      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_IV__cl_10__para_e",
      "schema:text": {
        "@language": "en",
        "@value": "if the assembly is a procession—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_IV__cl_10__para_e__subpara_viii__subpara_A",
      "@type": "akn:subparagraph",
      "eli:number": "A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_IV__cl_10__para_e__subpara_viii",
      "schema:text": {
        "@language": "en",
        "@value": "the proposed route of the procession;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_IV__cl_10__para_e__subpara_viii__subpara_B",
      "@type": "akn:subparagraph",
      "eli:number": "B",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_IV__cl_10__para_e__subpara_viii",
      "schema:text": {
