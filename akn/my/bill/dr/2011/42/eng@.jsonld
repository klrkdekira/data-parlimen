        "@value": "any place at which it is proposed that the procession will stop; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_IV__cl_10__para_e__subpara_viii__subpara_C",
      "@type": "akn:subparagraph",
      "eli:number": "C",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_IV__cl_10__para_e__subpara_viii",
      "schema:text": {
        "@language": "en",
        "@value": "the length of time it is proposed that the procession will remain at each such place;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_IV__cl_10__para_e__subpara_x",
