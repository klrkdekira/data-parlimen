        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_I__cl_3__list_2__para_c__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_I__cl_3__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "a place for the time being open to or used by the public, whether or not—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_I__cl_3__list_2__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_I__cl_3__list_2__para_c",
      "schema:text": {
