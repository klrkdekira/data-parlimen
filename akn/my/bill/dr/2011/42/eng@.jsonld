      "schema:text": {
        "@language": "en",
        "@value": "be signed by the organizer;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_IV__cl_10__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_IV__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "be accompanied by a copy of the consent of the owner or occupier of the place of assembly, if applicable;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_IV__cl_10__para_d",
      "@type": "akn:paragraph",
