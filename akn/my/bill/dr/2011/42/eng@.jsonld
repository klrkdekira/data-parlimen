      "schema:text": {
        "@language": "en",
        "@value": "the date on which the assembly is to be held;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_IV__cl_10__para_e__subpara_vi",
      "@type": "akn:subparagraph",
      "eli:number": "vi",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_IV__cl_10__para_e",
      "schema:text": {
        "@language": "en",
        "@value": "the place at which the assembly is to be held;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_IV__cl_10__para_e__subpara_vii",
