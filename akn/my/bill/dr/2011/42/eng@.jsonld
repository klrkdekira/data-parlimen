      "schema:text": {
        "@language": "en",
        "@value": "the times at which it is proposed that the assembly will begin and end;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_IV__cl_10__para_e__subpara_viii",
      "@type": "akn:subparagraph",
      "eli:number": "viii",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_IV__cl_10__para_e__subpara_viii__subpara_A",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_IV__cl_10__para_e__subpara_viii__subpara_B",
