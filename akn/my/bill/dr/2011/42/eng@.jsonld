      "schema:text": {
        "@language": "en",
        "@value": "RESPONSIBILITIES OF ORGANIZERS, PARTICIPANTS AND POLICE Responsibilities of organizers"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_6__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "An organizer shall ensure that an assembly is in compliance with this Act and any other written law."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_6__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_6__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_6__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_6__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_6__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_6__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_6__subsec_2__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_6__subsec_2__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_6__subsec_2__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_6__subsec_2__para_j"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "For the purpose of subsection (1), the organizer shall—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_6__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_6__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "ensure that the organization and conduct of an assembly is not in contravention of this Act or any order issued under this Act or any other written law;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_6__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_6__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "ensure that he or any other person at the assembly does not do any act or make any statement which has a tendency to promote feelings of ill-will, discontent or hostility amongst the public at large or do anything which will disturb public tranquility;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_6__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_6__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "ensure that he or any other person at the assembly does not commit any offence under any written law;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_6__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_6__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "ensure that the organization and conduct of an assembly is in accordance with the notification of assembly given under subsection 9(1) and any restrictions and conditions which may be imposed under section 15;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_6__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_6__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "appoint such number of persons as he thinks necessary to be in charge of the orderly conduct of the assembly;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_6__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_6__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "co-operate with the public authorities;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_6__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_6__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "ensure that the assembly will not endanger health or cause damage to property or the environment;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_6__subsec_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_6__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "ensure that the assembly will not cause any significant inconvenience to the public at large;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_6__subsec_2__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_6__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "ensure the clean-up of the place of assembly or bear the clean-up cost of the place of assembly; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_6__subsec_2__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_6__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of simultaneous assemblies or counter assemblies, ensure that the organization of the assemblies are not intended to specifically prevent the other assembly from taking place or interfere with the organization of such assembly. Responsibilities of participants"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_7__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III",
      "schema:name": {
        "@language": "en",
        "@value": "A participant shall—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_7__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_7__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_7__para_a__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_7__para_a__subpara_iv",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_7__para_a__subpara_v"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "refrain from—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_7__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_7__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "disrupting or preventing any assembly;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_7__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_7__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "behaving offensively or abusively towards any person;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_7__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_7__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "doing any act or making any statement which has a tendency to promote feelings of ill-will, discontent or hostility amongst the public at large or doing anything which will disturb public tranquility;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_7__para_a__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_7__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "committing any offence under any written law at any assembly; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_7__para_a__subpara_v",
      "@type": "akn:subparagraph",
      "eli:number": "v",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_7__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "causing damage to property; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "adhere to the orders given by the police, organizer or any person appointed by the organizer to be in charge of the orderly conduct of the assembly. Responsibilities of police"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "A police officer may take such measures as he deems necessary to ensure the orderly conduct of an assembly in accordance with this Act and any other written law."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_II__cl_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_II__cl_4__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_II__cl_4__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_II__cl_4__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_II__cl_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_II__cl_4__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_II__cl_4__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_II__cl_4__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_II__cl_4__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_II__cl_4__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "The right to organize an assembly or participate in an assembly peaceably and without arms under this Act shall not extend to the following:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_II__cl_4__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a non-citizen;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_II__cl_4__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "an assembly held at any prohibited place and within fifty metres from the limit of the prohibited place;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_II__cl_4__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a street protest;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_II__cl_4__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "in relation to the organization of an assembly, a person below the age of twenty-one years; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_II__cl_4__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "in relation to the participation in an assembly other than an assembly specified in the Second Schedule, a child."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_II__cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_II__cl_4__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_II__cl_4__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_II__cl_4__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_II__cl_4__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_II__cl_4__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_II__cl_4__subsec_2__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "A person commits an offence if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_II__cl_4__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_II__cl_4__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "being a non-citizen, he organizes or participates in an assembly;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_II__cl_4__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_II__cl_4__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "he organizes or participates in an assembly held at any prohibited place and within fifty metres from the limit of the prohibited place;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_II__cl_4__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_II__cl_4__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "he organizes or participates in a street protest;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_II__cl_4__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_II__cl_4__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "being a person below the age of twenty-one years, he organizes an assembly;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_II__cl_4__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_II__cl_4__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "being a child, he participates in an assembly other than an assembly specified in the Second Schedule; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_II__cl_4__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_II__cl_4__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "he recruits or brings a child to an assembly or allows a child to attend an assembly other than an assembly specified in the Second Schedule."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_II__cl_4__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "A person who commits an offence under paragraph (2)(a), (b), (c), (d) or (e) shall, on conviction, be liable to a fine not exceeding ten thousand ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_II__cl_4__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "A person who commits an offence under paragraph (2)(f) shall, on conviction, be liable to a fine not exceeding twenty thousand ringgit. Right of person who has interests"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "A person who has interests shall have the right to be informed of the details of an assembly in the manner specified in section 12 so as to allow him to raise his concerns or objections to the assembly."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/eng@/~part_IV",
