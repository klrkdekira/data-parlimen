      "schema:text": {
        "@language": "en",
        "@value": "the places as may be specified in the First Schedule; “place of assembly” means the place where the assembly is held and in relation to a procession, includes a place at or through which it is proposed the assembly will stop or pass; “designated place of assembly” means a place designated by the Minister under section 25."
      }
    },
