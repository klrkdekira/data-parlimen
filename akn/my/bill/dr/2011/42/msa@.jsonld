        "@value": "nama dan alamat penceramah dalam perhimpunan, jika ada;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_IV__cl_10__para_e__subpara_iv",
