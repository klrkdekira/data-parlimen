      "schema:text": {
        "@language": "ms",
        "@value": "TANGGUNGJAWAB PENGANJUR, PESERTA DAN POLIS Tanggungjawab penganjur"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_6__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang penganjur hendaklah memastikan bahawa sesuatu perhimpunan mematuhi Akta ini dan mana-mana undang-undang bertulis yang lain."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_6__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_6__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_6__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_6__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_6__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_6__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_6__subsec_2__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_6__subsec_2__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_6__subsec_2__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_6__subsec_2__para_j"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud subseksyen (1), penganjur hendaklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_6__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_6__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "memastikan bahawa penganjuran dan pengendalian perhimpunan tidak melanggar Akta ini atau apa-apa arahan yang dikeluarkan di bawah Akta ini atau mana- mana undang-undang bertulis yang lain;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_6__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_6__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "memastikan bahawa dia atau mana-mana orang lain yang berada di perhimpunan itu tidak melakukan apa- apa perbuatan atau membuat apa-apa pernyataan yang berkecenderungan untuk mengembangkan perasaan jahat, perasaan tidak puas hati atau permusuhan di kalangan orang awam amnya atau membuat apa-apa yang akan mengganggu ketenangan orang awam;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_6__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_6__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "memastikan bahawa dia atau mana-mana orang lain yang berada di perhimpunan itu tidak melakukan apa- apa kesalahan di bawah mana-mana undang-undang bertulis;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_6__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_6__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "memastikan bahawa penganjuran dan pengendalian suatu perhimpunan adalah mengikut pemberitahuan perhimpunan yang diberikan di bawah subseksyen 9(1) dan apa-apa sekatan dan syarat yang boleh dikenakan di bawah seksyen 15;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_6__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_6__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "melantik apa-apa bilangan orang yang difikirkannya perlu untuk bertanggungjawab bagi mengendalikan perhimpunan dengan teratur;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_6__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_6__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "bekerjasama dengan pihak berkuasa awam;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_6__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_6__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "memastikan bahawa perhimpunan itu tidak akan membahayakan kesihatan atau menyebabkan kerosakan kepada harta atau alam sekitar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_6__subsec_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_6__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "memastikan bahawa perhimpunan itu tidak akan menyebabkan apa-apa kesusahan yang signifikan kepada orang awam amnya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_6__subsec_2__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_6__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "memastikan pembersihan tempat perhimpunan atau menanggung kos pembersihan tempat perhimpunan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_6__subsec_2__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_6__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal perhimpunan serentak atau perhimpunan balas, memastikan bahawa penganjuran perhimpunan itu tidak diniatkan untuk menghalang secara spesifik perhimpunan yang satu lagi daripada diadakan atau mengganggu penganjuran perhimpunan itu. Tanggungjawab peserta"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_7__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III",
      "schema:name": {
        "@language": "ms",
        "@value": "Seseorang peserta hendaklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_7__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_7__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_7__para_a__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_7__para_a__subpara_iv",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_7__para_a__subpara_v"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "menahan diri daripada—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_7__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_7__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "menggendalakan atau menghalang mana-mana perhimpunan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_7__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_7__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "berkelakuan secara menyakitkan hati atau menggunakan kata kesat terhadap mana-mana orang;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_7__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_7__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "melakukan apa-apa perbuatan atau membuat apa- apa pernyataan yang berkecenderungan untuk mengembangkan perasaan jahat, perasaan tidak puas hati atau permusuhan di kalangan orang awam amnya atau membuat apa-apa yang akan mengganggu ketenangan orang awam;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_7__para_a__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_7__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "melakukan apa-apa kesalahan di bawah mana-mana undang-undang bertulis di mana-mana perhimpunan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_7__para_a__subpara_v",
      "@type": "akn:subparagraph",
      "eli:number": "v",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_7__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "menyebabkan kerosakan kepada harta; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "mematuhi arahan-arahan yang diberikan oleh polis, penganjur atau mana-mana orang yang dilantik oleh penganjur untuk bertanggungjawab bagi mengendalikan perhimpunan dengan teratur. Tanggungjawab polis"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pegawai polis boleh mengambil apa-apa langkah sebagaimana yang difikirkannya perlu untuk memastikan perhimpunan dikendalikan dengan teratur mengikut Akta ini dan mana-mana undang-undang bertulis yang lain."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_II__cl_4",
      "@type": "akn:clause",
