      "schema:text": {
        "@language": "ms",
        "@value": "dalam borang dalam Jadual Keempat;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_IV__cl_10__para_b",
      "@type": "akn:paragraph",
