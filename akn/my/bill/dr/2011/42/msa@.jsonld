        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_II__cl_4__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_II__cl_4__subsec_2__para_e",
