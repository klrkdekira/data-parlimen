      "schema:text": {
        "@language": "ms",
        "@value": "HAK UNTUK BERHIMPUN SECARA AMAN DAN TANPA SENJATA Hak untuk menganjurkan perhimpunan atau menyertai perhimpunan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_III",
