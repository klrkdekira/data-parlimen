      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang melakukan suatu kesalahan jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_II__cl_4__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_II__cl_4__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "sebagai seorang bukan warganegara, dia menganjurkan atau menyertai suatu perhimpunan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_II__cl_4__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_II__cl_4__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dia menganjurkan atau menyertai suatu perhimpunan yang diadakan di mana-mana tempat larangan dan dalam jarak lima puluh meter dari had tempat larangan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_II__cl_4__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_II__cl_4__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dia menganjurkan atau menyertai suatu protes jalanan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_II__cl_4__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_II__cl_4__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "sebagai seorang yang di bawah umur dua puluh satu tahun, dia menganjurkan suatu perhimpunan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_II__cl_4__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_II__cl_4__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "sebagai seorang kanak-kanak, dia menyertai suatu perhimpunan selain suatu perhimpunan yang dinyatakan dalam Jadual Kedua; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_II__cl_4__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_II__cl_4__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dia merekrut atau membawa kanak-kanak ke suatu perhimpunan atau membenarkan kanak-kanak untuk menghadiri suatu perhimpunan selain suatu perhimpunan yang dinyatakan dalam Jadual Kedua."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_II__cl_4__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang melakukan suatu kesalahan di bawah perenggan (2)(a), (b), (c), (d) atau (e) boleh, apabila disabitkan, didenda tidak melebihi sepuluh ribu ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_II__cl_4__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang melakukan suatu kesalahan di bawah perenggan (2)(f) boleh, apabila disabitkan, didenda tidak melebihi dua puluh ribu ringgit Hak orang yang mempunyai kepentingan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/42/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang mempunyai kepentingan hendaklah mempunyai hak untuk dimaklumkan mengenai butir-butir suatu perhimpunan mengikut cara yang dinyatakan dalam seksyen 12 untuk membolehkannya membangkitkan kebimbangan atau bantahannya terhadap perhimpunan itu."
      }
    },
