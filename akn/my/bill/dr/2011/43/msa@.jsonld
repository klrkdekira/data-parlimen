      ],
      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Polis (Pindaan) 2011"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/43/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/43/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/43/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/43/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/43/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/43/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Polis (Pindaan) 2011."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/43/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/43/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta. Pindaan seksyen 21"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/43/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/43/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Polis 1967 [Akta 344], yang disebut “Akta ibu” dalam Akta ini, dipinda dalam perenggan 21(1)(c) dengan memotong perkataan “and processions”. Pemotongan seksyen 27, 27a, 27b dan 27c"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/43/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/43/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memotong seksyen 27, 27a, 27b dan 27c. Kesan pemotongan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/43/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/43/msa@/~cl_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/43/msa@/~cl_4__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/43/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/43/msa@/~cl_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/43/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila mula berkuat kuasanya Akta ini, semua perkara yang berhubungan dengan suatu lesen untuk mengadakan atau mengumpulkan apa-apa perhimpunan atau membentuk apa-apa perarakan di bawah seksyen 27 yang belum diputuskan oleh Pegawai yang Menjaga Daerah Polis atau Pesuruhjaya atau Ketua Pegawai Polis tidak akan diteruskan; dan semua lesen yang dikeluarkan bagi apa-apa perhimpunan dan perarakan yang akan diadakan, dikumpulkan atau dibentuk sebelum tarikh permulaan kuat kuasa Akta ini hendaklah terhenti berkuat kuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/43/msa@/~cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/43/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa tindakan sivil atau jenayah menurut seksyen 27, 27a atau 27b Akta ibu yang belum selesai sebelum tarikh permulaan kuat kuasa Akta ini tidaklah terjejas oleh Akta ini dan hendaklah diteruskan seolah-olah Akta ini tidak diperbuat."
      }
    }
  ]
}
