      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Saraan Hakim (Pindaan) 2011"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/5/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/5/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/5/msa@/~cl_1__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/5/msa@/~cl_1__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/5/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/5/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/5/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Saraan Hakim (Pindaan) 2011."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/5/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/5/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 2, 3, 5, 6 dan 7 disifatkan telah mula berkuat kuasa pada 1 Januari 2009."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/5/msa@/~cl_1__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/5/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 4 disifatkan telah mula berkuat kuasa pada 28 Ogos 2008. Pindaan seksyen 4"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/5/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/5/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Saraan Hakim 1971 [Akta 45], yang disebut “Akta ibu” dalam Akta ini, dipinda dalam proviso seksyen 4 dengan menggantikan perkataan “1/2” dengan perkataan “3/5”. Pindaan seksyen 5"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/5/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/5/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 5(1) Akta ibu dipinda dengan menggantikan angka “15” dengan angka “18”. Penggantian seksyen 7A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/5/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/5/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan menggantikan seksyen 7A dengan seksyen yang berikut: “Tempoh perkhidmatan sebagai Pesuruhjaya Kehakiman 7A. (1) Bagi maksud menghitung pencen dan ganjaran seseorang Hakim di bawah Akta ini, tempoh perkhidmatannya sebagai Pesuruhjaya Kehakiman sebaik sebelum pelantikannya sebagai Hakim hendaklah dikira sebagai sebahagian daripada tempoh perkhidmatannya sebagai Hakim. (2) Subseksyen (1) hendaklah terpakai bagi seseorang Hakim yang masih dalam perkhidmatan atau yang telah bersara sebelum permulaan kuat kuasa seksyen ini. (3) Walau apa pun subseksyen (1), jika apa-apa pencen atau ganjaran telah dibayar kepada seseorang Hakim di bawah mana-mana undang-undang lain bagi tempoh yang sama dengan tempoh yang hendaklah dikira sebagai sebahagian daripada tempoh perkhidmatannya sebagai Hakim, pencen dan ganjarannya di bawah Akta ini hendaklah dikurangkan sebanyak amaun yang telah dibayar sedemikian.”. Penggantian seksyen 9"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/5/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/5/msa@/~cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/5/msa@/~cl_5__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/5/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/5/msa@/~cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/5/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan menggantikan seksyen 9 dengan seksyen yang berikut: “Peruntukan khas bagi Ketua Hakim Negara, Presiden dan Hakim Besar 9. Walau apa pun apa-apa jua yang terkandung dalam Akta ini tetapi tertakluk kepada seksyen 8, seseorang yang memegang jawatan Ketua Hakim Negara, Presiden atau Hakim Besar adalah berhak mendapat pencen maksimum jika dia telah memegang salah satu atau kesemua jawatan itu selama suatu tempoh yang kesemuanya tidak kurang daripada tiga tahun.”."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/5/msa@/~cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/5/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Pindaan dalam subseksyen (1) hendaklah terpakai bagi seorang Hakim yang masih dalam perkhidmatan atau yang telah bersara daripada perkhidmatan sebelum seksyen ini mula berkuat kuasa. Pindaan Jadual Ketiga dan Jadual Keempat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/5/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/5/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Jadual Ketiga dan Jadual Keempat kepada Akta ibu dipinda dengan menggantikan angka “180” yang terdapat dalam ruang “Formula” dengan angka “216”. Kecualian dan peralihan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/5/msa@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/5/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Pemberian pencen atau pencen terbitan berkenaan dengan seseorang Hakim yang bersara sebelum 1 Januari 2009 atau mati sebelum 31 Disember 2008 hendaklah berdasarkan Akta ibu seolah- olah Akta ibu tidak dipinda oleh Akta ini, dan pemberian pencen atau pencen terbitan itu hendaklah berdasarkan pindaan yang dibuat kepada Akta ibu oleh Akta ini hanya mulai 1 Januari 2009 dan kena dibayar mulai tarikh itu."
      }
    }
  ]
}
