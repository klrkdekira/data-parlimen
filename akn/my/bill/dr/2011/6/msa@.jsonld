      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Perbekalan Tambahan (2010) 2011"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/6/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/6/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Perbekalan Tambahan (2010)"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "2011. Perbelanjaan tambahan bagi tahun 2010"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/6/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/6/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Maka dengan ini dibenarkan pengeluaran sejumlah wang yang tidak melebihi tiga belas bilion seratus tujuh puluh juta sembilan ratus sembilan puluh tujuh ribu enam ratus ringgit (RM13,170,997,600) daripada Kumpulan Wang Disatukan bagi perbelanjaan tambahan untuk perkhidmatan dan maksud yang dinyatakan dalam Jadual bagi tahun 2010 yang tidak diperuntukkan atau yang tidak diperuntukkan dengan sepenuhnya oleh Akta Perbekalan 2010 [Akta A1361]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/6/msa@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/6/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Tajuk Parlimen Suruhanjaya Pilihan Raya Suruhanjaya Perkhidmatan Awam Jabatan Perdana Menteri 285,790,000 Jabatan Perkhidmatan Awam 592,345,100 Jabatan Peguam Negara Suruhanjaya Pencegahan Rasuah Malaysia Peruntukan kepada Kumpulan Wang Terkanun 8,020,353,100 Kementerian Perusahaan Perladangan dan 324,000,000 Komoditi Kementerian Pertanian dan Industri Asas Tani Kementerian Kemajuan Luar Bandar dan Wilayah Kementerian Perdagangan Antarabangsa dan Industri Kementerian Perdagangan Dalam Negeri, Koperasi 356,690,000 dan Kepenggunaan Kementerian Pengangkutan Kementerian Sains, Teknologi dan Inovasi Kementerian Wilayah Persekutuan dan Kesejahteraan Bandar Kementerian Pelajaran 1,759,019,400 Kementerian Kesihatan 1,007,900,000 Kementerian Belia dan Sukan Kementerian Penerangan, Komunikasi dan Kebudayaan Kementerian Pengajian Tinggi Kementerian Pertahanan Kementerian Dalam Negeri 493,251,000 JUMLAH 13,170,997,600"
      }
    }
