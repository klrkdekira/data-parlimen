      "schema:name": {
        "@language": "en",
        "@value": "Subsection 6A(2) of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/7/eng@/~cl_9__para_a",
