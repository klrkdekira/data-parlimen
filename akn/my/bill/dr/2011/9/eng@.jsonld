    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Medical Device Act 2011."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I",
      "schema:name": {
        "@language": "en",
        "@value": "In this Act, unless the context otherwise requires—"
      },
      "schema:text": {
        "@language": "en",
        "@value": "“conformity assessment body” means the conformity assessment body registered under section 12; “prescribed”, unless otherwise specified, means prescribed by regulations made under this Act; “establishment” means—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_1",
      "@type": "akn:list",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "a person who is either a manufacturer, importer, or distributor who is responsible for placing any medical device in the market but does not include a retailer; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_1__para_b__subpara_A",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_1__para_b__subpara_B"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "an authorized representative appointed by a manufacturer having a principal place of business outside Malaysia, and such person and authorized representative being—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_1__para_b__subpara_A",
      "@type": "akn:subparagraph",
      "eli:number": "A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "a person domiciled or resident in Malaysia; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_1__para_b__subpara_B",
      "@type": "akn:subparagraph",
      "eli:number": "B",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "a firm or company constituted under the laws of Malaysia, and carrying on business or practice principally in Malaysia; “place in the market” means to make available a medical device in return for payment or free of charge with a view to distributing, using, supplying or putting it into service, in Malaysia, regardless of whether it is new or reprocessed, but does not include to make available for use for clinical research or for performance evaluation of a medical device; “Minister” means the Minister charged with the responsibility for health; “manufacturer” means—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_2",
      "@type": "akn:list",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_2__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_2__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "a person who is responsible for—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_2__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "the design, production, fabrication, assembly, processing, packaging and labelling of a medical device whether or not it is the person, or a subcontractor acting on the person’s behalf, who carries out these operations; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_2__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "assigning to the finished medical device under his own name, its intended purpose and ensuring the finished product meets the regulatory requirement; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_2__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_2__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "any other person who—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "assembles, packages, processes, fully refurbishes, reprocesses or labels one or more ready-made medical devices; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_2__para_b__subpara_ii__subpara_A",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_2__para_b__subpara_ii__subpara_B"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "assigning to the ready-made medical device under his own name, its intended purpose and ensuring the finished product meets the regulatory requirement, but shall not include the following persons:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_2__para_b__subpara_ii__subpara_A",
      "@type": "akn:subparagraph",
      "eli:number": "A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_2__para_b__subpara_ii",
      "schema:text": {
        "@language": "en",
        "@value": "any person who assembles or adapts medical devices in the market that are intended for individual patients; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_2__para_b__subpara_ii__subpara_B",
      "@type": "akn:subparagraph",
      "eli:number": "B",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_2__para_b__subpara_ii",
      "schema:text": {
        "@language": "en",
        "@value": "any person who assembles, packages or adapts medical devices in relation to which the assembling, packaging or adaptation does not change the purpose intended for the medical devices; “medical device” means—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_3",
      "@type": "akn:list",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_3__para_a",
