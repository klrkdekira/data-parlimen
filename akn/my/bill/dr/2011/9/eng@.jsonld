      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_3__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_3__para_a__subpara_ii",
