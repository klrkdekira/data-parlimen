        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_20",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_21",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_22",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_23",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_24",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_25"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "Establishment licence Requirement for establishment licence"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_15__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_15__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_15__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "No establishment shall import, export or place in the market any registered medical device unless it holds an establishment licence granted under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "Any establishment who contravenes subsection (1) commits an offence and shall, on conviction, be liable to a fine not exceeding two hundred thousand ringgit or to imprisonment for a term not exceeding three years or to both. Application for establishment licence"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_16__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_16__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_16__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_16__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "An establishment may apply for an establishment licence to be granted under this Act by submitting a written application to the Authority in the prescribed manner."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "Every application under subsection (1) shall be accompanied by the prescribed application fee and such document or information as may be specified by the Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_16__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "An application may be withdrawn at any time by the applicant before it is granted or refused by the Authority. Additional information or document"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_17__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority may, in writing, at any time after the receipt of an application under section 16, request the applicant to give to the Authority within the period specified in the request additional information, particulars or document."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "If any additional information, particulars or document required under subsection (1) is not given by the applicant within the period specified in the request or any extension of time granted by the Authority, the application shall be deemed to be withdrawn and shall not be further proceeded with, but without affecting the right of the applicant to make a fresh application. Grant or refusal of establishment licence"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_18__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_18__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority may, after considering the application for an establishment licence under section 16, and the additional information, particulars or document provided under section 17, grant the establishment licence for a prescribed period or refuse to grant the establishment licence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "An establishment licence granted under subsection (1) shall be subject to the payment of the prescribed fee within the prescribed period and such conditions as the Authority thinks fit to impose. Compliance with establishment licence conditions"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_19__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_19__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_19__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "A licensee shall comply with the conditions imposed by the Authority on the establishment licence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_19__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "Any licensee who contravenes subsection (1) commits an offence and shall, on conviction, be liable to a fine not exceeding one hundred thousand ringgit or to imprisonment for a term not exceeding one year or to both. Power to impose additional conditions and to vary or revoke conditions"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_20__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_20__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1",
      "schema:name": {
        "@language": "en",
        "@value": "The Authority may, at any time—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_20__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "impose any additional conditions on the establishment licence; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_20__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "vary or revoke any of the conditions imposed on the establishment licence. Transfer of establishment licence"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_21__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_21__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_21__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "The grant of an establishment licence under section 18 shall be personal to the licensee and the establishment licence shall not be assigned, sub-licensed or transferred to any other person except with the prior written approval of the Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_21__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "A licensee who assigns, sub-licenses or transfers his establishment licence to any other person without the prior written approval of the Authority commits an offence and shall, on conviction, be liable to a fine of not less than fifty thousand ringgit and not more than five hundred thousand ringgit or to imprisonment for a term not exceeding three years or to both. Suspension or revocation of establishment licence"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_22__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_22__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_22__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_22__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_22__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_22__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_22__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority may suspend or revoke an establishment licence if the licensee—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_22__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_22__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "has contravened any provision of this Act or any regulations made under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_22__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_22__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "has breached any condition of the licence; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_22__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_22__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "has been convicted of an offence under this Act or any regulations made under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_22__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "If an establishment licence is suspended under subsection (1), the Authority may require the licensee to remedy the contravention or the breach within the period specified by the Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_22__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "If the Authority is satisfied that the licensee has failed to remedy the contravention or breach as required under subsection (2), or the contravention or breach continues after the establishment licence is suspended under subsection (1), the Authority shall revoke the licence. Surrender of establishment licence"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_23__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_23__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_23__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_23__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "A licensee may, by notice in writing, surrender its licence by forwarding the establishment licence to the Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_23__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "The surrender of the establishment licence shall take effect upon receipt of the establishment licence and the written notice under subsection (1) by the Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_23__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "The surrender of an establishment licence under subsection (1) shall be irrevocable. Renewal of establishment licence"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_24__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_24__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_24__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_24__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_24__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "A licensee may apply for renewal of its establishment licence to the Authority not later than one year before the expiry date of the establishment licence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_24__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_24__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_24__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_24__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_24__subsec_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority shall, upon payment of the prescribed fee, renew an establishment licence except in the following circumstances:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_24__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_24__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the licensee has contravened any provision of this Act or any regulations made under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_24__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_24__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the licensee has breached any condition of the establishment licence;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_24__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_24__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the licensee had improperly or illegally obtained the establishment licence; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_24__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_24__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the licensee has been convicted of an offence under this Act or any regulations made under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_24__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority may request the licensee to provide any information, particulars or document as may be required for the renewal application within the period specified in the request."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_24__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (2), if the information, particulars or document requested under subsection (3) is not provided by the licensee within the period specified in the request or any extension of time granted, the Authority may not renew the establishment licence. Effect of suspension, revocation, surrender or non-renewal of establishment licence"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_25__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_25__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_25__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_25__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_25__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "If an establishment licence is suspended or revoked under section 22, surrendered under section 23 or is not renewed under section 24, the licensee shall immediately cease to import, export or place in the market any registered medical device in respect of which the establishment licence was granted."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_25__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (1), the Authority may, at any time after the suspension, revocation, surrender or non-renewal of an establishment licence, give such directions to the licensee as it may deem necessary in the interest of public health and safety, and the licensee shall comply with all such directions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_25__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_25__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_25__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "A licensee whose establishment licence is—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_25__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_25__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "suspended, revoked or not renewed shall not be entitled to any compensation for any loss caused to it by the suspension, revocation or non-renewal of the establishment licence; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_25__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_25__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "revoked shall not be entitled to any refund of the establishment licence fee paid under section 18."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_25__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_1__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "Any licensee who contravenes subsection (1) commits an offence and shall, on conviction, be liable to a fine not exceeding two hundred thousand ringgit or to imprisonment for a term not exceeding three years or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2",
      "@type": "akn:chapter",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_26",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_27",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_28",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_29",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_30",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_31",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_32",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_33",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_34",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_35",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_36"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "Designated medical device permit Designated medical device"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, from time to time, after taking into consideration the risk level of a medical device, the exposure of medical device to public health, patient safety and the degree of complexities of the medical device, specify a medical device to be a designated medical device by an order published in the Gazette. Requirement for designated medical device permit"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_27__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_27__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_27__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall use or operate any designated medical device unless the person holds a designated medical device permit granted under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_27__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) commits an offence and shall, on conviction, be liable to a fine not exceeding one hundred thousand ringgit or to imprisonment for a term not exceeding one year or to both. Application for designated medical device permit"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_28__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_28__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_28__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_28__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "A person may apply for a designated medical device permit to be granted under this Act by submitting a written application to the Authority in the prescribed manner."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_28__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "Every application under subsection (1) shall be accompanied by the prescribed application fee and such document or information as may be specified by the Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_28__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "An application under this section may be withdrawn at any time by the applicant before it is granted or refused by the Authority. Additional information or document"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_29__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_29__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_29__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority may, in writing, at any time after the receipt of an application under section 28, request the applicant to give to the Authority within the period specified in the request additional information, particulars or document."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_29__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "If any additional information, particulars or document required under subsection (1) is not provided by the applicant within the period specified in the request or any extension of time granted by the Authority, the application shall be deemed to be withdrawn and shall not be further proceeded with, but without affecting the right of the applicant to make a fresh application. Grant or refusal of designated medical device permit"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_30__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_30__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_30__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority may, after considering the application for a designated medical device permit under section 28 and the additional information, particulars or document provided under section 29, grant the designated medical device permit for a prescribed period or refuse to grant the designated medical device permit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_30__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "A designated medical device permit granted under subsection (1) shall be subject to the payment of the prescribed fee within the prescribed period and such conditions as the Authority thinks fit to impose. Compliance with designated medical device permit conditions"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_31__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_31__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_31__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "A permit holder shall comply with the conditions imposed by the Authority on the designated medical device permit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_31__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "Any permit holder who contravenes subsection (1) commits an offence and shall, on conviction, be liable to a fine not exceeding fifty thousand ringgit or to imprisonment for a term not exceeding six months or to both. Power to impose additional conditions and to vary or revoke conditions"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_32__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_32__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2",
      "schema:name": {
        "@language": "en",
        "@value": "The Authority may, at any time—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_32__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "impose any additional conditions on the designated medical device permit; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_32__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "vary or revoke any of the conditions imposed on the designated medical device permit. Suspension or revocation of designated medical device permit"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_33__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_33__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_33__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_33__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_33__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_33__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_33__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority may suspend or revoke a designated medical device permit if the permit holder—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_33__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_33__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "has contravened any provision of this Act or any regulations made under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_33__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_33__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "has breached any condition of the designated medical device permit; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_33__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_33__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "has been convicted of an offence under this Act or any regulations made under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_33__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "If a designated medical device permit is suspended under subsection (1), the Authority may require the permit holder to remedy the contravention or breach within the period specified by the Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_33__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "If the Authority is satisfied that the permit holder has failed to remedy the contravention or breach as required under subsection (2), or the contravention or breach continues after the designated medical device permit is suspended under subsection (1), the Authority shall revoke the designated medical device permit. Surrender of designated medical device permit"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_34",
      "@type": "akn:clause",
      "eli:number": "34",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_34__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_34__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_34__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_34__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "A permit holder may, by notice in writting, surrender its designated medical device permit by forwarding the designated medical device permit to the Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_34__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "The surrender of the designated medical device permit shall take effect upon receipt of the designated medical device permit and the written notice under subsection (1) by the Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_34__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "The surrender of a designated medical device permit under subsection (1) shall be irrevocable. Renewal of designated medical device permit"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_35",
      "@type": "akn:clause",
      "eli:number": "35",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_35__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_35__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_35__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_35__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_35__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "A permit holder may apply for renewal of its designated medical device permit to the Authority not later than one year before the expiry date of the permit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_35__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_35__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_35__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_35__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_35__subsec_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority shall, upon payment of the prescribed fee, renew a designated medical device permit except in the following circumstances:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_35__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_35__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the permit holder has contravened any provision of this Act or any regulations made under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_35__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_35__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the permit holder has breached any condition of the designated medical device permit;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_35__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_35__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the permit holder had improperly or illegally obtained the designated medical device permit; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_35__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_35__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the permit holder has been convicted of an offence under this Act or any regulations made under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_35__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority may request the permit holder to provide any information, particulars or document as may be required for the renewal application within the period specified in the request."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_35__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (2), if the information, particulars or document requested under subsection (3) is not provided by the permit holder within the period specified in the request or any extension of time granted, the Authority may not renew the designated medical device permit. Effect of suspension, revocation, surrender or non-renewal of designated medical device permit"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_36",
      "@type": "akn:clause",
      "eli:number": "36",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_36__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_36__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_36__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_36__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_36__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "If a designated medical device permit is suspended or revoked under section 33, surrendered under section 34 or is not renewed under section 35, the permit holder shall immediately cease to use or operate a designated medical device in respect of which the designated medical device permit was granted."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_36__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (1), the Authority may, at any time after the suspension, revocation, surrender or non-renewal of a designated medical device permit, give such directions to the permit holder as it may deem necessary in the interest of public health and safety, and the permit holder shall comply with all such directions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_36__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_36__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_36__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "A permit holder whose designated medical device permit is—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_36__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_36__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "suspended, revoked or not renewed shall not be entitled to any compensation for any loss caused to him by the suspension, revocation or non-renewal of the designated medical device permit; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_36__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_36__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "revoked shall not be entitled to any refund of the designated medical device permit fee paid under section 30."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_36__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_2__cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "Any permit holder who contravenes subsection (1) commits an offence and shall, on conviction, be liable to a fine of not less than one hundred thousand ringgit and not more than one million ringgit or to imprisonment for a term not exceeding seven years or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3",
      "@type": "akn:chapter",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_37",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_38",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_39",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_40",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_41",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_42"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "Duties and obligations of licensees or permit holders Distribution records"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_37",
      "@type": "akn:clause",
      "eli:number": "37",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_37__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_37__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_37__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_37__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "An establishment shall maintain a distribution record in respect of each medical device manufactured, imported, exported and placed in the market."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_37__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "The distribution record shall contain information as prescribed by the Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_37__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "An establishment shall provide the distribution records to the Authority upon request. Post-market surveillance and vigilance"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_38__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_38__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_38__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "An establishment shall monitor the safety and performance of the medical device manufactured, imported, exported and placed in the market, and put in place a post-market surveillance system as prescribed by the Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_38__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "An establishment shall ensure that any vigilance report of adverse incident involving its medical device in the market is properly recorded and fully evaluated. Complaint handling"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3",
      "schema:text": {
        "@language": "en",
        "@value": "An establishment shall establish and implement documented procedures and maintain records of reported problems or complaints relating to the safety and the performance characteristics of its medical device. Mandatory problem reporting"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_40__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_40__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_40__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_40__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_40__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_40__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "An establishment shall report to the Authority any incident that comes to the establishment’s attention occurring inside or outside Malaysia that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_40__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_40__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "is related to the failure of the medical device or a deterioration in its effectiveness, or any inadequacy in its labelling or in its instructions for use and such report shall be made within thirty days from the discovery;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_40__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_40__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "has led to the death or serious deterioration in the state of health of a patient, user or other person, or could do so were the incident to recur and such report shall be made within ten days from the discovery; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_40__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_40__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "is a serious threat to public health and such report shall be made within forty-eight hours from the discovery."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_40__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) commits an offence and shall, on conviction, be liable to a fine not exceeding two hundred thousand ringgit or to imprisonment for a term not exceeding two years or to both. Field corrective action"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_41",
      "@type": "akn:clause",
      "eli:number": "41",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_41__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_41__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_41__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_41__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_41__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3",
      "schema:text": {
        "@language": "en",
        "@value": "An establishment shall undertake corrective or preventive action in relation to a medical device imported and placed in the market which may include—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_41__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "the return of the medical device to the establishment;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_41__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "modification of the medical device;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_41__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "exchange of the medical device;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_41__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "destruction of the medical device; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_41__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "specific advice on the use of the medical device. Recall"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_42",
      "@type": "akn:clause",
      "eli:number": "42",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_42__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_42__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_42__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_42__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_42__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "An establishment may recall any defective medical device at any time."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_42__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "The establishment shall, on or before undertaking a recall of the medical device, provide information as may be specified by the Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_42__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "The establishment shall, as soon as possible after the completion of a recall, report to the Authority the results of the recall and any action taken to prevent a recurrence of the problem."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_42__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_3__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (1), the Authority may order the establishment to recall any medical device at any time due to patient safety and public health."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4",
      "@type": "akn:chapter",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_43",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_44"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "General duty Usage, operation, maintenance, etc., of medical device"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_43",
      "@type": "akn:clause",
      "eli:number": "43",
      "hasPart": [
