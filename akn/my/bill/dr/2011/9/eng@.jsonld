      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_3",
      "schema:text": {
        "@language": "en",
        "@value": "any instrument, apparatus, implement, machine, appliance, implant, in-vitro reagent or calibrator, software, material or other similar or related article intended by the manufacturer to be used, alone or in combination, for human beings for the purpose of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_3__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_3__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "diagnosis, prevention, monitoring, treatment or alleviation of disease;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_3__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_3__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "diagnosis, monitoring, treatment, alleviation of or compensation for an injury;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_3__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_3__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "investigation, replacement or modification, or support of the anatomy or of a physiological process;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_3__para_a__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_3__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "support or sustaining life;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_3__para_a__subpara_v",
      "@type": "akn:subparagraph",
      "eli:number": "v",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_3__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "control of conception;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_3__para_a__subpara_vi",
      "@type": "akn:subparagraph",
      "eli:number": "vi",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_3__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "disinfection of medical device; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_3__para_a__subpara_vii",
      "@type": "akn:subparagraph",
      "eli:number": "vii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_3__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "providing information for medical or diagnostic purpose by means of in-vitro examination of specimens derived from the human body, which does not achieve its primary intended action in or on the human body by pharmacological, immunological or metabolic means, but that may be assisted in its intended function by such means; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_2__list_3",
      "schema:text": {
        "@language": "en",
        "@value": "any instrument, apparatus, implement, machine, appliance, implant, in-vitro reagent or calibrator, software, material or other similar or related article, to be used on the human body, which the Minister may, after taking into consideration issues of public safety, public health or public risk, declare to be a medical device by order published in the Gazette; “designated medical device” means a medical device specified by the Minister to be a designated medical device by order published in the Gazette; “Authority” means the Medical Device Authority established under the Medical Device Authority Act 2011 [Act ]; “appointed date” means the date appointed by the Minister under subsection 1(2)."
      }
    },
