        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_43__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_43__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_43__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_43__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_43__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_43__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "A person using or operating a medical device on a third party shall ensure that the medical device is—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_43__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_43__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "safe and efficacious;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_43__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_43__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "used in accordance with its intended purpose;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_43__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_43__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "used in accordance with the manufacturer’s instructions; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_43__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_43__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "properly installed, tested, commissioned and maintained."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_43__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_43__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_43__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "A person—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_43__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_43__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "using or operating a medical device on a third party; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_43__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_43__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "installing, testing, commissioning, maintaining and disposing of a medical device, shall have the qualification and competency as prescribed by the Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_43__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "A person using or operating a medical device on a third party shall take the medical device out of operation when it is no longer safe and effective for use."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_43__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_43__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_43__subsec_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_43__subsec_4__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_43__subsec_4__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "A medical device which has been taken out of operation under subsection (3) shall be removed and disposed of in a safe manner which eliminates or reduces any—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_43__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_43__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "danger of injury;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_43__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_43__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "danger of contamination with biological material or other contaminants;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_43__subsec_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_43__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "danger of environmental damage; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_43__subsec_4__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_43__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "danger of it being re-used."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_43__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority may issue directives, orders or guidelines to specify the measures to be taken in the event of an emergency or incident during the usage, operation, installation, testing, commissioning, maintenance and disposal of medical devices."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_43__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1), (2), (3) or (4) commits an offence and shall, on conviction, be liable to a fine not exceeding one hundred thousand ringgit or to imprisonment for a term not exceeding one year or to both. Advertising"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_44",
      "@type": "akn:clause",
      "eli:number": "44",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_44__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_44__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_44__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_44__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall advertise a medical device unless the medical device has been registered and complied with the requirements of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_44__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall make any misleading or fraudulent claims in respect of a medical device in any advertisement."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_44__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) or (2) commits an offence and shall, on conviction, be liable to a fine not exceeding three hundred thousand ringgit or to imprisonment for a term not exceeding three years or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_5",
      "@type": "akn:chapter",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_5__cl_45",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_5__cl_46"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "Export permit Export permit"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_5__cl_45",
      "@type": "akn:clause",
      "eli:number": "45",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_5__cl_45__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_5__cl_45__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_5__cl_45__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_5__cl_45__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_5__cl_45__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_5"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_5__cl_45__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_5__cl_45",
      "schema:text": {
        "@language": "en",
        "@value": "An establishment may apply to the Authority for a permit to export a registered medical device in the prescribed form and accompanied by the prescribed fees."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_5__cl_45__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_5__cl_45",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority may, after considering the application under subsection (1), issue or refuse to issue a permit to export a registered medical device."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_5__cl_45__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_5__cl_45",
      "schema:text": {
        "@language": "en",
        "@value": "If the Authority decides to issue an export permit, it may impose such conditions as it thinks fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_5__cl_45__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_5__cl_45",
      "schema:text": {
        "@language": "en",
        "@value": "An establishment shall comply with the conditions imposed by the Authority on the export permit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_5__cl_45__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_5__cl_45",
      "schema:text": {
        "@language": "en",
        "@value": "Any establishment who contravenes subsection (4) commits an offence and shall, on conviction, be liable to a fine not exceeding fifty thousand ringgit or to imprisonment for a term not exceeding six months or to both. Revocation of export permit"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_5__cl_46",
      "@type": "akn:clause",
      "eli:number": "46",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_5__cl_46__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_5__cl_46__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_5__cl_46__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_5__cl_46__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_5"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_5__cl_46__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_5__cl_46__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_5__cl_46__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_5__cl_46__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_5__cl_46__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_5__cl_46__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_5__cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority may, at any time, revoke an export permit issued if it is satisfied that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_5__cl_46__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_5__cl_46__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the permit holder has contravened any provision of this Act or any regulations made under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_5__cl_46__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_5__cl_46__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the permit holder has breached any condition of the permit;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_5__cl_46__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_5__cl_46__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the export permit was issued as a result of false, misleading or inaccurate information;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_5__cl_46__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_5__cl_46__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the permit holder had improperly or illegally obtained the permit; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_5__cl_46__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_5__cl_46__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the permit holder has been convicted of an offence under this Act or any regulations made under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_5__cl_46__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_5__cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "Upon the Authority notifying the permit holder of the revocation of its export permit, the permit holder shall immediately surrender the export permit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_5__cl_46__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_5__cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "Any permit holder who contravenes subsection (2) commits an offence and shall, on conviction, be liable to a fine not exceeding fifty thousand ringgit or to imprisonment for a term not exceeding six months or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_5__cl_46__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_5__cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "A permit holder whose export permit is revoked shall not be entitled to any compensation for any loss caused to him by the revocation of the export permit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1",
      "@type": "akn:chapter",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_9"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "Registration of medical device Classification of medical device"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_3__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "A medical device shall be classified by an establishment based on the level of risk it poses, its intended use and the vulnerability of the human body in accordance with the prescribed manner."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "In the event of any dispute between an establishment and a conformity assessment body over a classification of a medical device, the matter shall be referred to the Authority, in the manner and within such period as may be specified by the Authority, for its decision. Manufacturer’s obligations"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1",
      "schema:name": {
        "@language": "en",
        "@value": "A manufacturer shall ensure that a medical device—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "conforms to the prescribed essential principles of safety and performance;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "is manufactured in accordance with good manufacturing practice and any written directive issued by the Authority; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "is labelled, packaged and marked in accordance with the prescribed manner. Requirement for registration of medical device"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_5__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "No medical device shall be imported, exported or placed in the market unless the medical device is registered under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) commits an offence and shall, on conviction, be liable to a fine not exceeding two hundred thousand ringgit or to imprisonment for a term not exceeding three years or to both. Application for registration of medical device"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_6__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_6__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_6__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "An application for the registration of a medical device shall be made by an establishment to the Authority in the prescribed manner."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "An application may be withdrawn at any time by the applicant before it is approved or refused by the Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "Every application under subsection (1) shall be accompanied by the prescribed application fee and such document or information as may be specified by the Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_6__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority may, in writing, at any time after the receipt of an application under subsection (1), request the applicant to give to the Authority within the period specified in the request additional information, particulars or document on the application or sample of the medical device."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_6__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "If any additional information, particulars or document, or sample of the medical device required under subsection (4) is not given by the applicant within the period specified in the request or any extension of time granted by the Authority, the application shall be deemed to be withdrawn and shall not be further proceeded with, but without affecting the right of the applicant to make a fresh application. Registration and refusal to register medical device"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_7__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_7__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_7__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "Upon receipt of an application made under section 6 and the Authority being satisfied that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_7__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_7__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the medical device has been subjected to the conformity assessment procedures carried out by a conformity assessment body; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_7__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_7__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the applicant has complied with any requirement of the Authority made under subsection 6(4), the Authority may, after such inspection of the premises in which the medical device is being manufactured as it considers proper and necessary to carry out and on payment of the prescribed registration fee, register the medical device for a prescribed period subject to such conditions as the Authority thinks fit to impose, assign a registration number to the medical device and issue to the applicant a certificate of registration."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority shall not register the medical device if it is not satisfied with any matter referred to in subsection (1). Power to impose additional conditions and to vary or revoke conditions"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_8__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_8__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1",
      "schema:name": {
        "@language": "en",
        "@value": "The Authority may, at any time—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "impose any additional conditions on the registration of a medical device; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "vary or revoke any of the conditions imposed on the registration of a medical device. Power to cancel registration of medical device"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_9__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_9__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_9__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_9__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_9__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subsection (2), the Authority may cancel the registration of a medical device if the establishment on whose application a medical device is registered—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_9__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_9__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "has contravened any provision of this Act or any regulations made under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_9__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_9__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "has breached any condition of the registration; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_9__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_9__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "has been convicted of an offence under this Act or any regulations made under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "Before the cancellation of the registration of a medical device under subsection (1), the Authority shall, by notice in writing, give the establishment on whose application the medical device is registered an opportunity to show cause against the cancellation, and pending the decision on the cancellation, all importation or supply of the medical device by that establishment shall be suspended from the date of the receipt of the notice by the establishment."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_9__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_1__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "An establishment whose registration of medical device is cancelled shall not be entitled to any compensation for any loss caused to it by the cancellation and shall not be entitled to any refund of the prescribed registration fee paid under section 7."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2",
      "@type": "akn:chapter",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_11",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_12",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_13",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_14"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "Registration of conformity assessment body Conformity assessment body"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_10__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_10__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_10__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_10__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "A conformity assessment body shall be a body registered under this Act to carry out conformity assessment of a medical device to be registered under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The person who is in charge of and has overall control over a conformity assessment body shall be a Malaysian citizen."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_10__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_10__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_10__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_10__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "A conformity assessment body shall be independent and shall not have, acquire or hold any interest, directly or indirectly, in relation to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_10__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_10__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "any medical device under its assessment;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_10__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_10__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "any shares in the establishment whose medical device is assessed by it; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_10__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_10__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "any related company of the establishment whose medical device is assessed by it."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_10__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "A conformity assessment body shall not disclose any information received during the conformity assessment procedures carried out on any medical device."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_10__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "A conformity assessment body shall be audited by the Authority from time to time as may be deemed necessary by the Authority. Requirement for registration of conformity assessment body"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_11__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_11__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_11__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_11__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_11__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "No conformity assessment body may carry out any conformity assessment related to a medical device unless it is registered under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "A conformity assessment body may apply for registration by submitting a written application to the Authority in the prescribed manner."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_11__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "An application may be withdrawn at any time by the applicant before it is approved or refused by the Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_11__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "Every application under subsection (1) shall be accompanied by the prescribed application fee and such document or information as may be specified by the Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_11__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority may, in writing, at any time after the receipt of an application under subsection (2), request the applicant to give to the Authority within the period specified in the request additional information, particulars or document on the application."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_11__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "If any additional information, particulars or document required under subsection (5) is not given by the applicant within the period specified in the request or any extension of time granted by the Authority, the application shall be deemed to be withdrawn and shall not be further proceeded with, but without affecting the right of the applicant to make a fresh application. Registration and refusal to register conformity assessment body"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_12__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "Upon receipt of an application made under subsection 11(2) and the Authority being satisfied of the compliance with any requirement under subsections 11(4) and (5), the Authority may, after such inspection of the premises of the conformity assessment body as it considers proper and necessary to carry out and on payment of the prescribed registration fee, register the conformity assessment body for a prescribed period subject to such conditions as the Authority thinks fit to impose, assign a registration number to the conformity assessment body and issue to the conformity assessment body a certificate of registration."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority shall not register the conformity assessment body if it is not satisfied with any matter referred to in subsection (1). Power to impose additional conditions and to vary or revoke conditions"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_13__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_13__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2",
      "schema:name": {
        "@language": "en",
        "@value": "The Authority may, at any time—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_13__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "impose any additional conditions on the registration of a conformity assessment body; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_13__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "vary or revoke any of the conditions imposed on the registration of a conformity assessment body. Power to cancel registration of conformity assessment body"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_14__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_14__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_14__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_14__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_14__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subsection (2), the Authority may cancel the registration of a conformity assessment body that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_14__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_14__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "has contravened any provision of this Act or any regulations made under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_14__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_14__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "has breached any condition of the registration; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_14__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_14__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "has been convicted of an offence under this Act or any regulations made under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "Before the cancellation of the registration of a conformity assessment body under subsection (1), the Authority shall, by notice in writing, give the conformity assessment body an opportunity to show cause against the cancellation, and pending the decision of the cancellation, all assessment of any medical device by that conformity assessment body shall be suspended from the date of the receipt of the notice by the conformity assessment body."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_14__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_II__chp_2__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "A conformity assessment body whose registration is cancelled shall not be entitled to any compensation for any loss caused to it by the cancellation and shall not be entitled to any refund of the prescribed registration fee paid under section 12."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_IV__cl_47",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "APPEAL Appeal against decision of Authority"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_IV__cl_47",
      "@type": "akn:clause",
      "eli:number": "47",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_IV__cl_47__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_IV__cl_47__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_IV__cl_47__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_IV__cl_47__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_IV__cl_47",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who is aggrieved by the decision of the Authority under section 7, 9, 12, 14, 18, 22, 24, 30, 33, 35, 45 or 46 may appeal to the Minister in the prescribed manner and within the prescribed period."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_IV__cl_47__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_IV__cl_47",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may confirm, reverse or vary the decision of the Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_IV__cl_47__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_IV__cl_47",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister’s decision on any appeal under subsection (1) shall be final and binding."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
