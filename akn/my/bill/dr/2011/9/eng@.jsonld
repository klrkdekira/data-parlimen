    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI",
      "@type": "akn:part",
      "eli:number": "VI",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_67",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_68",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_69",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_70",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_71",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_72",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_73",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_74",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_75",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_76",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_77",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_78",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_80"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "GENERAL Register"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_67",
      "@type": "akn:clause",
      "eli:number": "67",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_67__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_67__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_67__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_67__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_67__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_67__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_67__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_67__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_67__subsec_1__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_67",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority shall cause to be kept and maintained a register consisting of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_67__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_67__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "all medical devices registered under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_67__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_67__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "all conformity assessment bodies registered under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_67__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_67__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "all licences and permits granted by the Authority;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_67__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_67__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "all decisions of the Authority to cancel the registration of a medical device or conformity assessment body;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_67__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_67__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "all decisions of the Authority to revoke and suspend licences or permits; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_67__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_67__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any other matters or data as may be specified by the Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_67__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_67",
      "schema:text": {
        "@language": "en",
        "@value": "The register shall be deemed to be a public document within the meaning of the Evidence Act 1950 and shall be open for public inspection and the public may make a search of and obtain extracts from the register upon payment of a prescribed fee. Confidential business information"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_68",
      "@type": "akn:clause",
      "eli:number": "68",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_68__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_68__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_68__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_68__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_68__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_68",
      "schema:text": {
        "@language": "en",
        "@value": "A person making an application or furnishing any information under this Act may apply to the Authority for confidentiality of any particular information relating to the application or furnishing of information, as the case may be."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_68__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_68",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority may grant confidentiality based on the criteria under subsection (3), and where confidentiality is granted, such information shall not be made public."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_68__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_68__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_68__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_68__subsec_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_68__subsec_3__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_68",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority shall consider the claim for confidentiality according to the following criteria:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_68__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_68__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "that the information is not known generally among, or readily accessible to, persons within the circle that normally deals with the kind of information sought to be made confidential;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_68__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_68__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "that the information has commercial value;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_68__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_68__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "that reasonable steps have been taken to keep the information secret; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_68__subsec_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_68__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "that the disclosure of the information will harm the competitive position of the person in a manner contrary to honest commercial practice."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_68__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_68",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority shall have the power to revoke the confidentiality granted in whole or in part in the interest of public health. Public disclosure"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_69",
      "@type": "akn:clause",
      "eli:number": "69",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to the discretion of the Authority, the public may have access to such information relating to any application or furnishing of information under this Act, which has not been granted confidentiality under section 68 or in respect of which the Authority has revoked its confidentiality under subsection 68(4), in such manner as the Authority thinks fit. Emergency response plan and assistance from multi-agencies in emergency"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_70",
      "@type": "akn:clause",
      "eli:number": "70",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_70__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_70__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_70__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_70__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_70__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_70__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_70",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority may require, as part of the process of issuing a licence or designated medical device permit, or otherwise, any person to provide the necessary measures to be taken in the event of an emergency for the protection of the public from harm or damage caused by a medical device."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_70__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_70",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority shall forward the emergency response plan submitted under subsection (1) to all relevant agencies for their necessary action."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_70__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_70",
      "schema:text": {
        "@language": "en",
        "@value": "In the event of any emergency involving any medical device, the Authority may seek the assistance and co-operation of the relevant agencies in implementing any emergency measures including those measures provided in the emergency response plan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_70__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_70",
      "schema:text": {
        "@language": "en",
        "@value": "Any costs incurred by any agency in implementing any emergency measure shall be borne by the licensee or designated medical device permit holder."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_70__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_70",
      "schema:text": {
        "@language": "en",
        "@value": "Nothing in this section shall absolve or be deemed to absolve the licensee or designated medical device permit holder from any of his obligation to take all necessary measures in the event of any emergency. Compounding of offences"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_71",
      "@type": "akn:clause",
      "eli:number": "71",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_71__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_71__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_71__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_71__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_71__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_71",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority may, with the consent of the Public Prosecutor, compound any offence committed by any person under this Act and prescribed to be a compoundable offence by regulations made under this Act by making a written offer to such person to compound the offence upon payment to the Authority of such amount not exceeding fifty per centum of the amount of the maximum fine for that offence within such time as may be specified in the offer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_71__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_71",
      "schema:text": {
        "@language": "en",
        "@value": "An offer under subsection (1) may be made at any time after the offence has been committed, but before any prosecution for it has been instituted."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_71__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_71",
      "schema:text": {
        "@language": "en",
        "@value": "If the amount specified in the offer made under subsection (1) is not paid within the time specified in the offer or within such extended period as the Authority may grant, prosecution for the offence may be instituted at any time after that against the person to whom the offer was made."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_71__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_71",
      "schema:text": {
        "@language": "en",
        "@value": "Where an offence has been compounded under subsection (1), no prosecution shall be instituted in respect of the offence against the person to whom the offer to compound was made. Prosecution"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_72",
      "@type": "akn:clause",
      "eli:number": "72",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "No prosecution for any offence under this Act or any regulations made under this Act shall be instituted except by or with the written consent of the Public Prosecutor. Offence by body corporate"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_73",
      "@type": "akn:clause",
      "eli:number": "73",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_73__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_73__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "If a body corporate commits an offence under this Act, any person who at the time of the commission of the offence was a director, manager, secretary or other similar officer of the body corporate or was purporting to act in any such capacity or was in any manner or to any extent responsible for the management of any of the affairs of the body corporate or was assisting in such management—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_73__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_73",
      "schema:text": {
        "@language": "en",
        "@value": "may be charged severally or jointly in the same proceedings with the body corporate; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_73__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_73__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_73__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_73",
      "schema:text": {
        "@language": "en",
        "@value": "where the body corporate is found guilty of the offence, shall be deemed to be guilty of that offence unless, having regard to the nature of his functions in that capacity and to all circumstances, he proves—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_73__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_73__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "that the offence was committed without his knowledge, consent or connivance; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_73__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_73__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "that he took all reasonable precautions and had exercised due diligence to prevent the commission of the offence. Offence by partner, agent or servant"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_74",
      "@type": "akn:clause",
      "eli:number": "74",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_74__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_74__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who would have been liable to any penalty under this Act for any act, omission, neglect or default if the act, omission, neglect or default is committed by him personally shall be liable to the same penalty if the act, omission, neglect or default is committed by his partner, agent or servant unless he proves—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_74__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_74",
      "schema:text": {
        "@language": "en",
        "@value": "that the act, omission, neglect or default was committed without his knowledge, consent or connivance; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_74__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_74",
      "schema:text": {
        "@language": "en",
        "@value": "that he took all reasonable precautions and had exercised due diligence to prevent the act, omission, neglect or default. Service of document"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_75",
      "@type": "akn:clause",
      "eli:number": "75",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_75__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_75__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_75__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_75__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_75__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_75__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_75",
      "schema:text": {
        "@language": "en",
        "@value": "Service of documents on any person shall be effected—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_75__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_75__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "by delivering the document to that person or by delivering the document at the last-known place of residence of that person to an adult member of his family;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_75__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_75__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "by leaving the document at the usual or last-known place of residence or business of that person in a cover addressed to that person; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_75__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_75__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "by forwarding the document by registered post addressed to that person at his usual or last-known place of residence or business."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_75__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_75__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_75__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_75",
      "schema:text": {
        "@language": "en",
        "@value": "A document required to be served on the owner or occupier of any premises—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_75__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_75__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "shall be deemed to be properly addressed if addressed by the description of the “owner” or “occupier” of such premises; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_75__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_75__subsec_2__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_75__subsec_2__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_75__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "may be served—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_75__subsec_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_75__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "by delivering the document to an adult person on the premises; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_75__subsec_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_75__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "if there is no such person on the premises to whom the document can with reasonable diligence be delivered, by advertisement at least in one local newspaper. False declaration"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_76",
      "@type": "akn:clause",
      "eli:number": "76",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_76__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_76__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_76__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_76",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who makes, orally or in writing, signs or furnishes any declaration, return, certificate or other document or information required under this Act which is untrue, inaccurate or misleading in any particular commits an offence and shall, on conviction, be liable to a fine not exceeding one hundred thousand ringgit or to imprisonment for a term not exceeding two years or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_76__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_76__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_76__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_76",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_76__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_76__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "without lawful authority alters, forges, mutilates or defaces any registration, licence or permit; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_76__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_76__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "knowingly makes use of any registration, licence or permit which has been altered, forged, mutilated or defaced, commits an offence and shall, on conviction, be liable to a fine not exceeding five hundred thousand ringgit or to imprisonment for a term not exceeding three years or to both. Power to exempt"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_77",
      "@type": "akn:clause",
      "eli:number": "77",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_77__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_77__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_77__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_77",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, if he considers it consistent with the purposes of this Act or in the interest of public health and safety, by order published in the Gazette, exempt any person or medical device from any of the provisions of this Act or any regulations made under this Act for such duration and subject to such conditions as the Minister may specify and he may alter or add the conditions so specified."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_77__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_77",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, at any time, by order published in the Gazette, revoke any order made under subsection (1) if he is satisfied that such exemption should no longer be granted. General penalty"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_78",
      "@type": "akn:clause",
      "eli:number": "78",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who commits an offence under this Act for which no penalty is expressly provided shall, on conviction, be liable to a fine not exceeding five hundred thousand ringgit or to imprisonment for a term not exceeding three years or to both. Regulations"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79",
      "@type": "akn:clause",
      "eli:number": "79",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may make such regulations as may be expedient or necessary for the better carrying out of the provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79__subsec_2__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79__subsec_2__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79__subsec_2__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79__subsec_2__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79__subsec_2__para_k",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79__subsec_2__para_l",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79__subsec_2__para_m",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79__subsec_2__para_n"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to the generality of subsection (1), regulations may be made for the following purposes:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe the manner of application for the registration of a medical device or conformity assessment body, licences or permits, and to provide for the cancellation of the registration, and suspension and revocation of the licence or permit;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe the risk classification criteria, the manner of classification and the rules of classification of medical devices;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe the design and manufacturing principles of medical devices, the good design principles in relation to risk elimination or minimization, and the good manufacturing principles in relation to standards, safety and efficacy of medical devices;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe all matters relating to the packaging, labelling and marking of medical devices for the purpose of identification;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe procedures and criteria for conformity assessment of medical devices;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe the conformity assessment standards for various class or categories of medical devices;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe the manner of keeping and maintaining the register;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79__subsec_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe matters relating to the contents of and conditions for advertising of medical devices;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79__subsec_2__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe the manner of maintenance and the contents of distribution records of medical devices;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79__subsec_2__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe the criteria, conditions and the procedures for post-market surveillance and vigilance, complaint handling, mandatory problem reporting, field corrective action and the usage, operation, installation, test, commission, maintenance and disposal of medical devices;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79__subsec_2__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe the procedure for voluntary recall by an establishment, the criteria, conditions and procedures for mandatory recall by the Authority, taking out of operation of medical devices and disposal of medical devices which are no longer safe to use;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79__subsec_2__para_l",
      "@type": "akn:paragraph",
      "eli:number": "l",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe matters relating to export permits including the criteria, conditions and the procedure for the application of export permits of medical devices;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79__subsec_2__para_m",
      "@type": "akn:paragraph",
      "eli:number": "m",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe the competency requirement of persons using, operating, installing, testing, commissioning, maintaining and disposing of medical devices; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79__subsec_2__para_n",
      "@type": "akn:paragraph",
      "eli:number": "n",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe the fees and charges payable under this Act and the manner for collecting and dealing with such fees and charges."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_79",
      "schema:text": {
        "@language": "en",
        "@value": "The regulations made under this Act may provide for any act or omission in contravention of the regulations to be an offence and may provide for penalties of a fine not exceeding two hundred thousand ringgit or to imprisonment for a term not exceeding two years or to both. Savings and transitional"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_80",
      "@type": "akn:clause",
      "eli:number": "80",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_80__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_80__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_80__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_80__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_80",
      "schema:text": {
        "@language": "en",
        "@value": "A person who, prior to the appointed date, has imported, exported or placed in the market medical devices shall, within twenty four months from the appointed date, apply for the registration of the medical devices under section 6."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_80__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_80",
      "schema:text": {
        "@language": "en",
        "@value": "A person who, prior to the appointed date, has been importing, exporting or placing in the market medical devices and intend to continue importing, exporting or placing in the market such medical devices shall, within twelve months from the appointed date, apply for an establishment licence under section 16."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_80__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_VI__cl_80",
      "schema:text": {
        "@language": "en",
        "@value": "A person referred to in subsection (1) or (2) may continue to import, export or place in the market the medical devices pending determination of its application for registration of a medical device or for an establishment licence, as the case may be."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_48",
      "@type": "akn:clause",
      "eli:number": "48",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_48__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_48__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_48__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, in writing, authorize any officer of the Authority or public officer to exercise the powers of enforcement under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_48__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "Any such officer shall be deemed to be a public servant within the meaning of the Penal Code [Act 574]. Authority card"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_49",
      "@type": "akn:clause",
      "eli:number": "49",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_49__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_49__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_49__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_49",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority shall issue to each authorized officer an authority card which shall be signed by the Chief Executive of the Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_49__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_49",
      "schema:text": {
        "@language": "en",
        "@value": "Whenever the authorized officer exercises any of the powers of enforcement under this Act, he shall produce on demand to the person against whom the power is being exercised the authority card issued to him under subsection (1). Power of investigation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_50",
      "@type": "akn:clause",
      "eli:number": "50",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_50__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_50__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_50__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "An authorized officer may investigate the commission of any offence under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_50__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "For the avoidance of doubt, it is declared that for the purposes of this Act, the authorized officer shall have all or any of the powers of a police officer of whatever rank in relation to police investigations in seizable cases as provided for under the Criminal Procedure Code [Act 593], and such powers shall be in addition to the powers provided for under this Act and not in derogation thereof. Search and seizure with warrant"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_51",
      "@type": "akn:clause",
      "eli:number": "51",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_51__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_51__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_51__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_51__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_51__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_51__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_51__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_51__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_51__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_51__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_51",
      "schema:text": {
        "@language": "en",
        "@value": "If it appears to a Magistrate, upon written information on oath from the authorized officer and after such inquiry as the Magistrate considers necessary, that there is reasonable cause to believe that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_51__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_51__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any premises or conveyance has been used for; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_51__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_51__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "there is in any premises or conveyance evidence necessary to the conduct of an investigation into, the commission of an offence under this Act, the Magistrate may issue a warrant authorizing the authorized officer named in the warrant at any reasonable time by day or night and with or without assistance, to enter the premises or conveyance and if need be by force."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_51__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_51",
      "schema:text": {
        "@language": "en",
        "@value": "Without affecting the generality of subsection (1), the warrant issued by the Magistrate may authorize the search and seizure of any medical device, book, document, computerized data, apparatus, equipment, device, machinery, vehicle, matter or thing including in digital form which is reasonably believed to furnish evidence of the commission of the offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_51__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_51",
      "schema:text": {
        "@language": "en",
        "@value": "An authorized officer conducting a search under subsection (1) may, for the purpose of investigating into the offence, search any person who is in or on the premises or conveyance."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_51__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_51",
      "schema:text": {
        "@language": "en",
        "@value": "An authorized officer making a search of a person under subsection (3) or section 52 may seize or take possession of, and place in safe custody all things other than the necessary clothing found upon the person, and any of those things of which there is reason to believe were the instruments or other evidence of the offence may be detained until the discharge or acquittal of the person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_51__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_51",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall be searched except by another person of the same gender, and such search shall be conducted with strict regard to decency."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_51__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_51",
      "schema:text": {
        "@language": "en",
        "@value": "If, by reason of its nature, size or amount, it is not practicable to remove any medical device, book, document, computerized data, apparatus, equipment, device, machinery, vehicle, matter or thing including in digital form seized under this section, the authorized officer shall by any means seal such medical device, book, document, computerized data, apparatus, equipment, device, machinery, vehicle, matter or thing including in digital form in the premises or conveyance in which it is found."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_51__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_51",
      "schema:text": {
        "@language": "en",
        "@value": "A person who, without lawful authority, breaks, tampers with or damages the seal referred to in subsection (6) or removes any medical device, book, document, computerized data, apparatus, equipment, device, machinery, vehicle, matter or thing including in digital form under seal or attempts to do so commits an offence and shall, on conviction, be liable to a fine not exceeding five hundred thousand ringgit or to imprisonment for a term not exceeding three years or to both. Search and seizure without warrant"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_52",
      "@type": "akn:clause",
      "eli:number": "52",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "If an authorized officer is satisfied upon information received that he has reasonable cause to believe that by reason of delay in obtaining a search warrant under section 51 the investigation would be adversely affected or evidence of the commission of an offence is likely to be tampered with, removed, damaged or destroyed, the authorized officer may enter the premises or conveyance and exercise in, upon and in respect of the premises or conveyance all the powers referred to in section 51 in as full and ample a manner as if he were authorized to do so by a warrant issued under that section. Access to computerized data"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_53",
      "@type": "akn:clause",
      "eli:number": "53",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_53__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_53__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_53__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_53",
      "schema:text": {
        "@language": "en",
        "@value": "An authorized officer conducting a search under sections 51 and 52 shall be given access to computerized data whether stored in a computer or otherwise."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_53__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_53__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_53__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_53",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this section, “access”—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_53__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_53__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "includes being provided with the necessary password, encryption code, decryption code, software or hardware and any other means required to enable comprehension of computerized data; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_53__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_53__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "has the meaning assigned to it in subsections 2(2) and (5) of the Computer Crimes Act 1997 [Act 563]. Warrant admissible notwithstanding defects"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_54",
      "@type": "akn:clause",
      "eli:number": "54",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "A search warrant issued under this Act shall be valid and enforceable notwithstanding any defect, mistake or omission therein or in the application for such warrant, and any medical device, book, document, computerized data, apparatus, equipment, device, machinery, vehicle, matter or thing including in digital form seized under such warrant shall be admissible in evidence in any proceedings under this Act. List of medical device, book, document, etc., seized"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_55",
      "@type": "akn:clause",
      "eli:number": "55",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_55__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_55__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_55__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_55__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_55__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_55__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_55",
      "schema:text": {
        "@language": "en",
        "@value": "Except as provided in subsection (2), where any medical device, book, document, computerized data, apparatus, equipment, device, machinery, vehicle, matter or thing including in digital form is seized pursuant to this Act, the authorized officer making the seizure—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_55__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_55__subsec_1__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_55__subsec_1__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_55__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "shall prepare—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_55__subsec_1__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_55__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "a list of the medical device, book, document, computerized data, apparatus, equipment, device, machinery, vehicle, matter or thing including in digital form seized and shall sign the list; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_55__subsec_1__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_55__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "a written notice of the seizure containing the grounds for the seizure and shall sign the notice; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_55__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_55__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "shall as soon as practicable serve a copy of the list of the medical device, book, document, computerized data, apparatus, equipment, device, machinery, vehicle, matter or thing including in digital form seized and the written notice of the seizure to the occupier of the premises which have been searched, or to his agent or servant at those premises."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_55__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_55",
      "schema:text": {
        "@language": "en",
        "@value": "The written notice of the seizure shall not be required to be served in pursuance of paragraph (1)(b) where the seizure is made in the presence of the person against whom proceedings under this Act are intended to be taken, or in the presence of the owner of such property or his agent, as the case may be."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_55__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_55",
      "schema:text": {
        "@language": "en",
        "@value": "If the premises is unoccupied, the authorized officer shall post a copy of the list of the medical device, book, document, computerized data, apparatus, equipment, device, machinery, vehicle, matter or thing including in digital form seized conspicuously on the premises. Release of medical device, book, document, etc., seized"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_56",
      "@type": "akn:clause",
      "eli:number": "56",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_56__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_56__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_56__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_56",
      "schema:text": {
        "@language": "en",
        "@value": "If any medical device, book, document, computerized data, apparatus, equipment, device, machinery, vehicle, matter or thing including in digital form has been seized under this Act, the authorized officer who effected the seizure may, after referring to the Public Prosecutor, release the medical device, book, document, computerized data, apparatus, equipment, device, machinery, vehicle, matter or thing including in digital form to the person determined by him to be lawfully entitled to it, if the medical device, book, document, computerized data, apparatus, equipment, device, machinery, vehicle, matter or thing including in digital form is not liable to forfeiture under this Act, and is not otherwise required for the purpose of any proceedings under this Act or for the purpose of any prosecution under any other written law, and in such event neither the authorized officer effecting the seizure, nor the Federal Government, the Authority or any person acting on behalf of the Federal Government or Authority shall be liable to any proceedings by any person if the seizure and the release of the medical device, book, document, computerized data, apparatus, equipment, device, machinery, vehicle, matter or thing including in digital form had been effected in good faith."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_56__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_56",
      "schema:text": {
        "@language": "en",
        "@value": "A record in writing shall be made by the authorized officer effecting the release of the medical device, book, document, computerized data, apparatus, equipment, device, machinery, vehicle, matter or thing including in digital form under subsection (1) specifying in detail the circumstances of and the reason for the release, and he shall send a copy of the record to the Public Prosecutor within seven days of the release. No costs or damages arising from seizure to be recoverable"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_57",
      "@type": "akn:clause",
      "eli:number": "57",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall, in any proceedings before any court in respect of any medical device, book, document, computerized data, apparatus, equipment, device, machinery, vehicle, matter or thing including in digital form seized in the exercise or the purported exercise of any power conferred under this Act, be entitled to the costs of such proceedings or to any damages or other relief unless such seizure was made without reasonable cause. Cost of holding seized medical device, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_58",
      "@type": "akn:clause",
      "eli:number": "58",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "If any medical device, book, document, computerized data, apparatus, equipment, device, machinery, vehicle, matter or thing including in digital form seized under this Act is held in the custody of the Authority pending the completion of any proceedings in respect of an offence under this Act, the cost of holding it in custody shall, irrespective of whether any prosecution is instituted or otherwise against any person, be a civil debt due to the Government by such person and shall be recoverable accordingly. Obstruction to search"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_59",
      "@type": "akn:clause",
      "eli:number": "59",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_59__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_59__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_59__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V",
      "schema:name": {
        "@language": "en",
        "@value": "Any person who—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_59__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_59",
      "schema:text": {
        "@language": "en",
        "@value": "refuses any authorized officer access to any premises or conveyance which the authorized officer is entitled to have access to under this Act or in the execution of any duty imposed or power conferred by this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_59__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_59",
      "schema:text": {
        "@language": "en",
        "@value": "assaults, obstructs, hinders or delays any authorized officer in effecting any entry which the authorized officer is entitled to effect under this Act, or in the execution of any duty imposed or power conferred by this Act; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_59__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_59",
      "schema:text": {
        "@language": "en",
        "@value": "refuses any authorized officer any information relating to an offence or suspected offence under this Act or any other information which may reasonably be required of him and which he has in his knowledge or power to give, commits an offence and shall, on conviction, be liable to a fine not exceeding five hundred thousand ringgit or to imprisonment for a term not exceeding three years or to both. Power to require attendance of persons acquainted with case"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_60",
      "@type": "akn:clause",
      "eli:number": "60",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_60__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_60__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_60__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_60",
      "schema:text": {
        "@language": "en",
        "@value": "An authorized officer making an investigation under this Act may, by order in writing, require the attendance before himself of any person who appears to the authorized officer to be acquainted with the facts and circumstances of the case, and such person shall attend as so required."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_60__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_60",
      "schema:text": {
        "@language": "en",
        "@value": "If any person refuses or fails to attend as so required, the authorized officer may report such refusal or failure to a Magistrate who shall issue a summons to secure the attendance of such person as may be required by the order made under subsection (1). Examination of persons acquainted with case"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_61",
      "@type": "akn:clause",
      "eli:number": "61",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_61__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_61__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_61__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_61__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_61__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_61__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_61",
      "schema:text": {
        "@language": "en",
        "@value": "An authorized officer making an investigation under this Act may examine orally any person supposed to be acquainted with the facts and circumstances of the case."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_61__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_61",
      "schema:text": {
        "@language": "en",
        "@value": "Such person shall be bound to answer all questions relating to the case put to him by the authorized officer, but he may refuse to answer any question the answer to which would have a tendency to expose him to a criminal charge or penalty or forfeiture."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_61__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_61",
      "schema:text": {
        "@language": "en",
        "@value": "A person making a statement under this section shall be legally bound to state the truth, whether or not such statement is made wholly or partly in answer to questions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_61__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_61",
      "schema:text": {
        "@language": "en",
        "@value": "The authorized officer examining a person under subsection (1) shall first inform that person of the provisions of subsections (2) and (3)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_61__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_61",
      "schema:text": {
        "@language": "en",
        "@value": "A statement made by any person under this section shall, whenever possible, be reduced into writing and signed by the person making it or affixed with his thumb print, as the case may be, after it has been read to him in the language in which he made it and after he has been given an opportunity to make any corrections he may wish. Admission of statements in evidence"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_62",
      "@type": "akn:clause",
      "eli:number": "62",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_62__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_62__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_62__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_62__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_62__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_62__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_62",
      "schema:text": {
        "@language": "en",
        "@value": "Except as provided in this section, no statement made by any person to an authorized officer in the course of an investigation made under this Act shall be used in evidence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_62__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_62",
      "schema:text": {
        "@language": "en",
        "@value": "When any witness is called for the prosecution or for the defence, other than the accused, the court shall, on the request of the accused or the prosecutor, refer to any statement made by that witness to the authorized officer in the course of investigation under this Act and may then, if the courts thinks fit in the interest of justice, direct the accused to be furnished with a copy of it and the statement may be used to impeach the credit of the witness in the manner provided by the Evidence Act 1950 [Act 56]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_62__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_62",
      "schema:text": {
        "@language": "en",
        "@value": "Where the accused had made a statement during the course of an investigation, such statement may be admitted in evidence in support of his defence during the course of the trial."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_62__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_62",
      "schema:text": {
        "@language": "en",
        "@value": "Nothing in this section shall be deemed to apply to any statement made in the course of an identification parade or falling within section 27 or paragraphs 32(1)(a), (i) and (j) of the Evidence Act 1950."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_62__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_62__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_62__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_62",
      "schema:text": {
        "@language": "en",
        "@value": "When any person is charged with any offence in relation to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_62__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_62__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "the making; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_62__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_62__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "the contents, of any statement made by him to an authorized officer in the course of an investigation made under this Act, that statement may be used as evidence in the prosecution’s case. Forfeiture of seized medical device, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_63",
      "@type": "akn:clause",
      "eli:number": "63",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "(1) Any medical device, book, document, computerized data, apparatus, equipment, device, machinery, vehicle, matter or thing including in digital form seized in exercise of any power conferred by this Act shall be liable to forfeiture. (2) An order for the forfeiture of the medical device, book, document, computerized data, apparatus, equipment, device, machinery, vehicle, matter or thing including in digital form seized and liable to forfeiture under this Act shall be made by the court before which the prosecution with regard thereto has been held if it is proved to the satisfaction of the court that an offence under this Act has been committed and that the medical device, book, document, computerized data, apparatus, equipment, device, machinery, vehicle, matter or thing including in digital form seized was the subject matter of or was used in the commission of the offence, notwithstanding that no person has been convicted of such offence. (3) If there is no prosecution with regard to any medical device, book, document, computerized data, apparatus, equipment, device, machinery, vehicle, matter or thing including in digital form seized under this Act, such medical device, book, document, computerized data, apparatus, equipment, device, machinery, vehicle, matter or thing including in digital form shall be taken and deemed to be forfeited at the expiration of a period of one calendar month from the date of service of a notice to the last- known address of the person from whom the medical device, book, document, computerized data, apparatus, equipment, device, machinery, vehicle, matter or thing including in digital form was seized indicating that there is no prosecution in respect of such medical device, book, document, computerized data, apparatus, equipment, device, machinery, vehicle, matter or thing including in digital form, unless before the expiration of that period a claim thereto is made in the manner set out in subsections (4), (5) and (6) . (4) Any person asserting that he is the owner of the medical device, book, document, computerized data, apparatus, equipment, device, machinery, vehicle, matter or thing including in digital form referred to in subsection (3) and that it is not liable to forfeiture may, personally or by his agent authorized in writing, give written notice to the authorized officer in whose possession such medical device, book, document, computerized data, apparatus, equipment, device, machinery, vehicle, matter or thing including in digital form is held that he claims the medical device, book, document, computerized data, apparatus, equipment, device, machinery, vehicle, matter or thing including in digital form. (5) On receipt of the notice under subsection (4), the authorized officer shall refer the matter to a Magistrate for his decision. (6) The Magistrate to whom the matter is referred under subsection (5) shall issue a summons requiring the person asserting that he is the owner of the medical device, book, document, computerized data, apparatus, equipment, device, machinery, vehicle, matter or thing including in digital form and the person from whom it was seized to appear before the Magistrate, and upon their appearance or default to appear, due service of the summons having been proved, the Magistrate shall proceed to the examination of the matter and, on proof that an offence under this Act has been committed and that medical device, book, document, computerized data, apparatus, equipment, device, machinery, vehicle, matter or thing including in digital form seized was the subject matter of or was used in the commission of such offence, the Magistrate shall order the medical device, book, document, computerized data, apparatus, equipment, device, machinery, vehicle, matter or thing including in digital form to be forfeited, and shall, in the absence of such proof, order its release. (7) Any medical device, book, document, computerized data, apparatus, equipment, device, machinery, vehicle, matter or thing including in digital form forfeited or deemed to be forfeited shall be delivered to the Authority and shall be disposed of in such manner as the Authority thinks fit. (8) The Authority may direct that any thing seized under this Act be sold at any time and the proceeds of the sale be held pending the result of any prosecution or claim under this section if— (a) it is of a perishable nature or is subject to speedy and natural decay; (b) the custody of the thing involves unreasonable expense and inconvenience; or (c) it is believed to cause obstruction or hazard to the public. Power of arrest"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_64",
      "@type": "akn:clause",
      "eli:number": "64",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_64__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_64__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_64__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_64",
      "schema:text": {
        "@language": "en",
        "@value": "An authorized officer or police officer may arrest without warrant any person whom he reasonably believes has committed or is attempting to commit an offence under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_64__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_64",
      "schema:text": {
        "@language": "en",
        "@value": "An authorized officer making an arrest under subsection (1) shall without unnecessary delay make over the person so arrested to the nearest police officer or, in the absence of a police officer, take such person to the nearest police station, and thereafter the person shall be dealt with as is provided for by the law relating to criminal procedure for the time being in force as if he had been arrested by a police officer. Power to take sample"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_65",
      "@type": "akn:clause",
      "eli:number": "65",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_65__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_65__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_65__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_65__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_65__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_65__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_65",
      "schema:text": {
        "@language": "en",
        "@value": "An authorized officer may demand, select, take or obtain samples of any medical device in the prescribed manner for the purposes of analysis—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_65__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_65__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "upon payment, from any person selling the medical device, or his or its agent or servant; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_65__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_65__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "without payment, from any establishment of the medical device or its agent or servant."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_65__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_65",
      "schema:text": {
        "@language": "en",
        "@value": "The analysis of the samples shall be done in the prescribed manner."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_65__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_65",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who refuses to comply with any demand made by an authorized officer under subsection (1) commits an offence and shall, on conviction, be liable to a fine not exceeding one hundred thousand ringgit or to imprisonment for a term not exceeding one year or to both. Appointment of analyst"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V__cl_66",
      "@type": "akn:clause",
      "eli:number": "66",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "The Authority may appoint any qualified person to be an analyst for the purposes of carrying out an analysis under this Act."
      }
    }
  ]
}
