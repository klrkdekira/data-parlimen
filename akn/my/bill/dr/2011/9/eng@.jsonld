        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_43__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_43__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/eng@/~part_III__chp_4__cl_43__subsec_4",
