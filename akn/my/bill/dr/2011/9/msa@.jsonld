    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_67__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_67__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_67__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_67__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_67__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_67__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_67__subsec_1__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_67",
      "schema:text": {
        "@language": "ms",
        "@value": "pihak berkuasa hendaklah menyebabkan supaya disimpan dan disenggarakan suatu daftar yang mengandungi—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_67__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_67__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "semua peranti perubatan yang didaftarkan di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_67__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_67__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "semua badan penilaian pematuhan yang didaftarkan di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_67__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_67__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "semua lesen dan permit yang diberikan oleh pihak berkuasa;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_67__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_67__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "semua keputusan yang dibuat oleh pihak berkuasa untuk membatalkan pendaftaran sesuatu peranti perubatan atau badan penilaian pematuhan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_67__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_67__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "semua keputusan pihak berkuasa untuk membatalkan dan menggantung lesen atau permit; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_67__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_67__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa perkara atau data lain sebagaimana yang ditentukan oleh pihak berkuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_67__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_67",
      "schema:text": {
        "@language": "ms",
        "@value": "Daftar itu hendaklah disifatkan sebagai suatu dokumen awam mengikut pengertian Akta Keterangan 1950 dan hendaklah terbuka untuk pemeriksaan awam dan orang awam boleh membuat carian pada dan mendapatkan cabutan daripada daftar itu apabila fi yang ditetapkan dibayar. Maklumat sulit perniagaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_68",
      "@type": "akn:clause",
      "eli:number": "68",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_68__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_68__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_68__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_68__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_68__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_68",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang yang membuat sesuatu permohonan atau memberikan apa-apa maklumat di bawah Akta ini boleh memohon kepada pihak berkuasa bagi kerahsiaan apa-apa maklumat tertentu yang berhubungan dengan permohonan atau pemberian maklumat itu, mengikut mana-mana yang berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_68__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_68",
      "schema:text": {
        "@language": "ms",
        "@value": "pihak berkuasa boleh membenarkan kerahsiaan berdasarkan kriteria di bawah subseksyen (3), dan jika kerahsiaan dibenarkan, maklumat itu tidak boleh didedahkan kepada umum."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_68__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_68__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_68__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_68__subsec_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_68__subsec_3__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_68",
      "schema:text": {
        "@language": "ms",
        "@value": "pihak berkuasa hendaklah menimbangkan tuntutan bagi kerahsiaan mengikut kriteria yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_68__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_68__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa maklumat itu tidak diketahui secara umum di kalangan, atau tidak tersedia untuk diakses oleh, orang dalam kelompok yang lazimnya berurusan dengan jenis maklumat yang hendak dijadikan rahsia itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_68__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_68__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa maklumat itu mempunyai nilai komersial;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_68__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_68__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa langkah-langkah yang munasabah telah diambil untuk memastikan maklumat itu sulit; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_68__subsec_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_68__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa penzahiran maklumat itu akan memudaratkan kedudukan persaingan orang itu dengan cara yang berlawanan dengan amalan komersial yang jujur."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_68__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_68",
      "schema:text": {
        "@language": "ms",
        "@value": "pihak berkuasa hendaklah mempunyai kuasa untuk membatalkan kerahsiaan yang dibenarkan keseluruhannya atau sebahagiannya demi kepentingan kesihatan awam. Penzahiran awam"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_69",
      "@type": "akn:clause",
      "eli:number": "69",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "tertakluk kepada budi bicara pihak berkuasa, orang awam boleh mempunyai akses kepada aa-apa maklumat yang berhubungan dengan apa-apa permohonan atau pemberian maklumat di bawah Akta ini, yang tidak dibenarkan kerahsiaan di bawah seksyen 68 atau yang berkenaan dengannya pihak berkuasa telah membatalkan kerahsiaannya di bawah subseksyen 68(4), mengikut cara yang difikirkan sesuai oleh pihak berkuasa. Pelan gerak balas kecemasan dan bantuan daripada pelbagai agensi semasa kecemasan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_70",
      "@type": "akn:clause",
      "eli:number": "70",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_70__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_70__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_70__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_70__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_70__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_70__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_70",
      "schema:text": {
        "@language": "ms",
        "@value": "pihak berkuasa boleh menghendaki, sebagai sebahagian daripada proses untuk mengeluarkan lesen atau permit peranti perubatan yang ditetapkan, atau selainnya, mana-mana orang supaya menyediakan langkah-langkah perlu untuk diambil sekiranya berlaku suatu kecemasan bagi perlindungan orang awam daripada bahaya atau kerosakan yang disebabkan oleh sesuatu peranti perubatan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_70__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_70",
      "schema:text": {
        "@language": "ms",
        "@value": "pihak berkuasa hendaklah menghantar pelan gerak balas kecemasan yang dikemukakan di bawah subseksyen (1) kepada semua agensi yang berkaitan untuk tindakan mereka yang perlu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_70__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_70",
      "schema:text": {
        "@language": "ms",
        "@value": "sekiranya berlaku apa-apa kecemasan yang melibatkan mana-mana peranti perubatan, pihak berkuasa boleh mendapatkan bantuan dan kerjasama daripada agensi-agensi yang berkaitan dalam melaksanakan apa-apa langkah kecemasan termasuk langkah- langkah yang terdapat dalam pelan gerak balas kecemasan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_70__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_70",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa kos yang ditanggung oleh mana-mana agensi dalam melaksanakan apa-apa langkah kecemasan hendaklah ditanggung oleh pemegang lesen atau pemegang permit peranti perubatan yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_70__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_70",
      "schema:text": {
        "@language": "ms",
        "@value": "tiada apa-apa jua dalam seksyen ini boleh melepaskan atau disifatkan sebagai melepaskan pemegang lesen atau pemegang permit peranti perubatan yang ditetapkan daripada apa-apa obligasinya untuk mengambil segala langkah yang perlu sekiranya berlaku apa-apa kecemasan. Pengkompaunan kesalahan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_71",
      "@type": "akn:clause",
      "eli:number": "71",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_71__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_71__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_71__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_71__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_71__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_71",
      "schema:text": {
        "@language": "ms",
        "@value": "pihak berkuasa boleh, dengan keizinan pendakwa Raya, mengkompaun apa-apa kesalahan yang dilakukan oleh mana-mana orang di bawah Akta ini dan yang ditetapkan sebagai kesalahan boleh kompaun oleh peraturan-peraturan yang dibuat di bawah Akta ini dengan membuat suatu tawaran bertulis kepada orang itu untuk mengkompaunkan kesalahan itu apabila dibayar kepada pihak berkuasa suatu amaun yang tidak melebihi lima puluh peratus daripada amaun denda maksimum bagi kesalahan itu dalam masa yang dinyatakan dalam tawaran itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_71__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_71",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu tawaran di bawah subseksyen (1) boleh dibuat pada bila-bila masa selepas kesalahan itu dilakukan, tetapi sebelum apa-apa pendakwaan baginya dimulakan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_71__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_71",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika amaun yang dinyatakan dalam tawaran yang dibuat di bawah subseksyen (1) itu tidak dibayar dalam masa yang dinyatakan dalam tawaran itu atau dalam apa-apa tempoh lanjutan yang diberikan oleh pihak berkuasa, pendakwaan bagi kesalahan itu boleh dimulakan pada bila-bila masa selepas itu terhadap orang yang kepadanya tawaran itu dibuat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_71__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_71",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika sesuatu kesalahan telah dikompaun di bawah subseksyen (1), tiada pendakwaan boleh dimulakan berkenaan dengan kesalahan itu terhadap orang yang kepadanya tawaran mengkompaun kesalahan itu dibuat. Pendakwaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_72",
      "@type": "akn:clause",
      "eli:number": "72",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "tiada pendakwaan bagi mana-mana kesalahan di bawah Akta ini atau mana-mana peraturan yang dibuat di bawah Akta ini boleh dimulakan kecuali oleh atau dengan keizinan bertulis pendakwa Raya. Kesalahan oleh pertubuhan perbadanan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_73",
      "@type": "akn:clause",
      "eli:number": "73",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_73__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_73__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika sesuatu pertubuhan perbadanan melakukan suatu kesalahan di bawah Akta ini, mana-mana orang yang pada masa pelakuan kesalahan itu ialah seorang pengarah, pengurus, setiausaha atau pegawai lain yang seumpamanya dalam pertubuhan perbadanan itu atau yang berupa bertindak atas apa-apa sifat sedemikian atau yang mengikut apa-apa cara atau sehingga apa-apa takat bertanggungjawab bagi pengurusan apa-apa hal ehwal pertubuhan perbadanan itu atau yang membantu dalam pengurusan sedemikian—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_73__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_73",
      "schema:text": {
        "@language": "ms",
        "@value": "boleh dipertuduh secara berasingan atau bersesama dalam prosiding yang sama bersekali dengan pertubuhan perbadanan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_73__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_73__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_73__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_73",
      "schema:text": {
        "@language": "ms",
        "@value": "jika pertubuhan perbadanan itu didapati bersalah melakukan kesalahan itu, hendaklah disifatkan bersalah terhadap kesalahan itu melainkan jika, dengan mengambil kira jenis fungsinya atas sifat itu dan segala hal keadaan, dia membuktikan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_73__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_73__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa kesalahan itu telah dilakukan tanpa pengetahuannya, persetujuannya atau pembiarannya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_73__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_73__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa dia telah mengambil segala langkah pencegahan yang munasabah dan telah menjalankan usaha yang wajar untuk mengelakkan pelakuan kesalahan itu. Kesalahan oleh pekongsi, ejen atau pekhidmat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_74",
      "@type": "akn:clause",
      "eli:number": "74",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_74__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_74__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang boleh dikenakan apa-apa penalti di bawah Akta ini bagi apa-apa perbuatan, peninggalan, pengabaian atau keingkaran jika perbuatan, peninggalan, pengabaian atau keingkaran itu dilakukan olehnya sendiri boleh dikenakan penalti yang sama jika perbuatan, peninggalan, pengabaian atau keingkaran itu dilakukan oleh pekongsi, ejen atau pekhidmatnya melainkan jika dia membuktikan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_74__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_74",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa perbuatan, peninggalan, pengabaian atau keingkaran itu dilakukan tanpa pengetahuannya, persetujuannya atau pembiarannya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_74__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_74",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa dia telah mengambil segala langkah pencegahan yang munasabah dan telah menjalankan usaha yang wajar untuk mengelakkan perbuatan, peninggalan, pengabaian atau keingkaran itu. Penyampaian dokumen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_75",
      "@type": "akn:clause",
      "eli:number": "75",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_75__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_75__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_75__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_75__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_75__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_75__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_75",
      "schema:text": {
        "@language": "ms",
        "@value": "penyampaian sesuatu dokumen kepada mana-mana orang hendaklah dilaksanakan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_75__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_75__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menghantar serah dokumen itu kepada orang itu atau dengan menghantar serah dokumen itu kepada seseorang anggota keluarganya yang dewasa di tempat kediaman orang itu yang terakhir diketahui;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_75__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_75__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan meninggalkan dokumen itu di tempat kediaman atau tempat perniagaan orang itu yang lazim atau yang terakhir diketahui dalam suatu sampul yang dialamatkan kepada orang itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_75__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_75__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menghantar dokumen itu melalui pos berdaftar yang dialamatkan kepada orang itu di tempat kediamannya atau tempat perniagaannya yang lazim atau yang terakhir diketahui."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_75__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_75__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_75__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_75",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu dokumen yang dikehendaki disampaikan kepada pemunya atau penghuni mana-mana premis—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_75__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_75__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah disifatkan telah dialamatkan dengan sepatutnya jika dialamatkan dengan perihalan “pemunya” atau “penghuni” premis itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_75__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_75__subsec_2__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_75__subsec_2__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_75__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "boleh disampaikan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_75__subsec_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_75__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menghantar serah dokumen itu kepada seorang dewasa yang berada di premis itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_75__subsec_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_75__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "jika tiada orang sedemikian di premis itu yang kepadanya dokumen itu boleh dengan usaha yang munasabah dihantarserahkan, melalui pengiklanan sekurang-kurangnya dalam satu akhbar tempatan. Perisytiharan palsu"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_76",
      "@type": "akn:clause",
      "eli:number": "76",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_76__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_76__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_76__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_76",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang membuat, secara lisan atau bertulis, menandatangani atau memberikan apa-apa perisytiharan, penyata, perakuan atau dokumen atau maklumat lain yang dikehendaki di bawah Akta ini yang tidak benar, tidak tepat atau mengelirukan mengenai apa-apa butiran melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi satu ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi dua tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_76__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_76__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_76__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_76",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_76__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_76__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "tanpa kuasa yang sah mengubah, memalsukan, mencacatkan atau merosakkan apa-apa pendaftaran, lesen atau permit; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_76__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_76__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menggunakan apa-apa pendaftaran, lesen atau permit yang diketahuinya telah diubah, dipalsukan, dicacatkan atau dirosakkan, melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tiga tahun atau kedua-duanya. Kuasa untuk mengecualikan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_77",
      "@type": "akn:clause",
      "eli:number": "77",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_77__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_77__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_77__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_77",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, jika didapatinya selaras dengan maksud Akta ini atau demi kepentingan kesihatan dan keselamatan awam, melalui perintah yang disiarkan dalam Warta, mengecualikan mana-mana orang atau peranti perubatan daripada mana-mana peruntukan Akta ini atau mana-mana peraturan yang dibuat di bawah Akta ini bagi apa-apa tempoh dan tertakluk kepada apa-apa syarat yang ditentukan oleh Menteri dan Menteri boleh mengubah atau menambah syarat-syarat yang ditentukan sedemikian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_77__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_77",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, pada bila-bila masa, melalui perintah yang disiarkan dalam Warta, membatalkan mana-mana perintah yang dibuat di bawah subseksyen (1) jika dia berpuas hati bahawa pengecualian itu tidak lagi diperlukan. Penalti am"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_78",
      "@type": "akn:clause",
      "eli:number": "78",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melakukan suatu kesalahan di bawah Akta ini yang baginya tiada penalti diperuntukkan dengan nyata boleh, apabila disabitkan, didenda tidak melebihi lima ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tiga tahun atau kedua-duanya. Peraturan-peraturan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_79",
      "@type": "akn:clause",
      "eli:number": "79",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_79__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_79__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_79__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_79__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_79",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh membuat apa-apa peraturan sebagaimana yang suai manfaat atau perlu bagi menjalankan peruntukan Akta ini dengan lebih baik."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_79__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_79__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_79__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_79__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_79__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_79__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_79__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_79__subsec_2__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_79__subsec_2__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_79__subsec_2__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_79__subsec_2__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_79__subsec_2__para_k",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_79__subsec_2__para_l",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_79__subsec_2__para_m",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_79__subsec_2__para_n"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_79",
      "schema:text": {
        "@language": "ms",
        "@value": "tanpa menjejaskan keluasan subseksyen (1), peraturan- peraturan boleh dibuat bagi maksud yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_79__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_79__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan cara permohonan bagi pendaftaran sesuatu peranti perubatan atau badan penilaian pematuhan, lesen atau permit, dan untuk memperuntukkan bagi pembatalan pendaftaran itu, dan penggantungan dan pembatalan lesen atau permit itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_79__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_79__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan kriteria pengkelasan risiko, cara pengkelasan dan kaedah-kaedah pengkelasan peranti perubatan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_79__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_79__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan prinsip-prinsip reka bentuk dan pembuatan peranti perubatan, prinsip reka bentuk yang baik berhubungan dengan penghapusan atau pengurangan risiko, dan prinsip pembuatan yang baik berhubungan dengan piawaian, keselamatan dan keberkesanan peranti perubatan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_79__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_79__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan segala perkara yang berhubungan dengan pembungkusan, pelabelan dan penandaan peranti perubatan bagi maksud pengenalan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_79__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_79__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan tatacara dan kriteria bagi penilaian pematuhan peranti perubatan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_79__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_79__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan piawaian penilaian pematuhan bagi pelbagai kelas atau kategori peranti perubatan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_79__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_79__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan cara bagi penyimpanan dan penyenggaraan daftar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_79__subsec_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_79__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan perkara yang berhubungan dengan kandungan dan syarat-syarat bagi pengiklanan peranti perubatan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_79__subsec_2__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_79__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan cara penyenggaraan dan kandungan bagi rekod pengedaran peranti perubatan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_79__subsec_2__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_79__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan kriteria, syarat-syarat dan tatacara bagi pemantauan dan pengawasan pascapasaran, pengendalian aduan, pelaporan masalah mandatori, tindakan pembetulan di lapangan dan penggunaan, penggendalian, pemasangan, pengujian, pentauliahan, penyenggaraan dan pelupusan peranti perubatan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_79__subsec_2__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_79__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan tatacara bagi panggilan balik secara sukarela oleh sesuatu establismen, kriteria, syarat-syarat dan tatacara bagi panggilan balik secara mandatori oleh pihak berkuasa, memberhentikan peranti perubatan daripada beroperasi dan pelupusan peranti perubatan yang tidak lagi selamat untuk digunakan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_79__subsec_2__para_l",
      "@type": "akn:paragraph",
      "eli:number": "l",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_79__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan perkara yang berhubungan dengan permit eksport termasuk kriteria, syarat-syarat dan tatacara bagi permohonan permit eksport peranti perubatan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_79__subsec_2__para_m",
      "@type": "akn:paragraph",
      "eli:number": "m",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_79__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan kehendak kompetensi bagi orang yang menggunakan, mengendalikan, memasangkan, menguji, mentauliahkan, menyenggarakan dan melupuskan peranti perubatan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_79__subsec_2__para_n",
      "@type": "akn:paragraph",
      "eli:number": "n",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_79__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan fi dan caj yang kena dibayar di bawah Akta ini dan cara bagi mengutip dan menguruskan fi dan caj itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_79__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_79",
      "schema:text": {
        "@language": "ms",
        "@value": "peraturan-peraturan yang dibuat di bawah Akta ini boleh memperuntukkan bagi apa-apa tindakan atau peninggalan yang melanggar peraturan-peraturan itu menjadi suatu kesalahan dan boleh memperuntukkan penalti denda tidak melebihi dua ratus ribu ringgit atau pemenjaraan selama tempoh tidak melebihi dua tahun atau kedua-duanya. Kecualian dan peralihan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_80",
      "@type": "akn:clause",
      "eli:number": "80",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_80__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_80__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_80__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_80__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_80",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang yang, sebelum tarikh yang ditetapkan, telah mengimport, mengeksport atau meletakkan dalam pasaran peranti perubatan hendaklah, dalam tempoh dua puluh empat bulan dari tarikh yang ditetapkan, memohon bagi pendaftaran peranti perubatan itu di bawah seksyen 6."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_80__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_80",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang yang, sebelum tarikh yang ditetapkan, telah mengimport, mengeksport atau meletakkan dalam pasaran peranti perubatan dan berniat untuk terus mengimport, mengeksport atau meletakkan dalam pasaran peranti perubatan sedemikian hendaklah, dalam tempoh dua belas bulan dari tarikh yang ditetapkan, memohon lesen establismen di bawah seksyen 16."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_80__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_VI__cl_80",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang yang disebut dalam subseksyen (1) atau (2) boleh terus mengimport, mengeksport atau meletakkan dalam pasaran peranti perubatan sementara menunggu keputusan permohonannya bagi pendaftaran sesuatu peranti perubatan atau bagi lesen establismen, mengikut mana-mana yang berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_48",
      "@type": "akn:clause",
      "eli:number": "48",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_48__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_48__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_48__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_48",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, secara bertulis, memberi kuasa kepada mana-mana pegawai pihak berkuasa atau pegawai awam untuk menjalankan kuasa penguatkuasaan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_48__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_48",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pegawai sedemikian hendaklah disifatkan sebagai seorang pekhidmat awam mengikut pengertian Kanun Keseksaan [Akta 574]. Kad kuasa"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_49",
      "@type": "akn:clause",
      "eli:number": "49",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_49__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_49__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_49__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_49",
      "schema:text": {
        "@language": "ms",
        "@value": "pihak berkuasa hendaklah mengeluarkan kepada setiap pegawai diberi kuasa suatu kad kuasa yang hendaklah ditandatangani oleh Ketua eksekutif pihak berkuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_49__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_49",
      "schema:text": {
        "@language": "ms",
        "@value": "bilamana pegawai diberi kuasa menjalankan mana-mana kuasa penguatkuasaan di bawah Akta ini, dia hendaklah apabila diminta menunjukkan kepada orang yang terhadapnya kuasa itu sedang dijalankan kad kuasa yang dikeluarkan kepadanya di bawah subseksyen (1). Kuasa penyiasatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_50",
      "@type": "akn:clause",
      "eli:number": "50",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_50__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_50__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_50__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_50",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang pegawai diberi kuasa boleh menyiasat pelakuan apa-apa kesalahan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_50__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_50",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi mengelakkan keraguan, diisytiharkan bahawa bagi maksud Akta ini, pegawai diberi kuasa hendaklah mempunyai segala atau mana-mana kuasa seorang pegawai polis tidak kira apa jua pangkat berhubung dengan penyiasatan polis dalam kes boleh ditangkap sebagaimana yang diperuntukkan di bawah Kanun tatacara Jenayah [Akta 593], dan kuasa itu adalah sebagai tambahan kepada kuasa yang diperuntukkan di bawah Akta ini dan bukan pengurangan baginya. Penggeledahan dan penyitaan dengan waran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_51",
      "@type": "akn:clause",
      "eli:number": "51",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_51__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_51__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_51__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_51__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_51__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_51__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_51__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_51__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_51__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_51__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_51",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika ternyata pada Majistret, atas maklumat bersumpah bertulis daripada pegawai diberi kuasa dan selepas apa-apa siasatan sebagaimana yang didapati perlu oleh Majistret, bahawa terdapat sebab yang munasabah untuk mempercayai bahawa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_51__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_51__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana premis atau pengangkut telah digunakan bagi; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_51__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_51__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "ada di dalam mana-mana premis atau pengangkut keterangan yang perlu untuk menjalankan suatu penyiasatan mengenai, pelakuan suatu kesalahan di bawah Akta ini, Majistret boleh mengeluarkan waran yang memberi kuasa pegawai diberi kuasa yang dinamakan dalam waran itu pada bila-bila masa yang munasabah pada waktu siang atau malam dan dengan atau tanpa bantuan, untuk memasuki premis atau pengangkut itu dan jika perlu dengan menggunakan kekerasan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_51__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_51",
      "schema:text": {
        "@language": "ms",
        "@value": "tanpa menjejaskan keluasan subseksyen (1), waran yang dikeluarkan oleh Majistret boleh memberi kuasa untuk penggeledahan dan penyitaan mana-mana peranti perubatan, buku, dokumen, data berkomputer, radas, kelengkapan, peranti, jentera, kenderaan, perkara atau benda termasuklah dalam bentuk digital yang semunasabahnya dipercayai dapat memberikan keterangan mengenai pelakuan kesalahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_51__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_51",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang pegawai diberi kuasa yang menjalankan penggeledahan di bawah subseksyen (1) boleh, bagi maksud menyiasat kesalahan itu, memeriksa mana-mana orang yang berada di dalam atau di, premis atau pengangkut itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_51__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_51",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang pegawai diberi kuasa yang membuat pemeriksaan terhadap seseorang di bawah subseksyen (3) atau seksyen 52 boleh menyita atau mengambil milik, dan menyimpan dalam jagaan selamat semua benda selain pakaian yang perlu yang dijumpai pada orang itu, dan apa-apa benda yang baginya ada sebab untuk mempercayai bahawa benda itu merupakan peralatan atau keterangan lain bagi kesalahan itu boleh ditahan sehingga orang itu dilepaskan atau dibebaskan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_51__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_51",
      "schema:text": {
        "@language": "ms",
        "@value": "tiada seorang pun boleh diperiksa kecuali oleh seorang lain yang sama jantina, dan pemeriksaan sedemikian hendaklah dijalankan dengan penuh kesopanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_51__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_51",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika, oleh sebab sifat, saiz atau amaunnya, pemindahan mana-mana peranti perubatan, buku, dokumen, data berkomputer, radas, kelengkapan, peranti, jentera, kenderaan, perkara atau benda termasuklah dalam bentuk digital yang disita di bawah seksyen ini tidak boleh dilaksanakan, pegawai diberi kuasa hendaklah dengan apa-apa cara mengelak peranti perubatan, buku, dokumen, data berkomputer, radas, kelengkapan, peranti, jentera, kenderaan, perkara atau benda termasuklah dalam bentuk digital itu di dalam premis atau pengangkut yang di dalamnya ia dijumpai."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_51__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_51",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang yang, tanpa kuasa yang sah, memecahkan, mengganggu atau merosakkan lak yang disebut dalam subseksyen (6) atau memindahkan mana-mana peranti perubatan, buku, dokumen, data berkomputer, radas, kelengkapan, peranti, jentera, kenderaan, perkara atau benda termasuklah dalam bentuk digital yang telah dilak atau cuba untuk berbuat demikian melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tiga tahun atau kedua-duanya. Penggeledahan dan penyitaan tanpa waran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_52",
      "@type": "akn:clause",
      "eli:number": "52",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seseorang pegawai diberi kuasa berpuas hati atas maklumat yang diterima bahawa dia mempunyai sebab yang munasabah untuk mempercayai bahawa oleh sebab kelengahan dalam memperoleh suatu waran geledah di bawah seksyen 51 penyiasatan akan terjejas atau keterangan mengenai pelakuan sesuatu kesalahan mungkin diganggu, dipindahkan, dirosakkan atau dimusnahkan, pegawai diberi kuasa itu boleh memasuki premis atau pengangkut itu dan menjalankan di dalam, pada dan berkenaan dengan premis atau pengangkut itu semua kuasa yang disebut dalam seksyen 51 dengan cara yang sepenuhnya dan secukupnya seolah-olah dia telah diberi kuasa untuk berbuat demikian oleh suatu waran yang dikeluarkan di bawah seksyen itu. Capaian kepada data berkomputer"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_53",
      "@type": "akn:clause",
      "eli:number": "53",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_53__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_53__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_53__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_53",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang pegawai diberi kuasa yang menjalankan suatu penggeledahan di bawah seksyen 51 dan 52 hendaklah diberi capaian kepada data berkomputer sama ada disimpan dalam suatu komputer atau selainnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_53__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_53__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_53__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_53",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi maksud seksyen ini, “capaian”—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_53__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_53__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "termasuklah diberikan kata laluan, kod penyulitan, kod penyahsulitan, perisian atau perkakasan yang perlu dan apa-apa cara lain yang dikehendaki untuk membolehkan data berkomputer itu difahami; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_53__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_53__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mempunyai erti yang diberikan kepadanya dalam subseksyen 2(2) dan (5) Akta Jenayah Komputer 1997 [Akta 563]. Waran boleh diterima walaupun cacat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_54",
      "@type": "akn:clause",
      "eli:number": "54",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu waran geledah yang dikeluarkan di bawah Akta ini adalah sah dan boleh dikuatkuasakan walau apa pun kecacatan, kesilapan atau peninggalan dalamnya atau dalam permohonan bagi waran itu, dan apa-apa peranti perubatan, buku, dokumen, data berkomputer, radas, kelengkapan, peranti, jentera, kenderaan, perkara atau benda termasuklah dalam bentuk digital yang disita di bawah waran itu hendaklah boleh diterima sebagai keterangan dalam mana-mana prosiding di bawah Akta ini. Senarai peranti perubatan, buku, dokumen, dsb., yang disita"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_55",
      "@type": "akn:clause",
      "eli:number": "55",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_55__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_55__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_55__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_55__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_55__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_55__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_55",
      "schema:text": {
        "@language": "ms",
        "@value": "Kecuali sebagaimana yang diperuntukkan dalam subseksyen (2), jika mana-mana peranti perubatan, buku, dokumen, data berkomputer, radas, kelengkapan, peranti, jentera, kenderaan, perkara atau benda termasuklah dalam bentuk digital disita menurut Akta ini, pegawai diberi kuasa yang membuat penyitaan itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_55__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_55__subsec_1__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_55__subsec_1__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_55__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah menyediakan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_55__subsec_1__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_55__subsec_1__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu senarai peranti perubatan, buku, dokumen, data berkomputer, radas, kelengkapan, peranti, jentera, kenderaan, perkara atau benda termasuklah dalam bentuk digital yang disita dan hendaklah menandatangani senarai itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_55__subsec_1__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_55__subsec_1__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu notis bertulis mengenai penyitaan itu yang mengandungi alasan bagi penyitaan itu dan hendaklah menandatangani notis itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_55__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_55__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah dengan secepat yang dapat dilaksanakan menyampaikan suatu salinan senarai peranti perubatan, buku, dokumen, data berkomputer, radas, kelengkapan, peranti, jentera, kenderaan, perkara atau benda termasuklah dalam bentuk digital yang disita dan notis bertulis mengenai penyitaan itu kepada penghuni premis yang telah digeledah, atau kepada ejen atau pekhidmatnya di premis itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_55__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_55",
      "schema:text": {
        "@language": "ms",
        "@value": "Notis bertulis mengenai penyitaan itu tidak dikehendaki untuk disampaikan menurut perenggan (1)(b) jika penyitaan itu dibuat dengan kehadiran orang yang terhadapnya prosiding di bawah Akta ini diniatkan akan diambil, atau dengan kehadiran pemunya harta sedemikian atau ejennya, mengikut mana-mana yang berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_55__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_55",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika premis itu tidak berpenghuni, pegawai diberi kuasa hendaklah menampalkan suatu salinan senarai peranti perubatan, buku, dokumen, data berkomputer, radas, kelengkapan, peranti, jentera, kenderaan, perkara atau benda termasuklah dalam bentuk digital yang disita itu di tempat yang mudah dilihat di premis itu. Pelepasan peranti perubatan, buku, dokumen, dsb., yang disita"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_56",
      "@type": "akn:clause",
      "eli:number": "56",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_56__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_56__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_56__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_56",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana peranti perubatan, buku, dokumen, data berkomputer, radas, kelengkapan, peranti, jentera, kenderaan, perkara atau benda termasuklah dalam bentuk digital telah disita di bawah Akta ini, pegawai diberi kuasa yang membuat penyitaan itu boleh, selepas merujuk kepada pendakwa Raya, melepaskan peranti perubatan, buku, dokumen, data berkomputer, radas, kelengkapan, peranti, jentera, kenderaan, perkara atau benda termasuklah dalam bentuk digital itu kepada orang yang diputuskannya sebagai berhak secara sah kepadanya, jika peranti perubatan, buku, dokumen, data berkomputer, radas, kelengkapan, peranti, jentera, kenderaan, perkara atau benda termasuklah dalam bentuk digital itu tidak boleh dilucuthakkan di bawah Akta ini, dan tidak dikehendaki selainnya bagi maksud apa-apa prosiding di bawah Akta ini atau bagi maksud apa-apa pendakwaan di bawah mana-mana undang-undang bertulis lain, dan dalam hal sedemikian pegawai diberi kuasa yang membuat penyitaan itu, atau Kerajaan persekutuan, pihak berkuasa atau mana-mana orang yang bertindak bagi pihak Kerajaan persekutuan atau pihak berkuasa tidak boleh dikenakan apa-apa prosiding oleh mana-mana orang jika penyitaan dan pelepasan peranti perubatan, buku, dokumen, data berkomputer, radas, kelengkapan, peranti, jentera, kenderaan, perkara atau benda termasuklah dalam bentuk digital itu telah dibuat dengan suci hati."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_56__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_56",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu rekod bertulis hendaklah dibuat oleh pegawai diberi kuasa yang membuat pelepasan peranti perubatan, buku, dokumen, data berkomputer, radas, kelengkapan, peranti, jentera, kenderaan, perkara atau benda termasuklah dalam bentuk digital di bawah subseksyen (1) yang menyatakan secara terperinci hal keadaan dan sebab bagi pelepasan itu, dan dia hendaklah menghantarkan suatu salinan rekod itu kepada pendakwa Raya dalam tempoh tujuh hari dari pelepasan itu. Tiada kos atau ganti rugi yang berbangkit daripada penyitaan boleh didapatkan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_57",
      "@type": "akn:clause",
      "eli:number": "57",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "tiada seorang pun boleh, dalam apa-apa prosiding di hadapan mana-mana mahkamah berkenaan dengan mana-mana peranti perubatan, buku, dokumen, data berkomputer, radas, kelengkapan, peranti, jentera, kenderaan, perkara atau benda termasuklah dalam bentuk digital yang disita dalam menjalankan atau yang berupa sebagai menjalankan mana-mana kuasa yang diberikan di bawah Akta ini, berhak kepada kos prosiding itu atau kepada apa-apa ganti rugi atau relief lain melainkan jika penyitaan itu dibuat tanpa sebab yang munasabah. Kos bagi memegang peranti perubatan, dsb., yang disita"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_58",
      "@type": "akn:clause",
      "eli:number": "58",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika apa-apa peranti perubatan, buku, dokumen, data berkomputer, radas, kelengkapan, peranti, jentera, kenderaan, perkara atau benda termasuklah dalam bentuk digital yang disita di bawah Akta ini dipegang dalam jagaan pihak berkuasa sementara menunggu penyelesaian apa-apa prosiding berkenaan dengan suatu kesalahan di bawah Akta ini, kos bagi memegang dalam jagaan hendaklah, tanpa mengira sama ada apa-apa pendakwaan dimulakan atau selainnya terhadap mana-mana orang, menjadi hutang sivil yang kena dibayar oleh orang itu kepada Kerajaan dan bolehlah didapatkan dengan sewajarnya. Halangan untuk menggeledah"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_59",
      "@type": "akn:clause",
      "eli:number": "59",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_59__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_59__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_59__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V",
      "schema:name": {
        "@language": "ms",
        "@value": "Mana-mana orang yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_59__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_59",
      "schema:text": {
        "@language": "ms",
        "@value": "enggan memberi mana-mana pegawai diberi kuasa akses kepada mana-mana premis atau pengangkut yang pegawai diberi kuasa itu berhak kepadanya di bawah Akta ini atau dalam melaksanakan apa-apa kewajipan yang dikenakan atau kuasa yang diberikan oleh Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_59__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_59",
      "schema:text": {
        "@language": "ms",
        "@value": "mengamang, menghalang, menggalang atau melengahkan mana-mana pegawai diberi kuasa dalam membuat apa- apa kemasukan yang pegawai diberi kuasa itu berhak membuatnya di bawah Akta ini, atau dalam melaksanakan apa-apa kewajipan yang dikenakan atau kuasa yang diberikan oleh Akta ini; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_59__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_59",
      "schema:text": {
        "@language": "ms",
        "@value": "enggan memberi mana-mana pegawai diberi kuasa apa- apa maklumat yang berhubungan dengan suatu kesalahan atau kesalahan yang disyaki di bawah Akta ini atau apa-apa maklumat lain yang boleh dikehendaki secara munasabah daripadanya dan yang ada dalam pengetahuan atau kuasanya untuk memberikannya, melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tiga tahun atau kedua-duanya. Kuasa untuk menghendaki kehadiran orang yang mempunyai pengetahuan tentang kes"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_60",
      "@type": "akn:clause",
      "eli:number": "60",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_60__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_60__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_60__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_60",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang pegawai diberi kuasa yang menjalankan suatu penyiasatan di bawah Akta ini boleh, melalui perintah bertulis, menghendaki kehadiran di hadapannya mana-mana orang yang pada pendapat pegawai diberi kuasa itu mempunyai pengetahuan tentang fakta dan hal keadaan kes itu, dan orang itu hendaklah hadir sebagaimana yang dikehendaki sedemikian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_60__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_60",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana orang enggan atau tidak hadir sebagaimana yang dikehendaki sedemikian, pegawai diberi kuasa itu boleh melaporkan keengganan atau ketidakhadiran itu kepada seorang Majistret yang hendaklah mengeluarkan suatu saman untuk memastikan kehadiran orang itu sebagaimana yang dikehendaki oleh perintah yang dibuat di bawah subseksyen (1). Pemeriksaan orang yang mempunyai pengetahuan tentang kes"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_61",
      "@type": "akn:clause",
      "eli:number": "61",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_61__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_61__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_61__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_61__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_61__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_61__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_61",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang pegawai diberi kuasa yang menjalankan suatu penyiasatan di bawah Akta ini boleh memeriksa secara lisan mana-mana orang yang dikatakan mempunyai pengetahuan tentang fakta dan hal keadaan kes itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_61__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_61",
      "schema:text": {
        "@language": "ms",
        "@value": "Orang itu adalah terikat untuk menjawab semua soalan yang berhubungan dengan kes itu yang diajukan kepadanya oleh pegawai diberi kuasa itu, tetapi orang itu boleh enggan menjawab mana- mana soalan yang jawapannya berkecenderungan mendedahkannya kepada pertuduhan jenayah atau penalti atau pelucuthakan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_61__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_61",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang yang membuat suatu pernyataan di bawah seksyen ini adalah terikat di sisi undang-undang untuk menyatakan yang benar, sama ada pernyataan itu dibuat secara keseluruhannya atau sebahagiannya dalam menjawab soalan atau tidak."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_61__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_61",
      "schema:text": {
        "@language": "ms",
        "@value": "pegawai diberi kuasa yang memeriksa seseorang di bawah subseksyen (1) hendaklah terlebih dahulu memaklumkan orang itu mengenai peruntukan dalam subseksyen (2) dan (3)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_61__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_61",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu pernyataan yang dibuat oleh mana-mana orang di bawah seksyen ini hendaklah, bilamana mungkin, diubah ke dalam bentuk bertulis dan ditandatangani oleh orang yang membuatnya atau dilekatkan cap ibu jarinya, mengikut mana- mana yang berkenaan, selepas pernyataan itu dibacakan kepadanya dalam bahasa yang dibuatnya dan selepas dia diberi peluang untuk membuat apa-apa pembetulan yang dia mahu. Kebolehterimaan pernyataan sebagai keterangan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_62",
      "@type": "akn:clause",
      "eli:number": "62",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_62__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_62__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_62__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_62__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_62__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_62__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_62",
      "schema:text": {
        "@language": "ms",
        "@value": "Kecuali sebagaimana yang diperuntukkan dalam seksyen ini, tiada pernyataan yang dibuat oleh mana-mana orang kepada seorang pegawai diberi kuasa dalam penjalanan suatu penyiasatan yang dibuat di bawah Akta ini boleh digunakan sebagai keterangan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_62__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_62",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila mana-mana saksi dipanggil bagi pihak pendakwaan atau pembelaan, selain tertuduh, mahkamah hendaklah, atas permintaan tertuduh atau pendakwa, merujuk kepada apa-apa pernyataan yang dibuat oleh saksi itu kepada pegawai diberi kuasa dalam penjalanan penyiasatan di bawah Akta ini dan boleh kemudian, jika difikirkan patut oleh mahkamah demi kepentingan keadilan, mengarahkan supaya tertuduh diberikan suatu salinan pernyataan itu dan pernyataan itu boleh digunakan untuk mencabar kebolehpercayaan saksi itu mengikut cara yang diperuntukkan oleh Akta Keterangan 1950 [Akta 56]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_62__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_62",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika tertuduh telah membuat suatu pernyataan semasa penjalanan suatu penyiasatan, pernyataan itu boleh diterima sebagai keterangan untuk menyokong pembelaannya semasa penjalanan perbicaraan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_62__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_62",
      "schema:text": {
        "@language": "ms",
        "@value": "tiada apa-apa jua dalam seksyen ini hendaklah disifatkan terpakai bagi apa-apa pernyataan yang dibuat dalam penjalanan perbarisan cam atau termasuk dalam seksyen 27 atau perenggan 32(1)(a), (i) dan (j) Akta Keterangan 1950."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_62__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_62__subsec_5__para_a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_62",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila mana-mana orang dipertuduh atas apa-apa kesalahan yang berhubung dengan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_62__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_62__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "pembuatan; atau ( b) kandungan, apa-apa pernyataan yang dibuat olehnya kepada seorang pegawai diberi kuasa dalam penjalanan suatu penyiasatan yang dibuat di bawah Akta ini, pernyataan itu boleh digunakan sebagai keterangan dalam kes pendakwaan. Pelucuthakan peranti perubatan, dsb., yang disita"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_63",
      "@type": "akn:clause",
      "eli:number": "63",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_63__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_63__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_63__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_63__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_63__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_63__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_63__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_63__subsec_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_63__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_63",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa peranti perubatan, buku, dokumen, data berkomputer, radas, kelengkapan, peranti, jentera, kenderaan, perkara atau benda termasuklah dalam bentuk digital yang disita dalam penjalanan mana-mana kuasa yang diberikan oleh Akta ini boleh dilucuthakkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_63__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_63",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu perintah bagi pelucuthakan peranti perubatan, buku, dokumen, data berkomputer, radas, kelengkapan, peranti, jentera, kenderaan, perkara atau benda termasuklah dalam bentuk digital yang disita dan boleh dilucuthakkan di bawah Akta ini hendaklah dibuat oleh mahkamah yang di hadapannya pendakwaan berkenaan dengannya telah diadakan jika dibuktikan sehingga mahkamah berpuas hati bahawa suatu kesalahan di bawah Akta ini telah dilakukan dan bahawa peranti perubatan, buku, dokumen, data berkomputer, radas, kelengkapan, peranti, jentera, kenderaan, perkara atau benda termasuklah dalam bentuk digital yang disita ialah hal perkara bagi atau telah digunakan dalam pelakuan kesalahan itu, walaupun tiada seorang pun telah disabitkan atas kesalahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_63__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_63",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika tidak ada pendakwaan berkenaan dengan mana-mana peranti perubatan, buku, dokumen, data berkomputer, radas, kelengkapan, peranti, jentera, kenderaan, perkara atau benda termasuklah dalam bentuk digital yang disita di bawah Akta ini, peranti perubatan, buku, dokumen, data berkomputer, radas, kelengkapan, peranti, jentera, kenderaan, perkara atau benda termasuklah dalam bentuk digital itu hendaklah diambil kira dan disifatkan terlucut hak apabila habis tempoh satu bulan kalendar dari tarikh penyampaian notis ke alamat yang terakhir diketahui orang yang daripadanya peranti perubatan, buku, dokumen, data berkomputer, radas, kelengkapan, peranti, jentera, kenderaan, perkara atau benda termasuklah dalam bentuk digital disita yang menyatakan bahawa tidak ada pendakwaan berkenaan dengan peranti perubatan, buku, dokumen, data berkomputer, radas, kelengkapan, peranti, jentera, kenderaan, perkara atau benda termasuklah dalam bentuk digital itu, melainkan jika sebelum habis tempoh itu suatu tuntutan baginya dibuat mengikut cara yang dinyatakan dalam subseksyen (4), (5) dan (6)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_63__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_63",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang menuntut bahawa dia ialah pemunya peranti perubatan, buku, dokumen, data berkomputer, radas, kelengkapan, peranti, jentera, kenderaan, perkara atau benda termasuklah dalam bentuk digital yang disebut dalam subseksyen (3) dan bahawa peranti perubatan, buku, dokumen, data berkomputer, radas, kelengkapan, peranti, jentera, kenderaan, perkara atau benda termasuklah dalam bentuk digital itu tidak boleh dilucuthakkan boleh, secara sendiri atau melalui ejennya yang diberi kuasa secara bertulis, memberikan notis bertulis kepada pegawai diberi kuasa yang dalam milikannya peranti perubatan, buku, dokumen, data berkomputer, radas, kelengkapan, peranti, jentera, kenderaan, perkara atau benda termasuklah dalam bentuk digital itu dipegang bahawa dia menuntut peranti perubatan, buku, dokumen, data berkomputer, radas, kelengkapan, peranti, jentera, kenderaan, perkara atau benda termasuklah dalam bentuk digital itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_63__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_63",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila notis di bawah subseksyen (4) diterima, pegawai diberi kuasa hendaklah merujukkan perkara itu kepada Majistret bagi keputusannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_63__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_63",
      "schema:text": {
        "@language": "ms",
        "@value": "Majistret yang perkara itu dirujukkan kepadanya di bawah subseksyen (5) hendaklah mengeluarkan suatu saman yang menghendaki orang yang menuntut bahawa dia ialah pemunya peranti perubatan, buku, dokumen, data berkomputer, radas, kelengkapan, peranti, jentera, kenderaan, perkara atau benda termasuklah dalam bentuk digital itu dan orang yang daripadanya peranti perubatan, buku, dokumen, data berkomputer, radas, kelengkapan, peranti, jentera, kenderaan, perkara atau benda termasuklah dalam bentuk digital itu disita untuk hadir di hadapan Majistret itu, dan apabila mereka hadir atau apabila mereka tidak hadir, setelah dibuktikan bahawa saman itu telah disampaikan dengan sewajarnya, Majistret hendaklah meneruskan pemeriksaan perkara itu dan, apabila dibuktikan bahawa suatu kesalahan di bawah Akta ini telah dilakukan dan bahawa peranti perubatan, buku, dokumen, data berkomputer, radas, kelengkapan, peranti, jentera, kenderaan, perkara atau benda termasuklah dalam bentuk digital yang disita ialah hal perkara bagi atau telah digunakan dalam pelakuan kesalahan itu, Majistret hendaklah memerintahkan supaya peranti perubatan, buku, dokumen, data berkomputer, radas, kelengkapan, peranti, jentera, kenderaan, perkara atau benda termasuklah dalam bentuk digital itu dilucuthakkan, dan hendaklah, jika tidak ada bukti sedemikian, memerintahkan pelepasannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_63__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_63",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa peranti perubatan, buku, dokumen, data berkomputer, radas, kelengkapan, peranti, jentera, kenderaan, perkara atau benda termasuklah dalam bentuk digital yang dilucuthakkan atau disifatkan terlucut hak hendaklah diserahkan kepada pihak berkuasa dan hendaklah dilupuskan mengikut apa-apa cara yang difikirkan patut oleh pihak berkuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_63__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_63__subsec_8__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_63__subsec_8__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_63__subsec_8__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_63",
      "schema:text": {
        "@language": "ms",
        "@value": "pihak berkuasa boleh mengarahkan supaya apa-apa benda yang disita di bawah Akta ini dijual pada bila-bila masa dan hasil penjualan itu dipegang sementara menunggu keputusan apa-apa pendakwaan atau tuntutan di bawah seksyen ini jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_63__subsec_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_63__subsec_8",
      "schema:text": {
        "@language": "ms",
        "@value": "benda itu adalah daripada jenis yang mudah binasa atau yang mengikut tabiinya lekas rosak;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_63__subsec_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_63__subsec_8",
      "schema:text": {
        "@language": "ms",
        "@value": "penjagaan benda itu melibatkan perbelanjaan dan kesusahan yang tidak munasabah; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_63__subsec_8__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_63__subsec_8",
      "schema:text": {
        "@language": "ms",
        "@value": "benda itu dipercayai menyebabkan halangan atau membahayakan orang ramai. Kuasa menangkap"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_64",
      "@type": "akn:clause",
      "eli:number": "64",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_64__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_64__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_64__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_64",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang pegawai diberi kuasa atau pegawai polis boleh menangkap tanpa waran mana-mana orang yang dia percaya dengan munasabah telah melakukan atau cuba melakukan sesuatu kesalahan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_64__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_64",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang pegawai diberi kuasa yang membuat tangkapan di bawah subseksyen (1) hendaklah tanpa kelengahan yang tidak perlu menyerahkan orang yang ditangkap sedemikian kepada pegawai polis yang paling hampir atau, jika tiada pegawai polis, membawa orang itu ke balai polis yang paling hampir, dan selepas itu orang itu hendaklah diperlakukan sebagaimana yang diperuntukkan oleh undang-undang yang berhubungan dengan tatacara jenayah yang sedang berkuat kuasa seolah-olah dia ditangkap oleh seorang pegawai polis. Kuasa untuk mengambil sampel"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_65",
      "@type": "akn:clause",
      "eli:number": "65",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_65__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_65__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_65__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_65__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_65__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_65__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_65",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang pegawai diberi kuasa boleh meminta, memilih, mengambil atau mendapatkan sampel apa-apa peranti perubatan dengan cara yang ditetapkan bagi maksud analisis—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_65__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_65__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan bayaran, daripada mana-mana orang yang menjual peranti perubatan itu, atau ejen atau pekhidmatnya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_65__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_65__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tanpa bayaran, daripada mana-mana establismen bagi peranti perubatan itu atau ejen atau pekhidmatnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_65__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_65",
      "schema:text": {
        "@language": "ms",
        "@value": "penganalisisan sampel hendaklah dilakukan dengan cara yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_65__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_65",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang enggan mematuhi apa-apa permintaan yang dibuat oleh seseorang pegawai diberi kuasa di bawah subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi satu ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi satu tahun atau kedua- duanya. Pelantikan juruanalisis"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V__cl_66",
      "@type": "akn:clause",
      "eli:number": "66",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "pihak berkuasa boleh melantik mana-mana orang yang berkelayakan untuk menjadi juruanalisis bagi maksud menjalankan suatu analisis di bawah Akta ini."
      }
    }
  ]
}
