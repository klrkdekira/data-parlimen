        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_21",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_22",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_23",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_24",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_25"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Lesen establismen Kehendak bagi lesen establismen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_15__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_15__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_15__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "tiada establismen boleh mengimport, mengeksport atau meletakkan dalam pasaran apa-apa peranti perubatan yang didaftarkan melainkan jika establismen itu memegang suatu lesen establismen yang diberikan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana establismen yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi dua ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tiga tahun atau kedua-duanya. Permohonan bagi lesen establismen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_16__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_16__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_16__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_16__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu establismen boleh memohon supaya suatu lesen establismen diberikan di bawah Akta ini dengan mengemukakan suatu permohonan bertulis kepada pihak berkuasa mengikut cara yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "tiap-tiap permohonan di bawah subseksyen (1) hendaklah disertai dengan fi permohohan yang ditetapkan dan apa-apa dokumen atau maklumat sebagaimana yang ditentukan oleh pihak berkuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_16__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu permohonan boleh ditarik balik pada bila-bila masa oleh pemohon sebelum permohonan itu diberikan atau ditolak oleh pihak berkuasa. Maklumat atau dokumen tambahan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_17__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "pihak berkuasa boleh, secara bertulis, pada bila-bila masa selepas permohonan di bawah seksyen 16 diterima, meminta pemohon supaya memberikan maklumat, butir-butir atau dokumen tambahan kepada pihak berkuasa dalam tempoh yang ditentukan dalam permintaan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika apa-apa maklumat, butir-butir atau dokumen tambahan yang dikehendaki di bawah subseksyen (1) tidak diberikan oleh pemohon dalam tempoh yang ditentukan dalam permintaan itu atau apa-apa masa lanjutan yang diberikan oleh pihak berkuasa, permohonan itu hendaklah disifatkan telah ditarik balik dan tidak boleh diteruskan lagi, tetapi tanpa menjejaskan hak pemohon untuk membuat suatu permohonan baru. Pemberian atau keengganan untuk memberikan lesen establismen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_18__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_18__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "pihak berkuasa boleh, selepas menimbangkan permohonan bagi lesen establismen di bawah seksyen 16, dan maklumat, butir-butir atau dokumen tambahan yang diberikan di bawah seksyen 17, memberikan lesen establismen bagi suatu tempoh yang ditetapkan atau enggan untuk memberikan lesen establismen itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu lesen establismen yang diberikan di bawah subseksyen (1) hendaklah tertakluk kepada pembayaran fi yang ditetapkan dalam tempoh yang ditetapkan dan apa-apa syarat yang difikirkan patut oleh pihak berkuasa untuk dikenakan. Pematuhan syarat-syarat lesen establismen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_19__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_19__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_19__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang pemegang lesen hendaklah mematuhi syarat-syarat yang dikenakan oleh pihak berkuasa ke atas lesen establismen."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_19__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pemegang lesen yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, dikenakan denda tidak melebihi satu ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi satu tahun atau kedua-duanya. Kuasa untuk mengenakan syarat-syarat tambahan dan untuk mengubah atau membatalkan syarat-syarat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_20__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_20__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1",
      "schema:name": {
        "@language": "ms",
        "@value": "pihak berkuasa boleh, pada bila-bila masa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_20__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "mengenakan apa-apa syarat tambahan ke atas lesen establismen; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_20__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "mengubah atau membatalkan mana-mana syarat yang dikenakan ke atas lesen establismen. Pindah hakmilik lesen establismen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_21__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_21__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_21__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "pemberian sesuatu lesen establismen di bawah seksyen 18 hendaklah bersifat peribadi bagi pemegang lesen dan lesen establismen itu tidak boleh diserahhakkan, disublesenkan atau dipindahkan hakmilik kepada mana-mana orang lain kecuali dengan kelulusan bertulis terlebih dahulu daripada pihak berkuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_21__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang pemegang lesen yang menyerahhakkan, mensublesenkan atau memindahkan hakmilik lesen establismennya kepada mana-mana orang lain tanpa kelulusan bertulis terlebih dahulu daripada pihak berkuasa melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak kurang daripada lima puluh ribu ringgit dan tidak lebih daripada lima ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tiga tahun atau kedua-duanya. Penggantungan atau pembatalan lesen establismen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_22__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_22__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_22__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_22__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_22__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_22__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_22__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "pihak berkuasa boleh menggantung atau membatalkan sesuatu lesen establismen jika pemegang lesen—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_22__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_22__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah melanggar mana-mana peruntukan Akta ini atau mana-mana peraturan yang dibuat di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_22__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_22__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah memungkiri mana-mana syarat lesen; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_22__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_22__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah disabitkan dengan suatu kesalahan di bawah Akta ini atau mana-mana peraturan yang dibuat di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_22__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika sesuatu lesen establismen digantung di bawah subseksyen (1), pihak berkuasa boleh menghendaki supaya pemegang lesen itu meremedi pelanggaran atau kemungkiran itu dalam tempoh yang ditentukan oleh pihak berkuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_22__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika pihak berkuasa berpuas hati bahawa pemegang lesen tidak meremedi pelanggaran atau kemungkiran itu sebagaimana yang dikehendaki di bawah subseksyen (2), atau pelanggaran atau kemungkiran itu masih berterusan selepas lesen establismen itu digantung di bawah subseksyen (1), pihak berkuasa hendaklah membatalkan lesen itu. Penyerahan balik lesen establismen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_23__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_23__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_23__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_23__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "pemegang lesen boleh, dengan notis bertulis, menyerahkan balik lesennya dengan mengemukakan lesen establismen itu kepada pihak berkuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_23__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "penyerahan balik lesen establismen itu hendaklah berkuat kuasa apabila lesen establismen itu dan notis bertulis di bawah subseksyen (1) diterima oleh pihak berkuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_23__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "penyerahan balik sesuatu lesen establismen di bawah subseksyen (1) tidak boleh dibatalkan. Pembaharuan lesen establismen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_24__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_24__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_24__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_24__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_24__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "pemegang lesen boleh memohon bagi pembaharuan lesen establismennya kepada pihak berkuasa tidak lewat daripada satu tahun sebelum tarikh habis tempoh lesen establismen itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_24__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_24__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_24__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_24__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_24__subsec_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "pihak berkuasa hendaklah, apabila fi yang ditetapkan dibayar, membaharui sesuatu lesen establismen kecuali dalam hal keadaan yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_24__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_24__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pemegang lesen telah melanggar mana-mana peruntukan Akta ini atau mana-mana peraturan yang dibuat di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_24__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_24__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pemegang lesen telah memungkiri mana-mana syarat lesen establismen;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_24__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_24__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pemegang lesen telah mendapatkan lesen establismen secara tidak patut atau tidak sah; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_24__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_24__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pemegang lesen telah disabitkan dengan suatu kesalahan di bawah Akta ini atau mana-mana peraturan yang dibuat di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_24__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "pihak berkuasa boleh meminta pemegang lesen supaya memberikan apa-apa maklumat, butir-butir atau dokumen sebagaimana yang dikehendaki bagi permohonan pembaharuan lesen itu dalam tempoh yang ditentukan dalam permintaan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_24__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (2), jika maklumat, butir-butir atau dokumen yang diminta di bawah subseksyen (3) tidak diberikan oleh pemegang lesen dalam tempoh yang ditentukan dalam permintaan itu atau apa-apa masa lanjutan yang diberikan, pihak berkuasa boleh tidak membaharui lesen establismen itu. Kesan menggantung, membatalkan, menyerah balik atau tidak membaharui lesen establismen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_25__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_25__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_25__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_25__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_25__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika sesuatu lesen establismen digantung atau dibatalkan di bawah seksyen 22, diserah balik di bawah seksyen 23 atau tidak dibaharui di bawah seksyen 24, pemegang lesen hendaklah dengan serta-merta berhenti mengimport, mengeksport atau meletakkan dalam pasaran mana-mana peranti perubatan yang didaftarkan yang berkenaan dengannya lesen establismen itu diberikan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_25__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (1), pihak berkuasa boleh, pada bila-bila masa selepas penggantungan, pembatalan, penyerahan balik atau tidak membaharui sesuatu lesen establismen, memberikan apa-apa arahan kepada pemegang lesen yang difikirkannya perlu demi kepentingan kesihatan dan keselamatan awam, dan pemegang lesen itu hendaklah mematuhi semua arahan sedemikian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_25__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_25__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_25__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "pemegang lesen yang lesen establismennya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_25__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_25__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "digantung, dibatalkan atau tidak dibaharui tidak berhak kepada apa-apa pampasan bagi apa-apa kerugian yang disebabkan kepadanya oleh penggantungan, pembatalan atau hal tidak membaharui lesen establismen itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_25__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_25__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dibatalkan tidak berhak kepada apa-apa pembayaran balik fi lesen establismen yang telah dibayar di bawah seksyen 18."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_25__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_1__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pemegang lesen yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi dua ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tiga tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2",
      "@type": "akn:chapter",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_26",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_27",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_28",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_29",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_30",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_31",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_32",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_33",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_34",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_35",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_36"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Permit peranti perubatan yang ditetapkan Peranti perubatan yang ditetapkan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, dari semasa ke semasa, selepas mengambil kira tahap risiko sesuatu peranti perubatan, pendedahan peranti perubatan kepada kesihatan awam, keselamatan pesakit dan takat kompleksiti peranti perubatan itu, menentukan sesuatu peranti perubatan sebagai peranti perubatan yang ditetapkan melalui perintah yang disiarkan dalam Warta. Kehendak bagi permit peranti perubatan yang ditetapkan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_27__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_27__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_27__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "tiada seorang pun boleh menggunakan atau mengendalikan apa-apa peranti perubatan yang ditetapkan melainkan jika orang itu memegang suatu permit peranti perubatan yang ditetapkan yang diberikan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_27__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi satu ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi satu tahun atau kedua-duanya. Permohonan bagi permit peranti perubatan yang ditetapkan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_28__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_28__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_28__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_28__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang boleh memohon supaya suatu permit peranti perubatan yang ditetapkan diberikan di bawah Akta ini dengan mengemukakan suatu permohonan bertulis kepada pihak berkuasa mengikut cara yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_28__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "tiap-tiap permohonan di bawah subseksyen (1) hendaklah disertai dengan fi permohonan yang ditetapkan dan apa-apa dokumen atau maklumat sebagaimana yang ditentukan oleh pihak berkuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_28__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu permohonan di bawah seksyen ini boleh ditarik balik pada bila-bila masa oleh pemohon sebelum permohonan itu diberikan atau ditolak oleh pihak berkuasa. Maklumat atau dokumen tambahan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_29__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_29__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_29__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "pihak berkuasa boleh, secara bertulis, pada bila-bila masa selepas permohonan di bawah seksyen 28 diterima, meminta pemohon supaya memberikan maklumat, butir-butir atau dokumen tambahan kepada pihak berkuasa dalam tempoh yang ditentukan dalam permintaan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_29__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika apa-apa maklumat, butir-butir atau dokumen tambahan yang dikehendaki di bawah subseksyen (1) tidak diberikan oleh pemohon dalam tempoh yang ditentukan dalam permintaan itu atau apa-apa masa lanjutan yang diberikan oleh pihak berkuasa, permohonan itu hendaklah disifatkan telah ditarik balik dan tidak boleh diteruskan lagi, tetapi tanpa menjejaskan hak pemohon untuk membuat suatu permohonan baru. Pemberian atau keengganan untuk memberikan permit peranti perubatan yang ditetapkan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_30__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_30__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_30__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "pihak berkuasa boleh, selepas menimbangkan permohonan bagi permit peranti perubatan yang ditetapkan di bawah seksyen 28 dan maklumat, butir-butir atau dokumen tambahan yang diberikan di bawah seksyen 29, memberikan permit peranti perubatan yang ditetapkan bagi suatu tempoh yang ditetapkan atau enggan untuk memberikan permit peranti perubatan yang ditetapkan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_30__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu permit peranti perubatan yang ditetapkan yang diberikan di bawah subseksyen (1) hendaklah tertakluk kepada pembayaran fi yang ditetapkan dalam tempoh yang ditetapkan dan apa-apa syarat yang difikirkan sesuai oleh pihak berkuasa untuk dikenakan. Pematuhan syarat-syarat permit peranti perubatan yang ditetapkan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_31__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_31__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_31__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_31",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang pemegang permit hendaklah mematuhi syarat- syarat yang dikenakan oleh pihak berkuasa ke atas permit peranti perubatan yang ditetapkan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_31__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_31",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pemegang permit yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi enam bulan atau kedua-duanya. Kuasa untuk mengenakan syarat-syarat tambahan dan untuk mengubah atau membatalkan syarat-syarat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_32__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_32__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2",
      "schema:name": {
        "@language": "ms",
        "@value": "pihak berkuasa boleh, pada bila-bila masa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_32__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_32",
      "schema:text": {
        "@language": "ms",
        "@value": "mengenakan apa-apa syarat tambahan ke atas permit peranti perubatan yang ditetapkan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_32__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_32",
      "schema:text": {
        "@language": "ms",
        "@value": "mengubah atau membatalkan apa-apa syarat yang dikenakan ke atas permit peranti perubatan yang ditetapkan. Penggantungan atau pembatalan permit peranti perubatan yang ditetapkan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_33__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_33__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_33__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_33__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_33__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_33__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_33__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_33",
      "schema:text": {
        "@language": "ms",
        "@value": "pihak berkuasa boleh menggantung atau membatalkan suatu permit peranti perubatan yang ditetapkan jika pemegang permit itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_33__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_33__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah melanggar mana-mana peruntukan Akta ini atau mana-mana peraturan yang dibuat di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_33__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_33__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah memungkiri mana-mana syarat permit peranti perubatan yang ditetapkan itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_33__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_33__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah disabitkan dengan suatu kesalahan di bawah Akta ini atau mana-mana peraturan yang dibuat di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_33__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_33",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika sesuatu permit peranti perubatan yang ditetapkan digantung di bawah subseksyen (1), pihak berkuasa boleh menghendaki pemegang permit itu supaya meremedi pelanggaran atau kemungkiran itu dalam tempoh yang ditentukan oleh pihak berkuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_33__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_33",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika pihak berkuasa berpuas hati bahawa pemegang permit tidak meremedi pelanggaran atau kemungkiran itu sebagaimana yang dikehendaki di bawah subseksyen (2), atau pelanggaran atau kemungkiran itu masih berterusan selepas permit peranti perubatan yang ditetapkan itu digantung di bawah subseksyen (1), pihak berkuasa hendaklah membatalkan permit peranti perubatan yang ditetapkan itu. Penyerahan balik permit peranti perubatan yang ditetapkan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_34",
      "@type": "akn:clause",
      "eli:number": "34",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_34__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_34__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_34__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_34__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_34",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang pemegang permit boleh, dengan notis bertulis, menyerahkan balik permit peranti perubatan yang ditetapkannya dengan mengemukakan permit peranti perubatan yang ditetapkan itu kepada pihak berkuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_34__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_34",
      "schema:text": {
        "@language": "ms",
        "@value": "penyerahan balik permit peranti perubatan yang ditetapkan hendaklah berkuat kuasa apabila permit peranti perubatan yang ditetapkan itu dan notis bertulis di bawah subseksyen (1) diterima oleh pihak berkuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_34__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_34",
      "schema:text": {
        "@language": "ms",
        "@value": "penyerahan balik sesuatu permit peranti perubatan yang ditetapkan di bawah subseksyen (1) tidak boleh dibatalkan. Pembaharuan permit peranti perubatan yang ditetapkan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_35",
      "@type": "akn:clause",
      "eli:number": "35",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_35__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_35__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_35__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_35__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_35__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang pemegang permit boleh memohon bagi pembaharuan permit peranti perubatan yang ditetapkannya kepada pihak berkuasa tidak lewat daripada satu tahun sebelum tarikh habis tempoh permit itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_35__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_35__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_35__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_35__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_35__subsec_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "pihak berkuasa hendaklah, apabila fi yang ditetapkan dibayar, membaharui sesuatu permit peranti perubatan yang ditetapkan kecuali dalam hal keadaan yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_35__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_35__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pemegang permit telah melanggar mana-mana peruntukan Akta ini atau mana-mana peraturan yang dibuat di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_35__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_35__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pemegang permit telah memungkiri mana-mana syarat permit peranti perubatan yang ditetapkan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_35__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_35__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pemegang permit telah mendapatkan permit peranti perubatan yang ditetapkan secara tidak patut atau tidak sah; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_35__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_35__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pemegang permit telah disabitkan dengan suatu kesalahan di bawah Akta ini atau mana-mana peraturan yang dibuat di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_35__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "pihak berkuasa boleh meminta pemegang permit supaya memberikan apa-apa maklumat, butir-butir atau dokumen sebagaimana yang dikehendaki bagi permohonan pembaharuan permit itu dalam tempoh yang ditentukan dalam permintaan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_35__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (2), jika maklumat, butir-butir atau dokumen yang diminta di bawah subseksyen (3) tidak diberikan oleh pemegang permit dalam tempoh yang ditentukan dalam permintaan itu atau apa-apa masa lanjutan yang diberikan, pihak berkuasa boleh tidak membaharui permit peranti perubatan yang ditetapkan itu. Kesan menggantung, membatalkan, menyerah balik atau tidak membaharui permit peranti perubatan yang ditetapkan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_36",
      "@type": "akn:clause",
      "eli:number": "36",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_36__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_36__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_36__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_36__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_36__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_36",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika sesuatu permit peranti perubatan yang ditetapkan digantung atau dibatalkan di bawah seksyen 33, diserah balik di bawah seksyen 34 atau tidak dibaharui di bawah seksyen 35, pemegang permit hendaklah dengan serta-merta berhenti menggunakan atau mengendalikan peranti perubatan yang ditetapkan yang berkenaan dengannya permit peranti perubatan yang ditetapkan itu diberikan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_36__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_36",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (1), pihak berkuasa boleh, pada bila-bila masa selepas penggantungan, pembatalan, penyerahan balik atau tidak membaharui sesuatu permit peranti perubatan yang ditetapkan, memberikan apa-apa arahan kepada pemegang permit yang difikirkannya perlu demi kepentingan kesihatan dan keselamatan awam, dan pemegang permit itu hendaklah mematuhi semua arahan sedemikian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_36__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_36__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_36__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_36",
      "schema:text": {
        "@language": "ms",
        "@value": "pemegang permit yang permit peranti perubatan yang ditetapkannya itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_36__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_36__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "digantung, dibatalkan atau tidak dibaharui tidak berhak kepada apa-apa pampasan bagi apa-apa kerugian yang disebabkan kepadanya oleh penggantungan, pembatalan atau hal tidak membaharui permit peranti perubatan yang ditetapkan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_36__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_36__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dibatalkan tidak berhak kepada apa-apa pembayaran balik fi permit peranti perubatan yang ditetapkan yang telah dibayar di bawah seksyen 30."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_36__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_2__cl_36",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pemegang permit yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak kurang daripada satu ratus ribu ringgit dan tidak lebih daripada satu juta ringgit atau dipenjarakan selama tempoh tidak melebihi tujuh tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3",
      "@type": "akn:chapter",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_37",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_38",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_39",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_40",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_41",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_42"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Kewajipan dan obligasi pemegang lesen atau pemegang permit Rekod pengedaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_37",
      "@type": "akn:clause",
      "eli:number": "37",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_37__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_37__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_37__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_37__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu establismen hendaklah menyenggara suatu rekod pengedaran berkenaan dengan setiap peranti perubatan yang dibuat, diimport, dieksport dan diletakkan dalam pasaran."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_37__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "Rekod pengedaran itu hendaklah mengandungi maklumat sebagaimana yang ditetapkan oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_37__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu establismen hendaklah memberikan rekod pengedaran itu kepada pihak berkuasa apabila diminta. Pemantauan dan pengawasan pascapasaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_38__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_38__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_38__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_38",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu establismen hendaklah memantau keselamatan dan prestasi peranti perubatan yang dibuat, diimport, dieksport dan diletakkan dalam pasaran, dan menyediakan suatu sistem pemantauan pascapasaran sebagaimana yang ditetapkan oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_38__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_38",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu establismen hendaklah memastikan bahawa apa- apa laporan pengawasan mengenai insiden yang memudaratkan yang melibatkan peranti perubatannya dalam pasaran direkodkan dengan sewajarnya dan dinilai sepenuhnya. Pengendalian aduan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu establismen hendaklah menyediakan dan melaksanakan tatacara yang didokumentasikan dan menyenggarakan rekod bagi masalah atau aduan yang dilaporkan yang berhubungan dengan keselamatan dan ciri-ciri prestasi peranti perubatannya. Pelaporan masalah mandatori"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_40__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_40__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_40__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_40__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_40__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_40__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_40",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu establismen hendaklah melaporkan kepada pihak berkuasa apa-apa insiden yang sampai kepada perhatian establismen itu yang berlaku di dalam atau di luar Malaysia yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_40__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_40__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "berhubungan dengan kegagalan peranti perubatan itu atau kemerosotan dalam keberkesanannya, atau apa-apa kekurangan dalam pelabelannya atau pada petunjuk bagi penggunaannya dan laporan sedemikian hendaklah dibuat dalam tempoh tiga puluh hari dari penemuan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_40__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_40__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah mengakibatkan kematian atau kemerosotan yang serius pada tahap kesihatan seseorang pesakit, pengguna atau orang lain, atau yang boleh menyebabkan sedemikian jika insiden itu berlaku lagi dan laporan sedemikian hendaklah dibuat dalam tempoh sepuluh hari dari penemuan itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_40__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_40__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mempunyai ancaman serius pada kesihatan awam dan laporan sedemikian hendaklah dibuat dalam masa empat puluh lapan jam dari penemuan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_40__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_40",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi dua ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi dua tahun atau kedua-duanya. Tindakan pembetulan di lapangan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_41",
      "@type": "akn:clause",
      "eli:number": "41",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_41__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_41__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_41__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_41__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_41__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu establismen hendaklah menjalankan tindakan pembetulan atau pencegahan berhubungan dengan sesuatu peranti perubatan yang diimport dan diletakkan dalam pasaran yang boleh termasuk—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_41__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "pemulangan peranti perubatan itu kepada establismen itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_41__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "pengubahsuaian peranti perubatan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_41__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "pertukaran peranti perubatan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_41__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "pemusnahan peranti perubatan itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_41__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "nasihat khusus tentang penggunaan peranti perubatan itu. Panggilan balik"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_42",
      "@type": "akn:clause",
      "eli:number": "42",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_42__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_42__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_42__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_42__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_42__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_42",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu establismen boleh memanggil balik mana-mana peranti perubatan yang cacat pada bila-bila masa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_42__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_42",
      "schema:text": {
        "@language": "ms",
        "@value": "establismen hendaklah, pada atau sebelum menjalankan sesuatu panggilan balik peranti perubatan, memberikan maklumat sebagaimana yang ditentukan oleh pihak berkuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_42__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_42",
      "schema:text": {
        "@language": "ms",
        "@value": "establismen hendaklah, seberapa segera yang mungkin selepas selesainya sesuatu panggilan balik, melaporkan kepada pihak berkuasa hasil panggilan balik itu dan apa-apa tindakan yang diambil untuk mencegah masalah itu daripada berulang."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_42__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_3__cl_42",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (1), pihak berkuasa boleh mengarahkan establismen supaya memanggil balik mana-mana peranti perubatan pada bila-bila masa atas sebab keselamatan pesakit dan kesihatan awam."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4",
      "@type": "akn:chapter",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_43",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_44"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Kewajipan am Penggunaan, pengendalian, penyenggaraan, dsb., peranti perubatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_43",
      "@type": "akn:clause",
      "eli:number": "43",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_43__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_43__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_43__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_43__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_43__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_43__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_43__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_43__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_43__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_43__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_43__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang yang menggunakan atau mengendalikan sesuatu peranti perubatan ke atas pihak ketiga hendaklah memastikan bahawa peranti perubatan itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_43__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_43__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "selamat dan berkesan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_43__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_43__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "digunakan mengikut maksud yang diniatkan baginya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_43__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_43__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "digunakan mengikut arahan pembuat; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_43__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_43__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dipasang, diuji, ditauliahkan dan disenggarakan dengan sewajarnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_43__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_43__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_43__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_43__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_43__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "yang menggunakan atau mengendalikan sesuatu peranti perubatan ke atas pihak ketiga; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_43__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_43__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "yang memasang, menguji, mentauliahkan, menyenggarakan dan melupuskan sesuatu peranti perubatan, hendaklah mempunyai kelayakan dan kompetensi sebagaimana yang ditetapkan oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_43__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang yang menggunakan atau mengendalikan sesuatu peranti perubatan ke atas pihak ketiga hendaklah memberhentikan peranti perubatan itu daripada beroperasi apabila peranti perubatan itu tidak lagi selamat dan berkesan untuk digunakan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_43__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_43__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_43__subsec_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_43__subsec_4__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_43__subsec_4__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu peranti perubatan yang telah diberhentikan daripada beroperasi di bawah subseksyen (3) hendaklah dipindahkan dan dilupuskan mengikut cara yang selamat yang menghapuskan atau mengurangkan apa-apa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_43__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_43__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "bahaya kecederaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_43__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_43__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "bahaya pencemaran dengan bahan biologi atau bahan kontaminasi lain;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_43__subsec_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_43__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "bahaya kerosakan alam sekitar; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_43__subsec_4__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_43__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "bahaya untuk peranti perubatan itu digunakan semula."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_43__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "pihak berkuasa boleh mengeluarkan arahan, perintah atau garis panduan untuk menentukan langkah-langkah yang hendaklah diambil sekiranya berlaku suatu kecemasan atau insiden semasa penggunaan, pengendalian, pemasangan, pengujian, pentauliahan, penyenggaraan dan pelupusan peranti perubatan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_43__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1), (2), (3) atau (4) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi satu ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi satu tahun atau kedua-duanya. Pengiklanan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_44",
      "@type": "akn:clause",
      "eli:number": "44",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_44__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_44__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_44__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_44__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_44",
      "schema:text": {
        "@language": "ms",
        "@value": "tiada seorang pun boleh mengiklankan sesuatu peranti perubatan melainkan jika peranti perubatan itu telah didaftarkan dan mematuhi kehendak Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_44__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_44",
      "schema:text": {
        "@language": "ms",
        "@value": "tiada seorang pun boleh membuat apa-apa dakwaan yang mengelirukan atau palsu berkenaan dengan sesuatu peranti perubatan dalam apa-apa iklan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_44__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_4__cl_44",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1) atau (2) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi tiga ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tiga tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_5",
      "@type": "akn:chapter",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_5__cl_45",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_5__cl_46"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Permit eksport Permit eksport"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_5__cl_45",
      "@type": "akn:clause",
      "eli:number": "45",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_5__cl_45__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_5__cl_45__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_5__cl_45__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_5__cl_45__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_5__cl_45__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_5"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_5__cl_45__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_5__cl_45",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu establismen boleh memohon kepada pihak berkuasa bagi suatu permit untuk mengeksport sesuatu peranti perubatan yang didaftarkan dalam bentuk yang ditetapkan dan disertai dengan fi yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_5__cl_45__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_5__cl_45",
      "schema:text": {
        "@language": "ms",
        "@value": "pihak berkuasa boleh, selepas menimbangkan permohonan di bawah subseksyen (1), mengeluarkan atau enggan untuk mengeluarkan suatu permit untuk mengeksport suatu peranti perubatan yang didaftarkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_5__cl_45__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_5__cl_45",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika pihak berkuasa memutuskan untuk mengeluarkan suatu permit eksport, pihak berkuasa boleh mengenakan apa-apa syarat yang difikirkannya sesuai."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_5__cl_45__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_5__cl_45",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu establismen hendaklah mematuhi syarat-syarat yang dikenakan oleh pihak berkuasa ke atas permit eksport."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_5__cl_45__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_5__cl_45",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana establismen yang melanggar subseksyen (4) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi enam bulan atau kedua-duanya. Pembatalan permit eksport"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_5__cl_46",
      "@type": "akn:clause",
      "eli:number": "46",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_5__cl_46__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_5__cl_46__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_5__cl_46__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_5__cl_46__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_5"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_5__cl_46__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_5__cl_46__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_5__cl_46__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_5__cl_46__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_5__cl_46__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_5__cl_46__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_5__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "pihak berkuasa boleh, pada bila-bila masa, membatalkan sesuatu permit eksport yang dikeluarkan jika ia berpuas hati bahawa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_5__cl_46__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_5__cl_46__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pemegang permit telah melanggar mana-mana peruntukan Akta ini atau mana-mana peraturan yang dibuat di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_5__cl_46__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_5__cl_46__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pemegang permit telah memungkiri mana-mana syarat permit itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_5__cl_46__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_5__cl_46__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "permit eksport itu telah dikeluarkan hasil daripada maklumat yang palsu, mengelirukan atau tidak tepat;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_5__cl_46__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_5__cl_46__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pemegang permit telah mendapatkan permit itu dengan cara yang tidak patut atau tidak sah; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_5__cl_46__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_5__cl_46__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pemegang permit telah disabitkan dengan suatu kesalahan di bawah Akta ini atau mana-mana peraturan yang dibuat di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_5__cl_46__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_5__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila pihak berkuasa memberitahu pemegang permit mengenai pembatalan permit eksportnya, pemegang permit itu hendaklah dengan serta-merta menyerahkan balik permit eksport itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_5__cl_46__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_5__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pemegang permit yang melanggar subseksyen (2) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi enam bulan atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_5__cl_46__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_III__chp_5__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang pemegang permit yang permit eksportnya dibatalkan tidak berhak kepada apa-apa pampasan bagi apa-apa kerugian yang disebabkan kepadanya oleh pembatalan permit eksport itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1",
      "@type": "akn:chapter",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_9"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftaran peranti perubatan Pengkelasan peranti perubatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_3__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu peranti perubatan hendaklah dikelaskan oleh sesuatu establismen berdasarkan tahap risiko yang ditimbulkan olehnya, penggunaan yang diniatkan baginya dan mudahnya tubuh manusia terdedah pada bahaya mengikut cara yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "sekiranya berlaku apa-apa pertikaian antara suatu establismen dengan suatu badan penilaian pematuhan mengenai pengkelasan sesuatu peranti perubatan, perkara itu hendaklah dirujukkan kepada pihak berkuasa, mengikut cara dan dalam tempoh yang ditentukan oleh pihak berkuasa, bagi keputusannya. Obligasi pembuat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1",
      "schema:name": {
        "@language": "ms",
        "@value": "pembuat hendaklah memastikan bahawa sesuatu peranti perubatan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "mematuhi prinsip-prinsip keselamatan dan prestasi yang perlu yang ditetapkan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dibuat mengikut amalan pembuatan yang baik dan apa-apa arahan bertulis yang dikeluarkan oleh pihak berkuasa; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dilabel, dibungkus dan ditandakan mengikut cara yang ditetapkan. Kehendak bagi pendaftaran peranti perubatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_5__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "tiada peranti perubatan boleh diimport, dieksport atau diletakkan dalam pasaran melainkan jika peranti perubatan itu didaftarkan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi dua ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tiga tahun atau kedua-duanya. Permohonan bagi pendaftaran peranti perubatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_6__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_6__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_6__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu permohonan bagi pendaftaran sesuatu peranti perubatan hendaklah dibuat oleh establismen kepada pihak berkuasa mengikut cara yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu permohonan boleh ditarik balik pada bila-bila masa oleh pemohon sebelum permohonan itu diluluskan atau ditolak oleh pihak berkuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "tiap-tiap permohonan di bawah subseksyen (1) hendaklah disertai dengan fi permohonan yang ditetapkan dan apa-apa dokumen atau maklumat sebagaimana yang ditentukan oleh pihak berkuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_6__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "pihak berkuasa boleh, secara bertulis, pada bila-bila masa selepas diterimanya sesuatu permohonan di bawah subseksyen (1), meminta pemohon supaya memberi pihak berkuasa dalam tempoh yang ditentukan dalam permintaan itu maklumat, butir-butir atau dokumen tambahan mengenai permohonan itu atau sampel peranti perubatan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_6__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika apa-apa maklumat, butir-butir atau dokumen tambahan, atau sampel peranti perubatan yang dikehendaki di bawah subseksyen (4) tidak diberikan oleh pemohon dalam tempoh yang ditentukan dalam permintaan itu atau apa-apa lanjutan masa yang diberikan oleh pihak berkuasa, permohonan itu hendaklah disifatkan telah ditarik balik dan tidak boleh diteruskan lagi, tetapi tanpa menjejaskan hak pemohon untuk membuat permohonan baru. Pendaftaran dan keengganan untuk mendaftarkan peranti perubatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_7__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_7__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_7__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila permohonan yang dibuat di bawah seksyen 6 diterima dan pihak berkuasa berpuas hati bahawa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_7__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_7__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "peranti perubatan itu telah menjalani tatacara penilaian pematuhan yang dijalankan oleh suatu badan penilaian pematuhan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_7__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_7__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pemohon telah mematuhi apa-apa kehendak pihak berkuasa yang dibuat di bawah subseksyen 6(4), pihak berkuasa boleh, selepas apa-apa pemeriksaan premis yang di dalamnya peranti perubatan itu dibuat sebagaimana yang difikirkannya patut dan perlu untuk dijalankan dan apabila fi pendaftaran yang ditetapkan dibayar, mendaftarkan peranti perubatan itu bagi suatu tempoh yang ditetapkan tertakluk kepada apa-apa syarat yang difikirkan patut oleh pihak berkuasa untuk dikenakan, memberikan suatu nombor pendaftaran kepada peranti perubatan itu dan mengeluarkan suatu perakuan pendaftaran kepada pemohon."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "pihak berkuasa tidak boleh mendaftarkan peranti perubatan itu jika ia tidak berpuas hati dengan apa-apa perkara yang disebut dalam subseksyen (1). Kuasa untuk mengenakan syarat-syarat tambahan dan untuk mengubah atau membatalkan syarat-syarat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_8__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_8__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1",
      "schema:name": {
        "@language": "ms",
        "@value": "pihak berkuasa boleh, pada bila-bila masa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "mengenakan apa-apa syarat tambahan ke atas pendaftaran sesuatu peranti perubatan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "mengubah atau membatalkan mana-mana syarat yang dikenakan ke atas pendaftaran sesuatu peranti perubatan. Kuasa untuk membatalkan pendaftaran peranti perubatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_9__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_9__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_9__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_9__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_9__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "tertakluk kepada subseksyen (2), pihak berkuasa boleh membatalkan pendaftaran sesuatu peranti perubatan jika establismen yang atas permohonannya sesuatu peranti perubatan didaftarkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_9__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_9__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah melanggar mana-mana peruntukan Akta ini atau mana-mana peraturan yang dibuat di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_9__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_9__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah memungkiri mana-mana syarat pendaftaran; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_9__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_9__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah disabitkan dengan suatu kesalahan di bawah Akta ini atau mana-mana peraturan yang dibuat di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "sebelum pendaftaran sesuatu peranti perubatan dibatalkan di bawah subseksyen (1), pihak berkuasa hendaklah, dengan notis secara bertulis, memberikan peluang kepada establismen yang atas permohonannya peranti perubatan itu didaftarkan untuk menunjuk sebab terhadap pembatalan itu, dan sementara menunggu keputusan mengenai pembatalan itu, semua pengimportan atau perbekalan peranti perubatan itu oleh establismen itu hendaklah digantung bermula dari tarikh penerimaan notis itu oleh establismen itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_9__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_1__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu establismen yang pendaftaran peranti perubatannya dibatalkan tidak berhak kepada apa-apa pampasan bagi apa-apa kerugian yang disebabkan kepadanya oleh pembatalan itu dan tidak berhak kepada apa-apa pembayaran balik fi pendaftaran yang ditetapkan yang telah dibayar di bawah seksyen 7."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2",
      "@type": "akn:chapter",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_11",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_12",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_13",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_14"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftaran badan penilaian pematuhan Badan penilaian pematuhan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_10__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_10__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_10__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_10__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu badan penilaian pematuhan hendaklah suatu badan yang didaftarkan di bawah Akta ini untuk menjalankan penilaian pematuhan sesuatu peranti perubatan yang akan didaftarkan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Orang yang bertanggungjawab bagi dan mempunyai kawalan keseluruhan ke atas sesuatu badan penilaian pematuhan hendaklah seorang warganegara Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_10__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_10__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_10__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_10__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu badan penilaian pematuhan hendaklah bebas dan tidak boleh mempunyai, memperoleh atau memegang apa-apa kepentingan, secara langsung atau tidak langsung, berhubungan dengan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_10__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_10__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana peranti perubatan di bawah penilaiannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_10__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_10__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa syer dalam establismen yang peranti perubatannya dinilai oleh badan penilaian pematuhan itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_10__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_10__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana syarikat yang berkaitan establismen yang peranti perubatannya dinilai oleh badan penilaian pematuhan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_10__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu badan penilaian pematuhan tidak boleh menzahirkan apa-apa maklumat yang diterima semasa tatacara penilaian pematuhan dijalankan ke atas mana-mana peranti perubatan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_10__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu badan penilaian pematuhan hendaklah diaudit oleh pihak berkuasa dari semasa ke semasa sebagaimana yang difikirkan perlu oleh pihak berkuasa. Kehendak bagi pendaftaran badan penilaian pematuhan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_11__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_11__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_11__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_11__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_11__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "tiada badan penilaian pematuhan boleh menjalankan apa-apa penilaian pematuhan yang berhubungan dengan sesuatu peranti perubatan melainkan jika badan penilaian pematuhan itu didaftarkan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu badan penilaian pematuhan boleh memohon bagi pendaftaran dengan mengemukakan permohonan bertulis kepada pihak berkuasa mengikut cara yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_11__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu permohonan boleh ditarik balik pada bila-bila masa oleh pemohon sebelum permohonan itu diluluskan atau ditolak oleh pihak berkuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_11__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "tiap-tiap permohonan di bawah subseksyen (1) hendaklah disertai dengan fi permohonan yang ditetapkan dan apa-apa dokumen atau maklumat sebagaimana yang ditentukan oleh pihak berkuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_11__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "pihak berkuasa boleh, secara bertulis, pada bila-bila masa selepas diterima permohonan di bawah subseksyen (2), meminta pemohon memberikan maklumat, butir-butir atau dokumen tambahan mengenai permohonan itu kepada pihak berkuasa dalam tempoh yang ditentukan dalam permintaan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_11__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika apa-apa maklumat, butir-butir atau dokumen tambahan yang dikehendaki di bawah subseksyen (5) tidak diberikan oleh pemohon dalam tempoh yang ditentukan dalam permintaan itu atau apa-apa masa lanjutan yang diberikan oleh pihak berkuasa, permohonan itu hendaklah disifatkan telah ditarik balik dan tidak boleh diteruskan lagi, tetapi tanpa menjejaskan hak pemohon untuk membuat permohonan baru. Pendaftaran dan keengganan untuk mendaftarkan badan penilaian pematuhan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_12__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila sesuatu permohonan yang dibuat di bawah subseksyen 11(2) diterima dan pihak berkuasa berpuas hati dengan pematuhan apa-apa kehendak di bawah subseksyen 11(4) dan (5), pihak berkuasa boleh, selepas apa-apa pemeriksaan ke atas premis badan penilaian pematuhan itu sebagaimana yang difikirkannya patut dan perlu untuk dijalankan dan apabila fi pendaftaran yang ditetapkan dibayar, mendaftarkan badan penilaian pematuhan itu bagi suatu tempoh yang ditetapkan tertakluk kepada apa-apa syarat yang difikirkan patut oleh pihak berkuasa untuk dikenakan, memberikan suatu nombor pendaftaran kepada badan penilaian pematuhan itu dan mengeluarkan suatu perakuan pendaftaran kepada badan penilaian pematuhan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "pihak berkuasa tidak boleh mendaftarkan badan penilaian pematuhan itu jika ia tidak berpuas hati dengan apa-apa perkara yang disebut dalam subseksyen (1). Kuasa untuk mengenakan syarat-syarat tambahan dan untuk mengubah atau membatalkan syarat-syarat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_13__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_13__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2",
      "schema:name": {
        "@language": "ms",
        "@value": "pihak berkuasa boleh, pada bila-bila masa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_13__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "mengenakan apa-apa syarat tambahan ke atas pendaftaran sesuatu badan penilaian pematuhan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_13__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "mengubah atau membatalkan mana-mana syarat yang dikenakan ke atas pendaftaran sesuatu badan penilaian pematuhan. Kuasa untuk membatalkan pendaftaran badan penilaian pematuhan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_14__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_14__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_14__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_14__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_14__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "tertakluk kepada subseksyen (2), pihak berkuasa boleh membatalkan pendaftaran sesuatu badan penilaian pematuhan yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_14__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_14__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah melanggar mana-mana peruntukan Akta ini atau mana-mana peraturan yang dibuat di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_14__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_14__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah memungkiri mana-mana syarat pendaftaran; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_14__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_14__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah disabitkan dengan suatu kesalahan di bawah Akta ini atau mana-mana peraturan yang dibuat di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "sebelum pendaftaran sesuatu badan penilaian pematuhan dibatalkan di bawah subseksyen (1), pihak berkuasa hendaklah, melalui notis secara bertulis, memberikan peluang kepada badan penilaian pematuhan itu untuk menunjuk sebab terhadap pembatalan itu, dan sementara menunggu keputusan mengenai pembatalan itu, semua penilaian apa-apa peranti perubatan oleh badan penilaian pematuhan itu hendaklah digantung bermula dari tarikh penerimaan notis itu oleh badan penilaian pematuhan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_14__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_II__chp_2__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu badan penilaian pematuhan yang pendaftarannya dibatalkan tidak berhak kepada apa-apa pampasan bagi apa-apa kerugian yang disebabkan kepadanya oleh pembatalan itu dan tidak berhak kepada apa-apa pembayaran balik fi pendaftaran yang ditetapkan yang telah dibayar di bawah seksyen 12."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_IV__cl_47",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "RAYUAN Rayuan terhadap keputusan Pihak Berkuasa"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_IV__cl_47",
      "@type": "akn:clause",
      "eli:number": "47",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_IV__cl_47__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_IV__cl_47__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_IV__cl_47__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_IV__cl_47__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_IV__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang terkilan dengan keputusan pihak berkuasa di bawah seksyen 7, 9, 12, 14, 18, 22, 24, 30, 33, 35, 45 atau 46 boleh merayu kepada Menteri mengikut cara yang ditetapkan dan dalam tempoh yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_IV__cl_47__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_IV__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh mengesahkan, mengakas atau mengubah keputusan pihak berkuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_IV__cl_47__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_IV__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Keputusan Menteri mengenai apa-apa rayuan di bawah subseksyen (1) adalah muktamad dan mengikat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta peranti perubatan 2011."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta. Tafsiran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I",
      "schema:name": {
        "@language": "ms",
        "@value": "Dalam Akta ini, melainkan jika konteksnya menghendaki makna yang lain—"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "“badan penilaian pematuhan” ertinya badan penilaian pematuhan yang didaftarkan di bawah sekyen 12; “ditetapkan”, melainkan jika dinyatakan selainnya, ertinya ditetapkan oleh peraturan-peraturan yang dibuat di bawah Akta ini; “establismen” ertinya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_1",
      "@type": "akn:list",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang yang sama ada pembuat, pengimport, atau pengedar yang bertanggungjawab bagi meletakkan apa-apa peranti perubatan dalam pasaran tetapi tidak termasuk peruncit; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_1__para_b__subpara_A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang wakil diberi kuasa yang dilantik oleh pembuat yang mempunyai tempat perniagaan utama di luar Malaysia, dan orang dan wakil diberi kuasa itu merupakan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_1__para_b__subpara_A",
      "@type": "akn:subparagraph",
      "eli:number": "A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang yang berdomisil atau bermastautin di Malaysia; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_2",
      "@type": "akn:list",
      "eli:number": "2",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_2__para_b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu firma atau syarikat yang ditubuhkan di bawah undang-undang Malaysia, dan menjalankan perniagaan atau amalan utamanya di Malaysia; “meletakkan dalam pasaran” ertinya menjadikan boleh didapati suatu peranti perubatan dengan mendapat balasan pembayaran atau dengan percuma bagi tujuan untuk mengedarkan, menggunakan, membekalkan atau menjadikan tersedia untuk digunakan, di Malaysia, tanpa mengira sama ada peranti perubatan itu adalah baru atau yang diproses semula, tetapi tidak termasuk untuk menjadikan boleh didapati untuk digunakan bagi kajian klinikal atau bagi penilaian prestasi sesuatu peranti perubatan; “Menteri” ertinya Menteri yang dipertanggungkan dengan tanggungjawab bagi kesihatan; “pembuat” ertinya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_3",
      "@type": "akn:list",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_3__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_3__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_3",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang yang bertanggungjawab bagi—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_3__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_3__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "reka bentuk, pengeluaran, pemasangan siap, pemasangan, pemprosesan, pembungkusan dan pelabelan sesuatu peranti perubatan sama ada atau tidak orang itu sendiri, atau subkontraktor yang bertindak bagi pihak orang itu, yang menjalankan operasi itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_3__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_3__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "menetapkan bagi peranti perubatan yang sudah siap di bawah namanya sendiri, maksud yang diniatkan baginya dan memastikan produk yang sudah siap itu memenuhi kehendak pengawalseliaan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_3__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_3__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_3",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang lain yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_3__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_3__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "memasang, membungkus, memproses, mengelokkan sepenuhnya, memproses semula atau melabel satu atau lebih peranti perubatan yang tersedia dibuat; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_3__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_3__para_b__subpara_ii__subpara_A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_3__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "menetapkan bagi peranti perubatan yang tersedia dibuat di bawah namanya sendiri, maksud yang diniatkan baginya dan memastikan produk yang sudah siap itu memenuhi kehendak pengawalseliaan, tetapi tidak termasuk orang yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_3__para_b__subpara_ii__subpara_A",
      "@type": "akn:subparagraph",
      "eli:number": "A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_3__para_b__subpara_ii",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang yang memasang atau menyesuaikan peranti perubatan dalam pasaran yang dicadangkan bagi pesakit perseorangan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_4",
      "@type": "akn:list",
      "eli:number": "4",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_4__para_b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_4",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang yang memasang, membungkus atau menyesuaikan peranti perubatan yang berhubungan dengannya pemasangan, pembungkusan atau penyesuaian itu tidak mengubah maksud yang dicadangkan bagi peranti perubatan itu; “peranti perubatan” ertinya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_5",
      "@type": "akn:list",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_5__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_5__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_5__para_a__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_5__para_a__subpara_iv",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_5__para_a__subpara_v",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_5__para_a__subpara_vi",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_5__para_a__subpara_vii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_5",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa peralatan, radas, perkakas, mesin, alat, implan, reagen atau kalibrator in vitro, perisian, bahan atau barang lain yang seumpamanya atau yang berkaitan yang diniatkan oleh pembuat untuk digunakan, secara bersendirian atau gabungan, bagi manusia bagi maksud—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_5__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_5__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "diagnosis, pencegahan, pemantauan, rawatan atau pengurangan penyakit;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_5__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_5__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "diagnosis, pemantauan, rawatan, pengurangan atau pampasan bagi sesuatu kecederaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_5__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_5__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "penyiasatan, penggantian atau pengubahsuaian, atau sokongan anatomi atau proses fisiologi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_5__para_a__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_5__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "sokongan atau pengekalan hayat;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_5__para_a__subpara_v",
      "@type": "akn:subparagraph",
      "eli:number": "v",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_5__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "pengawalan kehamilan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_5__para_a__subpara_vi",
      "@type": "akn:subparagraph",
      "eli:number": "vi",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_5__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "penyahjangkitan peranti perubatan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_5__para_a__subpara_vii",
      "@type": "akn:subparagraph",
      "eli:number": "vii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_5__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "penyediaan maklumat bagi maksud perubatan atau diagnostik dengan cara pemeriksaan in vitro ke atas spesimen yang diperoleh daripada tubuh manusia, yang tidak mencapai tindakan utama yang diniatkan baginya di dalam atau pada tubuh manusia melalui cara farmakologi, imunologi atau metabolik, tetapi yang boleh dibantu dalam fungsinya yang diniatkan itu melalui cara sedemikian; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2011/9/msa@/~part_I__cl_2__list_5",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa peralatan, radas, perkakas, mesin, alat, implan, reagen atau kalibrator in vitro, perisian, bahan atau barang lain yang seumpamanya atau yang berkaitan, untuk digunakan pada tubuh manusia, yang boleh diisytiharkan oleh Menteri, setelah mengambil kira isu keselamatan awam, kesihatan awam atau risiko awam, sebagai suatu peranti perubatan melalui perintah yang disiarkan dalam Warta; “peranti perubatan yang ditetapkan” ertinya suatu peranti perubatan yang ditentukan oleh Menteri sebagai suatu peranti perubatan yang ditetapkan melalui perintah yang disiarkan dalam Warta; “pihak berkuasa” ertinya pihak berkuasa peranti perubatan yang ditubuhkan di bawah Akta pihak berkuasa peranti perubatan 2011 [Akta ]; “tarikh yang ditetapkan” ertinya tarikh yang ditetapkan oleh Menteri di bawah subseksyen 1(2)."
      }
    },
    {
