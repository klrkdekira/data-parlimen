      "schema:text": {
        "@language": "en",
        "@value": "COMMENCEMENT OF MEDIATION Commencement of mediation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III",
      "@type": "akn:part",
      "eli:number": "III",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "MEDIATOR Appointment of mediator"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_7__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_7__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_7__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_7__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_7__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_7__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_7__subsec_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "The parties shall appoint a mediator to assist them in the mediation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_7__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_7__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "A mediator appointed under this Part shall—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_7__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_7__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "possess the relevant qualifications, special knowledge or experience in mediation through training or formal tertiary education; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_7__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_7__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "satisfy the requirements of an institution in relation to a mediator."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_7__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "The parties may request for assistance from the institution to appoint a mediator or mediators on their behalf."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_7__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "The appointment of a mediator under subsection (1) shall be made by way of a mediation agreement under section 6 and there shall be one mediator for a mediation unless the parties agree otherwise."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_7__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "If there is more than one mediator, the mediators shall act jointly in the mediation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_7__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "No appointment of any mediator shall be valid except with the prior written consent of the mediator."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_7__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "A mediator appointed under this Part shall disclose, before accepting the appointment, any known facts that a reasonable person would consider likely to affect his impartiality as mediator, including a financial or personal interest in the outcome of the mediation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_7__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "The mediator may be paid a fee or given any other consideration as agreed between the parties. Termination of appointment of mediator"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_8__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_8__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_8__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_8__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_8__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_8__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "If a mediator appointed under this Part—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_8__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_8__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "no longer possesses the relevant qualifications, special knowledge or experience in mediation as required under paragraph 7(2)(a);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_8__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_8__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "no longer satisﬁ es the requirement of an institution in relation to a mediator as required under paragraph 7(2)(b);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_8__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_8__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "is found to have financial or personal interest in the dispute;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_8__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_8__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "is found to have obtained his appointment by way of fraud; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_8__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_8__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "is unable to serve as a mediator for the mediation, the parties may terminate the appointment of the mediator and appoint another mediator for the mediation or request the institution to appoint another mediator."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_III__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (1), the parties may terminate the appointment of a mediator for any reason and shall inform the mediator the reason for the termination."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_II__cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_II__cl_5__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_II__cl_5__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_II__cl_5__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_II__cl_5__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_II__cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "A person may initiate mediation by sending to the person with whom he has a dispute, a written invitation regarding the mediation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_II__cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The written invitation referred to in subsection (1) shall briefly specify the matters in dispute."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_II__cl_5__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "Upon receipt of a written invitation sent by the person initiating the mediation under subsection (1), the person with whom he has a dispute may, in writing, accept the written invitation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_II__cl_5__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "A mediation shall be deemed to have been commenced upon the person initiating the mediation receiving the acceptance of the written invitation from the person with whom he has a dispute under subsection (3)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_II__cl_5__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "An invitation regarding a mediation under subsection (1) shall be deemed to have been rejected if the person initiating the mediation does not receive a reply from the person with whom he has a dispute, within fourteen days from the date he sends the person the written invitation or within such other period of time specified in the written invitation. Mediation agreement"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_II__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_II__cl_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_II__cl_6__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_II__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "Upon the commencement of a mediation as specified under subsection 5(4), the parties shall enter into a mediation agreement."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_II__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "A mediation agreement shall be in writing and signed by the parties."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_II__cl_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "A mediation agreement shall contain an agreement by the parties to submit to mediation disputes which have arisen or which may arise between them, the appointment of a mediator, the costs to be borne by the parties and other matters the parties deem appropriate."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_IV__cl_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_IV__cl_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_IV__cl_11"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "MEDIATION PROCESS Role of mediator"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_IV__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_IV__cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_IV__cl_10__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_IV__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_IV__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "A mediator may request each party to submit a statement setting out the brief facts of the dispute, supplemented by any documents that the party deems appropriate to submit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_IV__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_IV__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "At any stage of a mediation, a mediator may request any party to submit any additional information or document as the mediator deems appropriate. Conduct of mediation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_IV__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_IV__cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_IV__cl_11__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_IV__cl_11__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_IV__cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_IV__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "A mediator shall ensure that a mediation is privately conducted and he may meet with the parties together or with each party separately."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_IV__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_IV__cl_11__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_IV__cl_11__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_IV__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_IV__cl_11__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_IV__cl_11__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "a non-party of any party’s choice may participate in a mediation to assist the party, subject to the consent of the mediator; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_IV__cl_11__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_IV__cl_11__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "a non-party of a mediator’s choice may participate in a mediation to assist the mediator during the mediation, subject to the consent of the parties."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_IV__cl_11__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_IV__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "A mediator may end the mediation if, in his opinion, further efforts at mediation would not contribute to a satisfactory resolution of the dispute between the parties."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_IV__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_IV__cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_IV__cl_9__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_IV__cl_9__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_IV__cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_IV__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "A mediator shall facilitate a mediation and determine the manner in which the mediation is to be conducted."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_IV__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_IV__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "A mediator may assist the parties to reach a satisfactory resolution of the dispute and suggest options for the settlement of the dispute."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_IV__cl_9__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_IV__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of subsection (1), the mediator shall act independently and impartially. Submission of statements to mediator"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_I__cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Mediation Act 2012."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Non-application"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_I__cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_I__cl_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_I__cl_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_I",
      "schema:name": {
        "@language": "en",
        "@value": "This Act shall not apply to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_I__cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_I__cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "any dispute regarding matters specified in the Schedule;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_I__cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_I__cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "any mediation conducted by a judge, magistrate or officer of the court pursuant to any civil action that has been filed in court; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_I__cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_I__cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "any mediation conducted by the Legal Aid Department. Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_I__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_I__cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_I__cl_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_I__cl_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_I",
      "schema:name": {
        "@language": "en",
        "@value": "In this Act, unless the context otherwise requires—"
      },
      "schema:text": {
        "@language": "en",
        "@value": "“non-party” means a person who participates in a mediation, other than a party or mediator, and includes counsels of each party, experts in the subject matter of a dispute and witnesses; “institution” means a body or organization that provides mediation services; “mediation communication” means an oral or written statement made—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_I__cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_I__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "during a mediation;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_I__cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_I__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "in relation to a mediation; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_I__cl_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_I__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "for the purposes of considering, conducting, participating in, commencing, continuing, reconvening or concluding a mediation or retaining a mediator; “Minister” means the Minister charged with the responsibility for legal affairs; “mediator” means a mediator appointed by the parties under section 7; “mediation” means a voluntary process in which a mediator facilitates communication and negotiation between parties to assist the parties in reaching an agreement regarding a dispute; “mediation agreement” means the agreement referred to in section 6; “settlement agreement” means the agreement referred to in section 13; “party” means a party to a mediation agreement and includes the Federal Government and a State Government; “proceedings” means any proceedings of a civil nature and includes an application at any stage of proceedings. Mediation does not prevent court action, arbitration, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_I__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_I__cl_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_I__cl_4__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_I__cl_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_I__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to section 2, any person may, before commencing any civil action in court or arbitration, initiate mediation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_I__cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_I__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "A mediation under this Act shall not prevent the commencement of any civil action in court or arbitration nor shall it act as a stay of, or extension of any proceedings, if the proceedings have been commenced."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_V",
      "@type": "akn:part",
      "eli:number": "V",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_V__cl_12",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_V__cl_13",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_V__cl_14"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "CONCLUSION OF MEDIATION Conclusion of mediation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VI",
      "@type": "akn:part",
      "eli:number": "VI",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VI__cl_15",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VI__cl_16"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "CONFIDENTIALITY AND PRIVILEGE Confidentiality"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VII",
      "@type": "akn:part",
      "eli:number": "VII",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VII__cl_17",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VII__cl_18",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VII__cl_19",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VII__cl_20"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "MISCELLANEOUS Costs"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VII__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VII__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VII__cl_17__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VII__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VII__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "The costs of a mediation shall be borne equally by the parties."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VII__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VII__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (1), the parties may agree on the amount of costs to be borne by each party. Power to amend Schedule"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VII__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, by order published in the Gazette, amend the Schedule. Liability of a mediator"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VII__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "A mediator shall not be liable for any act or omission in respect of anything done or omitted to be done in the discharge of his functions as a mediator unless the act or omission is proved to have been fraudulent or involves wilful misconduct. Regulations"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VII__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may make regulations for the better carrying out of the objects and purposes of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VI__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VI__cl_15__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VI__cl_15__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VI__cl_15__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VI__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall disclose any mediation communication."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VI__cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VI__cl_15__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VI__cl_15__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VI__cl_15__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VI__cl_15__subsec_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VI__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (1), mediation communication may be disclosed if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VI__cl_15__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VI__cl_15__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the disclosure is made with the consent of the parties;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VI__cl_15__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VI__cl_15__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the disclosure is made with the consent of the person who gives the mediation communication;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VI__cl_15__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VI__cl_15__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the disclosure is required under this Act or for the purpose of any civil or criminal proceedings under any written law; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VI__cl_15__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VI__cl_15__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the disclosure is required under any other written law for the purposes of implementation or enforcement of a settlement agreement. Privilege"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VI__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VI__cl_16__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VI__cl_16__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VI__cl_16__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VI__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "Any mediation communication is privileged and is not subject to discovery or be admissible in evidence in any proceedings."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VI__cl_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VI__cl_16__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VI__cl_16__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VI__cl_16__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VI__cl_16__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VI__cl_16__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VI__cl_16__subsec_2__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VI__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (1), the mediation communication is not privileged if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VI__cl_16__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VI__cl_16__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the privilege is expressly waived in writing by the parties, the mediator and the non-party;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VI__cl_16__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VI__cl_16__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "it is a public document by virtue of the Evidence Act 1950 [Act 56];"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VI__cl_16__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VI__cl_16__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "it is a threat to inflict bodily injury or commit a crime;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VI__cl_16__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VI__cl_16__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "it is used or intended to be used to plan a crime, attempt to commit or commit a crime, or to conceal a crime or criminal activity or an ongoing crime or ongoing criminal activity;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VI__cl_16__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VI__cl_16__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "it is sought or offered to prove or disprove a claim or complaint of professional misconduct or malpractice filed against a mediator; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VI__cl_16__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_VI__cl_16__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "it is sought or offered to prove or disprove a claim or complaint of professional misconduct or malpractice filed against a party, non-party, or representative of a party based on their conduct during any mediation session."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_V__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_V__cl_12__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_V__cl_12__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_V__cl_12__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_V__cl_12__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_V",
      "schema:name": {
        "@language": "en",
        "@value": "A mediation shall conclude—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_V__cl_12__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_V__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "upon the signing of a settlement agreement by the parties under section 13;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_V__cl_12__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_V__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "upon the issuance of a written declaration by a mediator to the parties stating that further efforts at mediation would not contribute to a satisfactory resolution of the dispute;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_V__cl_12__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_V__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "upon the issuance of a written declaration by the parties to a mediator stating that the mediation is terminated; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_V__cl_12__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_V__cl_12__para_d__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_V__cl_12__para_d__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_V__cl_12__para_d__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_V__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "unless otherwise provided by mediation agreement referred to in section 6—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_V__cl_12__para_d__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_V__cl_12__para_d",
      "schema:text": {
        "@language": "en",
        "@value": "upon the issuance of a written declaration by a party to the other party and the mediator stating that the mediation is terminated;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_V__cl_12__para_d__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_V__cl_12__para_d",
      "schema:text": {
        "@language": "en",
        "@value": "upon the withdrawal from a mediation by any party; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_V__cl_12__para_d__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_V__cl_12__para_d",
      "schema:text": {
        "@language": "en",
        "@value": "upon the death of any party or incapacity of any party. Settlement agreement"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_V__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_V__cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_V__cl_13__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_V__cl_13__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_V__cl_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_V__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "Upon the conclusion of a mediation and the reaching of an agreement by the parties regarding a dispute, the parties shall enter into a settlement agreement."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_V__cl_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_V__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The settlement agreement under subsection (1) shall be in writing and signed by the parties."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_V__cl_13__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_V__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The mediator shall authenticate the settlement agreement and furnish a copy of the agreement to the parties. Effect of settlement agreement"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_V__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_V__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_V__cl_14__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_V__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_V__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "A settlement agreement shall be binding on the parties."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_V__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~part_V__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "If proceedings have been commenced in court, the settlement agreement may be recorded before the court as a consent judgment or judgment of the court."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~sched_1__para_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~sched_1__para_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~sched_1__para_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~sched_1__para_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~sched_1__para_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~sched_1__para_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~sched_1__para_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~sched_1__para_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~sched_1__para_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~sched_1__para_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~sched_1__para_11"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "[Paragraph 2(a)] NON-APPLICATION"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~sched_1__para_1",
      "@type": "akn:paragraph",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~sched_1",
      "schema:text": {
        "@language": "en",
        "@value": "Proceedings involving a question which arises as to the effect of any provision of the Federal Constitution."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~sched_1__para_10",
      "@type": "akn:paragraph",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~sched_1",
      "schema:text": {
        "@language": "en",
        "@value": "Any proceedings before a native court."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~sched_1__para_11",
      "@type": "akn:paragraph",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~sched_1",
      "schema:text": {
        "@language": "en",
        "@value": "Any criminal matter."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~sched_1__para_2",
      "@type": "akn:paragraph",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~sched_1",
      "schema:text": {
        "@language": "en",
        "@value": "Suits involving prerogative writs, as set out in the Schedule to the Courts of Judicature Act 1964 [Act 91]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~sched_1__para_3",
      "@type": "akn:paragraph",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/eng@/~sched_1",
      "schema:text": {
        "@language": "en",
        "@value": "Proceedings involving the remedy of temporary or permanent injunctions."
      }
    },
    {
