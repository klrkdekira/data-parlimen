      "schema:text": {
        "@language": "ms",
        "@value": "KERAHSIAAN DAN PERLINDUNGAN Kerahsiaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VII",
      "@type": "akn:part",
      "eli:number": "VII",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VII__cl_17",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VII__cl_18",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VII__cl_19",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VII__cl_20"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "PELBAGAI Kos"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VII__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VII__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VII__cl_17__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VII__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VII__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Kos pengantaraan hendaklah ditanggung secara sama rata oleh pihak-pihak."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VII__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VII__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (1), pihak-pihak boleh bersetuju tentang amaun kos yang akan ditanggung oleh setiap pihak. Kuasa meminda Jadual"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VII__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, melalui perintah yang disiarkan dalam Warta, meminda Jadual. Tanggungan pengantara"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VII__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pengantara tidaklah bertanggungan bagi apa-apa perbuatan atau peninggalan berkenaan dengan apa-apa yang dilakukan atau yang ditinggalkan daripada dilakukan dalam menunaikan fungsinya sebagai pengantara melainkan jika perbuatan atau peninggalan itu telah dibuktikan sebagai fraud atau melibatkan salah laku secara sengaja. Peraturan-peraturan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VII__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh membuat peraturan-peraturan bagi penjalanan yang lebih baik tujuan dan maksud Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VI__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VI__cl_15__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VI__cl_15__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VI__cl_15__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VI__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh menzahirkan apa-apa komunikasi pengantaraan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VI__cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VI__cl_15__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VI__cl_15__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VI__cl_15__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VI__cl_15__subsec_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VI__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (1), komunikasi pengantaraan boleh dizahirkan jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VI__cl_15__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VI__cl_15__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "penzahiran itu dibuat dengan persetujuan pihak-pihak;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VI__cl_15__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VI__cl_15__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "penzahiran itu dibuat dengan persetujuan orang yang memberikan komunikasi pengantaraan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VI__cl_15__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VI__cl_15__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "penzahiran itu dikehendaki di bawah Akta ini atau bagi maksud apa-apa prosiding sivil atau jenayah di bawah mana-mana undang-undang bertulis; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VI__cl_15__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VI__cl_15__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "penzahiran itu dikehendaki di bawah mana-mana undang- undang bertulis yang lain bagi maksud pelaksanaan atau penguatkuasaan sesuatu perjanjian penyelesaian. Perlindungan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VI__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VI__cl_16__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VI__cl_16__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VI__cl_16__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VI__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa komunikasi pengantaraan dilindungi dan tidak tertakluk kepada penzahiran atau tidak boleh diterima sebagai keterangan dalam mana-mana prosiding."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VI__cl_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VI__cl_16__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VI__cl_16__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VI__cl_16__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VI__cl_16__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VI__cl_16__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VI__cl_16__subsec_2__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VI__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (1), komunikasi pengantaraan tidak dilindungi jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VI__cl_16__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VI__cl_16__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "perlindungan itu diketepikan dengan nyata secara bertulis oleh pihak-pihak, pengantara dan bukan pihak;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VI__cl_16__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VI__cl_16__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "ia dokumen awam menurut Akta Keterangan 1950 [Akta 56];"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VI__cl_16__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VI__cl_16__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "ia ugutan untuk menyebabkan kecederaan tubuh badan atau untuk melakukan jenayah;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VI__cl_16__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VI__cl_16__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "ia digunakan atau diniatkan untuk digunakan bagi merancang jenayah, cubaan melakukan atau melakukan jenayah, atau bagi menyembunyikan jenayah atau kegiatan jenayah atau jenayah atau kegiatan jenayah yang sedang dilakukan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VI__cl_16__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VI__cl_16__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "ia diperoleh atau ditawarkan untuk membuktikan atau membuktikan sebaliknya sesuatu dakwaan atau aduan mengenai salah laku atau amalan salah berkaitan dengan profesion yang difailkan terhadap pengantara; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VI__cl_16__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_VI__cl_16__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "ia diperoleh atau ditawarkan untuk membuktikan atau membuktikan sebaliknya sesuatu dakwaan atau aduan mengenai salah laku atau amalan salah berkaitan dengan profesion yang difailkan terhadap sesuatu pihak, bukan pihak, atau wakil pihak berdasarkan kelakuannya semasa mana-mana sesi pengantaraan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_V__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_V__cl_12__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_V__cl_12__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_V__cl_12__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_V__cl_12__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_V",
      "schema:name": {
        "@language": "ms",
        "@value": "Pengantaraan hendaklah berakhir—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_V__cl_12__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_V__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "apabila perjanjian penyelesaian ditandatangani oleh pihak- pihak di bawah seksyen 13;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_V__cl_12__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_V__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "apabila pengantara mengeluarkan suatu akuan bertulis kepada pihak-pihak yang menyatakan bahawa usaha selanjutnya melalui pengantaraan tidak akan menyumbang kepada penyelesaian yang memuaskan bagi pertikaian itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_V__cl_12__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_V__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "apabila pihak-pihak mengeluarkan suatu akuan bertulis kepada pengantara yang menyatakan bahawa pengantaraan itu ditamatkan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_V__cl_12__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_V__cl_12__para_d__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_V__cl_12__para_d__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_V__cl_12__para_d__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_V__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "melainkan jika diperuntukkan selainnya oleh perjanjian pengantaraan yang disebut dalam seksyen 6— Perjanjian penyelesaian"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_V__cl_12__para_d__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_V__cl_12__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "apabila suatu pihak mengeluarkan suatu akuan bertulis kepada pihak yang satu lagi dan pengantara yang menyatakan bahawa pengantaraan itu ditamatkan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_V__cl_12__para_d__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_V__cl_12__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "apabila mana-mana pihak menarik diri daripada pengantaraan itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_V__cl_12__para_d__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_V__cl_12__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "apabila mana-mana pihak mati atau tidak berkeupayaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_V__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_V__cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_V__cl_13__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_V__cl_13__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_V__cl_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_V__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila pengantaraan berakhir dan pihak-pihak mencapai persetujuan berkenaan dengan sesuatu pertikaian, pihak-pihak itu hendaklah membuat suatu perjanjian penyelesaian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_V__cl_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_V__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Perjanjian penyelesaian di bawah subseksyen (1) hendaklah secara bertulis dan ditandatangani oleh pihak-pihak."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_V__cl_13__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_V__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengantara hendaklah mengesahkan perjanjian penyelesaian itu dan memberikan suatu salinan perjanjian itu kepada pihak- pihak. Kesan perjanjian penyelesaian"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_V__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_V__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_V__cl_14__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_V__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_V__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Perjanjian penyelesaian hendaklah mengikat pihak- pihak."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_V__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~part_V__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika prosiding telah dimulakan di mahkamah, perjanjian penyelesaian itu boleh direkodkan di hadapan mahkamah itu sebagai penghakiman persetujuan atau penghakiman mahkamah itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~sched_1__para_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~sched_1__para_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~sched_1__para_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~sched_1__para_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~sched_1__para_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~sched_1__para_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~sched_1__para_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~sched_1__para_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~sched_1__para_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~sched_1__para_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~sched_1__para_11"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "[Perenggan 2(a)] KETIDAKPAKAIAN"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~sched_1__para_1",
      "@type": "akn:paragraph",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~sched_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Prosiding yang melibatkan persoalan yang berbangkit tentang kesan mana-mana peruntukan Perlembagaan Persekutuan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~sched_1__para_10",
      "@type": "akn:paragraph",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~sched_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa prosiding di hadapan mahkamah anak negeri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~sched_1__para_11",
      "@type": "akn:paragraph",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~sched_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa perkara jenayah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~sched_1__para_2",
      "@type": "akn:paragraph",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~sched_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Guaman yang melibatkan writ prerogatif, sebagaimana yang dinyatakan dalam Jadual kepada Akta Mahkamah Kehakiman 1964 [Akta 91]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~sched_1__para_3",
      "@type": "akn:paragraph",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~sched_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Prosiding yang melibatkan remedi injunksi sementara atau injunksi kekal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~sched_1__para_4",
      "@type": "akn:paragraph",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~sched_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Petisyen pilihan raya di bawah Akta Kesalahan Pilihan Raya 1954 [Akta 5]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~sched_1__para_5",
      "@type": "akn:paragraph",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~sched_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Prosiding di bawah Akta Pengambilan Tanah 1960 [Akta 486]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~sched_1__para_6",
      "@type": "akn:paragraph",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~sched_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Prosiding yang melibatkan penjalanan bidang kuasa asal Mahkamah Persekutuan di bawah Perkara 128 Perlembagaan Persekutuan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~sched_1__para_7",
      "@type": "akn:paragraph",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~sched_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Semakan kehakiman."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~sched_1__para_8",
      "@type": "akn:paragraph",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~sched_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Rayuan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~sched_1__para_9",
      "@type": "akn:paragraph",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/1/msa@/~sched_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Semakan."
      }
    }
  ]
}
