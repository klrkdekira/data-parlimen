        "@value": "Educational Institutions (Discipline) (Amendment) Bill 2012"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/10/eng@/~cl_1",
      "@type": "akn:clause",
