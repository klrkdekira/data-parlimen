      },
      "eli:jurisdiction": {
        "@id": "http://publications.europa.eu/resource/authority/country/MYS"
      },
      "eli:language": "en",
      "eli:number": "DR-12-2012",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_8"
      ],
      "schema:name": {
        "@language": "en",
        "@value": "Pingat Tentera Udara (Remembrance Allowance) Bill 2012"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Pingat Tentera Udara (Remembrance Allowance) Act 2012."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act is deemed to have come into operation on 1 July 2011. Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "In this Act, unless the context otherwise requires—"
      },
      "schema:text": {
        "@language": "en",
        "@value": "“child” includes a step-child and a child adopted by the recipient under any written law relating to adoption; “Decoration” means the Decoration of Pingat Tentera Udara conferred under the Statutes of Pingat Tentera Udara [G.N. 4043/68]; “remembrance allowance” means the remembrance allowance granted under subsection 3(1); “spouse” means the widow or widower of a deceased recipient whose marriage is recognized in Malaysia as a valid marriage under any written law, religion or custom; “recipient” means a person who has been conferred the Decoration; “social guarantor” means a person who provides, not for the purpose of making profit, any of the following guarantees:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "a guarantee for a loan, scholarship or grant for educational or research purposes;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "a guarantee for a hire-purchase transaction of a vehicle for personal or non-business use;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "a guarantee for a housing loan transaction solely for personal dwelling. Grant of remembrance allowance"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_3__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_3__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_3__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_3__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "There may be granted to a recipient of a Decoration a remembrance allowance of one thousand ringgit a month, and where the Decoration is conferred on such recipient more than once, there may be granted to him a separate remembrance allowance of one thousand ringgit a month in respect of each Decoration conferred on him."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "The remembrance allowance shall only be payable to a recipient who is still living at the commencement of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_3__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "The remembrance allowance shall be payable in arrear no earlier than the end of each month."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_3__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Decoration is conferred before the commencement of this Act, the remembrance allowance shall be paid to the recipient, in any case, commencing with the month of the commencement of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_3__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Decoration is conferred on or after the commencement of this Act, the remembrance allowance shall be paid to the recipient commencing with the month in which the Decoration is conferred on him. Cessation of grant of remembrance allowance"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_4__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_4__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_4__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_4__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_4__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_4__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_4__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_4__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "The grant of a remembrance allowance shall cease–"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_4__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "if the recipient dies;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_4__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "if the recipient has been convicted for any offence by a court of law in the Federation;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_4__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "if the recipient has been ordered by a court of law in the Federation in any civil action to pay an amount which exceeds two thousand ringgit; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_4__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "upon the cancellation or annulment of the conferment of the Decoration in accordance with section VI of the Statutes of Pingat Tentera Udara."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_4__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_4__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_4__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_4__subsec_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "No remembrance allowance shall be paid commencing—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_4__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_4__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "with the month in which the death of the recipient takes place;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_4__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_4__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "with the month in which the sentence for an offence is imposed on the recipient;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_4__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_4__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "with the month in which the order referred to in paragraph (1)(c) is imposed on the recipient; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_4__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_4__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "with the month in which the conferment of the Decoration is cancelled or annulled, as the case may be."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_4__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "If there is an appeal against such sentence or order referred to in paragraph (1)(b) or (c) by the recipient, the remembrance allowance shall not be paid commencing with the month in which such sentence or order is confirmed on such appeal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_4__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "If the recipient receives a free pardon in respect of such conviction referred to in paragraph (1)(b), or if the cancelled or annulled Decoration is restored to him, the remembrance allowance shall be restored to him commencing with the month in which the free pardon is received or the Decoration is restored."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_4__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraph (1)(c) does not apply to a recipient where the court order against him was made in his capacity as a social guarantor. Grant to next-of-kin of recipient where Decoration is conferred posthumously"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_5__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_5__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Decoration is conferred posthumously after the commencement of this Act, there may be made a grant of a total sum of ten thousand ringgit once only—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "to the spouse or spouses and children of the deceased recipient who are living on the date of the conferment of the Decoration;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "if on the date of the conferment of the Decoration no spouse or child of the deceased recipient is living, to the parents or parent of the deceased recipient who are or is living on such date; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "if on the date of the conferment of the Decoration no spouse, child or parent of the deceased recipient is living, to the grandparents or grandparent of the deceased recipient who are or is living on such date. Prime Minister to apportion amount to be paid"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The amount to be paid to the spouse or spouses, children, parents or grandparents, as the case may be, under section 5 shall be in such proportions as may be determined by the Prime Minister. Remembrance allowance and sum to be charged to the Federal Consolidated Fund"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The remembrance allowance and sum granted under this Act shall be charged to the Federal Consolidated Fund. Remembrance allowance and sum not assignable, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/12/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Any remembrance allowance or sum granted under this Act shall not be assignable, transferable, liable to be attached, sequestrated or levied upon in respect of any claim."
      }
    }
  ]
}
