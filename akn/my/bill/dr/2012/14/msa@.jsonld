        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/14/msa@/~cl_2__list_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/14/msa@/~cl_2__list_3__para_d",
