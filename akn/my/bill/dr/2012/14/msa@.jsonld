    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/14/msa@/~cl_2__list_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/14/msa@/~cl_2__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa produk atau perkiraan yang berasaskan sekuriti atau derivatif, atau mana-mana gabungannya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/14/msa@/~cl_2__list_2__para_f",
      "@type": "akn:paragraph",
