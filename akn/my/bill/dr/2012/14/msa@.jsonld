      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa produk lain yang ditetapkan oleh Menteri sebagai suatu produk pasaran modal;’;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/14/msa@/~cl_2__list_3",
