      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 139ZK Akta ibu dipinda pada nota bahu dengan memasukkan selepas perkataan “mengelirukan” perkataan “kepada Suruhanjaya”. Seksyen baru 139ZN, 139ZO, 139ZP, 139ZQ dan 139ZR"
      }
    }
