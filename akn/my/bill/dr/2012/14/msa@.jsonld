      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 20(1) Akta ibu dipinda dengan menggantikan perkataan “seksyen 212” dengan perkataan “seksyen 214”. Pemotongan seksyen 70"
      }
    },
