      ],
      "schema:name": {
        "@language": "en",
        "@value": "Security Offences (Special Measures) Bill 2012"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/15/eng@/~part_I",
