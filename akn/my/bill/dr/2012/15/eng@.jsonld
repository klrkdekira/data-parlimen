      "schema:text": {
        "@language": "en",
        "@value": "PRELIMINARY Short title and commencement"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/15/eng@/~part_II",
      "@type": "akn:part",
      "eli:number": "II",
