      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the definition of “prescribed product” the following definition: ‘ “qualified person” means a person who fulfils the requirement as the Director General may determine to conduct an environmental audit and environmental impact assessment, and to submit a report thereon;’;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/19/eng@/~cl_3__para_c",
      "@type": "akn:paragraph",
