      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the definition of “pollution” the following definition: ‘ “pollution” means an act or process, whether natural or artificial, resulting in the introduction of any pollutant into the environment in contravention of the acceptable conditions as specified in the regulations made under section 21;’;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/19/eng@/~cl_3__para_d",
