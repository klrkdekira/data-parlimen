      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the full stop at the end of paragraph (c) the words “; and”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/19/eng@/~cl_8__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/19/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
