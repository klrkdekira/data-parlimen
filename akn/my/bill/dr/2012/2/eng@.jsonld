        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_44",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_45"
      ],
