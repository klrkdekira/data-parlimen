      "schema:text": {
        "@language": "en",
        "@value": "Where a member of the Board is a representative of a ministry, department or organization and—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_12__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "that ministry, department or organization is renamed; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_12__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "the functions of the ministry, department or organization have been assumed by another ministry, department or organization, the member shall be renamed as a representative of the ministry, department or organization as renamed or of the ministry, department or organization by whom the functions are assumed. Deputy Chairman and Secretary"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_13__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister shall appoint a Deputy Chairman of the Board from among the members of the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The Board shall appoint an officer of the Institute to be the Secretary of the Board. Functions of Board"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_14__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_14__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_14__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_14__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_14__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III",
      "schema:name": {
        "@language": "en",
        "@value": "The functions of the Board shall be—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_14__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "to review the policies and the strategic direction of the Institute;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_14__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "to advise the Minister on matters relating to this Act and developments pertaining to road safety research with particular reference to the implications of such developments for Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_14__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "to make recommendations to the Minister as to the methods, measures and policies to be adopted to facilitate the development of road safety research, and if approved by the Minister, to implement and assist in the implementation thereof through the Institute;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_14__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "to do such things as are necessary or advantageous and proper for the governance, control and management of the Institute; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_14__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "to do such other things arising out of or consequential to the functions of the Board under this Act which are not inconsistent with the purposes of this Act, whether or not directed by the Minister. Powers of Board"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "The Board shall be the executive body of the Institute and may exercise all the powers conferred on the Institute by this Act. Tenure of office"
      }
    },
