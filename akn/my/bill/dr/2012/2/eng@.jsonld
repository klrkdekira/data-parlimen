      "schema:text": {
        "@language": "en",
        "@value": "the Inspector General of Police or his representative;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_11__subsec_1__para_d",
