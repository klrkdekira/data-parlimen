        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_41"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "FINANCE Establishment of Fund"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI",
      "@type": "akn:part",
      "eli:number": "VI",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_42",
