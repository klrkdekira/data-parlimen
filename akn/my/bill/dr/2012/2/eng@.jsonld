      "schema:text": {
        "@language": "en",
        "@value": "the Director General of the Road Transport Department or his representative;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_11__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_11__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Director General of the Road Safety Department or his representative;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_11__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_11__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a representative from the Ministry of Transport;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_11__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_11__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a representative from the Ministry of Finance; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_11__subsec_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_11__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "not less than two and not more than six members who, in the opinion of the Minister, have experience and shown capacity and professionalism in matters relating to road safety including transport, education, media, engineering, medicine, research and human resource, or are otherwise suitable for appointment because of their special knowledge and experience in matters relating to road safety."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister shall appoint the members in paragraphs (1)(a), (f), (g) and (h)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_11__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "The Schedule shall apply to the members of the Board. Representative of renamed organization"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
