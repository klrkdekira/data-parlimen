        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_21__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_21__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_21__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_21__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_21__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_21__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_21__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_21__subsec_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_21__subsec_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_21__subsec_11",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_21__subsec_12"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_21__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may establish any committee as it considers necessary or expedient to assist it in the performance of its functions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_21__subsec_10",
      "@type": "akn:subsection",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may revoke the appointment of any member of a committee without assigning any reason for the revocation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_21__subsec_11",
      "@type": "akn:subsection",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "A member of a committee may resign by giving a written notice to the Board not less than fourteen days prior to the intended date of resignation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_21__subsec_12",
      "@type": "akn:subsection",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_21__subsec_12__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_21__subsec_12__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "A committee shall cause—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_21__subsec_12__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_21__subsec_12",
      "schema:text": {
        "@language": "en",
        "@value": "minutes of all its meetings to be maintained and kept in proper form; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_21__subsec_12__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_21__subsec_12",
      "schema:text": {
        "@language": "en",
        "@value": "copies of the minutes of all its meetings to be submitted to the Board as soon as practicable. Allowances"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_21__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may appoint any person to be a member of a committee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_21__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "A committee established under this section may elect any of its members to be the chairman of the committee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_21__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "A committee may regulate its own procedure."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_21__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "A committee shall be subject to, and act in accordance with, any direction given to the committee by the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_21__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "The meetings of a committee shall be held at such times and places as the chairman of the committee may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_21__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "A committee may invite any person who is not a member of the committee to attend any of its meetings for the purpose of advising it on any matter under discussion, but that person shall not be entitled to vote at the meeting."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_21__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "The members of a committee or any person invited under subsection (7) to attend any meeting of the committee may be paid such allowances and other expenses as the Board may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_21__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subsections (10), (11) and (12), a member of a committee shall hold office on such conditions and for such term as may be specified in his letter of appointment and is eligible for reappointment."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "There shall be paid to every member of the Board who is not an officer or servant of the Institute such allowances out of the Fund at such rates as the Minister may, after consultation with the Minister of Finance, determine. Power of Minister to give directions"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_23__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_23__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_23__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "The Board shall be responsible to the Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_23__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may give to the Board directions of a general character consistent with this Act relating to the performance of the functions of the Board, and the Board shall give effect to such directions. Validity of acts and proceedings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_24__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_24__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "No acts done or proceedings taken under this Act shall be questioned on the ground of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_24__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "any vacancy in the membership of or any defect in the constitution of the Board; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_24__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_III__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "any omission, defect or irregularity not affecting the merits of the case."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_4__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_4__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "A body corporate by the name of the “Malaysian Institute of Road Safety Research” or “MIROS” is established."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "The Institute shall have perpetual succession and may sue and be sued in its corporate name."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_4__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_4__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_4__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to and for the purposes of this Act, the Institute may upon such terms as it deems fit—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_4__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_4__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "enter into contracts; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_4__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_4__subsec_3__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_4__subsec_3__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_4__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "in respect of movable and immovable property and interest in movable and immovable property of every description—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_4__subsec_3__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_4__subsec_3__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "acquire, purchase and take such property and interest; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_4__subsec_3__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_4__subsec_3__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "hold, enjoy, convey, assign, surrender, yield up, charge, mortgage, demise, reassign, transfer or otherwise dispose of, or deal with such property and interest vested in the Institute. Common seal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_5__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_5__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_5__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_5__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_5__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The Institute shall have a common seal and the seal may from time to time be altered and made anew as the Institute thinks fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "Until a seal is provided by the Institute, a stamp bearing the words “Malaysian Institute of Road Safety Research” may be used and shall be deemed to be the common seal of the Institute."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_5__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The common seal shall be kept in the custody of the Director General or any other person authorized by the Institute in writing, and shall be authenticated by either the Director General or such other person as may be authorized by the Director General in writing."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_5__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "All deeds, documents and other instruments purported to be sealed with the common seal and duly authenticated shall, until the contrary is proved, be deemed to have been validly executed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_5__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "Any deed, document and other instrument which, if executed by a person not being a body corporate and is not required to be under seal may in the like manner be executed by an officer of the Institute authorized in that behalf."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_5__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The common seal of the Institute shall be officially and judicially noticed. Functions of Institute"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_6__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_6__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_6__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_6__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_6__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_6__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_6__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_6__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_6__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_6__para_k",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_6__para_l",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_6__para_m"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II",
      "schema:name": {
        "@language": "en",
        "@value": "The functions of the Institute shall be—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "to conduct comprehensive research on road safety, and to provide general directions for activities in respect of road safety research;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "to assist in the development of national objectives, policies and priorities for the orderly development and administration of road safety;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_6__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "to enhance and increase knowledge based on new developments regarding issues related to road safety;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_6__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "to raise the level of public awareness on road safety;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_6__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "to propose practical solutions with optimal effectiveness on road safety issues;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_6__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "to collect, analyze and manage data in relation to road safety;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_6__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "to develop, promote the use of, value add and commercialize research findings on road safety;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_6__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "to collect, collate and disseminate information relating to research findings on road safety by way of publishing or sponsoring the publication of periodicals, journals, books and any other means available, and to provide consultation and advice on road safety issues;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_6__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "to plan and evaluate road safety programmes, and to conduct related training;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_6__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "to review standards and learning outcomes of the curriculum for courses of instruction provided by driving institutions and audit the benchmark in respect of the delivery system of driving institutions;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_6__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "to review testing methods carried out by vehicle inspection organizations;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_6__para_l",
      "@type": "akn:paragraph",
      "eli:number": "l",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "to be a member of, be affiliated with or to maintain liaison with, other organizations, both public and private, local and foreign, having similar functions or activities as those of the Institute; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_6__para_m",
      "@type": "akn:paragraph",
      "eli:number": "m",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "to co-operate with any person, association or organization, both local and foreign, with a view to furthering the effective performance of the Institute. Powers of Institute"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_7__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "The Institute shall have the power to do all things necessary or expedient for or in connection with the performance of its functions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_7__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_7__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_7__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_7__subsec_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to the generality of subsection (1), the powers of the Institute shall include the power—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_7__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_7__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to impose fees or charges in relation to any activity or services rendered by the Institute or usage of the facilities of the Institute, and to collect and receive moneys in respect thereof;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_7__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_7__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to acquire rights in connection with any research findings on road safety owned by any person or organization;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_7__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_7__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to hold, dispose of or grant rights in connection with any research findings on road safety conducted by or for the Institute, or rights in such research findings that are vested in the Institute; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_7__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_7__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to assign any person or body to conduct research and development activities relating to road safety on behalf of the Institute. Additional power of Institute"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to section 9, the Institute may, with the approval of the Minister and the concurrence of the Minister of Finance establish companies under the Companies Act 1965 [Act 125] for purposes of carrying out or engaging in any activity which has been planned or undertaken by the Institute in connection with the discharge of its functions and powers. Commercialization of research findings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "The Institute may enter into any arrangement to make available any research findings vested in the Institute to any person or body on such terms, conditions and the payment of such fees, royalties or other consideration, if any, as the Board may, with the approval of the Minister, determine for the purpose of its commercialization."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV__cl_25",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV__cl_26",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV__cl_27",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV__cl_28",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV__cl_29",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV__cl_30",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV__cl_31"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "DIRECTOR GENERAL, DEPUTY DIRECTOR GENERALS, OFFICERS AND SERVANTS OF INSTITUTE Appointment of Director General"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV__cl_25__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV__cl_25__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV__cl_25__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV__cl_25__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV__cl_25__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV__cl_25__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV__cl_25__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, upon the recommendation of the Board, appoint any person with appropriate skills or expertise to serve as the Director General of the Institute and shall vest in him such powers and impose upon him such duties as may be determined by the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV__cl_25__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General shall be responsible for the overall administration and management of the functions and the day-to- day affairs of the Institute."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV__cl_25__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General shall have general control of the officers and servants of the Institute."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV__cl_25__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General shall perform such further duties as the Board may from time to time direct."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV__cl_25__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "In discharging his duties, the Director General shall act under the general authority and direction of the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV__cl_25__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "If the Director General is temporarily absent from Malaysia or is unable through illness or any other reason, to perform the duties of his office, the Director General shall appoint any person to carry out the duties of the Director General during such temporary absence or inability. Appointment of Deputy Director Generals"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may appoint such persons with appropriate skills or expertise, as recommended by the Director General, to be Deputy Director Generals of the Institute to assist the Director General in the performance of his duties. Power to delegate"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV__cl_27__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV__cl_27__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV__cl_27__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV__cl_27__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV__cl_27__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General may in writing delegate any of his functions, subject to such conditions, limitations or restrictions as he thinks fit, to a Deputy Director General or any officer of the Institute, and such person to whom the functions are delegated shall perform the functions in the same manner and with the same effect as if the functions had been conferred on him under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV__cl_27__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "A person purporting to act pursuant to a delegation made under this section shall, in the absence of proof to the contrary, be presumed to be acting in accordance with the terms of the delegation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV__cl_27__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "A delegation made under this section may at any time be revoked by the Director General."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV__cl_27__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "A delegation made under this section shall not preclude the Director General himself from carrying out at any time the delegated function. Appointment of officers, servants, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "The Institute may appoint or employ such number of officers and servants as it thinks necessary, and upon such terms as it considers appropriate, for carrying out the functions or exercising the powers of the Institute. Conditions of service, discipline and surcharge"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV__cl_29__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV__cl_29__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV__cl_29__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "The Institute may determine the conditions of service of its officers and servants."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV__cl_29__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "The Statutory Bodies (Discipline and Surcharge) Act 2000 [Act 605] shall apply to officers and servants of the Institute. Loans and advances"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "The Institute may grant loans and make advances to its officers and servants for such purposes and on such terms as the Institute may determine. Payment of retirement benefits, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "The Institute may make arrangements for the payment to its officers and servants, and their dependants such retirement benefits, gratuities and other allowances as the Institute may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_I__cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Malaysian Institute of Road Safety Research Act 2012."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Application"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_I",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall apply to all persons including the Federal Government and the State Governments. Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_I__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_I",
      "schema:name": {
        "@language": "en",
        "@value": "In this Act, unless the context otherwise requires—"
      },
      "schema:text": {
        "@language": "en",
        "@value": "“data” means any recorded information or document connected with or relevant to road safety, regardless of form, that covers primary data, secondary data, raw data or aggregated data, including accident data, reports, road accident sketches, injury data and traffic volume; “document” has the meaning assigned to it in section 3 of the Evidence Act 1950 [Act 56]; “physical entity” means any equipment, device, article, item or thing that is designed, constructed, manufactured, distributed, sold or represented for use on roads or that generally relates to land transportation or that is connected with or relevant to road safety, and includes motor vehicles, road furniture and traffic signs; “property” means all movable or immovable property, including intellectual property and all interests, rights and liabilities, whether equitable or legal, in such property, and includes choses-in-action, investments, money and goodwill; “Institute” means the Malaysian Institute of Road Safety Research or MIROS; “driving institution” means a driving school or driving institute which is issued with a permit under the Motor Vehicles (Driving Schools) Rules 1992 [P.U. (A) 60/1992]; “Director General” means the Director General of the Institute appointed under subsection 25(1); “Fund” means the Malaysian Institute of Road Safety Research Fund as established under section 32; “Board” means the Board of Directors of the Malaysian Institute of Road Safety Research established under section 10; “Minister” means the Minister responsible for transport; “assigned officer” means an officer appointed under section 42; “Chairman” means the Chairman of the Board appointed under subsection 11(2); “sample” means any amount, part or quantity taken from a physical entity to be a representative sample; “Deputy Director General” means the Deputy Director General of the Institute appointed under section 26."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V",
      "@type": "akn:part",
      "eli:number": "V",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_32",
