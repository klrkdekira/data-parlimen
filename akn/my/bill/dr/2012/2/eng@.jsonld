      "schema:text": {
        "@language": "en",
        "@value": "ASSIGNED OFFICERS Appointment of assigned officers"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII",
      "@type": "akn:part",
      "eli:number": "VII",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_46",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_47",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_48",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_49",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_50",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_51",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_52",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_53",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_54",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_55",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_56",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_57",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_58",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_59",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_60"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "SUPPLEMENTAL Property rights to research findings, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_46",
      "@type": "akn:clause",
      "eli:number": "46",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_46__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_46__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_46__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_46__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "The property rights to every research finding or programme undertaken by the Institute that is funded entirely by grants made to the Institute by the Federal Government or any State Government shall vest in the Institute."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_46__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (1), the Institute may reward the officer or person responsible for the research finding or programme in such manner as it deems fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_46__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "The property rights to every research finding or programme undertaken by the Institute that is funded by a private enterprise or organization shall vest in the Institute and such private enterprise or organization jointly, subject to the terms of any agreement between the Institute and the private enterprise or organization. Access to research findings and facilities"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_47",
      "@type": "akn:clause",
      "eli:number": "47",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_47__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_47__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_47__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_47",
      "schema:text": {
        "@language": "en",
        "@value": "The Institute may, subject to such conditions, restrictions and limitations as it may determine, including the imposition of fees, allow any person access to the research findings and facilities of the Institute."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_47__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_47",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this section, “facilities” includes equipment, laboratory and database. Retention of data"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_48",
      "@type": "akn:clause",
      "eli:number": "48",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_48__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_48__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_48__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "Data that is collected from other agencies for purposes of analysis under this Act shall not be retained longer than is necessary for the fulfillment of that purpose."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_48__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "It shall be the duty of the Institute to take all reasonable steps to ensure that the data is destroyed or permanently deleted if it is no longer required for the purpose of which it was collected. Symbol, design or representation of Institute"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_49",
      "@type": "akn:clause",
      "eli:number": "49",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_49__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_49__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_49__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_49__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_49",
      "schema:text": {
        "@language": "en",
        "@value": "The Institute shall have the exclusive right to the use of such symbol, design or representation as the Institute may create, and thereafter display or exhibit it in connection with its activities or affairs."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_49__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_49",
      "schema:text": {
        "@language": "en",
        "@value": "The symbol, design or representation created by the Institute shall be published in the Gazette."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_49__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_49",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who uses a symbol, design or representation of the Institute or any resemblance thereof, or creates any symbol, design or representation which refers to the Institute so as to deceive or cause confusion, or to be likely to deceive or cause confusion, commits an offence and shall, on conviction, be liable to a fine not exceeding fifty thousand ringgit or to imprisonment for a term not exceeding three years or to both. Public servant"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_50",
      "@type": "akn:clause",
      "eli:number": "50",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General, Deputy Director General, any member of the Board, any member of a committee, any officer or servant of the Institute, any assigned officer or any person engaged by the Institute while discharging his duties or performing his functions or exercising his powers under this Act in such capacity, shall be deemed to be a public servant within the meaning of the Penal Code [Act 574]. Public Authorities Protection Act 1948"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_51",
      "@type": "akn:clause",
      "eli:number": "51",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "The Public Authorities Protection Act 1948 [Act 198] shall apply to any action, suit, prosecution or proceedings against the Institute, Director General, Deputy Director General, any member of the Board, any member of a committee, any officer or servant of the Institute, any assigned officer or any person engaged by the Institute in respect of any act, neglect or default done or any omission by it or him in such capacity. Protection of members of Board from personal liability"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_52",
      "@type": "akn:clause",
      "eli:number": "52",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "No member of the Board shall incur any personal liability for any loss or damage caused by any act or omission in the management or conduct of the affairs of the Institute or the Board, unless such loss or damage is occasioned by an intentionally wrongful act or omission on his part. Protection against suits and legal proceedings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_53",
      "@type": "akn:clause",
      "eli:number": "53",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "No action, suit, prosecution or other proceedings shall lie or be brought, instituted or maintained in any court against the Institute, Director General, Deputy Director General, any member of the Board, any member of a committee, any officer or servant of the Institute, any assigned officer or any person engaged by the Institute in respect of any act done or omission by it or him in good faith in such capacity. Representation in civil proceedings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_54",
      "@type": "akn:clause",
      "eli:number": "54",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_54__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_54__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII",
      "schema:name": {
        "@language": "en",
        "@value": "Notwithstanding any other written law—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_54__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_54",
      "schema:text": {
        "@language": "en",
        "@value": "in any civil proceedings by or against the Institute; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_54__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_54",
      "schema:text": {
        "@language": "en",
        "@value": "in any other civil proceedings in which the Institute is required or permitted by the court to be represented, or to be heard, or is otherwise entitled to be represented or to be heard, any person authorized by the Institute for that purpose may, on behalf of the Institute, institute such proceedings or appear in such proceedings and may make all appearances and applications and do all acts in respect of the proceedings on behalf of the Institute. Obligation of secrecy"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_55",
      "@type": "akn:clause",
      "eli:number": "55",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_55__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_55__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_55__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_55__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_55__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_55",
      "schema:text": {
        "@language": "en",
        "@value": "Except for any of the purposes of this Act or for the purposes of any civil or criminal proceedings under any written law or where otherwise authorized by the Minister—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_55__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_55__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Director General, Deputy Director General, any member of the Board, any member of a committee, any officer or servant of the Institute, any assigned officer or any person engaged by the Institute, whether during or after his tenure of office, employment or engagement, shall not disclose any information that comes to his knowledge or is obtained by him in the course of his duties; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_55__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_55__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "no person who has by any means access to any information or documents relating to the affairs of the Institute or the Board shall disclose such information or documents."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_55__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_55",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) commits an offence and shall, on conviction, be liable to a fine not exceeding ten thousand ringgit or to imprisonment for a term not exceeding one year or to both. Service of notices or other documents"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_56",
      "@type": "akn:clause",
      "eli:number": "56",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_56__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_56__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_56__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII",
      "schema:name": {
        "@language": "en",
        "@value": "Service of a notice or any other document upon any person shall be effected—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_56__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_56",
      "schema:text": {
        "@language": "en",
        "@value": "by delivering the notice or other document to the person;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_56__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_56",
      "schema:text": {
        "@language": "en",
        "@value": "by leaving the notice or other document at the last known address of residence or place of business of the person in a cover addressed to that person; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_56__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_56",
      "schema:text": {
        "@language": "en",
        "@value": "by forwarding the notice or other document by post in an A.R. registered letter addressed to the person at his last known address of residence or place of business. Institution of prosecution"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_57",
      "@type": "akn:clause",
      "eli:number": "57",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "No prosecution for an offence under this Act shall be instituted except by or with the written consent of the Public Prosecutor. Adoption of regulations, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_58",
      "@type": "akn:clause",
      "eli:number": "58",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, after consultation with the Board, adopt with such modifications as he deems fit, any regulations, rules, policies, circulars and directives enacted or issued by the Federal Government, for the purpose of carrying out the provisions of this Act. Power to make regulations"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_59",
      "@type": "akn:clause",
      "eli:number": "59",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_59__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_59__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_59__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_59",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, after consultation with the Board, make such regulations as may be expedient or necessary for the purpose of carrying out the provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_59__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_59__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_59__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_59__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_59__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_59__subsec_2__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_59",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to the generality of the powers conferred by subsection (1), the Minister may, after consultation with the Board, make regulations for all or any of the following purposes:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_59__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_59__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe the fees or charges to be imposed in respect of consultancy and advisory services rendered by the Institute;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_59__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_59__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to provide and prescribe for any fees payable in connection with the provision of any service or any matter under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_59__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_59__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe the procedure for the obtaining, dealing with and retention of samples;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_59__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_59__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe any matter for which this Act makes express provision to be made by regulations;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_59__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_59__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe all other matters as are expedient or necessary to be prescribed for giving effect to this Act. Things done in anticipation of the enactment of this Act"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_60",
      "@type": "akn:clause",
      "eli:number": "60",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_60__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_60__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_60__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_60",
      "schema:text": {
        "@language": "en",
        "@value": "All acts and things done by any person or authority on behalf of the Institute in preparation for or in anticipation of the enactment of this Act and any expenditure incurred in relation thereto shall be deemed to have been authorized under this Act, provided that the acts and things done are consistent with the general intentions and purposes of this Act; and all rights and obligations acquired or incurred as a result of the doing of those acts or things including any expenditure incurred in relation thereto shall, upon the coming into operation of this Act, be deemed to be the rights and obligations of the Institute."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_60__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VII__cl_60",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (1), this section shall not be deemed to have authorized the imposition of any punishment on a person for any act or thing done in preparation for or in anticipation of the enactment of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_42",
      "@type": "akn:clause",
      "eli:number": "42",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_42__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_42__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_42__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General may appoint such numbers of officers of the Institute and public officers as he considers necessary to be assigned officers for the purposes of carrying out the powers as set out in this Part."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_42__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_42__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_42__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General shall issue to every assigned officer—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_42__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_42__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "a certificate regarding the appointment of the assigned officer signed by the Director General, where such certificate shall in any legal proceedings be admissible in evidence and shall be prima facie evidence of the facts so certified; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_42__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_42__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "an authority card signed by the Director General. Access and disclosure of data"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_43",
      "@type": "akn:clause",
      "eli:number": "43",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_43__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_43__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_43__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_43__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "The Institute or an assigned officer may request any person to give access to or disclose data that is in his possession, where such data is necessary for carrying out road safety research in pursuance of the Institute’s functions and powers under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_43__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_43__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_43__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to any written law, guidelines or directives, the person may, upon a request being made in pursuance of subsection (1), give access to or disclose data that is in his possession, provided that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_43__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_43__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "any data which is by its nature confidential or which is disclosed on a confidential basis shall be treated consistently in a confidential manner by the Institute or assigned officer and shall be used solely by the Institute; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_43__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_43__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "no subsequent disclosure of data shall be made in a form that could reasonably be expected to identify any person to whom it relates."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_43__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_43__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_43__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "Where a person gives access to or discloses data under subsection (2), the assigned officer may—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_43__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_43__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "examine the books, documents or records containing the data; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_43__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_43__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "make or cause to be made copies, or take or cause to be taken extracts, from any books, documents or records containing the data that is not by its nature confidential, and such copies or extracts certified as such by the assigned officer shall, unless the contrary is proved, be deemed to be true and correct copies or extracts. Examination of physical entity"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_44",
      "@type": "akn:clause",
      "eli:number": "44",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_44__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_44__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_44__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_44__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to any other written law, the assigned officer may examine any physical entity and take photographs of that physical entity."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_44__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of subsection (1), where the physical entity is found on any premises, the assigned officer may, subject to the consent of the owner of the premises or the person occupying the premises, enter the premise at any reasonable time by day."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_44__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "Where necessary, the assigned officer shall among others mark, seal, secure, weigh, count or measure any physical entity examined under subsection (1). Collection of samples, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_45",
      "@type": "akn:clause",
      "eli:number": "45",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_45__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_45__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_45__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_45",
      "schema:text": {
        "@language": "en",
        "@value": "An assigned officer may, without payment, request to obtain or retain samples of a physical entity from any person in possession of such physical entity, which he believes contains information that is connected to or relevant for the purposes of road safety research, and, upon receipt of such sample, examine or analyze all its physical or chemical constituents and anything that he believes is used or capable of being used for the design, construction, manufacture, storage, distribution or sale of that physical entity."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_45__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_45__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_45__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_45",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of sections 43, 44 and 45—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_45__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_45__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "every assigned officer shall declare his office and shall on demand produce to the person against whom he is acting, his authority card; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_45__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_VI__cl_45__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "a person may refuse to comply with a request or directive of an assigned officer if such officer refuses to declare his office and produce his authority card on demand being made by such person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_32__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_32__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_32__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "A fund to be known as the “Malaysian Institute of Road Safety Research Fund” is established and shall be administered and controlled by the Institute."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_32__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_32__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_32__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_32__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_32__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_32__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_32__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_32__subsec_2__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_32__subsec_2__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_32__subsec_2__para_i"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "The Fund shall consist of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_32__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_32__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "such sums as may be provided from time to time by Parliament for the purposes of this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_32__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_32__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "all fees, administration charges, levies or other charges imposed by or payable to the Institute in relation to road safety research;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_32__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_32__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "all monies derived as income from investments by the Institute under section 38;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_32__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_32__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "all monies derived from the sale, disposal, lease or hire of, or any other dealings with, any property, mortgages, charges or debentures vested in or acquired by the Institute;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_32__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_32__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "all monies earned from consultancy and advisory services and any other services provided by the Institute;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_32__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_32__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "all other monies and property which may in any manner become payable to or vested in the Institute in respect of any matter incidental to its functions and powers;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_32__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_32__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "any monies borrowed by the Institute under section 37;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_32__subsec_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_32__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "any monies or grants from any sources, contributions, endowments, gifts or bequests as may be made to or in favour of the Institute; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_32__subsec_2__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_32__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "all other monies and property lawfully received by the Institute, including interest. Expenditure to be charged to Fund"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_33__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_33__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_33__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_33__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_33__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_33__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "The Fund shall be expended for the following purposes:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_33__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "paying for the remuneration, allowances, reimbursement and other expenses of the Director General, Deputy Director Generals, members of the Board, members of committees, officers and servants of the Institute, assigned officers, any persons invited by the Board or committees and any persons engaged by the Institute, including the granting of loans and advances, superannuation allowances, retirement benefits, pensions and gratuities;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_33__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "defraying any expenditure incurred in providing for the welfare of the officers and servants of the Institute, with the approval of the Board;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_33__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "paying any other expenses, fees, costs, expenditure, grants or other payments lawfully incurred or accepted by the Institute in the performance of its functions or the exercise of its powers, including legal fees and costs;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_33__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "purchasing or hiring equipment, machinery and any other materials, acquiring land and other assets, erecting buildings, and carrying out any other works and undertakings in the performance of its functions or the exercise of its powers;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_33__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "repaying monies borrowed under section 37 and the interest due on such monies; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_33__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "generally, paying any expenses for carrying into effect the provisions of this Act. Conservation of Fund"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_34",
      "@type": "akn:clause",
      "eli:number": "34",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "It shall be the duty of the Institute to conserve the Fund by so performing its functions and exercising its powers under this Act as to secure that the total revenues of the Institute are sufficient to meet all sums properly chargeable to its revenue account for every financial year, including depreciation and interest on capital. Expenditure and preparation of estimates"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_35",
      "@type": "akn:clause",
      "eli:number": "35",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_35__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_35__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_35__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_35__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_35__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "The expenditure of the Institute up to such amount as may be authorized by the Minister for any one year shall be defrayed out of the Fund."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_35__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "Before 1 September of each year, the Institute shall submit to the Minister an estimate of its expenditure, including the expenditure for research and development programmes, for the following year in such form and containing such particulars as the Minister may direct."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_35__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister shall, before 31 December of each year, notify the Institute of the amount authorized for expenditure generally or of the amount authorized for each description of expenditure based on the estimate prepared under subsection (2) for the following year."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_35__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "The Institute may, at any time, submit to the Minister, a supplementary estimate of its expenditure for any one year and the Minister may allow the whole or any part of the additional expenditure included in the supplementary estimate. Bank accounts"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_36",
      "@type": "akn:clause",
      "eli:number": "36",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "The Institute shall open and maintain an account or accounts with such financial institution or financial institutions in Malaysia as the Institute thinks fit, and every such account shall be operated upon as far as practicable by cheques signed by any person as may be authorized by the Institute for such purpose from time to time. Power to borrow"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_37",
      "@type": "akn:clause",
      "eli:number": "37",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "The Institute may, from time to time, borrow in such form, at such rate of interest, for such period and upon such terms as to the time and method of repayment, as may be approved by the Minister, with the concurrence of the Minister of Finance, any money required by the Institute for meeting any of its obligations or discharging any of its duties. Investment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "The monies of the Institute shall, in so far as they are not immediately required to be expended by the Institute under this Act, be invested in such manner as the Minister may, with the concurrence of the Minister of Finance, approve. Financial procedure"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to this Act and the approval of the Minister, the Institute shall determine its own financial procedure. Financial year"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "The financial year of the Institute shall begin on 1 January and end on 31 December of each year. Accounts and annual reports"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V__cl_41",
      "@type": "akn:clause",
      "eli:number": "41",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "The Statutory Bodies (Accounts and Annual Reports) Act 1980 [Act 240] shall apply to the Institute."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "(Subsection 11(3)) Meetings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_1",
      "@type": "akn:paragraph",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_1__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_1__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_1__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_1__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_1__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_1",
      "schema:text": {
        "@language": "en",
        "@value": "The Board shall meet for the dispatch of its business at least once in every three months at such time and place as the Chairman may determine from time to time."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_1",
      "schema:text": {
        "@language": "en",
        "@value": "At any meeting of the Board, five members shall form a quorum."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_1__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_1",
      "schema:text": {
        "@language": "en",
        "@value": "The Chairman shall preside over all meetings of the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_1__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_1",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subparagraph (3), if for any reason the Chairman is unable to attend a meeting of the Board, the Deputy Chairman shall exercise the powers of the Chairman during the absence of the Chairman."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_1__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_1",
      "schema:text": {
        "@language": "en",
        "@value": "In the event that both the Chairman and Deputy Chairman are unable to attend a meeting of the Board, the remaining members of the Board shall elect from among themselves a person to preside over the meeting and the person elected shall have all the powers of the Chairman for the purpose of and for the duration of that meeting."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_1__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_1",
      "schema:text": {
        "@language": "en",
        "@value": "If on any question to be determined by the Board, there is an equality of votes, the Chairman shall have a casting vote in addition to his deliberative vote. Procedure"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_2",
      "@type": "akn:paragraph",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to this Act, the Board may regulate its own procedure. Minutes"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_3",
      "@type": "akn:paragraph",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_3__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_3__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_3",
      "schema:text": {
        "@language": "en",
        "@value": "The Board shall cause minutes of all the meetings of the Board to be maintained and kept in a proper form."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_3",
      "schema:text": {
        "@language": "en",
        "@value": "The minutes of meetings of the Board, if duly signed, shall in any legal proceedings be admissible as prima facie evidence of the facts stated in the minutes without further proof."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_3__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_3",
      "schema:text": {
        "@language": "en",
        "@value": "Every meeting of the Board of which minutes have been made in accordance with subparagraphs (1) and (2) shall be deemed to have been duly convened and held and all members at the meeting to have been duly qualified to act. Board may invite others to meetings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_4",
      "@type": "akn:paragraph",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_4__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_4",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may invite any person to attend any meeting or deliberation of the Board for the purpose of advising it on any matter under discussion, but any person so attending shall have no right to vote at the meeting or deliberation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_4",
      "schema:text": {
        "@language": "en",
        "@value": "A person invited under subparagraph (1) shall be paid such allowances as may be determined by the Board. Disclosure of interest"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5",
      "@type": "akn:paragraph",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5",
      "schema:text": {
        "@language": "en",
        "@value": "A member of the Board having, directly or indirectly, by himself, a member of his family or his associate—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "an interest in a company or undertaking with which the Institute proposes to make a contract, or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "an interest in a contract or matter under discussion by the Board, shall disclose to the Board the fact of his interest and its nature."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5",
      "schema:text": {
        "@language": "en",
        "@value": "A disclosure under subparagraph (1) shall be recorded in the minutes of the Board and such member shall take no part in the deliberation or decision of the Board relating to the contract or matter."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5__subsec_3__list_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5__subsec_3__list_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this paragraph— “a member of his family”, in relation to a member of the Board, means—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5__subsec_3__list_1",
      "@type": "akn:list",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5__subsec_3__list_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5__subsec_3__list_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5__subsec_3__list_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5__subsec_3__list_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5__subsec_3__list_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5__subsec_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5__subsec_3__list_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5__subsec_3__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "his spouse;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5__subsec_3__list_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5__subsec_3__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "his parent (including a parent of his spouse);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5__subsec_3__list_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5__subsec_3__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "his child (including an adopted child or stepchild);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5__subsec_3__list_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5__subsec_3__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "his brother or sister (including a brother or sister of his spouse); and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5__subsec_3__list_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5__subsec_3__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "a spouse of his child, brother or sister; and “associate”, in relation to a member of the Board, means—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5__subsec_3__list_2",
      "@type": "akn:list",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5__subsec_3__list_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5__subsec_3__list_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5__subsec_3__list_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5__subsec_3__list_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5__subsec_3__list_2__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5__subsec_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5__subsec_3__list_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5__subsec_3__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "a person who is a nominee or an employee of the member;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5__subsec_3__list_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5__subsec_3__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "a firm of which the member or any nominee of his is a partner;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5__subsec_3__list_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5__subsec_3__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "a partner of the member;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5__subsec_3__list_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5__subsec_3__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "a trustee of a trust under which the member or a member of his family is a beneficiary; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5__subsec_3__list_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/eng@/~sched_1__para_5__subsec_3__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "any corporation within the meaning of the Companies Act 1965 [Act 125], of which the member or any nominee of his or a member of the member’s family is a director or has a substantial shareholding in the corporation."
      }
    }
  ]
}
