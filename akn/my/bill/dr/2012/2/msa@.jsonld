      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_21__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga boleh menubuhkan apa-apa jawatankuasa sebagaimana yang difikirkannya perlu atau suai manfaat untuk membantunya dalam pelaksanaan fungsinya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_21__subsec_10",
      "@type": "akn:subsection",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga boleh membatalkan pelantikan mana-mana anggota jawatankuasa tanpa memberikan apa-apa alasan bagi pembatalan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_21__subsec_11",
      "@type": "akn:subsection",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang anggota jawatankuasa boleh meletakkan jawatan dengan memberikan notis bertulis kepada Lembaga tidak kurang daripada empat belas hari sebelum tarikh peletakan jawatan yang dimaksudkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_21__subsec_12",
      "@type": "akn:subsection",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_21__subsec_12__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_21__subsec_12__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu jawatankuasa hendaklah menyebabkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_21__subsec_12__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_21__subsec_12",
      "schema:text": {
        "@language": "ms",
        "@value": "minit kesemua mesyuaratnya disenggarakan dan disimpan dalam bentuk yang sepatutnya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_21__subsec_12__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_21__subsec_12",
      "schema:text": {
        "@language": "ms",
        "@value": "salinan minit semua mesyuaratnya dikemukakan kepada Lembaga dengan secepat yang dapat dilaksanakan. Elaun"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_21__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga boleh melantik mana-mana orang untuk menjadi anggota sesuatu jawatankuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_21__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu jawatankuasa yang ditubuhkan di bawah seksyen ini boleh memilih mana-mana anggotanya menjadi pengerusi jawatankuasa itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_21__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu jawatankuasa boleh mengawal selia tatacaranya sendiri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_21__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu jawatankuasa hendaklah tertakluk kepada, dan bertindak mengikut apa-apa arahan yang diberikan kepada jawatankuasa itu oleh Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_21__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Mesyuarat sesuatu jawatankuasa hendaklah diadakan pada masa dan tempat yang ditentukan oleh pengerusi jawatankuasa itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_21__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu jawatankuasa boleh mengundang mana-mana orang yang bukan anggota jawatankuasa untuk menghadiri mana-mana mesyuaratnya bagi maksud menasihatinya tentang apa-apa perkara yang sedang dibincangkan, tetapi orang itu tidak berhak untuk mengundi pada mesyuarat itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_21__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Anggota jawatankuasa atau mana-mana orang yang diundang di bawah subseksyen (7) untuk menghadiri mana-mana mesyuarat jawatankuasa boleh dibayar apa-apa elaun dan belanja lain yang ditentukan oleh Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_21__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada subseksyen (10), (11) dan (12), seseorang anggota jawatankuasa hendaklah memegang jawatan atas apa- apa syarat dan bagi suatu tempoh yang dinyatakan dalam surat pelantikannya dan layak untuk dilantik semula."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Maka hendaklah dibayar kepada setiap anggota Lembaga yang bukan pegawai atau pekhidmat Institut apa-apa elaun daripada Kumpulan Wang pada apa-apa kadar yang ditentukan oleh Menteri, selepas berunding dengan Menteri Kewangan. Kuasa Menteri untuk memberikan arahan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_23__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_23__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_23__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga hendaklah bertanggungjawab kepada Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_23__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh memberi Lembaga arahan yang bersifat umum selaras dengan Akta ini yang berhubungan dengan pelaksanaan fungsi Lembaga, dan Lembaga hendaklah melaksanakan arahan itu. Kesahan tindakan dan prosiding"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_24__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_24__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada tindakan yang dilakukan atau prosiding yang diambil di bawah Akta ini boleh dipersoalkan atas alasan bahawa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_24__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "ada apa-apa kekosongan dalam keanggotaan atau apa-apa kecacatan dalam penubuhan Lembaga; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_24__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "ada apa-apa peninggalan, kecacatan atau ketidakteraturan yang tidak menyentuh merit hal itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_4__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_4__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu pertubuhan perbadanan dengan nama “Institut Penyelidikan Keselamatan Jalan Raya Malaysia” atau “MIROS” ditubuhkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Institut adalah kekal turun-temurun dan boleh membawa guaman dan dibawa guaman terhadapnya atas nama perbadanannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_4__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_4__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_4__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada dan bagi maksud Akta ini, Institut boleh atas apa-apa terma yang difikirkannya patut—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_4__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_4__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat kontrak; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_4__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_4__subsec_3__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_4__subsec_3__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_4__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "berkenaan dengan apa-apa jenis harta alih dan tak alih dan kepentingan mengenai harta alih dan tak alih—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_4__subsec_3__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_4__subsec_3__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "memperoleh, membeli dan mengambil harta dan kepentingan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_4__subsec_3__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_4__subsec_3__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "memegang, menikmati, memindahhakkan, menyerahhakkan, menyerahkan balik, memulangkan, menggadaikan, menggadaijanjikan, mendemiskan, menyerahhakkan semula, memindahkan hakmilik atau dengan apa-apa cara lain melupuskan, atau membuat urusan mengenai apa-apa harta dan kepentingan yang terletak hak pada Institut. Meterai perbadanan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_5__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_5__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_5__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_5__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_5__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Institut hendaklah mempunyai suatu meterai perbadanan dan meterai itu bolehlah dari semasa ke semasa diubah dan dibuat baharu sebagaimana yang difikirkan patut oleh Institut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Sehingga suatu meterai diadakan oleh Institut, suatu cap yang mengandungi perkataan “Institut Penyelidikan Keselamatan Jalan Raya Malaysia” bolehlah digunakan dan hendaklah disifatkan sebagai meterai perbadanan Institut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_5__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Meterai perbadanan itu hendaklah disimpan dalam jagaan Ketua Pengarah atau mana-mana orang lain yang diberi kuasa oleh Institut secara bertulis, dan hendaklah ditentusahkan sama ada oleh Ketua Pengarah atau mana-mana orang lain yang diberi kuasa oleh Ketua Pengarah secara bertulis."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_5__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Segala surat ikatan, dokumen dan surat cara lain yang berupa sebagai dimeteraikan dengan meterai perbadanan itu dan ditentusahkan dengan sewajarnya hendaklah, sehingga dibuktikan sebaliknya, disifatkan telah disempurnakan dengan sah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_5__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa surat ikatan, dokumen dan surat cara lain yang, jika disempurnakan oleh seseorang yang bukan suatu pertubuhan perbadanan dan tidak dikehendaki supaya dimeteraikan boleh disempurnakan mengikut cara yang serupa oleh seorang pegawai Institut yang diberi kuasa bagi pihak Institut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_5__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Meterai perbadanan Institut hendaklah diberi pengiktirafan rasmi dan kehakiman. Fungsi Institut"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_6__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_6__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_6__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_6__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_6__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_6__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_6__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_6__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_6__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_6__para_k",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_6__para_l",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_6__para_m"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II",
      "schema:name": {
        "@language": "ms",
        "@value": "Fungsi Institut adalah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menjalankan penyelidikan yang menyeluruh ke atas keselamatan jalan raya, dan memberikan hala tuju umum untuk aktiviti berkenaan dengan penyelidikan keselamatan jalan raya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk membantu dalam pembangunan objektif, dasar dan keutamaan nasional bagi pembangunan dan pentadbiran keselamatan jalan raya yang teratur;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_6__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "menambah baik dan meningkatkan pengetahuan berasaskan kepada perkembangan terkini berkaitan dengan isu berhubung dengan keselamatan jalan raya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_6__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk meningkatkan tahap kesedaran awam terhadap keselamatan jalan raya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_6__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mencadangkan penyelesaian yang praktikal dengan keberkesanan optimum terhadap isu keselamatan jalan raya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_6__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengumpul, menganalisis dan menguruskan data berhubung dengan keselamatan jalan raya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_6__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk membangunkan, mempromosikan penggunaan, menambahkan nilai dan mengkomersialkan dapatan penyelidikan mengenai keselamatan jalan raya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_6__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengumpul, mengumpul semak dan menyebarkan maklumat berhubung dengan dapatan penyelidikan mengenai keselamatan jalan raya dengan cara menerbitkan atau menaja penerbitan terbitan berkala, jurnal, buku dan apa-apa cara lain yang ada, dan untuk menyediakan khidmat perundingan dan nasihat mengenai isu keselamatan jalan raya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_6__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk merancang dan menilai program keselamatan jalan raya, dan untuk menjalankan latihan berhubung dengannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_6__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengkaji semula piawaian dan hasil pembelajaran kurikulum bagi kursus memandu yang disediakan oleh institusi memandu dan mengaudit tanda aras berkenaan dengan sistem penyampaian institusi memandu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_6__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengkaji semula kaedah ujian yang dijalankan oleh organisasi pemeriksaan kenderaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_6__para_l",
      "@type": "akn:paragraph",
      "eli:number": "l",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menjadi anggota, bergabungan dengan atau menjalin hubungan dengan mana-mana organisasi lain, kedua-dua awam dan swasta, tempatan dan asing, yang mempunyai fungsi atau aktiviti yang serupa dengan fungsi dan aktiviti Institut termasuk organisasi yang melibatkan diri dalam penyelidikan saintifik, teknikal, ekonomi dan sosiologi berkaitan keselamatan jalan raya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_6__para_m",
      "@type": "akn:paragraph",
      "eli:number": "m",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk bekerjasama dengan mana-mana orang, persatuan atau organisasi, kedua-dua tempatan dan asing, dengan matlamat untuk meningkatkan prestasi Institut secara efektif. Kuasa Institut"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_7__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Institut hendaklah mempunyai kuasa untuk melakukan semua perkara yang perlu atau suai manfaat bagi atau berkaitan dengan pelaksanaan fungsinya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_7__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_7__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_7__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_7__subsec_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan keluasan subseksyen (1), kuasa Institut hendaklah termasuk kuasa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_7__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_7__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengenakan fi atau caj berhubung dengan apa-apa aktiviti atau perkhidmatan yang diberikan oleh Institut atau penggunaan kemudahan Institut, dan untuk mengutip dan menerima wang yang berkenaan dengannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_7__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_7__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memperoleh hak yang berkaitan dengan apa-apa dapatan penyelidikan mengenai keselamatan jalan raya yang dimiliki oleh mana-mana orang atau organisasi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_7__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_7__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memegang, melupuskan atau memberikan hak berkaitan dengan apa-apa dapatan penyelidikan berkaitan keselamatan jalan raya yang dijalankan oleh atau untuk Institut, atau hak dapatan penyelidikan yang terletak hak pada Institut; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_7__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_7__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk melantik mana-mana orang atau badan untuk menjalankan aktiviti penyelidikan dan pembangunan berhubung dengan keselamatan jalan raya bagi pihak Institut. Kuasa tambahan Institut"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan seksyen 9, Institut boleh, dengan kebenaran Menteri dan persetujuan Menteri Kewangan menubuhkan syarikat di bawah Akta Syarikat 1965 [Akta 125] bagi maksud menjalankan atau terlibat dalam apa-apa aktiviti yang telah dirancang atau dijalankan oleh Institut yang berkaitan dengan pelaksanaan fungsi dan kuasanya. Pengkomersialan dapatan penyelidikan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Institut boleh memasuki apa-apa perkiraan untuk membuat tersedia apa-apa dapatan penyelidikan yang terletak hak pada Institut kepada mana-mana orang atau badan atas apa-apa terma, syarat dan pembayaran apa-apa fi, royalti atau balasan lain, jika ada, sebagaimana yang ditentukan oleh Lembaga, dengan kelulusan Menteri, bagi maksud pengkomersialan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV__cl_25",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV__cl_26",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV__cl_27",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV__cl_28",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV__cl_29",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV__cl_30",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV__cl_31"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "KETUA PENGARAH, TIMBALAN KETUA PENGARAH, PEGAWAI DAN PEKHIDMAT INSTITUT Pelantikan Ketua Pengarah"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV__cl_25__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV__cl_25__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV__cl_25__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV__cl_25__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV__cl_25__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV__cl_25__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV__cl_25__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, di atas syor Lembaga, melantik mana- mana orang yang mempunyai kemahiran atau kepakaran yang sesuai untuk berkhidmat sebagai Ketua Pengarah Institut dan hendaklah meletak hak padanya apa-apa kuasa dan mengenakan ke atasnya apa-apa kewajipan sebagaimana yang ditentukan oleh Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV__cl_25__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah hendaklah bertanggungjawab bagi pentadbiran dan pengurusan keseluruhan fungsi dan hal ehwal harian Institut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV__cl_25__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah hendaklah mempunyai kawalan am ke atas pegawai dan pekhidmat Institut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV__cl_25__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah hendaklah melaksanakan apa-apa kewajipan tambahan sebagaimana yang diarahkan oleh Lembaga dari semasa ke semasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV__cl_25__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam menunaikan kewajipannya, Ketua Pengarah hendaklah bertindak di bawah kuasa dan arahan am Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV__cl_25__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Ketua Pengarah tidak ada buat sementara waktu di Malaysia atau tidak dapat oleh sebab sakit atau kerana apa-apa sebab lain, untuk melaksanakan kewajipannya, Ketua Pengarah hendaklah melantik mana-mana orang untuk menjalankan kewajipan Ketua Pengarah semasa ketiadaan atau ketidakupayaan sementara waktu itu. Pelantikan Timbalan Ketua Pengarah"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh melantik individu yang mempunyai kemahiran atau kepakaran yang sesuai, sebagaimana yang disyorkan oleh Ketua Pengarah, sebagai Timbalan Ketua Pengarah Institut untuk membantu Ketua Pengarah dalam melaksanakan kewajipannya. Kuasa untuk mewakilkan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV__cl_27__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV__cl_27__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV__cl_27__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV__cl_27__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV__cl_27__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah boleh secara bertulis mewakilkan mana- mana fungsinya, tertakluk kepada apa-apa syarat, batasan atau sekatan yang difikirkannya patut, kepada Timbalan Ketua Pengarah atau mana-mana pegawai Institut, dan orang yang kepadanya fungsi itu diwakilkan hendaklah melaksanakan fungsi itu mengikut cara yang sama dan dengan kesan yang sama seolah-olah fungsi itu telah diberikan kepadanya di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV__cl_27__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang berupa sebagai bertindak menurut pewakilan yang dibuat di bawah seksyen ini hendaklah, jika tiada bukti yang berlawanan, dianggap sebagai bertindak mengikut terma pewakilan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV__cl_27__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "Pewakilan yang dibuat di bawah seksyen ini boleh pada bila-bila masa dibatalkan oleh Ketua Pengarah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV__cl_27__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "Pewakilan yang dibuat di bawah seksyen ini tidaklah menghalang Ketua Pengarah daripada menjalankan pada bila-bila masa fungsi yang diwakilkan itu. Pelantikan pegawai, pekhidmat, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Institut boleh melantik atau mengambil kerja apa-apa bilangan pegawai dan pekhidmat yang difikirkannya perlu, dan atas apa- apa terma yang difikirkannya sesuai, untuk menjalankan fungsi dan melaksanakan kuasa Institut. Syarat-syarat perkhidmatan, tatatertib dan surcaj"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV__cl_29__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV__cl_29__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV__cl_29__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "Institut boleh menentukan syarat-syarat perkhidmatan pegawai dan pekhidmatnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV__cl_29__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Badan-Badan Berkanun (Tatatertib dan Surcaj) 2000 [Akta 605] hendaklah terpakai kepada pegawai dan pekhidmat Institut. Pinjaman dan pendahuluan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Institut boleh memberikan pinjaman dan membuat pendahuluan kepada pegawai dan pekhidmatnya bagi apa-apa maksud dan atas apa-apa terma yang ditentukan oleh Institut. Pembayaran faedah persaraan, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Institut boleh membuat perkiraan bagi pembayaran kepada pegawai dan pekhidmatnya, dan tanggungan mereka, apa-apa faedah persaraan, ganjaran dan elaun lain yang ditentukan oleh Institut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_I__cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_I__cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Institut Penyelidikan Keselamatan Jalan Raya Malaysia 2012."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_I__cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta. Pemakaian"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_I",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini hendaklah terpakai bagi semua orang termasuk Kerajaan Persekutuan dan Kerajaan Negeri. Tafsiran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_I__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_I",
      "schema:name": {
        "@language": "ms",
        "@value": "Dalam Akta ini, melainkan jika konteksnya menghendaki makna yang lain—"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "“data” ertinya apa-apa maklumat yang direkod atau dokumen yang berkaitan dengan atau relevan kepada keselamatan jalan raya, tidak kira dalam apa jua bentuk, yang meliputi data utama, data sekunder, data kasar atau data agregat, termasuk data kemalangan, laporan, pelan lakar kemalangan jalan raya, data kecederaan dan jumlah trafik; “dokumen” mempunyai erti seperti yang dinyatakan dalam seksyen 3 Akta Keterangan 1950 [Akta 56]; “entiti fizikal” ertinya apa-apa kelengkapan, alat, artikel, barang atau benda yang direka bentuk, dibina, dibuat, diedar, dijual atau dikatakan untuk kegunaan di jalan raya atau yang secara umumnya berhubung dengan pengangkutan darat atau berkaitan dengan atau relevan kepada keselamatan jalan raya, dan termasuk kenderaan bermotor, perkakas jalan raya dan tanda lalu lintas; “harta” ertinya semua harta alih atau tak alih, termasuk harta intelek dan semua kepentingan, hak dan liabiliti, sama ada di bawah ekuiti atau undang-undang, dalam harta itu, dan termasuk hak dalam tindakan, pelaburan, wang dan nama baik; “Institut” ertinya Institut Penyelidikan Keselamatan Jalan Raya Malaysia atau MIROS; “institusi memandu” ertinya sekolah memandu atau institut memandu yang kepadanya permit dikeluarkan di bawah Kaedah-Kaedah Kenderaan Motor (Sekolah Memandu) 1992 [P.U. (A) 60/1992]; “Ketua Pengarah” ertinya Ketua Pengarah Institut yang dilantik di bawah subseksyen 25(1); “Kumpulan Wang” ertinya Kumpulan Wang Institut Penyelidikan Keselamatan Jalan Raya Malaysia yang ditubuhkan di bawah seksyen 32; “Lembaga” ertinya Lembaga Pengarah Institut Penyelidikan Keselamatan Jalan Raya Malaysia yang ditubuhkan di bawah seksyen 10; “Menteri” ertinya Menteri yang bertanggungjawab bagi pengangkutan; “pegawai yang ditugaskan” ertinya seorang pegawai yang dilantik dibawah seksyen 42; “Pengerusi” ertinya Pengerusi Lembaga yang dilantik di bawah subseksyen 11(2); “sampel” ertinya apa-apa amaun, bahagian atau kuantiti yang diambil daripada entiti fizikal sebagai suatu sampel representatif; “Timbalan Ketua Pengarah” ertinya Timbalan Ketua Pengarah Institut yang dilantik di bawah seksyen 26."
      }
    },
    {
