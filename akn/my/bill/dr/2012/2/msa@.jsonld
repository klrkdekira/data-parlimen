        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_52",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_53",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_54",
