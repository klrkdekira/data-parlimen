      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga hendaklah terdiri daripada anggota yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_11__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_11__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_11__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_11__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_11__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_11__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Polis Negara atau wakilnya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_11__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_11__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah Jabatan Pengangkutan Jalan atau wakilnya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_11__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_11__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah Jabatan Keselamatan Jalan Raya atau wakilnya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_11__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_11__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang wakil daripada Kementerian Pengangkutan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_11__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_11__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang wakil daripada Kementerian Kewangan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_11__subsec_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_11__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak kurang daripada dua dan tidak lebih daripada enam anggota yang, pada pendapat Menteri, mempunyai pengalaman dan menunjukkan keupayaan dan profesionalisme dalam perkara yang berhubung dengan keselamatan jalan raya termasuk pengangkutan, pendidikan, media, kejuruteraan, perubatan, penyelidikan dan sumber manusia, atau selainnya yang sesuai bagi lantikan berdasarkan pengetahuan khusus dan pengalaman dalam perkara yang berhubung dengan keselamatan jalan raya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri hendaklah melantik anggota dalam perenggan (1)(a), (f), (g) dan (h)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_11__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Jadual hendaklah terpakai kepada anggota Lembaga. Wakil organisasi yang dinamakan semula"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_12__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_12__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seseorang anggota Lembaga ialah wakil sesuatu kementerian, jabatan atau organisasi dan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_12__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "kementerian, jabatan atau organisasi itu telah dinamakan semula; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_12__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "fungsi kementerian, jabatan atau organisasi itu diambil alih oleh kementerian, jabatan atau organisasi lain, anggota itu hendaklah dinamakan semula sebagai wakil kepada kementerian, jabatan atau organisasi sebagaimana yang dinamakan semula atau kepada kementerian, jabatan atau organisasi yang mengambil alih fungsi tersebut. Timbalan Pengerusi dan Setiausaha"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_13__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri hendaklah melantik Timbalan Pengerusi Lembaga dari kalangan anggota Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga hendaklah melantik seorang pegawai Institut sebagai Setiausaha Lembaga. Fungsi Lembaga"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_14__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_14__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_14__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_14__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_14__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III",
      "schema:name": {
        "@language": "ms",
        "@value": "Fungsi Lembaga adalah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_14__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengkaji semula dasar dan hala tuju strategik Institut;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_14__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menasihati Menteri dalam perkara yang berhubung dengan Akta ini dan perkembangan berkaitan penyelidikan keselamatan jalan raya dengan rujukan khusus kepada implikasi perkembangan sedemikian bagi Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_14__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk membuat pengesyoran kepada Menteri berkenaan dengan kaedah, langkah dan dasar untuk diterima pakai bagi memudahkan pembangunan penyelidikan keselamatan jalan raya, dan jika diluluskan oleh Menteri, untuk melaksanakan dan membantu di dalam pelaksanaannya melalui Institut;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_14__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk membuat apa-apa perkara yang perlu atau berfaedah dan sesuai bagi pentadbiran, pengawalan dan pengurusan Institut; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_14__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk membuat apa-apa perkara lain yang timbul atau berbangkit daripada fungsi Lembaga di bawah Akta ini yang tidak bercanggah dengan maksud Akta ini, sama ada diarahkan oleh Menteri atau tidak. Kuasa Lembaga"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga hendaklah menjadi badan eksekutif Institut dan boleh menjalankan semua kuasa yang diberi kepada Institut oleh Akta ini. Tempoh jawatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_16__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_16__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_16__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada apa-apa syarat yang dinyatakan dalam surat cara pelantikan, anggota Lembaga yang dilantik di bawah perenggan 11(1)(a), (f), (g) atau (h) hendaklah, melainkan dia meletak jawatan atau mengosongkan jawatannya atau pelantikannya ditamatkan, memegang jawatan bagi suatu tempoh yang tidak melebihi tiga tahun."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Anggota Lembaga yang dilantik di bawah perenggan 11(1)(a), (f), (g) atau (h) adalah layak untuk dilantik semula. Pembatalan pelantikan dan peletakan jawatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_17__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh pada bila-bila masa membatalkan pelantikan mana-mana anggota Lembaga yang dilantik di bawah perenggan 11(1)(a), (f), (g) atau (h) tanpa memberikan apa-apa alasan bagi pembatalan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Anggota Lembaga yang dilantik di bawah perenggan 11(1)(a), (f), (g) atau (h) boleh meletak jawatan dengan memberikan notis bertulis yang dialamatkan kepada Menteri tidak kurang daripada empat belas hari sebelum tarikh peletakan jawatan yang dimaksudkan. Pengosongan jawatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_18__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_18__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_18__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_18__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_18__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_18__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_18__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatan anggota Lembaga yang dilantik di bawah perenggan 11(1)(a), (f), (g) atau (h) hendaklah menjadi kosong—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_18__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia mati;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_18__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_18__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_18__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_18__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "jika telah dibuktikan terhadapnya, atau dia telah disabitkan atas, suatu pertuduhan berkenaan dengan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_18__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_18__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu kesalahan yang melibatkan fraud, kecurangan atau keburukan akhlak;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_18__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_18__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu kesalahan di bawah mana-mana undang- undang yang berhubung dengan rasuah; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_18__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_18__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa kesalahan lain yang boleh dihukum dengan pemenjaraan (sama ada pemenjaraan sahaja atau sebagai tambahan kepada atau sebagai ganti denda) selama tempoh yang melebihi dua tahun;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_18__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "sekiranya kelakuannya, sama ada yang berkaitan dengan tugasnya sebagai anggota Lembaga atau tidak, adalah sedemikian cara sehingga mencemarkan nama Lembaga;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_18__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia menjadi bankrap;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_18__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia tidak sempurna akal atau selainnya tidak berupaya menunaikan kewajipannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_18__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal Pengerusi, jika dia tidak menghadiri mesyuarat Lembaga tiga kali berturut-turut tanpa kebenaran secara bertulis daripada Menteri; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_18__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal anggota Lembaga yang dilantik di bawah perenggan 11(1)(f), (g) atau (h), jika dia tidak menghadiri mesyuarat Lembaga tiga kali berturut-turut tanpa kebenaran secara bertulis daripada Pengerusi. Penjalanan sementara fungsi Pengerusi"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_19__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_19__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_19__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh melantik secara sementara mana-mana anggota Lembaga untuk bertindak sebagai Pengerusi bagi tempoh apabila—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_19__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "jawatan Pengerusi kosong;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_19__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi tidak hadir bertugas atau tidak ada di Malaysia; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_19__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi, kerana apa-apa sebab lain, tidak dapat menjalankan kewajipan jawatannya. Pewakilan fungsi"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_20__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_20__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_20__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_20__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_20__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_20__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_20__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga boleh, tertakluk kepada apa-apa syarat, batasan atau sekatan yang difikirkan patut dikenakan, mewakilkan mana-mana fungsinya, kecuali fungsinya di bawah seksyen 59, kepada—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_20__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_20__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang anggota Lembaga; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_20__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_20__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu jawatankuasa yang ditubuhkan di bawah seksyen 21."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_20__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang atau jawatankuasa yang diwakilkan dengan fungsi sedemikian hendaklah terikat untuk mematuhi dan mengambil kira akan segala syarat dan sekatan yang dikenakan oleh Lembaga dan segala kehendak, tatacara dan perkara yang ditentukan oleh Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_20__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana fungsi yang diwakilkan di bawah seksyen ini hendaklah dilaksanakan dan dijalankan atas nama dan bagi pihak Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_20__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Pewakilan di bawah seksyen ini tidak menghalang Lembaga sendiri daripada melaksanakan atau menjalankan pada bila-bila masa mana-mana fungsi yang telah diwakilkan itu. Jawatankuasa"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_21__subsec_1",
