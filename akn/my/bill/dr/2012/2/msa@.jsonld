        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_48",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_49",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_50",
