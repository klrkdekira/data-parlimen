      "schema:text": {
        "@language": "ms",
        "@value": "KEWANGAN Penubuhan Kumpulan Wang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI",
      "@type": "akn:part",
      "eli:number": "VI",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_42",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_43",
