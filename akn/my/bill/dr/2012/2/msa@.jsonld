        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_56",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_57",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_58",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_59",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_60"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "TAMBAHAN Hak pemilikan bagi dapatan penyelidikan, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_46",
      "@type": "akn:clause",
      "eli:number": "46",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_46__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_46__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_46__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_46__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Hak pemilikan bagi setiap dapatan penyelidikan atau program yang dijalankan oleh Institut dan dibiayai sepenuhnya oleh pemberian yang diberikan kepada Institut oleh Kerajaan Persekutuan atau Kerajaan Negeri hendaklah terletak hak pada Institut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_46__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun dalam subseksyen (1), Institut boleh memberi ganjaran kepada pegawai atau orang yang bertanggungjawab bagi dapatan penyelidikan atau program itu dengan cara yang difikirkan sesuai."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_46__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Hak pemilikan bagi setiap dapatan penyelidikan atau program yang dijalankan oleh Institut yang dibiayai oleh badan perusahaan atau organisasi persendirian hendaklah terletak hak bersama pada Institut dan badan perusahaan atau organisasi persendirian tersebut, tertakluk kepada terma dalam apa-apa perjanjian antara Institut dengan badan perusahaan atau organisasi persendirian tersebut. Akses kepada dapatan penyelidikan dan kemudahan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_47",
      "@type": "akn:clause",
      "eli:number": "47",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_47__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_47__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_47__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Institut boleh, tertakluk kepada apa-apa syarat, batasan dan sekatan yang ditentukan, termasuk pengenaan fi, membenarkan mana-mana orang mendapat akses kepada dapatan penyelidikan dan kemudahan Institut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_47__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini, “kemudahan” termasuk peralatan, makmal dan pengkalan data. Penyimpanan data"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_48",
      "@type": "akn:clause",
      "eli:number": "48",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_48__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_48__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_48__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_48",
      "schema:text": {
        "@language": "ms",
        "@value": "Data yang diambil daripada agensi lain untuk maksud analisis di bawah Akta ini tidak boleh disimpan melebihi tempoh yang diperlukan bagi memenuhi maksud berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_48__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_48",
      "schema:text": {
        "@language": "ms",
        "@value": "Institut berkewajipan untuk mengambil semua langkah yang munasabah untuk memastikan bahawa data berkenaan telah dimusnahkan atau dipadam secara kekal jika ia tidak lagi diperlukan bagi maksud ianya diambil. Simbol, reka bentuk dan representasi Institut"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_49",
      "@type": "akn:clause",
      "eli:number": "49",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_49__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_49__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_49__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_49__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_49",
      "schema:text": {
        "@language": "ms",
        "@value": "Institut mempunyai hak eksklusif untuk menggunakan simbol, rekabentuk atau representasi yang direka oleh Institut dan kemudiannya boleh memperaga atau mempamerkannya dalam aktiviti atau hal ehwal yang berkaitan dengannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_49__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_49",
      "schema:text": {
        "@language": "ms",
        "@value": "Simbol, rekabentuk atau representasi yang direka oleh Institut hendaklah disiarkan dalam Warta."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_49__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_49",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang menggunakan simbol, rekabentuk atau representasi Institut atau yang mempunyai persamaan dengannya, atau mereka sebarang simbol, rekabentuk atau representasi yang merujuk kepada Institut untuk memperdaya atau menyebabkan kekeliruan, atau boleh memperdaya atau menyebabkan kekeliruan, melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tiga tahun atau kedua-duanya. Pekhidmat awam"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_50",
      "@type": "akn:clause",
      "eli:number": "50",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah, Timbalan Ketua Pengarah, mana-mana anggota Lembaga, mana-mana anggota jawatankuasa, mana-mana pegawai atau pekhidmat Institut, mana-mana pegawai yang ditugaskan atau mana-mana orang yang diupah oleh Institut semasa menunaikan kewajipannya atau melaksanakan fungsinya atau menjalankan kuasanya di bawah Akta ini atas kapasitinya yang sedemikian, hendaklah disifatkan sebagai pekhidmat awam mengikut pengertian Kanun Keseksaan [Akta 574]. Akta Perlindungan Pihak Berkuasa Awam 1948"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_51",
      "@type": "akn:clause",
      "eli:number": "51",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Perlindungan Pihak Berkuasa Awam 1948 [Akta 198] hendaklah terpakai bagi apa-apa tindakan, guaman, pendakwaan atau prosiding terhadap Institut, Ketua Pengarah, Timbalan Ketua Pengarah, mana-mana anggota Lembaga, atau anggota jawatankuasa, mana-mana pegawai atau pekhidmat Institut, pegawai yang ditugaskan atau mana-mana orang yang diupah oleh Institut berkenaan dengan apa-apa perbuatan, pengabaian atau keingkaran yang dilakukan atau apa-apa peninggalan olehnya atas sifat sedemikian. Perlindungan anggota Lembaga daripada liabiliti diri"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_52",
      "@type": "akn:clause",
      "eli:number": "52",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun anggota Lembaga hendaklah menanggung apa-apa liabiliti diri bagi apa-apa kerugian atau kerosakan yang disebabkan oleh apa-apa perbuatan atau peninggalan dalam pengurusan atau pengendalian hal ehwal Institut atau Lembaga, melainkan jika kerugian atau kerosakan itu disebabkan oleh sesuatu perbuatan salah atau peninggalan yang disengajakan oleh dirinya. Perlindungan daripada tindakan guaman dan prosiding undang-undang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_53",
      "@type": "akn:clause",
      "eli:number": "53",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada tindakan, guaman, pendakwaan atau prosiding lain boleh diambil atau dibawa, dimulakan atau dibuat dalam mana-mana mahkamah terhadap Institut, Ketua Pengarah, Timbalan Ketua Pengarah, mana-mana anggota Lembaga, mana-mana anggota jawatankuasa, mana-mana pegawai atau pekhidmat Institut, mana- mana pegawai yang ditugaskan atau mana-mana orang yang diupah oleh Institut berkenaan dengan apa-apa perbuatan yang dibuatnya atau peninggalan olehnya dengan suci hati, atas sifat sedemikian. Pewakilan dalam prosiding sivil"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_54",
      "@type": "akn:clause",
      "eli:number": "54",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_54__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_54__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII",
      "schema:name": {
        "@language": "ms",
        "@value": "Walau apa pun dalam mana-mana undang-undang bertulis yang lain—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_54__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_54",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam mana-mana prosiding sivil oleh atau terhadap Institut; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_54__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_54",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam mana-mana prosiding sivil yang lain yang dalamnya Institut dikehendaki atau dibenarkan oleh mahkamah untuk diwakili, atau didengar, atau selainnya berhak untuk diwakili atau didengar, mana-mana orang yang diberi kuasa oleh Institut bagi maksud itu boleh, bagi pihak Institut, memulakan prosiding sedemikian atau hadir dalam prosiding itu dan boleh membuat semua kehadiran dan permohonan dan melakukan semua perbuatan yang berkenaan dengan prosiding itu bagi pihak Institut. Obligasi kerahsiaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_55",
      "@type": "akn:clause",
      "eli:number": "55",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_55__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_55__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_55__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_55__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_55__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_55",
      "schema:text": {
        "@language": "ms",
        "@value": "Kecuali bagi apa-apa maksud Akta ini atau bagi maksud apa-apa prosiding sivil atau jenayah di bawah mana-mana undang- undang bertulis atau jika selainnya dibenarkan oleh Menteri—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_55__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_55__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah, Timbalan Ketua Pengarah, mana-mana anggota Lembaga, mana-mana anggota jawatankuasa, mana-mana pegawai atau pekhidmat Institut, mana- mana pegawai yang ditugaskan atau mana-mana orang yang diupah oleh Institut, sama ada dalam atau selepas tempoh jawatan, pekerjaan atau upahannya, hendaklah tidak menzahirkan apa-apa maklumat yang diketahuinya atau didapatinya dalam penjalanan tugas; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_55__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_55__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tiada seorang pun yang, melalui apa-apa cara, mempunyai akses kepada apa-apa maklumat atau dokumen yang berhubungan dengan hal ehwal Institut atau Lembaga Pengarah boleh menzahirkan maklumat atau dokumen itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_55__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_55",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi sepuluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi satu tahun atau kedua-duanya. Penyampaian notis atau dokumen lain"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_56",
      "@type": "akn:clause",
      "eli:number": "56",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_56__subsec_1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_56__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_56__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_56__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_56__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_56",
      "schema:text": {
        "@language": "ms",
        "@value": "Penyampaian notis atau dokumen lain kepada mana-mana orang hendaklah dilakukan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_56__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_56__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menyampaikan notis atau dokumen lain kepada orang itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_56__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_56__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan meninggalkan notis atau dokumen lain di alamat kediaman atau tempat perniagaan orang itu yang terakhir diketahui dalam sampul yang beralamat kepada orang itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_56__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_56__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menghantar notis atau dokumen lain melalui pos berdaftar A.T. yang dialamatkan kepada orang itu di alamat kediaman atau tempat perniagaannya yang terakhir diketahui. Permulaan pendakwaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_57",
      "@type": "akn:clause",
      "eli:number": "57",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada pendakwaan bagi sesuatu kesalahan di bawah Akta ini boleh dimulakan kecuali oleh atau dengan keizinan bertulis Pendakwa Raya. Pemakaian peraturan-peraturan, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_58",
      "@type": "akn:clause",
      "eli:number": "58",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, selepas berunding dengan Lembaga, menerima pakai dengan ubahsuaian sebagaimana yang dianggap sesuai, mana-mana peraturan, kaedah, dasar, pekeliling dan arahan yang diperbuat atau dikeluarkan oleh Kerajaan Persekutuan, bagi maksud melaksanakan peruntukan Akta ini. Kuasa untuk membuat peraturan-peraturan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_59",
      "@type": "akn:clause",
      "eli:number": "59",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_59__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_59__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_59__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_59",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, selepas berunding dengan Lembaga, membuat peraturan-peraturan yang suai manfaat atau perlu bagi maksud melaksanakan peruntukan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_59__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_59__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_59__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_59__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_59__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_59__subsec_2__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_59",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan kuasa am yang diberikan oleh subseksyen (1), Menteri boleh, selepas berunding dengan Lembaga, membuat peraturan-peraturan untuk semua atau mana-mana maksud di bawah:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_59__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_59__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan fi atau caj yang akan dikenakan berhubung dengan khidmat perundingan dan nasihat yang diberikan oleh Institut;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_59__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_59__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memperuntukkan dan menetapkan apa-apa fi yang kena dibayar berhubung dengan pemberian apa-apa perkhidmatan atau apa-apa perkara di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_59__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_59__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan prosedur untuk mendapatkan, berurusan dengan dan penyimpanan sampel;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_59__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_59__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan apa-apa perkara yang mana Akta ini membuat peruntukan nyata supaya dibuat melalui peraturan-peraturan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_59__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_59__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan semua perkara lain yang suai manfaat atau perlu untuk ditetapkan bagi memberikan kuat kuasa kepada Akta ini. Perkara yang dilakukan pada menjangkakan Akta ini diperbuat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_60",
      "@type": "akn:clause",
      "eli:number": "60",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_60__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_60__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_60__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_60",
      "schema:text": {
        "@language": "ms",
        "@value": "Segala perbuatan dan perkara yang dilakukan oleh mana-mana orang atau pihak berkuasa bagi pihak Institut sebagai persediaan bagi atau pada menjangkakan Akta ini diperbuat dan apa-apa perbelanjaan yang dilakukan berhubungan dengannya hendaklah disifatkan sebagai telah dibenarkan di bawah Akta ini, dengan syarat bahawa perbuatan dan perkara yang dilakukan itu adalah selaras dengan niat dan maksud am Akta ini; dan segala hak dan obligasi yang diperoleh atau ditanggung akibat pelakuan perbuatan atau perkara itu termasuk apa-apa perbelanjaan yang ditanggung berhubungan dengannya, hendaklah apabila Akta ini mula berkuat kuasa disifatkan sebagai hak dan obligasi Institut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_60__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII__cl_60",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun dalam subseksyen (1), seksyen ini tidak boleh disifatkan sebagai telah memberi kuasa untuk pengenaan apa-apa hukuman ke atas seseorang bagi apa-apa perbuatan atau perkara yang dilakukan sebagai persediaan bagi atau pada menjangkakan Akta ini diperbuat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_42",
      "@type": "akn:clause",
      "eli:number": "42",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_42__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_42__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_42__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_42",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah boleh melantik apa-apa bilangan pegawai Institut dan pegawai awam yang difikirkan perlu untuk menjadi pegawai yang ditugaskan bagi maksud menjalankan kuasa yang dinyatakan di dalam Bahagian ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_42__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_42__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_42__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_42",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah hendaklah mengeluarkan kepada setiap pegawai yang ditugaskan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_42__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_42__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu sijil berkenaan pelantikan pegawai yang ditugaskan yang ditandatangani oleh Ketua Pengarah, di mana sijil tersebut hendaklah dalam apa-apa prosiding undang- undang diterima sebagai keterangan dan hendaklah menjadi keterangan prima facie berkenaan fakta yang diperakukan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_42__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_42__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu kad kuasa yang ditandatangani oleh Ketua Pengarah. Akses dan pendedahan data"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_43",
      "@type": "akn:clause",
      "eli:number": "43",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_43__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_43__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_43__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_43__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Institut atau seorang pegawai yang ditugaskan boleh meminta mana-mana orang untuk memberi akses kepada atau mendedahkan data di dalam milikannya, di mana data tersebut diperlukan untuk menjalankan penyelidikan keselamatan jalan raya menurut fungsi dan kuasa Institut di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_43__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_43__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_43__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada mana-mana undang-undang bertulis, garis panduan atau arahan, orang itu boleh, apabila permintaan dibuat menurut subseksyen (1), memberikan akses atau mendedahkan data di dalam milikannya, dengan syarat—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_43__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_43__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa data yang bersifat sulit atau yang didedahkan atas dasar kerahsiaan hendaklah dianggap secara berterusan sebagai sulit oleh Institut atau pegawai yang ditugaskan dan hendaklah digunakan hanya oleh Institut; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_43__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_43__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "tiada pendedahan data seterusnya boleh dibuat dalam bentuk yang dijangka dengan munasabahnya boleh mengenalpasti mana-mana orang yang ada kaitan dengannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_43__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_43__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_43__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seseorang memberikan akses kepada atau mendedahkan data di bawah subseksyen (2), pegawai yang ditugaskan bolehlah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_43__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_43__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "memeriksa buku, dokumen atau rekod yang mengandungi data tersebut; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_43__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_43__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat atau menyebabkan dibuat salinan, atau mengambil atau menyebabkan diambil cabutan, dari mana-mana buku, dokumen atau rekod yang mengandungi data yang bukan bersifat sulit, dan salinan atau cabutan tersebut sebagaimana diperakukan oleh pegawai yang ditugaskan hendaklah, melainkan dibuktikan sebaliknya, dianggap sebagai salinan dan cabutan yang benar dan betul. Pemeriksaan entiti fizikal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_44",
      "@type": "akn:clause",
      "eli:number": "44",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_44__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_44__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_44__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_44__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_44",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada mana-mana undang-undang bertulis, pegawai yang ditugaskan boleh memeriksa mana-mana entiti fizikal dan mengambil gambar entiti fizikal tersebut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_44__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_44",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud subseksyen (1), jika entiti fizikal tersebut ditemui di mana-mana premis, pegawai yang ditugaskan boleh, tertakluk kepada kebenaran pemunya premis tersebut atau orang yang menghuni premis tersebut, memasuki premis tersebut pada masa yang munasabah pada waktu siang."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_44__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_44",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika perlu, pegawai yang ditugaskan hendaklah antara lainnya menanda, memeterai, memastikan keselamatan, menimbang, mengira atau mengukur mana-mana entiti fizikal yang diperiksa di bawah subseksyen (1). Pengumpulan sampel, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_45",
      "@type": "akn:clause",
      "eli:number": "45",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_45__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_45__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_45__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_45",
      "schema:text": {
        "@language": "ms",
        "@value": "Seorang pegawai yang ditugaskan boleh, tanpa sebarang bayaran, memohon untuk mendapatkan atau menyimpan sampel entiti fizikal dari mana-mana orang yang mempunyai milikan ke atas entiti fizikal tersebut, yang dia percaya mengandungi maklumat berkaitan dengan atau relevan bagi maksud penyelidikan keselamatan jalan raya, dan, setelah menerima sampel itu, memeriksa atau menganalisis semua kandungan fizikal atau kimianya dan apa-apa benda yang dia percaya digunakan atau boleh digunakan untuk pereka bentukan, pembinaan, pembuatan, penyimpanan, pengedaran atau penjualan entiti fizikal tersebut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_45__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_45__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_45__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_45",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen 43, 44 dan 45—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_45__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_45__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "setiap pegawai yang ditugaskan hendaklah mengisytiharkan jawatannya dan jika diminta menunjukkan kepada orang yang diambil tindakan olehnya, kad kuasanya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_45__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VI__cl_45__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang boleh menolak permintaan atau arahan pegawai yang ditugaskan jika pegawai tersebut enggan mengisytiharkan jawatannya dan menunjukkan kad kuasanya apabila diminta berbuat demikian oleh orang itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_32__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_32__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_32__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_32",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu kumpulan wang yang dikenali sebagai “Kumpulan Wang Institut Penyelidikan Keselamatan Jalan Raya Malaysia” ditubuhkan dan hendaklah ditadbirkan dan dikawal oleh Institut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_32__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_32__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_32__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_32__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_32__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_32__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_32__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_32__subsec_2__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_32__subsec_2__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_32__subsec_2__para_i"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_32",
      "schema:text": {
        "@language": "ms",
        "@value": "Kumpulan Wang hendaklah terdiri daripada—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_32__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_32__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa jumlah yang diperuntukkan dari semasa ke semasa oleh Parlimen bagi maksud Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_32__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_32__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "semua fi, caj pentadbiran, levi atau caj lain yang dikenakan oleh atau yang kena dibayar kepada Institut berhubung dengan penyelidikan keselamatan jalan raya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_32__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_32__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "semua wang yang diperoleh sebagai pendapatan daripada pelaburan oleh Institut di bawah seksyen 38;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_32__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_32__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "semua wang yang diperoleh daripada penjualan, pelupusan, pemajakan atau penyewaan atau apa-apa urus niaga lain mengenai apa-apa harta, gadai janji, gadaian atau debentur yang terletak hak pada atau yang diperoleh oleh Institut;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_32__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_32__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "semua wang yang diperoleh daripada perkhidmatan perundingan dan nasihat dan apa-apa perkhidmatan lain yang diberi oleh Institut;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_32__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_32__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "semua wang dan harta lain yang boleh dalam apa-apa cara menjadi kena dibayar kepada atau terletak hak pada Institut berkenaan dengan apa-apa perkara yang bersampingan dengan fungsi dan kuasanya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_32__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_32__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa wang yang dipinjam oleh Institut di bawah seksyen 37;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_32__subsec_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_32__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa wang atau pemberian daripada mana-mana sumber, sumbangan, biaya, hadiah atau bekues yang boleh dibuat kepada atau bagi faedah Institut; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_32__subsec_2__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_32__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "semua wang dan harta lain yang diterima dengan sah oleh Institut, termasuk bunga. Perbelanjaan yang hendaklah dipertanggungkan pada Kumpulan Wang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_33__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_33__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_33__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_33__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_33__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_33__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Kumpulan Wang hendaklah dibelanjakan bagi maksud yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_33__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_33",
      "schema:text": {
        "@language": "ms",
        "@value": "membayar saraan, elaun, bayaran balik dan perbelanjaan lain Ketua Pengarah, Timbalan Ketua Pengarah, anggota Lembaga, anggota jawatankuasa, pegawai dan pekhidmat Institut, pegawai yang ditugaskan, mana-mana orang yang diundang oleh Lembaga atau jawatankuasa dan mana-mana orang yang diupah oleh Institut, termasuk memberikan pinjaman dan wang pendahuluan, elaun persaraan, faedah persaraan, pencen dan ganjaran;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_33__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_33",
      "schema:text": {
        "@language": "ms",
        "@value": "menjelaskan apa-apa belanja yang ditanggung dalam memperuntukkan bagi kebajikan pegawai dan pekhidmat Institut, dengan kelulusan Lembaga;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_33__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_33",
      "schema:text": {
        "@language": "ms",
        "@value": "membayar apa-apa belanja, fi, kos, perbelanjaan, pemberian atau pembayaran lain yang ditanggung atau diterima dengan sah oleh Institut dalam melaksanakan fungsinya atau menjalankan kuasanya, termasuk fi dan kos guaman;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_33__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_33",
      "schema:text": {
        "@language": "ms",
        "@value": "membeli atau menyewa kelengkapan, mesin dan apa-apa bahan lain, memperoleh tanah dan aset lain, membina bangunan, dan menjalankan apa-apa kerja dan perusahaan lain dalam pelaksanaan fungsinya atau penjalanan kuasanya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_33__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_33",
      "schema:text": {
        "@language": "ms",
        "@value": "membayar balik apa-apa wang yang dipinjam di bawah seksyen 37 dan bunga yang kena dibayar atas wang itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_33__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_33",
      "schema:text": {
        "@language": "ms",
        "@value": "secara amnya, membayar apa-apa belanja bagi melaksanakan peruntukan Akta ini. Pemeliharaan Kumpulan Wang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_34",
      "@type": "akn:clause",
      "eli:number": "34",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Institut berkewajipan memelihara Kumpulan Wang dengan melaksanakan fungsinya dan menjalankan kuasanya di bawah Akta ini dengan sedemikian cara supaya dapat dipastikan bahawa jumlah hasil Institut mencukupi untuk membayar semua jumlah wang yang boleh dipertanggungkan dengan sepatutnya kepada akaun hasilnya untuk setiap tahun kewangan, termasuk susut nilai dan bunga atas modal. Perbelanjaan dan penyediaan anggaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_35",
      "@type": "akn:clause",
      "eli:number": "35",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_35__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_35__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_35__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_35__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_35__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbelanjaan Institut setakat amaun yang dibenarkan oleh Menteri bagi mana-mana satu tahun hendaklah dibayar daripada Kumpulan Wang."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_35__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "Sebelum 1 September setiap tahun, Institut hendaklah mengemukakan kepada Menteri suatu anggaran perbelanjaan, termasuk perbelanjaan bagi program penyelidikan dan pembangunan, bagi tahun yang berikutnya dalam apa-apa bentuk dan yang mengandungi apa-apa butir sebagaimana yang diarahkan oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_35__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri hendaklah, sebelum 31 Disember setiap tahun, memberitahu Institut mengenai amaun yang dibenarkan bagi perbelanjaan secara amnya atau mengenai amaun yang dibenarkan bagi setiap perihalan perbelanjaan berdasarkan anggaran yang disediakan di bawah subseksyen (2) untuk tahun berikutnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_35__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "Institut boleh, pada bila-bila masa, mengemukakan kepada Menteri, suatu anggaran tambahan perbelanjaannya bagi mana- mana satu tahun dan Menteri boleh membenarkan keseluruhan atau mana-mana bahagian perbelanjaan tambahan yang termasuk dalam anggaran tambahan itu. Akaun bank"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_36",
      "@type": "akn:clause",
      "eli:number": "36",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Institut hendaklah membuka dan menyenggara akaun atau akaun-akaun dengan mana-mana institusi kewangan atau institusi- institusi kewangan dalam Malaysia sebagaimana yang difikirkan patut oleh Institut, dan setiap akaun itu hendaklah dikendalikan setakat yang boleh dilaksanakan melalui cek yang ditandatangani oleh mana-mana orang yang diberi kuasa oleh Institut bagi maksud itu dari semasa ke semasa. Kuasa untuk meminjam"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_37",
      "@type": "akn:clause",
      "eli:number": "37",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Institut boleh, dari semasa ke semasa, meminjam dalam apa- apa bentuk, pada apa-apa kadar bunga, bagi apa-apa tempoh dan atas apa-apa terma mengenai masa dan cara pembayaran balik, sebagaimana yang diluluskan oleh Menteri, dengan persetujuan Menteri Kewangan, apa-apa jumlah yang diperlukan oleh Institut bagi memenuhi mana-mana obligasinya atau menunaikan mana- mana kewajipannya. Pelaburan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Wang Institusi hendaklah, setakat yang tidak dikehendaki untuk dibelanjakan dengan segera oleh Institut di bawah Akta ini, dilaburkan mengikut apa-apa cara yang diluluskan oleh Menteri dengan persetujuan Menteri Kewangan. Tatacara kewangan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada Akta ini dan kelulusan Menteri, Institut hendaklah menentukan tatacara kewangannya sendiri. Tahun kewangan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Tahun kewangan Institut hendaklah bermula pada 1 Januari dan berakhir pada 31 Disember setiap tahun. Akaun dan laporan tahunan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V__cl_41",
      "@type": "akn:clause",
      "eli:number": "41",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Badan Berkanun (Akaun dan Laporan Tahunan) 1980 [Akta 240] hendaklah terpakai bagi Institut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "(Subseksyen 11(3)) Mesyuarat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_1",
      "@type": "akn:paragraph",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_1__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_1__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_1__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_1__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_1__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga hendaklah bermesyuarat bagi melaksanakan urusannya sekurang-kurangnya sekali setiap tiga bulan pada masa dan tempat sebagaimana ditentukan oleh Pengerusi dari semasa ke semasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi mana-mana mesyuarat Lembaga, lima orang anggota hendaklah membentuk kuorum."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_1__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi hendaklah mempengerusikan semua mesyuarat Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_1__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun dalam subperenggan (3), jika Pengerusi atas apa-apa sebab tidak dapat menghadiri mesyuarat Lembaga, Timbalan Pengerusi hendaklah menjalankan kuasa Pengerusi semasa ketiadaan Pengerusi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_1__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam keadaan di mana kedua-dua Pengerusi dan Timbalan Pengerusi tidak dapat menghadiri mesyuarat Lembaga, anggota Lembaga yang tinggal hendaklah memilih seorang di kalangan mereka untuk mempengerusikan mesyuarat dan orang yang dipilih hendaklah mempunyai semua kuasa Pengerusi bagi maksud dan untuk tempoh mesyuarat tersebut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_1__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mengenai apa-apa persoalan yang hendak ditentukan oleh Lembaga, terdapat bilangan undi yang sama banyak, Pengerusi hendaklah mempunyai undi pemutus sebagai tambahan kepada undi biasanya. Tatacara"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_2",
      "@type": "akn:paragraph",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada Akta ini, Lembaga boleh mengawal selia tatacaranya sendiri. Minit"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_3",
      "@type": "akn:paragraph",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_3__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_3__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga hendaklah menyebabkan minit semua mesyuarat Lembaga disenggarakan dan disimpan dalam bentuk yang sepatutnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Minit mesyuarat Lembaga, jika ditandatangani dengan sewajarnya, hendaklah dalam mana-mana prosiding undang-undang diterima sebagai keterangan prima facie mengenai fakta yang dinyatakan dalam minit itu tanpa bukti selanjutnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_3__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Setiap mesyuarat Lembaga yang berkenaan dengannya minit telah dibuat mengikut subperenggan (1) dan (2) hendaklah disifatkan telah dipanggil dan diadakan dengan sewajarnya semua anggota dalam mesyuarat itu adalah layak dengan sewajarnya untuk bertindak. Lembaga boleh mengundang orang lain untuk menghadiri mesyuarat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_4",
      "@type": "akn:paragraph",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_4__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga boleh mengundang mana-mana orang untuk menghadiri mana- mana mesyuarat atau pertimbangtelitian Lembaga bagi maksud menasihatinya tentang apa-apa perkara yang sedang dibincangkan, tetapi mana-mana orang yang hadir itu tidak berhak untuk mengundi pada mesyuarat atau pertimbangtelitian itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang diundang di bawah subperenggan (1) hendaklah dibayar elaun sebagaimana yang ditentukan oleh Lembaga. Penzahiran kepentingan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5",
      "@type": "akn:paragraph",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang anggota Lembaga, yang mempunyai, secara langsung atau tidak langsung, dengan sendiri, menerusi anggota keluarganya atau menerusi sekutunya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu kepentingan dalam syarikat atau perusahaan yang mana pihak Institut bercadang untuk mengikat kontrak; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu kepentingan di dalam suatu kontrak atau perkara yang dibincangkan oleh Lembaga, hendaklah menzahirkan kepada Lembaga hakikat kepentingannya dan jenis kepentingan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Penzahiran di bawah subperenggan (1) hendaklah direkodkan dalam minit mesyuarat Lembaga dan anggota yang berkenaan tidak boleh mengambil bahagian dalam perbincangan atau keputusan Lembaga berhubung dengan kontrak atau perkara itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5__subsec_3__list_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5__subsec_3__list_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud perenggan ini— “anggota keluarganya”, berhubungan dengan seseorang anggota Lembaga, ertinya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5__subsec_3__list_1",
      "@type": "akn:list",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5__subsec_3__list_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5__subsec_3__list_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5__subsec_3__list_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5__subsec_3__list_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5__subsec_3__list_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5__subsec_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5__subsec_3__list_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5__subsec_3__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "suami atau isterinya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5__subsec_3__list_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5__subsec_3__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "ibu atau bapanya (termasuk ibu atau bapa suami atau isterinya);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5__subsec_3__list_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5__subsec_3__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "anaknya (termasuk anak angkat atau anak tiri);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5__subsec_3__list_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5__subsec_3__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "adik-beradiknya (termasuk adik-beradik suami atau isterinya); dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5__subsec_3__list_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5__subsec_3__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "suami atau isteri anak atau adik-beradiknya; dan “sekutunya”, berhubungan dengan seseorang anggota Lembaga, ertinya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5__subsec_3__list_2",
      "@type": "akn:list",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5__subsec_3__list_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5__subsec_3__list_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5__subsec_3__list_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5__subsec_3__list_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5__subsec_3__list_2__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5__subsec_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5__subsec_3__list_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5__subsec_3__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "orang yang merupakan penama atau pekerja anggota itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5__subsec_3__list_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5__subsec_3__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "firma yang anggota itu atau mana-mana penamanya merupakan seorang pekongsinya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5__subsec_3__list_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5__subsec_3__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pekongsi anggota itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5__subsec_3__list_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5__subsec_3__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pemegang amanah sesuatu amanah yang di bawahnya anggota itu atau seorang ahli keluarganya ialah seorang benefisiari; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5__subsec_3__list_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~sched_1__para_5__subsec_3__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana perbadanan mengikut pengertian Akta Syarikat 1965 [Akta 125], yang mana anggota itu atau mana-mana penamanya atau seorang ahli keluarga anggota itu ialah pengarah atau mempunyai pemegangan syer yang substansial dalam perbadanan itu."
      }
    }
  ]
}
