        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_21__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_III__cl_21__subsec_4",
