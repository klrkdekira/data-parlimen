      "schema:text": {
        "@language": "ms",
        "@value": "PEGAWAI YANG DITUGASKAN Pelantikan pegawai yang ditugaskan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/2/msa@/~part_VII",
