      ],
      "schema:name": {
        "@language": "en",
        "@value": "Printing Presses and Publications (Amendment) Bill 2012"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/23/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/23/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/23/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/23/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/23/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/23/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Printing Presses and Publications (Amendment) Act 2012."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/23/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/23/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Amendment of section 3"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/23/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/23/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Printing Presses and Publications Act 1984 [Act 301], which is referred to as the “principal Act” in this Act, is amended by substituting for subsection 3(3) the following subsection: “(3) The Minister may grant to any person a licence to keep for use or use a printing press and he may refuse any application for such licence or may at any time revoke or suspend such licence for any period he considers desirable.”. Amendment of section 6"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/23/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/23/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 6(1) of the principal Act is amended by deleting the words “in his absolute discretion”. Substitution of section 12"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/23/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/23/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by substituting for section 12 the following section: “Validity of licence and permit 12. A licence or permit granted under this Act shall be subject to such conditions as may be endorsed in the licence or permit and shall remain valid for so long as it is not revoked.”. Amendment of section 13a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/23/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/23/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 13a(1) of the principal Act is amended by deleting the words “and shall not be called in question by any court on any ground whatsoever”. Substitution of section 13b"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/23/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/23/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by substituting for section 13b the following section: “Right to be heard 13b. A person who has been granted a licence or permit under this Act shall be given an opportunity to be heard before a decision to revoke or suspend such licence or permit is made under subsection 3(3), 6(2) or 13(1), as the case may be.”. Savings provision"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/23/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/23/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "A licence or permit that has been granted and is valid at the date of coming into operation of this Act shall remain valid for so long as it is not revoked, notwithstanding its expiry date."
      }
    }
  ]
}
