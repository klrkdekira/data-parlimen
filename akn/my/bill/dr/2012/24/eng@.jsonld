      "schema:name": {
        "@language": "en",
        "@value": "Section 13 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/24/eng@/~cl_10__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/24/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (1a) the following subsection: “(1a) For the purposes of subsection (2) there shall be established a committee to be known as the Medical Qualifying Committee consisting of the following members: (a) the President as Chairman; (b) four members of the Council nominated from and representing the recognised local universities and university colleges and appointed by the Chairman; (c) four representatives from the Ministry of Health; and (d) four other members of the Council nominated from those not representing the recognised local universities and university colleges and appointed by the Chairman.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/24/eng@/~cl_10__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
