        "@value": "in subsection (2), by inserting after the words “(to be styled “annual practising certificate”)” the words “with terms and conditions determined by the Council”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/24/eng@/~cl_16__para_c",
      "@type": "akn:paragraph",
