      "schema:text": {
        "@language": "en",
        "@value": "in subparagraph 2(2), by substituting for the word “seven” the word “ten” and by inserting after the words “meeting of the Council” the words “for a specified purpose”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/24/eng@/~cl_41__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/24/eng@/~cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subparagraph 2(2) the following paragraph: “(2a) At least fourteen days, notice in writing of the meeting referred to in subsections (1) and (2) shall be given to the members.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/24/eng@/~cl_41__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/24/eng@/~cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting subparagraph 2(3);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/24/eng@/~cl_41__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/24/eng@/~cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting subparagraph 2(5);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/24/eng@/~cl_41__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/24/eng@/~cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subparagraph 2(6) the following subparagraph: “(6) There shall be paid to all members of the Council such fees for attendance at meetings of the Council or of any committee appointed by the Council and such reasonable travelling expenses and subsistence allowances for such attendance and for journeys undertaken in the discharge of their duties under this Act or any other expenses as the Council may determine with the approval of the Minister from time to time.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/24/eng@/~cl_41__para_j",
      "@type": "akn:paragraph",
