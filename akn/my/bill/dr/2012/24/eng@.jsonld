      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/24/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (9), by substituting for the words “medicine, surgery or obstetric and gynaecology” the word “Medicine”. Amendment of section 14"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/24/eng@/~cl_11",
