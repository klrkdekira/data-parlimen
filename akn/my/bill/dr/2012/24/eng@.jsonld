      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/24/eng@/~cl_10__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the word “board” the word “Committee” wherever it appears in this subsection; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/24/eng@/~cl_10__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/24/eng@/~cl_10__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words “evidence thereof” the words “determined by the Council from time to time”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/24/eng@/~cl_10__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/24/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (4), by inserting after the word “disability” the words “or any other reason as determined by the Council”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/24/eng@/~cl_10__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/24/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (4) the following subsection: “(4a) Notwithstanding paragraph 12(1)(aaa), the Council may consider any person who is a non citizen and not a spouse of a citizen studying in any recognised local training institution to be provisionally registered for the purpose of obtaining the experience as provided in subsection (2).”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/24/eng@/~cl_10__para_e",
