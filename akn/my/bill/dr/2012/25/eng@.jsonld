      "schema:name": {
        "@language": "en",
        "@value": "Safeguards (Amendment) Bill 2012"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/25/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/25/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/25/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/25/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/25/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/25/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Safeguards (Amendment) Act 2012."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/25/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/25/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Amendment of section 28"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/25/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/25/eng@/~cl_2__para_b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/25/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Safeguards Act 2006 [Act 657], which is referred to as the “principal Act” in this Act, is amended in subsection 28(2) by substituting for the words “(1)(a) and (b)” the words “(1)(a),"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/25/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/25/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "and (c)”. New section 40a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/25/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/25/eng@/~cl_3__subsec_2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/25/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting after section 40 the following section: “Bilateral safeguards 40a. (1) Nothing in this Act shall prevent the Government from initiating safeguard investigation and imposing safeguard measure in accordance with the terms and conditions agreed upon in a trade agreement entered into by the Government."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/25/eng@/~cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/25/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister shall prescribe the terms and conditions of the safeguard investigation and safeguard measure for the purpose of subsection (1).”."
      }
    }
  ]
}
