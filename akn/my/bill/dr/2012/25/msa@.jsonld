      ],
      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Pelindung (Pindaan) 2012"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/25/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/25/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/25/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/25/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/25/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/25/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Pelindung (Pindaan) 2012."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/25/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/25/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta. Pindaan seksyen 28"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/25/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/25/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Pelindung 2006 [Akta 657], yang disebut “Akta ibu” dalam Akta ini, dipinda dalam subseksyen 28(2) dengan menggantikan perkataan “(1)(a) dan (b)” dengan perkataan “(1)(a), (b) dan (c)”. Seksyen baru 40a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/25/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/25/msa@/~cl_3__subsec_2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/25/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memasukkan selepas seksyen 40 seksyen yang berikut: “Pelindungan dua hala 40a. (1) Tiada apa-apa pun dalam Akta ini boleh menghalang Kerajaan daripada memulakan penyiasatan pelindungan dan mengenakan langkah perlindungan mengikut terma dan syarat yang dipersetujui dalam perjanjian perdagangan yang dibuat oleh Kerajaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/25/msa@/~cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/25/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri hendaklah menetapkan terma dan syarat penyiasatan pelindungan dan langkah perlindungan bagi maksud subseksyen (1).”."
      }
    }
  ]
}
