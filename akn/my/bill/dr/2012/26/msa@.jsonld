      "schema:text": {
        "@language": "ms",
        "@value": "UMUR PERSARAAN MINIMUM Umur persaraan minimum"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III",
      "@type": "akn:part",
      "eli:number": "III",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_11"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "ADUAN DAN SIASATAN Kuasa Ketua Pengarah untuk menyiasat aduan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_10__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang tidak berpuas hati dengan keputusan Ketua Pengarah di bawah subseksyen 8(5) boleh merayu kepada Mahkamah Tinggi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada mana-mana kaedah-kaedah yang dibuat di bawah seksyen 4 Akta Kaedah-Kaedah Mahkamah Rendah 1955 [Akta 55], tatacara dalam sesuatu rayuan ke Mahkamah Tinggi adalah tatacara dalam rayuan sivil daripada Mahkamah Sesyen dengan pengubahsuaian mengikut kehendak keadaan. Ketidakpatuhan kepada arahan Ketua Pengarah"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_11__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_11__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang majikan yang tidak mematuhi arahan Ketua Pengarah di bawah perenggan 8(5)(b) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi sepuluh ribu ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seseorang majikan telah disabitkan dengan suatu kesalahan di bawah subseksyen (1), mahkamah yang di hadapannya majikan itu disabitkan boleh memerintahkan majikan itu membayar pekerja itu jumlah yang diarahkan oleh Ketua Pengarah supaya dibayar di bawah perenggan 8(5)(b)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_11__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_11__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_11__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika majikan tidak mematuhi perintah yang dibuat di bawah subseksyen (2), mahkamah boleh, atas permohonan seseorang pekerja, mengeluarkan suatu waran untuk melevi harta majikan itu bagi mendapatkan amaun yang diperintahkan supaya dibayar di bawah subseksyen (2) dengan cara yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_11__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_11__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "secara distres dan penjualan harta majikan itu mengikut tatacara pelaksanaan yang sama di bawah Kaedah- Kaedah Mahkamah Rendah 1980 [P.U. (A) 328/1980] dan pelaksanaan ini hendaklah terpakai mutatis mutandis walau apa pun amaun yang diperintahkan untuk dibayar; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_11__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_11__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "mengikut cara yang sama seperti suatu denda sebagaimana yang diperuntukkan di bawah seksyen 283 Kanun Tatacara Jenayah [Akta 593]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_8__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_8__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_8__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_8__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_8__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_8__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_8__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_8__subsec_9"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pekerja yang telah dibersarakan secara pramasa oleh majikannya mempunyai pilihan untuk mengadu secara bertulis kepada Ketua Pengarah dalam tempoh enam puluh hari dari tarikh persaraan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seseorang pekerja memilih untuk membuat suatu aduan kepada Ketua Pengarah di bawah subseksyen (1), pekerja itu tidak boleh membuat representasi di bawah seksyen 20 Akta Perhubungan Perusahaan 1967 sehingga aduannya kepada Ketua Pengarah di bawah seksyen ini telah diselesaikan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_8__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seseorang pekerja telah membuat representasi di bawah seksyen 20 Akta Perhubungan Perusahaan 1967 dan juga membuat aduan di bawah subseksyen (1), Ketua Pengarah tidak boleh menjalankan siasatan terhadap aduan yang dibuat oleh pekerja itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_8__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada subseksyen (3), Ketua Pengarah boleh menjalankan suatu siasatan, mengikut cara yang ditetapkan oleh Menteri, untuk menentukan sama ada terdapat keterangan prima facie bahawa seseorang pekerja telah dibersarakan secara pramasa oleh majikannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_8__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_8__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_8__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Selepas suatu siasatan di bawah subseksyen (4), jika Ketua Pengarah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_8__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_8__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "berpuas hati bahawa aduan oleh seseorang pekerja adalah tidak berasas, Ketua Pengarah hendaklah menolak aduan itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_8__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_8__subsec_5__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_8__subsec_5__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_8__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "berpuas hati bahawa pekerja itu telah dibersarakan secara pramasa oleh majikannya, Ketua Pengarah boleh mengarahkan majikan itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_8__subsec_5__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_8__subsec_5__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "supaya mengembalikan semula pekerja itu kepada pekerjaan asalnya dan membayar pekerja itu apa- apa tunggakan gaji yang dikira dari tarikh pekerja itu telah dibersarakan secara pramasa sehingga tarikh pengembalian semula kerja itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_8__subsec_5__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_8__subsec_5__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "supaya membayar pekerja itu pampasan sebagai ganti pengembalian semula kerja yang tidak melebihi amaun keseluruhan gaji pekerja itu yang dikira dari tarikh pekerja itu telah dibersarakan secara pramasa sehingga tarikh pekerja itu mencapai umur persaraan minimum."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_8__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (2) dan apa-apa had masa yang diperuntukkan di bawah subseksyen 20(1a) Akta Perhubungan Perusahaan 1967, seseorang pekerja boleh membuat representasi di bawah seksyen 20 Akta Perhubungan Perusahaan 1967 jika Ketua Pengarah menolak aduannya di bawah perenggan (5)(a), dan representasi itu hendaklah dibuat dalam tempoh tiga puluh hari selepas penolakan aduan di bawah perenggan (5)(a) disampaikan kepada pekerja itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_8__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seseorang pekerja telah membuat representasi di bawah seksyen 20 Akta Perhubungan Perusahaan 1967 selepas aduannya ditolak di bawah perenggan (5)(a), pekerja itu tidak berhak untuk merayu di bawah seksyen 9 Akta ini, terhadap penolakan aduannya oleh Ketua Pengarah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_8__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Ketua Pengarah telah membuat suatu arahan di bawah perenggan (5)(b), seseorang pekerja tidak berhak untuk mendapat apa-apa remedi lain bagi pembuangan kerja tanpa sebab dan alasan yang adil di bawah Akta Perhubungan Perusahaan 1967."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_8__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_8__subsec_9__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_8__subsec_9__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini, “gaji”—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_8__subsec_9__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_8__subsec_9",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi pekerja yang dinyatakan dalam Jadual Pertama kepada Akta Kerja 1955, dalam Jadual kepada Ordinan Buruh Sabah atau dalam Jadual kepada Ordinan Buruh Sarawak, mempunyai erti yang diberikan masing-masing kepadanya dalam seksyen 2 Akta Kerja 1955, seksyen 2 Ordinan Buruh Sabah atau seksyen 2 Ordinan Buruh Sarawak; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_8__subsec_9__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_8__subsec_9",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi pekerja yang tidak dinyatakan dalam Jadual Pertama kepada Akta Kerja 1955, dalam Jadual kepada Ordinan Buruh Sabah atau dalam Jadual kepada Ordinan Buruh Sarawak, ertinya kadar gaji yang dipersetujui dalam kontrak perkhidmatannya. Rujukan kepada Mahkamah Tinggi bagi persoalan undang- undang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_9__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam mana-mana siasatan di bawah subseksyen 8(4), Ketua Pengarah boleh, jika difikirkannya patut, merujuk apa- apa persoalan undang-undang bagi keputusan Hakim Mahkamah Tinggi dan jika Ketua Pengarah berbuat sedemikian dia hendaklah membuat keputusan dalam siasatan itu selaras dengan keputusan Hakim Mahkamah Tinggi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_III__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu rayuan ke atas mana-mana keputusan Hakim Mahkamah Tinggi di bawah subseksyen (1) hendaklah dibuat kepada Mahkamah Rayuan. Rayuan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_II__cl_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_II__cl_4__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_II__cl_4__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_II__cl_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa-apa pun undang-undang bertulis lain, umur persaraan minimum seseorang pekerja adalah apabila pekerja itu mencapai umur enam puluh tahun."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_II__cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, melalui pemberitahuan dalam Warta, menetapkan umur persaraan minimum yang lebih tinggi daripada umur persaraan yang diperuntukkan di bawah subseksyen (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_II__cl_4__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila Menteri menetapkan umur persaraan minimum yang lebih tinggi di bawah subseksyen (2), umur persaraan minimum yang ditetapkan itu hendaklah menggantikan umur persaraan minimum yang diperuntukkan di bawah subseksyen (1). Persaraan pramasa"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_II__cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_II__cl_5__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_II__cl_5__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_II__cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang majikan tidak boleh membersarakan secara pramasa seseorang pekerja sebelum pekerja itu mencapai umur persaraan minimum."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_II__cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang majikan yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi sepuluh ribu ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_II__cl_5__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu persaraan pramasa tidak termasuk suatu persaraan pilihan di bawah seksyen 6 dan penamatan kontrak perkhidmatan atas apa-apa sebab selain daripada atas alasan umur. Persaraan pilihan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun umur persaraan minimum, seseorang pekerja boleh bersara apabila mencapai umur persaraan pilihan yang dipersetujui dalam kontrak perkhidmatan atau perjanjian kolektif. Ketidaksahan terma kontrak perkhidmatan dan perjanjian kolektif"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_II__cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_II__cl_7__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_II__cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa umur persaraan dalam sesuatu kontrak perkhidmatan atau perjanjian kolektif yang dibuat sebelum, pada atau selepas tarikh permulaan kuat kuasa Akta ini yang lebih rendah daripada umur persaraan minimum yang diperuntukkan di bawah Akta ini hendaklah disifatkan sebagai terbatal dan digantikan dengan umur persaraan minimum yang telah diperuntukkan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_II__cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana terma dalam sesuatu kontrak perkhidmatan atau perjanjian kolektif yang berhubungan dengan umur persaraan hendaklah terbatal jika terma itu mengecualikan atau mengehadkan kuat kuasa mana-mana peruntukan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_IV__cl_12",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_IV__cl_13",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_IV__cl_14"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "PENYIASATAN DAN PENGUATKUASAAN Kuasa Ketua Pengarah"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_IV__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_IV__cl_12__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_IV__cl_12__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_IV",
      "schema:name": {
        "@language": "ms",
        "@value": "Ketua Pengarah hendaklah mempunyai segala kuasa untuk—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_IV__cl_12__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_IV__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "menyiasat apa-apa kesalahan di bawah Akta ini; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_IV__cl_12__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_IV__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menguatkuasakan mana-mana peruntukan Akta ini. Kuasa untuk menghendaki kehadiran orang yang mempunyai pengetahuan tentang kes"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_IV__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_IV__cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_IV__cl_13__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_IV__cl_13__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_IV__cl_13__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_IV__cl_13__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_IV__cl_13__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_IV__cl_13__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_IV__cl_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_IV__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah dalam membuat penyiasatan di bawah Akta ini boleh, melalui perintah secara bertulis, menghendaki kehadiran di hadapannya mana-mana orang yang pada pendapatnya mengetahui fakta dan hal keadaan kes itu, dan orang itu hendaklah hadir sebagaimana yang dikehendaki."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_IV__cl_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_IV__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana orang enggan atau tidak hadir sebagaimana yang dikehendaki, Ketua Pengarah boleh melaporkan keengganan atau ketidakhadiran itu kepada seorang Majistret yang hendaklah mengeluarkan suatu saman untuk memastikan kehadiran orang itu sebagaimana yang dikehendaki oleh perintah yang dibuat di bawah subseksyen (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_IV__cl_13__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_IV__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah boleh memeriksa secara lisan seseorang yang dikatakan mempunyai pengetahuan tentang fakta dan hal keadaan kes di bawah penyiasatannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_IV__cl_13__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_IV__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang itu adalah terikat untuk menjawab semua soalan yang diajukan kepadanya oleh Ketua Pengarah yang berhubungan dengan kes dalam penyiasatan tetapi orang itu boleh enggan untuk menjawab mana-mana soalan yang jawapannya berkecenderungan untuk mendedahkannya kepada pertuduhan jenayah atau penalti atau pelucuthakan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_IV__cl_13__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_IV__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang membuat pernyataan di bawah seksyen ini adalah terikat di sisi undang-undang untuk menyatakan yang benar, sama ada pernyataan itu dibuat keseluruhannya atau sebahagiannya dalam menjawab soalan atau tidak."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_IV__cl_13__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_IV__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah yang memeriksa seseorang di bawah subseksyen (3) hendaklah terlebih dahulu memaklumkan orang itu tentang peruntukan subseksyen (4) dan (5)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_IV__cl_13__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_IV__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu pernyataan yang dibuat oleh mana-mana orang di bawah seksyen ini hendaklah diubah ke dalam bentuk bertulis dan ditandatangani oleh orang yang membuat pernyataan itu atau ditandakan dengan cap ibu jarinya selepas pernyataan itu telah dibacakan kepadanya dalam bahasa pernyataan itu dibuat olehnya dan selepas dia diberi peluang untuk membuat apa-apa pembetulan yang dia mahu. Kuasa untuk menghendaki pengemukaan dokumen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_IV__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_IV__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_IV__cl_14__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_IV__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_IV__cl_14__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_IV__cl_14__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_IV__cl_14__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_IV__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah yang membuat penyiasatan di bawah Akta ini boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_IV__cl_14__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_IV__cl_14__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menghendaki mana-mana orang yang mempunyai pengetahuan tentang fakta dan hal keadaan kes itu untuk mengemukakan apa-apa kontrak perkhidmatan atau dokumen lain yang berhubungan dengan pekerjaan seseorang pekerja yang membuat aduan di bawah subseksyen 8(1);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_IV__cl_14__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_IV__cl_14__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat salinan mana-mana kontrak perkhidmatan atau dokumen lain yang berhubungan dengan pekerjaan yang dikemukakan di bawah perenggan (a); dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_IV__cl_14__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_IV__cl_14__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mengambil atau mengeluarkan apa-apa dokumen yang berkaitan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_IV__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_IV__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Ketua Pengarah berpuas hati bahawa mana-mana dokumen tidak lagi perlu dipegang simpan, Ketua Pengarah boleh mengembalikan dokumen itu kepada orang yang memberikan dokumen itu dengan secepat yang dapat dilaksanakan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_I__cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_I__cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Umur Persaraan Minimum 2012."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_I__cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta dan Menteri boleh menetapkan tarikh yang berlainan bagi permulaan kuat kuasa peruntukan yang berlainan dalam Akta ini. Ketidakpakaian"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_I__cl_2__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_I__cl_2__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_I__cl_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_I__cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini tidak terpakai bagi orang yang dinyatakan dalam Jadual."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_I__cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_I__cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, melalui perintah yang disiarkan dalam Warta, meminda Jadual. Tafsiran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_I__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_I__cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_I__cl_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_I__cl_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_I",
      "schema:name": {
        "@language": "ms",
        "@value": "Dalam Akta ini, melainkan jika konteksnya menghendaki makna yang lain—"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "“ditetapkan” ertinya ditetapkan melalui peraturan-peraturan; “Ketua Pengarah” ertinya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_I__cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_I__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "berkenaan dengan Semenanjung Malaysia, Ketua Pengarah Tenaga Kerja yang dilantik di bawah subseksyen 3(1) Akta Kerja 1955 [Akta 265];"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_I__cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_I__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "berkenaan dengan Sabah, Pengarah Tenaga Kerja yang dilantik di bawah subseksyen 3(1) Ordinan Buruh Sabah [Sabah Bab 67]; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_I__cl_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_I__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "berkenaan dengan Sarawak, Pengarah Tenaga Kerja yang dilantik di bawah subseksyen 3(1) Ordinan Buruh Sarawak [Sarawak Bab 76]; “kontrak perkhidmatan” ertinya mana-mana perjanjian, sama ada secara lisan atau bertulis, dan sama ada secara nyata atau tersirat, yang menurutnya seseorang bersetuju untuk mengambil kerja seorang yang lain sebagai pekerja dan orang yang lain itu bersetuju untuk berkhidmat dengan majikannya sebagai pekerja; “majikan” ertinya mana-mana orang yang membuat kontrak perkhidmatan untuk mengambil kerja seorang yang lain sebagai pekerja dan termasuk ejen, pengurus atau faktor bagi orang yang mula-mula disebut itu; “Menteri” ertinya Menteri yang dipertanggungkan dengan tanggungjawab bagi sumber manusia; “pegawai tenaga kerja” ertinya pegawai yang dilantik di bawah subseksyen 3(2) Akta Kerja 1955, subseksyen 3(1a) Ordinan Buruh Sabah atau subseksyen 3(1a) Ordinan Buruh Sarawak; “pekerja” ertinya mana-mana orang yang membuat, dan bekerja di bawah, suatu kontrak perkhidmatan dengan seorang majikan tanpa mengira gajinya tetapi tidak termasuk orang yang dinyatakan dalam Jadual; “perjanjian kolektif” mempunyai erti yang sama yang diberikan kepadanya dalam seksyen 2 Akta Perhubungan Perusahaan 1967 [Akta 177]; “persaraan” ertinya penamatan sesuatu kontrak perkhidmatan seseorang pekerja atas alasan umur; “persaraan pramasa” ertinya persaraan yang tidak mengikut seksyen 5; “umur persaraan minimum” ertinya umur persaraan yang diperuntukkan di bawah subseksyen 4(1) dan jika Menteri menetapkan suatu umur persaraan minimum yang lebih tinggi di bawah subseksyen 4(2), umur persaraan minimum yang lebih tinggi itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_V",
      "@type": "akn:part",
      "eli:number": "V",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_V__cl_15",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_V__cl_16",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_V__cl_17",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_V__cl_18",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_V__cl_19"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "AM Pelaksanaan kuasa Ketua Pengarah oleh pegawai tenaga kerja"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_V__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_V__cl_15__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_V__cl_15__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_V__cl_15__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_V__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada subseksyen (2) dan apa-apa batasan sebagaimana yang ditetapkan oleh Menteri, seorang pegawai tenaga kerja boleh menjalankan semua kuasa yang diberikan kepada Ketua Pengarah di bawah Akta ini, dan setiap kuasa yang dijalankan hendaklah disifatkan telah dijalankan bagi maksud Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_V__cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_V__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Seorang pegawai tenaga kerja tidak boleh menjalankan mana-mana kuasa Ketua Pengarah di bawah Akta ini melainkan jika dia memiliki kad kuasa yang ditandatangani oleh Ketua Pengarah yang memberi kuasa kepadanya untuk melaksanakan kuasa tersebut. Pendakwaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_V__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada pendakwaan bagi sesuatu kesalahan di bawah Akta ini boleh dimulakan kecuali oleh atau dengan keizinan bertulis Pendakwa Raya. Pengkompaunan kesalahan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_V__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_V__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_V__cl_17__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_V__cl_17__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_V__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_V__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah boleh, dengan keizinan secara bertulis Pendakwa Raya, mengkompaun apa-apa kesalahan yang dilakukan oleh mana-mana majikan di bawah Akta ini yang ditetapkan sebagai kesalahan boleh kompaun dengan membuat suatu tawaran bertulis kepada majikan yang disyaki melakukan kesalahan itu untuk mengkompaun kesalahan itu apabila dibayar kepada Ketua Pengarah suatu amaun wang yang tidak melebihi lima puluh peratus daripada amaun denda maksimum bagi kesalahan itu dalam tempoh masa yang dinyatakan dalam tawaran itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_V__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_V__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu tawaran di bawah subseksyen (1) boleh dibuat pada bila-bila masa selepas kesalahan itu telah dilakukan, tetapi sebelum apa-apa pendakwaan baginya telah dimulakan, dan jika amaun yang dinyatakan dalam tawaran itu tidak dibayar dalam tempoh masa yang dinyatakan dalam tawaran itu atau dalam apa- apa tempoh masa lanjutan yang diberikan oleh Ketua Pengarah, pendakwaan bagi kesalahan itu boleh dimulakan pada bila-bila masa selepas itu terhadap majikan yang kepadanya tawaran itu dibuat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_V__cl_17__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_V__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika sesuatu kesalahan telah dikompaun di bawah subseksyen (1), tiada pendakwaan boleh dimulakan berkenaan dengan kesalahan itu terhadap majikan yang kepadanya tawaran untuk mengkompaun itu telah dibuat. Pengecualian"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_V__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, melalui perintah yang disiarkan dalam Warta, mengecualikan dengan atau tanpa syarat mana-mana majikan atau kumpulan majikan daripada semua atau mana-mana peruntukan Akta ini. Kuasa untuk membuat peraturan-peraturan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_V__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh membuat peraturan-peraturan sebagaimana perlu dan suai manfaat bagi maksud untuk melaksanakan peruntukan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~sched_1__para_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~sched_1__para_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "(Seksyen 2)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~sched_1__para_1",
      "@type": "akn:paragraph",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~sched_1__para_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~sched_1__para_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~sched_1__para_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~sched_1__para_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~sched_1__para_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~sched_1__para_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~sched_1__para_1__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~sched_1__para_1__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~sched_1__para_1__para_i"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~sched_1",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ini tidak terpakai bagi—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~sched_1__para_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~sched_1__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang yang diambil kerja secara tetap, sementara atau kontrak dan dibayar emolumen oleh Kerajaan Persekutuan, Kerajaan mana-mana Negeri, mana-mana badan berkanun atau mana-mana pihak berkuasa tempatan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~sched_1__para_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~sched_1__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang yang bekerja dalam tempoh percubaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~sched_1__para_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~sched_1__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang perantis yang diambil kerja di bawah kontrak perantisan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~sched_1__para_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~sched_1__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pekerja bukan warganegara;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~sched_1__para_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~sched_1__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pekhidmat domestik;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~sched_1__para_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~sched_1__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang yang diambil kerja dalam apa-apa pekerjaan dengan purata waktu bekerjanya tidak melebihi tujuh puluh peratus waktu bekerja biasa seseorang pekerja sepenuh masa;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~sched_1__para_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~sched_1__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang pelajar yang diambil kerja di bawah mana-mana kontrak untuk tempoh sementara tetapi tidak termasuk pekerja dalam cuti belajar dan pekerja yang sedang belajar secara separuh masa;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~sched_1__para_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~sched_1__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang yang diambil kerja untuk suatu kontrak perkhidmatan bertempoh tetap termasuk apa-apa perlanjutan, yang tidak lebih daripada dua puluh empat bulan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~sched_1__para_1__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~sched_1__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang yang, sebelum tarikh permulaan kuat kuasa Akta ini, telah bersara pada umur lima puluh lima tahun atau lebih dan kemudiannya bekerja semula selepas dia bersara."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~sched_1__para_2",
      "@type": "akn:paragraph",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/26/msa@/~sched_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud Jadual ini “pekhidmat domestik” dan “kontrak perantisan” mempunyai erti yang diberikan kepadanya dalam seksyen 2 Akta Kerja 1955, Ordinan Buruh Sabah dan Ordinan Buruh Sarawak."
      }
    }
  ]
}
