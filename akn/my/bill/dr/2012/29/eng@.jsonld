      "schema:name": {
        "@language": "en",
        "@value": "Section 53A of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/29/eng@/~cl_11__para_a",
      "@type": "akn:paragraph",
