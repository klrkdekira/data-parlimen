      "schema:text": {
        "@language": "en",
        "@value": "Subsection 40(1) of the principal Act is amended by substituting for the words “not exceeding one thousand” the words “of not less than three hundred ringgit and not more than two thousand”. Amendment of section 53A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/29/eng@/~cl_11",
