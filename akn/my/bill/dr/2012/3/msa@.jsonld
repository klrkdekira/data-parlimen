      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Perbekalan Tambahan (2011) 2012"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/3/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/3/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Perbekalan Tambahan (2011) 2012. Perbelanjaan tambahan bagi tahun 2011"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/3/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/3/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Maka dengan ini dibenarkan pengeluaran sejumlah wang yang tidak melebihi sepuluh bilion dua ratus sembilan puluh juta dua ratus empat puluh tiga ribu lapan ratus ringgit (RM10,290,243,800) daripada Kumpulan Wang Disatukan bagi perbelanjaan untuk perkhidmatan dan maksud yang dinyatakan dalam Jadual bagi tahun 2011 yang tidak diperuntukkan atau yang tidak diperuntukkan dengan sepenuhnya oleh Akta Perbekalan 2011 [Akta A1388]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/3/msa@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/3/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Maksud Tajuk B. 4 Suruhanjaya Pilihan Raya B. 6 Jabatan Perdana Menteri B. 7 Jabatan Perkhidmatan Awam B. 10 Perbendaharaan B. 11 Perkhidmatan Am Perbendaharaan B. 12 Peruntukan Kepada Kumpulan Wang Terkanun B. 22 Kementerian Kemajuan luar Bandar dan Wilayah B. 23 Kementerian Sumber Asli dan Alam Sekitar B. 25 Kementerian Perdagangan Dalam Negeri, Koperasi dan Kepenggunaan B. 27 Kementerian Kerja Raya B. 28 Kementerian Pengangkutan B. 41 Kementerian Pelajaran B. 42 Kementerian Kesihatan B. 46 Kementerian Sumber Manusia B. 48 Kementerian Pembangunan Wanita, Keluarga dan Masyarakat B. 60 Kementerian Pertahanan B. 62 Kementerian Dalam Negeri JUMlAH"
      }
