      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif “lease” takrif yang berikut: ‘ “limited liability partnership” means a limited liability partnership registered under the Limited Liability Partnership Act 2012 [Act 743];’;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/35/msa@/~part_I__cl_4__para_a__subpara_v",
