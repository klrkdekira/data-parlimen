      "schema:text": {
        "@language": "ms",
        "@value": "Akta Cukai Pendapatan 1967 [Akta 53], Akta Setem 1949 [Akta 378], Akta Petroleum (Cukai Pendapatan) 1967 [Akta 543] dan Akta Cukai Keuntungan Harta Tanah 1976 [Akta 169] dipinda mengikut cara yang dinyatakan masing-masing dalam Bab II, III, IV dan V."
      }
    },
