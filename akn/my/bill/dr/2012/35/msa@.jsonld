        "@language": "ms",
        "@value": "Seksyen 39 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/35/msa@/~part_II__chp_IV__cl_49__para_a",
