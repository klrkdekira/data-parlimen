      "schema:text": {
        "@language": "ms",
        "@value": "dalam takrif “company”, dengan memasukkan selepas perkataan “Malaysia” perkataan “and a business trust”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/35/msa@/~part_I__cl_4__para_a__subpara_iv",
