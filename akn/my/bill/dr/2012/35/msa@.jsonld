    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/35/msa@/~part_I__cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/35/msa@/~part_I__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Subperenggan 4(a)(i) dan (iii), perenggan 4(b) dan (c), seksyen 7 dan 23 dan perenggan 35(c) berhubung dengan amanah syarikat mula berkuat kuasa apabila berkuatkuasanya peruntukan bersamaan Akta Pasaran Modal dan Perkhidmatan (Pindaan) 2012 [Akta A1437] yang berhubungan dengan amanah syarikat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/35/msa@/~part_I__cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/35/msa@/~part_I__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Subperenggan 4(a)(ii), seksyen 20 dan 22, dan perenggan 35(a) mula berkuat kuasa apabila berkuatkuasanya Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/35/msa@/~part_I__cl_3__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/35/msa@/~part_I__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Subperenggan 4(a)(iv), (v) dan (vi), seksyen 7, 8, 9, 14, 15, 23, 24, 25, 27, 28 dan 29, perenggan 33(b) dan (c), dan perenggan 35(c), 35(f) dan 37(a) berhubung dengan perkongsian liabiliti terhad mula berkuat kuasa apabila berkuatkuasanya peruntukan Akta Perkongsian Liabiliti Terhad 2012 [Akta 743]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/35/msa@/~part_I__cl_3__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/35/msa@/~part_I__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Subperenggan 4(a)(vii), seksyen 5, 10, 13, 18, perenggan 33(a) dan (d), perenggan 35(d) dan (e), perenggan 38(a), (b), (c), (d), (e), (g), (h) dan (i) dan seksyen 39 dan 40 berkuat kuasa bagi tahun taksiran 2013 dan tahun-tahun taksiran yang berikutnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/35/msa@/~part_I__cl_3__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/35/msa@/~part_I__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 6 dan 30 dan perenggan 33(e) mula berkuat kuasa pada 1 Januari 2013."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/35/msa@/~part_I__cl_3__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/35/msa@/~part_I__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 11, 12, 16, 26, 31, 32 dan 34, perenggan 35(b), seksyen 36 dan perenggan 38(f) mula berkuat kuasa pada 1 Januari 2014."
      }
    },
    {
