      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan 2—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/35/msa@/~part_I__cl_33__para_b__subpara_i",
