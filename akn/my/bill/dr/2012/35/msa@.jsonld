      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/35/msa@/~part_II__chp_IV__cl_48",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (2) subseksyen yang berikut: “(3) Paragraph (1)(h) shall not apply if for a year of assessment a person is exempt under section 65C or the Promotion of Investments Act 1986 [Act 327], in respect of all income of that person from all sources not being exemption on income equal to capital expenditure incurred.”. Pindaan seksyen 39"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/35/msa@/~part_II__chp_IV__cl_49",
