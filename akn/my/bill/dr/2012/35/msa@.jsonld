      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 56 dan perenggan 63(c) mula berkuat kuasa apabila mula berkuatkuasanya Akta Perkongsian Liabiliti Terhad 2012 [Akta 743]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/35/msa@/~part_II__chp_V__cl_55__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/35/msa@/~part_II__chp_V__cl_55",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 57, 58, perenggan 59(c), seksyen 61, perenggan 63(a) dan (b), dan seksyen 64 mula berkuat kuasa apabila mula berkuatkuasanya Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/35/msa@/~part_II__chp_V__cl_55__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
