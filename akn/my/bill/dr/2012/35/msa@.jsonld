      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 19, 21 dan perenggan 37(b) berkuat kuasa bagi tahun taksiran 2012 dan tahun-tahun taksiran yang berikutnya. Pindaan seksyen 2"
      }
    },
    {
