      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (9), dengan memasukkan selepas perkataan “shall exclude” perkataan “a business trust and”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/35/msa@/~part_I__cl_4__para_c",
      "@type": "akn:paragraph",
