      "schema:text": {
        "@language": "ms",
        "@value": "dalam takrif “Central Bank”, dengan menggantikan perkataan “Central Bank of Malaysia Act 1958 [Act 519]” dengan perkataan “Central Bank of Malaysia Act 2009 [Act 701]”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/35/msa@/~part_I__cl_4__para_a__subpara_iii",
