      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif “total income” takrif yang berikut: ‘ “treasury share” means a share of a company that was previously issued but was repurchased, redeemed or otherwise acquired by such company and not cancelled;’;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/35/msa@/~part_I__cl_4__para_b",
      "@type": "akn:paragraph",
