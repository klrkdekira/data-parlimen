      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 19(1) Akta ibu dipinda dengan menggantikan perkataan “enam” dengan perkataan “lima”. Pindaan seksyen 21B"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/35/msa@/~part_II__chp_V__cl_61",
