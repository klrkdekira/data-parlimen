    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_10__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_10__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_10__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_10__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Jadual Pertama Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_10__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “[Seksyen 2]” yang terdapat dalam kepala Jadual Pertama dengan perkataan “[Seksyen 3]”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_10__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subperenggan 12(i), dengan menggantikan perkataan “lima puluh” di mana-mana jua terdapat dengan perkataan “lima puluh lima”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_10__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subperenggan 12(ii), dengan menggantikan perkataan “lima puluh lima” dengan perkataan “enam puluh”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_10__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perenggan 13. Pindaan Jadual Kelapan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Jadual Kelapan Akta ibu dipinda dalam perenggan 2, 3 dan 6 dengan menggantikan perkataan “lima puluh lima” di mana- mana jua terdapat dengan perkataan “enam puluh”. Kesan menaikkan had umur yang layak orang berinsurans daripada lima puluh lima tahun kepada enam puluh tahun"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_12__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_12__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_12__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_12__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_12__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam seksyen ini, “tarikh yang ditetapkan” ertinya tarikh yang ditetapkan oleh Menteri di bawah subseksyen 1(2)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_12__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_12__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_12__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_12__subsec_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada Akta ibu, pada tarikh yang ditetapkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_12__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_12__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "orang berinsurans yang telah mencapai umur lima puluh tahun tetapi belum mencapai umur enam puluh tahun layak mendapat pencen ilat kecuali dalam keadaan di bawah subseksyen (3) dan (4);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_12__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_12__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang tanggungan bagi orang berinsurans yang mati apabila mencapai apa-apa umur daripada lima puluh lima hingga umur enam puluh tahun layak mendapat pencen penakat kecuali dalam keadaan di bawah subseksyen (5) dan (6);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_12__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_12__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah kena dibayar berkenaan dengan orang berinsurans yang disebut dalam perenggan (a) caruman jenis kedua pada kadar yang dinyatakan dalam Jadual Ketiga Akta ibu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_12__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_12__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah kena dibayar berkenaan dengan orang berinsurans yang belum mencapai umur lima puluh lima tahun caruman jenis pertama pada kadar yang dinyatakan dalam Jadual Ketiga Akta ibu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_12__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_12__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_12__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Orang berinsurans yang berkenaan dengannya caruman jenis pertama kena dibayar tidak layak mendapat pencen ilat jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_12__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_12__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dia diperakui sebagai ilat apabila mencapai umur lima puluh lima tahun sebelum tarikh yang ditetapkan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_12__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_12__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dia diperakui sebagai ilat apabila mencapai umur enam puluh tahun sama ada pada atau selepas tarikh yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_12__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Orang berinsurans tidak layak mendapat pencen ilat jika dia diperakui sebagai ilat apabila mencapai umur lima puluh lima tahun sama ada pada atau selepas tarikh yang ditetapkan, dan dia diambil kerja hanya apabila mencapai umur lima puluh tahun dan jika tiada caruman jenis pertama kena dibayar berkenaan dengannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_12__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_12__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_12__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Orang tanggungan bagi orang berinsurans yang berkenaan dengannya caruman jenis pertama kena dibayar tidak layak mendapat pencen penakat jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_12__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_12__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "orang berinsurans itu mati apabila mencapai umur lima puluh lima tahun sebelum tarikh yang ditetapkan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_12__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_12__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "orang berinsurans itu mati apabila mencapai umur enam puluh tahun sama ada pada atau selepas tarikh yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_12__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_12__subsec_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_12__subsec_6__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Orang tanggungan bagi orang berinsurans tidak layak mendapat pencen penakat jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_12__subsec_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_12__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "orang berinsurans itu mati apabila mencapai umur lima puluh lima tahun sama ada pada atau selepas tarikh yang ditetapkan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_12__subsec_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_12__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "orang berinsurans itu diambil kerja hanya selepas dia mencapai umur lima puluh tahun dan jika tiada caruman jenis pertama kena dibayar berkenaan dengannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Keselamatan Sosial Pekerja (Pindaan) 2012."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta. Pindaan seksyen 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Keselamatan Sosial Pekerja 1969 [Akta 4], yang disebut “Akta ibu” dalam Akta ini, dipinda dalam subseksyen 2(5)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan sebelum perkataan ‘“pekerja”’ perkataan “Tertakluk kepada seksyen 3,”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan koma di hujung subperenggan (iii) dengan koma bernoktah; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan “akan tetapi tidak termasuk seseorang yang diperihalkan dalam Jadual Pertama;”. Pindaan seksyen 3"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 3 Akta ibu dipinda dengan memasukkan selepas subseksyen (2) subseksyen yang berikut: “(3) Akta ini tidak terpakai bagi orang yang diperihalkan dalam Jadual Pertama. (4) Menteri boleh, melalui perintah yang disiarkan dalam Warta, meminda Jadual Pertama.”. Pindaan am"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 15, 20A dan 29 Akta ibu dipinda dengan menggantikan perkataan “55” di mana-mana jua terdapat dengan perkataan “enam puluh”. Pindaan seksyen 17"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 17(1) Akta ibu dipinda dengan menggantikan perkataan “berumur genap lima puluh lima tahun” dengan perkataan “telah mencapai umur enam puluh tahun”. Pindaan seksyen 21"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 21(3) Akta ibu dipinda dengan menggantikan perkataan “genap umur lima puluh lima tahun” dengan perkataan “mencapai umur enam puluh tahun”. Pindaan seksyen 30"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_7__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 30 Akta ibu dipinda dengan menggantikan perkataan “yang sama banyaknya dengan empat puluh peratus kadar pencen atau faedah itu, tertakluk kepada amaun maksimum” dengan perkataan “pada kadar”."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Kadar elaun layanan sentiasa yang akan ditetapkan di bawah seksyen 30 Akta ibu sebagaimana yang dipinda dalam subseksyen (1) tidak boleh menyebabkan keadaan yang tidak kurang baiknya kepada orang berinsurans yang telah berhak mendapat elaun layanan sentiasa pada kadar yang sama banyaknya dengan empat puluh peratus kadar pencen atau faedah itu atau pada apa-apa kadar yang lebih tinggi sebagaimana yang ditetapkan oleh Menteri menurut seksyen 30 sebelum pindaan seksyen 30 Akta ibu dalam subseksyen (1) mula berkuat kuasa. Pindaan seksyen 57A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan 57A(c) Akta ibu dipinda dengan menggantikan perkataan “lima puluh lima” dengan perkataan “enam puluh”. Seksyen baru 112A"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memasukkan selepas seksyen 112 seksyen yang berikut: “Penyerahan dokumen secara elektronik 112A. (1) Tertakluk kepada subseksyen (2), Pertubuhan boleh membenarkan apa-apa penyata, penyataan, butiran, rekod, notis, laporan, daftar atau dokumen lain yang dikehendaki untuk diserahkan atau dikemukakan di bawah Akta ini atau peraturan-peraturan yang dibuat di bawah Akta ini melalui perantara elektronik atau secara penyampaian elektronik. (2) Syarat dan spesifikasi yang di bawahnya sesuatu penyata, penyataan, butiran, rekod, notis, laporan, daftar atau dokumen lain yang disebut dalam subseksyen (1) hendaklah diserahkan atau dikemukakan hendaklah sebagaimana yang ditentukan oleh Pertubuhan. (3) Penyata, penyataan, butiran, rekod, notis, laporan, daftar atau dokumen lain yang disebut dalam subseksyen (1) hendaklah disifatkan telah diserahkan atau dikemukakan oleh seseorang kepada Pertubuhan pada tarikh pengakuterimaan dokumen itu disampaikan secara elektronik oleh Pertubuhan kepada orang itu. (4) Pengakuterimaan oleh Pertubuhan, penyata, penyataan, butiran, rekod, notis, laporan, daftar atau dokumen lain yang diserah atau dikemukakan menurut subseksyen (3) hendaklah diterima sebagai keterangan dalam mana-mana prosiding.”. Pindaan Jadual Pertama"
      }
    }
  ]
}
