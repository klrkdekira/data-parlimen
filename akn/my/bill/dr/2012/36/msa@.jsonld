        "@value": "Rang Undang-Undang Keselamatan Sosial Pekerja (Pindaan) 2012"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/36/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
