      "schema:name": {
        "@language": "en",
        "@value": "Section 24b of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/4/eng@/~cl_7__para_a",
