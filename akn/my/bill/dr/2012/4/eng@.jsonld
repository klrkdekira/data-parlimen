      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (c), by inserting before the word “inform” the words “shall, if the polling agent or agents or counting agent or agents have been appointed under paragraph (a),”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/4/eng@/~cl_5__para_a__subpara_v",
