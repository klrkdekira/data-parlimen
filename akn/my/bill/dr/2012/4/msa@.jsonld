        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/4/msa@/~cl_5__para_a__subpara_v"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/4/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/4/msa@/~cl_5__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/4/msa@/~cl_5__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan “hendaklah”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/4/msa@/~cl_5__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/4/msa@/~cl_5__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (a), dengan memasukkan sebelum perkataan “melantik” perkataan “boleh”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/4/msa@/~cl_5__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/4/msa@/~cl_5__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perenggan (b) dengan perenggan yang berikut: “ (b) boleh menyewa pejabat parti politik bagi pihak calon itu;”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/4/msa@/~cl_5__para_a__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/4/msa@/~cl_5__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (c), dengan memasukkan sebelum perkataan “memberitahu” perkataan “hendaklah, jika ejen atau ejen-ejen tempat mengundi atau ejen atau ejen-ejen mengira telah dilantik di bawah perenggan (a),”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/4/msa@/~cl_5__para_a__subpara_v",
      "@type": "akn:subparagraph",
      "eli:number": "v",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/4/msa@/~cl_5__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (d), dengan memasukkan sebelum perkataan “memberitahu” perkataan “hendaklah, jika ejen atau-ejen-ejen mengira telah dilantik di bawah perenggan (a),”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/4/msa@/~cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/4/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (1a) dengan subseksyen yang berikut: “(1a) Tiap-tiap ejen tempat mengundi atau ejen mengira seseorang calon yang dilantik di bawah perenggan (1)(a) hendaklah bertugas atau hadir di tempat mengundi atau hendaklah menghadiri pengiraan undi di tempat mengundi mengikut waktu yang ditetapkan oleh Suruhanjaya Pilihan Raya.”. Pindaan seksyen 24a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/4/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/4/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 24 a Akta ibu dipinda dengan menggantikan subseksyen (2) dengan subseksyen yang berikut: “(2) Tiada seorang pun boleh, pada hari atau hari-hari penamaan, menunggu atau berdiri-diri dalam jarak satu ratus meter atau apa-apa jarak yang ditentukan oleh Suruhanjaya Pilihan Raya dari sempadan mana-mana tempat penamaan calon kecuali dengan kebenaran Suruhanjaya Pilihan Raya.”. Pindaan seksyen 24b"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/4/msa@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/4/msa@/~cl_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/4/msa@/~cl_7__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/4/msa@/~cl_7__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/4/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 24b Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/4/msa@/~cl_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/4/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2), dengan menggantikan perkataan “Seseorang” dengan perkataan “Tertakluk kepada subseksyen (2a), seseorang”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/4/msa@/~cl_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/4/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (2) subseksyen yang berikut: “(2a) Mana-mana pejabat yang dibuka, ditubuhkan atau disenggarakan di bawah subseksyen (2) hanya boleh dibuka, ditubuhkan atau disenggarakan dalam jarak tidak kurang daripada satu ratus meter dari pusat mengundi. ( 2b) Mana-mana orang yang melanggar subseksyen (2a) boleh, apabila disabitkan, dipenjarakan selama tempoh tidak melebihi satu tahun atau didenda tidak melebihi lima ribu ringgit atau kedua-duanya. ( 2c) Kesalahan di bawah subseksyen (2a) ialah kesalahan boleh tangkap mengikut pengertian Kanun Tatacara Jenayah.”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/4/msa@/~cl_7__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/4/msa@/~cl_7__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/4/msa@/~cl_7__para_c__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/4/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (7)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/4/msa@/~cl_7__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/4/msa@/~cl_7__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “lima puluh meter” dengan perkataan “satu ratus meter atau apa-apa jarak yang ditentukan oleh Suruhanjaya Pilihan Raya”; dan"
      }
    },
    {
