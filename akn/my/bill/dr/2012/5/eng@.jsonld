      "schema:name": {
        "@language": "en",
        "@value": "Labuan Companies (Amendment) Bill 2012"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/5/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/5/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/5/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/5/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/5/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/5/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This act may be cited as the labuan Companies (amendment) act 2012."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/5/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/5/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Amendment of section 18"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/5/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/5/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The labuan Companies act 1990 [Act 441], which is referred to as the “principal act” in this act, is amended in paragraph 18(1)(c) by deleting the words “and the division thereof into shares of a fixed amount”. Amendment of section 111"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/5/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/5/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 111(2) of the principal act is amended by inserting after the word “company” the words “, together with its relevant resolution, ”. Amendment of section 121"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/5/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/5/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 121(5) of the principal act is amended by substituting for the words “of such amount as may be prescribed not later than thirty days from each anniversary of the date of its registration” the words “in accordance with section 151”. Amendment of section 130o"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/5/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/5/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraph 130o(4)(a) of the principal act is amended by deleting the word “general”. Amendment of section 130v"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/5/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/5/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 130 v(1) of the principal act is amended by substituting for the words “section 48 a” the words “section 53”. Amendment of section 151"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/5/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/5/eng@/~cl_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/5/eng@/~cl_7__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/5/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 151 of the principal act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/5/eng@/~cl_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/5/eng@/~cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (1) the following subsection: “(1a) The authority may impose an administrative penalty on payment of any annual fees received later than the anniversary date as specified in subsection (1).”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/5/eng@/~cl_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/5/eng@/~cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (2), by substituting for the word “if” the words “Notwithstanding subsection (1a), if”."
      }
    }
  ]
}
