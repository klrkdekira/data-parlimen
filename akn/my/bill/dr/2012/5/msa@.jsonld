      ],
      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Syarikat Labuan (Pindaan) 2012"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/5/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/5/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/5/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/5/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/5/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/5/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Syarikat Labuan (Pindaan) 2012."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/5/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/5/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta. Pindaan seksyen 18"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/5/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/5/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Syarikat Labuan 1990 [Akta 441], yang disebut “Akta ibu” dalam Akta ini, dipinda dalam perenggan 18(1)(c) dengan memotong perkataan “dan pembahagiannya kepada syer amaun tetap”. Pindaan seksyen 111"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/5/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/5/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 111(2) Akta ibu dipinda dengan memasukkan selepas perkataan “anggota” perkataan “syarikat bersama dengan resolusinya yang berkaitan”. Pindaan seksyen 121"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/5/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/5/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 121(5) Akta ibu dipinda dengan menggantikan perkataan “dalam apa-apa amaun sebagaimana ditetapkan tidak lewat daripada tiga puluh hari dari setiap ulang tahun tarikh pendaftaran syarikat itu” dengan perkataan “mengikut seksyen 151”. Pindaan seksyen 130o"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/5/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/5/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan 130o(4)(a) Akta ibu dipinda dengan memotong perkataan “am”. Pindaan seksyen 130v"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/5/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/5/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 130v(1) Akta ibu dipinda dengan menggantikan perkataan “seksyen 48a” dengan perkataan “seksyen 53”. Pindaan seksyen 151"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/5/msa@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/5/msa@/~cl_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/5/msa@/~cl_7__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/5/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 151 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/5/msa@/~cl_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/5/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (1) subseksyen yang berikut: “(1a) Lembaga boleh mengenakan penalti pentadbiran ke atas pembayaran apa-apa fi tahunan yang diterima lewat daripada tarikh ulang tahun yang dinyatakan dalam subseksyen (1).”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/5/msa@/~cl_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2012/5/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2), dengan menggantikan perkataan “Jika” dengan perkataan “Walau apa pun subseksyen (1a), jika”."
      }
    }
  ]
}
