      "schema:name": {
        "@language": "en",
        "@value": "Prison (Amendment) Bill 2013"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2013/14/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2013/14/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Prison (Amendment) Act 2013. Amendment of section 7"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2013/14/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2013/14/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Prison Act 1995 [Act 537], which is referred to as the “principal Act” in this Act, is amended in section 7 by inserting after subsection (1) the following subsection: “(1A) In addition, it shall be lawful for the Minister, by notification in the Gazette, to appoint lock-ups at such police stations and court houses as may be specified in the notification to be places for the confinement of persons remanded under the Prevention of Crime Act 1959 [Act 297].”."
      }
    }
  ]
