      ],
      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Fi (Jabatan Muzium Malaysia) (Pengesahan) 2013"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2013/19/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2013/19/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Fi (Jabatan Muzium Malaysia) (Pengesahan) 2013. Pengesahan dan tanggung rugi"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2013/19/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2013/19/msa@/~cl_2__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2013/19/msa@/~cl_2__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2013/19/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2013/19/msa@/~cl_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2013/19/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun peruntukan Akta Fi 1951 [Akta 209], fi yang telah dikenakan dan dipungut oleh Jabatan Muzium Malaysia berkenaan dengan kemasukan ke mana-mana muzium yang ditadbir atau pameran yang dianjurkan oleh Jabatan Muzium Malaysia semasa tempoh dari 1 Januari 1991 hingga 11 Jun 2012 hendaklah disifatkan telah dikenakan dan dipungut dengan sah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2013/19/msa@/~cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2013/19/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada tindakan atau prosiding undang-undang boleh dibawa, dimulakan atau disenggarakan terhadap Kerajaan Malaysia atau mana-mana pegawai Kerajaan Malaysia atau mana-mana orang yang bertindak di bawahnya berkenaan dengan apa-apa fi yang dikenakan dan dipungut semasa tempoh yang disebut dalam subseksyen (1), dan jika apa-apa tindakan atau prosiding undang-undang sedemikian telah dibawa, dimulakan atau disenggarakan, ia hendaklah dibatalkan dan dijadikan tidak sah dan tiada pembayaran balik berkenaan dengan fi yang telah dikenakan dan dipungut seperti yang dinyatakan dalam Akta ini boleh dibuat."
      }
    }
  ]
}
