      ],
      "schema:name": {
        "@language": "en",
        "@value": "Dangerous Drugs (Amendment) Bill 2013"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2013/20/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2013/20/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Dangerous Drugs (Amendment) Act 2013. Amendment of section 31a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2013/20/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2013/20/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Dangerous Drugs Act 1952 [Act 234], which is referred to as the “principal Act” in this Act, is amended in section 31a by inserting after subsection (1a) the following subsection: “(1aa) Any biological sample collected for the purposes of an examination under this section may be analysed by a science officer employed by the Government.”. Renumbering of section 37a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2013/20/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2013/20/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by renumbering the existing section 37a as section 37b. New section 37a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2013/20/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2013/20/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting before section 37b as renumbered the following section: “Application of presumptions 37a. Notwithstanding anything under any written law or rule of law, a presumption may be applied under this Part in addition to or in conjunction with any other presumption provided under this Part or any other written law.”."
      }
    }
  ]
