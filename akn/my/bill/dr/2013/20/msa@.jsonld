      ],
      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-Undang Dadah Berbahaya (Pindaan) 2013"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2013/20/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2013/20/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Dadah Berbahaya (Pindaan) 2013. Pindaan seksyen 31a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2013/20/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2013/20/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Dadah Berbahaya 1952 [Akta 234], yang disebut “Akta ibu” dalam Akta ini, dipinda dalam seksyen 31a dengan memasukkan selepas subseksyen (1a) subseksyen yang berikut: “(1aa) Any biological sample collected for the purposes of an examination under this section may be analysed by a science officer employed by the Government.”. Penomboran semula seksyen 37a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2013/20/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2013/20/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan menomborkan semula seksyen 37a yang sedia ada sebagai seksyen 37b. Seksyen 37a baru"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2013/20/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2013/20/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memasukkan sebelum seksyen 37b sebagaimana yang dinomborkan semula seksyen yang berikut: “Application of presumptions 37a. Notwithstanding anything under any written law or rule of law, a presumption may be applied under this Part in addition to or in conjunction with any other presumption provided under this Part or any other written law.”."
      }
    }
  ]
