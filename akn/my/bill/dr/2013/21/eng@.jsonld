        "@value": "Supply Bill 2014"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2013/21/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2013/21/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Supply Act 2014. Issue and appropriation for the service of the year 2014"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2013/21/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2013/21/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The issue of a sum not exceeding one hundred and seventy- four billion eight hundred and seven million seven hundred and nine thousand ringgit (RM174,807,709,000) from the Consolidated Fund for the service of the year 2014 is hereby authorised and that sum is appropriated for the purposes specified in the Schedule."
      }
    },
    {
