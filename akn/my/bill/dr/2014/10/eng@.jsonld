      "schema:text": {
        "@language": "en",
        "@value": "in subsection (1), by substituting for the words “Commissioner of Prison” the words “Deputy Commissioner General of Prison”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/10/eng@/~cl_4__para_b",
      "@type": "akn:paragraph",
