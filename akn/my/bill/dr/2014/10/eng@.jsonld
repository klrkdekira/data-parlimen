      "schema:name": {
        "@language": "en",
        "@value": "Section 13 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/10/eng@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
