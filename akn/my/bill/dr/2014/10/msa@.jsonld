      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2), dengan menggantikan perkataan “Komisioner Penjara” dengan perkataan “Timbalan Komisioner Jeneral Penjara”. Pindaan seksyen 13"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/10/msa@/~cl_5",
      "@type": "akn:clause",
