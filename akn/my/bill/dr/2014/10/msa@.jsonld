      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/10/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 11 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/10/msa@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/10/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1), dengan menggantikan perkataan “Komisioner Penjara” dengan perkataan “Timbalan Komisioner Jeneral Penjara”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/10/msa@/~cl_4__para_b",
      "@type": "akn:paragraph",
