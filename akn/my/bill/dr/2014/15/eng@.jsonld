        "@value": "Supply Bill 2015"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/15/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/15/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Supply Act 2015. Issue and appropriation for the service of the year 2015"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/15/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/15/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The issue of a sum not exceeding one hundred and seventy-six billion nine hundred and thirty-one million seven hundred and thirty-one thousand ringgit (RM176,931,731,000) from the Consolidated Fund for the service of the year 2015 is hereby authorised and that sum is appropriated for the purposes specified in the Schedule."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/15/eng@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/15/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Purpose Title B. 1 Parliament B. 2 Office of the Keeper of the Rulers’ Seal B. 3 National Audit Department B. 4 Election Commission B. 5 Public Services Commission B. 6 Prime Minister’s Department B. 7 Public Service Department B. 8 Attorney General’s Chambers B. 9 Malaysian Anti-Corruption Commission B. 10 Treasury B. 11 Treasury General Services B. 12 Contribution to Statutory Funds B. 13 Ministry of Foreign Affairs B. 20 Ministry of Plantation Industries and Commodities B. 21 Ministry of Agriculture and Agro-Based Industry B. 22 Ministry of Rural and Regional Development B. 23 Ministry of Natural Resources and Environment B. 24 Ministry of International Trade and Industry B. 25 Ministry of Domestic Trade, Co-operatives and Consumerism B. 27 Ministry of Works B. 28 Ministry of Transport B. 29 Ministry of Energy, Green Technology and Water Purpose Title B. 30 Ministry of Science, Technology and Innovation B. 31 Ministry of Tourism and Culture B. 32 Ministry of the Federal Territories B. 40 Education Service Commission B. 42 Ministry of Health B. 43 Ministry of Urban Wellbeing, Housing and Local Government B. 45 Ministry of Youth and Sports B. 46 Ministry of Human Resources B. 47 Ministry of Communications and Multimedia B. 48 Ministry of Women, Family and Community Development B. 60 Ministry of Defence B. 62 Ministry of Home Affairs B. 63 Education B. 64 Higher Education TOTAL"
      }
    }
