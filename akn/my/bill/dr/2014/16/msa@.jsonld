      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/16/msa@/~cl_18__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/16/msa@/~cl_18__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/16/msa@/~cl_18__subsec_3",
