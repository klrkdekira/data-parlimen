      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/16/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif “Menteri” takrif yang berikut: ‘ “Pendaftar” ertinya Pendaftar yang ditetapkan di bawah subseksyen 20a(1);’; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/16/msa@/~cl_2__para_d",
      "@type": "akn:paragraph",
