      "schema:text": {
        "@language": "ms",
        "@value": "dalam subperenggan (iv), dengan memotong perkataan “and” di hujung subperenggan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/19/msa@/~chp_II__cl_9__para_d__subpara_i__subpara_C",
      "@type": "akn:subparagraph",
      "eli:number": "C",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/19/msa@/~chp_II__cl_9__para_d__subpara_i",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subperenggan (v) subperenggan yang berikut: “(vi) the amount of actuarial surplus from the family fund that is transferred to the shareholders’ fund; and”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/19/msa@/~chp_II__cl_9__para_d__subpara_ii",
      "@type": "akn:subparagraph",
