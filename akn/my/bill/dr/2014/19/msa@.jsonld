      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 11, 13 dan 14, perenggan 15(a), seksyen 17, 18 dan 19, subsubperenggan 20(a)(iv)(A) dan perenggan 22(a) mula berkuat kuasa apabila berkuatkuasanya Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/19/msa@/~chp_II__cl_3__subsec_3",
