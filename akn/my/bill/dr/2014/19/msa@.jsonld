      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/19/msa@/~chp_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan 15(b) mula berkuat kuasa pada 1 Januari 2015. Pindaan seksyen 5"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/19/msa@/~chp_II__cl_4",
