      "schema:text": {
        "@language": "ms",
        "@value": "dalam subperenggan (iii), dengan menggantikan perkataan “family fund, general fund, inward re-takaful fund, offshore fund or family re-takaful fund” dengan perkataan “general fund, inward re-takaful fund, offshore fund or family re-takaful fund, or any other fee receivable in respect of an investment fund from the family fund”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/19/msa@/~chp_II__cl_9__para_d__subpara_i__subpara_B",
