      "schema:name": {
        "@language": "ms",
        "@value": "Jadual 1 kepada Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/19/msa@/~chp_II__cl_20__para_a",
