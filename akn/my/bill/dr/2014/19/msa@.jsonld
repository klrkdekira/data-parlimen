      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/19/msa@/~chp_II__cl_9__para_d__subpara_ii__subpara_A",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/19/msa@/~chp_II__cl_9__para_d__subpara_ii__subpara_B"
      ],
