        "@value": "dalam perenggan (a)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/19/msa@/~chp_II__cl_9__para_d__subpara_i__subpara_A",
