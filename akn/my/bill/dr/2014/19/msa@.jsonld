      "schema:text": {
        "@language": "ms",
        "@value": "dalam Bahagian I—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/19/msa@/~chp_II__cl_20__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/19/msa@/~chp_II__cl_20__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perenggan 1 dengan perenggan yang berikut: “1. Except where paragraphs 1a, 2, 2a, 2d, 3 and 4 provide otherwise, income tax shall be charged for a year of assessment upon the chargeable income of every person at the following rates: Chargeable Income RM Rate of Income Tax For every ringgit of the 5,000 0 per cent first For every ringgit of the 15,000 1 per cent next For every ringgit of the 15,000 5 per cent next For every ringgit of the 15,000 10 per cent next For every ringgit of the 20,000 16 per cent next For every ringgit of the 30,000 21 per cent next For every ringgit of the 150,000 24 per cent next For every ringgit of the 150,000 24.5 per cent next For every ringgit 400,000 25 per cent”; exceeding"
      }
