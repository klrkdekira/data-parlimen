      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong proviso kepada subseksyen itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/19/msa@/~chp_II__cl_4__para_b",
