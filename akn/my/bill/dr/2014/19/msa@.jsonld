      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (1) subseksyen yang berikut: “(1a) For the purpose of ascertaining the chargeable income of a person under subsection (1), any amount or income received by that person which is subject to deduction of tax under section 109c, 109e or 109g shall be excluded.”. Pindaan seksyen 29"
      }
    },
