        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/22/msa@/~cl_35__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/22/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/22/msa@/~cl_35__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/22/msa@/~cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "A firm or body corporate practising as a consulting Quantity Surveyor under the principal Act, before the date of the coming into operation of this Act, may continue to practise, carry on business or take up employment in quantity surveying services until the expiry of the certificate of registration issued under the principal Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/22/msa@/~cl_35__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/22/msa@/~cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "For the purposes of subsection (1), the provisions relating to a firm or body corporate practising as a consulting Quantity Surveyor under the principal Act shall continue to apply as if those provisions of the principal Act had not been amended by this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/22/msa@/~cl_35__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/22/msa@/~cl_35__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/22/msa@/~cl_35__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/22/msa@/~cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "Any registered Quantity Surveyor under the principal Act who—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/22/msa@/~cl_35__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/22/msa@/~cl_35__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "on the date of the coming into operation of this Act, has been registered for a period of not less than five years shall be deemed to be registered as a Consultant Quantity Surveyor; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/22/msa@/~cl_35__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/22/msa@/~cl_35__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "on the date of the coming into operation of this Act, has been registered for a period of less than five years shall be deemed to be registered as a Professional Quantity Surveyor."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/22/msa@/~cl_35__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/22/msa@/~cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "Any registered Quantity Surveyor deemed to be registered as a Consultant Quantity Surveyor under paragraph (3)(a) and any registered Quantity Surveyor deemed to be registered as a Professional Quantity Surveyor under paragraph (3)(b) shall continue to practise, carry on business or take up employment in quantity surveying services until the expiry of the certificate of registration issued under the principal Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/22/msa@/~cl_35__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/22/msa@/~cl_35__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/22/msa@/~cl_35__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/22/msa@/~cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "Any person deemed to be a registered Professional Quantity Surveyor under paragraph (3)(b) may apply to be registered as a Consultant Quantity Surveyor—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/22/msa@/~cl_35__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/22/msa@/~cl_35__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "within five years from the date of coming into operation of this Act provided that he has been registered for a period of not less than five years and has acquired working experience during that period; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/22/msa@/~cl_35__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/22/msa@/~cl_35__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "if the person has passed an examination as may be determined by the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/22/msa@/~cl_35__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/22/msa@/~cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "Any registered graduate Quantity Surveyor and temporary registered Quantity Surveyor under the principal Act shall, on the date of the coming into operation of this Act, be deemed to be registered as a Provisional Quantity Surveyor."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/22/msa@/~cl_35__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/22/msa@/~cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "Any registered graduate Quantity Surveyor and temporary registered Quantity Surveyor deemed to be registered as a Provisional Quantity Surveyor under subsection (6) shall continue to practise, carry on business or take up employment in quantity surveying services until the expiry of the certificate of registration issued under the principal Act."
      }
    },
