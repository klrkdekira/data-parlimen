      "schema:text": {
        "@language": "ms",
        "@value": "by inserting before the definition of “architectural consultancy services” the following definition: ‘ “Architect” has the same meaning assigned to it in the Architects Act 1967 [Act 117];’;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/22/msa@/~cl_2__para_b",
