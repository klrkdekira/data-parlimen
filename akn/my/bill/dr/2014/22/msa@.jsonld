      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/22/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Section 18 of the principal Act is amended by substituting for the words “registered, registered graduate or temporary registered Quantity Surveyor or firm or body corporate practising as consulting Quantity Surveyors” the words “Consultant Quantity Surveyor, Professional Quantity Surveyor, Provisional Quantity Surveyor, Quantity Surveying Technologist or Consulting Quantity Surveying Practice”. Amendment of section 19"
      }
    },
