      "schema:text": {
        "@language": "ms",
        "@value": "by inserting after the word “hearing” the words “by the Disciplinary Committee”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/22/msa@/~cl_9__para_i__subpara_ii__subpara_i__subpara_iii__subpara_B",
