      "schema:text": {
        "@language": "ms",
        "@value": "The Quantity Surveyors Act 1967 [Act 487], which is referred to as the “principal Act” in this Act, is amended in section 2—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/22/msa@/~cl_20",
