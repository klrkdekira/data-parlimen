      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/22/msa@/~cl_9__para_i__subpara_ii__subpara_i__subpara_iii",
      "schema:text": {
        "@language": "ms",
        "@value": "by substituting for subparagraph (ii) the following subparagraph: “(ii) in the case of a partnership or body corporate, by the partner or director who at the material time was responsible for the act or thing which forms the grounds of the complaint and the partner or director may be assisted by counsel.”;"
      }
    },
