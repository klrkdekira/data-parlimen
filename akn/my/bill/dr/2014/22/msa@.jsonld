      "schema:text": {
        "@language": "ms",
        "@value": "in subparagraph (i), by deleting the words “or counsel”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/22/msa@/~cl_9__para_i__subpara_ii__subpara_i__subpara_iii__subpara_C",
