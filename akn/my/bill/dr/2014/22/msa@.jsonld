      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/22/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "by inserting after subsection (2) the following subsection: “(3) A person is not allowed to practise as a consulting Quantity Surveyor, or to collect any fee, charge, remuneration or other form of consideration for any professional advice or services rendered, unless the person has obtained a permit to practise as a Consulting Quantity Surveying Practice approved by the Board under section 7a or 7b.”. Amendment of section 7a"
      }
    },
