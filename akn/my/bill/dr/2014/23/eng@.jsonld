      "schema:name": {
        "@language": "en",
        "@value": "Members of Parliament (Remuneration) (Amendment) Bill 2014"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/23/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/23/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/23/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/23/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/23/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/23/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Members of Parliament (Remuneration) (Amendment) Act 2014."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/23/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/23/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on 1 January 2015. Amendment of section 3"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/23/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/23/eng@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/23/eng@/~cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/23/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Members of Parliament (Remuneration) Act 1980 [Act 237], which is referred to as the “principal Act” in this Act, is amended in subsection 3(1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/23/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/23/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (a), by substituting for the words “four thousand one hundred and twelve ringgit and seventy- nine sen” the words “seven thousand ringgit”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/23/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/23/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (b), by substituting for the words “six thousand five hundred and eight ringgit and fifty-nine sen” the words “eleven thousand ringgit”. Amendment of section 4"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/23/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/23/eng@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/23/eng@/~cl_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/23/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 4 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/23/eng@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/23/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraphs (a) and (b), by substituting for the words “fourteen thousand nine hundred and seven ringgit and twenty sen” the words “twenty thousand ringgit”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/23/eng@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/23/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraphs (c) and (d), by substituting for the words “ten thousand eight hundred and forty-seven ringgit and sixty-five sen” the words “sixteen thousand ringgit”. Payment of salaries and allowances notwithstanding section 7"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/23/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/23/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding section 7 of the principal Act, the monthly salaries and allowances specified in the amendments to sections 3 and 4 of the principal Act in sections 2 and 3 of this Act, and payable, shall commence from 1 January 2015 or from the date of appointment or election, whichever is the later, of the Members of Parliament, the President or Deputy President of the Senate and the Speaker or Deputy Speakers of the House of Representatives, as the case may be."
      }
    }
  ]
}
