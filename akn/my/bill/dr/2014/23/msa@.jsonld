      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-undang Ahli Parlimen (Saraan) (Pindaan) 2014"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/23/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/23/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/23/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/23/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/23/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/23/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Ahli Parlimen (Saraan) (Pindaan) 2014."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/23/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/23/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada 1 Januari 2015. Pindaan seksyen 3"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/23/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/23/msa@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/23/msa@/~cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/23/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Ahli Parlimen (Saraan) 1980 [Akta 237], yang disebut “Akta ibu” dalam Akta ini, dipinda dalam subseksyen 3(1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/23/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/23/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (a), dengan menggantikan perkataan “empat ribu satu ratus dua belas ringgit dan tujuh puluh sembilan sen” dengan perkataan “tujuh ribu ringgit”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/23/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/23/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (b), dengan menggantikan perkataan “enam ribu lima ratus lapan ringgit dan lima puluh sembilan sen” dengan perkataan “sebelas ribu ringgit”. Pindaan seksyen 4"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/23/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/23/msa@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/23/msa@/~cl_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/23/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 4 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/23/msa@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/23/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (a) dan (b), dengan menggantikan perkataan “empat belas ribu sembilan ratus tujuh ringgit dan dua puluh sen” dengan perkataan “dua puluh ribu ringgit”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/23/msa@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/23/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (c) dan (d), dengan menggantikan perkataan “sepuluh ribu lapan ratus empat puluh tujuh ringgit dan enam puluh lima sen” dengan perkataan “enam belas ribu ringgit”. Pembayaran gaji dan elaun walau apa pun seksyen 7"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/23/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/23/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun seksyen 7 Akta ibu, gaji dan elaun bulanan yang dinyatakan dalam pindaan kepada seksyen 3 dan 4 Akta ibu dalam seksyen 2 dan 3 Akta ini, dan yang kena dibayar, hendaklah bermula dari 1 Januari 2015 atau dari tarikh pelantikan atau pemilihan, mengikut mana-mana yang terkemudian, Ahli Parlimen, Yang di-Pertua atau Timbalan Yang di-Pertua Dewan Negara dan Yang di-Pertua atau Timbalan Yang di-Pertua Dewan Rakyat, mengikut mana-mana yang berkenaan."
      }
    }
  ]
}
