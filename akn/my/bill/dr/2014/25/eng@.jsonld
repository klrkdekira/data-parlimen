      "schema:name": {
        "@language": "en",
        "@value": "Netting Of Financial Agreements Bill 2014"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/25/eng@/~part_I",
      "@type": "akn:part",
