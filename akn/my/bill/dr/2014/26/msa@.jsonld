      ],
      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-undang Perhubungan Perusahaan (Pindaan) 2014"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/26/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/26/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/26/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/26/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/26/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/26/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Perhubungan Perusahaan (Pindaan) 2014."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/26/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/26/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta. Pindaan seksyen 2a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/26/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/26/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Perhubungan Perusahaan 1967 [Akta 177], yang disebut “Akta ibu” dalam Akta ini, dipinda dalam perenggan 2a(2)(b) dengan menggantikan perkataan “Principal Assistant Directors of Industrial Relations,” dengan perkataan “Deputy Directors of Industrial Relations, Principal Assistant Directors of Industrial Relations, Senior Assistant Directors of Industrial Relations,”. Penggantian seksyen 23a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/26/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/26/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan menggantikan seksyen 23a dengan seksyen yang berikut: “Qualification of President and Chairman of Industrial Court 23a. A person is qualified for appointment as President under paragraph 21(1)(a) and as Chairman under subsection 23(2) if, for the seven years preceding his appointment, he has been— (a) an advocate and solicitor within the meaning of the Legal Profession Act 1976 [Act 166]; (b) an advocate within the meaning of the Advocates Ordinance of Sabah [Sabah Cap. 2]; (c) an advocate within the meaning of the Advocates Ordinance of Sarawak [Sarawak Cap. 110]; or (d) a member of the judicial and legal service of the Federation or of the legal service of a State, or sometimes one and sometimes another.”. Pindaan seksyen 56"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/26/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/26/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 56(4) Akta ibu dipinda dengan menggantikan perkataan “may, at the request of either party, send a certified copy thereof” dengan perkataan “shall, at the request of either party, send a certified copy of the order expeditiously and where practicable within seven days from the date of request”."
      }
    }
  ]
}
