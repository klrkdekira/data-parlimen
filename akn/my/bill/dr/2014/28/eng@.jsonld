      "schema:text": {
        "@language": "en",
        "@value": "in subsection (2)— Amendment of section 26"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/28/eng@/~cl_4__para_b__subpara_i",
