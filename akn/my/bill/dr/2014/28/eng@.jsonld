      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words “two hundred and fifty thousand” the words “two million”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/28/eng@/~cl_4__para_b__subpara_ii",
