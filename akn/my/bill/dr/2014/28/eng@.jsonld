      "schema:text": {
        "@language": "en",
        "@value": "in subsection (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/28/eng@/~cl_4__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/28/eng@/~cl_4__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words “one hundred thousand” the words “one million”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/28/eng@/~cl_4__para_a__subpara_ii",
