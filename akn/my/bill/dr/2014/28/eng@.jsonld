      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words “two hundred and fifty thousand” the words “three million”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/28/eng@/~cl_4__para_b",
      "@type": "akn:paragraph",
