      "schema:name": {
        "@language": "en",
        "@value": "Control of Supplies (Amendment) Bill 2014"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/28/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/28/eng@/~cl_1__subsec_1",
