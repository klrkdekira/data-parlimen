      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/28/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 26 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/28/msa@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/28/msa@/~cl_5__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/28/msa@/~cl_5__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/28/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1)— “(a) any controlled article, in respect of which the offence has been committed, which has been seized by or has otherwise come into the possession of the Controller or any person acting under his authority;”; dan “(aa) any property of the accused, vehicle, vessel or other article, by means of which the offence has been committed or which is intended to be used for the commission of an offence against this Act; or”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/28/msa@/~cl_5__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/28/msa@/~cl_5__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perenggan (a) dengan perenggan yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/28/msa@/~cl_5__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/28/msa@/~cl_5__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan (a) perenggan yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/28/msa@/~cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/28/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2), dengan memasukkan selepas perkataan “proceeds of sale,” perkataan “property of the accused,”."
      }
    }
  ]
