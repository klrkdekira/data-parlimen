      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/28/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2)— Pindaan seksyen 26"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/28/msa@/~cl_4__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/28/msa@/~cl_4__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “two hundred and fifty thousand” dengan perkataan “two million”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/28/msa@/~cl_4__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/28/msa@/~cl_4__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “five hundred thousand” dengan perkataan “five million”."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/28/msa@/~cl_5",
      "@type": "akn:clause",
