      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_7__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_7__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh dilantik sebagai Pentabdir melainkan jika dia—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_7__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "ialah orang sebenar; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_7__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah bersetuju secara bertulis mengenai pelantikannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_7__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_7__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Orang yang berikut layak untuk dilantik sebagai Pentadbir:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_7__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_7__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang juruaudit syarikat yang diluluskan di bawah Akta Syarikat 1965; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_7__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_7__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang yang, pada pendapat pelantik, berupaya untuk melaksanakan tugas pentadbir."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_7__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_7__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_7__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_7__subsec_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_7__subsec_3__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_7__subsec_3__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_7__subsec_3__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Orang yang berikut tidak layak untuk dilantik sebagai Pentadbir:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_7__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_7__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang bankrap belum lepas;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_7__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_7__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang pemegang gadai janji mana-mana harta Syarikat yang Ditadbir;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_7__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_7__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang yang mempunyai pemegangan syer secara langsung atau tidak langsung dalam Syarikat yang Ditadbir;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_7__subsec_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_7__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang yang, secara langsung atau tidak langsung, mempunyai kepentingan dalam apa-apa kontrak atau perkiraan untuk membekalkan barangan atau perkhidmatan kepada Syarikat yang Ditadbir;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_7__subsec_3__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_7__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang juruaudit Syarikat yang Ditadbir; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_7__subsec_3__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_7__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang pegawai Syarikat yang Ditadbir. pemberitahuan pelantikan pentadbir"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
