        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10__para_o",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10__para_p",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10__para_q",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10__para_r",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10__para_s",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10__para_t",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10__para_u",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10__para_v",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10__para_w",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10__para_x"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam melaksanakan fungsinya di bawah seksyen 9, Pentadbir hendaklah mempunyai kuasa yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menjalankan perniagaan Syarikat yang Ditadbir;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk melakukan semua benda (termasuk melaksanakan kerja) sebagaimana yang perlu untuk menguruskan, merealisasikan dan memelihara harta, usaha dan hal ehwal Syarikat yang Ditadbir;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk melantik mana-mana orang sebagai pengarah mana-mana Syarikat yang Ditadbir, sama ada untuk mengisi kekosongan atau selainnya, dan untuk menyingkirkan atau menggantung mana-mana pengarah Syarikat yang Ditadbir daripada jawatan walau apa pun Memorandum dan Artikel Persatuan atau mana-mana undang-undang yang lain;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengambil milikan harta Syarikat yang Ditadbir dan bagi maksud itu, untuk mengambil apa-apa prosiding yang difikirkannya suai manfaat;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menjual atau selainnya melupuskan semua atau sebahagian daripada harta, perniagaan, usaha atau harta Syarikat yang Ditadbir melalui lelongan awam atau kontrak persendirian;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mendapatkan atau meminjam wang dan mencagarkan harta Syarikat yang Ditadbir bagi pemerdapatan atau peminjaman wang itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk melantik seorang peguam cara atau akauntan, atau seorang berkelayakan profesional yang lain untuk membantunya dalam pelaksanaan fungsinya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk membawa atau membela apa-apa tindakan atau prosiding undang-undang yang lain atas nama dan bagi pihak Syarikat yang Ditadbir;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk merujuk kepada suatu timbang tara apa-apa persoalan yang menyentuh Syarikat yang Ditadbir;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengambil dan mengekalkan insurans berkenaan dengan harta Syarikat yang Ditadbir;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menggunakan meterai perbadanan Syarikat yang Ditadbir;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10__para_l",
      "@type": "akn:paragraph",
      "eli:number": "l",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk melakukan semua perbuatan dan untuk menyempurnakan atas nama dan bagi pihak Syarikat yang Ditadbir apa-apa surat ikatan, resit atau dokumen lain;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10__para_m",
      "@type": "akn:paragraph",
      "eli:number": "m",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengeluarkan, menerima, membuat dan mengendors apa-apa bil pertukaran atau nota janji hutang atas nama dan bagi pihak Syarikat yang Ditadbir;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10__para_n",
      "@type": "akn:paragraph",
      "eli:number": "n",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengambil kerja atau memecat pekerja, dan untuk menentukan pampasan yang kena dibayar kepada pekerja yang dipecat itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10__para_o",
      "@type": "akn:paragraph",
      "eli:number": "o",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memindahkan mana-mana harta, perniagaan, tanggungan dan hal ehwal Syarikat yang Ditadbir kepada Malaysia Airlines Berhad atau mana-mana syarikat subsidiari Malaysia Airlines Berhad;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10__para_p",
      "@type": "akn:paragraph",
      "eli:number": "p",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk membeli syer, harta dan kelengkapan mana-mana syarikat, yang Syarikat yang Ditadbir merupakan pemegang syer yang sedia ada dalamnya, yang membekalkan barangan atau perkhidmatan atau kedua-duanya yang penting untuk memastikan perniagaan yang terletak hak atau akan terletak hak pada Malaysia Airlines Berhad menurut Bahagian V diteruskan tanpa gangguan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10__para_q",
      "@type": "akn:paragraph",
      "eli:number": "q",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memberikan atau menerima penyerahan balik suatu pajakan atau sewaan harta Syarikat yang Ditadbir, dan untuk mengambil suatu pajakan atau sewaan apa-apa harta yang dikehendaki atau sesuai bagi Syarikat yang Ditadbir;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10__para_r",
      "@type": "akn:paragraph",
      "eli:number": "r",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk membuat panggilan ke atas mana-mana modal yang belum dipanggil bagi Syarikat yang Ditadbir, mengubah atau mengurangkan semua atau sebahagian daripada modal syer Syarikat yang Ditadbir;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10__para_s",
      "@type": "akn:paragraph",
      "eli:number": "s",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memberi taraf dan menuntut dalam kebankrapan, ketidaksolvenan atau penyelesaian mana-mana orang yang berhutang dengan Syarikat yang Ditadbir dan untuk menerima dividen, dan untuk menyertai surat ikatan amanah bagi pemiutang mana-mana orang itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10__para_t",
      "@type": "akn:paragraph",
      "eli:number": "t",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengemukakan atau membela suatu petisyen untuk penggulungan Syarikat yang Ditadbir;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10__para_u",
      "@type": "akn:paragraph",
      "eli:number": "u",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menukar lokasi mana-mana pejabat berdaftar Syarikat yang Ditadbir;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10__para_v",
      "@type": "akn:paragraph",
      "eli:number": "v",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk melantik mana-mana ejen untuk membuat apa-apa urusan yang tidak dapat dibuat oleh Pentadbir sendiri atau yang boleh dibuat dengan lebih mudah oleh seorang ejen;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10__para_w",
      "@type": "akn:paragraph",
      "eli:number": "w",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk membuat apa-apa pembayaran yang perlu atau bersampingan dengan pelaksanaan fungsinya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10__para_x",
      "@type": "akn:paragraph",
      "eli:number": "x",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk melakukan segala benda lain yang bersampingan dengan pelaksanaan fungsi Pentadbir. kesan pelantikan pentadbir"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_1__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila Pentadbir dilantik, suatu moratorium hendaklah berkuat kuasa yang dalam tempoh itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tiada petisyen bagi penggulungan Syarikat yang Ditadbir boleh difailkan oleh mana-mana orang dalam mana-mana mahkamah;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tiada ketetapan boleh diluluskan atau perintah dibuat bagi penggulungan Syarikat yang Ditadbir;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tiada penerima, penerima dan pengurus atau penyelesai sementara, boleh dilantik, atau jika dilantik, pelantikannya hendaklah terhenti dengan serta-merta dan dia hendaklah mengosongkan jawatannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_1__para_d__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_1__para_d__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_1__para_d__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_1__para_d__subpara_iv"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tiada langkah boleh diambil—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_1__para_d__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_1__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mewujudkan, menyempurnakan atau menguatkuasakan apa-apa cagaran ke atas apa-apa harta Syarikat yang Ditadbir;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_1__para_d__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_1__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menguatkuasakan suatu penghakiman ke atas apa-apa harta Syarikat yang Ditadbir;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_1__para_d__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_1__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memiliki semula apa-apa harta dalam milikan, jagaan atau kawalan Syarikat yang Ditadbir; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_1__para_d__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_1__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menolak apa-apa hutang yang terhutang kepada Syarikat yang Ditadbir berkenaan dengan apa-apa tuntutan terhadap Syarikat yang Ditadbir, kecuali dengan persetujuan bertulis Pentadbir terlebih dahulu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tiada prosiding dan tiada pelaksanaan atau proses undang-undang yang lain dalam mana-mana mahkamah atau tribunal boleh dimulakan atau diteruskan, dan tiada distres boleh dilevikan, terhadap Syarikat yang Ditadbir atau hartanya kecuali dengan persetujuan bertulis Pentadbir terlebih dahulu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa permohonan yang dibuat di bawah seksyen 176 Akta Syarikat 1965 hendaklah ditangguhkan sine die dan apa-apa perintah sekatan yang dikeluarkan di bawah subseksyen 176(10) Akta Syarikat 1965 hendaklah dilepaskan dan diketepikan dengan serta-merta; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tiada prosiding dan tiada pelaksanaan atau proses undang-undang yang lain dalam mana-mana mahkamah atau tribunal boleh dimulakan, atau diteruskan, terhadap mana-mana orang yang menyediakan jaminan atau yang bertindak sebagai penjamin bagi tanggungan Syarikat yang Ditadbir berkenaan dengan tanggungan itu kecuali dengan persetujuan bertulis Pentadbir terlebih dahulu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Pentadbir tidak akan bertanggungan bagi sesuatu tindakan atau ganti rugi lain berkenaan dengan keengganan untuk memberikan persetujuannya di bawah subseksyen (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_3__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_3__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_3__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_3__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Pelantikan Pentadbir tidak boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dianggap sebagai meletakkan Pentadbir atau Syarikat yang Ditadbir dalam keadaan yang melanggari atau memungkiri mana-mana kontrak, atau melakukan pecah kepercayaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_3__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_3__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_3__para_b__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_3__para_b__subpara_iv"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dianggap sebagai meletakkan Syarikat yang Ditadbir dalam keadaan yang melanggari atau memungkiri mana-mana kontrak atau dianggap sebagai menimbulkan hak atau kewajipan bagi mana-mana orang untuk—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_3__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_3__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "menamatkan, membatalkan atau mengubahsuaikan sesuatu perjanjian;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_3__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_3__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "menguatkuasakan atau mempercepat pelaksanaan sesuatu obligasi Syarikat yang Ditadbir;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_3__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_3__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "menghendaki pelaksanaan sesuatu obligasi yang tidak selainnya berbangkit untuk pelaksanaan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_3__para_b__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_3__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "enggan atau menghentikan pelaksanaan obligasinya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dianggap sebagai meletakkan Pentadbir atau Syarikat yang Ditadbir dalam keadaan yang melanggari mana-mana undang-undang atau perjanjian yang melarang, menyekat atau mengawal selia penyerahhakan, penjualan, pelupusan atau pemindahan apa-apa harta atau penzahiran maklumat;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "melepaskan seorang penjamin daripada sesuatu obligasi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_3__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "menidaksahkan atau melepaskan sesuatu kontrak atau cagaran;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_3__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dianggap sebagai menamatkan, membatalkan atau mengubah apa-apa hak, keistimewaan, pengecualian atau keutamaan berhubung dengan harta Syarikat yang Ditadbir; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_3__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dianggap sebagai meletakkan Syarikat yang Ditadbir atau Pentadbir dalam keadaan yang melanggari mana-mana undang-undang atau apa-apa perintah mana-mana mahkamah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada apa-apa jua dalam seksyen ini boleh menghalang apa-apa prosiding sivil atau jenayah daripada dimulakan atau diteruskan oleh mana-mana badan kawal selia terhadap Syarikat yang Ditadbir. Moratorium"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_12__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_12__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Tempoh moratorium yang disebut dalam seksyen 11, melainkan jika pentadbiran itu terlebih dahulu ditamatkan di bawah seksyen 6 atau perenggan 21(3)(c), hendaklah selama suatu tempoh dua belas bulan bermula dari tarikh pelantikan Pentadbir di bawah subseksyen 5(1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, atas permintaan bertulis Pentadbir atau pelantik, melanjutkan moratorium bagi suatu tempoh tidak lebih daripada dua belas bulan selepas berpuas hati bahawa hal keadaan itu mewajarkan pelanjutan itu, dan kuasa pelanjutan sedemikian tidak boleh dilakukan lebih daripada sekali."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_12__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika tempoh moratorium dilanjutkan menurut subseksyen (2), Pentadbir hendaklah menyebabkan supaya notis pelanjutan itu disiarkan dalam sekurang-kurangnya dua akhbar harian kebangsaan, salah satu daripadanya hendaklah dalam bahasa kebangsaan. keutamaan yang tidak wajar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_13__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Selepas pelantikan Pentadbir, apa-apa pemindahan, gadai janji, pelaksanaan, penahanan, obligasi, penyelesaian, gadaian, penyerahhakan, penghantaran barangan, pembayaran atau perbuatan lain yang berhubungan dengan apa-apa harta yang dibuat, ditanggung atau dilakukan oleh atau terhadap Syarikat yang Ditadbir yang, jika pemindahan, gadai janji, pelaksanaan, penahanan, obligasi, penyelesaian, gadaian, penyerahhakan, penghantaran barangan, pembayaran atau perbuatan itu dibuat, ditanggung atau dilakukan oleh atau terhadap orang perseorangan, akan menjadi batal atau boleh batal jika dilakukan semasa dia dalam keadaan bankrap di bawah undang-undang kebankrapan, boleh dielakkan atau didapatkan kembali oleh Pentadbir."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika sebutan dibuat dalam undang-undang kebankrapan mengenai suatu tarikh bagi maksud untuk menentukan kesan kebankrapan ke atas transaksi yang disebut dalam subseksyen (1), tarikh itu hendaklah tarikh Akta ini mula berkuat kuasa. perkhidmatan peralihan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_14__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_14__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_14__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_14__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_14__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada subseksyen (2), jika mana-mana orang terikat di bawah suatu kontrak atau mempunyai obligasi untuk membekalkan barangan atau perkhidmatan atau kedua-duanya kepada Syarikat yang Ditadbir, Pentadbir boleh mengarahkan orang itu untuk membekalkan barangan atau perkhidmatan atau kedua-duanya kepada Malaysia Airlines Berhad dan syarikat subsidiarinya dan bukan kepada Syarikat yang Ditadbir, dan Malaysia Airlines Berhad dan syarikat subsidiarinya hendaklah membayar bagi barangan atau perkhidmatan itu atau kedua-duanya pada kadar yang sama yang sepatutnya dibayar oleh Syarikat yang Ditadbir."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Arahan oleh Pentadbir di bawah subseksyen (1) hendaklah diberikan hanya bagi maksud memastikan bahawa perkhidmatan Malaysia Airlines Berhad dan syarikat subsidiarinya tidak terganggu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_14__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_14__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_14__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "walau apa pun mana-mana peruntukan Akta ini yang lain atau mana-mana undang-undang lain, jika pemberi perkhidmatan peralihan tidak mematuhi arahan Pentadbir di bawah subseksyen (1), Menteri boleh, jika difikirkannya perlu demi kepentingan awam, melalui perintah yang disiarkan dalam Warta, mengarahkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_14__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_14__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Pentadbir atau mana-mana orang lain untuk mengambil alih kawalan keseluruhan atau sebahagian daripada harta, perniagaan dan hal ehwal pemberi perkhidmatan peralihan dan untuk menjalankan keseluruhan atau sebahagian daripada perniagaan dan hal ehwal pemberi perkhidmatan peralihan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_14__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_14__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "supaya perbelanjaan Pentadbir atau orang lain itu, mengikut mana-mana yang berkenaan, dibayar daripada aset pemberi perkhidmatan peralihan itu mendahului semua tuntutan lain sama ada bercagar atau tidak bercagar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_14__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Penentuan tentang apa yang merupakan kepentingan awam hendaklah dibuat oleh Menteri dan penentuan itu adalah muktamad dan mengikat semua orang."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_14__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan Bahagian III, seksyen ini tidak akan menyentuh hak dan kelayakan pemberi perkhidmatan peralihan untuk mendapatkan apa-apa hutang yang sedia ada yang terhutang oleh Syarikat yang Ditadbir kepada pemberi perkhidmatan peralihan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_14__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Tidak menjadi prasyarat bahawa Malaysia Airlines Berhad dan syarikat subsidiarinya hendaklah membayar terlebih dahulu apa-apa hutang yang sedia ada yang terhutang oleh Syarikat yang Ditadbir kepada pemberi perkhidmatan peralihan sebelum menerima apa-apa barangan atau perkhidmatan atau kedua-duanya di bawah subseksyen (1). kesan pengambilalihan kawalan pemberi perkhidmatan peralihan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_15__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_15__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_15__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_15__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_15__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_15__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_15__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika kawalan pemberi perkhidmatan peralihan telah diambil alih di bawah suatu perintah yang dibuat di bawah seksyen 14, pemberi perkhidmatan peralihan dan pegawainya hendaklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_15__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_15__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "memberikan kawalan ke atas hartanya, perniagaannya dan hal ehwalnya kepada Pentadbir atau orang lain itu, mengikut mana-mana yang berkenaan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_15__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_15__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "memberikan kepada Pentadbir atau orang lain itu, mengikut mana-mana yang berkenaan, semua kemudahan sebagaimana yang dikehendaki untuk menjalankan perniagaan dan hal ehwal pemberi perkhidmatan peralihan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Pentadbir atau orang lain itu, mengikut mana-mana yang berkenaan, hendaklah terus mengawal harta itu, perniagaan dan hal ehwal pemberi perkhidmatan peralihan itu dan menjalankan perniagaan dan hal ehwal pemberi perkhidmatan peralihan itu atas nama dan bagi pihak pemberi perkhidmatan peralihan itu sehingga bila-bila masa apabila perintah itu dibatalkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_15__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_15__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_15__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_15__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam tempoh sesuatu perintah yang dibuat di bawah seksyen 14 sedang berkuat kuasa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_15__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_15__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "semua kuasa pemberi perkhidmatan peralihan dan pegawainya di bawah dokumen konstituen pemberi perkhidmatan peralihan, atau yang boleh dijalankan oleh pemberi perkhidmatan peralihan atau pegawainya di bawah mana-mana undang-undang bertulis, hendaklah terletak hak pada Pentadbir atau orang lain, mengikut mana-mana yang berkenaan, tidak kira sama ada kuasa itu boleh dijalankan melalui ketetapan, ketetapan khas atau mengikut apa-apa cara lain dan apa-apa kesulitan yang berbangkit daripada peletakhakan itu boleh diselesaikan oleh Menteri melalui arahan secara bertulis;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_15__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_15__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "tiada pegawai pemberi perkhidmatan peralihan boleh, sama ada secara langsung atau secara tidak langsung, terlibat dalam apa-apa aktiviti berhubung dengan pemberi perkhidmatan peralihan itu, kecuali sebagaimana yang dikehendaki atau dibenarkan oleh Pentadbir atau orang lain itu, mengikut mana-mana yang berkenaan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_15__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_15__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Pentadbir atau orang lain itu, mengikut mana-mana yang berkenaan, hendaklah menjalankan kuasa pemberi perkhidmatan peralihan yang terletak hak padanya untuk menjamin penghantaran barangan atau perkhidmatan atau kedua-duanya kepada Malaysia Airlines Berhad dan syarikat subsidiarinya dan tidak boleh sebaliknya melakukan apa-apa pun untuk mengganggu perniagaan pemberi perkhidmatan peralihan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_15__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu perintah di bawah seksyen 14 tidak mempunyai kesan memberikan atau meletakhakkan pada Pentadbir atau orang lain itu, mengikut mana-mana yang berkenaan, apa-apa hakmilik kepada atau apa-apa kepentingan benefisial mengenai mana-mana harta pemberi perkhidmatan peralihan. penyiasatan oleh pentadbir"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_16__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_16__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_16__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Pentadbir boleh menghendaki mana-mana pegawai Syarikat yang Ditadbir untuk menentusahkan dan mengemukakan kepada Pentadbir suatu pernyataan mengenai hal ehwal Syarikat yang Ditadbir dalam masa dua puluh satu hari."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_16__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_16__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_16__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_16__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_16__subsec_2__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Pernyataan itu hendaklah mengikut apa-apa bentuk yang ditentukan oleh Pentadbir dan hendaklah mengandungi maklumat yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_16__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_16__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "butir-butir mengenai semua harta dan tanggungan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_16__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_16__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "nama dan alamat pemiutang;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_16__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_16__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "cagaran yang dipegang oleh pemiutang dan tarikh bila cagaran itu diberikan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_16__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_16__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu akuan berkanun yang di bawah Akta Akuan Berkanun 1960 [Akta 13], yang mengisytiharkan bahawa maklumat dalam pernyataan hal ehwal itu adalah benar dan betul; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_16__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_16__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa maklumat lain yang dikehendaki oleh Pentadbir. kewajipan pegawai untuk membantu dalam penyiasatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_17__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_17__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_17__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_17__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pegawai Syarikat yang Ditadbir hendaklah dalam masa tujuh hari selepas diminta oleh Pentadbir—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_17__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_17__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menghantar kepada Pentadbir semua buku, rekod dan dokumen Syarikat yang Ditadbir yang berada dalam milikan pegawai itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_17__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_17__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika pegawai itu mengetahui lokasi buku, rekod dan dokumen lain yang berhubungan dengan Syarikat yang Ditadbir, memaklumkan Pentadbir tentang lokasi buku, rekod dan dokumen itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_17__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_17__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pegawai Syarikat yang Ditadbir hendaklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_17__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_17__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "membantu Pentadbir pada bila-bila masa; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_17__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_17__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "memberi Pentadbir apa-apa maklumat berkenaan dengan harta, hal ehwal dan hal keadaan kewangan Syarikat yang Ditadbir, sebagaimana yang dikehendaki oleh Pentadbir secara munasabah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_17__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Pentadbir hendaklah, apabila pentadbiran di bawah Akta ini berakhir, mengembalikan apa-apa buku, rekod dan dokumen yang diterima di bawah subseksyen (1) kepada Syarikat yang Ditadbir."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada kelulusan bertulis Menteri terlebih dahulu, anggota Syarikat, atau lembaga pengarah Syarikat menurut suatu ketetapan lembaga pengarah, boleh meletakkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Syarikat;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_4__para_b",
      "@type": "akn:paragraph",
