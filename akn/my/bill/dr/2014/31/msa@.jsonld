      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI__cl_35__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI__cl_35__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI__cl_35__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI__cl_35__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "walau apa pun mana-mana undang-undang, suatu perintah mahkamah tidak boleh diberikan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI__cl_35__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI__cl_35__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi menggantung, menyekat atau menyentuh kuasa Pentadbir di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI__cl_35__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI__cl_35__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi menggantung, menyekat atau menyentuh apa-apa tindakan yang diambil atau yang dicadangkan untuk diambil oleh Pentadbir di bawah Akta ini; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI__cl_35__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI__cl_35__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi memaksa Pentadbir untuk melakukan atau melaksanakan apa-apa perbuatan, dan apa-apa perintah sedemikian, jika diberikan, adalah tidak sah dan tidak boleh dikuatkuasakan dan tidak boleh menjadi hal perkara apa-apa proses pelaksanaan sama ada bagi maksud memaksa pematuhan kepada perintah itu atau selainnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI__cl_35__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "Keputusan pelantik dalam seksyen 4 dan 5, Menteri dalam subseksyen 12(2) dan Pentadbir dalam subseksyen 18(1) adalah muktamad. kesahan transaksi"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI__cl_36",
      "@type": "akn:clause",
      "eli:number": "36",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "walau apa pun mana-mana undang-undang bertulis atau rukun undang-undang, apa-apa pembayaran yang dibuat, transaksi yang dibuat, atau apa-apa perbuatan atau benda lain yang dilakukan dengan suci hati oleh atau dengan persetujuan Pentadbir adalah sah dan mempunyai kuat kuasa bagi maksud Akta ini dan tidak boleh dianggap sebagai suatu keutamaan tidak wajar semasa penggulungan Syarikat yang Ditadbir. benda yang dilakukan pada menjangkakan pembuatan akta ini akan diperbuat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI__cl_37",
      "@type": "akn:clause",
      "eli:number": "37",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI__cl_37__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI__cl_37__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI__cl_37__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua perbuatan dan benda yang dilakukan oleh mana-mana orang berkaitan dengan harta, tanggungan, perniagaan dan hal ehwal Syarikat yang Ditadbir sebagai persediaan atau pada menjangkakan pembuatan Akta ini dan apa-apa perbelanjaan yang dilakukan berhubung dengan perbuatan dan benda yang dilakukan hendaklah disifatkan telah dibenarkan di bawah Akta ini, jika perbuatan dan benda yang dilakukan adalah selaras dengan niat dan maksud am Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI__cl_37__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "Pemerbadanan Malaysia Airlines Berhad dan semua perbuatan dan benda yang dilakukan oleh mana-mana orang bagi pihak Malaysia Airlines Berhad dan semua hak dan obligasi yang diperoleh atau dilakukan bagi pihak Malaysia Airlines Berhad hendaklah, apabila mula berkuat kuasanya Akta ini, disifatkan sebagai dilakukan di bawah Akta ini dan hendaklah menjadi hak dan obligasi Malaysia Airlines Berhad."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_V__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_V__cl_30__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_V__cl_30__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_V__cl_30__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_V__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, dari semasa ke semasa, melalui perintah yang disiarkan dalam Warta, menetapkan suatu tarikh peletakhakan bagi setiap perintah dan pada tarikh sedemikian mana-mana harta atau tanggungan Syarikat yang Ditadbir yang dinyatakan oleh Menteri dalam perintah itu hendaklah dipindahkan kepada dan terletak hak pada Malaysia Airlines Berhad tanpa apa-apa jua pemindahhakan, penyerahhakan atau pemindahan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_V__cl_30__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_V__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "Peletakhakan menurut subseksyen (1) hendaklah mempunyai kesan yang dinyatakan dalam Jadual walau apa pun mana-mana undang-undang bertulis atau rukun undang-undang dan hendaklah mengikat mana-mana orang yang terjejas oleh peletakhakan itu. perintah peletakhakan gantian"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_V__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_V__cl_31__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_V__cl_31__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_V__cl_31__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_V__cl_31__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_V__cl_31__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_V__cl_31__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_V__cl_31",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh mengeluarkan suatu perintah peletakhakan baru (“perintah peletakhakan gantian”) untuk menggantikan mana- mana perintah peletakhakan yang dikeluarkan terdahulu untuk membetulkan apa-apa peninggalan atau kesilapan dalam perintah peletakhakan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_V__cl_31__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_V__cl_31",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana perintah peletakhakan gantian yang dikeluarkan di bawah subseksyen (1), yang menyatakan bahawa harta atau tanggungan telah dipindahkan kepada dan terletak hak pada Malaysia Airlines Berhad, hendaklah menjadi keterangan muktamad mengenai pemindahan dan peletakhakan itu pada tarikh peletakhakan yang ditetapkan dalam perintah peletakhakan gantian itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_V__cl_31__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_V__cl_31",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana undang-undang menetapkan suatu tempoh masa yang dalamnya pemindahan apa-apa harta atau tanggungan yang dinyatakan sebagai hal perkara bagi perintah peletakhakan gantian itu hendaklah didaftarkan atau difailkan, tempoh itu hendaklah bermula dari tarikh peletakhakan yang ditetapkan dalam perintah peletakhakan gantian itu atau tarikh perintah peletakhakan gantian itu dikeluarkan, mengikut mana-mana yang kemudian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_V__cl_31__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_V__cl_31",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa perbuatan yang dilakukan oleh Malaysia Airlines Berhad atau mana-mana orang lain, yang bergantung pada suatu perintah peletakhakan yang dikeluarkan terdahulu tidak akan terjejas oleh apa-apa peninggalan atau kesilapan yang dibetulkan dalam perintah peletakhakan gantian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_V__cl_31__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_V__cl_31",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud Akta ini, apa-apa sebutan mengenai sesuatu perintah peletakhakan hendaklah disifatkan sebagai termasuk sebutan mengenai perintah peletakhakan gantian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "[Seksyen 30] PELETAKHAKAN HARTA DAN TANGGUNGAN tafsiran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_1",
      "@type": "akn:paragraph",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam Jadual ini, melainkan jika konteksnya menghendaki makna yang lain— “pemindah” dan “penerima pindahan” masing-masing ertinya pihak masing- masing yang dikenal pasti seperti sedemikian dalam perintah peletakhakan; “perintah peletakhakan” ertinya perintah yang dibuat oleh Menteri di bawah seksyen 30. “tarikh pindah milik” ertinya tarikh yang dinyatakan dalam perintah peletakhakan yang pada hari itu apa-apa harta atau tanggungan dipindahkan dan terletak hak;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Sebutan dalam Jadual ini mengenai “tanggungan” ertinya keseluruhan atau apa-apa bahagian daripada tanggungan sebagaimana yang dipindahkan melalui perintah peletakhakan. kesan perintah peletakhakan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2",
      "@type": "akn:paragraph",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika sesuatu harta dipindahkan di bawah perintah peletakhakan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal jika harta itu dipegang oleh pemindah sendiri sebaik sebelum tarikh pindah milik, harta itu hendaklah pada dan dari tarikh pindah milik itu terletak hak pada penerima pindahan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal jika harta itu dipegang bersesama oleh pemindah dengan mana-mana orang lain sebaik sebelum tarikh pindah milik itu, harta itu hendaklah pada dan dari tarikh pindah milik itu terletak hak pada penerima pindahan bersesama dengan seorang yang lain itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Penerima pindahan hendaklah, pada dan dari tarikh pindah milik bagi harta itu, memperoleh dan diletakhakkan dengan segala hak, hakmilik dan kepentingan pemindah, pada masa sekarang dan hadapan, dan kewajipan berkenaan dengan, harta itu, bebas daripada apa-apa bebanan kecuali apa-apa kepentingan berdaftar yang ada pada tarikh pindah milik itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu perintah peletakhakan yang menyatakan bahawa sesuatu harta atau tanggungan telah dipindahkan dan terletak hak pada penerima pindahan adalah keterangan muktamad bagi pemindahan dan peletakhakan itu pada tarikh pindah milik itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada peruntukan dalam mana-mana perjanjian yang mengehadkan atau melarang hak pemindah atau menghendaki apa-apa keizinan untuk menyerahhakkan, menjual, melupuskan atau memindahkan suatu harta itu boleh terpakai atau mempunyai kuat kuasa berkenaan dengan pemindahan dan peletakhakan harta kepada penerima pindahan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Berhubung dengan sesuatu tanggungan yang dipindahkan di bawah sesuatu perintah peletakhakan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "penerima pindahan hendaklah disifatkan sebagai telah mengambil tanggungan dan bertanggungan untuk melepaskan tanggungan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "pemindah hendaklah dibebaskan dan dilepaskan daripada tanggungan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_6__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_6__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_6__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_6__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_6__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_6__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_6__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_6__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_6__para_j"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Berhubung dengan sesuatu pindahan di bawah suatu perintah peletakhakan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu perjanjian, surat cara yang sedia ada, atau suatu perintah mana- mana mahkamah di bawahnya atau menurut kuasanya pemindah mempunyai hakmilik, pemunyaan, kepentingan atau hak kepada harta atau tanggungan itu, hendaklah ditafsirkan dan hendaklah mempunyai kuat kuasa seolah-olah sebutan mengenai pemindah dalam perjanjian, surat cara atau perintah itu telah digantikan dengan sebutan mengenai penerima pindahan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu perjanjian yang sedia ada yang kepadanya pemindah merupakan suatu pihak hendaklah mempunyai kuat kuasa seolah-olah penerima pindahan menjadi pihak kepada perjanjian itu dan bukannya pemindah;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_6__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu arahan, perintah, mandat, surat kuasa wakil, kuasa, aku janji atau keizinan yang sedia ada sama ada berhubungan dengan sesuatu akaun atau tidak yang telah diberikan kepada pemindah, sama ada berseorangan atau secara bersesama dengan orang lain, hendaklah mempunyai kuat kuasa, seolah-olah diberikan kepada penerima pindahan sama ada berseorangan atau dengan orang lain itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_6__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa cagaran yang dipegang sebaik sebelum tarikh pindah milik oleh pemindah atau oleh seseorang penama atau pemegang amanah bagi pemindah, sebagai cagaran untuk pembayaran atau pelepasan apa-apa tanggungan mana-mana orang, hendaklah dipegang oleh penerima pindahan atau oleh penama atau pemegang amanah itu sebagai penama atau pemegang amanah penerima pindahan dengan keutamaan yang sama seperti pemindah, dan setakat tanggungan itu, hendaklah tersedia pada penerima pindahan sebagai cagaran untuk pembayaran atau pelepasan tanggungan itu; dan jika apa-apa cagaran sedemikian diluaskan kepada pendahuluan atau tanggungan masa hadapan, cagaran itu hendaklah dipegang oleh dan tersedia kepada penerima pindahan sebagai cagaran bagi pendahuluan masa hadapan oleh atau tanggungan masa hadapan penerima pindahan mengikut cara yang sama sebagaimana pendahuluan masa hadapan oleh atau tanggungan masa hadapan pemindah dijamin sebaik sebelum tarikh pindah milik;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_6__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "sebagai tambahan kepada apa-apa hak, kuasa atau remedi lain yang diberikan kepada penerima pindahan, penerima pindahan hendaklah mempunyai hak, kuasa dan remedi (dan khususnya hak dan kuasa untuk mengambil atau menentang prosiding undang-undang atau prosiding lain atau membuat atau menentang permohonan kepada mana-mana pihak berkuasa) bagi menentukan, melindungi atau menguatkuasakan hak, hakmilik, kepentingan yang terletak hak pada penerima pindahan, termasuk hak, hakmilik atau kepentingan berkenaan dengan apa-apa prosiding undang-undang atau prosiding lain atau permohonan kepada mana-mana pihak berkuasa yang belum selesai sebaik sebelum tarikh pindah milik itu oleh atau terhadap pemindah, dan menentang apa-apa tuntutan, tanggungan atau kepentingan berdaftar seolah-olah ia adalah pada setiap masa merupakan hak, hakmilik atau kepentingan penerima pindahan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_6__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu penghakiman, award atau perintah yang diperoleh oleh pemindah dan tidak diselesaikan sepenuhnya sebelum tarikh pindah milik boleh dikuatkuasakan oleh penerima pindahan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_6__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "tiada pemindahan kepada atau pemerolehan oleh penerima pindahan boleh menjadi terbatal atau boleh batal disebabkan oleh pemakaian mana-mana undang-undang;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_6__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "jika jagaan apa-apa barangan, benda atau dokumen itu dipegang oleh pemindah sebagai baili sebaik sebelum tarikh pindah milik, barangan, benda atau dokumen itu hendaklah disifatkan telah dipindahkan kepada penerima pindahan dan hak dan kewajipan pemindah di bawah apa-apa kontrak bailmen yang berhubungan dengan mana-mana barangan, benda atau dokumen itu hendaklah dipindahkan kepada penerima pindahan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_6__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu surat cara boleh niaga atau perintah bagi pembayaran wang yang diberikan kepada atau digunakan atau diterima oleh pemindah, atau yang kena dibayar di tempat perniagaan pemindah, sama ada diberikan, digunakan atau diterima sedemikian sebelum, pada atau selepas tarikh pindah milik, hendaklah mempunyai kesan yang sama pada dan dari tarikh pindah milik, seolah-olah surat cara boleh niaga atau perintah bagi pembayaran wang itu telah diberikan kepada atau digunakan atau diterima oleh penerima pindahan atau telah kena dibayar di tempat perniagaan penerima pindahan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_6__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana akaun antara pemindah dengan pelanggannya hendaklah menjadi akaun antara penerima pindahan dengan pelanggan itu, tertakluk kepada syarat dan insiden yang berhubungan dengan akaun itu sehingga tarikh pindah milik, dan akaun itu hendaklah disifatkan bagi segala maksud sebagai satu akaun yang berterusan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_7__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_7__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_7__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_7__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_7__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu pemindahan harta atau tanggungan di bawah suatu perintah peletakhakan tidak boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_7",
      "schema:text": {
        "@language": "ms",
        "@value": "dianggap sebagai meletakkan penerima pindahan, pemindah, mana- mana orang yang mendapat hakmilik daripada penerima pindahan atau mana-mana orang lain, dalam kedudukan mungkir atau ingkar di bawah mana-mana kontrak atau pecah kepercayaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_7__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_7__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_7__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_7",
      "schema:text": {
        "@language": "ms",
        "@value": "dianggap sebagai menimbulkan hak atau kewajipan bagi mana-mana orang untuk—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_7__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_7__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "menamatkan atau meminda sesuatu perjanjian;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_7__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_7__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "menguatkuasakan atau mempercepat pelaksanaan sesuatu kewajipan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_7__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_7__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "menghendaki pelaksanaan sesuatu kewajipan yang tidak secara lainnya berbangkit untuk pelaksanaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_7__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_7",
      "schema:text": {
        "@language": "ms",
        "@value": "dianggap sebagai menjadikan pemindah, penerima pindahan atau mana-mana orang lain melanggar mana-mana undang-undang, rukun undang-undang atau perjanjian yang melarang, menyekat atau mengawal selia penyerahhakan, penjualan, pelupusan atau pemindahan apa-apa harta atau tanggungan atau penzahiran maklumat;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_7__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_7",
      "schema:text": {
        "@language": "ms",
        "@value": "melepaskan seseorang penjamin daripada sesuatu kewajipan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_7__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_7",
      "schema:text": {
        "@language": "ms",
        "@value": "menidaksahkan atau melepaskan sesuatu kontrak atau cagaran; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_7__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~sched_1__para_2__subsec_7",
      "schema:text": {
        "@language": "ms",
        "@value": "dianggap sebagai menamatkan atau mengubah apa-apa hak, keistimewaan, pengecualian (termasuk apa-apa pengecualian cukai) atau keutamaan yang pemindah berhak kepadanya dan yang menurut kuasa Jadual ini telah terletak hak pada penerima pindahan atau yang wujud demi manfaat pemindah berhubung dengan apa-apa harta atau tanggungan yang dipindahkan kepada penerima pindahan menurut Jadual ini."
      }
    }
  ]
}
