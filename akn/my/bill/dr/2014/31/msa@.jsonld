      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_8__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_8__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Pentadbir hendaklah dalam masa tujuh hari selepas pelantikannya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_8__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_8__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menyerah simpan suatu notis pelantikan dengan Pendaftar Syarikat; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_8__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_8__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menyebabkan supaya suatu notis pelantikannya disiarkan dalam sekurang-kurangnya dua akhbar harian kebangsaan, salah satu daripadanya hendaklah dalam bahasa kebangsaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap invois, pesanan untuk barangan atau perkhidmatan, surat urusan, cek, nota kredit, surat cara boleh niaga atau bil muatan yang dikeluarkan oleh atau bagi pihak Syarikat yang Ditadbir atau Pentadbir selepas pelantikan Pentadbir hendaklah mengandungi perkataan “Pentadbir Dilantik”."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_8__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa ketidakpatuhan kepada subseksyen (1) dan (2) tidak akan menjejaskan kesahan perbuatan Pentadbir dalam pentadbiran Syarikat yang Ditadbir."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_8__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini, “Pendaftar Syarikat” mempunyai erti yang diberikan kepadanya di bawah seksyen 4 Akta Syarikat Fungsi pentadbir"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_9",
