        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_9__subsec_1__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Pentadbir hendaklah mempunyai fungsi yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_9__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_9__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menjalankan perniagaan dan pengendalian (termasuk menstrukturkan semula pengendalian itu) Syarikat yang Ditadbir;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_9__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_9__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengambil ke dalam jagaannya atau di bawah kawalannya harta, tanggungan, perniagaan dan hal ehwal Syarikat yang Ditadbir dan semua harta yang Syarikat yang Ditadbir berhak atau tampak berhak kepadanya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_9__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_9__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menguruskan harta, tanggungan, perniagaan dan hal ehwal Syarikat yang Ditadbir atas nama dan bagi pihak Syarikat yang Ditadbir, termasuk pelupusan harta dan tanggungan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_9__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_9__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengambil alih kawalan dan menjalankan semua kuasa yang diberikan kepada pengarah di bawah Akta Syarikat 1965 atau melalui perlembagaan Syarikat yang Ditadbir, dan kuasa pengarah Syarikat yang Ditadbir hendaklah selepas itu terhenti kecuali setakat yang dibenarkan oleh Pentadbir;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_9__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_9__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk membuat apa-apa perkiraan atau kompromi bagi pihak Syarikat yang Ditadbir dengan pemiutangnya atau mana-mana kelas pemiutangnya atau antara syarikat subsidiari yang dinyatakan dengan anggotanya atau mana-mana kelas anggotanya atau antara Syarikat yang Ditadbir dengan penghutangnya atau mana-mana kelas penghutangnya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_9__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_9__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk melaksanakan apa-apa fungsi yang boleh dilaksanakan atau dijalankan oleh Syarikat yang Ditadbir atau mana- mana pegawai Syarikat yang Ditadbir jika Pentadbir tidak dilantik."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada apa-apa dalam perenggan (1)(d) boleh menghendaki Pentadbir untuk memanggil apa-apa mesyuarat Syarikat yang kuasa pentadbir"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_24",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_25",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_26",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_27",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_28",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_29"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "MALAYSIA AIRLINES BERHAD pemerbadanan Malaysia airlines berhad"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan yang diperbadankan di bawah Akta Syarikat 1965 dengan nama “Malaysia Airlines Berhad” hendaklah mempunyai matlamat utama untuk mengendalikan syarikat penerbangan nasional Malaysia dan hendaklah menjalankan perniagaan syarikat penerbangan nasional sebagai suatu perusahaan komersial dan apa-apa perniagaan lain yang difikirkan patut oleh lembaga pengarah Malaysia Airlines Berhad. tawaran pekerjaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Malaysia Airlines Berhad boleh, menurut budi bicara mutlaknya, menawarkan pekerjaan kepada mana-mana orang yang sebaik sebelum tarikh tawaran itu berada dalam penggajian atau perkhidmatan Syarikat yang Ditadbir atas apa-apa terma dan syarat yang ditentukan oleh Malaysia Airlines Berhad. Malaysia airlines berhad, dsb., bukan majikan pengganti"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_26__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_26__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_26__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_26__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_26__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_26__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "walau apa pun apa-apa yang berlawanan dalam Akta ini atau di bawah mana-mana undang-undang, jika Pentadbir mengambil alih kawalan Syarikat yang Ditadbir, atau jika Malaysia Airlines Berhad membuat suatu tawaran pekerjaan kepada seseorang yang berada dalam penggajian atau perkhidmatan Syarikat yang Ditadbir, atau jika Malaysia Airlines Berhad membuat suatu perjanjian perkhidmatan peralihan dengan Syarikat yang Ditadbir, Pentadbir, pelantik atau Malaysia Airlines Berhad tidak boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_26__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_26__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dianggap sebagai pengganti, pemegang serah hak atau penerima pindahan atau majikan pengganti kepada Syarikat yang Ditadbir;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_26__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_26__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bertanggungan bagi apa-apa obligasi yang berhubungan dengan apa-apa pelan persaraan atau pelan manfaat pasca pekerjaan yang lain berkenaan dengan pekerja atau bekas pekerja Syarikat yang Ditadbir atau mana- mana pendahulu bagi Syarikat yang Ditadbir yang wujud sebelum pengambilalihan kawalan atau pelantikan itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_26__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_26__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bertanggungan bagi apa-apa jumlah wang yang dikira dengan merujuk kepada suatu tempoh masa sebelum Malaysia Airlines Berhad menjadi majikan orang yang berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_26__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Malaysia Airlines Berhad, pelantik dan Pentadbir tidak boleh dinamakan sebagai suatu pihak dalam apa-apa tuntutan atau permohonan yang dibuat atau ditambahkan sebagai suatu pihak dalam apa-apa prosiding yang dimulakan atau diteruskan oleh atau bagi pihak mana-mana pekerja atau bekas pekerja Syarikat yang Ditadbir menurut Akta Perhubungan Perusahaan 1967 [Akta 177], atau Akta Kerja 1955 [Akta 265], Ordinan Buruh Sabah 1950 [Sabah Bab 67], Ordinan Buruh Sarawak 1952 [Sarawak Bab 76] atau Akta Kesatuan Sekerja 1959 [Akta 262]. kaedah-kaedah kerja, kod tatakelakuan dan peraturan- peraturan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Malaysia Airlines Berhad boleh, jika difikirkannya patut, mengenakan apa-apa kaedah kerja, kod tatakelakuan dan peraturan-peraturan berhubung dengan pekerjanya mengikut semua undang-undang yang terpakai. Rundingan dengan kesatuan sekerja dan persatuan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_28__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_28__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_28__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_28__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_28__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_28__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_28__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_28__subsec_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_28__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_28__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_28__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua perkara yang hendak dibincangkan atau dirundingkan antara Malaysia Airlines Berhad dengan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_28__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_28__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana kesatuan sekerja yang diiktiraf dengan sewajarnya oleh Malaysia Airlines Berhad mengikut Akta Perhubungan Perusahaan 1967 dan Akta Kesatuan Sekerja 1959; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_28__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_28__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana persatuan yang diiktiraf oleh Malaysia Airlines Berhad, hendaklah melalui mesyuarat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_28__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu mesyuarat yang hendak diadakan di bawah subseksyen (1) tidak boleh diteruskan melainkan jika semua kesatuan sekerja dan persatuan diwakili sewajarnya dalam mesyuarat itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_28__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika selepas setengah jam dari masa yang ditetapkan bagi sesuatu mesyuarat, tidak semua daripada kesatuan sekerja dan persatuan diwakili dengan sewajarnya, mesyuarat itu hendaklah ditangguhkan ke minggu yang berikutnya, pada hari dan masa dan di tempat yang sama tanpa apa-apa notis lanjut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_28__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mesyuarat itu ditangguhkan ke suatu hari yang merupakan hari kelepasan am, mesyuarat yang ditangguhkan itu hendaklah diadakan semula pada hari bekerja yang berikutnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_28__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila mesyuarat yang ditangguhkan itu diadakan semula pada tarikh yang baru, ketidakhadiran oleh mana-mana kesatuan sekerja atau persatuan tidak boleh menghalang mesyuarat itu daripada diteruskan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_28__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa keputusan yang dibuat semasa mesyuarat oleh Malaysia Airlines Berhad dengan kesatuan sekerja dan persatuan yang hadir pada mesyuarat itu hendaklah sah dan mengikat Malaysia Airlines Berhad dan semua kesatuan sekerja dan persatuan yang diiktiraf oleh Malaysia Airlines Berhad."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_28__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam sesuatu mesyuarat di bawah seksyen ini, jika kesatuan sekerja dan persatuan dengan sebulat suara memutuskan bahawa perkara bagi perbincangan atau rundingan itu berhubungan semata-mata dengan suatu kesatuan sekerja atau persatuan yang khusus, mesyuarat itu hendaklah dibubarkan dan suatu mesyuarat yang berasingan hendaklah diadakan antara Malaysia Airlines Berhad dengan kesatuan sekerja atau persatuan yang khusus itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_28__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "Mesyuarat yang berasingan antara Malaysia Airlines Berhad dengan kesatuan sekerja atau persatuan khusus itu tidak boleh membincangkan apa-apa perkara selain perkara yang diputuskan di bawah subseksyen (7). perkara yang berhubungan dengan produktiviti atau penggunaan tenaga kerja dengan berkesan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_IV__cl_29__subsec_1",
