      "schema:text": {
        "@language": "ms",
        "@value": "Tiada tindakan, guaman, pendakwaan atau apa jua prosiding boleh diambil atau dibawa, dimulakan atau dikekalkan dalam mana-mana mahkamah atau tribunal atau di hadapan mana-mana pihak berkuasa terhadap—"
      }
    },
