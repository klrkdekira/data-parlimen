      "schema:text": {
        "@language": "ms",
        "@value": "PELETAKHAKAN HARTA DAN TANGGUNGAN peruntukan peletakhakan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI",
      "@type": "akn:part",
      "eli:number": "VI",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI__cl_32",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI__cl_33",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI__cl_34",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI__cl_35",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI__cl_36",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI__cl_37"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "AM ketidakpakaian seksyen 132e akta Syarikat 1965"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 132E Akta Syarikat 1965 tidak terpakai bagi apa-apa pelupusan melalui apa-apa perkiraan atau transaksi antara Syarikat dengan Malaysia Airlines Berhad. tanggung rugi bagi pentadbir, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI__cl_33__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI__cl_33__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI__cl_33__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI__cl_33__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI__cl_33__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI__cl_33__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI__cl_33__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI__cl_33",
      "schema:text": {
        "@language": "ms",
        "@value": "Pentadbir, pelantik dan mana-mana orang lain adalah berhak untuk mendapatkan tanggung rugi daripada harta Syarikat yang Ditadbir bagi—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI__cl_33__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI__cl_33__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal Pentadbir, kos, perbelanjaan dan saraannya yang diperuntukkan di bawah terma pelantikannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI__cl_33__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI__cl_33__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal pelantik, pembayaran balik apa-apa kemudahan kredit yang diberikan oleh pelantik kepada Pentadbir atau kepada Syarikat yang Ditadbir semasa pentadbiran Syarikat yang Ditadbir;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI__cl_33__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI__cl_33__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal Malaysia Airlines Berhad, pembayaran balik apa-apa kemudahan kredit yang diberikan oleh Malaysia Airlines Berhad kepada Pentadbir atau kepada Syarikat yang Ditadbir semasa pentadbiran Syarikat yang Ditadbir; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI__cl_33__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI__cl_33__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal mana-mana orang lain, pembayaran balik apa-apa kemudahan kredit yang diberikan oleh orang itu kepada Pentadbir atau kepada Syarikat yang Ditadbir semasa pentadbiran Syarikat yang Ditadbir dengan kelulusan pelantik."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI__cl_33__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI__cl_33",
      "schema:text": {
        "@language": "ms",
        "@value": "walau apa pun mana-mana undang-undang lain, suatu hak tanggung rugi di bawah subseksyen (1) hendaklah mempunyai keutamaan ke atas harta Syarikat yang Ditadbir dan hendaklah dibayar dahulu berbanding dengan semua hutang bercagar dan tidak bercagar yang lain. kekebalan"
      }
    },
    {
