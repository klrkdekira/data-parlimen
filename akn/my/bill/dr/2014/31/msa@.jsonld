      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana pegawai orang yang disebut dalam perenggan (b) dan (d); atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/31/msa@/~part_VI__cl_34__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
