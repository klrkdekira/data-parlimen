      ],
      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-undang Suruhanjaya Koperasi Malaysia (Pindaan) 2014"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/8/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/8/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/8/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/8/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/8/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/8/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Suruhanjaya Koperasi Malaysia (Pindaan) 2014."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/8/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/8/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta. Pindaan seksyen 11"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/8/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/8/msa@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/8/msa@/~cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/8/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Suruhanjaya Koperasi Malaysia 2007 [Akta 665], yang disebut “Akta ibu” dalam Akta ini, dipinda dalam subseksyen 11(3)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/8/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/8/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (c), dengan menggantikan perkataan “atau seorang Timbalan Gabenor” dengan perkataan “, atau seorang Timbalan Gabenor atau Penolong Gabenor”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/8/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/8/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perenggan (d) dengan perenggan yang berikut: “ (d) Ketua Setiausaha atau seorang Timbalan Ketua Setiausaha Kementerian yang dipertanggungkan dengan tanggungjawab bagi pembangunan koperasi sebagaimana yang dinamakan oleh Menteri;”. Seksyen baru 62a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/8/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2014/8/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memasukkan selepas seksyen 62 seksyen yang berikut: “Pewakilan dalam prosiding sivil 62a. Walau apa pun peruntukan mana-mana undang-undang bertulis yang lain— (a) dalam mana-mana prosiding sivil oleh atau terhadap Suruhanjaya; atau (b) dalam mana-mana prosiding sivil yang lain yang Suruhanjaya dikehendaki atau dibenarkan oleh mahkamah untuk diwakili, atau untuk didengar, atau selainnya berhak untuk diwakili atau untuk didengar, mana-mana pegawai Suruhanjaya yang diberi kuasa oleh Pengerusi Eksekutif bagi maksud itu boleh, bagi pihak Suruhanjaya, memulakan prosiding sedemikian atau hadir dalam prosiding itu dan boleh membuat semua kehadiran dan permohonan dan melakukan semua perbuatan berkenaan dengan prosiding itu bagi pihak Suruhanjaya.”."
      }
    }
  ]
}
