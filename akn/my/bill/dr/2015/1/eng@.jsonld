      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/1/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Subsection 18(2) of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/1/eng@/~cl_8__para_a",
