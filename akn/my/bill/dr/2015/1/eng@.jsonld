      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words “Associate of the Malaysian Institute of Chemistry” the words “Member of the Malaysian Institute of Chemistry”. Amendment of section 19"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/1/eng@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/1/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 19 of the principal Act is amended by substituting for subsection (2) the following subsection: “(2) Any member who contravenes subsection (1) commits an offence and shall, on conviction, be liable to a fine not exceeding five thousand ringgit and the Council may suspend his membership for a term not exceeding one year and if convicted for the second time for an offence under subsection (1), the Council may terminate his membership immediately.”. Amendment of section 23"
      }
