      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/1/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting subsection (5). Amendment of section 15"
      }
    },
