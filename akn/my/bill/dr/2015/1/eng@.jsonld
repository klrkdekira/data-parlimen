        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/1/eng@/~cl_5__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/1/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 14 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/1/eng@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/1/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (1) the following subsection: “(1a) Whenever the post of the Registrar is vacant due to the vacancy of the post of the Director General of Chemistry, the Minister shall appoint any person to perform the duties of the Registrar until the new Director General of Chemistry is appointed.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/1/eng@/~cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/1/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (2), by deleting the words “, with the approval of the Minister,”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/1/eng@/~cl_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/1/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (4), by substituting for the word “Registrar” the word “Council”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/1/eng@/~cl_5__para_d",
      "@type": "akn:paragraph",
