      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (3) the following subsection: “(3) The Registrar shall cause to be published in the Gazette, at least once in every year, a copy of the register which contains changes to the list of membership roll of the register of members who have been removed from the register, included in the register or upgraded from Licentiate to Member or Member to Fellow.”. Amendment of section 17"
      }
    },
