      "schema:text": {
        "@language": "en",
        "@value": "in subsection (1), by substituting for the words “as Fellows, Associates and Licentiates” the words “into three grades, namely Fellow, Member and Licentiate.”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/1/eng@/~cl_6__para_b",
