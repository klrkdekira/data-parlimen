      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/1/eng@/~cl_7__para_d",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for paragraph (b) the following paragraph: “ (b) practical experience in chemistry of not less than one year for a degree or its equivalent; and”. Amendment of section 18"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/1/eng@/~cl_8",
