      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1), dengan menggantikan perkataan “Fellowship, Associateship dan Licentiateship” dengan perkataan “Fellow, Member dan Licentiate”;"
      }
    },
    {
