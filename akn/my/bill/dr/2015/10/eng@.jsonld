        "@language": "en",
        "@value": "POWERS OF ARREST AND REMAND Arrest and production before Magistrate"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III",
      "@type": "akn:part",
