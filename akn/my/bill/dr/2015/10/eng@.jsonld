        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_11",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_12"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "INQUIRIES Prevention of Terrorism Board"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_10__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_10__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_10__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_10__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_10__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_10__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_10__subsec_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "When any person is brought before an Inquiry Officer under section 5, the Inquiry Officer shall inquire and report in writing to the Board whether there are reasonable grounds for believing that the person is engaged in the commission or support of terrorist acts involving listed terrorist organizations in a foreign country or any part of a foreign country."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "An inquiry held under subsection (1) shall be held in such manner and in accordance with such procedure as the Board may direct."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_10__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_10__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_10__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_10__subsec_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_10__subsec_3__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_10__subsec_3__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "An Inquiry Officer may, for the purpose of any inquiry under this Act—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_10__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_10__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "procure and receive all such evidence, in any form and whether the evidence be admissible or not under any written law for the time being in force relating to evidence or criminal procedure, which he may think necessary or desirable;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_10__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_10__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "summon and examine witnesses on oath or affirmation, and may for those purposes administer any oath or affirmation;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_10__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_10__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "require the production of any document or other thing in his opinion relevant to the inquiry;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_10__subsec_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_10__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "if he considers it necessary in the public interest or to protect a witness or his family or associates, receive evidence in the absence of the person who is the subject of the inquiry;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_10__subsec_3__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_10__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "give any direction as may be necessary."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_10__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of paragraph (3)(d), where any evidence is received in the absence of the person who is the subject of the inquiry, the Inquiry Officer shall communicate to the person the substance of the evidence, so far as he may consider it compatible with the public interest or the need to protect a witness or his family or associates so to do, and shall in every such case include in any report made under paragraph 12(2)(a) a statement of the circumstances in which the evidence was received."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_10__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "Any person summoned as a witness under subsection (3) who without reasonable excuse fails to attend at the time and place mentioned in the summons or who, having attended, refuses to answer any question that may lawfully be put to him or to produce any document or thing which is in his power to produce, commits an offence and shall be punished with imprisonment for a term not exceeding six months or to a fine not exceeding two thousand ringgit or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_10__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "Neither the person who is the subject of the inquiry nor a witness at an inquiry shall be represented by an advocate and solicitor at the inquiry except when his own evidence is being taken and recorded by the Inquiry Officer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_10__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The Public Prosecutor may appear at an inquiry to assist the Inquiry Officer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_10__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may by regulations prescribe the allowances to be paid to witnesses summoned under subsection (3). Access by Inquiry Officer to detainees or prisoners"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_11__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_11__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_11__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding any other written law, an Inquiry Officer conducting an inquiry under this Act shall be allowed to have access to any person whom he has reason to believe to be connected to or has any evidence of any offence who is—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_11__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_11__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "being detained under any other written law; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_11__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_11__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "under confinement in prison, whether convicted or not."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "Nothing in this section shall authorize the attendance of the subject of the inquiry or his advocate and solicitor or representative, if any, at the place of detention or prison. Report of Inquiry Officer"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_12__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "An Inquiry Officer shall submit his report in writing to the Board within such period as may be prescribed by the Minister by regulations made under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_12__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_12__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "Upon receipt of the report under subsection (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_12__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_12__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "where the Board concurs with the Inquiry Officer that there are reasonable grounds for believing that the person who was the subject of the inquiry is engaged in the commission or support of terrorist acts involving listed terrorist organizations in a foreign country or any part of a foreign country, the Board shall proceed under section 13;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_12__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_12__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "where the Board concurs with the Inquiry Officer that there are no reasonable grounds for believing that the person who was the subject of the inquiry is engaged in the commission or support of terrorist acts involving listed terrorist organizations in a foreign country or any part of a foreign country, the Board shall forthwith direct any person having the custody of that person, within twenty-four hours from the receipt of the direction, to produce the person before a Sessions Court Judge, who shall thereupon discharge the order of remand made under section 4 and, if there are no other grounds on which the person is lawfully detained, shall order his immediate release."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_8__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_8__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_8__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_8__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_8__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_8__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_8__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_8__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_8__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "A Prevention of Terrorism Board is established which shall consist of the following members to be appointed by the Yang di-Pertuan Agong:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_8__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_8__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a Chairman, who shall be a legally qualified person with at least fifteen years experience in the legal field;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_8__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_8__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a Deputy Chairman; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_8__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_8__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "not less than three and not more than six other members."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "Every member of the Board shall, unless he sooner resigns, hold office for a period not exceeding three years and is eligible for re-appointment once for another period of three years."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_8__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "Every member of the Board may at any time resign his office by giving notice in writing to the Yang di-Pertuan Agong."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_8__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "The appointment of any member of the Board may at any time be revoked by the Yang di-Pertuan Agong."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_8__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "The quorum for any sitting of the Board shall be three members."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_8__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to this Act, the Board shall determine its own procedure."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_8__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "Every member of the Board shall be deemed to be a public servant within the meaning of the Penal Code. Appointment of Inquiry Officers"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_9__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may in writing appoint any person by name or office, and either generally or for any particular case, to be an Inquiry Officer for the purposes of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_III__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "No police officer shall be appointed as an Inquiry Officer. Duties and powers of Inquiry Officers"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_3__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_3__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_3__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "A police officer may without a warrant arrest any person if he has reason to believe that grounds exist which would justify the holding of an inquiry into the case of that person under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "When a person is arrested under subsection (1), the case shall be referred by the police officer to the Public Prosecutor for direction not later than seven days from the date of arrest."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_3__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "Any person arrested under subsection (1) shall, unless sooner released, be taken without unreasonable delay, and in any case within twenty-four hours (excluding the time of any necessary journey) before a Magistrate."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_3__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_3__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_3__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "The police officer making an investigation pertaining to a person arrested under this section shall cause a copy of the complete report of the investigation to be submitted to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_3__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_3__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "an Inquiry Officer; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_3__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_3__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "the Board, within such period as may be prescribed by the Minister by regulations made under this Act. Procedure before Magistrate"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_4__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_4__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_4__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_4__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_4__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_4__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_4__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "Whenever any person is taken before a Magistrate under subsection 3(3), the Magistrate shall—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_4__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "on production of a statement in writing signed by a police officer not below the rank of Inspector stating that there are grounds for believing that the name of the person who is engaged in the commission or support of terrorist acts involving listed terrorist organizations in a foreign country or any part of a foreign country should be entered in the Register, remand the person in police custody for a period of twenty-one days; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_4__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "if no such statement is produced, and there are no other grounds on which the person is lawfully detained, direct his release."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_4__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_4__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "Any person remanded under paragraph (1)(a) shall, unless sooner released, on or before the expiry of the period for which he is remanded, be taken before a Magistrate, who shall—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_4__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_4__subsec_2__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_4__subsec_2__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_4__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "on production of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_4__subsec_2__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_4__subsec_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "a statement in writing signed by the Public Prosecutor stating that in his opinion sufficient evidence exists to justify the holding of an inquiry under section 10; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_4__subsec_2__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_4__subsec_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "a statement in writing signed by a police officer not below the rank of Assistant Superintendent stating that it is intended to hold an inquiry into the case of that person under section 10, order the person to be remanded in custody for a period of thirty-eight days; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_4__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_4__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "if no such statements are produced, and there are no other grounds on which the person is lawfully detained, direct his release."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_4__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall be arrested and detained under this section solely for his political belief or political activity."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_4__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "Except as provided in subsection 10(6), the provisions of section 28a of the Criminal Procedure Code shall apply to any person remanded under section 4."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_4__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "The Public Prosecutor may appear in any application made under this section."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_4__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_4__subsec_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_4__subsec_6__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_4__subsec_6__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "For the purpose of this section, “political belief or political activity” means engaging in a lawful activity through—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_4__subsec_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_4__subsec_6__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_4__subsec_6__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_4__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "the expression of an opinion or the pursuit of a course of action made according to the tenets of a political party that is at the relevant time registered under the Societies Act 1966 [Act 335] as evidenced by—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_4__subsec_6__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_4__subsec_6__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "membership of or contribution to that party; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_4__subsec_6__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_4__subsec_6__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "open and active participation in the affairs of that party;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_4__subsec_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_4__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "the expression of an opinion directed towards any government in Malaysia; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_4__subsec_6__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_4__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "the pursuit of a course of action directed towards any government in Malaysia. Person in custody to be brought before Inquiry Officer"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "Every person remanded in custody under section 4 shall, if not sooner released, as soon as possible be brought before an Inquiry Officer. Release of person remanded in custody"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_6__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_6__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_6__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_6__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "Any person remanded in custody under section 4 may at any time be taken before a Sessions Court Judge who, if there are no other grounds on which the person is lawfully detained—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_6__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "shall direct his release if there is produced to the Sessions Court Judge a statement in writing signed by a police officer not below the rank of Assistant Superintendent stating that it is not intended to continue with an inquiry into the case of that person under section 10; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_6__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_6__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_6__subsec_1__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "in any other case, on the application of a police officer, may direct his release subject to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_6__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_6__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "the execution by the person of a bond, with or without sureties, for his due appearance at such place or places and at such time or times and within such period not exceeding fifty-nine days as the Sessions Court Judge may direct; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_6__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_6__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "the supervision of the police for such period not exceeding fifty-nine days as the Sessions Court Judge may direct."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "If a person is released under paragraph (1)(b), an electronic monitoring device shall be attached on the person in accordance with subsections (3) and (4)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "If the police officer intends to release the person under paragraph (1)(b) and attach an electronic monitoring device on the person upon his release, he shall submit a report to the Public Prosecutor before the application under paragraph (1)(b) is made."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_6__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "Upon receipt of the report under subsection (3), the Public Prosecutor may apply to the Sessions Court Judge for the person to be attached with an electronic monitoring device in accordance with section 7 for the period of his release as allowed under paragraph (1)(b). Special procedures relating to electronic monitoring device"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_7__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_7__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_7__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_7__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_7__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_7__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_7__subsec_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "Upon application by the Public Prosecutor under section 6, the Sessions Court Judge shall order the person to be attached with an electronic monitoring device for a period as the Sessions Court Judge may determine but which shall not exceed the period of his release as allowed under paragraph 6(1)(b)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "The Sessions Court Judge shall explain the operation of the electronic monitoring device and the terms and conditions of the electronic monitoring device to the person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_7__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "The person shall sign a form as specified in the Schedule and deposit the form with the Sessions Court Judge."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_7__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "The person shall be attached with an electronic monitoring device by a police officer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_7__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "The person shall comply with all the terms and conditions of the electronic monitoring device and shall report to the nearest police station at such time as specified in the form."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_7__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who fails to comply with the terms and conditions under subsection (5) commits an offence and shall be punished with imprisonment for a term not exceeding three years."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_7__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who tampers with, or destroys, the electronic monitoring device commits an offence and shall be punished with imprisonment for a term not exceeding three years and such person shall be liable to pay for any damage to the electronic monitoring device arising from his action."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_7__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "Upon expiry of the period referred to in subsection (1), the person shall report to the nearest police station for removal of the electronic monitoring device."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_14",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_15",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_16",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_17",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_18",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_19",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_20",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_21",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_22",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_23",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_24",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_25",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_26",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_27",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_28"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "DETENTION AND RESTRICTION ORDERS Power to order detention and restriction"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_10"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "Whenever the Board, after considering—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_10",
      "@type": "akn:subsection",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The direction of the Board under subsection (1) shall be subject to review by the High Court. Validity of detention orders"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the complete report of the investigation submitted under subsection 3(4); and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the report of the Inquiry Officer submitted under section 12, is satisfied with respect to any person that such person has been or is engaged in the commission or support of terrorist acts involving listed terrorist organizations in a foreign country or any part of a foreign country, the Board may, if it is satisfied that it is necessary in the interest of the security of Malaysia or any part of Malaysia that such person be detained, by order (“detention order”) direct that such person be detained for a period not exceeding two years."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "Every person detained in pursuance of a detention order shall be detained in such place (“place of detention”) as the Board may direct and in accordance with any instructions issued by the Board and any regulations made under section 34."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_3__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_3__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_3__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_3__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_3__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_3__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_3__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_3__para_k",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_3__para_l"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "If the Board is satisfied that for the purpose mentioned in subsection (1) it is necessary that control and supervision should be exercised over any person or that restrictions and conditions should be imposed upon that person in respect of his activities, freedom of movement or places of residence or employment, but for that purpose it is unnecessary to detain him, the Board may by order (“restriction order”) direct that the person named in the order (“restricted person”) shall be subject to the supervision of the police for any period not exceeding five years at a time and may impose all or any of the following restrictions and conditions:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "he shall be required to reside within the limits of any State, district, mukim, town or village specified in the order;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "he shall not be permitted to transfer his residence to any other State, district, mukim, town or village, as the case may be, without the written authority of the Board;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "except so far as may be otherwise provided by the order, he shall not leave the State, district, mukim, town or village within which he resides without the written authority of the Chief Police Officer of the State concerned;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "he shall at all times keep the Officer in Charge of the Police District in which he resides notified of the house or place in which he resides;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_3__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "he shall be liable, at such time or times as may be specified in the order, to present himself at the nearest police station;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_3__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "he shall remain within doors, or within such area as may be defined in the order, between such hours as may be specified in the order, unless he obtains special permission to the contrary from the Officer in Charge of the Police District;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_3__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "except so far as may be otherwise provided by the order, he shall not be permitted to enter any State, district, mukim, town or village specified in the order;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_3__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "he shall use only equipment and facilities of communication which are declared to and approved by the Chief Police Officer of any State concerned;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_3__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "except so far as may be otherwise provided by the order, he shall not access the internet;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_3__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "he shall keep the peace and be of good behaviour;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_3__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "he shall enter into a bond, with or without sureties as the Board may direct and in such amount as may be specified in the order, for his due compliance with the restrictions and conditions imposed on him by the order;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_3__para_l",
      "@type": "akn:paragraph",
      "eli:number": "l",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "he shall be attached with an electronic monitoring device."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may, by order in writing served on the person subject to a restriction order, vary, cancel or add to any restrictions and conditions imposed under subsection (3)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "Any restricted person who fails to comply with any restriction or condition imposed on him under this section commits an offence and shall be punished with imprisonment for a term not exceeding ten years and not less than two years."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who conspires with, abets or assists any restricted person to breach any restriction or condition under this section commits an offence and shall be punished with imprisonment for a term not exceeding ten years and not less than two years."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "Sections 173a and 294 of the Criminal Procedure Code shall not apply in respect of offences under subsections (5) and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The punishment imposed under subsection (5) and any term of imprisonment imposed under any written law shall not be taken into consideration for the purpose of the period of supervision imposed under subsection (3) and the period of supervision shall be continued from the date of completion of the sentence of imprisonment imposed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "A copy of every detention order made by the Board under subsection (1) shall as soon as may be after the making of the order be served on the person to whom it relates, and every such person shall be entitled to make representations to an Advisory Board constituted under Clause (2) of Article 151 of the Federal Constitution in accordance with the prescribed procedures."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_14__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_14__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV",
      "schema:name": {
        "@language": "en",
        "@value": "No detention order shall be invalid or inoperative by reason—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_14__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_14__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_14__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_14__para_a__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "that the person to whom it relates—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_14__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_14__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "was immediately before the making of the detention order detained in any place other than a place of detention referred to in subsection 13(2);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_14__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_14__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "continued to be detained immediately after the making of the detention order in the place in which he was detained under section 3 before his removal to a place of detention referred to in subsection 13(2); or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_14__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_14__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "was during the duration of the detention order on journey in police custody or any other custody to a place of detention referred to in subsection 13(2); or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_14__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "that the detention order was served on him at any place other than the place of detention referred to in subsection 13(2), or that there was any defect relating to its service upon him. Suspension of detention orders"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_15__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_15__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_15__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_15__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_15__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may, at any time, direct that the operation of any detention order under subsection 13(1) be suspended subject to the imposition of all or any of the restrictions and conditions under subsection 13(3)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "Where a detention order is suspended under subsection (1), subsection 13(3) shall have effect as if the restrictions and conditions on which the detention order is suspended were restrictions and conditions imposed by a restriction order made under subsection 13(3)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_15__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_15__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_15__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may revoke the suspension of any detention order if it is satisfied that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_15__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_15__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the person against whom the detention order was made has failed to comply with any restriction or condition imposed upon him; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_15__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_15__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "it is necessary in the interest of public order or public security that the suspension should be revoked, and in any such case the revocation of the suspension shall be sufficient authority to any police officer to re-arrest without warrant the person against whom the detention order was made, and that person shall as soon as practicable be returned to his former place of detention or, if the Board so directs, sent to another place of detention."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_15__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "The suspension of any detention order under this section shall, subject to subsection 13(4) as applied by subsection (2) and subject also to subsection (3), continue in force for the unexpired portion of the period of the order specified under subsection 13(1). Effect on term of imprisonment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_16__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_16__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV",
      "schema:name": {
        "@language": "en",
        "@value": "Where a person—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_16__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "who is undergoing detention under subsection 13(1) is sentenced to any term of imprisonment under this Act or any other written law; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_16__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "has his period of detention extended under subsection 17(1) whilst he is serving any such term of imprisonment, the detention or extended detention shall be deemed to be undergone concurrently with that term of imprisonment, and if upon completion of any such term of imprisonment, there still remain any unexpired portion of the detention period or of the extended detention period, he shall be required to be detained for such unexpired portion of such period. Board’s power to extend detention order, restriction order or suspended detention order"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_17__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_17__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_17__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_17__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_17__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_17__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_17__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may at any time before the expiration of the duration of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_17__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_17__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a detention order made under subsection 13(1);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_17__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_17__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a restriction order made under subsection 13(3); or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_17__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_17__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a detention order suspended under subsection 15(1) (“suspended detention order”), direct that the duration of the order be extended for such further period, not exceeding two years for a detention order or five years for a restriction order, as the Board may specify, commencing immediately upon the expiration of its then current duration."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_17__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_17__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_17__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Board directs for the duration of a detention order, restriction order or suspended detention order to be extended under subsection (1), it shall set out in the direction the grounds for the extension and state whether such grounds are—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_17__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_17__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the same as the grounds on which the order was originally made;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_17__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_17__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "different from the grounds on which the order was originally made; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_17__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_17__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "partly the same grounds and partly different grounds."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_17__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "Where the duration of a suspended detention order is extended under subsection (1), the duration of the direction for its suspension under subsection 15(1) shall be deemed to be extended for the duration of the extension of the suspended detention order together with the restrictions and conditions imposed in respect of such suspension, subject, if the Board so directs, to the requirement that the person against whom the detention order was made shall enter into a fresh bond as provided in paragraph 13(3)(k), and section 15 shall apply to such extended suspension in the same manner as it applies to an original suspension under subsection 15(1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_17__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "Where the direction under subsection (1) for the extension of the duration of a detention order or a suspended detention order is on grounds which fall under paragraph (2)(b) or (c), subsection 13(9) shall apply to such direction as if the direction were a fresh detention order."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_17__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "The duration of a detention order, restriction order or suspended detention order which is extended under subsection (1) may be further extended from time to time for further periods not exceeding two years at a time, and the provisions of this section shall apply mutatis mutandis in relation to each such extension. Board’s power to revoke detention order, restriction order, suspended detention order or direction for extension of any such order"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_18__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_18__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding anything contained in this Act, the Board may at any time revoke any detention order made under subsection 13(1) or any restriction order made under subsection 13(3) or any suspended detention order or any direction under subsection 17(1) for the extension of the duration of any such order, if it deems it just or fit to do so."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "Any revocation under subsection (1) shall be without prejudice to the validity of the order or direction before its revocation or to anything done under it, or to the power of the Board to make a fresh detention order under subsection 13(1) or a fresh restriction order under subsection 13(3) or a fresh direction under subsection 17(1) in respect of the person against whom the order or direction which is revoked was made or given. Judicial review of act or decision of Board"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_19__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_19__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_19__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "There shall be no judicial review in any court of, and no court shall have or exercise any jurisdiction in respect of, any act done or decision made by the Board in the exercise of its discretionary power in accordance with this Act, except in regard to any question on compliance with any procedural requirement in this Act governing such act or decision."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_19__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_19__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_19__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_19__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_19__subsec_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "In this Act, “judicial review” includes proceedings instituted by way of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_19__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_19__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "an application for any of the prerogative orders of mandamus, prohibition and certiorari;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_19__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_19__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "an application for a declaration or an injunction;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_19__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_19__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "a writ of habeas corpus; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_19__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_19__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "any other suit, action or legal proceedings relating to or arising out of any act done or decision made by the Board in accordance with this Act. Power to order removal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_20__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_20__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_20__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may by order direct the removal from any place of detention to another place of detention to be specified in such order of any person detained under subsection 13(1), or under subsection 17(1), to be there detained for the whole or any part of such period for which it has been ordered that such person shall be detained."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_20__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who is in the course of removal under subsection (1) shall be deemed to be in lawful custody. Power to order production of detained person"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_21__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_21__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_21__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_21__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "On proof to his satisfaction that the presence at any place of any person detained under subsection 13(1) or 17(1), or lawfully in the custody of the police or confined in any prison whether under subsection 13(1), subsection 17(1) or under an order of any court or otherwise howsoever, and notwithstanding any order of any court or other authority whatsoever, is required in the interests of justice, or for the purpose of any public or other inquiry, or in the national interest, or in the interests of the person detained, in custody or confined, the Commissioner General of Prison where the person is detained in a place of detention or prison, or the Inspector General of Police where the person is in the lawful custody of the police, may order that such person be taken to that place."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_21__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "Any person in the course of being taken to any place under subsection (1) and whilst at such place shall be kept in such custody as the Commissioner General of Prison or the Inspector General of Police, as the case may be, may direct and whilst in that custody shall be deemed to be in lawful custody."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_21__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "In this section, “Commissioner General of Prison” has the same meaning assigned to it by subsection 2(1) of the Prison Act 1995 [Act 537]. Registration"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_22__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_22__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_22__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_22__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_22__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "The Registrar shall keep a Register for the purposes of this Act, in which shall be entered the name of every restricted person and of every person in respect of whom a detention order is in force (whether suspended under section 15 or not), together with such particulars concerning any such person as may be prescribed; and upon the name and particulars of any such person being entered in the Register he shall be a “registered person” for the purposes of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_22__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_22__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_22__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "Any police officer not below the rank of Inspector may—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_22__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_22__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "visit any place referred to in subsection 13(2) for the purpose of taking finger impressions and photographs of any person detained therein and of obtaining such other particulars concerning any such person as may be prescribed or as may be necessary for effecting the registration of that person under subsection (1);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_22__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_22__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "by notice in writing direct the attendance before him, at a time and place specified in the notice, of any restricted person for the purpose of taking finger impressions and photographs of that person and of obtaining such other particulars concerning any such person as may be prescribed or as may be necessary for effecting the registration of that person under subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_22__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who, being required by a police officer not below the rank of Inspector to furnish the particulars referred to in paragraph (2)(a) or (b), refuses to furnish any such particulars or furnishes any particulars which he knows or has reason to believe to be false, commits an offence and shall be punished with a fine not exceeding ten thousand ringgit or with imprisonment for a term not exceeding three years or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_22__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "If any person fails to attend as directed under paragraph (2)(b), the police officer who issued the notice may cause him to be arrested without warrant by any police officer and brought before him for the purposes mentioned in that subsection. Removal of name from Register"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_23__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_23__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_23__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "Whenever an order under subsection 13(1) or 13(3), or a direction under subsection 17(1), expires or is revoked so that the person in respect of whom the order was made ceases to be subject to any restrictions or conditions whatsoever, the Registrar shall forthwith remove his name and all entries concerning him from the Register."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_23__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may at any time in its discretion direct the Registrar to remove the name of any person from the Register, and upon such removal the person shall cease to be a registered person, unless his name is subsequently re-entered in the Register in accordance with section 22. Registered person not to consort with other registered persons"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_24__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_24__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_24__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "No registered person shall consort or habitually associate with any other registered person without the permission of the Officer in Charge of the Police District in which he resides, unless he shall prove that he did not know and had no reason to suspect that such other person was a registered person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_24__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes the provisions of this section commits an offence and shall be punished with imprisonment for a term not exceeding fifteen years and not less than five years. Double penalties"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "Any registered person who is convicted of any offence committed after the date of the entry of his name in the Register under any written law shall be liable to imprisonment for a term of twice as long as the maximum term for which he would have been liable on conviction for that offence, and also to whipping. Loitering in public place, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_26__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_26__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_26__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV",
      "schema:name": {
        "@language": "en",
        "@value": "Any registered person who—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_26__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "is found between the hours of sunset and sunrise frequenting or loitering in or about any public place or in or in the neighbourhood of any place of public entertainment;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_26__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "at any time is found in the company of two or more registered persons; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_26__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "at any time is found in or near any place in which any act of violence or breach of the peace is being or has just been committed, and who is unable satisfactorily to account for his presence at such place or time or in such company commits an offence and shall be punished with imprisonment for a term not exceeding five years or to a fine not exceeding ten thousand ringgit or to both. Harbouring"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_27__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_27__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_27__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who knowingly harbours or conceals any person who enters any State, district, mukim, town or village in contravention of any order under section 13 commits an offence and shall be punished with imprisonment for a term not exceeding five years or to a fine not exceeding ten thousand ringgit or to both: provided that this subsection shall not apply to the case of a wife harbouring or concealing her husband or a husband harbouring or concealing his wife."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_27__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "Any person aware of the presence in any State, district, mukim, town or village of any person, not being the husband or wife of the first-mentioned person, who has been ordered not to enter the State, district, mukim, town or village or has been ordered to reside in any other State, district, mukim, town or village, and being aware also of the making of the order, shall in the absence of reasonable excuse, proof whereof shall lie on him, forthwith give information thereof to the nearest police officer or Magistrate, and in default of his so doing commits an offence and shall be punished with imprisonment for a term not exceeding three years or to a fine not exceeding five thousand or to both. Saving in respect of prosecution of persons detained"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "The detention of any person under this Part shall be without prejudice to the taking of any criminal proceeding against that person, whether during or after the period of his detention."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_I__cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Prevention of Terrorism Act"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_I__cl_2__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_I__cl_2__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_I__cl_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_I__cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "In this Act, unless the context otherwise requires— “district, mukim, town or village” means the land included in any district, mukim, town or village under the provisions of any law for the time being in force relating to land; “Register” means the register kept by the Registrar under section 22; “Board” means the Prevention of Terrorism Board established under section 8; “Minister” means the Minister charged with the responsibility for home affairs; “registered person” means a person whose name is entered in the Register; “listed terrorist organization” means any specified entity declared under sections 66b and 66c of the Anti-Money Laundering, Anti- Terrorism Financing and Proceeds of Unlawful Activities Act 2001 [Act 613]; “Inquiry Officer” means an officer appointed by the Minister under section 9; “Registrar” means the Registrar of Criminals appointed under section 3 of the Registration of Criminals and Undesirable Persons Act 1969 [Act 7]; “terrorist act” has the same meaning assigned to it by the Penal Code [Act 574]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_I__cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_I__cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "References to the supervision of the police shall be construed as references to the obligations imposed upon persons subject to police supervision under section 296 of the Criminal Procedure Code [Act 593]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V",
      "@type": "akn:part",
      "eli:number": "V",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_29",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_30",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_31",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_32",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_33",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_34",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_35"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "GENERAL Powers of police to investigate"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_29__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_29__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_29__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "When a police officer not below the rank of Inspector has reason to believe that grounds exist which would justify the holding of an inquiry into the case of any person under this Act, he or any police officer subordinate to him and acting under his orders may investigate the facts and circumstances of the case so far as they may be relevant to any proceedings in respect of that person under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_29__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "In making any investigation under subsection (1), a police officer may exercise all or any of the powers in relation to police investigations in any seizable case which are given to him by the law for the time being in force relating to criminal procedure. Arrest"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "A police officer may without a warrant arrest any person if he has reason to believe that the person has committed an offence against section 24, 26 or 27 and every such offence shall be seizable and non-bailable for the purposes of the Criminal Procedure Code. Taking of photographs and finger impressions"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_31__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_31__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_31__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_31__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "A police officer may take or cause to be taken the photograph and finger impressions of any person arrested under subsection 3(1), or whose name is required to be entered in the Register under section 22, and shall send the photograph and impressions to the Registrar for identification and report; and every such person shall be legally bound to submit to the taking of his photographs and finger impressions, and may be compelled thereto by the use of force if necessary."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_31__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who, being legally bound under subsection (1) to submit to the taking of his photographs or finger impressions, refuses or fails to submit thereto on demand commits an offence and shall be punished with imprisonment for a term not exceeding six months or to a fine not exceeding two thousand ringgit or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_31__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_31__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_31__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "Whenever—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_31__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_31__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "any person whose photograph and finger impressions have been taken under this section is released under section 4, 6 or 12; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_31__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_31__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the name of any person is removed from the Register under section 23, the officer in charge of the case shall forthwith notify the Registrar of the release or removal, and the Registrar shall, upon the application of the person, deliver to that person the sheet upon which his finger impressions have been made, together with the negative and all copies of any photograph taken of him and forwarded to the Registrar under this section. Disclosure of information"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_32__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_32__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "Nothing in this Act or in any regulations made under this Act shall require the Board, any member of the Board, any Inquiry Officer or any public servant to disclose facts or to produce documents which he considers—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_32__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "to be against the public interest to disclose or produce; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_32__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "would compromise the protection of a witness or his family or associates. Power to amend Schedule"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, by order published in the Gazette, amend the Schedule. Regulations"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_34",
      "@type": "akn:clause",
      "eli:number": "34",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_34__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_34__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_34__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may make regulations for carrying out the purposes of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_34__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_34__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_34__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_34__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_34__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_34__subsec_2__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to the generality of the powers conferred by subsection (1), such regulations may—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_34__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_34__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "prescribe the form of the Register, and such other forms as may be necessary or desirable to be used in connection with the matters dealt with in this Act or in any regulations made under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_34__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_34__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "require all or any class of registered persons to carry identity cards, provide for the form, issue, production, inspection, cancellation, alteration, endorsement on and replacement of those cards, and the substitution of those identity cards for identity cards issued to those persons under any other written law, and for all other matters necessary or desirable in connection with the cards or the carrying of the cards or the enforcement of the regulations, including the prescription of penalties not exceeding in respect of any offence a fine of five thousand ringgit or imprisonment for a term of three years or both;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_34__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_34__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "provide for the administration and management of the Board, including provisions on training for the members of the Board;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_34__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_34__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "provide for the maintenance and management of places of detention and for the discipline and treatment of persons detained in places of detention and different regulations may be made for different places of detention;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_34__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_34__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "provide for any other matter which under this Act is required or permitted to be prescribed. Saving and transitional"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_35",
      "@type": "akn:clause",
      "eli:number": "35",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_35__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_35__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_35__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_35__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall not affect any supervision order or detention order issued under the Prevention of Crime Act 1959 [Act 297] in relation to any person who was engaged in the commission or support of terrorist acts involving listed terrorist organizations in a foreign country or any part of a foreign country before the date of coming into operation of this Act and such person shall continue to be subject to the supervision order or detention order, as the case may be, for so long as the supervision order or detention order is in force."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_35__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall not affect any inquiry initiated under the Prevention of Crime Act 1959 in relation to any person who was engaged in the commission or support of terrorist acts involving listed terrorist organizations in a foreign country or any part of a foreign country which is pending at the date of coming into operation of this Act and such inquiry shall be continued until its conclusion under that Act as if this Act had not been enacted and where it is decided that a supervision order or detention order shall be issued, the supervision order or a detention order shall be issued under that Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_35__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~part_V__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall not affect any proceeding initiated under or pursuant to the Prevention of Crime Act 1959 in relation to any person who was engaged in the commission or support of terrorist acts involving listed terrorist organizations in a foreign country or any part of a foreign country which is pending at the date of coming into operation of this Act and such proceeding shall be continued until its conclusion under that Act as if this Act had not been enacted and after that, where any action is required in relation to a supervision order or a detention order issued under that Act which is the subject of such proceeding, such action shall be taken under that Act."
      }
    },
