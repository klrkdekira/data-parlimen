      "schema:text": {
        "@language": "en",
        "@value": "Terms and conditions:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~sched_1__para_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~sched_1__para_8",
      "schema:text": {
        "@language": "en",
        "@value": "to report to the nearest police station at/for every ……….....;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~sched_1__para_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~sched_1__para_8",
      "schema:text": {
        "@language": "en",
        "@value": "understands that all movements will be tracked and retained as an official record;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~sched_1__para_8__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~sched_1__para_8",
      "schema:text": {
        "@language": "en",
        "@value": "agrees to be required to report for device equipment checks if necessary;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~sched_1__para_8__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~sched_1__para_8",
      "schema:text": {
        "@language": "en",
        "@value": "to notify the police officer if there is any change of address;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~sched_1__para_8__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~sched_1__para_8",
      "schema:text": {
        "@language": "en",
        "@value": "to allow inspections of the device by the police officer;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~sched_1__para_8__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~sched_1__para_8",
      "schema:text": {
        "@language": "en",
        "@value": "to report to the nearest police station for removal of the device;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~sched_1__para_8__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~sched_1__para_8",
      "schema:text": {
        "@language": "en",
        "@value": "to return all the device equipment to the police officer;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~sched_1__para_8__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~sched_1__para_8",
      "schema:text": {
        "@language": "en",
        "@value": "to submit to procedures required by the police officer;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~sched_1__para_8__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~sched_1__para_8",
      "schema:text": {
        "@language": "en",
        "@value": "to maintain the device as instructed by the police officer;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~sched_1__para_8__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~sched_1__para_8",
      "schema:text": {
        "@language": "en",
        "@value": "to comply with any directions of the police officer;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~sched_1__para_8__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/eng@/~sched_1__para_8",
      "schema:text": {
        "@language": "en",
        "@value": "to comply with any other conditions as the court may determine. Failure to comply with the terms and conditions is an offence under subsection 7(6) of the Prevention of Terrorism Act 2015. I hereby agree to and shall comply with the terms and conditions as stated in this Form. ......................................................... ( )"
      }
    }
