      "schema:text": {
        "@language": "ms",
        "@value": "SIASATAN Lembaga Pencegahan Keganasan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_10__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_10__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_10__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_10__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_10__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_10__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_10__subsec_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila mana-mana orang dibawa di hadapan seorang Pegawai Siasatan di bawah seksyen 5, Pegawai Siasatan itu hendaklah menyiasat dan melapor secara bertulis kepada Lembaga sama ada terdapat alasan yang munasabah bagi mempercayai bahawa orang itu terlibat dengan perbuatan melakukan atau menyokong perbuatan keganasan yang melibatkan organisasi pengganas tersenarai di sesuatu negara asing atau di mana-mana bahagian sesuatu negara asing."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Siasatan yang diadakan di bawah subseksyen (1) hendaklah diadakan dengan cara dan mengikut tatacara yang diarahkan oleh Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_10__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_10__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_10__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_10__subsec_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_10__subsec_3__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_10__subsec_3__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Pegawai Siasatan boleh, bagi maksud mana-mana siasatan di bawah Akta ini—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_10__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_10__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "mendapatkan dan menerima segala keterangan, dalam apa-apa bentuk dan sama ada keterangan itu boleh diterima atau tidak boleh diterima di bawah mana-mana undang-undang bertulis yang sedang berkuat kuasa yang berhubungan dengan keterangan atau tatacara jenayah, yang difikirkannya perlu atau wajar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_10__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_10__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "memanggil dan memeriksa saksi atas sumpah atau ikrar, dan boleh bagi maksud itu mengendalikan apa-apa sumpah atau ikrar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_10__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_10__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "menghendaki pengemukaan apa-apa dokumen atau benda lain yang pada pendapatnya berkaitan dengan siasatan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_10__subsec_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_10__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "jika didapatinya perlu demi kepentingan awam atau untuk melindungi saksi atau keluarganya atau rakannya, menerima keterangan tanpa kehadiran orang yang menjadi subjek siasatan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_10__subsec_3__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_10__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "memberi apa-apa arahan yang perlu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_10__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud perenggan (3)(d), jika apa-apa keterangan diterima tanpa kehadiran orang yang menjadi subjek siasatan itu, Pegawai Siasatan hendaklah memberitahu orang itu mengenai isi keterangan itu, setakat yang didapatinya selaras dengan kepentingan awam atau keperluan untuk melindungi saksi atau keluarganya atau rakannya untuk berbuat sedemikian, dan hendaklah dalam tiap- tiap kes sedemikian memasukkan dalam mana-mana laporan yang dibuat di bawah perenggan 12(2)(a) suatu pernyataan mengenai hal keadaan yang keterangan itu telah diterima."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_10__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang dipanggil sebagai saksi di bawah subseksyen (3) yang tanpa alasan yang munasabah tidak hadir pada masa dan di tempat yang disebut dalam saman itu atau yang, setelah hadir, enggan menjawab mana-mana soalan yang dikemukakan kepadanya dengan sah atau mengemukakan apa-apa dokumen atau benda yang ada dalam kuasanya untuk dikemukakan, melakukan suatu kesalahan dan hendaklah dihukum dengan pemenjaraan selama tempoh tidak melebihi enam bulan atau denda tidak melebihi dua ribu ringgit atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_10__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Orang yang menjadi subjek siasatan itu dan saksi dalam suatu siasatan tidak boleh diwakili oleh peguam bela dan peguam cara dalam siasatan itu kecuali apabila keterangannya sendiri sedang diambil dan direkodkan oleh Pegawai Siasatan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_10__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendakwa Raya boleh hadir dalam sesuatu siasatan untuk membantu Pegawai Siasatan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_10__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh melalui peraturan-peraturan menetapkan elaun yang kena dibayar kepada saksi yang dipanggil di bawah subseksyen (3). Akses oleh Pegawai Siasatan kepada orang tahanan atau banduan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_11__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_11__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_11__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun mana-mana undang-undang bertulis yang lain, seseorang Pegawai Siasatan yang menjalankan suatu siasatan di bawah Akta ini hendaklah dibenarkan mempunyai akses kepada mana-mana orang yang dia mempunyai sebab untuk mempercayai ada kaitan dengan atau mempunyai apa-apa keterangan mengenai mana-mana kesalahan yang orang itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_11__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_11__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "sedang ditahan di bawah mana-mana undang-undang bertulis yang lain; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_11__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_11__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "berada dalam kurungan di penjara, sama ada disabitkan atau tidak."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada apa jua dalam seksyen ini boleh memberi kuasa subjek siasatan atau peguam bela dan peguam caranya atau wakilnya, jika ada, hadir di tempat tahanan atau penjara. Laporan Pegawai Siasatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_12__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Pegawai Siasatan hendaklah mengemukakan laporannya secara bertulis kepada Lembaga dalam tempoh yang ditetapkan oleh Menteri melalui peraturan-peraturan yang dibuat di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_12__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_12__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila laporan di bawah subseksyen (1) diterima—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_12__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_12__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "jika Lembaga bersetuju dengan Pegawai Siasatan bahawa terdapat alasan yang munasabah untuk mempercayai bahawa orang yang menjadi subjek siasatan terlibat dengan perbuatan melakukan atau menyokong perbuatan keganasan yang melibatkan organisasi pengganas tersenarai di sesuatu negara asing atau di mana-mana bahagian sesuatu negara asing, Lembaga hendaklah meneruskan tindakan di bawah seksyen 13;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_12__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_12__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "jika Lembaga bersetuju dengan Pegawai Siasatan bahawa tidak ada alasan yang munasabah untuk mempercayai bahawa orang yang menjadi subjek siasatan terlibat dengan perbuatan melakukan atau menyokong perbuatan keganasan yang melibatkan organisasi pengganas tersenarai di sesuatu negara asing atau di mana-mana bahagian sesuatu negara asing, Lembaga hendaklah dengan segera mengarahkan mana-mana orang yang mempunyai jagaan ke atas orang itu, dalam masa dua puluh empat jam dari penerimaan arahan itu, untuk membawa orang itu di hadapan Hakim Mahkamah Sesyen, yang hendaklah dengan itu melepaskan perintah reman yang dibuat di bawah seksyen 4 dan, jika tidak ada alasan lain yang berdasarkannya orang itu ditahan dengan sah, hendaklah memerintahkan pelepasannya dengan serta-merta."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_8__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_8__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_8__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_8__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_8__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_8__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_8__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_8__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_8__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu Lembaga Pencegahan Keganasan ditubuhkan yang terdiri daripada anggota yang berikut yang dilantik oleh Yang di-Pertuan Agong:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_8__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_8__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang Pengerusi, yang hendaklah seseorang yang berkelayakan undang-undang dengan pengalaman sekurang-kurangnya lima belas tahun dalam bidang undang-undang;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_8__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_8__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang Timbalan Pengerusi; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_8__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_8__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak kurang daripada tiga dan tidak lebih daripada enam anggota lain."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap anggota Lembaga hendaklah, melainkan jika dia meletakkan jawatan terlebih dahulu, memegang jawatan selama suatu tempoh yang tidak melebihi tiga tahun dan layak untuk dilantik semula sekali sahaja selama tempoh tiga tahun lagi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_8__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap anggota Lembaga boleh pada bila-bila masa meletakkan jawatannya dengan memberikan notis bertulis kepada Yang di-Pertuan Agong."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_8__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Pelantikan mana-mana anggota Lembaga boleh pada bila- bila masa dibatalkan oleh Yang di-Pertuan Agong."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_8__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Kuorum bagi mana-mana persidangan Lembaga adalah tiga anggota."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_8__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada Akta ini, Lembaga hendaklah menentukan tatacaranya sendiri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_8__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap anggota Lembaga hendaklah disifatkan sebagai seorang pekhidmat awam mengikut pengertian Kanun Keseksaan. Pelantikan Pegawai Siasatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_9__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh secara bertulis melantik mana-mana orang mengikut nama atau jawatan, dan sama ada secara am atau bagi mana-mana kes tertentu, sebagai Pegawai Siasatan bagi maksud Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_III__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun pegawai polis boleh dilantik sebagai Pegawai Siasatan. Kewajipan dan kuasa Pegawai Siasatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_3__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_3__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_3__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pegawai polis boleh tanpa waran menangkap mana-mana orang jika dia mempunyai sebab untuk mempercayai bahawa terdapat alasan yang menjustifikasikan siasatan diadakan mengenai kes orang itu di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila seseorang ditangkap di bawah subseksyen (1), kes itu hendaklah dirujuk oleh pegawai polis kepada Pendakwa Raya untuk mendapatkan arahan tidak lewat daripada tujuh hari dari tarikh penangkapan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_3__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang ditangkap di bawah subseksyen (1) hendaklah, melainkan jika dilepaskan terlebih dahulu, dibawa tanpa kelengahan yang tidak munasabah, dan dalam mana-mana hal dalam masa dua puluh empat jam (tidak termasuk masa bagi apa-apa perjalanan yang perlu) di hadapan seorang Majistret."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_3__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_3__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_3__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Pegawai polis yang membuat penyiasatan berkaitan dengan seseorang yang ditangkap di bawah seksyen ini hendaklah menyebabkan supaya suatu salinan laporan lengkap penyiasatan itu dikemukakan kepada—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_3__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_3__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Pegawai Siasatan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_3__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_3__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga, dalam apa-apa tempoh yang ditetapkan oleh Menteri melalui peraturan-peraturan yang dibuat di bawah Akta ini. Tatacara di hadapan Majistret"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_4__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_4__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_4__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_4__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_4__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_4__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_4__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila mana-mana orang dibawa di hadapan seorang Majistret di bawah subseksyen 3(3), Majistret hendaklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_4__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "atas pengemukaan pernyataan bertulis yang ditandatangani oleh seorang pegawai polis yang berpangkat tidak rendah daripada Inspektor yang menyatakan bahawa terdapat alasan untuk mempercayai bahawa nama orang yang terlibat dengan perbuatan melakukan atau menyokong perbuatan keganasan yang melibatkan organisasi pengganas tersenarai di sesuatu negara asing atau di mana-mana bahagian sesuatu negara asing patut dicatatkan dalam Daftar, mereman orang itu dalam jagaan polis selama tempoh dua puluh satu hari; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_4__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika tiada pernyataan sedemikian dikemukakan, dan tiada alasan lain bagi menahan orang itu dengan sah, mengarahkan pelepasannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_4__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_4__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang direman di bawah perenggan (1)(a) hendaklah, melainkan jika dilepaskan terlebih dahulu, pada atau sebelum habis tempoh remannya, dibawa di hadapan seorang Majistret, yang hendaklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_4__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_4__subsec_2__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_4__subsec_2__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_4__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "atas pengemukaan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_4__subsec_2__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_4__subsec_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu pernyataan bertulis yang ditandatangani oleh Pendakwa Raya yang menyatakan bahawa pada pendapatnya terdapat keterangan yang mencukupi untuk menjustifikasikan suatu siasatan diadakan di bawah seksyen 10; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_4__subsec_2__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_4__subsec_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu pernyataan bertulis yang ditandatangani oleh seorang pegawai polis yang berpangkat tidak rendah daripada Penolong Penguasa yang menyatakan bahawa terdapat tujuan untuk mengadakan suatu siasatan mengenai kes orang itu di bawah seksyen 10, memerintahkan orang itu direman dalam jagaan selama tempoh tiga puluh lapan hari; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_4__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_4__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "jika tiada pernyataan sedemikian dikemukakan, dan tiada alasan lain bagi menahan orang itu dengan sah, mengarahkan pelepasannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_4__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh ditangkap dan ditahan di bawah seksyen ini semata-mata atas kepercayaan politiknya atau aktiviti politiknya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_4__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Kecuali sebagaimana yang diperuntukkan dalam subseksyen 10(6), peruntukan seksyen 28a Kanun Tatacara Jenayah hendaklah terpakai bagi mana-mana orang yang direman di bawah seksyen 4."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_4__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendakwa Raya boleh hadir dalam mana-mana permohonan yang dibuat di bawah seksyen ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_4__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_4__subsec_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_4__subsec_6__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_4__subsec_6__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini, “kepercayaan politik atau aktiviti politik” ertinya penglibatan dalam aktiviti yang sah di sisi undang- undang melalui—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_4__subsec_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_4__subsec_6__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_4__subsec_6__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_4__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "pernyataan pendapat atau pengambilan tindakan yang dibuat mengikut rukun sesuatu parti politik yang pada masa yang berkaitan itu berdaftar di bawah Akta Pertubuhan 1966 [Akta 335] yang terbukti melalui—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_4__subsec_6__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_4__subsec_6__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "keanggotaan atau sumbangan kepada parti itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_4__subsec_6__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_4__subsec_6__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "penyertaan terbuka dan aktif dalam hal ehwal parti itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_4__subsec_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_4__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "pernyataan pendapat yang ditujukan terhadap mana-mana kerajaan di dalam Malaysia; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_4__subsec_6__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_4__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "pengambilan tindakan yang ditujukan terhadap mana-mana kerajaan di dalam Malaysia. Orang dalam jagaan hendaklah dibawa di hadapan Pegawai Siasatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap orang yang direman dalam jagaan di bawah seksyen 4 hendaklah, jika tidak dilepaskan terlebih dahulu, seberapa segera yang boleh dibawa di hadapan seorang Pegawai Siasatan. Pelepasan orang yang direman dalam jagaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_6__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_6__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_6__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_6__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang direman dalam jagaan di bawah seksyen 4 boleh pada bila-bila masa dibawa di hadapan seorang Hakim Mahkamah Sesyen yang, jika tiada alasan lain bagi menahan orang itu dengan sah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_6__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah mengarahkan pelepasannya jika dikemukakan kepada Hakim Mahkamah Sesyen itu suatu pernyataan bertulis yang ditandatangani oleh seorang pegawai polis yang berpangkat tidak rendah daripada Penolong Penguasa yang menyatakan bahawa tidak terdapat tujuan untuk meneruskan suatu siasatan mengenai kes orang itu di bawah seksyen 10; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_6__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_6__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_6__subsec_1__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam mana-mana hal lain, atas permohonan seorang pegawai polis, boleh mengarahkan pelepasannya tertakluk kepada—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_6__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_6__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "pelaksanaan suatu bon oleh orang itu, dengan atau tanpa penjamin, bagi kehadirannya dengan sewajarnya di tempat atau tempat-tempat dan pada masa atau masa-masa dan dalam tempoh yang tidak melebihi lima puluh sembilan hari sebagaimana yang diarahkan oleh Hakim Mahkamah Sesyen; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_6__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_6__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "pengawasan polis selama apa-apa tempoh yang tidak melebihi lima puluh sembilan hari sebagaimana yang diarahkan oleh Hakim Mahkamah Sesyen."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seseorang dilepaskan di bawah perenggan (1)(b), suatu peranti pengawasan elektronik hendaklah dipasang pada orang itu mengikut subseksyen (3) dan (4)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika pegawai polis itu bertujuan untuk melepaskan orang itu di bawah perenggan (1)(b) dan memasang suatu peranti pengawasan elektronik pada orang itu apabila orang itu dilepaskan, dia hendaklah mengemukakan suatu laporan kepada Pendakwa Raya sebelum permohonan di bawah perenggan (1)(b) dibuat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_6__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila laporan di bawah subseksyen (3) diterima, Pendakwa Raya boleh memohon kepada Hakim Mahkamah Sesyen untuk orang itu dipasang dengan suatu peranti pengawasan elektronik mengikut seksyen 7 selama tempoh pelepasannya sebagaimana yang dibenarkan di bawah perenggan (1)(b). Tatacara khas yang berhubungan dengan peranti pengawasan elektronik"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_7__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_7__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_7__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_7__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_7__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_7__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_7__subsec_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila permohonan oleh Pendakwa Raya dibuat di bawah seksyen 6, Hakim Mahkamah Sesyen hendaklah memerintahkan supaya orang itu dipasang dengan suatu peranti pengawasan elektronik selama tempoh yang ditentukan oleh Hakim Mahkamah Sesyen itu tetapi tempoh itu tidak boleh melebihi tempoh pelepasannya sebagaimana yang dibenarkan di bawah perenggan 6(1)(b)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Hakim Mahkamah Sesyen hendaklah menjelaskan pengendalian peranti pengawasan elektronik serta terma dan syarat peranti pengawasan elektronik itu kepada orang itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_7__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Orang itu hendaklah menandatangani suatu borang yang dinyatakan dalam Jadual dan mendepositkan borang itu dengan Hakim Mahkamah Sesyen itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_7__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Orang itu hendaklah dipasang dengan peranti pengawasan elektronik oleh seorang pegawai polis."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_7__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Orang itu hendaklah mematuhi semua terma dan syarat peranti pengawasan elektronik dan hendaklah melaporkan diri di balai polis yang terdekat pada masa yang dinyatakan dalam borang itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_7__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang tidak mematuhi terma dan syarat di bawah subseksyen (5) melakukan suatu kesalahan dan hendaklah dihukum dengan pemenjaraan selama tempoh tidak melebihi tiga tahun."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_7__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang mengganggu, atau merosakkan, peranti pengawasan elektronik melakukan suatu kesalahan dan hendaklah dihukum dengan pemenjaraan selama tempoh tidak melebihi tiga tahun dan orang itu boleh dipertanggungkan untuk membayar bagi apa-apa kerosakan kepada peranti pengawasan elektronik itu yang berbangkit daripada perbuatannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_7__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila habis tempoh yang disebut dalam subseksyen (1), orang itu hendaklah melaporkan diri di balai polis yang terdekat untuk membuka peranti pengawasan elektronik itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_13",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_14",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_15",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_16",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_17",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_18",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_19",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_20",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_21",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_22",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_23",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_24",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_25",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_26",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_27",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_28"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "PERINTAH TAHANAN DAN SEKATAN Kuasa untuk memerintahkan tahanan dan sekatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "(1) Bilamana Lembaga, selepas menimbangkan— (a) laporan lengkap penyiasatan yang dikemukakan di bawah subseksyen 3(4); dan (b) laporan Pegawai Siasatan yang dikemukakan di bawah seksyen 12, berpuas hati berkenaan dengan mana-mana orang bahawa orang itu telah atau sedang terlibat dengan perbuatan melakukan atau menyokong perbuatan keganasan yang melibatkan organisasi pengganas tersenarai di sesuatu negara asing atau di mana-mana bahagian sesuatu negara asing, Lembaga boleh, jika Lembaga berpuas hati bahawa adalah perlu demi kepentingan keselamatan Malaysia atau mana-mana bahagian Malaysia yang orang itu ditahan, melalui perintah (“perintah tahanan”) mengarahkan supaya orang itu ditahan selama tempoh yang tidak melebihi dua tahun. (2) Tiap-tiap orang yang ditahan menurut suatu perintah tahanan hendaklah ditahan di mana-mana tempat (“tempat tahanan”) yang diarahkan oleh Lembaga dan mengikut apa-apa arahan yang dikeluarkan oleh Lembaga dan mana-mana peraturan yang dibuat di bawah seksyen 34. (3) Jika Lembaga berpuas hati bahawa bagi maksud yang disebut dalam subseksyen (1) adalah perlu supaya kawalan dan pengawasan dibuat ke atas mana-mana orang atau bahawa sekatan dan syarat patut dikenakan ke atas orang itu berkenaan dengan aktivitinya, kebebasannya bergerak atau tempat kediamannya atau tempat kerjanya, tetapi tidak perlu menahan orang itu bagi maksud itu, Lembaga boleh melalui perintah (“perintah sekatan”) mengarahkan supaya orang yang dinamakan dalam perintah itu (“orang sekatan”) hendaklah tertakluk kepada pengawasan polis selama apa-apa tempoh yang tidak melebihi lima tahun pada sesuatu masa dan boleh mengenakan semua atau mana-mana daripada sekatan dan syarat yang berikut: (a) dia dikehendaki bermastautin di dalam had mana-mana Negeri, daerah, mukim, bandar atau kampung yang dinyatakan dalam perintah itu; (b) dia tidak dibenarkan berpindah tempat bermastautinnya ke mana-mana Negeri, daerah, mukim, bandar atau kampung yang lain, mengikut mana-mana yang berkenaan, tanpa kebenaran bertulis Lembaga; (c) kecuali setakat yang diperuntukkan selainnya oleh perintah itu, dia tidak boleh meninggalkan Negeri, daerah, mukim, bandar atau kampung yang di dalamnya dia bermastautin tanpa kebenaran bertulis daripada Ketua Polis Negeri yang berkenaan; (d) dia hendaklah pada setiap masa memberitahu Ketua Polis Daerah di mana dia bermastautin mengenai rumah atau tempat di mana dia bermastautin; (e) dia hendaklah, pada masa atau masa-masa yang dinyatakan dalam perintah itu, menghadirkan dirinya di balai polis yang terdekat; (f) dia hendaklah berada di dalam rumah, atau di dalam kawasan yang ditakrifkan dalam perintah itu, pada masa yang dinyatakan dalam perintah itu, melainkan jika dia memperoleh kebenaran khas selainnya daripada Ketua Polis Daerah; (g) kecuali setakat yang diperuntukkan selainnya oleh perintah itu, dia tidak dibenarkan untuk memasuki mana-mana Negeri, daerah, mukim, bandar atau kampung yang dinyatakan dalam perintah itu; (h) dia hendaklah hanya menggunakan kelengkapan dan kemudahan komunikasi yang diisytiharkan pada dan diluluskan oleh Ketua Polis Negeri mana-mana Negeri yang berkenaan; (i) kecuali setakat yang diperuntukkan selainnya oleh perintah itu, dia tidak boleh membuat capaian internet; (j) dia hendaklah menjaga keamanan dan berkelakuan baik; (k) dia hendaklah mengikat suatu bon, dengan atau tanpa penjamin sebagaimana yang diarahkan oleh Lembaga dan bagi suatu amaun yang dinyatakan dalam perintah itu, bagi pematuhannya yang sewajarnya dengan sekatan dan syarat yang dikenakan ke atasnya oleh perintah itu; (l) dia hendaklah dipasang dengan suatu peranti pengawasan elektronik. (4) Lembaga boleh, melalui perintah bertulis yang disampaikan kepada orang yang tertakluk kepada suatu perintah sekatan, mengubah, mengkansel atau menambah kepada mana-mana sekatan dan syarat yang dikenakan di bawah subseksyen (3). (5) Mana-mana orang sekatan yang tidak mematuhi mana-mana sekatan atau syarat yang dikenakan ke atasnya di bawah seksyen ini melakukan suatu kesalahan dan hendaklah dihukum dengan pemenjaraan selama tempoh yang tidak melebihi sepuluh tahun dan tidak kurang daripada dua tahun. (6) Mana-mana orang yang berkomplot dengan, bersubahat atau membantu mana-mana orang sekatan untuk melanggar mana- mana sekatan atau syarat di bawah seksyen ini melakukan suatu kesalahan dan hendaklah dihukum dengan pemenjaraan selama tempoh yang tidak melebihi sepuluh tahun dan tidak kurang daripada dua tahun. (7) Seksyen 173a dan 294 Kanun Tatacara Jenayah tidak terpakai berkenaan dengan kesalahan di bawah subseksyen (5) dan (6). (8) Hukuman yang dikenakan di bawah subseksyen (5) dan apa-apa tempoh pemenjaraan yang dikenakan di bawah mana- mana undang-undang bertulis tidak boleh dipertimbangkan bagi maksud tempoh pengawasan yang dikenakan di bawah subsekyen (3) dan tempoh pengawasan itu hendaklah diteruskan dari tarikh tamat hukuman pemenjaraan yang dikenakan. (9) Suatu salinan tiap-tiap perintah tahanan yang dibuat oleh Lembaga di bawah subseksyen (1) hendaklah disampaikan kepada orang yang kepadanya perintah itu berkaitan seberapa segera yang boleh selepas perintah itu dibuat, dan tiap-tiap orang sedemikian adalah berhak membuat representasi kepada suatu Lembaga Penasihat yang ditubuhkan di bawah Fasal (2) Perkara 151 Perlembagaan Persekutuan mengikut tatacara yang ditetapkan. (10) Arahan Lembaga di bawah subseksyen (1) hendaklah tertakluk kepada kajian semula oleh Mahkamah Tinggi. Kesahan perintah tahanan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_14__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_14__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada perintah tahanan boleh menjadi tidak sah atau tidak berkuat kuasa oleh sebab—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_14__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_14__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_14__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_14__para_a__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "orang yang terhadapnya perintah tahanan itu dimaksudkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_14__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_14__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "telah sebaik sebelum perintah tahanan itu dibuat ditahan di mana-mana tempat selain tempat tahanan yang disebut dalam subseksyen 13(2);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_14__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_14__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "terus ditahan sebaik selepas perintah tahanan itu dibuat di tempat yang dia telah ditahan di bawah seksyen 3 sebelum dia dipindahkan ke suatu tempat tahanan yang disebut dalam subseksyen 13(2); atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_14__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_14__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "telah semasa jangka masa perintah tahanan itu berada dalam perjalanan dalam jagaan polis atau dalam apa-apa jagaan lain ke suatu tempat tahanan yang disebut dalam subseksyen 13(2); atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_14__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "perintah tahanan itu telah disampaikan kepadanya di mana- mana tempat selain tempat tahanan yang disebut dalam subseksyen 13(2), atau terdapat apa-apa kecacatan yang berhubungan dengan penyampaian perintah tahanan itu kepadanya. Penggantungan perintah tahanan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_15__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_15__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_15__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_15__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_15__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga boleh, pada bila-bila masa, mengarahkan supaya kuat kuasa mana-mana perintah tahanan di bawah subseksyen 13(1) digantung tertakluk kepada pengenaan semua atau mana-mana daripada sekatan dan syarat di bawah subseksyen 13(3)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu perintah tahanan digantung di bawah subseksyen (1), subseksyen 13(3) hendaklah berkuat kuasa seolah-olah sekatan dan syarat yang berdasarkannya perintah tahanan itu digantung adalah sekatan dan syarat yang dikenakan oleh suatu perintah sekatan yang dibuat di bawah subseksyen 13(3)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_15__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_15__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_15__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga boleh membatalkan penggantungan mana-mana perintah tahanan jika Lembaga berpuas hati bahawa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_15__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_15__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "orang yang terhadapnya perintah tahanan itu dibuat tidak mematuhi mana-mana sekatan atau syarat yang dikenakan ke atasnya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_15__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_15__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "adalah perlu demi ketenteraman awam atau keselamatan awam untuk penggantungan itu dibatalkan, dan dalam mana-mana hal sedemikian pembatalan penggantungan itu hendaklah menjadi kuasa yang mencukupi bagi mana-mana pegawai polis untuk menangkap semula tanpa waran orang yang terhadapnya perintah tahanan itu telah dibuat, dan orang itu hendaklah seberapa cepat yang dapat dilaksanakan dikembalikan ke tempat tahanannya yang terdahulu atau, jika diarahkan sedemikian oleh Lembaga, dihantar ke suatu tempat tahanan yang lain."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_15__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Penggantungan mana-mana perintah tahanan di bawah seksyen ini hendaklah, tertakluk kepada subseksyen 13(4) sebagaimana yang terpakai oleh subseksyen (2) dan tertakluk juga kepada subseksyen (3), terus berkuat kuasa bagi bahagian tempoh perintah itu yang belum tamat yang dinyatakan di bawah subseksyen 13(1). Kesan atas tempoh pemenjaraan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_16__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_16__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV",
      "schema:name": {
        "@language": "ms",
        "@value": "Jika seseorang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_16__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "yang sedang menjalani tahanan di bawah subseksyen 13(1) dihukum dengan apa-apa tempoh pemenjaraan di bawah Akta ini atau mana-mana undang-undang bertulis yang lain; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_16__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "telah dilanjutkan tempoh tahanannya di bawah subseksyen 17(1) semasa dia sedang menjalani mana-mana tempoh pemenjaraan itu, tahanan atau tahanan lanjut itu hendaklah disifatkan telah dijalani serentak dengan tempoh pemenjaraan itu, dan jika setelah tempoh pemenjaraan itu selesai, masih ada mana-mana bahagian tempoh tahanan atau tempoh tahanan lanjut yang belum tamat, dia hendaklah ditahan bagi bahagian tempoh yang belum tamat itu. Kuasa Lembaga untuk melanjutkan perintah tahanan, perintah sekatan atau perintah tahanan yang digantung"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~part_IV__cl_17__subsec_2",
