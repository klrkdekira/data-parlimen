        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~sched_1__para_8__para_k"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~sched_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Terma-terma dan syarat-syarat:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~sched_1__para_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~sched_1__para_8",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk melaporkan diri di balai polis yang terdekat pada/bagi tiap-tiap ...................…;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~sched_1__para_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~sched_1__para_8",
      "schema:text": {
        "@language": "ms",
        "@value": "memahami bahawa semua pergerakan akan dijejaki dan disimpan sebagai rekod rasmi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~sched_1__para_8__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~sched_1__para_8",
      "schema:text": {
        "@language": "ms",
        "@value": "bersetuju untuk dikehendaki untuk melaporkan diri bagi pemeriksaan kelengkapan peranti jika perlu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~sched_1__para_8__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~sched_1__para_8",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memberitahu pegawai polis jika terdapat apa-apa pertukaran alamat;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~sched_1__para_8__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~sched_1__para_8",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk membenarkan pemeriksaan peranti oleh pegawai polis;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~sched_1__para_8__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~sched_1__para_8",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk melaporkan diri di balai polis yang terdekat bagi peranti itu dibuka;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~sched_1__para_8__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~sched_1__para_8",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memulangkan semua kelengkapan peranti kepada pegawai polis;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~sched_1__para_8__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~sched_1__para_8",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mematuhi tatacara yang dikehendaki oleh pegawai polis;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~sched_1__para_8__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~sched_1__para_8",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menyenggara peranti sebagaimana yang diarahkan oleh pegawai polis;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~sched_1__para_8__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~sched_1__para_8",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mematuhi apa-apa arahan pegawai polis;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~sched_1__para_8__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~sched_1__para_8",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mematuhi apa-apa syarat lain yang ditentukan oleh mahkamah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~sched_1__para_9",
      "@type": "akn:paragraph",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/10/msa@/~sched_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketidakpatuhan terma-terma dan syarat-syarat ini merupakan suatu kesalahan di bawah subseksyen 7(6) Akta Pencegahan Keganasan 2015. Saya dengan ini bersetuju dan akan mematuhi terma-terma dan syarat-syarat sebagaimana yang dinyatakan dalam Borang ini. …………………………………… ( )"
      }
    }
  ]
}
