      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/11/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/11/msa@/~cl_9__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/11/msa@/~cl_9__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “Tertakluk kepada apa-apa pengecualian yang” dengan perkataan “Tertakluk kepada apa-apa pengecualian yang diberikan di bawah Akta ini”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/11/msa@/~cl_9__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/11/msa@/~cl_9__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam teks bahasa kebangsaan, dengan menggantikan perkataan “mengikut terma sesuatu lesen yang membenarkan dengan nyata” dengan perkataan “mengikut terma dan syarat sesuatu lesen sebagaimana yang ditetapkan yang membenarkan”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/11/msa@/~cl_9__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/11/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2), dengan memasukkan sebelum perkataan “syarat” perkataan “terma dan”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/11/msa@/~cl_9__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/11/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (2a) subseksyen yang berikut: “(2b) Walau apa pun subseksyen (2), Suruhanjaya boleh memberikan suatu lesen apabila fi dibayar dan atas apa-apa syarat sebagaimana yang ternyata dikehendaki atau suai manfaat memandangkan tugas yang dikenakan oleh seksyen 4 berkenaan dengan apa-apa pepasangan yang ditetapkan. ( 2c) Suruhanjaya boleh, dari semasa ke semasa, mengeluarkan kod, garis panduan atau arahan berkenaan dengan apa-apa pepasangan.”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/11/msa@/~cl_9__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/11/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (6) subseksyen yang berikut: “(7) Suruhanjaya boleh, dengan kelulusan Menteri, pada bila-bila masa— (a) mengenakan apa-apa terma atau syarat tambahan ke atas lesen, termasuk lesen sedia ada; atau (b) meminda apa-apa terma atau syarat yang dikenakan ke atas lesen itu, mengikut tatacara sebagaimana yang boleh ditetapkan.”. Seksyen baru 9a, 9b, 9c, 9d dan 9e"
      }
    }
  ]
}
