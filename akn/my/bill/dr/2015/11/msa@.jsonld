      "schema:text": {
        "@language": "ms",
        "@value": "dalam subsekyen (2)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/11/msa@/~cl_40__para_b__subpara_i",
