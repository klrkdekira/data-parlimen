      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (4)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/11/msa@/~cl_30__para_d__subpara_i",
      "@type": "akn:subparagraph",
