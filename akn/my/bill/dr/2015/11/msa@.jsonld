    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/11/msa@/~cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/11/msa@/~cl_30__para_a",
