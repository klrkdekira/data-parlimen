      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (5), dengan memasukkan selepas perkataan “kegunaan sedemikian” perkataan “dan boleh termasuk meter prabayar, infrastruktur pemeteran, telepemeteran atau apa-apa cara pemeteran lain sebagaimana yang ditentukan oleh Suruhanjaya”. Pindaan seksyen 33"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/11/msa@/~cl_25",
