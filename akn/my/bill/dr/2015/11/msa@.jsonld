      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “lima ribu” dengan perkataan “dua puluh ribu”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/11/msa@/~cl_40__para_b__subpara_ii",
      "@type": "akn:subparagraph",
