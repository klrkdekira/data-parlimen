      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (14)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/11/msa@/~cl_28__para_f__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
