      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “pemegang lesen” perkataan “yang membekalkan elektrik”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/11/msa@/~cl_24__para_f",
      "@type": "akn:paragraph",
