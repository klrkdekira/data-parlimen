        "@value": "dalam perenggan (a)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/11/msa@/~cl_30__para_d__subpara_ii__subpara_A",
      "@type": "akn:subparagraph",
