        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/11/msa@/~cl_8__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/11/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 8 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/11/msa@/~cl_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/11/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan “atau” di hujung perenggan (c);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/11/msa@/~cl_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/11/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan (c) perenggan yang berikut: “ (ca) enggan untuk memberi mana-mana pegawai Suruhanjaya apa-apa maklumat yang dengan munasabahnya mungkin dikehendaki daripadanya dan yang ada dalam pengetahuannya atau yang dia mempunyai kuasa untuk memberikan berhubung dengan apa-apa perkara di bawah fungsi, tugas dan kuasa Suruhanjaya di bawah seksyen 4; atau”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/11/msa@/~cl_8__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/11/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “lima ribu” dengan perkataan “lima puluh ribu”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/11/msa@/~cl_8__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/11/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “dua tahun” dengan perkataan “tiga tahun”. Pindaan seksyen 9"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/11/msa@/~cl_9",
