      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (i), dengan memotong perkataan “bentuk dan kandungan lesen dan syarat-syarat yang hendak ditetapkan,” dan perkataan “lesen dan”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/11/msa@/~cl_40__para_a__subpara_ii",
      "@type": "akn:subparagraph",
