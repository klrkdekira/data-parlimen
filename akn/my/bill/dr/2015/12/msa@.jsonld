      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Keterangan (Pindaan) 2015. Seksyen baru 32a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/12/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/12/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Keterangan 1950 [Akta 56] dipinda dengan memasukkan selepas seksyen 32 seksyen yang berikut: “Admissibility of evidence given under section 265a of the Criminal Procedure Code 32a. Notwithstanding any other provision in this Act, evidence taken in accordance with section 265a of the Criminal Procedure Code shall be admissible in any criminal proceedings.”. Rang Undang-Undang"
      }
    }
