        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/14/eng@/~cl_20__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/14/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 17 of the principal Act is amended—"
      }
    },
    {
