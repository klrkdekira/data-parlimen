        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/14/eng@/~cl_17__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/14/eng@",
      "schema:name": {
