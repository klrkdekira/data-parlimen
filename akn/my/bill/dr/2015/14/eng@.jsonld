      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the shoulder note the following shoulder note: “Delegation of Board’s and Chairman’s functions”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/14/eng@/~cl_20__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/14/eng@/~cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (1) the following subsection: “(1) The Board may delegate any of its functions to— (a) any of the members of the Board; (b) any Board committee established by the Board; or (c) any officer of the Commission.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/14/eng@/~cl_20__para_c",
