      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/14/eng@/~cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the word “Commission” wherever appearing the word “Board”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/14/eng@/~cl_15__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/14/eng@/~cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (1) the following subsection: “(1a) The Chairman shall preside at all meetings of the Board.”. Substitution of section 11"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/14/eng@/~cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/14/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by substituting for section 11 the following section: “Board may invite others to meeting 11. The Board may invite any person to attend any meeting or deliberation of the Board for the purpose of advising the Board on any matter under discussion, but the person so invited shall not be entitled to vote at the said meeting or deliberation.”. Amendment of section 13"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/14/eng@/~cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
