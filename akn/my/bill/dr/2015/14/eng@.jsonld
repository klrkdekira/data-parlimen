      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/14/eng@/~cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (1) the following subsection: “(1) A member of the Board or any member of the Board committee who has or acquires a direct or indirect interest in relation to any matter under discussion by the Board or Board committee shall disclose to the Board or Board committee, as the case may be, the existence of his interest and the nature of that interest.”;"
      }
