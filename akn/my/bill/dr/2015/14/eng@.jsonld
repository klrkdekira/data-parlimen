      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/14/eng@/~cl_5"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/14/eng@/~cl_5__list_2__para_a",
