      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Securities Commission (Amendment) Act 2015."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/14/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
