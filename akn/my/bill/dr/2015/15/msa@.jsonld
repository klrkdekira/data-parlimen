      ],
      "schema:name": {
        "@language": "ms",
        "@value": "Rang Undang-undang Kumpulan Wang Persaraan (Pindaan) 2015"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini boleh dinamakan Akta Kumpulan Wang Persaraan (Pindaan) 2015."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta. Pindaan seksyen 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Kumpulan Wang Persaraan 2007 [Akta 662], yang disebut “Akta ibu” dalam Akta ini, dipinda dalam seksyen 2—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan sebelum takrif “jawatankuasa” takrif yang berikut: ‘ “debentur” termasuklah stok debentur, bon, nota dan apa-apa sekuriti lain sesuatu syarikat atau perbadanan sama ada membentuk suatu gadaian atau tidak ke atas aset syarikat atau perbadanan itu;’;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_2__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_2__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_2__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam takrif “sekuriti”—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (b), dengan memotong perkataan “dan” di hujung perenggan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perenggan (c) dengan perenggan yang berikut: “ (c) amanah saham, dana dagangan bursa atau surat cara yang ditetapkan; dan”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_2__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan (c) perenggan yang berikut: “ (d) apa-apa sekuriti Islam,”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam takrif “syarikat”, dengan memasukkan selepas perkataan “[Akta 125]” perkataan “, suatu syarikat amanah yang diperbadankan di bawah Akta Syarikat Amanah 1949 [Akta 100] atau mana-mana syarikat yang diperbadankan di bawah mana-mana undang-undang bertulis”. Seksyen baru 4a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memasukkan selepas seksyen 4 seksyen yang berikut: “Kumpulan Wang Persaraan (Diperbadankan) boleh bertindak sebagai ejen Kerajaan 4a. (1) Kumpulan Wang Persaraan (Diperbadankan) boleh bertindak sebagai ejen Kerajaan Malaysia bagi maksud pembayaran apa-apa pencen, ganjaran atau faedah lain yang diberikan di bawah mana-mana undang-undang bertulis daripada Kumpulan Wang Disatukan mengikut apa-apa cara sebagaimana yang dipersetujui antara Kerajaan Malaysia dengan Kumpulan Wang Persaraan (Diperbadankan). (2) Kumpulan Wang Persaraan (Diperbadankan) boleh dibayar oleh Kerajaan Malaysia bagi perkhidmatan yang diberikan olehnya sebagai ejen Kerajaan Malaysia di bawah subseksyen (1).”. Pindaan seksyen 6"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan 6(4)(f) Akta ibu dipinda dengan memasukkan selepas perkataan “perniagaan” perkataan “, pelaburan, perbankan”. Pindaan seksyen 7"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 7(2) Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perenggan (b); dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perenggan (e) dengan perenggan yang berikut: “ (e) empat orang daripada sektor awam atau swasta yang mempunyai pengalaman dan kepakaran dalam perniagaan, pelaburan, perbankan atau kewangan.”. Pindaan seksyen 13"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_6__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 13 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_6__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_6__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_6__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_6__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan “dan” di hujung perenggan (d);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_6__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_6__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan (d) perenggan yang berikut: “ (da) wang yang diterima oleh Kumpulan Wang Persaraan (Diperbadankan) bagi perkhidmatan yang diberikan oleh Kumpulan Wang Persaraan (Diperbadankan) kepada Kerajaan Malaysia sebagai ejennya di bawah seksyen 4a; dan” dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (5), dengan memotong perkataan “bagi pegawai perkhidmatan awam dan pekerja pihak berkuasa berkanun dan tempatan”. Pindaan seksyen 14"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_7__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_7__para_ja"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 14 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_7__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_7__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_7__para_a__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_7__para_a__subpara_iv",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_7__para_a__subpara_v",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_7__para_a__subpara_vi"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_7__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_7__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perenggan (a) dengan perenggan yang berikut: “ (a) sebagai deposit dalam apa-apa mata wang termasuk ringgit dalam— (i) Bank Negara Malaysia; (ii) mana-mana institusi kewangan berlesen yang sewajarnya sebagaimana yang ditakrifkan di bawah Akta Perkhidmatan Kewangan 2013 [Akta 758]; (iii) mana-mana institusi kewangan pembangunan sebagaimana yang ditakrifkan di bawah Akta Institusi Kewangan Pembangunan 2002 [Akta 618]; (iv) mana-mana bank Islam di bawah Akta Perkhidmatan Kewangan Islam 2013 [Akta 759]; atau (v) mana-mana bank atau institusi kewangan berlesen yang sewajarnya di luar Malaysia;”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_7__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_7__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (b), dengan menggantikan perkataan “dan perakuan deposit” dengan perkataan “, perakuan deposit dan apa-apa surat cara yang diiktiraf oleh badan pengawal selia yang berkaitan”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_7__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_7__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (d), dengan memasukkan selepas perkataan “Kumpulan Wang Persaraan (Diperbadankan)” perkataan “dan dengan kriteria kredit yang boleh diterima”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_7__para_a__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_7__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (h), dengan menggantikan perkataan “*Akta Perindustrian Sekuriti 1983 [Akta 280]” dengan perkataan “Akta Pasaran Modal dan Perkhidmatan 2007 [Akta 671] atau sekuriti dalam suatu syarikat yang telah diluluskan untuk disenaraikan di mana-mana bursa saham di luar Malaysia tertakluk kepada penyenaraian sekuriti tersebut telah diluluskan oleh undang-undang dalam bidang kuasa asing”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_7__para_a__subpara_v",
      "@type": "akn:subparagraph",
      "eli:number": "v",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_7__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (j), dengan memotong perkataan “dan” di hujung perenggan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_7__para_a__subpara_vi",
      "@type": "akn:subparagraph",
      "eli:number": "vi",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/15/msa@/~cl_7__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan (j) perenggan yang berikut: “ (ja) dengan kelulusan Menteri— (i) dalam pembangunan bangunan, infrastruktur dan sumber asli, dan kepentingan dalamnya; (ii) dalam sekuriti yang diterbitkan atau dijamin sepenuhnya oleh mana-mana kerajaan berdaulat, organisasi supranasional atau multilateral dan termasuklah sekuriti yang penanggung obligasinya adalah mana-mana kerajaan berdaulat, organisasi supranasional atau multilateral; (iii) dalam sekuriti yang diterbitkan atau dijamin sepenuhnya oleh Kerajaan Malaysia, dijamin oleh mana-mana kerajaan berdaulat, organisasi supranasional atau multilateral dan termasuklah sekuriti yang penanggung obligasinya adalah mana-mana kerajaan berdaulat, organisasi supranasional atau multilateral dan apa-apa surat cara yang diterbitkan oleh Bank Negara Malaysia; (iv) dalam membeli sekuriti atau melanggan apa-apa produk bagi maksud perlindungan nilai pelaburan Kumpulan Wang; (v) dalam dana ekuiti persendirian yang diuruskan oleh— (A) mana-mana syarikat pengurusan dana yang didaftarkan dengan Suruhanjaya Sekuriti Malaysia atau Suruhanjaya Syarikat Malaysia; (B) mana-mana syarikat pengurusan dana yang didaftarkan oleh mana-mana badan pengawal selia di luar Malaysia; atau (C) mana-mana perkongsian liabiliti terhad yang didaftarkan oleh mana-mana badan pengawal selia di luar Malaysia; dan”; dan"
      }
