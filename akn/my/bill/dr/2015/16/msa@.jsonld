      "schema:text": {
        "@language": "ms",
        "@value": "dalam teks bahasa kebangsaan, dengan menggantikan perkataan “pihak berkuasa menyelia” di mana- mana jua terdapat dengan perkataan “pihak berkuasa penyeliaan”. Pindaan seksyen 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/16/msa@/~cl_3",
