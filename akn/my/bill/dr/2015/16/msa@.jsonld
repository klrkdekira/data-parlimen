        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/16/msa@/~cl_20__para_a__subpara_vii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/16/msa@/~cl_20__para_a__subpara_viii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/16/msa@/~cl_20__para_a__subpara_ix",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/16/msa@/~cl_20__para_a__subpara_x"
      ],
