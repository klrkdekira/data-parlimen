      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/16/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 216 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/16/msa@/~cl_20__para_a",
      "@type": "akn:paragraph",
