      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 217 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/16/msa@/~cl_21__para_a",
      "@type": "akn:paragraph",
