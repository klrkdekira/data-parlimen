      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (b), dengan menggantikan perkataan “sebagaimana yang ditakrifkan dalam Kod;” dengan perkataan “; atau”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/16/msa@/~cl_20__para_a__subpara_x__subpara_B",
