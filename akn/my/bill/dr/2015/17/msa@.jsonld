        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_3__para_a__subpara_v"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_3__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_3__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (a), dengan memotong perkataan “or against any Government”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_3__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_3__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan (b) misalan yang berikut: “ILLUSTRATION A excites a person or a group of persons to demand for the secession of State B from Malaysia. Such act is seditious.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_3__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_3__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perenggan (c);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_3__para_a__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_3__para_a__subpara_iv__subpara_A",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_3__para_a__subpara_iv__subpara_B"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_3__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (e)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_3__para_a__subpara_iv__subpara_A",
      "@type": "akn:subparagraph",
      "eli:number": "A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_3__para_a__subpara_iv",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “and hostility” dengan perkataan “, hostility or hatred”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_3__para_a__subpara_iv__subpara_B",
      "@type": "akn:subparagraph",
      "eli:number": "B",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_3__para_a__subpara_iv",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan “or” di hujung perenggan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_3__para_a__subpara_v",
      "@type": "akn:subparagraph",
      "eli:number": "v",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_3__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan (e) perenggan yang berikut: “ (ea) to promote feelings of ill will, hostility or hatred between persons or groups of persons on the ground of religion; or”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_3__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_3__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_3__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_3__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (b), dengan memotong perkataan “or in the administration of justice”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_3__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_3__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subperenggan (c)(ii) dengan subperenggan yang berikut: “(ii) to point out, with a view to their removal, any matters producing or having a tendency to produce feelings of ill will, hostility or hatred— (A) between different races or classes of the population of Malaysia; or (B) between persons or groups of persons on the ground of religion,”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (3), dengan memasukkan selepas perkataan “published” perkataan “or caused to be published”. Pindaan seksyen 4"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 4 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_4__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_4__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_4__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_4__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (c), dengan memasukkan selepas perkataan “publishes” perkataan “or causes to be published”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_4__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_4__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “for a first offence to a fine not exceeding five thousand ringgit or to imprisonment for a term not exceeding three years or to both, and, for a subsequent offence, to imprisonment for a term not exceeding five years” dengan perkataan “to imprisonment for a term of not less than three years but not exceeding seven years”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (1) subseksyen yang berikut: “(1a) Any person who— (a) does or attempts to do, or makes any preparation to do, or conspires with any person to do, any act which has or which would, if done, have a seditious tendency; (b) utters any seditious words; (c) prints, publishes or causes to be published, sells, offers for sale, distributes or reproduces any seditious publication; or (d) imports any seditious publication, and by such act causes bodily injury or damage to property shall be guilty of an offence and shall, on conviction, be liable to imprisonment for a term of not less than five years but not exceeding twenty years.”. Seksyen baru 5a dan 5b"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memasukkan selepas seksyen 5 seksyen yang berikut: “No bail to be granted 5a. When a person is charged with an offence under subsection 4(1a) and there is a certificate in writing by the Public Prosecutor stating that it is not in the public interest to grant bail to the person charged, the person shall not be released on bail. Power of court to prevent person from leaving Malaysia 5b. (1) When a person is charged with an offence under section 4 and released on bail, the court shall, on the application of the Public Prosecutor— (a) order the person to surrender his travel documents within such period specified in the order until all proceedings in relation to the charge against the person have been concluded; or (b) in cases where the person has no travel documents and he is a citizen or permanent resident, order the Director General of Immigration not to issue any travel document to the person until all proceedings in relation to the charge against the person have been concluded. (2) Any person who fails to comply with an order made under paragraph (1)(a), shall be guilty of an offence and shall, on conviction, be liable to a fine not exceeding five thousand ringgit or to imprisonment for a term not exceeding three years or to both, and his bail shall be revoked by the court. (3) For the purpose of this section— (a) “Director General of Immigration” means the Director General of Immigration appointed under section 3 of the Immigration Act 1959/63 [Act 155]; and (b) “travel document” means a passport or any form of valid document of identity issued by any government for the purpose of travel across international boundaries.”. Penggantian seksyen 6"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan menggantikan seksyen 6 dengan seksyen yang berikut: “Evidence 6. No person shall be convicted of any offence under paragraph 4(1)(c) or (d) or 4(1a)(c) or (d) if the person proves that the publication in respect of which he is charged was printed, published or caused to be published, sold, offered for sale, distributed, reproduced or imported without his authority, consent and knowledge and without any want of due care or caution on his part, or that he did not know and had no reasonable ground to believe that the publication had a seditious tendency.”. Seksyen baru 6a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memasukkan selepas seksyen 6 seksyen yang berikut: “Non-application of sections 173a, 293 and 294 of the Criminal Procedure Code 6a. Sections 173a, 293 and 294 of the Criminal Procedure Code [Act 593] shall not apply in respect of offences under subsection 4(1a).”. Pindaan seksyen 10"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_8__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_8__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_8__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_8__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_8__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 10 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (1) dengan subseksyen yang berikut: “(1) Where on the application of the Public Prosecutor it is shown to the satisfaction of a Sessions Court Judge that the making or circulation of a seditious publication— (a) is or if commenced or continued would likely lead to bodily injury or damage to property; (b) appears to be promoting feeling of ill will, hostility or hatred between different races or classes of the population of Malaysia; or (c) appears to be promoting feeling of ill will, hostility or hatred between persons or groups of persons on the ground of religion, the Sessions Court Judge shall make an order (“prohibition order”) prohibiting the making or circulation of that seditious publication (“prohibited publication”).”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (1) subseksyen yang berikut: “(1a) The prohibition order under subsection (1) shall— (a) require every person having any copy of the prohibited publication in his possession, power, or control to deliver forthwith every such copy into the custody of the police; or (b) in the case of a prohibited publication by electronic means— (i) require the person making or circulating the prohibited publication to remove or cause to be removed wholly or partly the prohibited publication; and (ii) prohibit the person making or circulating the prohibited publication from accessing any electronic device.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_8__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (4) dengan subseksyen yang berikut: “(4) Any person who contravenes a prohibition order made under subsection (1) shall be guilty of an offence and shall, on conviction, be liable to a fine not exceeding five thousand ringgit or to imprisonment for a term not exceeding three years or to both and, in the case of a continuing offence, to a fine of three thousand ringgit for each day during which the offence continues after conviction and in default of the payment of the fine, be liable to imprisonment for a term not exceeding one year.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_8__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (5) dengan subseksyen yang berikut: “(5) Every person who knowingly have in his possession, power or control a prohibited publication shall— (a) forthwith deliver every such prohibited publication into the custody of the police; and (b) in the case of a prohibited publication by electronic means, remove or cause to be removed wholly or partly the prohibited publication, and if he fails to do so, he shall be guilty of an offence and shall, on conviction, be liable to a fine not exceeding five thousand ringgit or to imprisonment for a term not exceeding three years or to both and, in the case of a continuing offence, to a fine of three thousand ringgit for each day during which the offence continues after conviction and in default of the payment of the fine, be liable to imprisonment for a term not exceeding one year.”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_8__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong subseksyen (9). Seksyen baru 10a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/17/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memasukkan selepas seksyen 10 seksyen yang berikut: “Special power to issue order regarding seditious publication by electronic means 10a. Where on the application of the Public Prosecutor it is shown to the satisfaction of a Sessions Court Judge that the making or circulation of a seditious publication by electronic means by a person who cannot be identified— (a) is or if commenced or continued would likely lead to bodily injury or damage to property; (b) appears to be promoting feeling of ill will, hostility or hatred between different races or classes of the population of Malaysia; or (c) appears to be promoting feeling of ill will, hostility or hatred between persons or groups of persons on the ground of religion, the Sessions Court Judge shall make an order directing an officer authorized under the Communications and Multimedia Act 1998 [Act 588] to prevent access to such publication.”."
      }
    }
  ]
}
