        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/18/msa@/~cl_6__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/18/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 11 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/18/msa@/~cl_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/18/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menomborkan semula seksyen itu sebagai subseksyen (1); dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/18/msa@/~cl_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/18/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (1) subseksyen yang berikut: “(2) Setiausaha Majlis hendaklah mempunyai apa-apa kewajipan dan fungsi yang berhubungan dengan Majlis sebagaimana yang ditentukan oleh Menteri.”. Pindaan seksyen 42"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/18/msa@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/18/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 42(1) Akta ibu dipinda dengan memotong perkataan “, pemberitahuan dalam Warta,”. Pindaan seksyen 43"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/18/msa@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/18/msa@/~cl_8__para_a",
