      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/18/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 44(2) Akta ibu dipinda dengan menggantikan perkataan “empat belas hari” dengan perkataan “dua puluh satu hari”. Pindaan seksyen 51"
      }
    }
  ]
}
