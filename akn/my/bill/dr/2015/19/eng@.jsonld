        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_33"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "CRUELTY TO ANIMALS Cruelty offences"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI",
      "@type": "akn:part",
      "eli:number": "VI",
