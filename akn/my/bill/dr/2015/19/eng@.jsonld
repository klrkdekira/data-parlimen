      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "ANIMALS IN DISTRESS Powers in relation to animals in distress"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII",
      "@type": "akn:part",
      "eli:number": "VII",
