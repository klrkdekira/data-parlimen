        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_38",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_39",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_40",
