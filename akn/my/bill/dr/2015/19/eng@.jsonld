      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III",
      "@type": "akn:part",
      "eli:number": "III",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_15",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_16",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_17",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_18",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_19",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_20",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_21",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_22",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_23"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "LICENSING Requirement for licence"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_15__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_15__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_15__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_15__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall carry on the activities involving animals as specified in the Schedule unless he holds a valid licence granted under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (1), a licence is not required for the activity of slaughtering animals for religious and customary purposes."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_15__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) commits an offence and shall on conviction be liable to a fine of not less than fifteen thousand ringgit and not more than seventy-five thousand ringgit or to imprisonment for a term not more than two years or to both. Application and issuance of licence"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_16__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_16__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_16__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_16__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_16__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "An application for a licence shall be made to the Board in such manner as the Board may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The application under subsection (1) shall be accompanied by such documents or information as the Board may consider necessary and relevant to the application and the Board may, orally or in writing at any time after receiving the application and before it is determined, require the applicant to provide such additional documents or information as the Board considers necessary for the purposes of determining the suitability of the applicant for the licence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_16__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may, after receiving an application for a licence under subsection (1), issue the licence or refuse to issue the licence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_16__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "Where an application for a licence is approved by the Board, the licence shall be issued in the name of the applicant upon payment of the prescribed fee and the Board may impose such terms and conditions as it may deem necessary. Licence not transferable"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_17__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "A licence under this Act shall not be transferable and no person shall use a licence of another person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) commits an offence and shall, on conviction, be liable to a fine of not less than ten thousand ringgit and not more than fifty thousand ringgit or to imprisonment for a term not more than one year or to both. Duration of licence"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_18__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_18__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_18__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_18__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "A licence issued or renewed under this Act shall remain in force for a period of five years from the date of its issuance or renewal, unless—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_18__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "the Board specifies any shorter period in the licence;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_18__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "the licence is suspended or revoked;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_18__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "the licensee is barred from holding the licence; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_18__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "the licensee is disqualified under section 52. Renewal of licence"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_19__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_19__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_19__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_19__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_19__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "A licensee may apply for a renewal of his licence not later than sixty days before the date of expiry of the licence in any form and manner as may be determined by the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_19__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "A licensee shall furnish to the Board any information as the Board considers necessary and relevant to the application."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_19__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may, after receiving an application for a renewal of licence under subsection (1), renew the licence or refuse to renew the licence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_19__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "Where an application for a renewal of licence is approved by the Board, the licence shall be renewed upon payment of the prescribed fee and the Board may impose such terms and conditions as the Board considers necessary. Display of licence"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_20__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_20__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_20__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_20__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "A licensee shall display his licence at a conspicuous place at his premises."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_20__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (1), a licensee is not required to cause a copy of the licence to be displayed if he carries on the activities outside the premises but the licensee shall ensure that he or the person in charge of the activity has a copy of the licence with him."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_20__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) or (2) commits an offence and shall, on conviction, be liable to a fine of not less than ten thousand ringgit and not more than fifty thousand ringgit or to imprisonment for a term not more than one year or to both. Suspension and revocation of licence"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_21__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_21__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_21__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_21__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_21__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_21__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_21__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_21__subsec_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_21__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_21__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_21__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_21__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_21__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may, by giving a notice in writing to the licensee, suspend the licence for a period of up to three months under any of the following circumstances:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_21__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_21__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the licensee or any employee of the licensee has been convicted of an offence under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_21__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_21__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the licensee has breached any conditions specified in the licence;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_21__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_21__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the licensee has failed to comply with any of provisions of this Act or any subsidiary legislations made under this Act; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_21__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_21__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the welfare of an animal would be under threat if the licence remained in force."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_21__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (1), the licensee is allowed to apply for a renewal of licence during suspension period."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_21__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_21__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_21__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_21__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may, by giving a notice in writing to the licensee, revoke the licence under any of the following circumstances:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_21__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_21__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the licence has been obtained by fraud or misrepresentation;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_21__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_21__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the licensee fails to remedy the grounds of suspension or take reasonable steps to ensure that the grounds for the suspension will not recur within fourteen days before the end of the suspension period; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_21__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_21__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the original purpose for which the licence was issued no longer exists."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_21__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may disqualify a licensee from applying for another licence before the expiration of the revoked licence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_21__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "The Board shall give the licensee a notice in writing before the Board makes a decision under subsection (1) or (3)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_21__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "Upon suspension or revocation, a licensee shall surrender the licence to the Board not later than fourteen days from the date on which the notice of suspension or revocation is served on him."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_21__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "The Board shall return the suspended licence referred to in subsection (6) to the licensee after the end of the suspension period."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_21__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "Where a licence has been revoked or suspended, it shall have no effect from the date of revocation or during the period of suspension, as the case may be. Appeal to Minister"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_22__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_22__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_22__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_22__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_22__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "Any person aggrieved—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_22__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_22__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "by the refusal of the Board to issue or renew any licence; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_22__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_22__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "by the suspension or revocation of any licence, may within thirty days after being informed in writing of the refusal, suspension or revocation, appeal in writing against such decision to the Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_22__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, after considering the appeal made under subsection (1), confirm or set aside the decision appealed against, and the decision of the Minister shall be final. Barred from holding licence"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "Where a person has been convicted of an offence under this Act or any of its subsidiary legislation, he may be barred from holding any licence by the Board for a period not exceeding five years commencing on the date when the proceeding in respect of the conviction is finally concluded."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_10__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, at any time, revoke the appointment of any member of the Board appointed under paragraph 6(1)(b), (f), (g), (h) or (i)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "Any member of the Board appointed under paragraph 6(1)(b), (f), (g), (h) or (i) may, at any time, resign from his appointment by giving a notice in writing to the Minister. Vacation of office"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_11__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_11__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_11__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_11__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_11__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_11__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_11__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_11__subsec_1__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "The office of a member of the Board appointed under paragraph 6(1)(b), (f), (g), (h) or (i) shall be vacated if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_11__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_11__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "he dies;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_11__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_11__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_11__subsec_1__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_11__subsec_1__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_11__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "there has been proved against him, or he has been convicted of, a charge in respect of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_11__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_11__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "an offence involving fraud, dishonesty or moral turpitude;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_11__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_11__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "an offence under any law relating to corruption; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_11__subsec_1__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_11__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "any other offence punishable with imprisonment (in itself only or in addition to or in lieu of a fine) for more than two years;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_11__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_11__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "he becomes a bankrupt;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_11__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_11__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "he is of unsound mind or is otherwise incapable of discharging his duties;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_11__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_11__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "he absents himself from three consecutive meetings of the Board without leave from the Chairman;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_11__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_11__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "his resignation is accepted by the Minister; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_11__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_11__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "his appointment is revoked by the Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "Where a member appointed under paragraph 6(1)(b), (f), (g), (h) or (i) ceases to be a member of the Board, by reason of any provision in this Act, the Minister may appoint another person to fill the vacancy for the remaining term for which the vacating member was appointed in accordance with the provisions applicable. Meeting of the Board"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_12__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_12__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_12__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_12__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_12__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The Board shall meet as often as may be necessary for the performance of its function and such meetings are to be held at such places and times as the Chairman of the Board may decide."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The Chairman of the Board shall preside at all meetings of the Board and if for any reason the Chairman is unable to attend, the Deputy Chairman shall preside over the meeting."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_12__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "If at any meeting of the Board, the Chairman and the Deputy Chairman are unable to attend, the meeting shall be adjourned."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_12__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The Chairman and four other members of the Board shall form a quorum at any meeting of the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_12__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "Where there is an equality of votes, the Chairman or the Deputy Chairman replacing the Chairman referred to in subsection (2) shall have the casting vote."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_12__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may invite any person to attend any meeting of the Board for the purpose of advising the Board on any matter under discussion, but the person so invited shall not be entitled to vote at the said meeting. Committees"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13__subsec_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13__subsec_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13__subsec_11",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13__subsec_12",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13__subsec_13",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13__subsec_14",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13__subsec_15",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13__subsec_16"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may establish any committee as the Board considers necessary or expedient to assist the Board in the performance of its functions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13__subsec_10",
      "@type": "akn:subsection",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "A committee shall be subject to, and shall act in accordance with, any direction given to it by the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13__subsec_11",
      "@type": "akn:subsection",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The meetings of a committee shall be held at such times and places as the chairman of the committee may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13__subsec_12",
      "@type": "akn:subsection",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13__subsec_12__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13__subsec_12__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "A committee shall cause—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13__subsec_12__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13__subsec_12",
      "schema:text": {
        "@language": "en",
        "@value": "minutes of all its meetings to be maintained and kept in a proper form; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13__subsec_12__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13__subsec_12",
      "schema:text": {
        "@language": "en",
        "@value": "copies of the minutes of all its meetings to be submitted to the Board as soon as practicable."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13__subsec_13",
      "@type": "akn:subsection",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "A committee may invite any person to attend any of its meetings for the purpose of advising the committee on any matter under discussion but that person shall not be entitled to vote at the meeting."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13__subsec_14",
      "@type": "akn:subsection",
      "eli:number": "14",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "Any minutes made of a meeting of the committee shall, if duly signed, be admissible as evidence in any legal proceedings without further proof."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13__subsec_15",
      "@type": "akn:subsection",
      "eli:number": "15",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The members of the committee or any person invited under subsection (13) shall be paid such allowance and other expenses as the Board may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13__subsec_16",
      "@type": "akn:subsection",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13__subsec_16__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13__subsec_16__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "No act done or proceedings taken under this Act shall be questioned on the ground of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13__subsec_16__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13__subsec_16",
      "schema:text": {
        "@language": "en",
        "@value": "any vacancy in the membership of, or any defect in the constitution of, a committee; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13__subsec_16__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13__subsec_16",
      "schema:text": {
        "@language": "en",
        "@value": "any omission, defect or irregularity not affecting the merits of the case. Power of Minister to give directions"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "A committee established under subsection (1) shall deliberate upon matters referred to it by the Board and make appropriate recommendations on the matters to the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may elect any of its members to be the chairman of a committee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may appoint any person to be a member of a committee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "A member of a committee shall hold office for such term as specified in his letter of appointment and is eligible for reappointment for any term as may be determined by the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may, at any time, revoke the appointment of any member of a committee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "A member of a committee may, at any time, resign his office by giving a notice in writing to the chairman of the committee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may, at any time, discontinue or alter the constitution of a committee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "A committee may regulate its own procedure."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, from time to time, give directions to the Board consistent with the provisions of this Act and the Board shall give effect to all such directions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "A body to be known as the “Animal Welfare Board” is established. Functions of the Board"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_4__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_4__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_4__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_4__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_4__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_4__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_4__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_4__subsec_1__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_4__subsec_1__para_h"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "The Board shall have the following functions:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_4__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to monitor the work of associations or bodies established for the purpose of preventing trauma, pain or suffering to animals;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_4__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to monitor the work for the protection of animals, including animals in rescue homes, animal shelters or sanctuaries;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_4__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to monitor the situation of the place where the animals may find a shelter when the animals are infirmed or in need of protection;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_4__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to impart education in relation to the humane treatment of animals and to encourage the formation of public opinion relating to the infliction of trauma, pain or suffering to animals;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_4__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to promote the animal welfare by means of lectures, books, posters, cinematographic exhibitions and others;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_4__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to advise the Minister on any matter relating to animal welfare, the prevention of infliction of trauma, pain or suffering on animals, the prevention of unnecessary killing and to provide for the welfare and wellbeing of the animal;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_4__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to administer, enforce and ensure the effective implementation of this Act; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_4__subsec_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to discharge all such functions as authorized under this Act or subsidiary legislation made under this Act, including those functions that may be entrusted to the Board under the direction of the Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "In the exercise of its functions under this Act, the Board shall have the powers to issue directions in writing to any person, officer or any authority and such person, officer or authority shall be bound to comply with such directions. Delegation of functions of the Board"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_5__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_5__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_5__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_5__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_5__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may, subject to the conditions or restrictions as it thinks fit to impose, delegate any of its functions, except the power of delegation, to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_5__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any committee established under section 13; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_5__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any public officer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "Any committee or public officer delegated with such functions shall be bound to observe and have regard to all conditions and restrictions imposed by the Board and all the requirements, procedures and matters specified by the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_5__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "Any function delegated under this section shall be performed and exercised in the name and on behalf of the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_5__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The delegation under this section shall not preclude the Board itself from performing or exercising at any time any of the delegated functions. Membership of the Board"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_6__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_6__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_6__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_6__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_6__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_6__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_6__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_6__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_6__subsec_1__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_6__subsec_1__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_6__subsec_1__para_i"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The Board shall consist of the following members:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_6__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Director General of the Department of Veterinary Services, as Chairman;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_6__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a senior officer of the Department of Veterinary Services, who shall be appointed by the Minister as Deputy Chairman;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_6__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Director General of the Department of Wildlife Peninsular Malaysia and National Parks or his representative;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_6__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Director General of the Department of Fisheries or his representative;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_6__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Director General of the Local Government Department or his representative;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_6__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the dean of faculty in relation to veterinary, from a public institution of higher learning to be appointed by the Minister;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_6__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a senior officer of the Ministry of Agriculture and Agro-Based Industry to be appointed by the Minister;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_6__subsec_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a senior officer of the Ministry of Education to be appointed by the Minister; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_6__subsec_1__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a senior officer of the Ministry of Health to be appointed by the Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, after consultation with the Board, appoint any person to be a member of the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The Director of the Department of Veterinary Services and Animal Industry Sabah and the Senior Assistant Director (Veterinary) of the Department of Agriculture Sarawak shall be ex-officio members of the Board but shall not be entitled to vote at the meeting of the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_6__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister shall, after consultation with the Board, appoint a senior officer of the Department of Veterinary Services to be the Secretary to the Board. Alternate members"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_7__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_7__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, in relation to each member appointed under paragraph 6(1), (f), (g), (h) or (i), appoint a person to be an alternate member to attend, as an alternate to such member, meetings of the Board when such member is unable to attend for any reason."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "An alternate member who attends the meetings of the Board shall, for all purposes, be deemed to be a member of the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_7__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "An alternate member shall, unless he sooner resigns his office or his appointment is sooner revoked, cease to be an alternate member when the member in respect of whom he is an alternate member ceases to be a member of the Board. Tenure of office"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to such conditions as may be specified in his instrument of appointment, a member of the Board appointed under paragraph 6(1)(b), (f), (g), (h) or (i) shall, unless he resigns or vacates his office or his appointment is revoked, hold office for a term not exceeding three years and shall be eligible for reappointment for a term not exceeding three years. Allowances and expenses"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "The members of the Board, alternate member or any other person invited to any meeting of the Board under subsection 12(6) may be paid such allowances and other expenses as the Minister may from time to time determine with the concurrence of the Minister of Finance. Revocation of appointment and resignation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_24",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_25",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_26",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_27",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_28"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "MATTERS RELATING TO ANIMAL WELFARE Duties of owner or licensee"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_24__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_24__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_24__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_24__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_24__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_24__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "The owner or a licensee shall have the duty to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_24__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_24__subsec_1__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_24__subsec_1__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_24__subsec_1__para_a__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_24__subsec_1__para_a__subpara_iv",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_24__subsec_1__para_a__subpara_v"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_24__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "take reasonable steps to ensure that the needs of an animal are fulfilled, which includes—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_24__subsec_1__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_24__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "its need for a suitable environment;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_24__subsec_1__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_24__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "its need for a suitable diet;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_24__subsec_1__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_24__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "the need for it to be able to exhibit its normal behavior patterns;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_24__subsec_1__para_a__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_24__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "the need for it to be housed with or apart from other animals; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_24__subsec_1__para_a__subpara_v",
      "@type": "akn:subparagraph",
      "eli:number": "v",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_24__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "the need for it to be protected from pain, suffering, injury and disease; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_24__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_24__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_24__subsec_1__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_24__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "ensure that the circumstances to which it is relevant to have regard to the needs of an animal under paragraph (a) includes—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_24__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_24__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "any lawful purpose for which the animal is kept; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_24__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_24__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "any lawful activity undertaken in relation to the animal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_24__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "Nothing in this section applies to the lawful destruction of any animal for any reasonable purposes in an appropriate and humane manner."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_24__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "An owner or a licensee who contravenes subsection (1) commits an offence and shall, on conviction, be liable to a fine of not less than fifteen thousand ringgit and not more than seventy-five thousand ringgit or to imprisonment for a term not more than two years or to both. Improvement notices"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_25__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_25__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_25__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_25__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_25__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_25__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_25__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_25__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_25__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_25__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "Where an animal welfare officer is of the opinion that an owner or a licensee fails to comply with section 24, he may serve on the owner or the licensee an improvement notice containing the following:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_25__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_25__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the details of the non-compliance of section 24;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_25__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_25__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the steps to be taken by the owner or the licensee;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_25__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_25__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "set out a period for the owner or the licensee to take those steps referred to in paragraph (b); and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_25__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_25__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the effect of the failure to comply with the direction as specified in the improvement notice."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_25__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "An owner or a licensee shall comply with the requirement of the notice referred to in subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_25__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "If the improvement notice under subsection (1) is served to the owner or the licensee, no proceedings for an offence under subsection 24(3) shall be instituted."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_25__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "An animal welfare officer may, as he thinks necessary, extend the compliance period specified in the improvement notice."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_25__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "An owner or a licensee who contravenes subsection (2) commits an offence and shall, on conviction, be liable to a fine of not less than ten thousand ringgit and not more than fifty thousand ringgit or to imprisonment for a term not more than one year or to both. Animals used in research, testing or teaching"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_26__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_26__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_26__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_26__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_26__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_26__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_26__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_26__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_26__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_26__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall use animals in research, testing or teaching unless—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_26__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_26__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "all reasonable steps are taken to ensure that the physical, health, and behavioral needs of those animals are in accordance with this Act and the subsidiary legislation as may be prescribed by the Minister;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_26__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_26__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the animals shall receive, where practicable, treatment that alleviates any unreasonable or unnecessary pain or distress when the animals are ill or injured; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_26__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_26__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any degree of pain or distress is reduced to the minimum possible in the circumstances where the nature of the research, testing, or teaching cannot comply with paragraph (a) or (b)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_26__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "No person, except school, shall use animals for research, testing or teaching unless the person is licensed by the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_26__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "The guidelines on the research, testing or teaching of animals in school shall be in accordance with any guidelines issued by the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_26__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall breed any animal to be used for research, testing or teaching unless it is approved by the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_26__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "For the purpose of this section, “school” has the meaning assigned to it in the Education Act 1996 [Act 550]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_26__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes any provision under this section commits an offence and shall, on conviction, be liable to a fine of not less than twenty thousand ringgit and not more than one hundred thousand ringgit or to imprisonment for a term not more than three years or to both. Transportation of animals"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_27__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_27__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_27__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_27__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_27__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_27__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "An owner or operator of any conveyance shall have the duty to provide for—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_27__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_27__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "an adequate, clean and sanitary facilities; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_27__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_27__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "sufficient food and water, to the animals which are being transported in a conveyance to ensure the safe delivery of the animals to the consignee at the place of consignment."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_27__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall confine or restrain cruelly animals which are being transported in a conveyance under subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_27__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) or (2) commits an offence and shall, on conviction, be liable to a fine of not less than fifteen thousand ringgit and not more than seventy-five thousand ringgit or to imprisonment for a term not more than two years or to both. Selling of animals to persons under the age of twelve years old"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who sells an animal to a person whom he has reasonable cause to believe to be under the age of twelve years old, unless such person is accompanied by an adult, commits an offence and shall, on conviction, be liable to a fine of not less than fifteen thousand ringgit and not more than seventy-five thousand ringgit or to imprisonment for a term not more than two years or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX",
      "@type": "akn:part",
      "eli:number": "IX",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_56",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_57",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_58",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_59",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_60",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_61",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_63",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_64"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "GENERAL Offence committed by body corporate"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_56",
      "@type": "akn:clause",
      "eli:number": "56",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_56__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_56__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX",
      "schema:text": {
        "@language": "en",
        "@value": "Where a body corporate commits an offence under this Act or any of its subsidiary legislation, any person who at the time of the commission of the offence was a chief executive officer, director, manager, secretary or other similar officer of the body corporate or was purporting to act in any such capacity or was in any manner or to any extent responsible for the management of any of the affairs of the body corporate or was assisting in such management—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_56__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_56",
      "schema:text": {
        "@language": "en",
        "@value": "may be charged severally or jointly in the same proceedings with the body corporate; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_56__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_56__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_56__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_56",
      "schema:text": {
        "@language": "en",
        "@value": "where the body corporate is found guilty of the offence, shall be deemed to be guilty of the offence unless, having regard to the nature of his functions in that capacity and to all circumstances, he proves—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_56__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_56__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "that the offence was committed without his knowledge, consent or connivance; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_56__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_56__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "that he took all reasonable precautions and had exercised due diligence to prevent the commission of the offence. Failure to comply with lawful order"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_57",
      "@type": "akn:clause",
      "eli:number": "57",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_57__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_57__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_57__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_57",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may make any order as may be expedient or necessary for the better carrying out the provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_57__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_57",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who fails to comply with any written order issued by the Minister commits an offence and shall, on conviction, be liable to a fine of not less than ten thousand ringgit and not more than fifty thousand ringgit or to imprisonment for a term not more than one year or to both. Photograph of animal to be admissible as evidence"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_58",
      "@type": "akn:clause",
      "eli:number": "58",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX",
      "schema:text": {
        "@language": "en",
        "@value": "Photograph or a copy of the photograph of an animal shall be admissible as evidence in court if it involves unreasonable expenses or inconvenience for the animal to be brought to the court. Protection against suits and legal proceedings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_59",
      "@type": "akn:clause",
      "eli:number": "59",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_59__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_59__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX",
      "schema:text": {
        "@language": "en",
        "@value": "No action, suit, prosecution or other proceeding shall be brought, instituted or maintained in any court against—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_59__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_59",
      "schema:text": {
        "@language": "en",
        "@value": "any member of the Board, any authorized officer or any registered veterinary surgeon for or on account of or in respect of any act ordered or done for the purpose of carrying into effect of this Act; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_59__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_59",
      "schema:text": {
        "@language": "en",
        "@value": "any other person for or an account of or in respect of any act done or purported to be done by him under the order, direction or instruction of the Minister, the Board or any officer duly authorized under this Act, if the act was done in good faith and in a reasonable belief that it was necessary for the purpose intended to be served by it. Compounding of offences"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_60",
      "@type": "akn:clause",
      "eli:number": "60",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_60__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_60__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_60__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_60__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_60",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may, with the consent in writing of the Public Prosecutor, offer to compound any offence committed by any person under this Act or any of its subsidiary legislation by making a written offer to the person suspected of having committed the offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_60__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_60",
      "schema:text": {
        "@language": "en",
        "@value": "An offer under subsection (1) may be made at any time after the offence has been committed, but before any prosecution for it has been instituted, and where the amount specified in the offer, under subsection (1) is not paid within the time specified in the offer or within such extended period as the Board or any animal welfare officer that the Board has delegated such power in writing, may grant, prosecution for the offence may be instituted at any time after that against the person to whom the offer was made."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_60__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_60__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_60__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_60",
      "schema:text": {
        "@language": "en",
        "@value": "Where an offence has been compounded under subsection (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_60__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_60__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "no prosecution shall be instituted after that in respect of the offence against the person to whom the offer to compound was made; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_60__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_60__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "any animal, carcass, conveyance, substance or other thing seized from any premises shall be released or forfeited by the animal welfare officer after taking into consideration the nature of the offence and the condition of the animal, carcass, conveyance, substance or other thing in accordance with the term and conditions of the compound. Institution of prosecution"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_61",
      "@type": "akn:clause",
      "eli:number": "61",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX",
      "schema:text": {
        "@language": "en",
        "@value": "No prosecution for or in relation to an offence under this Act or any of its subsidiary legislation shall be instituted except by or with the written consent of the Public Prosecutor. Power to make regulations"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62",
      "@type": "akn:clause",
      "eli:number": "62",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, after consulting the Board, make such regulations as may be expedient or necessary for the purpose of carrying into effect the provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2__para_k",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2__para_l",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2__para_m",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2__para_n",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2__para_o",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2__para_p",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2__para_q"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62",
      "schema:text": {
        "@language": "en",
        "@value": "In particular, and without prejudice to the generality of subsection (1), regulations may be made for the following purposes:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe all matters relating to subsection 24(1);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe all matters relating to the handling of animals;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe all matters relating to animals used in research, testing or teaching;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe all matters relating to the managing and up keeping of the experimental, rescued, rehabilitated and captured animals;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe matters relating to the maximum load, including any load occasioned by the weight of passengers, to be carried or drawn by any animal;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe all matters relating to the precautions to be taken in the transport of animals whether by rail, road, inland waterway, sea or air and in the cages or other receptacles or any manner in which the animal may be so transported;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe all matters relating to the handling of animals prior to the slaughter and the process of slaughtering;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe all matters relating to the training, housing, upkeep, exhibition, display, or depiction of performing animal or the breeding or sale of animals;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe all matters relating to licensing;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe the fees payable under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe the offences which may be compounded;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2__para_l",
      "@type": "akn:paragraph",
      "eli:number": "l",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe all matters relating to the costs which are recoverable under this Act and any of its subsidiary legislation, the amounts of those costs or the method by which they are to be assessed, the persons liable for payment of the costs, and the circumstances in which the recovery of costs may be remitted or waived in whole or in part;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2__para_m",
      "@type": "akn:paragraph",
      "eli:number": "m",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe all matters relating to the qualifications, experiences, conduct and duties of the animal welfare officer and voluntary animal welfare assistant;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2__para_n",
      "@type": "akn:paragraph",
      "eli:number": "n",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe the all matters relating to an improvement notice;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2__para_o",
      "@type": "akn:paragraph",
      "eli:number": "o",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe all matters relating to an accepted veterinary management procedures;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2__para_p",
      "@type": "akn:paragraph",
      "eli:number": "p",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to regulate training providers or its organization in the field of animal welfare including the training modules; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2__para_q",
      "@type": "akn:paragraph",
      "eli:number": "q",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to provide for such other matters as are contemplated by, or necessary for giving full effect to the provisions of this Act and their due administration."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_62",
      "schema:text": {
        "@language": "en",
        "@value": "The regulation made under this section may prescribe any act in contravention of the regulation to be an offence and may prescribe penalties of a fine not more than ten thousand ringgit or imprisonment for a term not more than two years or both for such offence. Power to amend Schedule"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_63",
      "@type": "akn:clause",
      "eli:number": "63",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, by order published in the Gazette, amend the Schedules to this Act. Transitional provisions"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_64",
      "@type": "akn:clause",
      "eli:number": "64",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_64__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_64__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_64__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_64__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_64",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who, on the date of the coming into operation of this Act, is undertaking an activity to which this Act applies shall, within six months from the date of the coming into operation of this Act, apply for a licence under section 16 and such application shall be treated as a fresh application and not as an application for renewal of a licence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_64__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_64",
      "schema:text": {
        "@language": "en",
        "@value": "Upon receipt of an application under subsection (1), the Board shall issue an acknowledgement of receipt to such person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_64__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_IX__cl_64",
      "schema:text": {
        "@language": "en",
        "@value": "Pending the determination of such application, such person may continue to undertake the activity."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_I__cl_1__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_I__cl_1__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Animal Welfare Act 2015."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act applies to Peninsular Malaysia and the Federal Territory of Labuan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_I__cl_1__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_I",
      "schema:name": {
        "@language": "en",
        "@value": "In this Act, unless the context otherwise requires—"
      },
      "schema:text": {
        "@language": "en",
        "@value": "“prescribed” means prescribed by the Minister by subsidiary legislation made under this Act; “animal” means any living creature other than a human being and includes any beast, bird, aquatic animals, reptile or insect but does not include wildlife under the Wildlife Conservation Act 2010 [Act 716]; “performing animal” means any animal which is used for the purpose of any entertainment, exhibition, sports, audio-visual recording and animal shows; “carcass” means the dead body of an animal and includes any part of the body whether separately or otherwise; “animal welfare” includes the animal needs as specified in section 24; “Board” means the Animal Welfare Board established under section 3; “Minister” means the Minister charged with the responsibility for the agriculture and agro-based industry; “animal welfare officer” means any public officer appointed under section 36; “voluntary animal welfare assistant” means any qualified person appointed under section 37; “owner” means any person who owns any animal and includes any person for the time being in charge of any animal or any person occupying any premises; “conveyance” means any vehicle, vessel, ship, aircraft and any other mode of transportation whether by air, sea or land; “veterinary authority” has the meaning assigned to it under the Animals Act 1953 [Act 647]; “premises” includes any house, building, hut, shed, structure, platform, plant, licensed warehouse, container and land whether or not enclosed or built upon; “accepted veterinary management procedures” includes dehorning of cattle, nose roping of cattle, ear notching, ear tagging, clipping of furs, horns, tusks or nails, and making of marks on animals or any other procedures determined by the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V",
      "@type": "akn:part",
      "eli:number": "V",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_30",
