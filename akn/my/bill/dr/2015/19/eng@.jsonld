        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~sched_1__para_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~sched_1__para_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~sched_1__para_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~sched_1__para_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~sched_1__para_11",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~sched_1__para_12",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~sched_1__para_13"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "[Section 15] Activities involving animals The following activities are regarded as activities involving the use animals for the purposes of this Act:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~sched_1__para_1",
      "@type": "akn:paragraph",
      "eli:number": "1",
