        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_42",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_43",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_44",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_45",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_46",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_47",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_48",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_49"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "POWERS RELATING TO ENFORCEMENT Animal welfare officer"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII",
      "@type": "akn:part",
      "eli:number": "VIII",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_50",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_51",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_52",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_53",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_54",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_55"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "ANCILLARY POWER OF THE COURT Second or subsequent offence"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_50",
      "@type": "akn:clause",
      "eli:number": "50",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII",
      "schema:text": {
        "@language": "en",
        "@value": "Any person guilty for a second or subsequent similar offence under this Act or any subsidiary legislation made under this Act shall, on conviction, be liable to a fine not more than twice the original sum of fine for that offence or to imprisonment for a term not less than three months. Deprivation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_51",
      "@type": "akn:clause",
      "eli:number": "51",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_51__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_51__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_51__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_51__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_51__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_51",
      "schema:text": {
        "@language": "en",
        "@value": "Where a person is convicted of an offence under any section 26, 29, 30, 31, or 32 and he is the owner or the licensee in relation to which the offence was committed, the court before which he is convicted may, instead of or in addition to dealing with the owner or the licensee in any other way, make an order to deprive the ownership of the animal from the owner or the licensee, or make an order for the animal to be disposed or destroyed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_51__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_51",
      "schema:text": {
        "@language": "en",
        "@value": "Where the owner or the licensee of an animal is convicted of an offence under subsection 52(3) as a result of a breach of an order under subsection 52(1), the court before which he is convicted may, instead of or in addition to dealing with the owner or licensee in any other way, make an order to deprive the ownership of the animal from the owner or the licensee, or make an order for the animal to be disposed or destroyed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_51__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_51",
      "schema:text": {
        "@language": "en",
        "@value": "If the animal in respect of which an order made under subsection (1) or (2) has any offspring, the court may include in the order the deprivation of the ownership of the offspring or for the said animal to be disposed or destroyed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_51__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_51__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_51__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_51",
      "schema:text": {
        "@language": "en",
        "@value": "If the court makes an order under subsection (1) or (2), the court may—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_51__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_51__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "appoint any animal welfare officer to carry out or arrange for the carrying out of the order; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_51__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_51__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "order the owner or the licensee to pay the expenses of carrying out such order. Disqualification"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_52",
      "@type": "akn:clause",
      "eli:number": "52",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_52__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_52__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_52__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_52__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_52__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_52__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_52__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_52__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_52",
      "schema:text": {
        "@language": "en",
        "@value": "Where a person is convicted of an offence under section 15, 24, 26, 27, 28, 29, 30, 31 or 32, the court before which he is convicted may, instead of or in addition to dealing with him in any other way, make an order to disqualify him for a period not more than one year from—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_52__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_52__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "owning animals;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_52__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_52__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "keeping animals;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_52__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_52__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "participating in the keeping of animals; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_52__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_52__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "being a party to an arrangement under which he is entitled to control or influence the way in which animals are kept."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_52__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_52__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_52__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_52",
      "schema:text": {
        "@language": "en",
        "@value": "The court may—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_52__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_52__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "suspend the operation of the order pending an appeal; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_52__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_52__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "where it appears to the court that the person owns or keeps an animal to which the order applies, suspend the operation of the order and of any order made under section 53 in connection with the disqualification, for such period as it thinks necessary to enable alternative arrangements to be made in respect of the animal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_52__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_52",
      "schema:text": {
        "@language": "en",
        "@value": "A person who contravenes a disqualification order under subsection (1) commits an offence and shall, on conviction, be liable to a fine of not less than ten thousand ringgit and not more than fifty thousand ringgit or to imprisonment for a term not more than one year or to both. Seizure of animals in connection with disqualification"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_53",
      "@type": "akn:clause",
      "eli:number": "53",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_53__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_53__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_53__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_53__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_53",
      "schema:text": {
        "@language": "en",
        "@value": "Where a person is convicted of an offence under subsection 52(3) in breach of an order under paragraph 52(1)(a) or (b), the court before which he is convicted may order that all animals be taken into possession by the animal welfare officer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_53__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_53",
      "schema:text": {
        "@language": "en",
        "@value": "An order under subsection (1), relating to any animal owned by the person subject to the disqualification under section 52, shall have effect as an order under section 51."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_53__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_53__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_53__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_53",
      "schema:text": {
        "@language": "en",
        "@value": "The court before which an order was made under this section may—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_53__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_53__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "appoint an animal welfare officer to carry out or arrange for the carrying out of, the order; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_53__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_53__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "order the person to pay the expenses of carrying out such order. Power of court to order destruction of animal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_54",
      "@type": "akn:clause",
      "eli:number": "54",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_54__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_54__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_54__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_54",
      "schema:text": {
        "@language": "en",
        "@value": "The court before which a person is convicted of an offence under section 24, 26, 28, 31, or 32 may order the destruction of an animal in relation to which the offence was committed, if the court is satisfied, on the basis of the evidence given by a registered veterinary surgeon or animal welfare officer, that it is appropriate to do so in the interests of the animal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_54__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_54__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_54__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_54",
      "schema:text": {
        "@language": "en",
        "@value": "If the court makes an order under subsection (1), the court may—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_54__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_54__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "appoint an animal welfare officer to carry out or arrange for the carrying out of the order; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_54__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_54__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "order the person, if any, to pay the expenses of carrying out the order. Forfeiture of item used in or related to the offences"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_55",
      "@type": "akn:clause",
      "eli:number": "55",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_55__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_55__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_55__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_55__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_55__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_55__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_55",
      "schema:text": {
        "@language": "en",
        "@value": "Where a person is convicted of an offence under this Act or any of its subsidiary legislation, the court may order any item relating to the offence and the proceed of any sale, if any, to be forfeited, destroyed or dealt with in such manner as may be specified in the order."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_55__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_55",
      "schema:text": {
        "@language": "en",
        "@value": "Where any item related to the offence has been seized under this Act but the person who is alleged to have committed the offence is unknown or cannot be found, the court may, if it is satisfied that an offence has been committed, order that such item relating to the offence to be forfeited."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_55__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_55",
      "schema:text": {
        "@language": "en",
        "@value": "No order for forfeiture shall be made in respect of a conveyance unless the name of the owner and the place of his residence is known and that he is given an opportunity to be heard."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_55__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_55",
      "schema:text": {
        "@language": "en",
        "@value": "Where there is proceed from any sale of such item relating to the offence seized under this Act, the court may, if it is satisfied that an offence has been committed, order that such proceed to be forfeited."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_55__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VIII__cl_55",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this section, “item” means any things or substance in respect of which an offence has been committed and which is a subject matter in relation to the evidence necessary to establish the commission of the offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_36",
      "@type": "akn:clause",
      "eli:number": "36",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_36__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_36__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_36__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may appoint in writing, such number of public officers to be animal welfare officers as he thinks necessary for the purpose of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_36__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "An animal welfare officer shall have all powers vested on him under this Act or any subsidiary legislation made under this Act. Voluntary animal welfare assistant"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_37",
      "@type": "akn:clause",
      "eli:number": "37",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_37__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_37__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_37__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may appoint in writing, any qualified person to be voluntary animal welfare assistant to assist the animal welfare officer for the purpose of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_37__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "A voluntary animal welfare assistant may not exercise any powers under this Act or any subsidiary legislation made under this Act. Authority card"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_38__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_38__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_38__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "The Chairman shall issue to each animal welfare officer an authority card which shall be signed by the Chairman."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_38__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "Whenever an animal welfare officer exercises any of the powers under this Act or any subsidiary legislation made under this Act, he shall, on demand, produce to the person against whom the power is being exercised, the authority card issued to him under subsection (1). Power of investigation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_39__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_39__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_39__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_39",
      "schema:text": {
        "@language": "en",
        "@value": "An animal welfare officer shall have all the powers necessary to carry out an investigation of the commission of an offence under this Act or any subsidiary legislation made under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_39__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_39",
      "schema:text": {
        "@language": "en",
        "@value": "For the purpose of subsection (1), the Criminal Procedure Code [Act 593] shall apply and an animal welfare officer shall have all the powers as provided for under the Criminal Procedure Code to carry out an investigation. Search and seizure without warrant"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "If an animal welfare officer is satisfied upon information received that he has reasonable cause to believe that by reason of delay in obtaining a search warrant under section 56 of the Criminal Procedure Code the investigation would be adversely affected or evidence of the commission of an offence is likely to be tampered with, removed, damaged or destroyed, the animal welfare officer may enter the premises and exercise in, upon and in respect of the premises all the powers referred to in section 56 of the Criminal Procedure Code in as full and ample a manner as if he were authorized to do so by a warrant issued under that Power to enter premises"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_41",
      "@type": "akn:clause",
      "eli:number": "41",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_41__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_41__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_41__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding section 40, any animal welfare officer may enter any premises for the purpose of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_41__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "inspecting any animal, carcass, conveyance, substance or other thing as he considers necessary;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_41__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "verifying the accuracy of records or statement or any information given to an animal welfare officer; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_41__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "collecting samples of any animal, carcass, conveyance, substance or other thing found in the premises as he thinks necessary for the purposes of analysis without any payment. Power to stop, search and seize conveyance"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_42",
      "@type": "akn:clause",
      "eli:number": "42",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_42__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_42__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_42__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_42__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "If an animal welfare officer has reasonable cause to suspect that any conveyance is carrying any animal, carcass, conveyance, substance or other thing in respect of which an offence under this Act or any of its subsidiary legislation is being or has been committed, he may stop and search the conveyance and may, if on examination he has reasonable cause to believe that such conveyance is or has been used for the commission of such offence, seize the conveyance and any animal, carcass, conveyance, substance or other thing found in the conveyance that is reasonably believed to furnish evidence of the commission of such offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_42__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_42__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_42__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "The person in control or in charge of the conveyance shall, if required to do so by the animal welfare officer—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_42__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_42__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "stop the conveyance and allow the animal welfare officer to examine it; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_42__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_42__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "open all parts of the conveyance for search and take all measures necessary to enable or facilitate the carrying out of the search as the animal welfare officer thinks necessary."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_42__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (2) commits an offence and shall, on conviction, be liable to a fine of not less than ten thousand ringgit and not more than fifty thousand ringgit or to imprisonment for a term not more than one year or to both. Power to seal premises or conveyance"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_43",
      "@type": "akn:clause",
      "eli:number": "43",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_43__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_43__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_43__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_43__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "Where applicable and by reason of its nature, size or amount, it is not practicable to remove any animal, carcass, conveyance, substance or other thing that has been or on any premises or any animal, carcass, conveyance, substance or other thing in any conveyance referred to in subsection 42(1) seized under this section, the animal welfare officer shall, by any means, seal such premises or conveyance from where the animal, carcass, conveyance, substance or other thing was found."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_43__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "The owner or the occupier of the premises or conveyance shall be responsible for the general care or the welfare of the animal, the overall maintenance and safe keeping of any animal, carcass, conveyance, substance or other thing that has been sealed in the premises or conveyance referred to in subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_43__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who, without lawful authority, breaks, tampers with or damages the seal referred to in subsection (1) or removes the animal, carcass, conveyance, substance or other thing that has been sealed, or attempts to do so commits an offence and shall, on conviction, be liable to a fine of not less than ten thousand ringgit and not more than fifty thousand ringgit or to imprisonment for a term not more than one year or to both. List of things seized"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_44",
      "@type": "akn:clause",
      "eli:number": "44",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_44__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_44__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_44__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_44__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "Where any seizure is made under this Act, the animal welfare officer making the seizure shall prepare a list of any animal, carcass, conveyance, substance or other thing seized and of the place in which the animal, carcass, conveyance, substance or other thing is found and shall sign the list."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_44__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_44__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_44__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "The list prepared in accordance with subsection (1) shall be delivered immediately to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_44__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_44__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the occupier of the premises where the any animal, carcass, conveyance, substance or other thing seized is found; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_44__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_44__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the person in control or in charge of the conveyance, if the seizure is made under section 42."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_44__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "Where the seizure is made in or from any premises which is unoccupied, the animal welfare officer shall whenever possible post a list of the things seized conspicuously at or on the premises. Orders to detain animals, carcass, etc., seized under this Act"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_45",
      "@type": "akn:clause",
      "eli:number": "45",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_45__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_45__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_45__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_45",
      "schema:text": {
        "@language": "en",
        "@value": "An animal welfare officer may apply to the Court for an order to detain any animal, carcass, conveyance, substance or other thing which has been seized in respect of any offence under this Act then until the conclusion of such criminal proceeding."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_45__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_45",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this section, “animal” includes offspring of such animal. Orders in relation to animals, carcass, etc., seized under this Act"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_46",
      "@type": "akn:clause",
      "eli:number": "46",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_46__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_46__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_46__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_46__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_46__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_46__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_46__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_46__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_46__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_46__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_46__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "If upon an application by an animal welfare officer, the court is satisfied that, where applicable, any animal, carcass, substance or other thing seized under this Act—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_46__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_46__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "is subject to speedy and natural decay, which is perishable in nature;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_46__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_46__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "is liable to depreciate in value within a short time;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_46__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_46__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "is liable to die in short time due to its deteriorating physical condition;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_46__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_46__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "is dangerous, toxic, harmful or poisonous substance such as banned and dangerous drugs or harmful and poisonous carcass or meat; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_46__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_46__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "whom the custody of which is unreasonable in view of the expense or inconvenience that would thereby involved, may make an order for the said animal, carcass, substance or other thing to be destroyed or otherwise disposed of in such manner as the court may think fit based on the report of a Government registered veterinary surgeon, and the proceeds of sale, if any, shall be kept until the conclusion of such criminal proceedings."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_46__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_46__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_46__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "A court may make an order under subsection (1) if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_46__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_46__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the owner or the licensee has been given an opportunity to be heard; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_46__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_46__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the court is satisfied that it is not reasonably practicable to communicate with the owner or the licensee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_46__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "Where a court makes an order under subsection (1), the court may order a person to pay any expenses to carry out the order."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_46__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "The court, in exercising its power under this section, shall have regard to the necessity of protecting value of the animal and avoiding any increasing of expenses which a person may be ordered to pay."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_46__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this section, “animal” includes offspring of such animal. Animal welfare officer may seek assistance to examine things relating to offence"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_47",
      "@type": "akn:clause",
      "eli:number": "47",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "An animal welfare officer may seek the assistance of any person to examine any animal, carcass, conveyance, substance or other thing seized or detained under this Act if such person has the necessary qualification to examine such animal, carcass, conveyance, substance or other thing for the purposes of an investigation under this Act. Cost of holding animal, etc., seized"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_48",
      "@type": "akn:clause",
      "eli:number": "48",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "Where any animal, carcass, conveyance, substance or other thing seized under this Act is held in the custody of the animal welfare officer pending completion of any proceedings in respect of an offence under this Act, the cost of holding it in custody shall, in the event of any person being convicted of such offence, be a debt due to the Government, by such person and shall be recoverable accordingly. No costs or damages arising from seizure to be recoverable"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII__cl_49",
      "@type": "akn:clause",
      "eli:number": "49",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall, in any proceedings before any court in respect of the seizure of any animal, carcass, conveyance, substance or other thing seized in the exercise or the purported exercise of any power conferred under this Act, be entitled to the costs of such proceedings or to any damages or other relief unless such seizure was made without reasonable cause."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34",
      "@type": "akn:clause",
      "eli:number": "34",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34__subsec_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34__subsec_10"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "If a registered veterinary surgeon certifies in writing that an animal shall be destroyed, an animal welfare officer may destroy or arrange for the animal to be destroyed where it is or take it to another place for it to be destroyed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34__subsec_10",
      "@type": "akn:subsection",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of subsections (3) and (4), “possession” includes the possession of the offspring of any animal taken into possession. Orders in relation to animals taken into possession"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (1), an animal welfare officer may destroy an animal without the certification of a registered veterinary surgeon if it appears to him that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the condition of the animal is such that there is no reasonable alternative to destroy it; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "it is not reasonably practicable to get the certification of a registered veterinary surgeon at that time."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "An animal welfare officer may take an animal into possession if a registered veterinary surgeon certifies that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the animal is suffering; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the animal is likely to suffer if it is not taken into possession."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "An animal welfare officer may act under subsection (3) without the certificate of a registered veterinary surgeon if it appears to him that the animal suffering or likely to suffer or is not reasonably practicable to get certificate from a registered veterinary surgeon at that time."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "A registered veterinary surgeon or an animal welfare officer may examine and take samples from any animal for the purposes of subsection (1) or (3)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34__subsec_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34__subsec_6__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34__subsec_6__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "If any animal is taken into possession under subsection (3), an animal welfare officer may—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34__subsec_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "remove the animal or arrange for it to be removed, to a safe place;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34__subsec_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34__subsec_6__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34__subsec_6__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "care for the animal or arrange for it to be cared for—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34__subsec_6__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34__subsec_6__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "at the premises where the animal was placed when it was taken into possession; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34__subsec_6__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34__subsec_6__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "at any other place as the animal welfare officer thinks fit;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34__subsec_6__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "mark the animal by using any method or in any manner in accordance with this Act, or arrange for it to be marked, for identification purposes."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "Any person may use any equipment at the premises referred to in paragraph (6)(b)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "The animal registered veterinary surgeon or the animal welfare officer shall notify the owner or licensee if any registered veterinary surgeon or animal welfare officer exercises his powers under this section without the knowledge of the owner or the licensee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "The animal welfare officer may make an application to the court for the owner or the licensee to pay any cost and expenses incurred in carrying out his powers under this section."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_35",
      "@type": "akn:clause",
      "eli:number": "35",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_35__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_35__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_35__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_35__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_35__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_35__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_35__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_35__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_35__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_35__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_35__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_35__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subsection (3), if any animal is taken into possession, a court may make an order to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_35__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_35__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "specify any treatment to be administered to the animal by a veterinary authority or any registered veterinary surgeon;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_35__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_35__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "give up the possession of the animal to any other person;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_35__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_35__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "direct the for the selling of the animal;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_35__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_35__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "direct the animal to be disposed by way of sale or otherwise; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_35__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_35__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "direct the animal or carcass to be destroyed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_35__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "If any animal is taken into possession when the animal is pregnant, the court may make an order under subsection (1), in relation to any offspring that results from the pregnancy."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_35__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_35__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_35__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "A court may make an order under subsection (1) if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_35__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_35__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "there is an application by the owner or any other person who has sufficient interest to the animal; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_35__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_35__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the owner or the licensee has been given an opportunity to be heard unless the court is satisfied that it is not reasonably practicable to communicate with the owner or the licensee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_35__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_35__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_35__subsec_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_35__subsec_4__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_35__subsec_4__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "If a court makes an order under subsection (1), the court may—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_35__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_35__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "appoint any person to carry out or arrange for the carrying out of the order;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_35__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_35__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "give directions in relation to the carrying out of the order;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_35__subsec_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_35__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "confer additional powers to any person, including power to enter premises where an animal to which the order applies is placed for the purpose of carrying out of the order; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_35__subsec_4__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_35__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "order a person to pay any expenses to carry out the order."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_35__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "A court, in exercising its power under this section, shall have regard to the necessity of protecting value of the animal and avoiding any increasing of expenses which a person may be ordered to pay."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_35__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_VI__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who intentionally obstructs a person in the exercise of any powers conferred under this section commits an offence and shall, on conviction, be liable to a fine of not less than ten thousand ringgit and not more fifty thousand ringgit or to imprisonment for a term not more than one year or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1__para_k",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1__para_l",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1__para_m",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1__para_n",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1__para_o",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1__para_p",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1__para_q",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1__para_r",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1__para_s",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1__para_t",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1__para_u"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "cruelly beats, kicks, overloads, tortures or terrifies any animals;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "overrides and overdrives any animal, except for activities in relation to equestrian sports which is listed in the First Schedule of the Sports Development Act 1997 [Act 576];"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "causes, procures or, being the owner, permits any animal to be so used;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "being the owner of any animal, or being the person in charge of any animal in confinement, fails or neglects to provide such animal with sufficient food, drink or shelter;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "by wantonly or unreasonably doing or omitting to do any act, causes any unnecessary pain or suffering, or, being the owner, permits any unnecessary pain or suffering to any animal;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "causes, procures or, being the owner, permits any animal to be confined, conveyed, lifted or carried any animal in such manner or position as to subject such animal to unnecessary pain or suffering;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "employs, causes, procures or being the owner permits to be employed at any work labour, any animal which in consequence of any disease, infirmity, wound or sore, or otherwise is unfit to be so employed;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "mutilates any animal in any manner including ear cropping, tail docking, defanging, declawing, branding, piercing or debarking unless in the manner as determined and certified by a veterinary authority or a registered veterinary surgeon;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "skins, roasts or kills any live animals for superstitious belief through a procedure which causes pain and suffering to the animals;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "extracts any parts of any live animals through a procedure which causes pain and suffering to the animals for the purpose of getting skins, oils or other animal products;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "dynamites, electrifies or poisons any streams, rivers or other water bodies for the purpose of killing, harvesting or catching animals;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1__para_l",
      "@type": "akn:paragraph",
      "eli:number": "l",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "keeps any animal chained or tethered by using a short or heavy chain or cord, or hobbles the legs of animal;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1__para_m",
      "@type": "akn:paragraph",
      "eli:number": "m",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "keeps or confines any animal in any cage or other receptacle which does not measure sufficiently in height, length and width to permit the natural movement of the animal;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1__para_n",
      "@type": "akn:paragraph",
      "eli:number": "n",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "offers for sale any animal which is suffering in pain by reason of mutilation, starvation, thirst, overcrowding or other ill-treatment;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1__para_o",
      "@type": "akn:paragraph",
      "eli:number": "o",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "possesses, without reasonable cause, any animal which is suffering in pain by reason of mutilation, starvation, thirst, overcrowding or other ill-treatment;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1__para_p",
      "@type": "akn:paragraph",
      "eli:number": "p",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "abandons any animal in circumstances which it is likely to suffer trauma, pain or suffering by reason of relocation, starvation, thirst, injury, or illness;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1__para_q",
      "@type": "akn:paragraph",
      "eli:number": "q",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "being the owner of any animal, willfully or negligently causes, any animal to go out unattended in any place while the animal is infected with infectious disease;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1__para_r",
      "@type": "akn:paragraph",
      "eli:number": "r",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "being the owner of animal, willfully or negligently causes, any diseased, disabled or injured animal to die in any place;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1__para_s",
      "@type": "akn:paragraph",
      "eli:number": "s",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "causes, obtain or assists at fighting or baiting of any animal, or keeps, uses, manages, acts or assists in management of any premises or place for the purpose of fighting or baiting any animal, or permits any premises or place to be so kept, manage, or used, or receives or causes or obtains any person to receive money for the admission of any person to such premises or place;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1__para_t",
      "@type": "akn:paragraph",
      "eli:number": "t",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "promotes or takes part in any shooting match or competition of which animals are released from captivity for the purpose of such shooting; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1__para_u",
      "@type": "akn:paragraph",
      "eli:number": "u",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "organizes, participates, promotes or in any manner is associated with any sport or activity involving the use of animals, where such animals are subjected to cruelty, either during the sport or activity itself or while in training, commits an offence and shall, on conviction, be liable to a fine of not less than twenty thousand ringgit and not more than one hundred thousand ringgit or to imprisonment for a term not more than three years or both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (1), the following acts shall not constitute as an offence of cruelty:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "any acts which the Board has determined to be accepted veterinary management procedures;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "any baiting of any pest animals for the purposes of public health, disease control, population control and relocation for conservation done by any lawful authority or any person approved by the Board; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_29__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "feeding of animals as food for other animals in accordance with their natural eating habits. Killing of animals"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_30__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_30__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_30__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_30__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_30__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall kill by way of shooting with firearms any dog, cat or any other animal which may be prescribed by the Minister by notification in the Gazette, unless it is authorized by the veterinary authority during emergency or for the purposes of disease control."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_30__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_30__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_30__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_30__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_30__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_30__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_30__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_30__subsec_2__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (1), the killing of any animal is prohibited unless—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_30__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_30__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the killing of the animal is for the purpose of human consumption;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_30__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_30__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the animal is incurably ill as determined and certified by the veterinary authority or a registered veterinary surgeon;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_30__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_30__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the killing of the animal is deemed necessary to end the suffering of such animal as determined and certified by a veterinary authority or a registered veterinary surgeon;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_30__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_30__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the killing is done to prevent an imminent danger to the life or limb of a human being;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_30__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_30__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the killing is done for the purpose of animal population control by any authorized authority under any written law;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_30__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_30__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the killing is approved by the animal ethics committee at the end of any research, testing and teaching procedures; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_30__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_30__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the killing is for any other reasons as determined and certified by a veterinary authority or registered veterinary surgeon."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_30__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this section— “incurably ill” means an animal that is fatally wounded or sick with a grave prognosis certified by a veterinary authority or a registered veterinary surgeon; “animal ethics committee” means the committee established by any institution and is approved by the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_30__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) or (2) commits an offence and shall, on conviction, be liable to a fine of not less than twenty thousand ringgit and not more one hundred thousand ringgit or to imprisonment for a term not more than three years or to both. Administration of poisons"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_31__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_31__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_31__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_31__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_31__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who without lawful authority or reasonable excuse—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_31__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_31__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "administers any poisonous or injurious drug or substance to any animal; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_31__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_31__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "causes any poisonous or injurious drug or substance to be taken by any animal, commits an offence and shall, on conviction, be liable to a fine of not less than twenty thousand ringgit and not more than one hundred thousand ringgit or to imprisonment for a term not more than three years or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_31__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this section, “poisonous or injurious drug or substance” includes a drug or substance which, by virtue of the quantity or manner in which it is administered or taken, has the effect of a poisonous or injurious drug or substance. Animal fighting venture"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32__subsec_1__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32__subsec_1__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32__subsec_1__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32__subsec_1__para_j"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "A person commites an offence if he—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "causes an animal fight to take place, or attempts to do so;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "receives money for the admission to an animal fight;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "publicizes a proposed animal fight;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "provides information about an animal fight to another person with the intention of encouraging attendance at the fight;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "makes or accepts a bet on the result of an animal fight;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "makes or accepts a bet on anything which may occur during the animal fight;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "takes part in an animal fight;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32__subsec_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "has in his possession, anything designed or adapted for the purposes of an animal fight;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32__subsec_1__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "keeps or trains any animal for the purpose of an animal fight; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32__subsec_1__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "has any premises which is used for animal fight."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall, without lawful authority or reasonable excuse—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "present at an animal fight; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "supply, publish, show or possess an audio-visual recording of an animal fight."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraph (2)(b) shall not apply—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "if the audio-visual recording of an animal fight took place outside Malaysia; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "if the supply of an audio-visual recording is for the purposes of its inclusion or, publication or showing in a film, documentary and news."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this section— “audio-visual recording” means a recording, in any form, from which a moving image may by any means be reproduced and includes data stored in a computer, disc or by other electronic means which is capable of being converted to a moving image; “supply of an audio-visual recording” means the supply of an audiovisual recording in any manner including any audiovisual recording in the form of data stored electronically for the purposes of transmitting such data; “publication or showing” means to publicize or show a moving image reproduced from an audiovisual recording by any means; “animal fight venture” means any event that involves a fight between at least two animal and is conducted for the purposes of sport, wagering, or entertainment except the animals are expressing their natural behavior; “animal fight” means an occasion on which an animal is placed with another animal or with a human, for the purposes of fighting, wrestling or baiting."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) or (2) commits an offence and shall, on conviction, be liable to a fine of not less than twenty thousand ringgit and not more one hundred thousand ringgit or to imprisonment for a term not more than three years or to both. Failure to exercise reasonable care and supervision"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_33__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_33__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_33__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who fails to exercise reasonable care and supervision relating to the protection of the animal from cruelty or animal welfare, commits an offence under this Part or any offence relating to animal welfare within the meaning of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_33__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~part_V__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "A person convicted of an offence under subsection (1) by reason of negligence shall not be liable to imprisonment without giving him an option of a fine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~sched_1__para_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~sched_1__para_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/eng@/~sched_1__para_3",
