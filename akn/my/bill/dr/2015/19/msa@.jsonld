      "schema:text": {
        "@language": "ms",
        "@value": "PENGANIAYAAN TERHADAP HAIWAN Kesalahan penganiayaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI",
      "@type": "akn:part",
      "eli:number": "VI",
      "hasPart": [
