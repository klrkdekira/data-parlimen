        "@language": "ms",
        "@value": "Kawalan haiwan terbiar oleh mana-mana individu, organisasi atau badan korporat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~sched_1__para_2",
