        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~sched_1__para_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~sched_1__para_11",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~sched_1__para_12",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~sched_1__para_13"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "[Seksyen 15] Aktiviti yang melibatkan haiwan Aktiviti berikut dianggap sebagai aktiviti yang melibatkan penggunaan haiwan bagi maksud Akta ini:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~sched_1__para_1",
      "@type": "akn:paragraph",
      "eli:number": "1",
