        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_46",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_47",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_48",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_49"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "KUASA YANG BERHUBUNGAN DENGAN PENGUATKUASAAN Pegawai kebajikan haiwan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII",
      "@type": "akn:part",
      "eli:number": "VIII",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_50",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_51",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_52",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_53",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_54",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_55"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "KUASA SAMPINGAN MAHKAMAH Kesalahan kedua atau berikutnya"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_50",
      "@type": "akn:clause",
      "eli:number": "50",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang bersalah untuk kali kedua atau berikutnya atas kesalahan yang sama di bawah Akta ini atau mana-mana perundangan subsidiari yang dibuat di Akta ini, apabila disabitkan, didenda tidak lebih daripada dua kali jumlah denda asal untuk kesalahan itu atau dipenjarakan selama tempoh tidak kurang daripada tiga bulan. Pelucuthakan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_51",
      "@type": "akn:clause",
      "eli:number": "51",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_51__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_51__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_51__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_51__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_51__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_51",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seseorang disabitkan suatu kesalahan di bawah mana-mana seksyen 26, 29, 30, 31 atau 32 dan dia merupakan pemunya atau pemegang lesen yang berhubungan dengan kesalahan yang telah dilakukan, mahkamah di mana dia disabitkan boleh, daripada berurusan atau sebagai tambahan kepada berurusan dengan pemunya atau pemegang lesen dalam apa-apa cara lain, membuat suatu perintah untuk melucuthakan pemunyaan haiwan itu daripada pemunya atau pemegang lesen, atau membuat suatu perintah bagi haiwan itu dilupuskan atau dimusnahkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_51__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_51",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika pemunya atau pemegang lesen haiwan disabitkan dengan suatu kesalahan di bawah subseksyen 52(3) disebabkan pelanggaran subseksyen 52(1), mahkamah di mana dia disabitkan boleh, daripada berurusan atau sebagai tambahan berurusan dengan pemunya atau pemegang lesen dalam apa-apa cara lain, membuat suatu perintah untuk melucuthakan pemunyaan haiwan itu daripada pemunya atau pemegang lesen, atau membuat suatu perintah bagi haiwan itu dilupuskan atau dimusnahkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_51__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_51",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika haiwan yang berkenaan dengan suatu perintah yang dibuat di bawah subseksyen (1) atau (2) mempunyai anak, mahkamah boleh memasukkan dalam perintah, pelucuthakan pemunyaan anak itu atau bagi haiwan itu dilupuskan atau dimusnahkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_51__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_51__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_51__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_51",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mahkamah membuat suatu perintah di bawah subseksyen (1) atau (2), mahkamah boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_51__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_51__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "melantik mana-mana pegawai kebajikan haiwan untuk menjalankan atau mengatur penjalanan, perintah itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_51__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_51__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "memerintahkan pemunya atau pemegang lesen itu membayar apa-apa perbelanjaan untuk melaksanakan perintah itu. Hilang kelayakan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_52",
      "@type": "akn:clause",
      "eli:number": "52",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_52__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_52__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_52__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_52__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_52__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_52__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_52__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_52__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_52",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seseorang disabitkan dengan suatu kesalahan di bawah seksyen 15, 24, 26, 27, 28, 29, 30, 31 atau 32, mahkamah di mana dia disabitkan boleh, daripada berurusan atau sebagai tambahan berurusan dengannya dalam apa-apa cara lain, membuat suatu perintah untuk menghilangkan kelayakan orang itu selama tempoh tidak lebih daripada satu tahun daripada—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_52__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_52__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "memiliki haiwan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_52__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_52__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menyimpan haiwan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_52__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_52__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mengambil bahagian dalam penyimpanan haiwan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_52__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_52__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menjadi pihak pada suatu perkiraan yang di bawahnya dia berhak untuk mengawal atau mempengaruhi cara haiwan itu disimpan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_52__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_52__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_52__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_52",
      "schema:text": {
        "@language": "ms",
        "@value": "Mahkamah boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_52__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_52__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menggantung penjalanan kuat kuasa perintah itu sementara menunggu rayuan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_52__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_52__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "jika mahkamah mendapati seseorang itu memiliki atau menyimpan mana-mana haiwan yang baginya perintah itu terpakai, menggantung penjalanan kuat kuasa perintah itu, dan apa-apa perintah yang dibuat di bawah seksyen 53 berkaitan dengan hilang kelayakan, untuk suatu tempoh yang difikirkannya perlu bagi membolehkan perkiraan alternatif dibuat berkenaan dengan haiwan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_52__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_52",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang melanggar perintah hilang kelayakan di bawah subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak kurang daripada sepuluh ribu ringgit dan tidak lebih daripada lima puluh ribu ringgit atau dipenjarakan selama tempoh tidak lebih daripada satu tahun atau kedua-duanya sekali. Penyitaan haiwan berhubung dengan hilang kelayakan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_53",
      "@type": "akn:clause",
      "eli:number": "53",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_53__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_53__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_53__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_53__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_53",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seseorang disabitkan dengan suatu kesalahan di bawah subseksyen 52(3) kerana melanggar perintah di bawah perenggan 52(1)(a) atau (b), mahkamah yang di mana orang itu disabitkan boleh, memerintahkan semua haiwan diambil dalam pemilikan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_53__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_53",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu perintah di bawah subseksyen (1), yang berhubungan dengan mana-mana haiwan yang dimiliki oleh orang yang tertakluk kepada hilang kelayakan di bawah seksyen 52, hendaklah mempunyai kesan sebagai suatu perintah di bawah seksyen 51."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_53__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_53__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_53__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_53",
      "schema:text": {
        "@language": "ms",
        "@value": "Mahkamah yang membuat perintah di bawah seksyen ini boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_53__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_53__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "melantik seseorang pegawai kebajikan haiwan untuk melaksanakan, atau mengatur pelaksanaan, perintah itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_53__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_53__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "memerintahkan seseorang untuk itu membayar apa-apa perbelanjaan untuk melaksanakan perintah itu. Kuasa mahkamah untuk memerintahkan pemusnahan haiwan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_54",
      "@type": "akn:clause",
      "eli:number": "54",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_54__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_54__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_54__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_54",
      "schema:text": {
        "@language": "ms",
        "@value": "Mahkamah di mana seseorang itu disabitkan dengan suatu kesalahan di bawah seksyen 24, 26, 28, 31 atau 32 boleh memerintahkan pemusnahan haiwan yang berhubung dengan kesalahan itu dilakukan, jika mahkamah berpuas hati, berdasarkan keterangan yang diberikan oleh doktor veterinar berdaftar atau pegawai kebajikan haiwan, bahawa ia wajar melakukan sedemikian demi kepentingan haiwan tersebut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_54__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_54__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_54__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_54",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu mahkamah membuat suatu perintah di bawah subseksyen (1), mahkamah itu boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_54__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_54__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "melantik seorang pegawai kebajikan haiwan untuk menjalankan atau mengatur penjalanan, perintah itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_54__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_54__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "memerintahkan seseorang itu, jika ada, membayar perbelanjaan untuk menjalankan perintah itu. Pelucuthakan item yang digunakan atau berhubung kesalahan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_55",
      "@type": "akn:clause",
      "eli:number": "55",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_55__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_55__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_55__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_55__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_55__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_55__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_55",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seseorang telah disabitkan dengan suatu kesalahan di bawah Akta ini atau mana-mana perundangan subsidiarinya, mahkamah boleh mengarahkan apa-apa item yang berhubungan dengan kesalahan itu dan hasil mana-mana jualan, jika ada, dilucuthakan, dan dimusnahkan atau diuruskan dengan cara yang dinyatakan dalam perintah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_55__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_55",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila apa-apa item berhubungan dengan kesalahan itu disita di bawah Akta ini tetapi orang yang dituduh melakukan kesalahan itu tidak diketahui atau tidak boleh dijumpai, mahkamah boleh, jika ia berpuas hati bahawa suatu kesalahan telah dilakukan, memerintahkan apa-apa item yang berhubungan dengan kesalahan itu dilucuthakan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_55__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_55",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada perintah untuk melucuthakan boleh dibuat berkenaan dengan suatu pengangkut melainkan nama pemunya dan tempat tinggalnya diketahui dan dia diberikan peluang untuk didengar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_55__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_55",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika terdapat apa-apa hasil daripada jualan item yang berhubungan dengan kesalahan itu yang disita di bawah Akta ini, mahkamah boleh, jika ia berpuas hati bahawa suatu kesalahan telah dilakukan, memerintahkan apa-apa hasil itu dilucuthakan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_55__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VIII__cl_55",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini, “item” ertinya apa-apa barang atau bahan berkenaan dengan suatu kesalahan yang telah dilakukan dan yang ialah suatu hal perkara berhubung dengan keterangan yang perlu untuk membuktikan pelakuan kesalahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_36",
      "@type": "akn:clause",
      "eli:number": "36",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_36__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_36__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_36__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_36",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh melantik secara bertulis, apa-apa bilangan pegawai awam untuk menjadi pegawai kebajikan haiwan yang difikirkannya perlu bagi maksud Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_36__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_36",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pegawai kebajikan haiwan hendaklah mempunyai semua kuasa yang terletak hak padanya di bawah Akta ini atau mana-mana perundangan subsidiari yang dibuat di bawah Akta ini. Pembantu sukarela kebajikan haiwan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_37",
      "@type": "akn:clause",
      "eli:number": "37",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_37__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_37__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_37__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga boleh melantik secara bertulis, mana-mana orang yang berkelayakan secara bertulis untuk menjadi pembantu sukarela kebajikan haiwan untuk membantu pegawai kebajikan haiwan bagi maksud Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_37__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "Seorang pembantu sukarela kebajikan haiwan tidak boleh menjalankan mana-mana kuasa di bawah Akta ini atau mana-mana perundangan subsidiari yang dibuat di bawah Akta ini. Kad kuasa"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_38__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_38__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_38__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_38",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi hendaklah mengeluarkan kepada setiap pegawai kebajikan haiwan suatu kad kuasa yang hendaklah ditandatangani oleh Pengerusi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_38__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_38",
      "schema:text": {
        "@language": "ms",
        "@value": "Bila mana seseorang pegawai kebajikan haiwan menjalankan mana-mana kuasa di bawah Akta ini atau mana-mana perundangan subsidiari yang dibuat di bawah Akta ini, dia hendaklah, apabila diminta, mengemukakan kepada orang yang terhadapnya kuasa itu sedang dijalankan, kad kuasa yang dikeluarkan kepadanya di bawah subseksyen (1). Kuasa penyiasatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_39__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_39__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_39__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pegawai kebajikan haiwan hendaklah mempunyai segala kuasa yang perlu untuk menjalankan penyiasatan pelakuan sesuatu kesalahan di bawah Akta ini atau mana-mana perundangan subsidiari yang dibuat di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_39__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud subseksyen (1), Kanun Tatacara Jenayah [Akta 593] hendaklah terpakai dan seseorang pegawai kebajikan haiwan hendaklah mempunyai segala kuasa yang diperuntukkan di bawah Kanun Tatacara Jenayah untuk menjalankan penyiasatan. Penggeledahan dan penyitaan tanpa waran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seseorang pegawai penguat kuasa berpuas hati atas maklumat yang diterima bahawa dia mempunyai sebab yang munasabah untuk mempercayai bahawa oleh sebab kelengahan dalam memperoleh suatu waran geledah di bawah seksyen 56 Kanun Tatacara Jenayah penyiasatan akan terjejas atau keterangan mengenai pelakuan suatu kesalahan mungkin diganggu, dialihkan, dirosakkan atau dimusnahkan, pegawai kebajikan haiwan itu boleh memasuki premis itu dan menjalankan di dalam, di atas dan berkenaan dengan premis itu semua kuasa yang disebut dalam seksyen 56 Kanun Tatacara Jenayah dengan cara yang sepenuhnya dan secukupnya seolah-olah dia diberi kuasa untuk berbuat demikian oleh suatu waran yang dikeluarkan di bawah seksyen itu. Kuasa untuk memasuki premis"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_41",
      "@type": "akn:clause",
      "eli:number": "41",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_41__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_41__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_41__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun seksyen 40, mana-mana pegawai kebajikan haiwan boleh memasuki mana-mana premis bagi maksud—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_41__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "memeriksa mana-mana haiwan, karkas, pengangkut, bahan atau benda lain yang difikirkannya perlu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_41__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "menentusahkan ketepatan rekod atau pernyataan atau apa- apa maklumat yang diberikan kepada seseorang pegawai kebajikan haiwan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_41__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "mengambil sampel mana-mana haiwan, karkas, pengangkut, bahan atau benda lain yang dijumpai di dalam premis yang difikirkannya perlu bagi maksud analisis tanpa apa-apa bayaran. Kuasa untuk memberhentikan, menggeledah dan menyita pengangkut"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_42",
      "@type": "akn:clause",
      "eli:number": "42",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_42__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_42__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_42__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_42__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_42",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seseorang pegawai kebajikan haiwan mempunyai sebab yang munasabah untuk mengesyaki bahawa mana-mana pengangkut sedang membawa mana-mana haiwan, karkas, pengangkut, bahan atau benda lain yang berkenaan dengannya suatu kesalahan di bawah Akta ini atau mana-mana perundangan subsidiarinya sedang atau telah dilakukan, dia boleh memberhentikan dan menggeledah pengangkut itu dan boleh, jika setelah pemeriksaan itu dia mempunyai sebab yang munasabah untuk mempercayai bahawa pengangkut itu sedang atau telah digunakan untuk melakukan kesalahan itu, menyita pengangkut itu dan mana-mana haiwan, karkas, pengangkut, bahan atau benda lain yang dijumpai di dalam pengangkut itu yang dengan semunasabahnya dipercayai untuk memberikan keterangan mengenai pelakuan kesalahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_42__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_42__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_42__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_42",
      "schema:text": {
        "@language": "ms",
        "@value": "Orang yang mengawal atau menjaga pengangkut itu hendaklah, jika dikehendaki untuk berbuat demikian oleh pegawai kebajikan haiwan itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_42__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_42__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "memberhentikan pengangkut itu dan membenarkan pegawai kebajikan haiwan itu memeriksa pengangkut itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_42__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_42__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "membuka semua bahagian pengangkut itu untuk digeledah dan mengambil segala langkah yang perlu untuk membolehkan atau memudahkan penjalanan penggeledahan itu sebagaimana yang difikirkan perlu oleh pegawai kebajikan haiwan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_42__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_42",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (2) melakukan suatu kesalahan di bawah Akta ini dan boleh, apabila disabitkan, didenda tidak kurang daripada sepuluh ribu ringgit dan tidak melebihi lima puluh ribu ringgit atau dipenjarakan selama tempoh tidak daripada satu tahun atau kedua-duanya. Kuasa untuk mengelak premis atau pengangkut"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_43",
      "@type": "akn:clause",
      "eli:number": "43",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_43__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_43__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_43__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_43__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika terpakai dan oleh sebab jenis, saiz atau amaunnya, adalah tidak munasabah untuk memindahkan mana-mana binatang, karkas, pengangkut, bahan atau benda lain yang pernah ada atau berada di mana-mana premis atau mana-mana binatang, karkas, pengangkut, bahan atau benda lain di dalam mana-mana pengangkut di subsekyen 42(1) disita di bawah seksyen ini, pegawai kebajikan haiwan itu hendaklah, dengan apa-apa cara, mengelak premis atau pengangkut di mana haiwan, bangkai, pengangkut, bahan atau benda lain dijumpai."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_43__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Pemunya atau penghuni premis atau pengangkut itu hendaklah bertanggungjawab bagi penjagaan umum atau kebajikan haiwan, keseluruhan penyelenggaraan dan penyimpanan selamat mana- mana haiwan, karkas, pengangkut, bahan atau benda lain yang telah dielak di dalam premis atau kenderaan yang disebut dalam subseksyen (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_43__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang, tanpa kuasa yang sah, memecahkan, mengganggu atau merosakkan lak yang disebut dalam subseksyen (1) atau memindahkan haiwan, karkas, pengangkut, bahan atau benda lain yang dilak atau cuba untuk berbuat demikian melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak kurang daripada sepuluh ribu ringgit dan tidak lebih daripada lima puluh ribu ringgit atau dipenjarakan selama tempoh tidak lebih daripada satu tahun atau kedua-duanya. Senarai benda yang disita"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_44",
      "@type": "akn:clause",
      "eli:number": "44",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_44__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_44__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_44__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_44__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_44",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika apa-apa penyitaan dibuat di bawah Akta ini, pegawai kebajikan haiwan yang membuat penyitaan itu hendaklah menyediakan suatu senarai mana-mana haiwan, karkas, pengangkut, bahan atau benda lain yang disita itu dan tempat di mana haiwan, karkas, pengangkut, bahan atau benda lain itu dijumpai dan hendaklah menandatangani senarai itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_44__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_44__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_44__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_44",
      "schema:text": {
        "@language": "ms",
        "@value": "Senarai yang disediakan mengikut subseksyen (1) hendaklah diserahkan dengan serta-merta kepada—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_44__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_44__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "penghuni premis tempat mana-mana haiwan, karkas, pengangkut, bahan atau benda lain yang disita itu dijumpai; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_44__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_44__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "orang yang mengawal atau menjaga pengangkut itu, jika penyitaan itu dibuat di bawah seksyen 42."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_44__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_44",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika penyitaan itu dibuat di dalam atau dari mana-mana premis yang tidak diduduki, pegawai kebajikan haiwan itu hendaklah bila-bila mungkin menampalkan senarai benda yang disita itu supaya mudah dilihat di atau pada premis itu. Perintah menahan haiwan, karkas, dsb., yang disita di bawah Akta ini"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_45",
      "@type": "akn:clause",
      "eli:number": "45",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_45__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_45__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_45__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_45",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang Pegawai kebajikan haiwan boleh memohon kepada mahkamah untuk mendapatkan suatu perintah untuk menahan mana-mana haiwan, karkas, pengangkut, bahan atau benda lain yang telah disita yang berkenaan dengan kesalahan di bawah Akta ini sehingga selesai prosiding jenayah itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_45__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_45",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini, “haiwan” termasuklah anak kepada haiwan itu. Perintah berhubung dengan haiwan, karkas, dsb., yang disita di bawah Akta ini"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_46",
      "@type": "akn:clause",
      "eli:number": "46",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_46__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_46__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_46__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_46__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_46__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_46__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_46__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_46__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_46__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_46__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika atas permohonan oleh seseorang pegawai kebajikan haiwan, mahkamah berpuas hati bahawa, jika terpakai, mana-mana haiwan, karkas, bahan atau benda lain yang disita di bawah Akta ini—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_46__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_46__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "adalah tertakluk kepada pereputan yang cepat dan semula jadi yang sifatnya tidak tahan lama;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_46__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_46__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "boleh susut nilai dalam tempoh masa yang singkat;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_46__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_46__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "boleh mati dalam masa yang singkat kerana keadaan fizikalnya yang merosot;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_46__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_46__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "adalah bahan yang berbahaya, bertoksik, memudaratkan atau beracun seperti dadah yang diharamkan dan berbahaya, karkas atau daging yang memudaratkan dan beracun; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_46__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_46__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "di mana jagaan yang tidak munasabah memandangkan perbelanjaan atau kesusahan yang akan terlibat, boleh membuat suatu perintah untuk haiwan, karkas, bahan atau benda lain tersebut dimusnahkan atau selainnya dilupuskan mengikut cara yang mahkamah fikirkan sesuai berdasarkan laporan doktor veterinar berdaftar Kerajaan, dan hasil jualan itu, jika ada, hendaklah disimpan sehingga selesai prosiding jenayah itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_46__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_46__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_46__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Mahkamah boleh membuat suatu perintah di bawah subseksyen (1) jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_46__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_46__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pemunya atau pemegang lesen itu telah diberi peluang untuk didengar; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_46__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_46__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mahkamah berpuas hati bahawa adalah tidak dapat dilaksanakan secara munasabah untuk menghubungi pemunya atau pemegang lesen."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_46__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mahkamah membuat suatu perintah di bawah subseksyen (1), mahkamah boleh memerintahkan seseorang untuk membayar apa-apa perbelanjaan bagi menjalankan perintah itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_46__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Mahkamah, dalam menjalankan kuasanya di bawah seksyen ini, hendaklah mengambil kira keperluan untuk melindungi nilai haiwan dan mengelakkan apa-apa peningkatan perbelanjaan yang seseorang boleh diperintahkan untuk membayar. ( 5) Bagi maksud seksyen ini, “haiwan” termasuk anak kepada haiwan tersebut. Pegawai kebajikan haiwan boleh meminta bantuan untuk memeriksa benda yang berhubungan dengan kesalahan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_47",
      "@type": "akn:clause",
      "eli:number": "47",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pegawai kebajikan haiwan boleh meminta bantuan mana-mana orang untuk memeriksa mana-mana haiwan, karkas, pengangkut, bahan atau benda lain yang disita atau ditahan di bawah Akta ini jika orang itu mempunyai kelayakan yang perlu untuk memeriksa haiwan, karkas, pengangkut, bahan atau benda lain bagi maksud sesuatu penyiasatan di bawah Akta ini. Kos menyimpan haiwan, dsb., yang disita"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_48",
      "@type": "akn:clause",
      "eli:number": "48",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana haiwan, karkas, pengangkut, bahan atau benda lain di bawah Akta ini dipegang dalam jagaan oleh pegawai kebajikan haiwan sementara menunggu penyelesaian apa-apa prosiding berkenaan dengan suatu kesalahan di bawah Akta ini, kos bagi memegangnya dalam jagaan hendaklah, sekiranya mana- mana orang disabitkan dengan kesalahan itu, menjadi hutang yang kena bayar kepada Kerajaan oleh orang itu dan bolehlah didapatkan semula dengan sewajarnya. Tiada kos atau ganti rugi yang berbangkit daripada penyitaan boleh didapatkan semula"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII__cl_49",
      "@type": "akn:clause",
      "eli:number": "49",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh, dalam apa-apa prosiding di hadapan mana-mana mahkamah berkenaan dengan penyitaan mana-mana haiwan, karkas, pengangkut, bahan atau benda lain yang disita pada menjalankan atau berupa sebagai menjalankan mana-mana kuasa yang diberikan di bawah Akta ini, berhak untuk mendapat kos prosiding itu atau apa-apa ganti rugi atau relif lain melainkan jika penyitaan itu dibuat tanpa sebab yang munasabah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34",
      "@type": "akn:clause",
      "eli:number": "34",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34__subsec_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34__subsec_10"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seseorang doktor veterinar berdaftar memperakui secara bertulis bahawa haiwan itu hendaklah dimusnahkan, seseorang pegawai kebajikan haiwan boleh memusnahkan atau mengaturkan supaya haiwan itu dimusnahkan di mana haiwan itu berada atau membawanya ke suatu tempat lain untuk haiwan itu dimusnahkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34__subsec_10",
      "@type": "akn:subsection",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud subseksyen (3) dan (4), “pemilikan” termasuklah pemilikan anak mana-mana haiwan yang diambil milik. Perintah berhubung dengan haiwan yang diambil milik"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (1), seseorang pegawai kebajikan haiwan boleh memusnahkan mana-mana haiwan tanpa perakuan doktor veterinar berdaftar jika ternyata kepadanya bahawa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "keadaan haiwan itu menunjukkan tiadanya alternatif yang munasabah untuk memusnahkannya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak dapat dilaksanakan secara munasabah untuk mendapatkan perakuan doktor veterinar berdaftar pada masa itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pegawai kebajikan haiwan boleh mengambil haiwan itu dalam pemilikan jika seseorang doktor veterinar berdaftar memperakui bahawa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "haiwan itu sedang menderita; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "haiwan itu berkemungkinan akan menderita jika haiwan itu tidak diambil dalam pemilikan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pegawai kebajikan haiwan boleh bertindak di bawah subseksyen (3) tanpa perakuan seseorang doktor veterinar berdaftar jika ternyata kepadanya bahawa haiwan itu sedang menderita atau berkemungkinan akan menderita atau tidak dapat dilaksanakan secara munasabah untuk mendapatkan perakuan seseorang doktor veterinar berdaftar pada masa itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang doktor veterinar berdaftar atau seseorang pegawai kebajikan haiwan boleh memeriksa dan mengambil sampel daripada mana-mana haiwan bagi maksud subseksyen (1) atau (3)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34__subsec_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34__subsec_6__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34__subsec_6__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana haiwan yang diambil dalam pemilikan di bawah subseksyen (3), seseorang pegawai kebajikan haiwan boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34__subsec_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "mengalihkan haiwan itu atau mengaturkannya supaya ia dialihkan, ke suatu tempat selamat;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34__subsec_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34__subsec_6__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34__subsec_6__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "menjaga haiwan itu atau mengaturkan supaya ia dijaga—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34__subsec_6__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34__subsec_6__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "di premis di mana haiwan itu diletakkan apabila ia diambil dalam pemilikan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34__subsec_6__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34__subsec_6__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "di mana-mana tempat lain yang difikirkan oleh pagawai kebajikan haiwan sesuai;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34__subsec_6__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "menandakan haiwan itu dengan menggunakan apa-apa kaedah atau apa-apa cara menurut Akta ini, atau mengaturkan supaya ia ditandakan, bagi maksud pengecaman."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang boleh menggunakan apa-apa peralatan di premis yang disebut dalam perenggan (6)(b)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34",
      "schema:text": {
        "@language": "ms",
        "@value": "Doktor veterinar berdaftar atau pegawai kebajikan haiwan hendaklah memaklumkan pemunya atau pemegang lesen jika doktor veterinar berdaftar atau pegawai kebajikan haiwan menjalankan kuasanya di bawah seksyen ini tanpa pengetahuan pemunya atau pemegang lesen."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_34",
      "schema:text": {
        "@language": "ms",
        "@value": "Pegawai kebajikan haiwan itu boleh membuat suatu permohonan kepada mahkamah untuk pemunya atau pemegang lesen untuk membayar apa-apa perbelanjaan yang ditanggung dalam menjalankan kuasanya di bawah seksyen ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_35",
      "@type": "akn:clause",
      "eli:number": "35",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_35__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_35__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_35__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_35__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_35__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_35__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_35__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_35__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_35__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_35__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_35__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_35__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada subseksyen (3), jika mana-mana haiwan diambil milik, mahkamah boleh membuat perintah untuk—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_35__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_35__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menyatakan apa-apa rawatan untuk diberikan kepada haiwan oleh pihak berkuasa veterinar atau mana-mana doktor veterinar berdaftar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_35__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_35__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menyerahkan hak milik haiwan kepada mana-mana orang lain;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_35__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_35__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mengarahkan supaya haiwan itu dijual;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_35__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_35__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mengarahkan supaya haiwan dilupuskan melalui jualan atau selainnya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_35__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_35__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mengarahkan supaya haiwan atau karkas itu dimusnahkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_35__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika haiwan diambil milik ketika ia bunting, mahkamah boleh membuat perintah di bawah subseksyen (1), berhubung dengan mana-mana anak yang lahir daripada kandungan tersebut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_35__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_35__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_35__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "Mahkamah boleh membuat perintah di bawah subseksyen (1) jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_35__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_35__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "terdapat permohonan oleh pemilik atau mana-mana orang lain yang mmpunyai kepentingan yang mencukupi terhadap haiwan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_35__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_35__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "pemunya atau pemegang lesen telah diberikan peluang untuk didengar melainkan jika mahkamah berpuas hati bahawa adalah tidak dapat dilaksanakan secara munasabah untuk berkomunikasi dengan pemunya atau pemegang lesen."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_35__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_35__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_35__subsec_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_35__subsec_4__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_35__subsec_4__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mahkamah membuat suatu perintah di bawah subseksyen (1), mahkamah boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_35__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_35__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "melantik mana-mana orang untuk menjalankan atau mengatur untuk menjalankan perintah itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_35__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_35__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "memberi arahan berhubung dengan menjalankan perintah itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_35__subsec_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_35__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "memberikan kuasa tambahan kepada mana-mana orang, termasuk kuasa untuk memasuki premis di mana haiwan yang baginya perintah itu terpakai ditempatkan bagi maksud menjalankan perintah itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_35__subsec_4__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_35__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "mengarahkan seseorang untuk membayar perbelanjaan untuk menjalankan perintah itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_35__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "Mahkamah, dalam menjalankan kuasanya di bawah seksyen ini hendaklah mengambil kira keperluan untuk melindungi nilai haiwan dan mengelakkan apa-apa kenaikan perbelanjaan yang seseorang itu boleh diperintahkan untuk membayar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_35__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VI__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang dengan sengaja menghalang seseorang yang menjalankan apa-apa kuasa yang diberikan di bawah seksyen ini melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak kurang daripada sepuluh ribu ringgit dan tidak lebih daripada lima puluh ribu ringgit atau dipenjarakan selama tempoh tidak lebih daripada satu tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1__para_k",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1__para_l",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1__para_m",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1__para_n",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1__para_o",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1__para_p",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1__para_q",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1__para_r",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1__para_s",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1__para_t",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1__para_u"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan kejamnya memukul, menyepak, melebihkan muatan, mendera atau menakutkan mana-mana haiwan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "terlebih naik atau terlebih tunggang mana-mana haiwan, kecuali untuk aktiviti berhubungan dengan sukan ekuestrian seperti yang disenaraikan di bawah Jadual Pertama kepada Akta Pembangunan Sukan 1997 [Akta 576];"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menyebabkan, memperoleh atau, sebagai pemunya, membenarkan mana-mana haiwan dipergunakan sedemikian;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "sebagai pemunya mana-mana haiwan, atau sebagai penjaga mana-mana haiwan di dalam kurungan, tidak menyediakan makanan, minuman atau tempat perlindungan yang mencukupi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan kejamnya atau secara tidak munasabah membuat atau meninggalkan untuk melakukan apa-apa perbuatan, menyebabkan kesakitan atau penderitaan yang tidak perlu atau, sebagai pemunya, membenarkan apa-apa kesakitan atau penderitaan yang tidak perlu kepada mana-mana haiwan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menyebabkan, memperoleh atau, sebagai pemunya, membenarkan mana-mana haiwan dikurung, diangkut, diangkat atau dibawa mana-mana haiwan dengan apa- apa cara atau kedudukan yang menyebabkan haiwan itu mengalami kesakitan atau penderitaan yang tidak perlu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mengambil kerja, menyebabkan, memperoleh atau sebagai pemunya membenarkan diambil bekerja di mana-mana tempat kerja, mana-mana haiwan yang disebabkan oleh apa-apa penyakit, lemah, luka atau sakit, atau sebaliknya tidak sesuai untuk diambil bekerja;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mencacatkan mana-mana haiwan dengan apa-apa cara termasuklah memotong telinga, memendekkan ekor, mencabut gigi taring, mencabut kuku, menyelar, menindik atau mengurangkan salakan melainkan dengan apa-apa cara yang ditentukan dan diperakukan oleh pihak berkuasa veterinar atau doktor veterinar berdaftar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "melapah, memanggang atau membunuh mana-mana haiwan yang masih hidup kerana kepercayaan karut melalui tatacara yang menyebabkan kesakitan dan penderitaan kepada haiwan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mengeluarkan mana-mana bahagian haiwan yang masih hidup melalui suatu tatacara yang menyebabkan kesakitan dan penderitaan kepada haiwan bagi maksud untuk mendapatkan kulit, minyak atau produk haiwan yang lain;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "memasang dinamit, mengelektrikan atau membubuh racun ke dalam mana-mana anak sungai, sungai atau jasad air yang lain bagi maksud untuk membunuh, menuai atau menangkap haiwan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1__para_l",
      "@type": "akn:paragraph",
      "eli:number": "l",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "membiarkan mana-mana haiwan dirantai atau ditambat dengan menggunakan rantai atau tali yang pendek atau berat, atau mengikat kaki haiwan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1__para_m",
      "@type": "akn:paragraph",
      "eli:number": "m",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menyimpan atau mengurung mana-mana haiwan di dalam sangkar atau bekas lain yang ukuran tinggi, panjang dan lebarnya tidak mencukupi bagi membenarkan pergerakan semula jadi haiwan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1__para_n",
      "@type": "akn:paragraph",
      "eli:number": "n",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat tawaran jualan mana-mana haiwan yang sedang menderita kesakitan disebabkan oleh kecacatan, kebuluran, dahaga, kesesakan atau perbuatan aniaya yang lain;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1__para_o",
      "@type": "akn:paragraph",
      "eli:number": "o",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "memiliki, tanpa alasan yang munasabah, mana-mana haiwan yang sedang menderita kesakitan disebabkan oleh kecacatan, kebuluran, dahaga, kesesakan atau perbuatan aniaya yang lain;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1__para_p",
      "@type": "akn:paragraph",
      "eli:number": "p",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "meninggalkan mana-mana haiwan dalam keadaan yang boleh menyebabkan haiwan itu mengalami trauma, kesakitan atau penderitaan atas sebab penempatan semula, kebuluran, dahaga, kecederaan, atau penyakit;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1__para_q",
      "@type": "akn:paragraph",
      "eli:number": "q",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "sebagai pemunya mana-mana haiwan, dengan sengaja atau cuai menyebabkan mana-mana haiwan keluar tanpa pengawasan di mana-mana tempat ketika haiwan itu dijangkiti penyakit berjangkit;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1__para_r",
      "@type": "akn:paragraph",
      "eli:number": "r",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "sebagai pemunya mana-mana haiwan, dengan sengaja atau cuai menyebabkan, mana-mana haiwan yang cedera, tidak berupaya atau berpenyakit untuk mati di mana-mana tempat;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1__para_s",
      "@type": "akn:paragraph",
      "eli:number": "s",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menyebabkan, mendapatkan atau membantu dalam pelagaan atau pengumpanan mana-mana haiwan, atau menyimpan, menggunakan, menguruskan, melakukan atau membantu dalam pengurusan mana-mana premis atau tempat bagi maksud pelagaan atau pengumpanan mana-mana haiwan, atau membenarkan mana-mana premis atau tempat dijaga, diurus atau digunakan, atau menerima, menyebabkan atau mendapatkan mana-mana orang untuk menerima wang bagi kemasukan mana-mana orang ke premis atau tempat itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1__para_t",
      "@type": "akn:paragraph",
      "eli:number": "t",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menggalakkan atau mengambil bahagian dalam mana-mana pertandingan menembak atau pertandingan yang haiwan dilepaskan dari kurungan bagi maksud penembakan itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1__para_u",
      "@type": "akn:paragraph",
      "eli:number": "u",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menganjurkan, mengambil bahagian, menggalakkan atau dengan apa-apa cara bersekutu dengan apa-apa sukan atau aktiviti yang melibatkan penggunaan haiwan, yang haiwan itu tertakluk kepada penganiayaan sama ada semasa sukan atau aktiviti itu sendiri atau semasa dalam latihan, adalah melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak kurang daripada dua puluh ribu ringgit dan tidak lebih daripada satu ratus ribu ringgit atau dipenjarakan selama tempoh tidak lebih daripada tiga tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (1), perbuatan berikut tidaklah menjadi suatu kesalahan penganiayaan:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa perbuatan yang telah ditentukan oleh Lembaga sebagai tatacara pengurusan veterinar yang diterima pakai;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa pengumpanan mana-mana haiwan perosak bagi maksud kesihatan awam, pengawalan penyakit, pengawalan populasi dan penempatan semula bagi pemuliharaan yang dilakukan oleh pihak berkuasa yang sah atau mana-mana orang yang diluluskan oleh Lembaga; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_29__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "memberi makan haiwan sebagai makanan bagi haiwan lain menurut tabiat pemakanan semula jadi haiwan itu. Pembunuhan haiwan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_30__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_30__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_30__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_30__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_30__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh membunuh dengan menembak dengan senjata api mana-mana anjing, kucing atau mana-mana binatang lain yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta, melainkan jika dibenarkan oleh pihak berkuasa veterinar dalam kecemasan atau bagi maksud kawalan penyakit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_30__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_30__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_30__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_30__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_30__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_30__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_30__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_30__subsec_2__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (1), pembunuhan mana-mana haiwan adalah dilarang melainkan jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_30__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_30__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pembunuhan haiwan itu bagi maksud untuk dimakan oleh manusia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_30__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_30__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "haiwan itu mengalami sakit yang tidak dapat dirawat sebagaimana yang ditentukan dan diperakui oleh seseorang pihak berkuasa veterinar atau seseorang doktor veterinar berdaftar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_30__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_30__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pembunuhan itu disifatkan perlu bagi menamatkan penderitaan haiwan itu sebagaimana yang ditentukan dan diperakui oleh seseorang pihak berkuasa veterinar atau seseorang doktor veterinar berdaftar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_30__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_30__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pembunuhan itu dilakukan untuk mencegah bahaya yang sudah nyata kepada kehidupan atau anggota badan manusia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_30__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_30__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pembunuhan itu dilakukan bagi maksud kawalan populasi haiwan oleh mana-mana pihak berkuasa yang dibenarkan di bawah mana-mana undang-undang bertulis;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_30__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_30__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pembunuhan itu diluluskan oleh jawatankuasa etika haiwan pada akhir mana-mana prosedur penyelidikan, ujian dan pengajaran; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_30__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_30__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pembunuhan itu, bagi apa-apa sebab yang ditentukan dan diperakukan oleh pihak berkuasa veterinar atau doktor veterinar berdaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_30__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini— “sakit yang tidak dapat dirawat” ertinya haiwan yang telah cedera parah atau sakit dengan prognosis genting yang diperakukan oleh pihak berkuasa veterinar atau doktor veterinar berdaftar; “jawatankuasa etika haiwan” ertinya jawatankuasa yang ditubuhkan oleh mana-mana institusi dan diluluskan oleh Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_30__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1) dan (2) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak kurang daripada dua puluh ribu ringgit dan tidak lebih daripada satu ratus ribu ringgit atau dipenjarakan selama tempoh tidak lebih daripada tiga tahun atau kedua-duanya. Pemberian racun"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_31__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_31__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_31__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_31__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_31__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_31",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang tanpa kebenaran yang sah atau sebab yang munasabah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_31__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_31__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "memberikan apa-apa ubat atau bahan beracun atau memudaratkan kepada mana-mana haiwan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_31__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_31__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menyebabkan apa-apa ubat atau bahan yang beracun atau memudaratkan diambil oleh mana-mana haiwan, melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak kurang daripada dua puluh ribu ringgit dan tidak lebih daripada satu ratus ribu ringgit atau dipenjarakan selama tempoh tidak lebih daripada tiga tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_31__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_31",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini, “ubat atau bahan yang beracun atau memudaratkan” termasuklah ubat atau bahan yang, oleh sebab kuantiti atau cara yang diberikan atau diambil, mempunyai kesan suatu ubat atau bahan beracun atau memudaratkan. Usaha niaga pelagaan haiwan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "(1) Seseorang melakukan kesalahan jika dia— (a) menyebabkan suatu pelagaan haiwan berlaku, atau percubaan untuk berbuat sedemikian; (b) menerima wang untuk menyertai/memasuki suatu laga haiwan; (c) membuat publisiti suatu pelagaan haiwan yang dicadangkan; (d) memberikan maklumat tentang suatu pelagaan haiwan kepada orang lain dengan niat untuk membolehkan atau menggalakkan kehadiran ke perlagaan itu; (e) membuat atau menerima suatu pertaruhan ke atas suatu keputusan pelagaan haiwan; (f) membuat atau menerima suatu pertaruhan ke atas sesuatu yang mungkin berlaku semasa pelagaan haiwan itu; (g) mengambil bahagian dalam pelagaan haiwan; (h) ada dalam milikannya, apa-apa yang direka atau diubah suai bagi maksud pelagaan haiwan; (i) menyimpan atau melatih mana-mana haiwan bagi maksud pelagaan haiwan; atau (j) mempunyai mana-mana premis bagi maksud pelagaan haiwan. (2) Tiada seorang pun boleh tanpa kuasa yang sah atau sebab yang munasabah— (a) hadir pada suatu pelagaan haiwan; atau (b) membekalkan, menyiarkan, menunjukkan atau memiliki suatu rakaman audio-visual pelagaan haiwan. (3) Perenggan (2)(b) tidak terpakai— (a) jika rakaman audio-visual pelagaan haiwan berlaku di luar Malaysia; atau (b) jika pembekalan suatu rakaman audio-visual adalah bagi maksud memasukkan atau penyiaran dan penayangan dalam filem, dokumentari dan berita. (4) Bagi maksud seksyen ini— “rakaman audio-visual” ertinya suatu rakaman, dalam apa-apa bentuk, daripada suatu imej yang bergerak yang boleh dengan apa-apa cara diterbitkan semula dan termasuklah data yang disimpan dalam komputer, cakera atau cara elektronik lain yang boleh ditukarkan kepada suatu imej yang bergerak; “pembekalan suatu rakaman audio-visual” ertinya membekalkan suatu rakaman audio-visual dalam apa-apa cara termasuklah apa-apa rakaman audio-visual dalam bentuk data yang disimpan secara elektronik bagi maksud memindahkan data tersebut; “penyiaran dan penayangan” ertinya menyiarkan atau menayangkan suatu imej bergerak yang diterbitkan semula daripada suatu rakaman audio-visual melalui apa-apa cara; “usaha niaga pelagaan haiwan” ertinya apa-apa acara yang melibatkan suatu pelagaan antara sekurang-kurangnya dua haiwan dan usaha niaga itu dijalankan bagi maksud sukan, pertaruhan atau hiburan kecuali haiwan itu mempamerkan kelakuan semula jadi mereka; dan “ pelagaan haiwan” ertinya suatu acara apabila haiwan itu ditempatkan bersama-sama dengan satu haiwan lain atau dengan manusia, bagi maksud berlaga, bergusti atau mengumpan. (5) Mana-mana orang yang melanggar subseksyen (1) atau (2) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak kurang daripada dua puluh ribu ringgit dan tidak lebih daripada satu ratus ribu ringgit atau dipenjarakan selama tempoh tidak lebih daripada tiga tahun atau kedua-duanya. Kegagalan menjalankan jagaan dan pengawasan yang munasabah"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_33__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_33__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_33__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_33",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang tidak menjalankan jagaan dan pengawasan yang munasabah yang berhubungan dengan perlindungan haiwan daripada penganiayaan atau kebajikan haiwan, melakukan suatu kesalahan di bawah Bahagian ini atau mana-mana kesalahan yang berhubungan dengan kebajikan haiwan mengikut pengertian Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_33__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_V__cl_33",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang disabitkan dengan suatu kesalahan di bawah subseksyen (1) atas sebab kecuaian tidak boleh dipenjarakan tanpa memberikannya pilihan untuk denda."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~sched_1__para_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~sched_1__para_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~sched_1__para_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~sched_1__para_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~sched_1__para_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~sched_1__para_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~sched_1__para_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~sched_1__para_8",
