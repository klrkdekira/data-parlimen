      "schema:text": {
        "@language": "ms",
        "@value": "HAIWAN DALAM DISTRES Kuasa yang berhubung dengan haiwan dalam distres"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/19/msa@/~part_VII",
