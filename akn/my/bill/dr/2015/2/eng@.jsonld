        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_11"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "The Board shall, with the approval of the Minister, appoint a Chief Executive Officer on such conditions as the Board deems desirable."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_10",
      "@type": "akn:subsection",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "The Chief Executive Officer shall be paid such remuneration as the Board may determine with the approval of the Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_11",
      "@type": "akn:subsection",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraphs 14(a), (b), (c), (d), (e), (f), (g) and (i) shall apply to the Chief Executive Officer. Appointment of employees"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_2__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "The Chief Executive Officer shall be a person who—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "has the academic qualification and experience which will enable him to satisfactorily discharge his responsibilities;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "has not held a position of responsibility in the management of a company which has been convicted of an offence under any written law during his tenure of office unless he proves that such offence was committed without his knowledge or consent and he was not in a position to prevent the offence;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_2__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_2__para_c__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_2__para_c__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "has not held a position of responsibility in the management of any company which during his tenure of office—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_2__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_2__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "has defaulted in the payment of any judgment sum against the company;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_2__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_2__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "has suspended payment to or has compounded with, the creditors of the company; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_2__para_c__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_2__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "has had a receiver or manager appointed in respect of the property of the company;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "is available for full time employment, and shall not carry on any other business or vocation, except as a non- executive director or shareholder of another company;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "has not caused a conflict of interest situation with that of the Board, either by himself or through his relative; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "has not acted in a manner which may cast doubt on his fitness to hold the position of Chief Executive Officer, or acted in blatant disregard for proper professional conduct."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "The Chief Executive Officer shall have such powers and duties as may be conferred or imposed upon him by the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "The Chief Executive Officer shall be responsible for the overall administration and management of the functions and the day-to-day affairs of the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "The Chief Executive Officer shall have general control of the employees of the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "In discharging his duties, the Chief Executive Officer shall act under the general authority and direction of the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_7__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_7__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subsection (8), the Board may appoint temporarily any employee of the Board to act as the Chief Executive Officer for a period when—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "the office of the Chief Executive Officer is vacant;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "the Chief Executive Officer is absent from duty or from Malaysia; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_7__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "the Chief Executive Officer is, for any other reason, unable to perform the duties of his office."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "The Board shall obtain the approval of the Minister if the appointment under subsection (7) is for more than six months."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "The Chief Executive Officer shall be an employee of the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may, from time to time, appoint and employ such number of employees as the Board deems necessary for carrying out the purposes of this Act. Conditions of service, conduct and discipline"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_20__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_20__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_20__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_20__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_20__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_20__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_20__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may determine the conditions of service of its employees."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_20__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "The Board shall have disciplinary authority over all its employees and shall exercise disciplinary control over the employees."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_20__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may prescribe regulations to provide for the conduct and discipline of its employees."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_20__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_20__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_20__subsec_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_20__subsec_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "The regulations prescribed under this section may include—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_20__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_20__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "provisions for the establishment of an appropriate disciplinary committee and the procedures to be complied with;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_20__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_20__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "provisions for the establishment of a disciplinary appeal committee to hear appeals against the decision of a disciplinary committee and the procedures to be complied with; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_20__subsec_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_20__subsec_4__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_20__subsec_4__para_c__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_20__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "provisions for— of an employee of the Board during the pendency of the disciplinary proceedings."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_20__subsec_4__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_20__subsec_4__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "the interdiction with reduction in salary or other remuneration; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_20__subsec_4__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_20__subsec_4__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "the suspension without salary or other remuneration,"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_20__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "The regulations prescribed under this section may create such disciplinary offences and provide for such disciplinary punishments as the Board deems appropriate, and the punishments so provided may extend to dismissal and reduction in rank."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_20__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "The regulations prescribed under this section shall, in prescribing the procedure for disciplinary proceedings, provide for an opportunity for representations to be made by the employee of the Board against whom the disciplinary proceedings are taken before a decision is arrived at by the disciplinary committee on such disciplinary charge laid against such employee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "The members of the Board shall be paid such allowances as the Minister may determine. Revocation and resignation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_11__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, at any time, revoke the appointment of any member of the Board appointed under paragraph 8(1)(e) or (f)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_11__subsec_2__para_e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "Any member of the Board appointed under paragraph 8(1)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_11__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_11__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "or (f) may, at any time, resign by giving a one-month written notice to the Minister. Meetings and procedures of the Board"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_12__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_12__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_12__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_12__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_12__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_12__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_12__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_12__subsec_9"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The Board shall convene its meetings at least twice in a year at such time and place as the Chairman may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "All meetings of the Board shall be presided by the Chairman or, in the absence of the Chairman, the Deputy Chairman."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_12__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_12__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_12__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The quorum of the meeting of the Board shall be five and shall consist of at least—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_12__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_12__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "two members of the Board appointed under paragraphs 8(1)(b), (c) or (e), not including the Deputy Chairman if the meeting is presided by the Deputy Chairman; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_12__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_12__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "one member of the Board appointed under paragraph 8(1)(f)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_12__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The decisions of the Board shall be adopted by a simple majority of votes of the members present and voting, and in the case of an equality of votes, the Chairman shall have a casting vote in addition to his deliberative vote."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_12__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "Any minutes of meetings of the Board shall, if duly signed by the Chairman, be admissible as evidence of the facts stated therein in any legal proceedings and every meeting in respect of which minutes have been so made shall be deemed to have been duly convened and held and all members thereat to have been duly qualified to act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_12__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The Board shall cause minutes of all its meetings to be maintained and kept in a proper form."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_12__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_12__subsec_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_12__subsec_7__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "A resolution is taken to have been passed—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_12__subsec_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_12__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "at a meeting of the Board, if all members of the Board have been informed of the proposed resolution, or reasonable efforts have been made to inform all members of the Board of the proposed resolution; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_12__subsec_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_12__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "without meeting, if all members of the Board indicate agreement with the resolution in accordance with the method determined by the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_12__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_12__subsec_8__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_12__subsec_8__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection (7) applies only if the Board—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_12__subsec_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_12__subsec_8",
      "schema:text": {
        "@language": "en",
        "@value": "decides that the subsection applies; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_12__subsec_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_12__subsec_8",
      "schema:text": {
        "@language": "en",
        "@value": "decides the method by which members of the Board are to indicate agreement with the resolution."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_12__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may determine its own procedure. Committees"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_13__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_II__cl_13__subsec_3",
