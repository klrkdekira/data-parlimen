        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_III__cl_18__subsec_4",
