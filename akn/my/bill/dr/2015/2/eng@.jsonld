        "@value": "ADDITIONAL POWERS OF THE BOARD Power to borrow"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII",
      "@type": "akn:part",
      "eli:number": "VII",
