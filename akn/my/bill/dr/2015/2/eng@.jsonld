        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_31"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "FINANCIAL PROVISIONS The Fund"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VI",
      "@type": "akn:part",
      "eli:number": "VI",
