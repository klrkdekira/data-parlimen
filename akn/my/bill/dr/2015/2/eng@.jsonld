        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_38",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_39",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_40",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_41",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_42",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_43"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "GENERAL Delegation of powers"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VIII",
      "@type": "akn:part",
      "eli:number": "VIII",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VIII__cl_44",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VIII__cl_45",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VIII__cl_46",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VIII__cl_47"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "REPEAL, SAVINGS AND TRANSITIONAL Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VIII__cl_44",
      "@type": "akn:clause",
      "eli:number": "44",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VIII",
      "schema:text": {
        "@language": "en",
        "@value": "In this Part, “appointed date” means the date appointed under subsection 1(2) for the coming into operation of Part VIII. Repeal of the Housing Loans Fund Act 1971"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VIII__cl_45",
      "@type": "akn:clause",
      "eli:number": "45",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VIII",
      "schema:text": {
        "@language": "en",
        "@value": "On the appointed date, the Housing Loans Fund Act 1971 is repealed. Savings and transitional"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VIII__cl_46",
      "@type": "akn:clause",
      "eli:number": "46",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VIII__cl_46__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VIII__cl_46__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VIII__cl_46__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VIII__cl_46__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VIII__cl_46__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VIII__cl_46__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VIII__cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "Any application, approval, direction, decision, recommendation, specification, notice or other acts or things issued, made or done under the repealed Act and in force or having effect immediately before the appointed date, shall be deemed to have been issued, made or done under this Act, and shall continue to remain in force and have effect in relation to the person to whom it applied until amended or substituted."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VIII__cl_46__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VIII__cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "Any application, approval or decision under the repealed Act pending immediately before the appointed date shall, on the appointed date, be dealt with by the Board under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VIII__cl_46__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VIII__cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "Neither the repeal of the repealed Act nor anything contained in this Act shall affect the liability of any person to be prosecuted or punished for offences committed under the repealed Act before the appointed date, or any proceedings brought or sentence imposed before that date in respect of such offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VIII__cl_46__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VIII__cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to this Act, any proceedings whether civil or criminal, or cause of action by or against the Government or any person acting on its behalf, pending or existing immediately before the appointed date in relation to the repealed Act may be continued or instituted by or against the Board as it might have been by or against the Government or such person as if this Act had not been enacted."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VIII__cl_46__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VIII__cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "Any appeal brought or any leave to appeal applied for on or after the appointed date against a decision given in any legal proceedings to which the Government was a party in relation to the repealed Act before the appointed date may be brought by or against the Board. Transfer of funds"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VIII__cl_47",
      "@type": "akn:clause",
      "eli:number": "47",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VIII",
      "schema:text": {
        "@language": "en",
        "@value": "On the appointed date, the moneys standing to the credit of the Housing Loans Fund specified in the Second Schedule to the Financial Procedure Act 1957 [Act 61] shall be transferred into the Fund."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_35",
      "@type": "akn:clause",
      "eli:number": "35",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_35__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_35__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_35__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_35__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_35__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_35__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_35__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_35__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may, in writing, delegate any of its functions and powers, other than its powers to borrow moneys and raise fund under this Act to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_35__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_35__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Chairman or other member of the Board;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_35__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_35__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a committee; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_35__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_35__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "an employee of the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_35__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "The Chairman, other member of the Board, a committee or an employee of the Board, as the case may be, delegated with such functions or powers shall be bound to observe and have regard to all conditions and restrictions imposed by the Board and all requirements, procedures and matters specified by the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_35__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "Any function or power delegated under this section shall be performed and exercised in the name and on behalf of the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_35__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "A delegation under this section shall not preclude the Board itself from performing or exercising at any time any of the delegated functions or powers. Power of Minister to give directions"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_36",
      "@type": "akn:clause",
      "eli:number": "36",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may give to the Board directions of a general character consistent with this Act relating to the performance of the functions and the exercise of the powers of the Board and the Board shall give effect to such directions. Returns, reports, accounts and other information"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_37",
      "@type": "akn:clause",
      "eli:number": "37",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_37__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_37__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_37__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "The Board shall furnish to the Minister such returns, reports, accounts and other information as the Minister may, from time to time, require."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_37__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "The returns, reports, accounts and other information shall be in such form and contain such particulars relating to the proceedings and policy of the Board and any other matters as the Minister may, from time to time, specify. Public Authorities Protection Act 1948"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "The Public Authorities Protection Act 1948 [Act 198] shall apply to any action, suit, prosecution or proceedings against the Board, any member of the Board or committee, or any employee of the Board in respect of any act, neglect or default done or committed or any omission by it or him in good faith, in such capacity. Public servants"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "All members of the Board and committee and employees of the Board, while discharging their duties under this Act, shall be deemed to be public servants within the meaning of the Penal Code [Act 574]. Representation in civil proceedings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_40__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_40__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII",
      "schema:name": {
        "@language": "en",
        "@value": "Notwithstanding any other written law—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_40__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "in any civil proceedings by or against the Board; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_40__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "in any other civil proceedings in which the Board is required or permitted by the court to be represented, or to be heard, or is otherwise entitled to be represented or to be heard, any person authorized by the Board for that purpose may, on behalf of the Board, institute such proceedings or appear in such proceedings and may make all appearances and applications and do all acts in respect of the proceedings on behalf of the Board. Obligation of secrecy"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_41",
      "@type": "akn:clause",
      "eli:number": "41",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_41__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_41__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_41__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "Except for the purposes of this Act or any civil or criminal proceedings under any written law or where otherwise authorized by the Board, no member of the Board or committee, or any employee or agent of the Board, or any person attending any meeting of the Board or committee, or any other person, who for any reason has, by any means, access to any information or document relating to the affairs of the Board shall give, divulge, reveal or otherwise disclose such information or document to any person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_41__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) commits an offence and shall, on conviction, be liable to a fine not exceeding ten thousand ringgit or to imprisonment for a term not exceeding three years or to both. Things done in anticipation of the enactment of this Act"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_42",
      "@type": "akn:clause",
      "eli:number": "42",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "All acts and things done on behalf of the Board in preparation for or in anticipation of the enactment of this Act and any expenditure incurred in relation thereto shall be deemed to have been authorized under this Act, provided that the acts and things done are consistent with the general intention and purposes of this Act; and all rights, interests, obligations and liabilities acquired or incurred as a result of the doing of those acts or things including any expenditure incurred in relation thereto shall upon the coming into operation of this Act be deemed to be the rights, interests, obligations and liabilities of the Board. Power to make regulations"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII__cl_43",
      "@type": "akn:clause",
      "eli:number": "43",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, with the recommendation of the Board, make such regulations as are necessary or expedient for the purposes of carrying out the provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VI__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may, with the prior approval of the Minister, borrow, at such rate of interest and for such period and upon such terms as to the time and method of repayment and otherwise as the Minister may approve, any money required by the Board for meeting any of its obligations or performing any of its functions. Power to invest"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VI__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VI__cl_33__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VI__cl_33__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "The Fund may, in so far as they are not required to be expended by the Board under this Act, be invested with the approval of the Minister, in the following manner:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VI__cl_33__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VI__cl_33__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VI__cl_33__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VI__cl_33__para_a__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VI__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "by depositing in—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VI__cl_33__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VI__cl_33__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "the Central Bank of Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VI__cl_33__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VI__cl_33__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "licensed banks or licensed investment banks licensed under the Financial Services Act 2013 [Act 758]; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VI__cl_33__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VI__cl_33__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "licensed Islamic banks licensed under the Islamic Financial Services Act 2013 [Act 759] but shall not include licensed international Islamic bank; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VI__cl_33__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VI__cl_33__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VI__cl_33__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VI__cl_33__para_b__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VI__cl_33__para_b__subpara_iv"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VI__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "by investing in— Power to establish or acquire corporation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VI__cl_33__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VI__cl_33__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "securities issued by the Government;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VI__cl_33__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VI__cl_33__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "securities which are fully guaranteed by the Government;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VI__cl_33__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VI__cl_33__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "securities issued by the Central Bank of Malaysia; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VI__cl_33__para_b__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VI__cl_33__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "securities which are fully guaranteed by the Central Bank of Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VI__cl_34",
      "@type": "akn:clause",
      "eli:number": "34",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "The Board may, with the approval of the Minister, establish or acquire any corporation established under the Companies Act 1965 [Act 125] and Trust Companies Act 1949 [Act 100] necessary for the purpose of raising of fund, provided that the corporation so established or acquired by the Board is prohibited from establishing subsidiary of the corporation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_26__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_26__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_26__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "A fund to be known as the “Public Sector Home Financing Fund” is established and shall be administered and controlled by the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_26__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_26__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_26__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_26__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_26__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_26__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_26__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_26__subsec_2__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_26__subsec_2__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_26__subsec_2__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_26__subsec_2__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_26__subsec_2__para_k"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "The Fund shall consist of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_26__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_26__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "sums as may be provided from time to time by Parliament;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_26__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_26__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "moneys borrowed by the Board under section 32;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_26__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_26__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "sums of public sector home financing facility as may be repaid from time to time to the Board and sums from time to time falling due to the Board in respect of the repayment of any public sector home financing facility;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_26__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_26__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "sums representing the settlement of the principal of any public sector home financing facility and interest or profit due thereon, as the case may be, unless the Board authorizes the settlement of any such sums to any person pursuant to any arrangement entered into with such person under which any public sector home financing facility, or any right or interest derived or arising from the grant of any public sector home financing facility, is sold, disposed of or transferred to such person;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_26__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_26__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "moneys received from the sale or realization of any public sector home financing facility or any right or interest derived or arising from the grant of any public sector home financing facility, or from or pursuant to any arrangement entered into with any person under which any public sector home financing facility, or any right or interest derived or arising from the grant of a public sector home financing facility, is sold, disposed of or transferred to such person;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_26__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_26__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "fees and charges imposed by or payable to the Board;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_26__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_26__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "moneys derived as income from the investment by the Board under section 33;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_26__subsec_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_26__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "moneys derived from the sale, disposal, lease or hire of, or any other dealings with, any property, right, interest, obligation and liability transferred to, vested in or acquired by the Board;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_26__subsec_2__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_26__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "other moneys and properties which may, in any manner, become payable to or vested in the Board in respect of the performance of its functions and exercise of its powers;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_26__subsec_2__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_26__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "any cost paid to or recovered by the Board in any settlement of action or proceedings, civil or criminal; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_26__subsec_2__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_26__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "moneys and properties lawfully received by the Board. Expenditure to be charged on the Fund"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_27__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_27__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_27__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "The Fund shall be applied towards the grant of public sector home financing facilities to the approved eligible persons."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_27__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_27__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_27__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_27__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_27__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_27__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_27__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_27__subsec_2__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_27__subsec_2__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_27__subsec_2__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_27__subsec_2__para_j"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "The Fund may be applied for the purposes of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_27__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_27__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "repaying any moneys borrowed under section 32;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_27__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_27__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "settling the debts, obligations and liabilities transferred to and vested in the Board pursuant to section 4;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_27__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_27__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "paying for the allowances and other expenses to the members of the Board and committees, and any person invited to the meetings of the Board and committees;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_27__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_27__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "paying for the remuneration, allowances and other expenses of the employees of the Board, including the granting of loans, scholarships and advances, retirement benefits, medical benefits and other allowances;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_27__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_27__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the investment under section 33;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_27__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_27__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "paying expenses, costs or expenditure in relation to the procurement of goods and services, including the engagement of agents and advisors, legal fees and costs and other fees and costs, properly incurred or accepted by the Board in the performance of its functions and exercise of its powers;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_27__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_27__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "purchasing or hiring equipment, machinery and any other materials, acquiring land and any property, and erecting buildings, and carrying out any other works and undertakings in the performance of the functions or the exercise of the powers of the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_27__subsec_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_27__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "paying expenses or moneys required to satisfy any judgment, decision or award by any court or tribunal against the Board, or any member of the Board or committee, or any employee or agent of the Board in respect of any act, neglect or default done or committed in the performance of the functions or the exercise of the powers of the Board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_27__subsec_2__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_27__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "defraying the expenses, expenditure or costs properly and necessarily incurred by the Board in granting the public sector home financing facilities; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_27__subsec_2__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_27__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "such other expenses and expenditure as may be permitted by this Act or any regulations made under this Act, or incurred in the performance of the functions or the exercise of the powers of the Board. Annual estimates"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_28__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_28__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_28__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "The Chief Executive Officer shall, not later than one month before the commencement of each financial year, lay before the Board an estimate of the expenditure of the Board including capital expenditure for the ensuing year in such form and containing such particulars as the Board may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_28__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "A copy of the estimate referred to in subsection (1) shall be sent to each member of the Board not later than fourteen days prior to the meeting before which the estimate is to be laid. Bank accounts"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "The Board shall open and maintain an account or accounts with such bank or banks as the Board deems fit, and every such account shall be operated as far as practicable by cheques signed by any person as may, from time to time, be authorized by the Board. Statutory Bodies (Accounts and Annual Reports) Act 1980"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "The Statutory Bodies (Accounts and Annual Reports) Act 1980 [Act 240] shall apply to the Board. Financial procedure"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/2/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to section 30, the Board shall determine its own financial procedure and may adopt with such modifications as it deems fit any regulations, rules, policies, circulars and directives made or issued by the Government on financial procedure."
      }
    }
  ]
}
