      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the definition of “prescribed institution” the following definition: ‘ “Shariah committee” means the Shariah committee established under section 33f;’;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/20/eng@/~cl_3__para_a__subpara_vi",
