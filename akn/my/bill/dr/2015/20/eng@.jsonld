      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/20/eng@/~cl_79__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (c)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/20/eng@/~cl_79__para_a__subpara_iii__subpara_A",
      "@type": "akn:subparagraph",
      "eli:number": "A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/20/eng@/~cl_79__para_a__subpara_iii",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words “report or document” the words “report, document, computer, computer output, system, data, books or information”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/20/eng@/~cl_79__para_a__subpara_iii__subpara_B",
