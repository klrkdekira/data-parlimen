      "eli:number": "B",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/20/eng@/~cl_79__para_a__subpara_iii",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the words “so seized and detained” the words “, including access to any program or data held in any computer or have access to, inspect or check the operation of any computer and any associated apparatus or material”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/20/eng@/~cl_79__para_a__subpara_iv",
      "@type": "akn:subparagraph",
