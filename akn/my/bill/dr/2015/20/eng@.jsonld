      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (a), by substituting for the words “report or document seized” the words “report, document, apparatus, equipment, machinery, computer, computer output, system, data, books or information seized”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/20/eng@/~cl_79__para_d__subpara_ii",
