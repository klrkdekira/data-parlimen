      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (d), by substituting for the words “report or document” the words “report, document, apparatus, equipment, machinery, computer, computer output, system, data, books or information”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/20/eng@/~cl_79__para_a__subpara_v",
