      "schema:text": {
        "@language": "en",
        "@value": "Subsection 113(1) of the principal Act is amended by deleting the words “, including the daily fine, if any, in the case of a continuing offence,”. NEW SECTIONS 114A, 114B, 114C AND 114D"
      }
