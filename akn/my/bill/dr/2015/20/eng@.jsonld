      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the definition of “liabilities” the following definition: ‘ “Shariah Advisory Council” means the Shariah Advisory Council established under the Central Bank of Malaysia Act 2009 [Act 701];’;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/20/eng@/~cl_3__para_a__subpara_x",
      "@type": "akn:subparagraph",
      "eli:number": "x",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/20/eng@/~cl_3__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the definition of “officer” the following definition: ‘ “senior officer”, in relation to a prescribed institution, means a person, other than the Chief Executive Officer or a director, having authority and responsibility for planning, directing or controlling the activities of a prescribed institution including the chief operating officer, members of decision-making committees and other persons performing key functions such as risk management, compliance, internal audit or other functions as may be specified by the Bank under section 41, but shall not include a member of a Shariah committee;’;"
      }
    },
