    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/20/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/20/eng@/~cl_3__para_a",
