    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/21/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/21/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Judges’ Remuneration (Amendment) Act 2015."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/21/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/21/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Substitution of section 13"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/21/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/21/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Judges’ Remuneration Act 1971 [Act 45] is amended by substituting for section 13 the following section: “Pension not assignable or transferable, etc. 13. No pension or other benefit granted under this Act shall be assignable or transferable, or liable to be attached, sequestered or levied upon, for or in respect of any debt or claim whatsoever other than— (a) a debt due to the Government; or (b) a debt due to the Public Sector Home Financing Board established under the Public Sector Home Financing Board Act 2015 [Act 767] in respect of a public sector home financing facility granted by the Board.”."
      }
    }
  ]
