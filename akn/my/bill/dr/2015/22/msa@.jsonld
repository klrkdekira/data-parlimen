        "@value": "Rang Undang-Undang Polis (Pindaan) 2015"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/22/msa@/~cl_1",
      "@type": "akn:clause",
