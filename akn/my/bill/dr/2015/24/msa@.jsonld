      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal suatu perkongsian, setiap pekongsi dalam perkongsian itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_VI__cl_36__subsec_2__para_c",
