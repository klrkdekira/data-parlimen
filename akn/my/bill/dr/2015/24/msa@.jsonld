        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_25__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_25__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis hendaklah mempunyai kuasa tatatertib ke atas pengamal berdaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_25__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_25__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_25__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_25__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_25__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_25__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_25__subsec_2__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis boleh menjalankan kuasa tatatertib ke atas mana-mana pengamal berdaftar—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_25__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_25__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "yang telah disabitkan atas suatu kesalahan di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_25__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_25__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "yang telah disabitkan oleh mahkamah di Malaysia atau di mana-mana tempat lain atas apa-apa kesalahan yang melibatkan rasuah, fraud, kecurangan atau keburukan akhlak, atau apa-apa kesalahan lain yang boleh dihukum dengan pemenjaraan, sama ada hukuman penjara sahaja atau sebagai tambahan kepada atau sebagai ganti denda, lebih daripada dua tahun;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_25__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_25__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "yang kelulusannya telah ditarik balik atau dibatalkan oleh pihak berkuasa penganugerah yang melaluinya kelulusan itu diperoleh atau yang daripadanya kelulusan itu dianugerah;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_25__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_25__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "yang telah dilarang daripada mengamalkan Profesion Kesihatan Bersekutu di mana-mana tempat luar Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_25__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_25__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "yang dikatakan telah melakukan salah laku profesional yang serius sebagaimana yang ditetapkan dalam kod etika dan tatakelakuan profesional dan mana-mana garis panduan dan arahan lain yang dikeluarkan oleh Majlis; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_25__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_25__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "yang telah mendapatkan pendaftaran di bawah Akta ini melalui fraud atau salah nyataan. Jawatankuasa Penyiasat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_26__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_26__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_26__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_26__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis boleh, dari semasa ke semasa, menubuhkan Jawatankuasa Penyiasat untuk menyiasat apa-apa aduan atau maklumat yang diterima terhadap pengamal berdaftar atau apa-apa perkara tatatertib yang boleh disiasat oleh Majlis."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_26__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_26__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_26__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatankuasa Penyiasat hendaklah terdiri daripada anggota yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_26__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_26__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "anggota Majlis yang hendaklah menjadi pengerusi; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_26__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_26__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana anggota lain daripada kalangan pengamal berdaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_26__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatankuasa Penyiasat hendaklah menentukan sama ada perlu atau tidak suatu siasatan diadakan berdasarkan siasatannya dan hendaklah mengesyorkan dapatannya kepada Pihak Berkuasa Tatatertib. Pihak Berkuasa Tatatertib"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_27__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_27__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_27__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_27__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_27__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis boleh, dari semasa ke semasa, menubuhkan Pihak Berkuasa Tatatertib."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_27__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_27__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_27__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "Pihak Berkuasa Tatatertib hendaklah terdiri daripada anggota yang berikut, yang bukan orang yang dilantik di bawah subsekyen 26(2):"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_27__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_27__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "anggota Majlis yang hendaklah menjadi pengerusi; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_27__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_27__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana anggota lain daripada kalangan pengamal berdaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_27__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila Jawatankuasa Penyiasat mengesyorkan kepada Pihak Berkuasa Tatatertib untuk menyiasat apa-apa aduan atau maklumat yang diterima terhadap pengamal berdaftar, atau apa-apa perkara tatatertib yang boleh disiasat oleh Majlis, Pihak Berkuasa Tatatertib hendaklah menyiasat aduan, maklumat atau apa-apa perkara tatatertib itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_27__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "Pihak Berkuasa Tatatertib hendaklah mengesyorkan dapatannya kepada Majlis bagi Majlis membuat keputusan. Perintah sementara"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_28__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_28__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_28__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_28__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_28__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_28__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_28__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_28__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_28__subsec_9"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_28__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_28__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_28__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika, berdasarkan dapatan Jawatankuasa Penyiasat dan Pihak Berkuasa Tatatertib, Majlis berpuas hati adalah perlu bagi perlindungan orang awam atau selainnya demi kepentingan awam, Majlis boleh membuat perintah yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_28__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_28__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "supaya pendaftaran pengamal berdaftar itu digantung bagi tempoh yang tidak melebihi dua belas bulan sebagaimana yang dinyatakan dalam perintah yang hendaklah dikenali sebagai perintah penggantungan sementara; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_28__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_28__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "supaya pendaftaran pengamal berdaftar itu diteruskan atas kepatuhannya terhadap apa-apa syarat yang difikirkan patut oleh Majlis untuk dikenakan, sepanjang tempoh masa yang tidak melebihi dua belas bulan, sebagaimana yang dinyatakan dalam perintah yang hendaklah dikenali sebagai perintah bagi sekatan pendaftaran sementara."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_28__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis boleh melanjutkan atau melanjutkan seterusnya suatu perintah yang dibuat di bawah subseksyen (1) dan setiap pelanjutan hendaklah bagi suatu tempoh tidak melebihi enam bulan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_28__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar hendaklah memberitahu pengamal berdaftar tentang perintah yang dibuat di bawah subseksyen (1) dan (2)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_28__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_28__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_28__subsec_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_28__subsec_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis boleh, atas permohonan pengamal berdaftar berkenaan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_28__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_28__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal perintah penggantungan sementara, membatalkan perintah itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_28__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_28__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal perintah bagi sekatan pendaftaran sementara, membatalkan perintah itu atau mengubah apa-apa syarat yang dikenakan oleh perintah itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_28__subsec_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_28__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam mana-mana hal dalam perenggan (a) atau (b), menggantikan tempoh yang dinyatakan dalam perintah atau dalam perintah yang melanjutkannya dengan tempoh lain yang dinyatakan dalam perintah itu atau perintah yang melanjutkannya itu, semasa perintah itu dibuat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_28__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu perintah penggantungan sementara atau perintah bagi sekatan pendaftaran sementara hendaklah berkuat kuasa sehingga berakhirnya tempoh yang dinyatakan dalam perintah itu atau, jika dilanjutkan di bawah subseksyen (2), dalam perintah pelanjutan itu atau, tarikh tamatnya prosiding, yang mana lebih awal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_28__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "Semasa pendaftaran seseorang digantung oleh sebab suatu perintah penggantungan sementara, dia tidak boleh disifatkan sebagai berdaftar walaupun namanya masih terdapat dalam Daftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_28__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "Sebaik sahaja tamat tempoh atau pembatalan perintah penggantungan sementara atau perintah bagi sekatan pendaftaran sementara, hak dan keistimewaan orang itu sebagai pengamal berdaftar hendaklah dikembalikan semula dari tarikh tamat tempoh atau pembatalan itu, dengan syarat dia telah mematuhi semua terma perintah itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_28__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pengamal berdaftar yang melanggar perintah penggantungan sementara atau perintah bagi sekatan pendaftaran sementara yang dikenakan ke atasnya melakukan suatu kesalahan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_28__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pengamal berdaftar yang terkilan dengan suatu perintah yang dibuat di bawah seksyen ini boleh merayu kepada Menteri, dan keputusan Menteri adalah muktamad. Hukuman tatatertib"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_29__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_29__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_29__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_29__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_29__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_29__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis boleh, dalam menjalankan kuasa tatatertibnya, mengenakan mana-mana satu atau lebih hukuman yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_29__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "memerintahkan supaya nama pengamal berdaftar itu dipotong daripada Daftar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_29__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "memerintahkan supaya nama pengamal berdaftar itu digantung daripada Daftar bagi apa-apa tempoh yang difikirkan patut oleh Majlis;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_29__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "memerintahkan supaya pengamal berdaftar itu dicela."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_29__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis boleh, dalam mana-mana hal, membuat apa-apa perintah yang difikirkan patut oleh Majlis berkaitan pembayaran kos kepada Pendaftar, sekiranya ada, dan mana-mana pengadu, dan apa-apa kos yang diawardkan boleh dituntut sebagai hutang sivil. Rayuan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_30__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_30__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_30__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang terkilan dengan suatu perintah yang dibuat terhadapnya oleh Majlis pada menjalankan kuasa tatatertibnya boleh, dalam tempoh tiga puluh hari dari tarikh pembuatan perintah itu, merayu kepada Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_30__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, dalam mempertimbangkan suatu rayuan di bawah subseksyen (1), mengesahkan, mengakas atau mengubah perintah yang dirayu itu, dan keputusan Menteri adalah muktamad. Kemasukan semula selepas rayuan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang namanya telah dipotong daripada Daftar menurut suatu perintah Majlis di bawah seksyen 29 hendaklah, jika rayuannya dibenarkan, dimasukkan semula namanya ke dalam Daftar dan Pendaftar hendaklah mengeluarkan perakuan pendaftaran atau perakuan amalan sementara, mengikut mana-mana yang berkenaan, kepadanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_11",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_12",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_13",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_14"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "(Seksyen 5) Tempoh jawatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_1",
      "@type": "akn:paragraph",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_10",
      "@type": "akn:paragraph",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_10__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_10__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_10__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis dan jawatankuasa hendaklah menyebabkan supaya minit kesemua mesyuaratnya disenggarakan dan disimpan dalam bentuk yang sepatutnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Minit mesyuarat Majlis dan jawatankuasa, jika ditandatangani dengan sewajarnya, hendaklah, dalam mana-mana prosiding undang-undang, diterima sebagai keterangan prima facie mengenai fakta yang dinyatakan dalam minit itu tanpa bukti selanjutnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_10__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap mesyuarat Majlis dan jawatankuasa yang minit berkenaan dengannya telah dibuat mengikut subperenggan (1) dan (2) hendaklah disifatkan telah dipanggil dan diadakan dengan sewajarnya dan semua anggota dalam mesyuarat itu layak dengan sewajarnya untuk bertindak."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_10__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu jawatankuasa hendaklah menyebabkan salinan minit mesyuaratnya dikemukakan kepada Majlis secepat yang dapat dilaksanakan. Tatacara"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_11",
      "@type": "akn:paragraph",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis dan jawatankuasa boleh mengawal selia tatacaranya sendiri. Elaun"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_12",
      "@type": "akn:paragraph",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Anggota Majlis, jawatankuasa dan mana-mana orang lain yang diundang untuk menghadiri mana-mana mesyuarat atau pertimbangtelitian Majlis dan jawatankuasa hendaklah dibayar elaun atau perbelanjaan yang ditentukan oleh Menteri. Penzahiran kepentingan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_13",
      "@type": "akn:paragraph",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_13__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_13__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang anggota Majlis atau mana-mana jawatankuasa atau mana-mana orang yang diundang untuk menghadiri mesyuarat Majlis atau jawatankuasa, yang secara langsung atau tidak langsung, mempunyai kepentingan berhubung dengan apa-apa perkara yang dibincangkan oleh Majlis atau jawatankuasa hendaklah menzahirkan kepada Majlis atau jawatankuasa, mengikut mana-mana yang berkenaan, hakikat dan jenis kepentingannya itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Penzahiran di bawah subperenggan (1) hendaklah direkodkan dalam minit mesyuarat Majlis atau jawatankuasa, mengikut mana-mana yang berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_13__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_13__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_13__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Selepas penzahiran di bawah subperenggan (1), anggota Majlis atau jawatankuasa atau mana-mana orang yang diundang untuk menghadiri mesyuarat Majlis atau jawatankuasa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_13__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_13__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak boleh mengambil bahagian atau menghadiri apa-apa pertimbangtelitian atau semasa Majlis atau jawatankuasa membuat apa-apa keputusan, mengikut mana-mana yang berkenaan, mengenai perkara itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_13__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_13__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak boleh diambil kira bagi maksud membentuk korum Majlis atau jawatankuasa, mengikut mana-mana yang berkenaan, dalam pertimbangtelitian atau semasa membuat apa-apa keputusan mengenai perkara itu. Kesahan perbuatan dan prosiding"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_14",
      "@type": "akn:paragraph",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_14__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_14__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada perbuatan atau prosiding yang diambil di bawah Akta ini boleh dipersoalkan atas alasan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_14__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_14",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa kekosongan dalam keanggotaan, atau apa-apa kecacatan dalam penubuhan, Majlis atau jawatankuasa; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_14__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_14",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa peninggalan, kecacatan atau ketidakteraturan yang tidak menyentuh merit sesuatu kes."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang anggota Majlis daripada sektor swasta atau institusi pengajian tinggi, melainkan jika dia terlebih dahulu meletakkan atau mengosongkan, jawatannya atau pelantikannya terlebih dahulu dibatalkan, hendaklah memegang jawatan bagi tempoh tiga tahun dan layak untuk dilantik semula bagi tempoh tidak melebihi tiga tahun."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Anggota yang disebut dalam subperenggan (1) tidak layak untuk memegang jawatan melebihi dua penggal berturut-turut. Anggota silih ganti"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_2",
      "@type": "akn:paragraph",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_2__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_2__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_2__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_2__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh melantik bagi setiap anggota Majlis daripada sektor awam seorang anggota silih ganti yang mempunyai kelayakan yang sama dengan anggota itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Anggota silih ganti boleh menghadiri mesyuarat Majlis bagi menggantikan anggota apabila anggota itu atas apa-apa sebab tidak dapat hadir."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_2__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Anggota silih ganti yang menghadiri mana-mana mesyuarat Majlis hendaklah bagi segala maksud disifatkan sebagai anggota Majlis."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_2__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Anggota silih ganti hendaklah, melainkan jika dia terlebih dahulu meletakkan jawatannya atau perlantikannya terlebih dahulu dibatalkan, terhenti daripada menjadi anggota silih ganti apabila anggota yang baginya dia merupakan anggota silih ganti terhenti menjadi anggota Majlis. Pengosongan jawatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_3",
      "@type": "akn:paragraph",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_3__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_3__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_3__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_3__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_3__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_3__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_3__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_3__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_3__subsec_1__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_3__subsec_1__para_h"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatan seseorang anggota Majlis hendaklah dikosongkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_3__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_3__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia meninggal dunia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_3__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_3__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_3__subsec_1__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_3__subsec_1__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_3__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika telah dibuktikan terhadapnya, atau dia telah disabitkan atas, suatu pertuduhan berkenaan dengan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_3__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_3__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu kesalahan yang melibatkan fraud, kecurangan atau keburukan akhlak;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_3__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_3__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu kesalahan di bawah mana-mana undang-undang yang berhubungan dengan rasuah; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_3__subsec_1__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_3__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa kesalahan lain yang boleh dihukum dengan pemenjaraan, sama ada hukuman penjara sahaja atau sebagai tambahan kepada atau sebagai ganti denda, lebih daripada dua tahun;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_3__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_3__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia tidak sempurna akal atau selainnya tidak berupaya menunaikan kewajipannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_3__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_3__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia menjadi bankrap;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_3__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_3__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia tidak menghadiri mesyuarat Majlis tiga kali berturut-turut tanpa kebenaran Pengerusi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_3__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_3__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia meletak jawatan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_3__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_3__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika pelantikannya dibatalkan oleh Menteri; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_3__subsec_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_3__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia terhenti menjadi seorang pengamal berdaftar atau dia digantung sebagai seorang pengamal berdaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila jawatan seseorang anggota Majlis daripada sektor swasta atau institusi pengajian tinggi menjadi kosong sebelum tamat tempoh jawatannya, seseorang daripada profesion yang sama hendaklah dilantik oleh Menteri bagi mengisi kekosongan untuk mewakili profesion berkenaan dan hendaklah memegang jawatan bagi baki tempoh jawatan orang yang jawatannya telah menjadi kosong."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_3__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa tempoh pelantikan yang dibuat di bawah perenggan 1 Jadual ini tidak boleh diambil kira dalam pengiraan tempoh pelantikan seseorang anggota yang disebut dalam subperenggan (2). Pembatalan pelantikan dan peletakan jawatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_4",
      "@type": "akn:paragraph",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_4__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, pada bila-bila masa, membatalkan pelantikan seseorang anggota Majlis daripada sektor swasta atau institusi pengajian tinggi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Anggota yang disebut dalam subperenggan (1) boleh, pada bila-bila masa, meletak jawatan dengan memberikan sekurang-kurangnya tiga puluh hari notis bertulis kepada Menteri. Pengerusi"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_5",
      "@type": "akn:paragraph",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_5__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_5__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_5__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi hendaklah mempengerusikan semua mesyuarat Majlis."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Pada masa ketiadaan Pengerusi pada mana-mana mesyuarat Majlis atas apa-apa sebab, Timbalan Pengerusi hendaklah mempengerusikan mesyuarat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_5__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Pada masa ketiadaan Pengerusi dan Timbalan Pengerusi pada mana-mana mesyuarat Majlis atas apa-apa sebab, mana-mana anggota Majlis yang dilantik oleh Pengerusi hendaklah mempengerusikan mesyuarat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_5__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Timbalan Pengerusi atau anggota yang dilantik di bawah subperenggan (2) atau (3), mengikut mana-mana yang berkenaan, hendaklah sepanjang tempoh masa dia menjalankan fungsi Pengerusi di bawah perenggan ini disifatkan sebagai Pengerusi. Majlis dan jawatankuasa boleh mengundang orang lain ke mesyuarat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_6",
      "@type": "akn:paragraph",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis dan jawatankuasa boleh mengundang mana-mana orang untuk menghadiri mana-mana mesyuarat atau pertimbangtelitian Majlis atau jawatankuasa bagi maksud menasihati Majlis atau jawatankuasa atas apa-apa perkara yang sedang dibincangkan, tetapi orang itu tidak berhak untuk mengundi pada mesyuarat atau pertimbangtelitian itu. Kekerapan dan tempat mesyuarat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_7",
      "@type": "akn:paragraph",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_7__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_7__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis dan jawatankuasa hendaklah mengadakan seberapa banyak mesyuarat yang perlu bagi melaksanakan fungsinya dengan cekap dan mesyuarat itu hendaklah diadakan di tempat dan pada masa yang dinyatakan dalam notis bertulis yang dikeluarkan oleh Pengerusi jika berkenaan dengan Majlis atau pengerusi jawatankuasa jika berkenaan dengan jawatankuasa, dengan syarat mesyuarat diadakan sekurang-kurangnya dua kali setahun."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Anggota Majlis boleh memohon untuk mengadakan mesyuarat Majlis dengan mengemukakan notis permohonan kepada Setiausaha menurut subperenggan (3)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_7__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Notis permohonan di bawah subperenggan (2) hendaklah mengandungi tandatangan sekurang-kurangnya tiga anggota Majlis dan hendaklah menyatakan perkara yang hendak dibincangkan dan diputuskan oleh Majlis. Korum"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_8",
      "@type": "akn:paragraph",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_8__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Korum mesyuarat Majlis hendaklah lapan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Korum mesyuarat jawatankuasa hendaklah tidak kurang daripada separuh anggota jawatankuasa. Undi pemutus"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_9",
      "@type": "akn:paragraph",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_9__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Keputusan Majlis hendaklah dibuat melalui majoriti biasa anggota yang hadir dan mengundi, dan dalam hal keadaan bilangan undi yang sama banyak, Pengerusi hendaklah mempunyai undi pemutus sebagai tambahan kepada undi biasanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~sched_1__para_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengundian bagi mana-mana pertimbangtelitian atau keputusan berkaitan Profesion Kesihatan Bersekutu yang tertentu tidak boleh dilakukan tanpa kehadiran anggota Majlis masing-masing yang mewakili Profesion Kesihatan Bersekutu itu. Minit"
      }
    },
