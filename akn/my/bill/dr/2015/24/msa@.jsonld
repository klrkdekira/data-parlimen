        "@language": "ms",
        "@value": "didenda tidak melebihi lima puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi dua tahun atau kedua-duanya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_VI__cl_36__subsec_1__para_a__subpara_ii",
