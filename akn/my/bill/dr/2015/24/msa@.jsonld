      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melakukan suatu kesalahan di bawah Akta ini atau apa-apa peraturan-peraturan yang dibuat di bawah Akta ini yang baginya tiada penalti diperuntukkan dengan nyata boleh, apabila disabitkan—"
      }
    },
