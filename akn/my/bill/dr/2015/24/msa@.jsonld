        "@language": "ms",
        "@value": "KESALAHAN-KESALAHAN Pengiklanan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_VII",
