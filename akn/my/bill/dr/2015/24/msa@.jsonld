      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal seseorang individu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_VI__cl_37__subsec_1__para_a__subpara_i",
