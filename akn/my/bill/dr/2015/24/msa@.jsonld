      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu kesalahan di bawah subseksyen (1) dilakukan oleh suatu pertubuhan perbadanan, perkongsian atau suatu pertubuhan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_VI__cl_36__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_VI__cl_36__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal suatu pertubuhan perbadanan, orang yang bertanggungjawab terhadap pertubuhan perbadanan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/24/msa@/~part_VI__cl_36__subsec_2__para_b",
      "@type": "akn:paragraph",
