      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/32/msa@/~part_II__chp_IV__cl_42__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/32/msa@/~part_II__chp_IV__cl_42__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/32/msa@/~part_II__chp_IV__cl_42__para_a__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/32/msa@/~part_II__chp_IV__cl_42",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subperenggan 6(1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/32/msa@/~part_II__chp_IV__cl_42__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/32/msa@/~part_II__chp_IV__cl_42__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan “dan” di hujung subsubperenggan (c);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/32/msa@/~part_II__chp_IV__cl_42__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/32/msa@/~part_II__chp_IV__cl_42__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan noktah di hujung subsubperenggan (d) dengan perkataan “; dan”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/32/msa@/~part_II__chp_IV__cl_42__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/32/msa@/~part_II__chp_IV__cl_42__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subsubperenggan (d) subsubperenggan yang berikut: “(e) apa-apa amaun yang dibayar atau yang akan dibayar berkenaan dengan cukai barang dan perkhidmatan oleh pelupus jika dia tidak bertanggungan untuk berdaftar di bawah Akta Cukai Barang dan Perkhidmatan 2014 atau jika dia adalah orang berdaftar dan tidak layak di bawah Akta itu untuk mengkredit amaun itu sebagai cukai input.”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/32/msa@/~part_II__chp_IV__cl_42__para_b",
