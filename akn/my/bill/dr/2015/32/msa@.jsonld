      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 47 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/32/msa@/~part_I__cl_13__para_a",
