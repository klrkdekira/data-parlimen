      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/32/msa@/~part_II__chp_IV",
      "schema:name": {
        "@language": "ms",
        "@value": "Jadual 2 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/32/msa@/~part_II__chp_IV__cl_42__para_a",
