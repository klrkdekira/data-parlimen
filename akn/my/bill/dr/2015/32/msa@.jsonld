      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 22a Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/32/msa@/~part_II__chp_V__cl_46__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
