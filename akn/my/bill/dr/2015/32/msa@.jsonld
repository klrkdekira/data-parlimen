      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/32/msa@/~part_II__chp_VI",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 43 Akta ibu dipinda —"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/32/msa@/~part_II__chp_VI__cl_50__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
