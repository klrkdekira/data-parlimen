      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Kewangan 2015. Pindaan Akta"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/32/msa@/~chp_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/32/msa@/~chp_I",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Cukai Pendapatan 1967 [Akta 53], Akta Petroleum (Cukai Pendapatan) 1967 [Akta 543], Akta Cukai Keuntungan Harta Tanah 1976 [Akta 169], Akta Cukai Aktiviti Perniagaan Labuan 1990 [Akta 445], Akta Cukai Barang dan Perkhidmatan 2014 [Akta 762] dan Akta Penggalakan Pelaburan 1986 [Akta 327] dipinda mengikut cara yang dinyatakan masing-masing dalam Bab II, III, IV, V, VI dan VII."
      }
    },
