      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 83 Akta ibu dipinda dengan memasukkan selepas subseksyen (1a) subseksyen yang berikut: “(1B) Where the employer is a company, the return referred to in subsection (1) shall be furnished on an electronic medium or by way of electronic transmission in accordance with section 152a.”. Pindaan seksyen 91"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/32/msa@/~part_I__cl_17",
      "@type": "akn:clause",
