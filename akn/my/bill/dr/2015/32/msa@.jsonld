      "schema:text": {
        "@language": "ms",
        "@value": "dalam subperenggan 1(a), dengan menggantikan perkataan “three” dengan perkataan “four”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/32/msa@/~part_I__cl_13__para_b",
