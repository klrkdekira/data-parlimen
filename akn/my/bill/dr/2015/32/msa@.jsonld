        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/32/msa@/~part_II__chp_IV__cl_42__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/32/msa@/~part_II__chp_IV__cl_42",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan 7—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/32/msa@/~part_II__chp_IV__cl_42__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/32/msa@/~part_II__chp_IV__cl_42__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan “dan” di hujung subperenggan (b);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/32/msa@/~part_II__chp_IV__cl_42__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/32/msa@/~part_II__chp_IV__cl_42__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan noktah di hujung subperenggan (c) dengan koma bernoktah; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/32/msa@/~part_II__chp_IV__cl_42__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/32/msa@/~part_II__chp_IV__cl_42__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subperenggan (c) subperenggan yang berikut: “(d) apa-apa amaun yang dibayar atau yang akan dibayar berkenaan dengan cukai barang dan perkhidmatan sebagai cukai input oleh pelupus jika dia bertanggungan untuk berdaftar di bawah Akta Cukai Barang dan Perkhidmatan 2014 dan gagal untuk berbuat sedemikian, atau jika dia layak di bawah Akta itu untuk mengkredit amaun itu sebagai cukai input; dan (e) apa-apa amaun cukai output yang dibayar atau yang akan dibayar di bawah Akta Cukai Barang dan Perkhidmatan 2014 yang ditanggung oleh pelupus jika dia berdaftar atau bertanggungan untuk berdaftar di bawah Akta itu.”. Pindaan Jadual 4"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/32/msa@/~part_II__chp_IV__cl_43",
      "@type": "akn:clause",
      "eli:number": "43",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/32/msa@/~part_II__chp_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Jadual 4 kepada Akta ibu dipinda dalam perenggan 2 dengan menggantikan formula dengan formula yang berikut: “A X C B iaitu A ialah bahagian keluasan aset yang boleh dikenakan cukai yang dilupuskan; B ialah jumlah keluasan aset yang boleh dikenakan cukai; C ialah sepuluh ribu; atau sepuluh peratus keuntungan yang boleh dikenakan cukai, mengikut yang mana lebih tinggi”."
      }
    },
