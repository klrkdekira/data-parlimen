        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/32/msa@/~part_I__cl_12__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/32/msa@/~part_I",
      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 46(1) Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/32/msa@/~part_I__cl_12__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/32/msa@/~part_I__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (f), dengan menggantikan perkataan “five” dengan perkataan “seven”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/32/msa@/~part_I__cl_12__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/32/msa@/~part_I__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan “and” di hujung perenggan (l);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/32/msa@/~part_I__cl_12__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/32/msa@/~part_I__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan noktah di hujung perenggan (m) dengan koma bernoktah; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/32/msa@/~part_I__cl_12__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/32/msa@/~part_I__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan (m) perenggan yang berikut: “(n) an amount limited to a maximum of two hundred and fifty ringgit in respect of a contribution made or suffered in that basis year by that individual to the Social Security Organization pursuant to the Employees’ Social Security Act 1969; and (o) an amount of one thousand five hundred ringgit for each of the parent of that individual— (i) who is a resident and, at any time in that basis year, aged sixty years and above; and (ii) whose annual income does not exceed twenty-four thousand ringgit for that year of assessment: Provided that— (a) the deduction under this paragraph shall be allowed for a maximum of two parents; (b) the deduction under this paragraph shall not be allowed for an individual who has made a claim under paragraph 46(1)(c) for the same basis year; and (c) where two or more individuals are each entitled to claim a deduction for a year of assessment under this paragraph in respect of the same parent, there shall be allowed to each of those individuals, in place of the whole deduction which would otherwise be allowed under this paragraph, an amount of the whole deduction equally apportioned according to the number of the individuals making the claim.”. Pindaan seksyen 47"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/32/msa@/~part_I__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/32/msa@/~part_I__cl_13__para_a",
