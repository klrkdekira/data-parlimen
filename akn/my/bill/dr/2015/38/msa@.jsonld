      "schema:text": {
        "@language": "ms",
        "@value": "KECUALIAN Majlis Keselamatan Negara yang sedia ada"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/38/msa@/~part_VII__cl_43",
      "@type": "akn:clause",
      "eli:number": "43",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/38/msa@/~part_VII__cl_43__subsec_1",
