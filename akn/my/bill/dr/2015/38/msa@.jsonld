        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/38/msa@/~part_I__cl_2__list_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/38/msa@/~part_I__cl_2__list_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/38/msa@/~part_I__cl_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/38/msa@/~part_I__cl_2__list_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/38/msa@/~part_I__cl_2__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Polis Diraja Malaysia, Sukarelawan Simpanan Polis Diraja Malaysia dan Polis Bantuan yang disebut dalam Akta Polis 1967 [Akta 344];"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/38/msa@/~part_I__cl_2__list_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/38/msa@/~part_I__cl_2__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "angkatan tentera;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/38/msa@/~part_I__cl_2__list_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/38/msa@/~part_I__cl_2__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana angkatan yang merupakan angkatan pelawat bagi maksud Bahagian I Akta Angkatan Pelawat 1960 [Akta 432]; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/38/msa@/~part_I__cl_2__list_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/38/msa@/~part_I__cl_2__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Agensi Penguatkuasaan Maritim Malaysia yang ditubuhkan di bawah Akta Agensi Penguatkuasaan Maritim Malaysia 2004 [Akta 633]; “Pengarah Operasi” ertinya mana-mana orang yang dilantik oleh Majlis di bawah seksyen 20; “Pengerusi” ertinya Pengerusi Majlis yang disebut dalam seksyen 6; “perisytiharan” ertinya perisytiharan kawasan keselamatan yang dibuat di bawah seksyen 18."
      }
    },
