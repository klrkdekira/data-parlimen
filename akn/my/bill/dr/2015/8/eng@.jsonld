      "schema:text": {
        "@language": "en",
        "@value": "in subsection (3), by deleting the words “; and if no such application is received within three months from the date of the release or removal the Registrar shall destroy the sheet and every such negative and photograph”. Amendment of section 23"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2015/8/eng@/~cl_15",
