        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/10/eng@/~cl_8__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/10/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 35a of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/10/eng@/~cl_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
