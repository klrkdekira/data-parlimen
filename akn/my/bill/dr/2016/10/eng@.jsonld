      "schema:text": {
        "@language": "en",
        "@value": "in subsection (1), by substituting for the word “shall” the word “may”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/10/eng@/~cl_8__para_b",
      "@type": "akn:paragraph",
