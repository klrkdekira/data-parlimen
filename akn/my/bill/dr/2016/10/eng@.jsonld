      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/10/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 3a of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/10/eng@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/10/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the shoulder note the following shoulder note: “Authorization to Mayor, President of a Municipal Council, Chairman of a Municipal Council, officers of City Council or Municipal Council, etc.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/10/eng@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/10/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (3) the following subsections: “(3a) The Minister may, by order published in the Gazette, upon application being made by the President of a Municipal Council or the Chairman of a Municipal Council, authorize the President of the Municipal Council, the Chairman of the Municipal Council and the officers or persons in the service of the Municipal Council to exercise the powers conferred and to perform the duties imposed by this Act on the President of the Municipal Council, the Chairman of the Municipal Council or traffic warden, as the case may be. (3b) An order made under subsection (3a) may limit the powers to be conferred on and the duties to be performed by the President of a Municipal Council, the Chairman of a Municipal Council and the officers or persons in the service of the Municipal Council. (3 c) Upon authorization being made under subsection (3a), the President of a Municipal Council, the Chairman of a Municipal Council and the officers or persons in the service of the Municipal Council may exercise the powers conferred and perform the duties imposed by this Act on the President of a Municipal Council, the Chairman of a Municipal Council or traffic warden, as the case may be.”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/10/eng@/~cl_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/10/eng@/~cl_4__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/10/eng@/~cl_4__para_c__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/10/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (4)— ‘ “Municipal Council” means a Municipal Council for a local authority area that has been declared and determined in accordance with paragraph 3(d) of the Local Government Act 1976, paragraph 6(1)(cc) of the Local Government Ordinance 1961 and paragraph 3(1)(e) of the Local Authorities Ordinance 1996.’. Substitution of section 4"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/10/eng@/~cl_4__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/10/eng@/~cl_4__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the full stop a semicolon; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/10/eng@/~cl_4__para_c__subpara_ii",
