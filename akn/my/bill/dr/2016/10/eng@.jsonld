        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/10/eng@/~cl_2__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/10/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "in the definition of “traffic warden”—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/10/eng@/~cl_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
