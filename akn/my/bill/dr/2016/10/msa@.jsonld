      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/10/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 17(1) Akta ibu dipinda dengan menomborkan semula perenggan (bb) dan (bc) masing-masing sebagai perenggan (ba) dan (bb). Pindaan seksyen 35"
      }
    },
