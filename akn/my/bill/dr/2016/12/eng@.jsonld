      ],
      "schema:name": {
        "@language": "en",
        "@value": "Asian Infrastructure Investment Bank Bill 2016"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Asian Infrastructure Investment Bank Act 2016."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on the date the Agreement comes into operation for the Government of Malaysia pursuant to Article 58 of the Agreement. Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "In this Act, unless the context otherwise requires—"
      },
      "schema:text": {
        "@language": "en",
        "@value": "“member” means a member of the Bank; “Bank” means the Asian Infrastructure Investment Bank established under the Agreement; “Government” means the Government of Malaysia; “Minister” means the Minister charged with the responsibility for finance; “Agreement” means the Asian Infrastructure Investment Bank Articles of Agreement for the establishment and operation of the Asian Infrastructure Investment Bank signed by the Government in Beijing, China on 21 August 2015, as amended from time to time. Certain provisions of Agreement to have force of law"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_3__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_3__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding anything to the contrary in any other law, the provisions of the Agreement set out in the Schedule shall have the force of law in Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_3__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_3__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_3__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "Nothing in Article 51 of the Agreement shall be construed as—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_3__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_3__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "entitling the Bank to import into Malaysia goods free of any customs duty without any restriction on their subsequent sale in Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_3__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_3__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "conferring on the Bank any exemption from taxes or duties which form part of the price of goods sold or services supplied; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_3__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_3__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "conferring on the Bank any exemption from taxes or duties which are no more than charges for services rendered."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_3__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, by order published in the Gazette, amend the Schedule in conformity with any amendments to the provisions of the Agreement set out in the Schedule which may subsequently be made and adopted. Waiver"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Bank may waive any of the privileges, immunities and exemptions conferred under Chapter IX of the Agreement in any case or instance, in such manner and upon such conditions as it may determine to be appropriate in the best interests of the Bank. Power to subscribe to shares of the capital stock of the Bank"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_5__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_5__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The Minister is authorized to subscribe on behalf of the Government—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "to shares of the original authorized capital stock of the Bank in accordance with paragraph 1 of Article 5 of the Agreement to an amount not exceeding one hundred and nine million and five hundred thousand United States dollars;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "where the shares of the Government have been increased at the request of the Government under paragraph 3 of Article 5 of the Agreement, to the amount of such increase; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "where the original authorized capital stock of the Bank is increased under paragraph 4 of Article 5 of the Agreement, to a proportion of the increase of stock as provided in that paragraph. Sums payable to the Bank to be charged on the Consolidated Fund"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_6__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_6__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_6__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_6__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_6__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "There shall be charged on the Consolidated Fund—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_6__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_6__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "all sums payable to the Bank by way of subscription to its capital stock under and in accordance with the method of payment thereof as provided in Article 6 of the Agreement;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_6__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_6__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "all sums payable to the Bank by way of subscription to its callable capital stock as and when required by the Bank, under paragraph 3 of Article 6 of the Agreement;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_6__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_6__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "all sums payable to the Bank by way of increased subscription by the Government to the Bank’s capital stock in accordance with paragraphs 3 and 4 of Article 5 of the Agreement; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_6__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_6__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "all sums payable to the Bank under any other provisions of the Agreement."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "All the sums charged on the Consolidated Fund under this section shall be paid in United States dollars. Issue of promissory notes and other obligations"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_7__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may issue to the Bank in such form as he thinks fit any promissory notes or other obligations, in lieu of the amount to be paid in the Malaysian currency, provided that such amount is not required by the Bank for the conduct of its operations."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "Such notes or obligations issued shall be non-negotiable, non-interest bearing and payable to the Bank at par value upon demand. Receipt"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "All sums received by or on behalf of the Government from the Bank shall be paid into the Consolidated Fund. Power to make regulations"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may make regulations for the purpose of carrying out the provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "[Section 3] PROVISIONS OF THE AGREEMENT HAVING THE FORCE OF LAW IN MALAYSIA"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX",
      "@type": "akn:chapter",
      "eli:number": "IX",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_44",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_45",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_46",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_47",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_48",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_49",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_50",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_51"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1",
      "schema:text": {
        "@language": "en",
        "@value": "STATUS, IMMUNITIES, PRIVILEGES AND EXEMPTIONS"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_44",
      "@type": "akn:article",
      "eli:number": "44",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_44__para_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_44__para_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX",
      "schema:name": {
        "@language": "en",
        "@value": "Purposes of Chapter"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_44__para_1",
      "@type": "akn:paragraph",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_44",
      "schema:text": {
        "@language": "en",
        "@value": "To enable the Bank to fulfill its purpose and carry out the functions entrusted to it, the status, immunities, privileges and exemptions set forth in this Chapter shall be accorded to the Bank in the territory of each member."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_44__para_2",
      "@type": "akn:paragraph",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_44",
      "schema:text": {
        "@language": "en",
        "@value": "Each member shall promptly take such action as is necessary to make effective in its own territory the provisions set forth in this Chapter and shall inform the Bank of the action which it has taken."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_45",
      "@type": "akn:article",
      "eli:number": "45",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX",
      "schema:name": {
        "@language": "en",
        "@value": "Status of the Bank"
      },
      "schema:text": {
        "@language": "en",
        "@value": "The Bank shall possess full juridical personality and, in particular, the full legal capacity: (i) to contract; (ii) to acquire, and dispose of, immovable and movable property; (iii) to institute and respond to legal proceedings; and (iv) to take such other action as may be necessary or useful for its purpose and activities."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_46",
      "@type": "akn:article",
      "eli:number": "46",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_46__para_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_46__para_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_46__para_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX",
      "schema:text": {
        "@language": "en",
        "@value": "Immunity from Judicial Proceedings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_46__para_1",
      "@type": "akn:paragraph",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_46",
      "schema:text": {
        "@language": "en",
        "@value": "The Bank shall enjoy immunity from every form of legal process, except in cases arising out of or in connection with the exercise of its powers to raise funds, through borrowings or other means, to guarantee obligations, or to buy and sell or underwrite the sale of securities, in which cases actions may be brought against the Bank only in a court of competent jurisdiction in the territory of a country in which the Bank has an office, or has appointed an agent for the purpose of accepting service or notice of process, or has issued or guaranteed securities."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_46__para_2",
      "@type": "akn:paragraph",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_46",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding the provisions of paragraph 1 of this Article, no action shall be brought against the Bank by any member, or by any agency or instrumentality of a member, or by any entity or person directly or indirectly acting for or deriving claims from a member or from any agency or instrumentality of a member. Members shall have recourse to such special procedures for the settlement of controversies between the Bank and its members as may be prescribed in this Agreement, in the by-laws and regulations of the Bank, or in the contracts entered into with the Bank."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_46__para_3",
      "@type": "akn:paragraph",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_46",
      "schema:text": {
        "@language": "en",
        "@value": "Property and assets of the Bank shall, wheresoever located and by whomsoever held, be immune from all forms of seizure, attachment or execution before the delivery of final judgment against the Bank."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_47",
      "@type": "akn:article",
      "eli:number": "47",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_47__para_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_47__para_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX",
      "schema:text": {
        "@language": "en",
        "@value": "Immunity of Assets and Archives"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_47__para_1",
      "@type": "akn:paragraph",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_47",
      "schema:text": {
        "@language": "en",
        "@value": "Property and assets of the Bank, wheresoever located and by whomsoever held, shall be immune from search, requisition, confiscation, expropriation or any other form of taking or foreclosure by executive or legislative action."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_47__para_2",
      "@type": "akn:paragraph",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_47",
      "schema:text": {
        "@language": "en",
        "@value": "The archives of the Bank, and, in general, all documents belonging to it, or held by it, shall be inviolable, wheresoever located and by whomsoever held."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_48",
      "@type": "akn:article",
      "eli:number": "48",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX",
      "schema:name": {
        "@language": "en",
        "@value": "Freedom of Assets from Restrictions"
      },
      "schema:text": {
        "@language": "en",
        "@value": "To the extent necessary to carry out the purpose and functions of the Bank effectively, and subject to the provisions of this Agreement, all property and assets of the Bank shall be free from restrictions, regulations, controls and moratoria of any nature."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_49",
      "@type": "akn:article",
      "eli:number": "49",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX",
      "schema:name": {
        "@language": "en",
        "@value": "Privilege for Communications"
      },
      "schema:text": {
        "@language": "en",
        "@value": "Official communications of the Bank shall be accorded by each member the same treatment that it accords to the official communications of any other member."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_50",
      "@type": "akn:article",
      "eli:number": "50",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX",
      "schema:text": {
        "@language": "en",
        "@value": "Immunities and Privileges of Officers and Employees All Governors, Directors, Alternates, the President, Vice-Presidents and other officers and employees of the Bank, including experts and consultants performing missions or services for the Bank: (i) shall be immune from legal process with respect to acts performed by them in their official capacity, except when the Bank waives the immunity and shall enjoy inviolability of all their official papers, documents and records; (ii) where they are not local citizens or nationals, shall be accorded the same immunities from immigration restrictions, alien registration requirements and national service obligations, and the same facilities as regards exchange regulations, as are accorded by members to the representatives, officials and employees of comparable rank of other members; and (iii) shall be granted the same treatment in respect of travelling facilities as is accorded by members to representatives, officials and employees of comparable rank of other members."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_51",
      "@type": "akn:article",
      "eli:number": "51",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_51__para_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_51__para_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_51__para_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_51__para_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX",
      "schema:name": {
        "@language": "en",
        "@value": "Exemption from Taxation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_51__para_1",
      "@type": "akn:paragraph",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_51",
      "schema:text": {
        "@language": "en",
        "@value": "The Bank, its assets, property, income and its operations and transactions pursuant to this Agreement, shall be exempt from all taxation and from all customs duties. The Bank shall also be exempt from any obligation for the payment, withholding or collection of any tax or duty."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_51__para_2",
      "@type": "akn:paragraph",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_51",
      "schema:text": {
        "@language": "en",
        "@value": "No tax of any kind shall be levied on or in respect of salaries, emoluments and expenses, as the case may be, paid by the Bank to Directors, Alternate Directors, the President, Vice-Presidents and other officers or employees of the Bank, including experts and consultants performing missions or services for the Bank, except where a member deposits with its instrument of ratification, acceptance, or approval a declaration that such member retains for itself and its political subdivisions the right to tax salaries, and emoluments, as the case may be, paid by the Bank to citizens or nationals of such member."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_51__para_3",
      "@type": "akn:paragraph",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_51__para_3__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_51__para_3__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_51",
      "schema:text": {
        "@language": "en",
        "@value": "No tax of any kind shall be levied on any obligation or security issued by the Bank, including any dividend or interest thereon, by whomsoever held:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_51__para_3__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_51__para_3",
      "schema:text": {
        "@language": "en",
        "@value": "which discriminates against such obligation or security solely because it is issued by the Bank; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_51__para_3__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_51__para_3",
      "schema:text": {
        "@language": "en",
        "@value": "if the sole jurisdictional basis for such taxation is the place or currency in which it is issued, made payable or paid, or the location of any office or place of business maintained by the Bank."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_51__para_4",
      "@type": "akn:paragraph",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_51__para_4__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_51__para_4__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_51",
      "schema:text": {
        "@language": "en",
        "@value": "No tax of any kind shall be levied on any obligation or security guaranteed by the Bank, including any dividend or interest thereon, by whomsoever held:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_51__para_4__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_51__para_4",
      "schema:text": {
        "@language": "en",
        "@value": "which discriminates against such obligation or security solely because it is guaranteed by the Bank; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_51__para_4__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/eng@/~sched_1__chp_IX__art_51__para_4",
      "schema:text": {
        "@language": "en",
        "@value": "if the sole jurisdictional basis for such taxation is the location of any office or place of business maintained by the Bank."
      }
    }
  ]
}
