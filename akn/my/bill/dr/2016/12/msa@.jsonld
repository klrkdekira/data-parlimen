        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1"
      ],
      "schema:name": {
        "@language": "ms",
        "@value": "RUU Bank Pelaburan Infrastruktur Asia 2016"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~art_5",
      "@type": "akn:article",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~art_5__cl_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~art_5__cl_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~art_5__cl_9"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Perjanjian; dan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "(d) semua jumlah wang yang kena dibayar kepada Bank di bawah mana-mana peruntukan lain Perjanjian. (2) Semua jumlah wang yang dipertanggungkan pada Kumpulan Wang Disatukan di bawah seksyen ini hendaklah dibayar dalam dolar Amerika Syarikat. Pengeluaran nota janji hutang dan tanggungan lain"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~art_5__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~art_5__cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~art_5__cl_7__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~art_5"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~art_5__cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~art_5__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh mengeluarkan kepada Bank dalam apa-apa bentuk yang difikirkannya patut apa-apa nota janji hutang atau tanggungan lain, sebagai ganti kepada amaun yang kena dibayar dalam mata wang Malaysia, dengan syarat bahawa amaun itu tidak dikehendaki oleh Bank bagi penjalanan pengendaliannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~art_5__cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~art_5__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa nota atau tanggungan yang dikeluarkan itu hendaklah tidak boleh niaga, tanpa faedah dan kena dibayar kepada Bank pada nilai setara apabila diminta. Penerimaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~art_5__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~art_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua jumlah wang yang diterima oleh atau bagi pihak Kerajaan daripada Bank hendaklah dibayar ke dalam Kumpulan Wang Disatukan. Kuasa untuk membuat peraturan-peraturan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~art_5__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~art_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh membuat peraturan-peraturan bagi maksud melaksanakan peruntukan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Bank Pelaburan Infrastruktur Asia 2016."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh Perjanjian mula berkuat kuasa bagi Kerajaan Malaysia menurut Perkara 58 Perjanjian. Tafsiran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Dalam Akta ini, melainkan jika konteksnya menghendaki makna yang lain—"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "“anggota” ertinya anggota Bank; “Bank” ertinya Bank Pelaburan Infrastruktur Asia yang ditubuhkan di bawah Perjanjian; “Kerajaan” ertinya Kerajaan Malaysia; “Menteri” ertinya Menteri yang dipertanggungkan dengan tanggungjawab bagi kewangan; “Perjanjian” ertinya Perkara Perjanjian Bank Pelaburan Infrastruktur Asia bagi penubuhan dan pengendalian Bank Pelaburan Infrastruktur Asia yang ditandatangani oleh Kerajaan di Beijing, China pada 21 Ogos 2015, sebagaimana yang dipinda dari semasa ke semasa. Peruntukan tertentu Perjanjian hendaklah mempunyai kuat kuasa undang-undang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~cl_3__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~cl_3__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun yang berlawanan dalam mana-mana undang-undang lain, peruntukan Perjanjian yang dinyatakan dalam Jadual hendaklah mempunyai kuat kuasa undang-undang dalam Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~cl_3__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~cl_3__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~cl_3__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada apa-apa jua dalam Perkara 51 Perjanjian boleh ditafsirkan sebagai—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~cl_3__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~cl_3__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "memberi hak kepada Bank untuk mengimport ke dalam Malaysia barang yang bebas daripada duti kastam tanpa apa-apa sekatan ke atas penjualan berikutnya barang itu dalam Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~cl_3__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~cl_3__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "memberi kepada Bank apa-apa pengecualian daripada cukai atau duti yang menjadi sebahagian daripada harga barang yang dijual atau perkhidmatan yang dibekalkan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~cl_3__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~cl_3__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "memberi kepada Bank apa-apa pengecualian daripada cukai atau duti yang merupakan caj bagi perkhidmatan yang telah diberikan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~cl_3__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, melalui perintah yang disiarkan dalam Warta, meminda Jadual selaras dengan apa-apa pindaan kepada peruntukan Perjanjian yang dinyatakan dalam Jadual yang kemudiannya dibuat dan diterima pakai. Penepian"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Bank boleh mengetepikan apa-apa keistimewaan, kekebalan dan pengecualian yang diberikan di bawah Bab IX Perjanjian dalam mana-mana hal atau keadaan, mengikut cara dan atas syarat sebagaimana yang ditentukannya sesuai demi kepentingan Bank. Kuasa untuk memohon beli syer saham modal Bank"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~cl_5__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~cl_5__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Menteri diberi kuasa untuk memohon beli bagi pihak Kerajaan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "syer saham modal dibenarkan Bank yang asal mengikut perenggan 1 Perkara 5 Perjanjian bagi suatu amaun yang tidak melebihi seratus sembilan juta dan lima ratus ribu dolar Amerika Syarikat;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "jika syer Kerajaan telah ditambah atas permintaan Kerajaan di bawah perenggan 3 Perkara 5 Perjanjian, sebanyak amaun pertambahan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~cl_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "jika saham modal dibenarkan Bank yang asal ditambah di bawah perenggan 4 Perkara 5 Perjanjian, sebanyak suatu kadar daripada pertambahan saham sebagaimana yang diperuntukkan dalam perenggan itu. Jumlah wang yang kena dibayar kepada Bank hendaklah dipertanggungkan pada Kumpulan Wang Disatukan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~cl_6__subsec_1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~cl_6__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~cl_6__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~cl_6__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Maka hendaklah dipertanggungkan pada Kumpulan Wang Disatukan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~cl_6__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~cl_6__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "semua jumlah wang yang kena dibayar kepada Bank dengan cara permohonan beli saham modalnya di bawah dan mengikut cara pembayarannya sebagaimana yang diperuntukkan dalam Perkara 6 Perjanjian;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~cl_6__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~cl_6__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "semua jumlah wang yang kena dibayar kepada Bank dengan cara permohonan beli saham modal boleh panggilnya apabila dikehendaki oleh Bank, di bawah perenggan 3 Perkara 6 Perjanjian;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~cl_6__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~cl_6__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "semua jumlah wang yang kena dibayar kepada Bank dengan cara permohonan beli tambahan oleh Kerajaan bagi saham modal Bank mengikut perenggan 3 dan 4"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "[Seksyen 3] PERUNTUKAN PERJANJIAN YANG MEMPUNYAI KUAT KUASA UNDANG-UNDANG DI MALAYSIA"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX",
      "@type": "akn:chapter",
      "eli:number": "IX",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_44",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_45",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_46",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_47",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_48",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_49",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_50",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_51"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1",
      "schema:text": {
        "@language": "ms",
        "@value": "STATUS, KEKEBALAN, KEISTIMEWAAN DAN PENGECUALIAN"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_44",
      "@type": "akn:article",
      "eli:number": "44",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_44__para_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_44__para_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX",
      "schema:name": {
        "@language": "ms",
        "@value": "Maksud Bab"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_44__para_1",
      "@type": "akn:paragraph",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_44",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi membolehkan Bank memenuhi maksudnya dan menunaikan fungsi yang diamanahkan kepadanya, status, kekebalan, keistimewaan dan pengecualian yang dinyatakan dalam Bab ini hendaklah diberikan kepada Bank dalam wilayah setiap anggota."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_44__para_2",
      "@type": "akn:paragraph",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_44",
      "schema:text": {
        "@language": "ms",
        "@value": "Setiap anggota hendaklah dengan segera mengambil apa-apa tindakan yang perlu untuk menguatkuasakan dalam wilayah masing-masing peruntukan yang dinyatakan dalam Bab ini dan hendaklah memberitahu Bank tentang tindakan yang telah diambil."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_45",
      "@type": "akn:article",
      "eli:number": "45",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX",
      "schema:name": {
        "@language": "ms",
        "@value": "Status Bank"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Bank hendaklah mempunyai keperibadian juridikal penuh dan, secara khususnya, keupayaan undang-undang: (i) untuk membuat kontrak; (ii) untuk memperoleh, dan melupuskan, harta tak alih dan harta alih; (iii) untuk memulakan dan bertindak balas terhadap prosiding undang-undang; dan (iv) untuk mengambil apa-apa tindakan lain sebagaimana yang perlu atau berguna bagi maksud dan aktivitinya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_46",
      "@type": "akn:article",
      "eli:number": "46",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_46__para_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_46__para_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_46__para_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX",
      "schema:name": {
        "@language": "ms",
        "@value": "Kekebalan daripada Prosiding Kehakiman"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_46__para_1",
      "@type": "akn:paragraph",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Bank hendaklah menikmati kekebalan daripada tiap-tiap bentuk proses undang-undang, kecuali dalam hal keadaan yang berbangkit daripada atau yang berkaitan dengan pelaksanaan kuasanya untuk mengumpul dana, melalui pinjaman atau cara lain, untuk menjamin obligasi, atau untuk membeli dan menjual atau menaja jamin penjualan sekuriti, yang dalam hal keadaan itu tindakan boleh dibawa terhadap Bank hanya di mahkamah yang mempunyai bidang kuasa kompeten dalam wilayah sesebuah negara yang Bank mempunyai pejabat, atau telah melantik seorang ejen bagi maksud menerima penyampaian atau notis proses, atau telah mengeluarkan atau menjamin sekuriti."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_46__para_2",
      "@type": "akn:paragraph",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun peruntukan perenggan 1 Perkara ini, tiada tindakan boleh diambil terhadap Bank oleh mana-mana anggota, atau mana-mana orang yang membantu atau menjadi perantara mana-mana anggota, atau oleh mana-mana entiti atau orang yang secara langsung atau tidak langsung bertindak bagi atau mendapat tuntutan daripada anggota atau mana-mana orang yang membantu atau menjadi perantara mana-mana anggota. Anggota boleh menggunakan tatacara khas bagi penyelesaian kontroversi antara Bank dengan anggotanya sebagaimana yang ditetapkan dalam Perjanjian ini, dalam undang-undang kecil dan peraturan-peraturan Bank, atau dalam kontrak yang dibuat dengan Bank."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_46__para_3",
      "@type": "akn:paragraph",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Harta dan aset Bank hendaklah, walau di mana pun terletak dan dipegang oleh sesiapa pun, kebal daripada semua bentuk penyitaan, penahanan atau pelaksanaan sebelum penyampaian penghakiman muktamad terhadap Bank."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_47",
      "@type": "akn:article",
      "eli:number": "47",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_47__para_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_47__para_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX",
      "schema:name": {
        "@language": "ms",
        "@value": "Kekebalan Aset dan Arkib"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_47__para_1",
      "@type": "akn:paragraph",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Harta dan aset Bank, walau di mana pun terletak dan dipegang oleh sesiapapun, hendaklah kebal daripada penggeledahan, rekuisisi, perampasan, ekspropriasi atau apa-apa bentuk pengambilan atau halang tebus lain melalui tindakan eksekutif atau perundangan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_47__para_2",
      "@type": "akn:paragraph",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Arkib Bank, dan secara umum, semua dokumen yang dimiliki olehnya, atau yang dipegang olehnya, tidak boleh dicabul, walau di mana pun terletak dan dipegang oleh sesiapa pun."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_48",
      "@type": "akn:article",
      "eli:number": "48",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX",
      "schema:name": {
        "@language": "ms",
        "@value": "Kebebasan Aset daripada Sekatan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Setakat yang perlu untuk melaksanakan maksud dan fungsi Bank dengan berkesan, dan tertakluk kepada peruntukan Perjanjian ini, semua harta dan aset Bank hendaklah bebas daripada sekatan, peraturan-peraturan, kawalan dan penangguhan dalam apa-apa jua bentuk."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_49",
      "@type": "akn:article",
      "eli:number": "49",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX",
      "schema:name": {
        "@language": "ms",
        "@value": "Keistimewaan untuk Komunikasi"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Komunikasi rasmi Bank hendaklah diberikan layanan yang sama oleh setiap anggota sebagaimana layanan yang diberikan olehnya kepada komunikasi rasmi mana-mana anggota lain."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_50",
      "@type": "akn:article",
      "eli:number": "50",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX",
      "schema:name": {
        "@language": "ms",
        "@value": "Kekebalan dan Keistimewaan Pegawai dan Pekerja"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Semua Gabenor, Pengarah, Pengganti, Presiden, Naib Presiden dan pegawai dan pekerja lain Bank, termasuk pakar dan perunding yang menjalankan misi atau perkhidmatan untuk Bank: (i) hendaklah kebal daripada proses undang-undang berkenaan dengan perbuatan yang dilaksanakan oleh mereka atas sifat rasmi, kecuali apabila Bank mengetepikan kekebalan dan hendaklah menikmati ketidakbolehcabulan bagi semua kertas, dokumen dan rekod rasmi mereka; (ii) jika mereka bukan rakyat atau warganegara tempatan, hendaklah diberikan kekebalan yang sama daripada sekatan imigresen, keperluan pendaftaran orang asing dan obligasi khidmat negara, dan kemudahan yang sama berkenaan dengan peraturan pertukaran, sebagaimana yang diberikan oleh anggota kepada wakil, pegawai dan pekerja yang berpangkat setanding bagi anggota lain; dan (iii) hendaklah diberikan layanan yang sama berkenaan dengan kemudahan perjalanan sebagaimana yang diberikan oleh anggota kepada wakil, pegawai dan pekerja yang berpangkat setanding bagi anggota lain."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_51",
      "@type": "akn:article",
      "eli:number": "51",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_51__para_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_51__para_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_51__para_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_51__para_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX",
      "schema:name": {
        "@language": "ms",
        "@value": "Pengecualian Cukai"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_51__para_1",
      "@type": "akn:paragraph",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_51",
      "schema:text": {
        "@language": "ms",
        "@value": "Bank, asetnya, hartanya, pendapatannya dan operasi dan urus niaganya menurut Perjanjian ini, hendaklah dikecualikan daripada semua cukai dan duti kastam. Bank juga hendaklah dikecualikan daripada apa-apa obligasi untuk pembayaran, pegangan atau pemungutan apa-apa cukai atau duti."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_51__para_2",
      "@type": "akn:paragraph",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_51",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada apa jua jenis cukai boleh dikenakan ke atas atau berkenaan dengan gaji, emolumen dan perbelanjaan, mengikut mana-mana yang berkenaan, yang dibayar oleh Bank kepada Pengarah, Pengarah Ganti, Presiden, Naib Presiden dan pegawai atau pekerja lain Bank, termasuk pakar dan perunding yang menjalankan misi atau perkhidmatan untuk Bank, kecuali jika anggota mendeposit dengan surat cara ratifikasinya, penerimaan, atau kelulusan suatu deklarasi bahawa anggota itu mengekalkan bagi dirinya dan subbahagian politiknya hak untuk mengenakan cukai ke atas gaji, dan emolumen, mengikut mana-mana yang berkenaan, yang dibayar oleh Bank kepada rakyat atau warganegara anggota itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_51__para_3",
      "@type": "akn:paragraph",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_51__para_3__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_51__para_3__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_51",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada apa jua jenis cukai boleh dikenakan ke atas apa-apa obligasi atau sekuriti yang dikeluarkan oleh Bank, termasuk apa-apa dividen atau faedah baginya, yang dipegang oleh sesiapa pun:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_51__para_3__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_51__para_3",
      "schema:text": {
        "@language": "ms",
        "@value": "yang mendiskriminasikan obligasi atau sekuriti itu semata-mata kerana ia dikeluarkan oleh Bank; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_51__para_3__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_51__para_3",
      "schema:text": {
        "@language": "ms",
        "@value": "sekiranya satu-satunya asas bidang kuasa untuk pengenaan cukai itu ialah tempat atau mata wang ia dikeluarkan, kena dibayar atau dibayar, atau lokasi mana-mana pejabat atau tempat perniagaan yang disenggarakan oleh Bank."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_51__para_4",
      "@type": "akn:paragraph",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_51__para_4__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_51__para_4__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_51",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada apa jua jenis cukai boleh dikenakan ke atas apa-apa obligasi atau sekuriti yang dijamin oleh Bank, termasuk apa-apa dividen atau faedah baginya, yang dipegang oleh sesiapa pun:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_51__para_4__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_51__para_4",
      "schema:text": {
        "@language": "ms",
        "@value": "yang mendiskriminasikan obligasi atau sekuriti itu semata-mata kerana ia dijamin oleh Bank; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_51__para_4__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/12/msa@/~sched_1__chp_IX__art_51__para_4",
      "schema:text": {
        "@language": "ms",
        "@value": "sekiranya satu-satunya asas bidang kuasa untuk pengenaan cukai itu ialah lokasi mana-mana pejabat atau tempat perniagaan yang disenggarakan oleh Bank."
      }
    }
  ]
}
