      ],
      "schema:name": {
        "@language": "en",
        "@value": "Courts (Modes of Commencement of Civil Actions) Bill 2016"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/13/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/13/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/13/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/13/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/13/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/13/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Courts (Modes of Commencement of Civil Actions) Act 2016."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/13/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/13/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/13/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/13/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "In this Act, unless the context otherwise requires—"
      },
      "schema:text": {
        "@language": "en",
        "@value": "“Court” means High Court, Sessions Court or Magistrate’s Court, whichever is applicable; “Commissioner of Law Revision” means the Commissioner of Law Revision appointed under section 3 of the Revision of Laws Act 1968 [Act 1]; “appointed date” means the date this Act comes into operation; “civil action” includes any civil application made to the Court provided under any written law. Treatment of pending civil actions"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/13/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/13/eng@/~cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/13/eng@/~cl_3__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/13/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/13/eng@/~cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/13/eng@/~cl_3__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/13/eng@/~cl_3__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/13/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "Unless otherwise provided in the applicable rules of Court, where under any written law—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/13/eng@/~cl_3__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/13/eng@/~cl_3__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any civil action may be commenced in or made to the Court; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/13/eng@/~cl_3__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/13/eng@/~cl_3__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "such an action is required to be commenced or made or was commenced or made otherwise than by way of an originating summons or writ, then, if any such action is pending before the Court before the appointed date the Court may, if the Court deems just and expedient, order that the action be deemed as having been commenced by way of an originating summons or writ, as may be appropriate."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/13/eng@/~cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/13/eng@/~cl_3__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/13/eng@/~cl_3__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/13/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "Where pursuant to subsection (1), any pending civil action has been deemed as having been commenced by way of an originating summons or writ—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/13/eng@/~cl_3__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/13/eng@/~cl_3__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the action shall be continued in accordance with the provisions of the relevant written law and the applicable rules of Court; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/13/eng@/~cl_3__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/13/eng@/~cl_3__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Court may give such directions as to the conduct of the action as the Court deems just and expedient in accordance with the applicable rules of Court. Standardisation of the modes of commencement of civil action"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/13/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/13/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding anything in any written law, any civil action commenced in or made to the Court under any written law after the appointed date, shall be commenced or made by way of an originating summons or writ as may be appropriate unless otherwise provided in the applicable rules of Court. Power to substitute reference to mode of commencement in written law"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/13/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/13/eng@/~cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/13/eng@/~cl_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/13/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding the powers conferred under the Revision of Laws Act 1968, the Commissioner of Law Revision shall have the power to substitute any reference to a specific mode of commencing a civil action or making an application in any written law, whether such written law is revised or not, with a mode provided under any applicable rules of Court by way of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/13/eng@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/13/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "revising any written law; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/13/eng@/~cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/13/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "reprinting any written law."
      }
    }
  ]
}
