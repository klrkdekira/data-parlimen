        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/15/eng@/~cl_20__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/15/eng@/~cl_20__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/15/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 26 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/15/eng@/~cl_20__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/15/eng@/~cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "in the shoulder note, by deleting the words “Superintendent-Registrar and”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/15/eng@/~cl_20__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
