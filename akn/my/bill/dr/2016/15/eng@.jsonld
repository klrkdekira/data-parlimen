      "schema:name": {
        "@language": "en",
        "@value": "Section 18 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/15/eng@/~cl_11__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
