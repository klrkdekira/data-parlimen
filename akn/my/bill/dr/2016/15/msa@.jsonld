    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/15/msa@/~cl_29__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/15/msa@/~cl_29",
