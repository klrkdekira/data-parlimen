      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/15/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan nota bahu dengan nota bahu yang berikut: “Inspection of registers, etc.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/15/msa@/~cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/15/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menomborkan semula seksyen yang sedia ada sebagai subseksyen (1); dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/15/msa@/~cl_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/15/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (1) yang dinomborkan semula subseksyen yang berikut: “(2) A public officer may, in the performance of his duties and with the authorization of the Registrar-General, inspect the registers and indices.”. Pindaan seksyen 7"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/15/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/15/msa@/~cl_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/15/msa@/~cl_6__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/15/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 7 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/15/msa@/~cl_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/15/msa@/~cl_6__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/15/msa@/~cl_6__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/15/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/15/msa@/~cl_6__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/15/msa@/~cl_6__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “for the registration area in which the child was born” dengan perkataan “in any registration area”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/15/msa@/~cl_6__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/15/msa@/~cl_6__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan “in duplicate in manner prescribed”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/15/msa@/~cl_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/15/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong subseksyen (3). Pindaan seksyen 8"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/15/msa@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/15/msa@/~cl_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/15/msa@/~cl_7__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/15/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 8 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/15/msa@/~cl_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/15/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam nota bahu, dengan menggantikan perkataan “fourteen” dengan perkataan “sixty”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/15/msa@/~cl_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/15/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “fourteen” dengan perkataan “sixty”. Seksyen baharu 10a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/15/msa@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/15/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memasukkan selepas seksyen 10 seksyen yang berikut: “Special provision as to registration of birth 10a. Notwithstanding the provisions of this Part, the Registrar-General may, if he is satisfied from evidence adduced before him that a birth had occurred, cause such birth to be registered by entering in a register such particulars concerning the birth.”. Pemotongan seksyen 11"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/15/msa@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/15/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memotong seksyen 11. Pindaan seksyen 12"
      }
    }
  ]
}
