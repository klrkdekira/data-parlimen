      "schema:text": {
        "@language": "en",
        "@value": "Section 5 and subparagraph 10(a)(i) are deemed to have effect from the year of assessment 2015."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/eng@/~chp_II__cl_3__subsec_3",
