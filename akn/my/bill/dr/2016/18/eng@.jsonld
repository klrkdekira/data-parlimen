      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/eng@/~chp_IV__cl_36__para_d",
      "schema:text": {
        "@language": "en",
        "@value": "in subsubparagraph (a), by substituting for the words “the disposal;” the words “the disposal if the donor is a citizen; and”;"
      }
    },
