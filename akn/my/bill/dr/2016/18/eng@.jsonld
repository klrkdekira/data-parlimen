      "schema:text": {
        "@language": "en",
        "@value": "Section 35 comes into operation on the coming into operation of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/eng@/~chp_IV__cl_34__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/eng@/~chp_IV__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraph 36(a) is deemed to have come into operation on 30 June 2013."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/eng@/~chp_IV__cl_34__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/eng@/~chp_IV__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraphs 36(b) and (c) are deemed to have effect from the year of assessment 2015."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/eng@/~chp_IV__cl_34__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/eng@/~chp_IV__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraph 36(d) comes into operation on 1 January 2017. Amendment of section 13"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/eng@/~chp_IV__cl_35",
      "@type": "akn:clause",
      "eli:number": "35",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/eng@/~chp_IV",
      "schema:text": {
        "@language": "en",
        "@value": "The Real Property Gains Tax Act 1976, which is referred to as the “principal Act” in this Chapter, is amended in the proviso to subsection 13(4) by deleting the words “in Kuala Lumpur”. Amendment of Schedule 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/eng@/~chp_IV__cl_36",
      "@type": "akn:clause",
