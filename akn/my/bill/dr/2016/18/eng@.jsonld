      "schema:text": {
        "@language": "en",
        "@value": "Sections 12, 13, 20 and 21, and paragraphs 27(b) and 29(e) are deemed to have come into operation on 30 June 2013."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/eng@/~chp_II__cl_3__subsec_4",
