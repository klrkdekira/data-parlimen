      "schema:name": {
        "@language": "en",
        "@value": "Section 70 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/eng@/~chp_VI__cl_52__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/eng@/~chp_VI__cl_52",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (1) the following subsection: “(1) In relation to goods that have been approved by the proper officer of customs to be deposited in the warehouse, there shall be a scheme to be known as the “Warehousing Scheme” which allows— (a) tax due and payable on the goods that have been imported to be suspended when such goods are deposited in the warehouse; and (b) tax chargeable on any supply of taxable goods made within or between the warehouse to be disregarded.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/eng@/~chp_VI__cl_52__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/eng@/~chp_VI__cl_52",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (1) the following subsection: “(1A) The Warehousing Scheme under subsection (1) shall not be applicable to goods as may be prescribed.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/eng@/~chp_VI__cl_52__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/eng@/~chp_VI__cl_52",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (2) the following subsection: “(2) Tax shall be due and payable upon all goods removed from a warehouse to all intents as if the removal were importation into Malaysia unless the goods are removed for export, for deposit to another warehouse, to a free zone or to a designated area with the approval of the proper officer of customs.”;"
      }
    },
