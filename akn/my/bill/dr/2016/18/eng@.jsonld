      "schema:text": {
        "@language": "en",
        "@value": "in subsection (6)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/eng@/~chp_II__cl_8__para_a__subpara_i",
