      "schema:text": {
        "@language": "en",
        "@value": "in subparagraph 16b(1) as renumbered, by substituting for the words “42A and 42b” the words “42A, 42b and 42C”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/eng@/~chp_II__cl_28__para_a__subpara_iii",
