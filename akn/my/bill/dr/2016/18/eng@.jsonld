      "@type": "akn:clause",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/eng@/~chp_II",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 60(11) of the principal Act is amended by deleting the definition of “revenue account”. Amendment of section 60aa"
      }
    },
