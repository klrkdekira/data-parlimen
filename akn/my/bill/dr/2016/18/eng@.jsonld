        "@value": "by deleting subsubparagraph (b); and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/eng@/~chp_IV__cl_36__para_d__subpara_iii",
