        "@value": "AMENDMENTS TO THE REAL PROPERTY GAINS TAX ACT 1976 Commencement of amendments to the Real Property Gains Tax Act 1976"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/eng@/~chp_IV__cl_34",
      "@type": "akn:clause",
      "eli:number": "34",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/eng@/~chp_IV__cl_34__subsec_1",
