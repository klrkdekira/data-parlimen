      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subparagraph 33b(1) as renumbered the following subparagraph: “(2) The exemption under subparagraph (1) shall not apply to— (a) interest paid or credited to a company in the same group; (b) interest paid or credited to— (i) a bank licensed under the Financial Services Act 2013; (ii) an Islamic bank licensed under the Islamic Financial Services Act 2013; or (iii) a development financial institution prescribed under the Development Financial Institutions Act 2002.”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/eng@/~chp_II__cl_29__para_h",
