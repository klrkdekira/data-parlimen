      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Finance Act 2016. Amendment of Acts"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/eng@/~chp_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/eng@/~chp_I",
      "schema:text": {
        "@language": "en",
        "@value": "The Income Tax Act 1967 [Act 53], the Petroleum (Income Tax) Act 1967 [Act 543], the Real Property Gains Tax Act 1976 [Act 169], the Labuan Business Activity Tax Act 1990 [Act 445] and the Goods and Services Tax Act 2014 [Act 762] are amended in the manner specified in Chapters II, III, IV, V and VI respectively."
      }
    },
