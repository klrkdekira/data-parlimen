      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 20(6) Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_VI__cl_43__para_a",
      "@type": "akn:paragraph",
