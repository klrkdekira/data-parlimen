      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan sebelum takrif “investment” takrif yang berikut: ‘ “family takaful business” has the same meaning assigned to it under subsection 2(1) of the Islamic Financial Services Act 2013; “general takaful business” means all takaful business which is not family takaful business; “general takaful certificate” means a certificate other than a family takaful certificate;’;"
      }
    },
