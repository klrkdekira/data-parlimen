    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 4, 6, 22, 23, 24 dan 26, dan perenggan 28(b) mula berkuat kuasa apabila berkuatkuasanya Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 5 dan subperenggan 10(a)(i) disifatkan telah mula berkuat kuasa dari tahun taksiran 2015."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_3__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 12, 13, 20 dan 21, dan perenggan 27(b) dan 29(e) disifatkan telah mula berkuat kuasa pada 30 Jun 2013."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_3__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan 7(a) disifatkan telah mula berkuat kuasa dari 1 Januari 2010."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_3__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan 7(b), seksyen 8 dan 9, subperenggan 10(a)(ii), (iii), (iv), (v), (vi), (vii) dan (viii), perenggan 10 (b), seksyen 11, 14, 15, 16 dan 17, dan perenggan 27(a) dan 29(a), (b), (c), (d), (f), (g) dan (h) berkuat kuasa bagi tahun taksiran 2017 dan tahun-tahun taksiran berikutnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_3__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 18 dan 25 mula berkuat kuasa pada 1 Januari 2017."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_3__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 19 berkuat kuasa bagi tahun taksiran 2019 dan tahun-tahun taksiran berikutnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_3__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan 28(a) disifatkan telah mula berkuat kuasa dari tahun taksiran 2016. Pindaan seksyen 2"
      }
    },
