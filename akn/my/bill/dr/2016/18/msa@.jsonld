      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong subseksyen (3a) dan (3b); dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_7__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_7__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (6)(k)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_7__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_7__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “Ministry of Information, Communication and Culture” dengan perkataan “Minister charged with the responsibility for arts, culture or heritage”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_7__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_7__para_b__subpara_ii__subpara_A",
