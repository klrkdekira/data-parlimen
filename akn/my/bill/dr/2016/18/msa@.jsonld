      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong takrif “Malaysian certificate”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_13__para_i__subpara_x",
