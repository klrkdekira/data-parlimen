      "schema:text": {
        "@language": "ms",
        "@value": "dengan menomborkan semula perenggan 33a sedia ada sebagai subperenggan 33a(1); dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_29__para_f__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
