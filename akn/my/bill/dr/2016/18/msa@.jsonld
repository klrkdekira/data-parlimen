      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_VI__cl_52",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (4)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_VI__cl_52__para_e__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_VI__cl_52__para_e",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan “daripada Skim Penggudangan”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_VI__cl_52__para_e__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
