      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “dan duti” dengan perkataan “daripada suatu gudang”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_VI__cl_52__para_e__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "hasPart": [
