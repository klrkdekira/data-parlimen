      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “sovereign rights” perkataan “or jurisdiction”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_4__list_1__para_b",
