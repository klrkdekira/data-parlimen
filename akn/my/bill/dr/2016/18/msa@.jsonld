      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subperenggan 33a(1) sebagaimana yang dinomborkan semula subperenggan yang berikut: “(2) The exemption under subparagraph (1) shall not apply to interest paid or credited to a company in the same group.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_29__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_29__para_g__subpara_i",
