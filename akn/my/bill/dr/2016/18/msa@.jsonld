      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan takrif “qard” dengan takrif yang berikut: ‘ “qard” means a benevolent loan or other forms of financial support to the takaful fund from the shareholders’ fund made pursuant to section 95 of the Islamic Financial Services Act 2013;’;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_13__para_i__subpara_xiv",
