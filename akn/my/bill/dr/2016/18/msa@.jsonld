      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perenggan 18;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_29__para_d",
