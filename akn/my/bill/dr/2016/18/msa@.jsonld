      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “Central Bank of Malaysia pursuant to section 37 of the Banking and Financial Institutions Act 1989 and subsection 5(2) of the Islamic Banking Act 1983” dengan perkataan “Minister pursuant to section 12 of the Financial Services Act 2013 and section 12 of the Islamic Financial Services Act 2013”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_29__para_f",
      "@type": "akn:paragraph",
