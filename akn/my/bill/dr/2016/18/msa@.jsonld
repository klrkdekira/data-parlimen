      "schema:text": {
        "@language": "ms",
        "@value": "the use of, or the granting of the right to use, some or all such part of the spectrum specified in a spectrum licence as is mentioned in paragraph (f); or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_4__list_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_4__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "the alienation of any property, know-how or information mentioned in paragraph (a), (b) or (c) of this definition;”. Pindaan seksyen 13"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 13 Akta ibu dipinda dengan memasukkan selepas subseksyen (1) subseksyen yang berikut: “(1 a) The total amount of gross income referred to in subsection (1), where applicable, shall include any amount of output tax paid under the Goods and Services Tax Act 2014 in connection with the gross income which is borne by the employer.”. Pindaan seksyen 15a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_6__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 15a Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan noktah bertindih di hujung subperenggan 15a(iii) dengan noktah; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong proviso. Pindaan seksyen 34"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_7",
