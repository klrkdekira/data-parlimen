      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan 33a—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_29__para_f__subpara_i",
