      "schema:text": {
        "@language": "ms",
        "@value": "the use of, or the granting of the right to use, any such visual images or sounds as are mentioned in paragraph (e); or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_4__list_2__para_g__subpara_iv",
