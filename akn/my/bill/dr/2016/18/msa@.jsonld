      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_VI__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (c)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_VI__cl_46__para_d__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_VI__cl_46__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “tidak dibayar” perkataan “sepenuhnya atau sebahagiannya”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_VI__cl_46__para_d__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_VI__cl_46__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “sepuluh” dengan perkataan “lima belas”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_VI__cl_46__para_d__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_VI__cl_46__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “genap masa dan kena dibayar” dengan perkataan “masih belum dibayar;”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_VI__cl_46__para_d__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_VI__cl_46__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan “, tertakluk kepada penalti maksimum sebanyak dua puluh lima peratus daripada amaun cukai yang genap masa dan kena dibayar”. Pindaan seksyen 42"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_VI__cl_47",
      "@type": "akn:clause",
      "eli:number": "47",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_VI__cl_47__para_a",
