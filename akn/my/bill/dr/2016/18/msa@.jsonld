      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (b)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_VI__cl_52__para_e__subpara_iii__subpara_A",
      "@type": "akn:subparagraph",
      "eli:number": "A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_VI__cl_52__para_e__subpara_iii",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan “kastam atau gudang berlesen” di mana-mana jua terdapat; dan"
      }
    },
    {
