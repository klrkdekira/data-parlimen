      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “subsoil of the territorial waters,” perkataan “and the airspace above such areas,”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_4__list_1__para_a__subpara_ii",
