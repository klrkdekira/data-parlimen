      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan sebelum takrif “offshore takaful” takrif yang berikut: ‘ “Malaysian family takaful fund” means the takaful fund in respect of Malaysian family takaful certificate; “Malaysian takaful certificate” has the same meaning assigned to it under subsection 2(1) of the Islamic Financial Services Act 2013;’;"
      }
    },
