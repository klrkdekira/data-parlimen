      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “kawasan ditetapkan” perkataan “ke suatu kawasan ditetapkan yang lain melalui Malaysia atau dari kawasan ditetapkan”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_VI__cl_56__para_a__subpara_iii",
