      "schema:text": {
        "@language": "ms",
        "@value": "dalam proviso—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_7__para_b__subpara_ii__subpara_A",
      "@type": "akn:subparagraph",
      "eli:number": "A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_7__para_b__subpara_ii",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “five” dengan perkataan “seven”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_7__para_b__subpara_ii__subpara_B",
      "@type": "akn:subparagraph",
      "eli:number": "B",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_7__para_b__subpara_ii",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “two” dengan perkataan “three”. Pindaan seksyen 44"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_8",
      "@type": "akn:clause",
