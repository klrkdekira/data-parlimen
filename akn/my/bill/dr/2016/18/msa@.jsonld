      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan sebelum takrif “takaful” takrif yang berikut: ‘ “retakaful” has the same meaning assigned to it under subsection 2(1) of the Islamic Financial Services Act 2013;’;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_13__para_i__subpara_xvi",
