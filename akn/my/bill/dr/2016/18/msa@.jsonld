      "schema:text": {
        "@language": "ms",
        "@value": "dalam subsubperenggan (a), dengan menggantikan perkataan “or organization” dengan perkataan “, organization or fund”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_29__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_29__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subsubperenggan (b) dengan subsubperenggan yang berikut: “(b) a religious institution or organization in respect of any contribution received for charitable purposes in the basis year for a year of assessment provided such institution or organization is not operated or conducted primarily for profit and is established in Malaysia exclusively for the purpose of religious worship or the advancement of religion.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_29__para_c",
