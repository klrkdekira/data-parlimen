      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “the business of banking or finance in Malaysia and licensed under the Banking and Financial Institutions Act 1989 or the Islamic Banking Act 1983” dengan perkataan “banking business or Islamic banking business in Malaysia and licensed under the Financial Services Act 2013 or the Islamic Financial Services Act 2013, as the case may be”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_29__para_e__subpara_ii",
