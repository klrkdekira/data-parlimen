      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “yang dibekalkan” dengan perkataan “yang dipindahkan”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_VI__cl_56__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
