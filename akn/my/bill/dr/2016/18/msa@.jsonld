      "schema:text": {
        "@language": "ms",
        "@value": "the reception of, or the granting of the right to receive, any such visual images or sounds as are mentioned in paragraph (d);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_4__list_2__para_g__subpara_iii",
