      "schema:text": {
        "@language": "ms",
        "@value": "the use of, or the right to use in respect of any copyrights, software, artistic or scientific works, patents, designs or models, plans, secret processes or formulae, trademarks or other like property or rights;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/18/msa@/~chp_II__cl_4__list_2__para_b",
