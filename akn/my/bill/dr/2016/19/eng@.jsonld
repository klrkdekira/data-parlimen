      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/19/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Emblems and Names (Prevention of Improper Use) (Amendment) Act 2016."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/19/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/19/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Substitution of section 5"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/19/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/19/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Emblems and Names (Prevention of Improper Use) Act 1963 [Act 414] is amended by substituting for section 5 the following “Penalty 5. Any person who contravenes section 3 commits an offence and shall, on conviction, be liable to a fine not exceeding twenty thousand ringgit or to imprisonment for a term not exceeding three years, or to both.”."
      }
    }
