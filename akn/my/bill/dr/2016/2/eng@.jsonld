      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/2/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Purpose Title B. 1 Parliament B. 6 Prime Minister’s Department B. 12 Contribution to Statutory Funds B. 13 Ministry of Foreign Affairs B. 28 Ministry of Transport B. 43 Ministry of Urban Wellbeing, Housing and Local Government B. 63 Education TOTAL"
      }
    }
