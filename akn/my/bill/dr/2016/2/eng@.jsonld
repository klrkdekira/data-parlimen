        "@value": "Supplementary Supply (2015) Bill 2016"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/2/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/2/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Supplementary Supply (2015) Act 2016. Additional expenditure for the year 2015"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/2/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/2/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The issue is hereby authorised of a sum not exceeding three billion three hundred and thirteen million six hundred and twenty two thousand seven hundred and ninety four ringgit (RM3,313,622,794) from the Consolidated Fund for additional expenditure on the services and purposes specified in the Schedule for the year 2015 not provided for or not fully provided for by the Supply Act 2015 [Act A1469]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/2/eng@/~sched_1",
