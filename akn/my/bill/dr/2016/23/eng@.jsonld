      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (a), by substituting for the words “fifty thousand ringgit or to imprisonment for a term not exceeding three years” the words “one hundred thousand ringgit or to imprisonment for a term not exceeding five years”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/23/eng@/~cl_13__para_b__subpara_ii",
