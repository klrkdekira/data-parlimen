      "schema:text": {
        "@language": "en",
        "@value": "Subsection 24j(1) of the principal Act is amended by substituting for the words “he shall submit” the words “the Authority shall submit”. Amendment of section 24k"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/23/eng@/~cl_18",
