      "schema:text": {
        "@language": "en",
        "@value": "Subsection 24e(1) of the principal Act is amended by deleting the words “under paragraph 2b(a)”. Amendment of section 24h"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/23/eng@/~cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/23/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 24h of the principal Act is amended by substituting for the words “Director General” the words “Chief Executive Officer or authorized officer”. Amendment of section 24j"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/23/eng@/~cl_17",
      "@type": "akn:clause",
