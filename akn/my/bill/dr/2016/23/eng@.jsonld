      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (b), by substituting for the words “one hundred thousand ringgit” the words “two hundred thousand ringgit”. Amendment of section 24a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/23/eng@/~cl_14",
      "@type": "akn:clause",
