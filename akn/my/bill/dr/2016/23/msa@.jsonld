      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2), dengan menggantikan perkataan “sepuluh ribu ringgit” dengan perkataan “satu ratus ribu ringgit”. Pemotongan Bahagian IIIa"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/23/msa@/~cl_11",
