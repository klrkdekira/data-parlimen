      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 16 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/23/msa@/~cl_13__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
