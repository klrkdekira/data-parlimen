      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memotong Bahagian IIIa. Pindaan seksyen 7"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/23/msa@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
