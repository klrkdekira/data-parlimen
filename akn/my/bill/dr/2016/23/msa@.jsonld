      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 7(6) Akta ibu dipinda dengan menggantikan perkataan “lima puluh ribu ringgit” dengan perkataan “satu ratus ribu ringgit”. Pindaan seksyen 16"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/23/msa@/~cl_13",
      "@type": "akn:clause",
