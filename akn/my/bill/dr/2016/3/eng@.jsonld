    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_IV__cl_24__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_IV__cl_24__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "insurance coverage for the officers and servants of the Institute;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_IV__cl_24__para_a__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_IV__cl_24__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "costs incurred in providing for the welfare of the officers and servants of the Institute; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_IV__cl_24__para_a__subpara_v",
      "@type": "akn:subparagraph",
      "eli:number": "v",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_IV__cl_24__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "paying any other expenses, costs and expenditure in relation to the procurement of goods and services, including the engagement of consultants, legal fees and costs, and other fees and costs;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_IV__cl_24__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_IV__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "financing research and development activities;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_IV__cl_24__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_IV__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "providing funds to any body or organization which the Institute thinks expedient to commission research and development activities, development projects or publicity activities;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_IV__cl_24__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_IV__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "contributing to any body or organization within or outside Malaysia which promotes research and development in forest development and forest-based industries;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_IV__cl_24__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_IV__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "financing such scholarships for higher learning, research assistantship, scientist grants, fellowships, medals, prizes and other forms of distinctions, awards or assistance for serving as well as prospective officers and servants of the Institute;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_IV__cl_24__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_IV__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "paying any other expenses, costs or expenditure properly incurred or accepted by the Institute in the performance of its functions or the exercise of its powers under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_IV__cl_24__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_IV__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "meeting the expenses incurred by the Institute in setting up branches or research centres of the Institute;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_IV__cl_24__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_IV__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "purchasing or hiring equipment, machinery and any other materials, acquiring land and erecting buildings, and carrying out any other works and undertakings in the performance of its functions or the exercise of its powers under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_IV__cl_24__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_IV__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "granting loans or providing capital for companies established under section 30;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_IV__cl_24__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_IV__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "repaying any moneys borrowed under section 33 and the interest due on such moneys; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_IV__cl_24__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_IV__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "generally, paying any expenses for carrying into effect the provisions of this Act. Conservation of the Fund"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_IV__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "It shall be the duty of the Institute to conserve the Fund by so performing its functions and exercising its powers under this Act as to secure that the total revenues of the Institute are sufficient to meet all sums properly chargeable to its revenue account, including depreciation and interest on capital, taking one year with another. Expenditure and preparation of estimates"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_IV__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_IV__cl_26__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_IV__cl_26__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_IV__cl_26__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_IV__cl_26__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_IV__cl_26__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_IV__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "The expenditure of the Institute up to such amount as the Minister may authorize for any one year shall be defrayed out of the Fund."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_IV__cl_26__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_IV__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "Before the beginning of the month of June of each year, the Institute shall submit to the Minister an estimate of the expenditure (including the expenditure for research and development activities and development projects) for the following year in such form and containing such particulars as the Minister may direct."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_IV__cl_26__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_IV__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister shall, before the beginning of the month of December of that year, notify the Institute of the amount authorized for expenditure generally or of the amounts authorized for each description of expenditure."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_IV__cl_26__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_IV__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "The Institute may, at any time, submit to the Minister a supplementary estimate for any one year and the Minister may allow the whole or any part of the additional expenditure included in the supplementary estimate. Reserve fund"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_IV__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "The Institute shall establish and maintain a reserve fund within the Fund. Statutory Bodies (Accounts and Annual Reports) Act 1980"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_IV__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "The Statutory Bodies (Accounts and Annual Reports) Act 1980 [Act 240] shall apply to the Institute."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_I",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Forest Research Institute Malaysia Act 2016. Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_I__cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_I__cl_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_I__cl_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_I",
      "schema:name": {
        "@language": "en",
        "@value": "In this Act, unless the context otherwise requires—"
      },
      "schema:text": {
        "@language": "en",
        "@value": "“the repealed Act” means the Malaysian Forestry Research and Development Board Act 1985 [Act 319] repealed under subsection 46(1); “member of the Institute” means a member of the Institute appointed under section 7 and includes an alternate member appointed under section 9; “research findings” means any result from any research and development activity, and includes discovery, invention, innovation and improvement in any process, apparatus, machine or technique; “forest produce” means—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_I__cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_I__cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "products in the unprocessed or semi-processed form, and include logs, poles, fuelwood, rubberwood, stems and fibres of oil palms and its residues, coconut and other palms, gaharu and other scented wood, gums, damar and oleoresins, wood oils, leaves, rattans, bamboos, seeds, nuts, shoots, roots, mengkuang, medicinal plants, aromatic plants, soils, microorganisms and other similar products of any description whether present or future;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_I__cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_I__cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "products that have undergone processing or whose forms have been altered, and include sawn timber, charcoal, essential oils, wood chips and wood shavings, ground wood, beadings and mouldings, plywood and veneer, particleboards and fibreboards, blockboards, laminboards and other reconstituted wood-based panel products, wood pulp, paper and paper products, glue-laminated timber, tissue cultured plants, chemical and protein extracts, substances or derivatives for production of pharmaceuticals, neutraceuticals, cosmeceuticals and functional food and other processed or altered products that are derived from the products as specified in paragraph (a); and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_I__cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_I__cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "products in the finished form, and include attaps, railway and tramway sleepers of wood, furniture, handicrafts and toys of wood, wooden handles of tools, piles, pickets, and stakes of wood, picture frames of wood, packing cases of wood, household utensils of wood, basketwork, wickerwork and other articles of plaiting, pencils and other finished products that are wholly or partially made from the products as specified in paragraph (a) or (b); “forest-based industries” means all industries engaged in the harvesting, extracting, testing, processing, manufacturing, preservation and seasoning of forest produce, and services related thereto; “Institute” means the Forest Research Institute of Malaysia which continues to be in existence and with a change of name in the English language to the “Forest Research Institute Malaysia” under section 3; “Director General” means the Director General appointed under section 15; “Fund” means the Forest Research Institute Malaysia Fund established under section 23; “Minister” means the Minister charged with the responsibility for forestry; “forest development” means the management and development policies and activities for all natural and man-made forests based on sound ecological and socio-economic principles for the expressed purposes of both the production of forest produce and the protection of the environment; “conservation” means safeguarding genetic resources, species and ecosystem diversity, as well as sustainable use of biological resources and its equitable sharing of benefits to meet the needs and aspiration of present and future generations; “Chairman” means the Chairman of the Institute appointed under paragraph 7(a) and includes any member of the Institute appointed to perform the function of the Chairman under section 10."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V",
      "@type": "akn:part",
      "eli:number": "V",
