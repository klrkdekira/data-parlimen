        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_56"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "REPEAL, DISSOLUTION, SAVINGS AND TRANSITIONAL PROVISIONS, ETC. Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_45",
      "@type": "akn:clause",
      "eli:number": "45",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_45__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_45__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII",
      "schema:name": {
        "@language": "en",
        "@value": "For the purpose of this Part—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_45__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_45",
      "schema:text": {
        "@language": "en",
        "@value": "“dissolved Board” means the Malaysian Forestry Research and Development Board dissolved under subsection 46(2);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_45__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_45",
      "schema:text": {
        "@language": "en",
        "@value": "“commencement date” means the date on which this Act comes into operation. Repeal and dissolution"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_46",
      "@type": "akn:clause",
      "eli:number": "46",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_46__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_46__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_46__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "The Malaysian Forestry Research and Development Board Act 1985 is repealed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_46__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "The Malaysian Forestry Research and Development Board established under the repealed Act is dissolved. Transfer of powers, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_47",
      "@type": "akn:clause",
      "eli:number": "47",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "All powers, rights, privileges, liabilities, obligations and duties that before the commencement date were those of the dissolved Board shall devolve as from the commencement date on the Institute. Transfer of property"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_48",
      "@type": "akn:clause",
      "eli:number": "48",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_48__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_48__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_48__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "All lands that before the appointed date were vested in, or reserved under any written law relating to land for the purposes of the dissolved Board shall on the commencement date vest in or be deemed to be reserved for the purposes of the Institute."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_48__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "All properties and assets, other than land, that before the commencement date were vested in the dissolved Board or in any person on behalf of the dissolved Board shall on the commencement date vest in the Institute. Existing contracts"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_49",
      "@type": "akn:clause",
      "eli:number": "49",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "All deeds, bonds, agreements, instruments and working arrangements subsisting before the commencement date and affecting any of the property transferred under section 48 shall have full force and effect against or in favour of the Institute and shall be enforceable as fully and effectually as if, instead of the dissolved Board or any person acting on behalf of the dissolved Board, the Institute had been named therein or been a party thereto. Dissolution of Forestry Research and Development Fund, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_50",
      "@type": "akn:clause",
      "eli:number": "50",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_50__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_50__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_50__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "The Forestry Research and Development Fund established under the repealed Act is dissolved."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_50__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "All moneys standing in or due to be paid to the Forestry Research and Development Fund shall on the commencement date be transferred to and vested in and be deemed to be part of the Fund. Membership of dissolved Board"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_51",
      "@type": "akn:clause",
      "eli:number": "51",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_51__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_51__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_51__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_51__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_51",
      "schema:text": {
        "@language": "en",
        "@value": "All members and alternate members of the dissolved Board appointed under the repealed Act and all members of any committee set up under the repealed Act, who held office before the commencement date shall cease to hold office on the commencement date."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_51__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_51",
      "schema:text": {
        "@language": "en",
        "@value": "Nothing in subsection (1) shall affect the accountability of the outgoing members of the dissolved Board and as soon as practicable after the commencement date, the dissolved Board shall prepare and submit to the Minister a report including the financial statements required under the repealed Act, but the report shall be limited to the period from 1 January of the relevant year to the date before the commencement date."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_51__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_51",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (1), the dissolved Board shall continue in existence for the purpose of subsection (2). Officers continue to hold office"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_52",
      "@type": "akn:clause",
      "eli:number": "52",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_52__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_52__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_52__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "All persons holding office under the repealed Act immediately before the commencement date as—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_52__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_52",
      "schema:text": {
        "@language": "en",
        "@value": "Director General;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_52__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_52",
      "schema:text": {
        "@language": "en",
        "@value": "Deputy Director General;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_52__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_52",
      "schema:text": {
        "@language": "en",
        "@value": "officers and servants of the Institute, shall be deemed to have been appointed under this Act and shall continue to hold such office on the same terms and conditions for a term expiring on the date on which their appointments under the repealed Act would expire. Continuance of pending applications, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_53",
      "@type": "akn:clause",
      "eli:number": "53",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_53__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_53__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_53__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_53__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_53",
      "schema:text": {
        "@language": "en",
        "@value": "All applications, approvals and decisions, on appeal or otherwise, pending before the dissolved Board shall on the commencement date be dealt with by the Institute."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_53__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_53",
      "schema:text": {
        "@language": "en",
        "@value": "All applications, approvals and decisions, on appeal or otherwise, pending before the Minister under the repealed Act shall on the commencement date be dealt with by the Minister under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_53__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_53",
      "schema:text": {
        "@language": "en",
        "@value": "All instruments, certificates and documents lodged with the dissolved Board before the commencement date shall on the commencement date be lodged with the Institute. Continuance of civil and criminal proceedings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_54",
      "@type": "akn:clause",
      "eli:number": "54",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_54__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_54__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_54__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_54__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_54",
      "schema:text": {
        "@language": "en",
        "@value": "Nothing contained in this Act shall affect any person’s liability to be prosecuted or punished for the offences committed before the commencement date, or any proceedings brought before the commencement date in respect of such offences."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_54__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_54",
      "schema:text": {
        "@language": "en",
        "@value": "Any proceedings, whether civil or criminal, or cause of action pending or existing before the commencement date by or against the dissolved Board or any person acting on behalf of the dissolved Board may be continued or instituted by or against the Institute as it might have been by or against the Institute or such person if this Act had not been enacted."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_54__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_54",
      "schema:text": {
        "@language": "en",
        "@value": "Any appeal brought or any leave to appeal applied for on or after the commencement date against a decision given before the commencement date in any legal proceedings to which the dissolved Board was a party may be brought by or against the Institute. Validation and indemnity"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_55",
      "@type": "akn:clause",
      "eli:number": "55",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_55__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_55__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_55__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_55__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_55__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_55",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding the absence of any provision on the imposition and collection of fees by the dissolved Board except for the fixing of fees under section 22 of the Malaysian Forestry Research and Development Board Act 1985, the following fees shall be deemed to have been validly imposed and collected:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_55__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_55__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "entrance fees which were imposed and collected by the dissolved Board during the period from 1 November 1996; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_55__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_55__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "other fees and charges for any use of facilities which were imposed and collected by the dissolved Board during the period from 1 January 1986, to the day preceding the commencement date."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_55__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_55",
      "schema:text": {
        "@language": "en",
        "@value": "No action or legal proceeding shall be brought, instituted or maintained against the dissolved Board or any officer of the dissolved Board or any person acting under them in respect of any fees or charges which were imposed and collected, and if any such action or legal proceeding has been brought, instituted or maintained, it shall be discharged and made void and no refund in respect of the fees or charges imposed and collected as stated in this Act shall be made. Reference in law or document to dissolved Board"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_56",
      "@type": "akn:clause",
      "eli:number": "56",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "A reference in any law or document in force before the commencement date to the dissolved Board shall be construed as a reference to the Institute."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_37",
      "@type": "akn:clause",
      "eli:number": "37",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_37__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_37__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_37__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_37__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_37__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_37__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_37__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_37__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "Where a research and development activity conducted by the Institute is funded by—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_37__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_37__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Federal Government, the property in every research finding of such research and development activity shall vest in the Institute; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_37__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_37__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any State Government, individual, company, body or organization, the property in every research finding of such research and development activity shall vest in accordance with the agreement between the Institute and the State Government, individual, company, body or organization."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_37__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "Where a research and development activity is conducted by an officer or servant of the Institute in the course of his duties, the property in every research finding of such research and development activity shall vest in the Institute."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_37__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "The Institute may, as it thinks fit, give rewards or incentives to the officer or servant of the Institute referred to in subsection (2)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_37__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "The Institute may make available any research finding the property of which is vested in the Institute to the Federal Government or any State Government, individual, company, body or organization subject to such conditions and to the payment of such fees, royalties or other consideration, if any, as the Institute may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_37__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection (4) shall be in addition to and not in derogation of the provision of section 31. Access to research findings and facility, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "The Institute may, subject to such conditions, restrictions or limitations as the Institute may determine, including the imposition of fees, allow access to its research findings, premises and facilities. Prohibition against reproduction or publication"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_39__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_39__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_39__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_39__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_39__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_39",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall reproduce or publish or cause to be reproduced or published the contents of any research findings or any part thereof except—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_39__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_39__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "with the prior written consent of the Director General; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_39__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_39__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "in accordance with any terms and conditions as the Director General may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_39__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_39",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes this section commits an offence and shall, on conviction, be liable to a fine not exceeding one hundred thousand ringgit or to imprisonment for a term not exceeding two years or to both. Secrecy"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_40__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_40__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_40__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_40__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "Except for the purposes of this Act or of any proceedings, any member of the Institute or any of its committees or any officer, servant or agent of the Institute shall not disclose any information relating to any matter which has been obtained by him in the course of his duties and which is not published pursuant to this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_40__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "All information obtained by any member of the Institute or any of its committees, or any officer, servant or agent of the Institute in respect of any formula, process or practice in connection with the administration of this Act shall be treated as confidential."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_40__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes this section commits an offence and shall, on conviction, be liable to a fine not exceeding one hundred thousand ringgit or to imprisonment for a term not exceeding two years or to both. Restriction on the use of words"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_41",
      "@type": "akn:clause",
      "eli:number": "41",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_41__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_41__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_41__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "Except with the approval of the Institute, no person shall use for whatever purpose the name that contains the words “Institut Penyelidikan Perhutanan Malaysia”, “Forest Research Institute Malaysia”, “Forest Research Institute of Malaysia” or the letters “FRIM” or any abbreviation or misleading abbreviation thereof or any mark of the Institute or any resemblance thereof."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_41__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes this section commits an offence and shall, on conviction, be liable to a fine of not less than two hundred thousand ringgit. Protection against suits and legal proceedings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_42",
      "@type": "akn:clause",
      "eli:number": "42",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_42__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_42__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "No action, suit, prosecution or proceedings shall lie or be brought, instituted or maintained in any court—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_42__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "against the Institute; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_42__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "against any member of the Institute or any of its committees or any officer, servant or agent of the Institute, in respect of any act, neglect, default or omission done or omitted by it or him in good faith in such capacity. Public Authorities Protection Act 1948"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_43",
      "@type": "akn:clause",
      "eli:number": "43",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "The Public Authorities Protection Act 1948 [Act 198] shall apply to any action, suit, prosecution or proceedings against the Institute or against any member of the Institute or any of its committees, or any officer, servant or agent of the Institute in respect of any act, neglect or default done or committed by it or him in such capacity. Public servants"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_44",
      "@type": "akn:clause",
      "eli:number": "44",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "Every member of the Institute or any of its committees, or any officer, servant or agent of the Institute, while discharging his duties as such member, officer, servant or agent shall be deemed to be a public servant within the meaning of the Penal Code [Act 574]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V__cl_29__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V__cl_29__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V__cl_29__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V__cl_29__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, with the concurrence of the Minister of Finance, make orders for the imposition, variation or cancellation of a research cess on the exportation of all or any forest produce, and the order may specify the nature, amount and rate of the cess, person or class of persons on whom the cess is imposed and the manner of the collection of the cess."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V__cl_29__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "An order made under subsection (1) shall be published in the Gazette."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V__cl_29__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "Except as may be otherwise provided in an order made under subsection (1), such cess shall be deemed for the purposes of collecting and enforcing the collection thereof to be a customs duty imposed under the Customs Act 1967 [Act 235]. Power to establish companies"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V__cl_30__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V__cl_30__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "The Institute may, with the approval of the Minister and the Minister of Finance, establish or expand or promote the establishment or expansion of companies under the Companies Act 1965 [Act 125]—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V__cl_30__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "to perform any of its functions or exercise any of its powers; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V__cl_30__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "to carry out and have the charge, conduct and management of any programme, scheme, project or activity which has been planned or undertaken by the Institute in the performance of its functions or exercise of its powers. Power to commercialize research findings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V__cl_31__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V__cl_31__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V__cl_31__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "The Institute may, subject to such terms and conditions and the payment of such fees, royalties or other consideration, if any, as the Institute may determine, commercialize or cause to be commercialized any research findings or make available any research findings to any person for the purpose of its commercialization."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V__cl_31__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "For the purpose of subsection (1), the Institute may enter into any arrangement for sharing of profits, union of interest, co-operation, joint-venture or equity participation with any person. Power to impose fees and charges"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "The Institute may impose entrance fees and any other fees or charges as the Institute thinks fit for any technical, advisory, consultancy and any other services in relation to forest and forest-based industries, and any other services provided by the Institute and the use of its facilities. Power to borrow"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V__cl_33__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V__cl_33__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V__cl_33__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "The Institute may, with the approval of the Minister and the Minister of Finance, borrow any sums required by it for the proper performance of its functions or exercise of its powers."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V__cl_33__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "The Statutory Bodies (Power to Borrow) Act 1999 [Act 598] shall apply to the Institute. Power to invest, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V__cl_34",
      "@type": "akn:clause",
      "eli:number": "34",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V__cl_34__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V__cl_34__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V__cl_34__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "The Institute may, with the approval of the Minister and the Minister of Finance, invest the Fund or any part thereof, not being immediately required to be expended under this Act, in any investment or securities."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V__cl_34__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V__cl_34__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V__cl_34__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "The Institute may deposit, either on deposit account or current account, any moneys for the time being uninvested, in—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V__cl_34__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V__cl_34__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "any licensed bank or licensed investment bank under the Financial Services Act 2013 [Act 758]; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V__cl_34__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V__cl_34__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "any licensed Islamic bank under the Islamic Financial Services Act 2013 [Act 759]. Power to employ agents, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V__cl_35",
      "@type": "akn:clause",
      "eli:number": "35",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "The Institute may employ and pay agents, consultants and technical advisers, including advocates and solicitors, bankers, stockbrokers, surveyors, valuers or any other persons, to do all things expedient or necessary for or incidental to the performance of the functions of the Institute or the exercise of its powers. Power to make regulations"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V__cl_36",
      "@type": "akn:clause",
      "eli:number": "36",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "The Institute may, with the approval of the Minister, make such regulations as may be necessary or expedient for the purpose of carrying into effect the provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_11"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "[Subsection 3(4)] Revocation of appointment and resignation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_1",
      "@type": "akn:paragraph",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_1__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_1__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_10",
      "@type": "akn:paragraph",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to this Act, the Institute shall determine its own procedure. Member of Institute to devote time to business of Institute"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_11",
      "@type": "akn:paragraph",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1",
      "schema:text": {
        "@language": "en",
        "@value": "Every member of the Institute shall devote such time to the business of the Institute as may be necessary to discharge his duties effectively."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_1",
      "schema:text": {
        "@language": "en",
        "@value": "The appointment of any member of the Institute may at any time be revoked by the Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_1",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subparagraph (3), a member of the Institute may at any time resign his office by written notice addressed to the Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_1__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_1",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, upon receipt of the notice under subparagraph (2), accept or reject the resignation of the member of the Institute. Vacation of office"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_2",
      "@type": "akn:paragraph",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_2__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_2__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_2__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_2__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_2__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_2__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_2__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_2__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_2__subsec_1__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_2__subsec_1__para_h"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_2",
      "schema:text": {
        "@language": "en",
        "@value": "The office of a member of the Institute shall be vacated if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_2__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_2__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "he dies;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_2__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_2__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_2__subsec_1__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_2__subsec_1__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_2__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "there has been proved against him, or he has been convicted of, a charge in respect of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_2__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_2__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "an offence involving fraud, dishonesty or moral turpitude;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_2__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_2__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "an offence under any law relating to corruption; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_2__subsec_1__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_2__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "any other offence punishable with imprisonment (in itself only or in addition to or in lieu of a fine) for more than two years;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_2__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_2__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "he becomes a bankrupt;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_2__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_2__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "his conduct, whether in connection with his duties as a member of the Institute or otherwise, has been such as to bring discredit on the Institute;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_2__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_2__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "he is of unsound mind or is otherwise incapable of discharging his duties;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_2__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_2__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "he absents himself from three consecutive meetings of the Institute without leave of the Chairman or, in the case of the Chairman without leave of the Minister;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_2__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_2__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "his resignation is accepted by the Minister; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_2__subsec_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_2__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "his appointment is revoked by the Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_2",
      "schema:text": {
        "@language": "en",
        "@value": "Where the office of any member of the Institute is vacated by any reason referred to in subparagraph (1), the Minister may appoint another person to fill the vacancy. Meetings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_3",
      "@type": "akn:paragraph",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_3__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_3__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_3__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_3__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_3__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_3",
      "schema:text": {
        "@language": "en",
        "@value": "The Institute shall meet at least four times a year at such time and place as the Chairman may appoint."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_3",
      "schema:text": {
        "@language": "en",
        "@value": "At least fourteen days’ notice in writing shall be given to the members."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_3__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_3",
      "schema:text": {
        "@language": "en",
        "@value": "The Chairman shall preside at a meeting of the Institute."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_3__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_3",
      "schema:text": {
        "@language": "en",
        "@value": "The quorum of the Institute shall be six."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_3__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_3",
      "schema:text": {
        "@language": "en",
        "@value": "Every member present shall be entitled to one vote."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_3__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_3",
      "schema:text": {
        "@language": "en",
        "@value": "If on a question to be determined by the Institute there is an equality of votes, the Chairman shall have a casting vote. Allowance"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_4",
      "@type": "akn:paragraph",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1",
      "schema:text": {
        "@language": "en",
        "@value": "The Chairman and all other members of the Institute shall be paid such as meeting allowances at such rates as the Minister may determine. Institute may invite others to meetings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_5",
      "@type": "akn:paragraph",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_5__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_5",
      "schema:text": {
        "@language": "en",
        "@value": "The Institute may invite any person to attend a meeting or deliberation of the Institute for the purpose of advising it on any matter under discussion but that person shall not be entitled to vote at the meeting or deliberation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_5",
      "schema:text": {
        "@language": "en",
        "@value": "A person invited under subparagraph (1) may be paid such fees as the Institute may determine. Disclosure of interest"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_6",
      "@type": "akn:paragraph",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1",
      "schema:text": {
        "@language": "en",
        "@value": "A member of the Institute having, directly or indirectly, by himself or his partner, any interest in any company or undertaking with which the Institute proposes to make any contract or having any interest in any such contract or in any matter under discussion by the Institute shall disclose to the Institute the fact of his interest and the nature thereof, and such disclosure shall be recorded in the minutes of the Institute and, unless specifically authorized thereto by the Chairman, such member shall take no part in any deliberation or decision of the Institute relating to the contract or matter. Validity of acts and proceedings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_7",
      "@type": "akn:paragraph",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_7__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_7__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1",
      "schema:text": {
        "@language": "en",
        "@value": "No act done or proceedings taken under this Act shall be questioned on the ground of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_7",
      "schema:text": {
        "@language": "en",
        "@value": "a vacancy in the membership of, or a defect in the constitution of, the Institute;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_7",
      "schema:text": {
        "@language": "en",
        "@value": "the contravention of paragraph 6 by any member of the Institute; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_7__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_7",
      "schema:text": {
        "@language": "en",
        "@value": "an omission, a defect or an irregularity not affecting the merit of the case. Common seal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_8",
      "@type": "akn:paragraph",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_8__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_8__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_8",
      "schema:text": {
        "@language": "en",
        "@value": "The Institute shall have a common seal which shall bear such device as the Institute shall approve and such seal may be broken, changed, altered or made anew as the Institute thinks fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_8",
      "schema:text": {
        "@language": "en",
        "@value": "The common seal shall be kept in the custody of the Director General or such other person as the Institute may authorize, and shall be authenticated by the Director General or such authorized person or by any officer authorized by either of them in writing, and all deeds, documents and other instruments purporting to be sealed with the said seal, authenticated as aforesaid, shall, until the contrary is proved, be deemed to have been validly executed: Provided that any document or instrument which if executed by a person not being a body corporate would not be required to be under seal may in like manner be executed by the Institute, and any such document or instrument may be executed on behalf of the Institute by any officer or servant of the Institute generally or specially authorized by the Institute on that behalf."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_8__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_8",
      "schema:text": {
        "@language": "en",
        "@value": "The common seal of the Institute shall be officially and judicially noticed. Minutes"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_9",
      "@type": "akn:paragraph",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_9__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_9__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_9__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_9",
      "schema:text": {
        "@language": "en",
        "@value": "Minutes of meetings of the Institute shall be prepared by the Secretary to the Institute."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_9",
      "schema:text": {
        "@language": "en",
        "@value": "The Institute shall cause minutes of all its meetings to be maintained and kept in proper form."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_9__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_9",
      "schema:text": {
        "@language": "en",
        "@value": "Minutes made of meetings of the Institute shall, if duly signed, be admissible in evidence in all legal proceedings without further proof."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_9__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~sched_1__para_9",
      "schema:text": {
        "@language": "en",
        "@value": "Every meeting of the Institute in respect of the proceedings of which minutes have been so made shall be deemed to have been duly convened and held and all members thereat to have been duly qualified to act. Procedure"
      }
    }
  ]
}
