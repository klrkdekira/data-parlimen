        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_45",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_46",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII__cl_47",
