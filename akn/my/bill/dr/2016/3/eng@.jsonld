      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "DIRECTOR GENERAL, OFFICERS AND SERVANTS OF THE INSTITUTE Powers and duties of Director General"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_15__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_15__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_15__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_15__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_15__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_15__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_15__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister shall appoint a Director General of the Institute on such terms and conditions as the Minister may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "The Institute shall vest in the Director General such powers and shall impose upon him such duties as the Institute may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_15__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_15__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_15__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_15__subsec_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_15__subsec_3__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_15__subsec_3__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_15__subsec_3__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_15__subsec_3__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General shall be responsible for—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_15__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_15__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the proper administration and management of the affairs of the Institute;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_15__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_15__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the preparation of programmes, schemes, projects and activities for the consideration of the Institute;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_15__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_15__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the execution of all programmes, schemes, projects and activities of the Institute;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_15__subsec_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_15__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "keeping the Institute fully informed of the progress of the programmes, schemes, projects and activities of the Institute;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_15__subsec_3__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_15__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the issue of policy guidance and elucidation of the decisions of the Institute to officers and servants of the Institute;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_15__subsec_3__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_15__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "implementing the policy decisions of the Institute; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_15__subsec_3__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_15__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the supervision and control over the implementation of the decisions of the Institute."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_15__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General shall have general control of the officers and servants of the Institute."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_15__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General shall perform such further duties as the Institute may direct."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_15__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "In discharging his duties, the Director General shall act under the general authority and direction of the Institute. Appointment of Deputy Director General"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_16__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_16__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_16__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The Institute may appoint such number of Deputy Directors General from among the officers appointed under section 17 to assist the Director General in the exercise of his powers and the performance of his duties under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "If for any reason the Director General is unable to exercise his powers and to perform his duties, the Institute may appoint one of the Deputy Directors General to exercise the powers and to perform the duties of the Director General. Appointment of officers and servants"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_17__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_17__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "The Institute may appoint and employ such number of officers and servants as the Institute thinks necessary and upon such terms and conditions as the Institute considers appropriate for carrying out the purposes of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall be eligible for employment as an officer or servant of the Institute if he has, directly or indirectly, by himself or his partner, any share or interest in any contract or proposed contract with, for or on behalf of the Institute."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_17__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "The Institute may, with the approval of the Minister, the Treasury and the Public Services Department, determine the terms and conditions of service of the officers and servants of the Institute. Statutory Bodies (Discipline and Surcharge) Act 2000"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "The Statutory Bodies (Discipline and Surcharge) Act 2000 [Act 605] shall apply to the Institute. Loans, scholarships and advances"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "The Institute may grant loans, scholarships and advances to the officers and servants of the Institute for such purposes and on such terms and conditions as the Institute may determine. Payment of retirement benefit, gratuity, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "The Institute may make arrangements for the payment to the officers and servants of the Institute and their dependants such retirement benefits, gratuities and other allowances as the Institute may determine. Institute may adopt regulations, rules, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "The Institute may, with the approval of the Minister, adopt with such modifications as the Institute thinks fit any regulations, rules, policies, circulars and directives enacted or issued by the Federal Government. Delegation of Director General’s duties"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_22__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_22__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_22__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General may in writing delegate any of the powers or duties assigned to him under this Act, not including the powers so delegated from the Institute, to any officer of the Institute, subject to such conditions as the Director General thinks fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_22__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_III__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "A delegation under this section shall not preclude the Director General himself from performing or exercising at any time any of the powers or duties so delegated."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_10__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_10__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_10__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Chairman is for any reason unable to perform his functions or during any period of vacancy in the office of the Chairman, the Minister may appoint any member of the Institute, other than the Director General, to perform the functions of the Chairman."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "Until an appointment under subsection (1) is made or in default of such appointment or in the absence of the Chairman from any meeting of the Institute, the member of the Institute appointed under paragraph 7(b) shall perform the functions of the Chairman."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_10__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "A member appointed under subsection (1) or a member referred to in subsection (2) shall be deemed to be the Chairman during the period in which he is performing the functions of the Chairman under this section."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_10__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "If at any meeting of the Institute, neither the Chairman nor the person exercising the functions of the Chairman is present, the members present shall elect one of their members, other than the Director General, to preside at the meeting. Directions by Minister"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_11__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "The Institute shall be responsible to the Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, after consultation with the Institute, give such directions of a general character consistent with the provisions of this Act to the Institute and the Institute shall give effect to such directions. Returns, reports, accounts and information"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_12__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The Institute shall furnish to the Minister, and such public authority as the Minister may be direct, such returns, reports, accounts and information with respect to its property and activities as the Minister may require or direct."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to the generality of subsection (1), the Institute shall, as soon as practicable after the end of each financial year, cause to be made and transmitted to the Minister and, if so directed by the Minister, to any other public authority, a report dealing with the activities of the Institute during the preceding financial year and the report shall be in such form and shall contain such information relating to the proceedings and policy of the Institute as the Minister may determine. Secretary"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General shall appoint a person from among the officers appointed under section 17 to be the Secretary to the Institute. Institute may establish committees"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_14__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_14__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_14__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_14__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_14__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_14__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_14__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_14__subsec_9"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "The Institute may establish any committee as the Institute thinks necessary or expedient to assist it in the performance of its functions and exercise of its powers under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "The Institute may appoint any person to be a member of any committee established under subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_14__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "A committee established under this section may elect any of its members to be the chairman and may regulate its own procedure and, in the exercise of its powers under this subsection, such committee shall be subject to and act in accordance with any direction given to the committee by the Institute."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_14__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "Meetings of a committee established under this section shall be held at such times and places as the chairman of the committee may, subject to subsection (3), determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_14__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "A committee may invite any person who is not a member of the committee to attend any meeting of the committee for the purpose of advising it on any matter under discussion but that person is not entitled to vote at the meeting."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_14__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "Members of a committee or any person invited to attend any meeting of a committee under subsection (5) may be paid such allowances and other expenses as the Institute may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_14__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "A member of a committee shall hold office for such term as may be specified in his instrument of appointment and is eligible for reappointment."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_14__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "The appointment of any member of a committee may at any time be revoked by the Institute."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_14__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "A member of a committee may, at any time, resign his office by written notice addressed to the Chairman of the Institute."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_3__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_3__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_3__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_3__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding the repeal of the Malaysian Forestry Research and Development Board Act 1985 and the dissolution of the Malaysian Forestry Research and Development Board established under the repealed Act by section 46, the Forest Research Institute of Malaysia established by the Malaysian Forestry Research and Development Board under the repealed Act shall continue to be in existence under and subject to the provisions of this Act and with a change of name in the English language to the “Forest Research Institute Malaysia”."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "The change of name under subsection (1) shall not affect the identity of the Institute or any rights or obligations of the Institute or render defective any legal proceedings by or against the Institute, and any legal proceedings that might have been continued or commenced by or against it by its former name may be continued or commenced by or against it by its new name."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_3__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "The Institute shall be a body corporate and have perpetual succession and a common seal, and may sue and be sued in its corporate name."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_3__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "The provisions of the Schedule shall apply to the Institute."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_3__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may amend the provisions of the Schedule by order published in the Gazette. Functions of the Institute"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_4__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_4__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_4__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_4__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_4__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_4__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_4__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_4__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_4__para_k",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_4__para_l",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_4__para_m"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II",
      "schema:name": {
        "@language": "en",
        "@value": "The functions of the Institute shall be—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "to implement policies on research and development programmes to ensure the growth and sustainability of the forest and forest-based industries;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "to conduct and promote research on the multiple roles and functions of forests, including watershed, biotechnology, biodiversity and its sustainable use, conservation, ecotourism, greening of areas, effects of pollutants and climate change, appropriate for a rational and holistic approach to the sustainable and environmentally sound forest development;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "to promote, stimulate, facilitate, undertake and commercialize research findings in order to develop and utilize effectively such research findings in the interest of development of forest-based industries;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_4__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "to conduct and promote research on forest development including the production, extraction, processing, storage, transportation and utilization of forest produce, and other fields appropriate to the continued development of the forestry sector and the conservation of the resource base;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_4__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "to secure, where the public interest or the interest of forest development and forest-based industries so require, the development and advancement of research findings which appear to the Institute not to have been developed or explored or sufficiently developed or explored;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_4__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "to control, co-ordinate and monitor the activities of any person undertaking research and development programmes and any other programmes, schemes, projects and activities financed wholly or mainly from the Fund;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_4__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "to provide technical, advisory, consultancy and any other services in relation to forest and forest-based industries to any government, body or organization within or outside Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_4__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "to administer and manage the Fund;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_4__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "to collect, collate and disseminate information relating to research findings, forest development, forest produce and its utilization by way of publishing or sponsoring the publication of periodicals, journals, books, booklets and any other means available;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_4__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "to provide courses of study and training programmes in the field of forestry or any other related fields, and to take such other actions as may appear necessary or desirable for education;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_4__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "to act as a testing body and a certification body for forest produce upon being accredited as a conformity assessment body under the Standards of Malaysia Act 1996 [Act 549] or being accredited by any other accreditation body outside Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_4__para_l",
      "@type": "akn:paragraph",
      "eli:number": "l",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "to liaise, co-ordinate and collaborate with the Federal Government, any State Government or any body or organization in research and development programmes in the interest of the forest and forest-based industries including being members of any body or organization within and outside Malaysia; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_4__para_m",
      "@type": "akn:paragraph",
      "eli:number": "m",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "to do such other things as the Institute thinks fit to enable it to perform its functions effectively or which are incidental to the performance of its functions. Powers of the Institute"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The Institute shall have the power to do all things expedient or reasonable for and incidental to the performance of its functions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5__subsec_2__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5__subsec_2__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5__subsec_2__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5__subsec_2__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5__subsec_2__para_k",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5__subsec_2__para_l",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5__subsec_2__para_m",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5__subsec_2__para_n",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5__subsec_2__para_o"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The powers of the Institute shall include power—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to enter into contracts;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to acquire, purchase, take, hold and enjoy movable and immovable property of every description;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to convey, assign, surrender, yield up, charge, mortgage, demise, reassign, transfer or otherwise dispose of or deal with any movable or immovable property and any interest in any movable or immovable property, vested in the Institute;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to solicit and accept for the purposes of the Institute any money, land or other property from any person by way of grant, subsidy, donation, gift, subscription, endowment or otherwise, and where it accepts any such money, land or other property, extend to the person such concessions or benefits as the Institute thinks fit;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to acquire, hold, dispose of or grant rights in connection with the research findings of any research and development activity conducted by or for the Institute or by any person;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to undertake, co-ordinate or commission any person to undertake or co-ordinate research and development activities relating to forestry;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to determine the priority of the research and development activities of the Institute and approve the annual programmes of research and estimates of expenditure necessary for carrying out the programmes, schemes, projects and activities and for the administration of the Institute;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5__subsec_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to ensure that the programmes, schemes, projects and activities approved by the Institute are duly carried out and the expenditure incurred is in accordance with the estimates of expenditure;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5__subsec_2__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to collect and receive any moneys for services provided by the Institute and the use of its facilities;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5__subsec_2__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to enter into negotiations, agreements or arrangements as the Institute thinks fit for the performance of its functions;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5__subsec_2__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to conduct courses or technical and non-technical training in the field of forestry or any other related fields and to confer certificates upon persons who have followed such courses or training;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5__subsec_2__para_l",
      "@type": "akn:paragraph",
      "eli:number": "l",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to collaborate with any institution or organization within or outside Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5__subsec_2__para_m",
      "@type": "akn:paragraph",
      "eli:number": "m",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to award scholarships, bursaries, medals, prizes and other forms of distinctions, awards or assistance to any person in respect of the courses or technical and non-technical training referred to in paragraph (k) or the collaboration referred to in paragraph (l) or any course of study or training programme conducted by any institution of higher learning, whether public or private, within or outside Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5__subsec_2__para_n",
      "@type": "akn:paragraph",
      "eli:number": "n",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to undertake and co-ordinate such activities as the Institute thinks necessary for the purpose of protecting and furthering the interests of the forest and forest-based industries; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5__subsec_2__para_o",
      "@type": "akn:paragraph",
      "eli:number": "o",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to do all things expedient or necessary for or incidental to the performance of its functions and exercise of its powers."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The Institute may delegate any of its powers under this Act to the Director General of the Institute. Branches and research centres of the Institute"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_6__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The Institute may establish branches or research centres of the Institute within or outside Malaysia for the purpose of carrying out the provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The branches or research centres shall be headed by officers appointed by the Director General from amongst the officers appointed under section 17."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The heads of branches or research centres shall be responsible to the Director General and shall perform such duties as may be assigned to them by the Director General. Membership of the Institute"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_7__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_7__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_7__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_7__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_7__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_7__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_7__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_7__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_7__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_7__para_k",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_7__para_l"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "The Institute shall consist of the following members who shall be appointed by the Minister:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "a Chairman;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "a representative of the Ministry responsible for forestry;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_7__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
