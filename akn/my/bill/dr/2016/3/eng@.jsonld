      "schema:text": {
        "@language": "en",
        "@value": "moneys collected under section 29;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_IV__cl_23__subsec_3__para_c",
