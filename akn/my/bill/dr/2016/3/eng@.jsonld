        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI__cl_44"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "MISCELLANEOUS Property in research findings, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VII",
      "@type": "akn:part",
      "eli:number": "VII",
