        "@value": "moneys distributed as dividends from the companies established under section 30;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_IV__cl_23__subsec_3__para_d",
