      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "OTHER POWERS OF THE INSTITUTE Power to impose, etc., research cess"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_VI",
      "@type": "akn:part",
