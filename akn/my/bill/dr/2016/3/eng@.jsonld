      "schema:text": {
        "@language": "en",
        "@value": "fees, royalties and other consideration under sections 31 and 37 and moneys earned from any intellectual property rights, shares, equities and licensing agreements;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_IV__cl_23__subsec_3__para_e",
