      "schema:text": {
        "@language": "en",
        "@value": "a representative of the Malaysian Timber Industry Board;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_7__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "two representatives of the forest-based industries;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_7__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "not more than four other persons who, in the opinion of the Minister, are able to contribute to forestry research and development; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_7__para_l",
      "@type": "akn:paragraph",
      "eli:number": "l",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "the Director General. Tenure of office"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "A member of the Institute appointed under paragraph 7(a), (j) or (k) shall, unless he sooner resigns or vacates his office, hold office for a term not exceeding two years on such conditions as may be specified in his instrument of appointment and shall be eligible for reappointment. Alternate members"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_9__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_9__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "Any member of the Institute appointed under paragraph 7(b) to (i) may appoint an alternate member to attend meetings of the Institute if the member of the Institute is for any reason unable to attend."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "When attending meetings of the Institute, the alternate member shall for all purposes be deemed to be a member of the Institute."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_9__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "An alternate member shall, unless he sooner vacates his office, cease to be an alternate member when the member in respect of whom he is an alternate member resigns or vacates his office. Temporary exercise of functions of Chairman"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/eng@/~part_IV",
