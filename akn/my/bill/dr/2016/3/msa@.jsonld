      "schema:text": {
        "@language": "ms",
        "@value": "KETUA PENGARAH, PEGAWAI DAN PEKHIDMAT INSTITUT Kuasa dan kewajipan Ketua Pengarah"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_15__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_15__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_15__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_15__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_15__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_15__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_15__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri hendaklah melantik seorang Ketua Pengarah Institut atas apa-apa terma dan syarat sebagaimana yang ditentukan oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Institut hendaklah meletakhakkan kepada Ketua Pengarah apa-apa kuasa dan hendaklah mengenakan ke atasnya apa-apa kewajipan sebagaimana yang ditentukan oleh Institut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_15__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_15__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_15__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_15__subsec_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_15__subsec_3__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_15__subsec_3__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_15__subsec_3__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_15__subsec_3__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah adalah bertanggungjawab bagi—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_15__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_15__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "pentadbiran dan pengurusan sewajarnya hal ehwal Institut;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_15__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_15__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "penyediaan program, skim, projek dan aktiviti untuk dipertimbangkan oleh Institut;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_15__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_15__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "pelaksanaan semua program, skim, projek dan aktiviti Institut;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_15__subsec_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_15__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "memastikan Institut diberitahu sepenuhnya mengenai kemajuan program, skim, projek dan aktiviti Institut;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_15__subsec_3__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_15__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "pengeluaran garis panduan dasar dan penjelasan keputusan Institut kepada pegawai dan pekhidmat Institut;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_15__subsec_3__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_15__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "melaksanakan keputusan dasar Institut; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_15__subsec_3__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_15__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "pengawalseliaan dan kawalan ke atas pelaksanaan keputusan Institut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_15__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah hendaklah mempunyai kawalan am ke atas pegawai dan pekhidmat Institut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_15__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah hendaklah melaksanakan apa-apa kewajipan tambahan sebagaimana yang diarahkan oleh Institut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_15__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam menunaikan kewajipannya, Ketua Pengarah hendaklah bertindak di bawah kuasa dan arahan am Institut. Pelantikan Timbalan Ketua Pengarah"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_16__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_16__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_16__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Institut boleh melantik apa-apa bilangan Timbalan Ketua Pengarah daripada kalangan pegawai yang dilantik di bawah seksyen 17 untuk membantu Ketua Pengarah dalam penjalanan kuasanya dan pelaksanaan kewajipannya di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika atas apa-apa sebab Ketua Pengarah tidak dapat menjalankan kuasanya dan melaksanakan kewajipannya, Institut boleh melantik seorang daripada Timbalan Ketua Pengarah untuk menjalankan kuasa dan melaksanakan kewajipan Ketua Pengarah. Pelantikan pegawai dan pekhidmat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_17__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_17__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Institut boleh melantik dan mengambil khidmat apa-apa bilangan pegawai dan pekhidmat yang difikirkan perlu oleh Institut dan atas apa-apa terma dan syarat yang difikirkan sesuai oleh Institut bagi melaksanakan maksud Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun layak untuk diambil khidmat sebagai pegawai dan pekhidmat Institut jika dia mempunyai, secara langsung atau tidak langsung, dengan sendiri atau melalui pekongsinya, apa-apa syer atau kepentingan dalam mana-mana kontrak atau kontrak yang dicadangkan dengan, bagi atau bagi pihak Institut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_17__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Institut boleh, dengan kelulusan Menteri, Perbendaharaan dan Jabatan Perkhidmatan Awam, menentukan terma dan syarat perkhidmatan bagi pegawai dan pekhidmat Institut. Akta Badan Berkanun (Tatatertib dan Surcaj) 2000"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Badan Berkanun (Tatatertib dan Surcaj) 2000 [Akta 605] hendaklah terpakai bagi Institut. Pinjaman, biasiswa dan pendahuluan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Institut boleh memberikan pinjaman, biasiswa dan pendahuluan kepada pegawai dan pekhidmat Institut bagi apa-apa maksud dan atas apa-apa terma dan syarat sebagaimana yang ditentukan oleh Institut. Pembayaran faedah persaraan, ganjaran, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Institut boleh membuat perkiraan bagi pembayaran kepada pegawai dan pekhidmat Institut dan orang tanggungan mereka apa-apa faedah persaraan, ganjaran dan elaun lain sebagaimana yang ditentukan oleh Institut. Institut boleh menerima pakai peraturan-peraturan, kaedah-kaedah, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Institut boleh, dengan kelulusan Menteri, menerima pakai dengan apa-apa ubah suaian yang difikirkan patut oleh Institut mana-mana peraturan-peraturan, kaedah-kaedah, dasar, pekeliling dan arahan yang diperbuat atau dikeluarkan oleh Kerajaan Persekutuan. Pewakilan kewajipan Ketua Pengarah"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_22__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_22__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_22__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah boleh secara bertulis mewakilkan mana-mana kuasa atau kewajipan yang diberikan kepadanya di bawah Akta ini, tidak termasuk kuasa yang diwakilkan sedemikian daripada Institut, kepada mana-mana pegawai Institut, tertakluk kepada apa-apa syarat yang difikirkan patut oleh Ketua Pengarah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_22__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_III__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu pewakilan di bawah seksyen ini tidaklah menghalang Ketua Pengarah sendiri daripada melaksanakan atau menjalankan pada bila-bila masa mana-mana kuasa atau kewajipan yang diwakilkan sedemikian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_10__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_10__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_10__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Pengerusi atas apa-apa sebab tidak dapat melaksanakan fungsinya atau semasa apa-apa tempoh kekosongan jawatan Pengerusi, Menteri boleh melantik mana-mana anggota Institut, selain Ketua Pengarah, untuk melaksanakan fungsi Pengerusi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Sehingga suatu pelantikan di bawah subseksyen (1) dibuat atau jika tiada pelantikan sedemikian atau jika Pengerusi tidak hadir pada mana-mana mesyuarat Institut, anggota Institut yang dilantik di bawah perenggan 7(b) hendaklah melaksanakan fungsi Pengerusi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_10__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang anggota yang dilantik di bawah subseksyen (1) atau anggota yang disebut dalam subseksyen (2) hendaklah disifatkan sebagai Pengerusi semasa tempoh dia melaksanakan fungsi Pengerusi di bawah seksyen ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_10__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika pada mana-mana mesyuarat Institut, Pengerusi mahupun orang yang menjalankan fungsi Pengerusi tidak hadir, anggota yang hadir hendaklah melantik seorang daripada kalangan anggota yang hadir itu, selain Ketua Pengarah, untuk mempengerusikan mesyuarat itu. Arahan oleh Menteri"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_11__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Institut hendaklah bertanggungjawab kepada Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, selepas berunding dengan Institut, memberi Institut arahan yang bersifat am selaras dengan peruntukan Akta ini dan Institut hendaklah melaksanakan arahan itu. Penyata, laporan, akaun dan maklumat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_12__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Institut hendaklah memberi Menteri, dan mana-mana pihak berkuasa awam sebagaimana yang diarahkan oleh Menteri, apa-apa penyata, laporan, akaun dan maklumat mengenai harta dan aktivitinya sebagaimana yang dikehendaki atau diarahkan oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan keluasan subseksyen (1), Institut hendaklah, dengan seberapa segera yang dapat dilaksanakan selepas berakhir setiap tahun kewangan, menyebabkan supaya dibuat dan dihantar kepada Menteri dan, jika diarahkan sedemikian oleh Menteri, kepada mana-mana pihak berkuasa awam yang lain, suatu laporan yang menyatakan aktiviti Institut sepanjang tahun kewangan yang sebelumnya dan laporan itu hendaklah dalam apa-apa bentuk dan hendaklah mengandungi apa-apa maklumat yang berhubungan dengan prosiding dan dasar Institut sebagaimana yang ditentukan oleh Menteri. Setiausaha"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah hendaklah melantik seorang daripada kalangan pegawai yang dilantik di bawah seksyen 17 untuk menjadi Setiausaha kepada Institut. Institut boleh menubuhkan jawatankuasa"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_14__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_14__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_14__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_14__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_14__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_14__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_14__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_14__subsec_9"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Institut boleh menubuhkan apa-apa jawatankuasa yang difikirkannya perlu atau suai manfaat untuk membantunya dalam melaksanakan fungsinya dan menjalankan kuasanya di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Institut boleh melantik mana-mana orang untuk menjadi anggota mana-mana jawatankuasa yang ditubuhkan di bawah subseksyen (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_14__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu jawatankuasa yang ditubuhkan di bawah seksyen ini boleh memilih mana-mana daripada anggotanya untuk menjadi pengerusi dan boleh mengawal selia tatacaranya sendiri dan, pada menjalankan kuasanya di bawah subseksyen ini, mana-mana jawatankuasa itu hendaklah tertakluk kepada dan bertindak mengikut apa-apa arahan yang diberikan kepada jawatankuasa oleh Institut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_14__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Mesyuarat sesuatu jawatankuasa yang ditubuhkan di bawah seksyen ini hendaklah diadakan pada bila-bila masa dan di mana-mana tempat sebagaimana yang ditentukan oleh pengerusi jawatankuasa itu, tertakluk kepada subseksyen (3)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_14__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu jawatankuasa boleh mengundang mana-mana orang yang bukan anggota jawatankuasa untuk menghadiri mana-mana mesyuarat jawatankuasa bagi maksud menasihatinya mengenai apa-apa perkara yang dibincangkan tetapi orang itu tidak berhak untuk mengundi pada mesyuarat itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_14__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Anggota sesuatu jawatankuasa atau mana-mana orang yang diundang untuk menghadiri mesyuarat jawatankuasa itu di bawah subseksyen (5) boleh dibayar apa-apa elaun dan belanja lain sebagaimana yang ditentukan oleh Institut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_14__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang anggota sesuatu jawatankuasa hendaklah memegang jawatan bagi apa-apa tempoh sebagaimana yang dinyatakan dalam surat cara pelantikannya dan layak untuk dilantik semula."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_14__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Pelantikan mana-mana anggota jawatankuasa boleh pada bila-bila masa dibatalkan oleh Institut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_14__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang anggota sesuatu jawatankuasa boleh, pada bila-bila masa, meletakkan jawatannya dengan memberikan notis bertulis yang ditujukan kepada Pengerusi Institut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_3__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_3__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_3__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_3__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Walaupun Akta Lembaga Penyelidikan dan Pembangunan Perhutanan Malaysia 1985 dimansuhkan dan Lembaga Penyelidikan dan Pembangunan Perhutanan Malaysia yang ditubuhkan di bawah Akta yang dimansuhkan dibubarkan oleh seksyen 46, Institut Penyelidikan Perhutanan Malaysia yang ditubuhkan oleh Lembaga Penyelidikan dan Pembangunan Perhutanan Malaysia di bawah Akta yang dimansuhkan hendaklah terus wujud di bawah dan tertakluk kepada peruntukan Akta ini dan dengan pertukaran nama dalam bahasa Inggeris kepada “Forest Research Institute Malaysia”."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Pertukaran nama di bawah subseksyen (1) tidak boleh menyentuh identiti Institut atau apa-apa hak atau obligasi Institut atau mencacatkan apa-apa prosiding undang-undang oleh atau terhadap Institut, dan apa-apa prosiding undang-undang yang telah diteruskan atau dimulakan oleh atau terhadap Institut atas namanya yang dahulu boleh diteruskan atau dimulakan oleh atau terhadapnya atas namanya yang baharu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_3__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Institut hendaklah menjadi pertubuhan perbadanan dan terus kekal turun-temurun dan mempunyai suatu meterai perbadanan, dan boleh membawa guaman dan dibawa guaman atas nama perbadanannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_3__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Peruntukan Jadual hendaklah terpakai bagi Institut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_3__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh meminda peruntukan Jadual melalui perintah yang disiarkan dalam Warta. Fungsi Institut"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_4__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_4__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_4__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_4__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_4__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_4__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_4__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_4__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_4__para_k",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_4__para_l",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_4__para_m"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II",
      "schema:name": {
        "@language": "ms",
        "@value": "Fungsi Institut adalah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk melaksanakan dasar mengenai program penyelidikan dan pembangunan bagi menjamin pertumbuhan dan kemampanan hutan dan industri berasaskan hutan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menjalankan dan menggalakkan penyelidikan mengenai pelbagai peranan dan fungsi hutan, termasuk legeh, bioteknologi, kepelbagaian biologi dan penggunaannya secara mampan, pemuliharaan, ekopelancongan, penghijauan kawasan, kesan bahan pencemar dan perubahan iklim, sesuai dengan pendekatan yang rasional dan holistik bagi pembangunan hutan yang mampan dan mesra alam;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menggalakkan, merangsang, memudahkan, mengusahakan dan mengkomersialkan dapatan penyelidikan bagi membangunkan dan menggunakan secara berkesan dapatan penyelidikan itu demi kepentingan pembangunan industri berasaskan hutan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_4__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menjalankan dan menggalakkan penyelidikan mengenai pembangunan hutan termasuk pengeluaran, pengekstrakan, pemprosesan, penyimpanan, pengangkutan dan penggunaan hasil hutan, dan bidang lain yang sesuai dengan pembangunan berterusan sektor perhutanan dan pemuliharaan asas sumber;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_4__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mendapatkan, apabila kepentingan awam atau kepentingan pembangunan hutan dan industri berasaskan hutan berkehendakkan sedemikian, pembangunan dan kemajuan dapatan penyelidikan yang didapati oleh Institut masih belum dibangunkan atau diteroka atau dibangunkan atau diteroka dengan cukup;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_4__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengawal, menyelaraskan dan memantau aktiviti mana-mana orang yang mengusahakan program penyelidikan dan pembangunan dan apa-apa program, skim, projek dan aktiviti lain yang dibiayai keseluruhan atau terutamanya daripada Kumpulan Wang;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_4__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menyediakan perkhidmatan teknikal, nasihat, pakar runding dan apa-apa perkhidmatan lain berhubung dengan hutan dan industri berasaskan hutan kepada mana-mana kerajaan, badan atau organisasi di dalam dan di luar Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_4__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mentadbir dan mengurus Kumpulan Wang;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_4__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memungut, mengumpul semak dan menyebarkan maklumat yang berhubungan dengan dapatan penyelidikan, pembangunan hutan, hasil hutan dan penggunaannya melalui penyiaran atau menaja penerbitan berkala, jurnal, buku, buku kecil dan apa-apa cara lain yang ada;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_4__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menyediakan kursus pengajian dan program latihan dalam bidang perhutanan atau apa-apa bidang lain yang berkaitan, dan mengambil apa-apa langkah lain yang didapati perlu atau wajar untuk pendidikan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_4__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk bertindak sebagai suatu badan pengujian dan suatu badan pensijilan bagi hasil hutan apabila diakreditasikan sebagai badan penilaian pematuhan di bawah Akta Standard Malaysia 1996 [Akta 549] atau diakreditasikan oleh mana-mana badan akreditasi lain di luar Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_4__para_l",
      "@type": "akn:paragraph",
      "eli:number": "l",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk berhubung, menyelaraskan dan bekerjasama dengan Kerajaan Persekutuan, mana-mana Kerajaan Negeri dan apa-apa badan dan organisasi lain dalam program penyelidikan dan pembangunan demi kepentingan hutan dan industri berasaskan hutan termasuk menjadi anggota apa-apa badan atau organisasi di dalam dan di luar Malaysia; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_4__para_m",
      "@type": "akn:paragraph",
      "eli:number": "m",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk melakukan apa-apa perkara lain yang difikirkan patut oleh Institut bagi membolehkannya melaksanakan fungsinya dengan berkesan atau yang bersampingan dengan pelaksanaan fungsinya. Kuasa Institut"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Institut hendaklah mempunyai kuasa untuk melakukan semua perkara yang suai manfaat atau munasabah bagi dan bersampingan dengan pelaksanaan fungsinya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5__subsec_2__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5__subsec_2__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5__subsec_2__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5__subsec_2__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5__subsec_2__para_k",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5__subsec_2__para_l",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5__subsec_2__para_m",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5__subsec_2__para_n",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5__subsec_2__para_o"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Kuasa Institut hendaklah termasuk kuasa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk membuat kontrak;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memperoleh, membeli, mengambil, memegang dan menikmati tiap-tiap jenis harta alih dan harta tak alih;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memindahkan, menyerahhakkan, menyerahkan balik, memulangkan, menggadaikan, menggadai janji, mendemis, menyerahhakkan semula, memindahkan hakmilik atau selainnya melupuskan atau membuat apa-apa urusan dengan apa-apa harta alih atau harta tak alih dan apa-apa kepentingan dalam harta alih atau harta tak alih, yang terletak hak pada Institut;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mendapatkan dan menerima bagi maksud Institut apa-apa wang, tanah atau harta lain daripada mana-mana orang melalui pemberian, subsidi, derma, hadiah, langganan, endowmen atau selainnya, dan jika ia menerima mana-mana wang, tanah atau harta lain itu, menyampaikan kepada orang itu apa-apa konsesi atau faedah yang difikirkan patut oleh Institut;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memperoleh, memegang, melupuskan atau memberikan hak berkaitan dengan dapatan penyelidikan daripada apa-apa aktiviti penyelidikan dan pembangunan yang dijalankan oleh atau bagi Institut atau oleh mana-mana orang;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengusahakan, menyelaraskan atau memberikan kepada mana-mana orang untuk mengusahakan atau menyelaraskan aktiviti penyelidikan dan pembangunan yang berhubungan dengan perhutanan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menentukan keutamaan aktiviti penyelidikan dan pembangunan Institut dan meluluskan program tahunan penyelidikan dan anggaran perbelanjaan yang diperlukan untuk melaksanakan program, skim, projek dan aktiviti dan bagi pentadbiran Institut;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5__subsec_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memastikan bahawa program, skim, projek dan aktiviti yang diluluskan oleh Institut dijalankan dengan sewajarnya dan perbelanjaan yang dilakukan adalah mengikut anggaran perbelanjaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5__subsec_2__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengutip dan menerima apa-apa wang bagi perkhidmatan yang disediakan oleh Institut dan penggunaan kemudahannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5__subsec_2__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk membuat perundingan, perjanjian atau perkiraan yang difikirkan patut oleh Institut bagi pelaksanaan fungsinya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5__subsec_2__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menjalankan kursus atau latihan teknikal dan bukan teknikal dalam bidang perhutanan atau apa-apa bidang lain yang berkaitan dan untuk memberikan perakuan kepada orang yang telah mengikuti kursus atau latihan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5__subsec_2__para_l",
      "@type": "akn:paragraph",
      "eli:number": "l",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk berusaha sesama dengan mana-mana institusi atau organisasi di dalam atau di luar Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5__subsec_2__para_m",
      "@type": "akn:paragraph",
      "eli:number": "m",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menganugerahkan biasiswa, dermasiswa, pingat, hadiah dan bentuk kepujian, award atau bantuan lain kepada mana-mana orang berkenaan dengan kursus atau latihan teknikal dan bukan teknikal yang disebut dalam perenggan (k) dan usaha sama yang disebut dalam perenggan (l) atau mana-mana kursus pengajian atau program latihan yang dijalankan oleh mana-mana institusi pengajian tinggi, sama ada awam atau swasta, di dalam atau di luar Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5__subsec_2__para_n",
      "@type": "akn:paragraph",
      "eli:number": "n",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengusahakan dan menyelaraskan apa-apa aktiviti yang difikirkan perlu oleh Institut bagi maksud melindungi dan memajukan kepentingan hutan dan industri berasaskan hutan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5__subsec_2__para_o",
      "@type": "akn:paragraph",
      "eli:number": "o",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk melakukan semua perkara yang suai manfaat atau perlu atau bersampingan dengan pelaksanaan fungsinya dan penjalanan kuasanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Institut boleh mewakilkan mana-mana kuasanya di bawah Akta ini kepada Ketua Pengarah Institut. Cawangan dan pusat penyelidikan Institut"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_6__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Institut boleh menubuhkan cawangan atau pusat penyelidikan Institut di dalam atau di luar Malaysia bagi maksud melaksanakan peruntukan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Cawangan atau pusat penyelidikan itu hendaklah diketuai oleh pegawai yang dilantik oleh Ketua Pengarah daripada kalangan pegawai yang dilantik di bawah seksyen 17."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua cawangan atau ketua pusat penyelidikan hendaklah bertanggungjawab kepada Ketua Pengarah dan hendaklah melaksanakan apa-apa kewajipan sebagaimana yang diberikan kepadanya oleh Ketua Pengarah. Keanggotaan Institut"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_7__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_7__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_7__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_7__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_7__para_f",
