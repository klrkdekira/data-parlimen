      "schema:text": {
        "@language": "ms",
        "@value": "PERUNTUKAN PEMANSUHAN, PEMBUBARAN, KECUALIAN DAN PERALIHAN, DSB. Tafsiran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_VII__cl_45",
      "@type": "akn:clause",
      "eli:number": "45",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_VII__cl_45__para_a",
