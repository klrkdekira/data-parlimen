        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_7__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_7__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_7__para_k",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_7__para_l"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Institut hendaklah terdiri daripada anggota yang berikut yang hendaklah dilantik oleh Menteri:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang Pengerusi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang wakil Kementerian yang bertanggungjawab bagi perhutanan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_7__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang wakil Perbendaharaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_7__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang wakil Jabatan atau Unit yang bertanggungjawab bagi pembangunan sosioekonomi negara;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_7__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang wakil Kementerian yang bertanggungjawab bagi industri perladangan dan komoditi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_7__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang wakil Jabatan Perhutanan Semenanjung Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_7__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang wakil Kerajaan Negeri Sabah;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_7__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang wakil Kerajaan Negeri Sarawak;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_7__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang wakil Lembaga Perindustrian Kayu Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_7__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "dua orang wakil industri berasaskan hutan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_7__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak lebih daripada empat orang lain yang, pada pendapat Menteri, boleh menyumbang kepada penyelidikan dan pembangunan perhutanan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_7__para_l",
      "@type": "akn:paragraph",
      "eli:number": "l",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah. Tempoh jawatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II",
      "schema:name": {
        "@language": "ms",
        "@value": "Seseorang anggota Institut yang dilantik di bawah perenggan 7(a),"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "(j) atau (k) hendaklah, melainkan jika dia terlebih dahulu meletakkan atau mengosongkan jawatannya, memegang jawatan selama tempoh tidak melebihi dua tahun atas apa-apa syarat sebagaimana yang dinyatakan dalam surat cara pelantikannya dan dia hendaklah layak untuk dilantik semula. Anggota silih ganti"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_9__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_9__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana anggota Institut yang dilantik di bawah perenggan 7(b) hingga (i) boleh melantik anggota silih ganti untuk menghadiri mesyuarat Institut jika anggota Institut itu atas apa-apa sebab tidak dapat hadir."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila menghadiri mesyuarat Institut, anggota silih ganti hendaklah bagi segala maksud disifatkan sebagai anggota Institut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_9__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang anggota silih ganti hendaklah, melainkan jika dia terlebih dahulu mengosongkan jawatannya, terhenti menjadi anggota silih ganti apabila anggota yang berkenaan dengannya dia seorang anggota silih ganti meletakkan atau mengosongkan jawatannya. Penjalanan sementara fungsi Pengerusi"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_23",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_24",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_25",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_26",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_27",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_28"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "KEWANGAN Kumpulan Wang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_23__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_23__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_23__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_23__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud Akta ini, suatu kumpulan wang yang hendaklah dikenali sebagai “Kumpulan Wang Institut Penyelidikan Perhutanan Malaysia” ditubuhkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_23__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Kumpulan Wang itu hendaklah dikawal, disenggarakan dan dikendalikan oleh Institut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_23__subsec_3",
      "@type": "akn:subsection",
