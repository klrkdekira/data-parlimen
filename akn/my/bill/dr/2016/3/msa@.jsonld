        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_23__subsec_3__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_23__subsec_3__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_23__subsec_3__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_23__subsec_3__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_23__subsec_3__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_23__subsec_3__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_23__subsec_3__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_23__subsec_3__para_k"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Kumpulan Wang itu hendaklah terdiri daripada—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_23__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_23__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa jumlah wang sebagaimana yang diperuntukkan oleh Kerajaan Persekutuan atau mana-mana Kerajaan Negeri bagi maksud Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_23__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_23__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "wang yang dikutip di bawah seksyen 29;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_23__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_23__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "wang yang diagihkan sebagai dividen daripada syarikat yang ditubuhkan di bawah seksyen 30;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_23__subsec_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_23__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "fi, royalti dan balasan lain di bawah seksyen 31 dan 37 dan wang yang diperoleh daripada apa-apa hak harta intelek, syer, ekuiti dan perjanjian pelesenan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_23__subsec_3__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_23__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "wang yang diperoleh daripada fi kemasukan dan apa-apa fi atau caj lain bagi perkhidmatan yang disediakan oleh Institut dan penggunaan kemudahannya di bawah seksyen 32;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_23__subsec_3__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_23__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "wang yang dipinjam oleh Institut di bawah seksyen 33;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_23__subsec_3__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_23__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "wang yang diperoleh daripada pengendalian apa-apa program, skim, projek atau aktiviti yang dibiayai daripada Kumpulan Wang;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_23__subsec_3__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_23__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "wang yang diperoleh atau berbangkit daripada apa-apa jualan, pelupusan, pelaburan, gadai janji, pajakan, sewaan, gadaian atau debentur atau apa-apa urusan lain dengan mana-mana harta, yang diperoleh atau yang terletak hak pada Institut;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_23__subsec_3__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_23__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "wang daripada mana-mana sumber, sumbangan, endowmen, hadiah atau bekues sebagaimana yang dibuat kepada atau berpihak kepada Institut;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_23__subsec_3__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_23__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "derma dan sumbangan yang diterima daripada mana-mana kerajaan, badan atau organisasi di dalam atau di luar Malaysia; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_23__subsec_3__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_23__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "semua wang, jumlah wang atau harta lain yang dengan apa-apa cara menjadi kena dibayar kepada atau terletak hak pada Institut berkenaan dengan apa-apa perkara yang bersampingan dengan fungsinya dan kuasanya. Perbelanjaan hendaklah dipertanggungkan pada Kumpulan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_24__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_24__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_24__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_24__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_24__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_24__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_24__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_24__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_24__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_24__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_24__para_k"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV",
      "schema:name": {
        "@language": "ms",
        "@value": "Kumpulan Wang hendaklah dibelanjakan bagi maksud—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_24__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_24__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_24__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_24__para_a__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_24__para_a__subpara_iv",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_24__para_a__subpara_v"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "membayar apa-apa perbelanjaan yang dilakukan dengan sah oleh Institut, termasuk—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_24__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_24__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "elaun dan belanja lain anggota Institut atau mana-mana jawatankuasanya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_24__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_24__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "saraan pegawai dan pekhidmat Institut, termasuk pemberian pinjaman, biasiswa dan pendahuluan, faedah persaraan, ganjaran dan elaun;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_24__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_24__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "perlindungan insurans bagi pegawai dan pekhidmat Institut;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_24__para_a__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_24__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "kos yang ditanggung dalam memberikan bantuan bagi kebajikan pegawai dan pekhidmat Institut; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_24__para_a__subpara_v",
      "@type": "akn:subparagraph",
      "eli:number": "v",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_24__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "membayar apa-apa belanja, kos dan perbelanjaan lain berhubung dengan pemerolehan barang dan perkhidmatan, termasuk pengambilan perunding, fi dan kos guaman, dan fi dan kos lain;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_24__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "membiayai aktiviti penyelidikan dan pembangunan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_24__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "memberikan wang kepada mana-mana badan atau organisasi yang difikirkan suai manfaat oleh Institut untuk menjalankan aktiviti penyelidikan dan pembangunan, projek pembangunan atau aktiviti publisiti;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_24__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "menyumbang kepada mana-mana badan atau organisasi di dalam atau di luar Malaysia yang menggalakkan penyelidikan dan pembangunan dalam pembangunan hutan dan industri berasaskan hutan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_24__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "membiayai apa-apa biasiswa bagi pengajian tinggi, zamalah pembantu penyelidik, pemberian saintis, fellowship, pingat, hadiah dan bentuk kepujian lain, award atau bantuan bagi pegawai dan pekhidmat Institut yang sedang berkhidmat atau bakal berkhidmat;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_24__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "membayar apa-apa belanja, kos atau perbelanjaan lain yang dilakukan atau diterima dengan sewajarnya oleh Institut dalam pelaksanaan fungsinya atau penjalanan kuasanya di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_24__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "memenuhi belanja yang ditanggung oleh Institut dalam penubuhan cawangan atau pusat penyelidikan Institut;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_24__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "membeli atau menyewa kelengkapan, jentera dan apa-apa bahan lain, memperoleh tanah dan mendirikan bangunan, dan menjalankan apa-apa kerja atau pengusahaan lain dalam pelaksanaan fungsinya atau penjalanan kuasanya di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_24__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "memberikan pinjaman kepada atau mengadakan modal bagi syarikat yang ditubuhkan di bawah seksyen 30;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_24__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "membayar balik apa-apa wang yang dipinjam di bawah seksyen 33 dan bunga yang kena dibayar atas wang itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_24__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "secara amnya, membayar apa-apa belanja untuk melaksanakan peruntukan Akta ini. Pemeliharaan Kumpulan Wang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Menjadi kewajipan Institut untuk memelihara Kumpulan Wang dengan melaksanakan fungsinya dan menjalankan kuasanya di bawah Akta ini dengan sedemikian cara untuk memastikan bahawa jumlah hasil Institut mencukupi untuk membayar semua jumlah wang yang dipertanggungkan dengan sepatutnya pada akaun hasilnya, termasuk susut nilai dan bunga atas modal, dari setahun ke setahun. Perbelanjaan dan penyediaan anggaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_26__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_26__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_26__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_26__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_26__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbelanjaan Institut setakat apa-apa amaun yang dibenarkan oleh Menteri bagi mana-mana satu tahun hendaklah dibayar daripada Kumpulan Wang."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_26__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Sebelum mulanya bulan Jun setiap tahun, Institut hendaklah mengemukakan kepada Menteri suatu anggaran perbelanjaan (termasuk perbelanjaan bagi aktiviti penyelidikan dan pembangunan dan projek pembangunan) bagi tahun yang berikutnya dalam apa-apa bentuk dan yang mengandungi apa-apa butir sebagaimana yang diarahkan oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_26__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri hendaklah, sebelum permulaan bulan Disember tahun itu, memberitahu Institut amaun yang dibenarkan bagi perbelanjaan secara amnya atau amaun yang dibenarkan bagi setiap perihalan perbelanjaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_26__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Institut boleh, pada bila-bila masa, mengemukakan kepada Menteri suatu anggaran tambahan perbelanjaannya bagi mana-mana satu tahun dan Menteri boleh membenarkan keseluruhan atau mana-mana bahagian daripada perbelanjaan tambahan itu dimasukkan dalam anggaran tambahan. Kumpulan wang rizab"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Institut hendaklah menubuhkan dan menyenggarakan suatu kumpulan wang rizab dalam Kumpulan Wang. Akta Badan Berkanun (Akaun dan Laporan Tahunan) 1980"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Badan Berkanun (Akaun dan Laporan Tahunan) 1980 [Akta 240] hendaklah terpakai bagi Institut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_I",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Institut Penyelidikan Perhutanan Malaysia 2016. Tafsiran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_I__cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_I__cl_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_I__cl_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_I",
      "schema:name": {
        "@language": "ms",
        "@value": "Dalam Akta ini, melainkan jika konteksnya menghendaki makna yang lain—"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "“Akta yang dimansuhkan” ertinya Akta Lembaga Penyelidikan dan Pembangunan Perhutanan Malaysia 1985 [Akta 319] yang dimansuhkan di bawah subseksyen 46(1); “anggota Institut” ertinya anggota Institut yang dilantik di bawah seksyen 7 dan termasuklah anggota silih ganti yang dilantik di bawah seksyen 9; “dapatan penyelidikan” ertinya apa-apa hasil daripada apa-apa aktiviti penyelidikan dan pembangunan, dan termasuklah penemuan, rekaan, inovasi dan kemajuan dalam apa-apa proses, radas, mesin atau teknik; “hasil hutan” ertinya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_I__cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_I__cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "hasil dalam bentuk yang belum diproses atau telah diproses sebahagiannya, dan termasuklah kayu balak, kayu jaras, kayu api, kayu getah, batang dan gentian kelapa sawit dan sisanya, batang kelapa dan batang palma lain, kayu gaharu dan kayu lain yang berbau, gam, damar dan oleoresin, minyak kayu, daun, rotan, buluh, biji benih, kacang, pucuk, akar, mengkuang, tumbuhan ubatan, tumbuhan beraroma, tanih, mikroorganisma dan apa-apa jenis hasil lain yang seumpamanya sama ada sekarang atau pada masa hadapan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_I__cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_I__cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "hasil yang telah menjalani pemprosesan atau yang bentuknya telah diubah, dan termasuklah kayu gergaji, arang kayu, minyak pati, kayu serpai dan tatal kayu, kayu kisar, kayu terolah dan kayu kumai, papan lapis dan venir, papan partikel dan papan gentian, papan cantum, papan lamin dan hasil panel lain berasaskan kayu yang diubah suai, kayu pulpa, kertas dan hasil daripada kertas, kayu glu lam, tumbuhan kultur tisu, ekstrak kimia dan protein, bahan atau terbitan bagi penghasilan farmaseutikal, neutraseutikal, kosmeseutikal dan makanan fungsian dan hasil lain yang diproses atau diubah yang berasal daripada hasil sebagaimana yang dinyatakan dalam perenggan (a); dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_I__cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/3/msa@/~part_I__cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "hasil dalam bentuk yang telah siap, dan termasuklah atap, kayu landasan kereta api dan trem, perabot, kraftangan dan mainan daripada kayu, pemegang alat daripada kayu, cerucuk, pancang dan kayu pancang, bingkai gambar daripada kayu, kotak bungkusan daripada kayu, perkakas rumah daripada kayu, bakul, barang anyaman dan barang lain daripada anyaman, pensil dan hasil siap lain yang keseluruhannya atau sebahagiannya dibuat daripada hasil sebagaimana yang dinyatakan dalam perenggan (a) atau (b); “industri berasaskan hutan” ertinya semua industri yang terlibat dengan penuaian, pengekstrakan, pengujian, pemprosesan, pengilangan, pengawetan dan pengeringan hasil hutan, dan perkhidmatan berhubungan dengannya; “Institut” ertinya Institut Penyelidikan Perhutanan Malaysia yang terus wujud dan dengan pertukaran nama dalam bahasa Inggeris kepada “Forest Research Institute Malaysia” di bawah seksyen 3; “Ketua Pengarah” ertinya Ketua Pengarah yang dilantik di bawah seksyen 15; “Kumpulan Wang” ertinya Kumpulan Wang Institut Penyelidikan Perhutanan Malaysia yang ditubuhkan di bawah seksyen 23; “Menteri” ertinya Menteri yang dipertanggungkan dengan tanggungjawab bagi perhutanan; “pembangunan hutan” ertinya dasar dan aktiviti pengurusan dan pembangunan bagi semua hutan semula jadi dan buatan manusia berdasarkan prinsip ekologi dan sosioekonomi yang kukuh bagi maksud yang khusus untuk kedua-dua pengeluaran hasil hutan dan perlindungan alam sekitar; “pemuliharaan” ertinya melindungi sumber genetik, kepelbagaian spesies dan ekosistem, dan juga penggunaan mampan sumber biologi dan perkongsian faedah sumber biologi secara saksama bagi memenuhi keperluan dan aspirasi generasi masa kini dan akan datang; “Pengerusi” ertinya Pengerusi Institut yang dilantik di bawah perenggan 7(a) dan termasuklah mana-mana anggota Institut yang dilantik untuk melaksanakan fungsi Pengerusi di bawah seksyen 10."
      }
    },
