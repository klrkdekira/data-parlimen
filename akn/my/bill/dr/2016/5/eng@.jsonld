      "schema:text": {
        "@language": "en",
        "@value": "The Advocates Ordinance [Sabah Cap. 2], which is referred to as the “Ordinance” in this Act, is amended by inserting after the long title the following Part: “PART I PRELIMINARY” Amendment of section 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/5/eng@/~cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
