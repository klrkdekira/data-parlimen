      "schema:name": {
        "@language": "en",
        "@value": "Section 14 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/7/eng@/~cl_11__para_a",
