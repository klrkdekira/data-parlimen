      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/7/eng@/~cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (5)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/7/eng@/~cl_11__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/7/eng@/~cl_11__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words “The Land Administrator” the words “In addition to the award made under subsection 14(1), the Land Administrator”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/7/eng@/~cl_11__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/7/eng@/~cl_11__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words “imposed by the valuer” the words “prescribed by rules”. New section 19a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/7/eng@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/7/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting after section 19 the following section: “Enquiry and award by the Land Administrator pursuant to Certificate of Urgency 19a. (1) Notwithstanding that possession of the land has been taken pursuant to a Certificate of Urgency issued under section 19, the Land Administrator shall continue to make full enquiry and make an award in accordance with the provisions of this Act. (2) Where the possession of the land has been taken under section 19, subsection 8(4) shall not be applicable if the Land Administrator has not made an award under subsection 14(1) within the said period of two years.”. Amendment of section 21"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/7/eng@/~cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/7/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraph 21(2)(a) of the principal Act is amended by deleting the word “competent”. Amendment of section 22"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/7/eng@/~cl_14",
      "@type": "akn:clause",
