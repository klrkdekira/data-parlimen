      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/7/eng@/~cl_15__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/7/eng@/~cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting the words “or (3)”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/7/eng@/~cl_15__para_b",
