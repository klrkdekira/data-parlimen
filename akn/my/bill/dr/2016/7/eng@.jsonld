      "schema:text": {
        "@language": "en",
        "@value": "by inserting after paragraph (b) the following paragraph: “(c) the statutory body, person or corporation referred to in paragraph 23(a), and the management corporation in respect of a subdivided building or land.”. Amendment of section 23"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/7/eng@/~cl_15",
