      "schema:text": {
        "@language": "en",
        "@value": "by renumbering the existing section as subsection (1); and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/7/eng@/~cl_17__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/7/eng@/~cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (1) as renumbered the following subsection: “(2) For the purpose of subsection (1), the difference specified shall not exceed one quarter of a hectare or one per centum of the area of scheduled land as published in the Gazette under subsection 8(1), whichever is the greater, and such difference shall not be necessary for any further declaration to be made and published.”. Amendment of section 29"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/7/eng@/~cl_18",
      "@type": "akn:clause",
