      "schema:text": {
        "@language": "en",
        "@value": "in subsection (1), by deleting the words “under his hand”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/7/eng@/~cl_11__para_b",
