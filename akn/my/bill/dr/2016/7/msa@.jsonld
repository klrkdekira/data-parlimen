      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1), dengan memotong perkataan “under his hand”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/7/msa@/~cl_11__para_b",
      "@type": "akn:paragraph",
