      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 23 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/7/msa@/~cl_15__para_a",
