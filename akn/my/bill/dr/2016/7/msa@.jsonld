      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 12 Akta ibu dipinda dengan memasukkan selepas subseksyen (3) subseksyen yang berikut: “(4) The Land Administrator shall record all the evidence during the enquiry.”. Pindaan seksyen 14"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/7/msa@/~cl_11",
