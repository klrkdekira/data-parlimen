        "@value": "Seksyen 28 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/7/msa@/~cl_17__para_a",
      "@type": "akn:paragraph",
