      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 14 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/7/msa@/~cl_11__para_a",
      "@type": "akn:paragraph",
