      "schema:text": {
        "@language": "ms",
        "@value": "Akta Pengambilan Tanah 1960 [Akta 486], yang disebut “Akta ibu” dalam Akta ini, dipinda dalam subseksyen (2)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/7/msa@/~cl_20",
