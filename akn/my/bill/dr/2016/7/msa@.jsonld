      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan “or (3)”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/7/msa@/~cl_15__para_b",
