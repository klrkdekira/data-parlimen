      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/7/msa@/~cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan (b) perenggan yang berikut: “(ba) prescribe any Form in the Second Schedule in electronic form;”; dan"
