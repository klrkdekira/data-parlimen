      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 29(1) Akta ibu dipinda dengan memasukkan selepas perkataan “Form H” perkataan “, Form Lc or Form R”. Pindaan seksyen 29a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/7/msa@/~cl_19",
