      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 31 Akta ibu dipinda dengan memasukkan selepas perkataan “in any scheduled land” perkataan “or under Part VII”. Pindaan seksyen 32"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/7/msa@/~cl_21",
      "@type": "akn:clause",
