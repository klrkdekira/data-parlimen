      "schema:text": {
        "@language": "ms",
        "@value": "dalam subperenggan (1)(2d), dengan menggantikan perkataan “within the meaning of section 214a of the National Land Code [Act 56 of 1965], the market value shall not in any way be affected by the fact that it can be sold to one person” dengan perkataan “, the market value of such land shall be determined taking into consideration section 214a of the National Land Code”. Kecualian dan peralihan"
      }
