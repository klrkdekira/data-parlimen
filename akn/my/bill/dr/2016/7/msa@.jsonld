      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (1)(a), dengan memasukkan selepas perkataan “Form H” perkataan “, Form Lc or Form R”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/7/msa@/~cl_19__para_c",
      "@type": "akn:paragraph",
