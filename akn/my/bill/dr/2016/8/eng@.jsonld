    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/8/eng@/~cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/8/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 241 of the Code is amended by inserting after subsection (4) the following subsections: “(5) Subject to subsection (3), a charge in respect of alienated land or any lease of alienated land may be created in favour of a financial institution notwithstanding that such institution having beneficial rights pursuant to any transaction contracted in compliance with Syariah. (6) For the purpose of subsection (5), the financial institution shall be those institutions licensed under any written law relating to financial institutions or development financial institutions.”. Amendment of section 254"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/8/eng@/~cl_3__para_a",
