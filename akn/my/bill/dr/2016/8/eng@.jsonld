      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the words “section 211” the words “notwithstanding that the provisions dealt with dealings in alienated land,”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/8/eng@/~cl_45__para_b",
