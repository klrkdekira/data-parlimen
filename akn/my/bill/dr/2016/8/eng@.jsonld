      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/8/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The National Land Code [Act No. 56 of 1965], which is referred to as the “Code” in this Act, is amended in section 5—"
      }
    },
