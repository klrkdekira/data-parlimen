      "eli:number": "20",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/8/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 101 of the Code is amended by inserting after subsection (6) the following subsections: “(7) Notwithstanding the operation of Part IVa of the Strata Titles Act 1985, this section shall also apply to land with subdivided building in accordance to section 96a. (8) The rent of the land with subdivided building shall become payable only upon the termination of subdivision in accordance with Part IVa of the Strata Titles Act 1985.”. Amendment of section 122"
      }
