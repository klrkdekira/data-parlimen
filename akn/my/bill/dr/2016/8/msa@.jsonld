      "@type": "akn:clause",
      "eli:number": "80",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/8/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 434(2) Kanun dipinda dengan menggantikan perkataan “Arbitration Act 1952 [Act 93]” dengan perkataan “Arbitration Act 2005 [Act 646]”. Pindaan seksyen 436a"
      }
