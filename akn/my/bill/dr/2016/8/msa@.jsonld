      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (5), dengan menggantikan perkataan “which contains a note under subsection (2)” dengan perkataan “and subsidiary register, which contain a note under subsection (2) or (2a), as the case may be,”. Pindaan seksyen 160c"
      }
    },
