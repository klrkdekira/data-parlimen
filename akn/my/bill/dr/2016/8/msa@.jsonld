      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 281(1) Kanun dipinda dengan memotong perkataan “for a loan”. Seksyen baharu 292a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/8/msa@/~cl_42",
