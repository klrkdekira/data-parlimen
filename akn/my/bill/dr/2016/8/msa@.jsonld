      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/8/msa@/~cl_18__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/8/msa@/~cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan “within the State”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/8/msa@/~cl_18__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/8/msa@/~cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “as may be prescribed” perkataan “or through any person or body as approved by the State Authority”. Seksyen baharu 96a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/8/msa@/~cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/8/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Kanun dipinda dengan memasukkan selepas seksyen 96 seksyen yang berikut: “Rent of land with subdivided building 96a. (1) Upon the coming into operation of Part IVa of the Strata Titles Act 1985, the provisions of Part Six of this Act except section 101 (which relates to revision of rent), shall not be applicable in respect of land with subdivided building and any action taken for non-payment thereof shall be in accordance with the Strata Titles Act 1985. (2) The application of section 101 in respect of land with subdivided building shall be in accordance with the provision of subsection 101(7). (3) In the event of termination of the subdivided building in accordance with section 57 of the Strata Titles Act 1985, the rent in respect of the land shall become payable as from the beginning of the calendar year next following in accordance with this Act.”. Pindaan seksyen 101"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/8/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/8/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Kanun Tanah Negara (Pindaan) 2016."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/8/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/8/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa di setiap Negeri pada tarikh yang ditetapkan oleh Menteri, dengan kelulusan Majlis Tanah Negara, melalui pemberitahuan dalam Warta Persekutuan, dan Menteri boleh, dengan kelulusan Majlis Tanah Negara, menetapkan tarikh yang berlainan bagi permulaan kuat kuasa peruntukan yang berlainan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/8/msa@/~cl_1__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/8/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa di Wilayah Persekutuan Kuala Lumpur, Wilayah Persekutuan Putrajaya dan Wilayah Persekutuan Labuan pada tarikh yang ditetapkan oleh Menteri, melalui pemberitahuan dalam Warta Persekutuan, dan Menteri boleh menetapkan tarikh yang berlainan bagi permulaan kuat kuasa peruntukan yang berlainan Akta ini. Pindaan seksyen 5"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/8/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/8/msa@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/8/msa@/~cl_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/8/msa@/~cl_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/8/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Kanun Tanah Negara [Akta No. 56 tahun 1965], yang disebut “Kanun” dalam Akta ini, dipinda dalam seksyen 5—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/8/msa@/~cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/8/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 101 Kanun dipinda dengan memasukkan selepas subseksyen (6) subseksyen yang berikut: “(7) Notwithstanding the operation of Part IVa of the Strata Titles Act 1985, this section shall also apply to land with subdivided building in accordance to section 96a. (8) The rent of the land with subdivided building shall become payable only upon the termination of subdivision in accordance with Part IVa of the Strata Titles Act 1985.”. Pindaan seksyen 122"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/8/msa@/~cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/8/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan 122(d) Kanun dipinda dengan memasukkan selepas perkataan “the use” perkataan “or uses”. Pindaan seksyen 124"
      }
    },
