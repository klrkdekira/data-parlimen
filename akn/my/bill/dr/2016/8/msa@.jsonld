      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (1) subseksyen yang berikut: “(1a) For the purpose of subsection (1), the Registrar may register and issue document of qualified title first before its continuation into final title where it appears just and expedient.”; dan"
      }
    },
