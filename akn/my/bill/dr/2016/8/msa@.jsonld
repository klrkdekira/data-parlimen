      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan 254(1)(b) Kanun dipinda dengan memasukkan selepas perkataan “in the charge” perkataan “which shall not be less than one month”. Pindaan seksyen 281"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/8/msa@/~cl_41",
