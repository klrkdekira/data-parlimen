      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/8/msa@/~cl_82",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua permohonan atau perkara lain yang masih menunggu kelulusan atau pendaftaran atau selainnya di bawah seksyen 204b, 323, 324 dan 326, sebaik sebelum permulaan kuat kuasa Akta ini hendaklah, selepas permulaan kuat kuasa Akta ini, diteruskan atau diselesaikan seolah-olah Kanun Tanah Negara tidak dipinda oleh Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/8/msa@/~cl_82__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/8/msa@/~cl_82",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana perintah atau prosiding yang masih belum selesai atau dimulakan di bawah seksyen 214a, 400, 400a, 403, 422, 423, 424, 425, 425a, 426, 427, 428, 428a dan 429b, sebelum permulaan kuat kuasa Akta ini, hendaklah diteruskan dan diselesaikan seolah-olah Kanun Tanah Negara tidak dipinda oleh Akta ini."
      }
    },
