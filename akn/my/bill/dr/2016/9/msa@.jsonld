      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 9a Akta ibu dipinda dengan memotong perkataan “, yang merupakan bangunan atau tanah yang boleh dipecahbahagikan mengikut subseksyen 6(1) atau (1a),”. Pindaan seksyen 10"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/9/msa@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/9/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 10(2) Akta ibu dipinda dengan memasukkan selepas perkataan “pecah bahagi mana-mana bangunan” perkataan “atau tanah”. Pindaan seksyen 17"
      }
    },
