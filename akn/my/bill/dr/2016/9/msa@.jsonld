      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (6)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/9/msa@/~cl_26__para_e__subpara_i",
