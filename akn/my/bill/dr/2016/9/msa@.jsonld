      "schema:text": {
        "@language": "ms",
        "@value": "dalam nota bahu, dengan memasukkan selepas perkataan “bangunan” perkataan “atau tanah”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/9/msa@/~cl_25__para_b",
      "@type": "akn:paragraph",
