      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1), dengan memasukkan selepas perkataan “bangunan” perkataan “atau tanah”. Pindaan seksyen 57"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/9/msa@/~cl_26",
