        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/9/msa@/~cl_26__para_e__subpara_i__subpara_B"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/9/msa@/~cl_26__para_e",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (a)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/9/msa@/~cl_26__para_e__subpara_i__subpara_A",
      "@type": "akn:subparagraph",
      "eli:number": "A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/9/msa@/~cl_26__para_e__subpara_i",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “menggulungkan” dengan perkataan “menyelesaikan”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/9/msa@/~cl_26__para_e__subpara_i__subpara_B",
      "@type": "akn:subparagraph",
      "eli:number": "B",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/9/msa@/~cl_26__para_e__subpara_i",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan “dan” selepas perkataan “dari wujud;”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/9/msa@/~cl_26__para_e__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/9/msa@/~cl_26__para_e",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan (a) perenggan yang berikut: “(aa) memberitahu Pendaftar suatu tarikh perbadanan pengurusan itu hendaklah terhenti kewujudannya; dan”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/9/msa@/~cl_26__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "hasPart": [
