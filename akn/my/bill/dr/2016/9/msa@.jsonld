      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 56 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2016/9/msa@/~cl_25__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
