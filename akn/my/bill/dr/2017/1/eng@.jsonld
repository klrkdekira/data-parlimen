      "schema:text": {
        "@language": "en",
        "@value": "Subsection 20a(1) of the principal Act is amended by substituting for the word “four” the word “forty”. Amendment of section 28"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/1/eng@/~cl_11",
      "@type": "akn:clause",
