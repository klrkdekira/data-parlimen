      "schema:text": {
        "@language": "en",
        "@value": "in subsections (1) and (2), by substituting for the words “limits of error” the words “maximum permissible errors”."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/1/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/1/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Weights and Measures (Amendment) Act 2017. (2) Except for paragraphs 2(a) and 11(b) and sections 12 and 13, this Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Amendment of section 12"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/1/eng@/~cl_2",
      "@type": "akn:clause",
