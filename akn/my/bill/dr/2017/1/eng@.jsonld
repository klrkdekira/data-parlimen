      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/1/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Weights and Measures Act 1972 [Act 71], which is referred to as the “principal Act” in this Act, is amended in section 12—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/1/eng@/~cl_2__para_a",
