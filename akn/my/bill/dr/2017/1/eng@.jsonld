      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the shoulder note the following shoulder note: “Maximum permissible errors”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/1/eng@/~cl_13__para_b",
