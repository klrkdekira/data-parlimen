      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (a), by substituting for the word “complainant” the word “victim”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/10/eng@/~cl_12__para_b",
      "@type": "akn:paragraph",
