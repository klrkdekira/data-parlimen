      "schema:text": {
        "@language": "en",
        "@value": "Subsection 17a(4) of the principal Act is amended by substituting for the word “applicant” the word “victim”. Amendment of section 19"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/10/eng@/~cl_15",
