      "schema:text": {
        "@language": "ms",
        "@value": "Kanun dipinda dalam seksyen 377c dengan menggantikan perkataan “shall also be liable to” dengan perkataan “shall also be punished with”. Pindaan seksyen 377ca"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/11/msa@/~cl_9",
