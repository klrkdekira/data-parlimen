      "schema:text": {
        "@language": "ms",
        "@value": "dalam nota bahu, dengan memasukkan selepas perkataan “object” perkataan “, etc.”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/11/msa@/~cl_9__para_b",
