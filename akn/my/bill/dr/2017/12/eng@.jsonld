      ],
      "schema:name": {
        "@language": "en",
        "@value": "Tourism Tax Bill 2017"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_I",
      "@type": "akn:part",
