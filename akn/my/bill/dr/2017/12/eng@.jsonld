      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII",
      "@type": "akn:part",
      "eli:number": "VIII",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_39",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_40",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_41",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_42",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_43",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_44",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_45",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_46",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_47",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_48"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "OFFENCES AND PENALTIES Penalty for obstructing, etc., officer of customs"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_39__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_39__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII",
      "schema:name": {
        "@language": "en",
        "@value": "Any person who—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_39__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_39",
      "schema:text": {
        "@language": "en",
        "@value": "in any way assaults, hinders or obstructs the officer of customs in the performance of his duties under this Act; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_39__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_39",
      "schema:text": {
        "@language": "en",
        "@value": "fails to give reasonable facilities or assistance to any officer of customs in the performance of his duties under this Act, commits an offence and shall, on conviction, be liable to imprisonment for a term not exceeding three years or to a fine not exceeding fifty thousand ringgit or to both. Penalty for incorrect return"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_40__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_40__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who makes an incorrect return or gives any incorrect information in relation to any matter affecting his liability to collect tourism tax or the tourism tax collected commits an offence and shall, on conviction, be liable—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_40__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "to a fine not exceeding thirty thousand ringgit or to imprisonment for a term not exceeding one year or to both; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_40__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "where the offence relates to tourism tax undercharged, to a penalty equal to the amount of tourism tax which has been undercharged or would have been so undercharged if the return or information had been accepted as correct. Penalty for collecting tourism tax by person not liable to collect tourism tax"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_41",
      "@type": "akn:clause",
      "eli:number": "41",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_41__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_41__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_41__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall collect from any person any sum of money for the purpose of paying tourism tax charged and levied under this Act in respect of any accommodation provided by him or on his behalf unless he is liable under this Act to collect the tourism tax."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_41__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) commits an offence and shall, on conviction, be liable to a fine not exceeding thirty thousand ringgit or to imprisonment for a term not exceeding one year or to both. Penalty for evasion of tourism tax, fraud"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_42",
      "@type": "akn:clause",
      "eli:number": "42",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_42__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_42__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_42__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_42__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_42__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_42__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_42__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_42__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_42__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_42__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who with intent to evade or to assist any other person to evade tourism tax—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_42__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_42__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "omits from a return any information in relation to any matter affecting his liability to collect tourism tax or the amount of the tourism tax collected;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_42__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_42__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "makes any false statement or false entry in any return furnished, or claim or application made, under this Act or the regulations made under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_42__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_42__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "gives any false answer whether in writing or otherwise to any question asked or request for information made in accordance with the provisions of this Act or the regulations made under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_42__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_42__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "prepares or maintains, or authorizes the preparation or maintenance of, any false books of accounts, false invoices or other false records, or falsifies or authorizes the falsification of any books of accounts, invoices or records; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_42__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_42__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "makes, uses or authorizes the use of any fraud, artifice or contrivance, commits an offence and shall, on conviction, be liable to a fine not exceeding thirty thousand ringgit or to imprisonment for a term not exceeding one year or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_42__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "Where in any proceedings under this section it is proved that a false statement or false entry, whether by omission or otherwise, has been made in any return furnished, or claim or application made, under this Act or the regulations made under this Act, by or on behalf of any person or in any books of accounts, invoices or other records maintained by or on behalf of any person, that person shall be presumed until the contrary is proved to have made that false statement or false entry with intent to evade tourism tax."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_42__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_42__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_42__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_42__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "Any reference in this section to a person who makes, uses or authorizes the use of any fraud, artifice or contrivance to evade tourism tax includes a reference to a person who, without the authority of the Director General or a senior officer of customs—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_42__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_42__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "destroys, damages, erases, alters or manipulates data stored in, or used in connection with, a computer;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_42__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_42__subsec_3__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_42__subsec_3__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_42__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "introduces into, or records or stores in, a computer by any means data for the purpose of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_42__subsec_3__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_42__subsec_3__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "destroying, damaging, erasing, altering or manipulating data stored in, or used in connection with, a computer; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_42__subsec_3__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_42__subsec_3__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "interfering with, interrupting or obstructing the lawful use of the computer, or the data stored in, or used in connection with, a computer; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_42__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_42__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "otherwise uses a computer, the purpose or effect of which is to evade tourism tax."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_42__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of subsection (3), “data” includes any computer programme or part of a computer programme. Penalty for refusing to answer question or giving false information"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_43",
      "@type": "akn:clause",
      "eli:number": "43",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_43__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_43__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_43__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who, being required under this Act to give any information which may reasonably be required by the officer of customs which it is in his power to give, refuses to give the information or furnishes as true the information which he knows or has reason to believe to be false commits an offence and shall, on conviction, be liable to a fine not exceeding thirty thousand ringgit or to imprisonment for a term not exceeding one year or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_43__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "When any of the information is proved to be untrue or incorrect in whole or in part, it shall be no defence to allege that the information or any part of the information was furnished inadvertently or without criminal or fraudulent intent, or was misinterpreted or not fully interpreted by an interpreter provided by the informant. Attempts and abetments"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_44",
      "@type": "akn:clause",
      "eli:number": "44",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who attempts to commit an offence punishable under this Act, or abets the commission of the offence, shall be punishable with the punishment provided for the offence. General penalty"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_45",
      "@type": "akn:clause",
      "eli:number": "45",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who commits an offence under this Act or the regulations made under this Act for which no penalty is expressly provided shall, on conviction, be liable to a fine not exceeding thirty thousand ringgit or to imprisonment for a term not exceeding one year or to both. Offence by body of person, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_46",
      "@type": "akn:clause",
      "eli:number": "46",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII",
      "schema:text": {
        "@language": "en",
        "@value": "Where an offence under this Act or the regulations made under this Act has been committed by a company, a firm, a society, an association or other body of persons, any person who at the time of the commission of the offence was a director, partner, manager, secretary or other similar officer of the company, firm, society, association or other body of persons or was purporting to act in any such capacity or was in any manner or to any extent responsible for the management of any of the affairs of the company, firm, society, association or other body of persons or was assisting in such management, shall be deemed to be guilty of the offence unless he proves that the offence was committed without his knowledge, consent or connivance and that he had exercised due diligence to prevent the commission of the offence as he ought to have exercised, having regard to the nature of his functions in that capacity and to all the circumstances. Offence by employee or agent"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_47",
      "@type": "akn:clause",
      "eli:number": "47",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_47__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_47__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_47__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_47",
      "schema:text": {
        "@language": "en",
        "@value": "Where any person would be liable under this Act to any punishment or penalty for any act, omission, neglect or default, he shall be liable to the same punishment or penalty for every such act, omission, neglect or default of any employee or agent of his or of the employee of such agent, if such act, omission, neglect or default was committed by the employee of the person in the course of his employment, or by the agent when acting on behalf of the person, or by the employee of such agent in the course of his employment by such agent or otherwise on behalf of the agent."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_47__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_47",
      "schema:text": {
        "@language": "en",
        "@value": "Nothing under subsection (1) shall absolve an agent, officer or employee from any liability for an offence. Tourism tax, etc., to be payable notwithstanding any proceedings, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII__cl_48",
      "@type": "akn:clause",
      "eli:number": "48",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VIII",
      "schema:text": {
        "@language": "en",
        "@value": "The institution of proceedings or the imposition of a penalty, fine or term of imprisonment under this Act or the compounding of an offence under section 56 shall not relieve any person from the liability to pay for tourism tax, penalty, surcharge or other money under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this Act, a senior officer of customs shall have all the powers of a police officer of whatever rank as provided for under the Criminal Procedure Code [Act 593] in relation to enforcement, inspection and investigation, and such powers shall be in addition to the powers provided for under this Act and not in derogation thereof. Access to place, premises, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_33__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_33__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_33__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_33__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_33__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "Any senior officer of customs shall for the purposes of this Act at all times have full and free access to any place or premises where any person carries on the business relating to the operation of accommodation premises."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_33__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "Where any senior officer of customs exercises his powers under subsection (1), the person who operates the accommodation premises or any other person present at such place or premises at that time of entry shall provide to the senior officer of customs all reasonable facilities and assistance for the exercise of his duties under this section."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_33__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_33__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_33__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_33__subsec_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_33__subsec_3__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_33__subsec_3__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "Where any senior officer of customs enters upon any place or premises in accordance with this section, he may—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_33__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_33__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "require the operator or any other person to produce any book, data, document or other record or thing which relates to the operator’s business and any record which is required to be kept under section 17;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_33__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_33__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "examine any book, data, document or other record or thing;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_33__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_33__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "seize and detain any book, data, document or other record or thing if in his opinion it may afford evidence of the commission of any offence under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_33__subsec_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_33__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "require the person to answer any question relating to any book, data, document or other record or thing; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_33__subsec_3__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_33__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "make copies or extracts of any document, if he deems necessary."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_33__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who refuses to permit any senior officer of customs to enter upon any place or premises in accordance with this section commits an offence and shall, on conviction, be liable to a fine not exceeding thirty thousand ringgit or to imprisonment for a term not exceeding one year or to both. Access to recorded information or computerized data"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_34",
      "@type": "akn:clause",
      "eli:number": "34",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_34__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_34__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_34__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_34__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "Any officer of customs exercising his powers under this Part shall be given access to any recorded information or computerized data, whether stored in a computer or otherwise."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_34__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_34__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_34__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "In addition, an officer of customs exercising his powers under this Part—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_34__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_34__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "may inspect and check the operation of any computer and any associated apparatus or material which the officer of customs has reasonable cause to suspect is or has been used in connection with that information or data; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_34__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_34__subsec_2__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_34__subsec_2__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_34__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "may require—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_34__subsec_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_34__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "the person by whom or on whose behalf the officer of customs has reasonable cause to suspect the computer is or has been so used; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_34__subsec_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_34__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "the person having charge of, or is otherwise concerned with, the operation of the computer, apparatus or material, to provide the officer of customs with such reasonable assistance as he may require for the purposes of this"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_34__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of subsection (1), “access” includes being provided with the necessary password, encryption code, decryption code, software or hardware and any other means required to enable comprehension of recorded information or computerized data. Magistrate may issue search warrant"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_35",
      "@type": "akn:clause",
      "eli:number": "35",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_35__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_35__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_35__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_35__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_35__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "Whenever it appears to any Magistrate, upon written information upon oath and after any inquiry which he may think necessary, that there is reasonable cause to believe that in any place or premises, there are concealed or deposited any books, data, documents or other records or thing which may afford evidence of the commission of an offence under this Act, the Magistrate may issue a warrant authorizing any officer of customs named therein, at any time and with or without assistance—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_35__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_35__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to enter the place or premises and to search for and seize the books, data, documents or other records or thing; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_35__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_35__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to arrest any person being in the place or premises in whose possession the books, data, documents or other records or thing are found or who may reasonably be suspected as having concealed or deposited such books, data, documents or other records or thing."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_35__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_35__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_35__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_35__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "The officer of customs authorized under subsection (1) may, if it is necessary so to do—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_35__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_35__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "break open any outer or inner door of the place or premises and enter every part thereof, if necessary forcibly;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_35__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_35__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "remove by force any obstruction to the entry to search or to seize as he is empowered to effect; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_35__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_35__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "detain every person found in the place or premises until the search has been completed. Search may be made without warrant"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_36",
      "@type": "akn:clause",
      "eli:number": "36",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "Whenever it appears to the senior officer of customs that there is reasonable cause to believe that in any place or premises, there are concealed or deposited any books, data, documents or other records or thing which may afford evidence of commission of an offence under this Act and if he has reasonable grounds for believing that by reason of the delay in obtaining a search warrant the books, data, documents or other records or thing are likely to be removed, he may exercise in, upon and in respect, of the place or premises all the powers under section 35 in the same manner as if he were empowered so to do by a warrant issued under that section. Seizure of books, documents, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_37",
      "@type": "akn:clause",
      "eli:number": "37",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_37__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_37__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_37__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_37__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "All books, data, documents or other records or thing in respect of which the officer of customs has reasonable cause to suspect that there has been committed any offence under this Act or any violation of any of the provisions of this Act and any receptacle, package or conveyance in which the books, data, documents or other records or thing may have been found or which has been used in connection with the offence or violation, and any other book, data, document or other record or thing which may reasonably be believed to have a bearing on the case, may be seized by any officer of customs."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_37__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "Whenever any books, data, documents or other records or thing are seized under this Act, the officer of customs shall forthwith give notice in writing of the seizure and the grounds thereof to the owner of the books, data, documents or other records or thing, if known, either by delivering the notice to him personally or by posting the notice at his place of abode, if known."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_37__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "The provision of this section relating to the seizure of any books, data, documents or other records or thing shall apply to all the contents of any receptacle, package or conveyance in which the books, data, documents or other records or thing are found and to any article used to conceal the books, data, documents or other records or thing. Power of arrest"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_38__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_38__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_38__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_38__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_38__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_38__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_38__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_38__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_38__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_38__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "Any officer of customs may arrest without warrant—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_38__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_38__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any person found committing or attempting to commit or employing or aiding any person to commit or abetting the commission of an offence under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_38__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_38__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any person whom he may reasonably suspect to have in his possession any books, data, documents or other records or things liable to seizure under this Act; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_38__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_38__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any person whom he may reasonably suspect to have committed an offence under this Act, and the officer of customs may search or cause to be searched any person so arrested."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_38__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_38__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_38__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_38__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_38__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_38__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "any person so arrested by an officer of customs who requests that his person be searched in the presence of a senior officer of customs shall not be searched except in the presence of and under the supervision of the senior officer of customs, but that person may be detained until the arrival of the senior officer of customs, or taken to any office or police station where the senior officer of customs may be found;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_38__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_38__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the belonging of any person who requests to be present when it is searched and so presents himself within a reasonable time shall not be searched except in his presence; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_38__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_38__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "no person shall be searched except by another person of the same gender, and such search shall be conducted with strict regard to decency."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_38__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "Any officer of customs making an arrest under subsection (1) shall, without unnecessary delay, bring the person arrested to the nearest police station, and thereafter the person shall be dealt with in accordance with the law relating to criminal procedure for the time being in force."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_38__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "If any person liable to be arrested under this Act is not arrested at the time of committing the offence for which he is so liable, or after arrest makes his escape, he may at any time thereafter be arrested and dealt with as if he had been arrested at the time of committing the offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_38__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_38__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_38__subsec_5__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_38__subsec_5__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "Every person so arrested may be released from custody—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_38__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_38__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "on his depositing such reasonable sum of money as the senior officer of customs may require;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_38__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_38__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "on his executing a bond with such surety as the senior officer of customs may require; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_38__subsec_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_38__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "on his depositing such reasonable sum of money as the senior officer of customs may require and his executing a bond with such surety as the senior officer of customs may require."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_38__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_38__subsec_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_38__subsec_6__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who has been released from custody under subsection (5) may be arrested without warrant by any officer of customs—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_38__subsec_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_38__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "if the officer of customs has reasonable grounds for believing that any condition on or subject to which such person was released or otherwise admitted to bail has been or is likely to be breached; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_38__subsec_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VII__cl_38__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "on being notified in writing by the surety of such person that such person is likely to breach any condition on or subject to which such person was released and that the surety wishes to be relieved of his obligation as surety."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_21__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_21__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_21__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_21__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may remit the whole or any part of the tourism tax due and payable under this Act where he deems fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_21__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General may remit the whole or any part of the penalty, surcharge or other money payable under this Act where he deems fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_21__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "Where a person who has been granted remission under subsection (1) or (2) has paid any tourism tax, penalty, surcharge or other money to which the remission relates, he shall be entitled to a refund of the amount of the tourism tax, penalty, surcharge or other money paid. Refund of tourism tax, etc., overpaid or erroneously paid"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_22__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_22__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_22__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_22__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_22__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_22__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who has overpaid or erroneously paid any tourism tax, penalty, surcharge or any other money may make a claim thereof in the prescribed form to the Director General within six years from the time the overpayment or erroneous payment occurred."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_22__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "Upon receipt of the application under subsection (1), the Director General may refund the tourism tax, penalty, surcharge or any other money, as the case may be, after being satisfied that the person has properly established the claim."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_22__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General may reduce or disallow any refund claimed under this section to the extent that the refund would unjustly enrich the person referred to in subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_22__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "A claim under this section shall be supported by such evidence as required by the Director General."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_22__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "This section shall not apply to a claim for refund under section 8. Refund for bad debt"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_23__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_23__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_23__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_23__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_23__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_23__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_23__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_23__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_23__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_23__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subsection (2), any operator who ceases or has ceased to operate accommodation premises may make a claim to the Director General for a refund of the whole or any part of the tourism tax paid by the operator if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_23__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_23__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the whole or any part of the payment for accommodation payable to such operator has been written off in the operator’s accounts as bad debts; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_23__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_23__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Director General is satisfied that all reasonable efforts have been made by such operator to recover the payment for accommodation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_23__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection (1) shall not apply where part of payment for accommodation payable received by the operator is equal to or more than the tourism tax paid."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_23__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "Where the operator referred to in subsection (1) has not received any payment for accommodation payable to the operator, the Director General may allow such refund to be made to the operator."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_23__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "Where a claim for refund is made in relation to part of payment for accommodation being written off, the amount of tourism tax refundable shall be the difference between the tourism tax paid and the payment for accommodation received."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_23__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_23__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_23__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "Where a refund of tourism tax has been made under this section by the Director General to an operator and any payment in respect of the accommodation for which the tourism tax is payable is subsequently received by the operator, the operator shall repay to the Director General—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_23__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_23__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "the whole of the tourism tax refunded if the amount subsequently received in respect of the accommodation provided is equal to or more than the amount of the tourism tax refunded; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_23__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_23__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "an amount equal to the amount subsequently received in respect of the accommodation provided if the amount received is less than the amount of the tourism tax refunded."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_23__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection (5) shall apply in respect of any part payment received after the repayment made pursuant to paragraph (5)(b) so long as the total payment subsequently received does not exceed the amount of tourism tax refunded and the reference to “the amount of the tourism tax refunded” in paragraphs (5)(a) and (b) shall be construed as the reference to “the remaining amount of the tourism tax refunded”."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_23__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "For the purpose of this section, “bad debt” means the outstanding amount for the payment for accommodation including tourism tax which is payable to the operator but has not been paid to, and is irrecoverable by, the operator. Deduction from return of refunded tourism tax"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_24__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_24__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_24__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_24__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_24__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General may approve, subject to such conditions as he deems fit to impose, an application by any operator to deduct from time to time from the operator’s return referred to in subsection 19(1) the amount of tourism tax paid but subsequently refunded to the tourist by reason of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_24__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_24__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "cancellation of accommodation; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_24__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_24__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "such other reason as may be approved by the Director General."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_24__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "The operator shall make the deduction referred to in subsection (1) within one year after the refund of the tourism tax was made, or such extended period as may be approved by the Director General. Power to collect tourism tax, etc., from persons owing money to operator"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_25__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_25__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_25__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_25__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_25__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_25__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_25__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "Where any tourism tax is due and payable, or any penalty, surcharge or other money is payable, by an operator, the Director General may, by notice in writing, require—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_25__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_25__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any person by whom any money is due or accruing or may become due to the operator;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_25__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_25__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any person who holds or may subsequently hold money for or on account of the operator; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_25__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_25__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any person having authority from some other person to pay money to the operator, to pay to the Director General forthwith or within such period as the Director General may allow, the money not being salary or wages due to the operator or so much thereof as is sufficient to pay the tourism tax due and payable, and penalty, surcharge or other money payable, if any, by the operator."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_25__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "A copy of the notice referred to in subsection (1) shall be forwarded to the operator at his last known address."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_25__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "All payments made pursuant to a notice under this section shall be deemed to have been made on behalf of the operator and with the operator’s authority and the authority of all other persons concerned. Payment by instalments"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_26__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_26__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_26__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_26__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General may allow any tourism tax or penalty to be paid by instalments, under the prescribed circumstances in such amounts and on such dates as the Director General may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_26__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "Where tourism tax is allowed to be paid by instalments, the penalty under subsection 19(8) shall cease to be calculated from the date the Director General allows the payment by instalments."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_26__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "Where there is a default in the payment of any one instalment on its due date for the payment of the balance of the amount due and payable, the whole outstanding balance shall become due and payable on that date and shall, without any further notice being served on the person liable to pay the amount due, be subject to a surcharge equal to ten per cent of that balance and the surcharge shall be recoverable as if the surcharge were payable under this Act. Recovery of tourism tax, etc., from persons leaving Malaysia"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_27__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_27__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_27__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_27__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_27__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_27__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_27__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_27__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_27__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_27__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_27__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_27__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Director General has reason to believe that any person is about or is likely to leave Malaysia without paying—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_27__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_27__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any tourism tax payable by him;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_27__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_27__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any penalty payable by him under section 19;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_27__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_27__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any surcharge payable by him under section 26; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_27__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_27__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any other money recoverable from him under this Act, the Director General may issue to any Director of Immigration a certificate containing particulars of the tourism tax, penalty, surcharge or other money so payable with a request that such person be prevented from leaving Malaysia unless and until the person pays the tourism tax, penalty, surcharge or other money so payable, or furnishes security to the satisfaction of the Director General for its payment."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_27__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to any order issued or made under any written law for the time being in force relating to banishment or immigration, any Director of Immigration who receives a request under subsection (1) in respect of a person shall exercise all measures which may include the removal and retention of any certificate of identity, passport, exit permit or other travel documents in relation to that person as may be necessary to give effect to the request."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_27__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General shall cause a notice of the issue of a certificate under subsection (1) to be served personally or by registered post on the person to whom the certificate relates."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_27__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "The non-receipt of the notice referred to in subsection (3) shall not invalidate anything done under this section."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_27__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "Where the person in respect of whom a certificate has been issued under subsection (1) produces on or after the date of the certificate a written statement signed by the Director General stating that all the tourism tax, penalty, surcharge or other money specified in the certificate have been paid, or that security has been furnished for its payment, that statement shall be sufficient authority for allowing that person to leave Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_27__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "No legal proceedings shall be instituted or maintained against the Federal Government, a State Government or any other public officer in respect of anything lawfully done under this section."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_27__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "In this section, “Director of Immigration” means the Director of Immigration appointed under subsection 3(1a) of the Immigration Act 1959/1963 [Act 155]. Recovery of tourism tax, etc., erroneously refunded"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_28__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_28__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_28__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "Where any tourism tax, penalty, surcharge or any other money after having been paid has been erroneously refunded to any person, the person shall pay the tourism tax, penalty, surcharge or any other money erroneously refunded to him upon a demand made by the Director General."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_28__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "The demand referred to in subsection (1) shall be made by the Director General within six years from the date the refund was made. Recovery of tourism tax, etc., as civil debt"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_29__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_29__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_29__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_29__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to any other remedy, any tourism tax due and payable, and any penalty, surcharge or any other money payable, by an operator under this Act may be recovered as a civil debt due to the Government."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_29__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "In any proceedings to recover the tourism tax, penalty, surcharge or other money, if any, under subsection (1), the production of a certificate signed by the Director General giving the name and address of the operator and the amount of the tourism tax due and payable, and penalty, surcharge or other money payable, if any, by the operator shall be sufficient evidence of the amount so due by him and sufficient authority for the court to give judgment for the said amount."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_29__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "Any penalty or surcharge payable under this Act shall, for the purposes of this Act and the Limitation Act 1953 [Act 254], the Limitation Ordinance of Sabah [Sabah Cap. 72] or the Limitation Ordinance of Sarawak [Sarawak Cap. 49], as the case may be, be recoverable as if the penalty or surcharge were tourism tax due and payable under this Act and accordingly subsection 6(4) of the Limitation Act 1953, section 3 of the Limitation Ordinance of Sabah or section 3 of the Limitation Ordinance of Sarawak, as the case may be, shall not apply to that penalty or surcharge. Recovery of tourism tax in other circumstances"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_30__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_30__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_30__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "Where an invoice, receipt or other document shows a provision of accommodation as having taken place with tourism tax chargeable on it, there shall be recoverable from the person who issued the invoice, receipt or other document an amount equal to that which is shown in the invoice, receipt or other document as tourism tax for the provision of such accommodation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_30__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_30__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_30__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_30__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection (1) shall apply notwithstanding that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_30__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_30__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the invoice, receipt or other document, in which is stated an amount which purports to be tourism tax as chargeable, is not an invoice, receipt or other document issued under section 14;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_30__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_30__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the invoice, receipt or other document was issued by a person who was not an operator and who had provided accommodation for which an amount which purports to be tourism tax was chargeable; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_30__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_30__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the invoice, receipt or other document was issued by a person who had provided a product or service other than accommodation for which an amount which purports to be tourism tax was chargeable, and any amount which purports to be tourism tax shall be paid immediately by that person to the Director General and, in default of payment, may be recovered as a civil debt due to the Government. Joint and several liability of partners, officials, committee members or directors"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_31__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_31__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_31__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding anything to the contrary in this Act or in any other Act, where tourism tax is due and payable, and penalty, surcharge or other money is payable, by a firm, a society, an association, a company and every other body of persons, the partners of such firm, officials or committee members of such society or association, the directors of such company or such other body of persons, as the case may be, shall, together with such firm, society, association, company or other body of persons be jointly and severally liable for the tourism tax, penalty, surcharge or other money."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_31__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_VI__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "In relation to a company that is being wound up, the directors of such company shall only be liable where the assets of the company are insufficient to meet the amount due, after paying any sum having priority under the Companies Act 2016 [Act 777] in relation to the application of the assets of the company in such winding up over the tourism tax, penalty, surcharge or other money."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_14__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_14__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_14__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "Every operator shall issue an invoice, receipt or other document in the national language or in the English language to a tourist in respect of the accommodation provided and shall state the rate and amount of tourism tax payable separately from the charges for the accommodation provided by the operator."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "No invoice, receipt or other document showing an amount which purports to be tourism tax shall be issued by a person who is not an operator."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_14__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) or (2) commits an offence and shall, on conviction, be liable to a fine not exceeding thirty thousand ringgit or to imprisonment for a term not exceeding one year or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_14__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this section, and sections 15 and 30, the reference to “other document” includes local order and statement of account. Production of invoice, receipt or other document by computer"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_15__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_15__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of any provision under this Act in relation to an invoice, receipt, or other document, an operator shall be treated as having issued an invoice, receipt or other document to a tourist if the requisite particulars are recorded in a computer and are—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_15__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "transmitted or made available to the tourist by electronic means; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_15__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "produced on any material and the material is delivered to the tourist. Credit note and debit note"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "Where an operator issues a credit note or debit note containing the prescribed particular under the prescribed circumstances and conditions, the operator shall make adjustments in his returns accordingly. Duty to keep records"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_17__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_17__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_17__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_17__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "Every operator shall keep full, true and up to date records of all transactions which affect or may affect his liability to collect tourism tax in such books of account or other records as the Director General may direct."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_17__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_17__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_17__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "Any record kept under this section shall be—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_17__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_17__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "preserved for a period of seven years from the latest date to which the record relates;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_17__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_17__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "in the national language or English language; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_17__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_17__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "kept in Malaysia, except as otherwise approved by the Director General and subject to the conditions as he deems fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_17__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "Where the record is in an electronically readable form, the record shall be kept in such manner as to enable the record to be readily accessible and convertible into writing."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_17__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "Where the record is originally in a manual form and is subsequently converted into an electronic form, the record shall be retained in its original form prior to the conversion."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_17__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes this section commits an offence and shall, on conviction, be liable to a fine not exceeding thirty thousand ringgit or to imprisonment for a term not exceeding one year or to both. Taxable period"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_18__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_18__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "The taxable period for tourism tax shall be a period of three months ending on the last day of any month of any calendar year."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (1), an operator who has been assigned with a taxable period for the purposes of the Goods and Services Tax Act 2014 [Act 762] shall be assigned with the same taxable period for the purposes of this Act. Furnishing of returns and payment of tourism tax"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_19__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_19__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_19__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_19__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_19__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_19__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_19__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_19__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_19__subsec_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_19__subsec_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_19__subsec_11"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_19__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "Every operator shall, in respect of his taxable period, account for the tourism tax received in a return as may be prescribed and the return shall be furnished to the Director General in the prescribed manner not later than the last day of the month following after the end of the operator’s taxable period to which the return relates."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_19__subsec_10",
      "@type": "akn:subsection",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "The court may order that any operator who is convicted for the offence under subsection (7) shall pay the penalty as specified in subsection (8)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_19__subsec_11",
      "@type": "akn:subsection",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "No prosecution for the offence under subsection (7) shall be instituted against the operator who has paid the amount of tourism tax due and payable and the penalty specified in subsection (8) within the period specified in subsection (8). Power to assess"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_19__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "Where the whole or any part of the tourism tax is not received by the operator from the tourist within a period of twelve calendar months from the date of the invoice for the accommodation provided, the operator shall account for the tourism tax in the return in the taxable period following after the end of that period of twelve calendar months and the return shall be furnished to the Director General in the prescribed manner."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_19__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "Any operator who ceases to be registered under section 12 shall, not later than thirty days after so ceasing or such later date as the Director General may allow, furnish a return containing particulars as the Director General may determine in respect of that part of the last taxable period during which the operator was registered."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_19__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "Any operator who is required to furnish a return under this section shall pay to the Director General the amount of tourism tax due and payable by the operator in respect of the taxable period to which the return relates not later than the last day on which the operator is required to furnish the return."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_19__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "The return referred to in subsections (1), (2) and (3) shall be furnished whether or not there is tourism tax to be paid."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_19__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "Any operator who fails to furnish the return as required under subsection (1), (2) or (3) commits an offence and shall, on conviction, be liable to a fine not exceeding thirty thousand ringgit or to imprisonment for a term not exceeding one year or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_19__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "Any operator who fails to pay to the Director General the amount of tourism tax due and payable under subsection (4) commits an offence and shall, on conviction, be liable to a fine not exceeding thirty thousand ringgit or to imprisonment for a term not exceeding one year or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_19__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_19__subsec_8__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_19__subsec_8__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_19__subsec_8__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "Where any tourism tax due and payable is not paid wholly or partly by any operator after the last day on which it is due and payable under subsection (4) and no prosecution is instituted, the operator shall pay—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_19__subsec_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_19__subsec_8",
      "schema:text": {
        "@language": "en",
        "@value": "for the first thirty-day period that the tourism tax is not paid wholly or partly after the expiry of the period specified under subsection (4), a penalty of ten per cent of the amount of tourism tax remain unpaid;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_19__subsec_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_19__subsec_8",
      "schema:text": {
        "@language": "en",
        "@value": "for the second thirty-day period that the tourism tax is not paid wholly or partly after the expiry of the period specified under subsection (4), an additional penalty of ten per cent of the amount of tourism tax remain unpaid; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_19__subsec_8__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_19__subsec_8",
      "schema:text": {
        "@language": "en",
        "@value": "for the third thirty-day period that the tourism tax is not paid wholly or partly after the expiry of the period specified under subsection (4), an additional penalty of ten per cent of the amount of tourism tax remain unpaid."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_19__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subsection (11), prosecution for the offence under subsection (7) may be instituted after the expiry of the period specified in paragraph (8)(c)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_20__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_20__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_20__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_20__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_20__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_20__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_20__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_20__subsec_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_20__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_20__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_20__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_20__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "Where any operator—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_20__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_20__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "fails to apply for registration under section 10 or 11;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_20__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_20__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "fails to furnish a return under section 19; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_20__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_20__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "furnishes a return which to the Director General appears incomplete or incorrect, the Director General may assess to the best of the Director General’s judgment the amount of tourism tax due from and payable by, and the penalty payable under subsection 19(8), if any, by, the operator and shall forthwith notify the operator of the assessment in writing."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_20__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "The assessment under subsection (1) shall not be made more than six years from the date on which the tourism tax was due and payable."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_20__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (2), where in the opinion of the Director General any form of fraud or wilful default has been committed by or on behalf of any person in connection with or in relation to tourism tax, the Director General may, for the purposes of making good any loss of tourism tax attributable to the fraud or wilful default, make an assessment at any time."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_20__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_20__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_20__subsec_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_20__subsec_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "Where—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_20__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_20__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "the Director General has made an assessment under subsection (1);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_20__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_20__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "the tax assessed has been paid but no return has been furnished for the period to which the assessment relates; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_20__subsec_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_20__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "the operator fails to furnish a return for any subsequent taxable period, the Director General may assess the tourism tax at such greater amount as he deems fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_20__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Director General assessed the tourism tax at such greater amount under subsection (4), the Director General may make a supplementary assessment and shall notify the operator in writing accordingly."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_20__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "Where the amount of tourism tax and penalty, if any, have been assessed and notified to any operator under subsection (1) or (5), the amount shall be deemed to be the amount of tourism tax due and payable and penalty, if any, payable and such amount shall be paid by the operator, except to the extent that the assessment has been withdrawn or reduced."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_20__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "The amount of tourism tax due and payable and penalty payable under subsection (6) shall be paid by the operator whether or not that operator appeals against the assessment."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_20__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_V__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General may make any alteration in or addition to the assessment made under this section as he deems fit to ensure the correctness of the assessment and shall forthwith notify the operator in writing."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X",
      "@type": "akn:part",
      "eli:number": "X",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_60",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_61",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_62",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_63",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_64",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_65",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_66",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_67",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_68",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_69",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_70"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "MISCELLANEOUS Persons bound to produce books, etc., or give information, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_60",
      "@type": "akn:clause",
      "eli:number": "60",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_60__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_60__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_60__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_60__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_60__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_60",
      "schema:text": {
        "@language": "en",
        "@value": "Every person having information about any matter into which it is the duty of an officer of customs to inquire shall, upon being required by the officer of customs to do so, give the information."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_60__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_60",
      "schema:text": {
        "@language": "en",
        "@value": "Every person required by an officer of customs to produce any books, data, documents or other records or thing which is within the power of the person to produce, and which are books, data, documents or other records or thing required under this Act or books, data, documents or other records or thing used in any transaction or other matter relating to tourism tax or books, data, documents or other records or thing into which it is the duty of the officer of customs to enquire under this Act, shall produce the books, data, documents or other records or thing."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_60__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_60",
      "schema:text": {
        "@language": "en",
        "@value": "Where any information, books, data, documents or other records or thing are not in the national language or English language, the Director General or any officer of customs may by notice in writing require the operator or, on the operator’s default, any other person, to produce, within a reasonable period, a translation thereof in the national language or English language as may be determined by the Director General or the officer of customs."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_60__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_60",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes this section commits an offence and shall, on conviction, be liable to a fine not exceeding thirty thousand ringgit or to imprisonment for a term not exceeding five years or to both. Service of notices, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_61",
      "@type": "akn:clause",
      "eli:number": "61",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_61__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_61__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_61__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_61__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_61__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_61__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_61__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_61",
      "schema:text": {
        "@language": "en",
        "@value": "Every notice, direction or any other document required by this Act to be served on any person may be served—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_61__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_61__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "personally upon the person;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_61__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_61__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "by sending it to the person by registered post; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_61__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_61__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "by electronic service."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_61__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_61__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_61__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_61",
      "schema:text": {
        "@language": "en",
        "@value": "A notice, direction or other document sent to a person by registered post shall be deemed to have been served on that person at the time at which it would have been delivered to that person in the ordinary course of the post if the notice, direction or other document was addressed—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_61__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_61__subsec_2__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_61__subsec_2__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_61__subsec_2__para_a__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_61__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of a company, firm, society, an association or other body of persons—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_61__subsec_2__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_61__subsec_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "to its registered office;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_61__subsec_2__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_61__subsec_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "to its last-known address; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_61__subsec_2__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_61__subsec_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "to any person authorized by it to accept service of process; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_61__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_61__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of an individual, to his last-known address."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_61__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_61",
      "schema:text": {
        "@language": "en",
        "@value": "Where a person has given his consent for a notice to be served on him through the electronic service, the notice shall be deemed to have been served at the time when the electronic notice is transmitted to his account through the electronic service. Use of electronic service"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_62",
      "@type": "akn:clause",
      "eli:number": "62",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_62__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_62__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_62__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_62__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_62__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_62__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_62__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_62",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding any other provision of this Act and subject to regulations made under this Act, the Director General may provide an electronic service to any registered user for—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_62__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_62__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the filing or furnishing of any application, return, declaration or any other document; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_62__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_62__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the service of any notice, direction, order, permit, receipt or any other document."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_62__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_62",
      "schema:text": {
        "@language": "en",
        "@value": "Where an electronic notice is made and transmitted to the Director General, the Director General shall not be liable for any loss or damage suffered by the registered user by reason of any error or omission of whatever nature or however arising appearing in any electronic notice obtained by the registered user under the electronic service if the error or omission was made in good faith and in the ordinary course of the discharge of the duties of the Director General or occurred or arose as a result of any defect or breakdown in the service or in the equipment used for the provision of the service."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_62__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_62",
      "schema:text": {
        "@language": "en",
        "@value": "Any electronic notice made and transmitted by the registered user shall be deemed to have been filed, furnished or served at the time the electronic notice is received by the Director General."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_62__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_62",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this section, “registered user” means any person who is authorized in writing by the Director General to gain access to and use the electronic service. Authentication of notices, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_63",
      "@type": "akn:clause",
      "eli:number": "63",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_63__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_63__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_63__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_63__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_63",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subsection (2), every notice or any other document served for the purposes of this Act by the Director General or an officer authorized by the Director General shall be sufficiently authenticated if the name and office of the Director General is printed, stamped or otherwise written thereon."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_63__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_63",
      "schema:text": {
        "@language": "en",
        "@value": "Where this Act provides for a notice or any other document to be under the hand of any officer of customs, the notice or the other document shall be signed in manuscript by the officer of customs."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_63__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_63",
      "schema:text": {
        "@language": "en",
        "@value": "A notice or any other document served for the purposes of this Act and purporting to be signed in manuscript by the Director General or an officer authorized by the Director General shall be presumed, until the contrary is proved, to have been so signed. Free postage"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_64",
      "@type": "akn:clause",
      "eli:number": "64",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X",
      "schema:text": {
        "@language": "en",
        "@value": "All returns and remittances of tourism tax and any correspondence resulting from or connected with any return or remittance may, if posted in Malaysia, be sent free of postage to the Director General in an envelope marked “Tourism Tax”. Transaction of business on behalf of operator"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_65",
      "@type": "akn:clause",
      "eli:number": "65",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_65__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_65__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_65__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_65__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_65__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_65__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_65__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_65",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall transact any business in relation to this Act on behalf of an operator, except on matters with regard to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_65__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_65__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "refund;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_65__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_65__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "remission;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_65__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_65__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "exemption; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_65__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_65__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any other matters as may be approved by the Director General."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_65__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_65__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_65__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_65",
      "schema:text": {
        "@language": "en",
        "@value": "The person who transacts business on any of the matters stated in subsection (1) on behalf of an operator shall—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_65__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_65__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "produce a letter of authorization from the operator whom the person represents; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_65__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_65__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "where any prescribed form is required to be submitted for the purposes of the matters being transacted, submit the form that has been signed by the operator, except where otherwise allowed by a senior officer of customs. Forms to be used"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_66",
      "@type": "akn:clause",
      "eli:number": "66",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_66__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_66__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_66__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_66__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_66",
      "schema:text": {
        "@language": "en",
        "@value": "Where any form has been prescribed under this Act, no person shall, for the purposes of this Act, use any form which is not printed or issued by the authority of the Director General."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_66__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_66",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General may, at his discretion and subject to such conditions as he deems fit to impose, permit any person to use forms which are not printed or issued as aforesaid or the use of any form submitted through electronic service."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_66__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_66",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) commits an offence. Disputes and appeal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_67",
      "@type": "akn:clause",
      "eli:number": "67",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X",
      "schema:text": {
        "@language": "en",
        "@value": "Where any person disputes the decision of an officer of customs, he may appeal to the Director General whose decision on such dispute shall be final. Liquidator of company to give notice of winding up, and set aside tourism tax"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_68",
      "@type": "akn:clause",
      "eli:number": "68",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_68__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_68__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_68__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_68__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_68__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_68",
      "schema:text": {
        "@language": "en",
        "@value": "Where after the passing of this Act an effective resolution is passed or an order is made for the winding up of a company registered under section 12, the liquidator of the company shall give notice thereof to the Director General within fourteen days after the passing of the resolution or the making of the order, and shall before disposing of any of the assets of the company set aside such sum out of the assets as appears to the Director General to be sufficient to provide for any tourism tax that is or will thereafter become payable in respect of the accommodation that has been provided by the company, and shall pay such tourism tax."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_68__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_68",
      "schema:text": {
        "@language": "en",
        "@value": "A liquidator of any such company who fails to give notice to the Director General within the time specified in subsection (1) or fails to provide for payment of the tourism tax as required under that subsection shall be personally liable for any tourism tax that is or becomes payable as aforesaid."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_68__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_68",
      "schema:text": {
        "@language": "en",
        "@value": "Any liquidator who fails to comply with subsection (1) commits an offence and shall, on conviction, be liable to a fine not exceeding thirty thousand ringgit or to imprisonment for a term not exceeding one year or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_68__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_68",
      "schema:text": {
        "@language": "en",
        "@value": "Where two or more persons are appointed as liquidators or are required by law to carry out the winding up of any such company, the obligations and liabilities attaching to a liquidator under this section shall attach to all such persons jointly and severally, subject to a right of contribution between themselves as in cases of contract. Appointment of receiver to be notified to the Director General"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_69",
      "@type": "akn:clause",
      "eli:number": "69",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_69__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_69__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_69__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_69__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_69__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_69",
      "schema:text": {
        "@language": "en",
        "@value": "Where a receiver is appointed of the property of an operator registered under section 12, the receiver shall give notice thereof to the Director General within fourteen days after the appointment being made, and shall before disposing of any of the assets of that operator set aside such sum out of the assets as appears to the Director General to be sufficient to provide for any tourism tax that is or will thereafter become payable in respect of the accommodation that has been provided by that operator before the appointment of the receiver, and shall pay such tourism tax."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_69__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_69",
      "schema:text": {
        "@language": "en",
        "@value": "A person appointed as receiver who fails to give notice to the Director General within the time specified in subsection (1) or fails to provide for payment of the tourism tax as required under that subsection shall be personally liable for any tourism tax that is or becomes payable as aforesaid."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_69__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_69",
      "schema:text": {
        "@language": "en",
        "@value": "Any receiver who fails to comply with subsection (1) commits an offence and shall, on conviction, be liable to a fine not exceeding thirty thousand ringgit or to imprisonment for a term not exceeding one year or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_69__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_69",
      "schema:text": {
        "@language": "en",
        "@value": "Where two or more persons are appointed as receivers, the obligations and liabilities attaching to a receiver under this section shall attach to all such persons jointly and severally, subject to a right of contribution between themselves as in cases of contract. Power to make regulations"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_70",
      "@type": "akn:clause",
      "eli:number": "70",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_70__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_70__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_70__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_70",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may make regulations as may be necessary or expedient for the purposes of carrying into effect the provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_70__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_70__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_70__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_70__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_70__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_70__subsec_2__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_70",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to the generality of subsection (1), regulations may be made for the following purposes:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_70__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_70__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe matters relating to registration of operator;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_70__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_70__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe the offices for the administration of the tourism tax and for the days and times during which the offices may be opened for business;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_70__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_70__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe the forms to be used under and for purposes connected with this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_70__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_70__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to provide for offences and penalties not exceeding a fine of thirty thousand ringgit or imprisonment not exceeding one year or both for the contravention of any provision of the regulations; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_70__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/12/eng@/~part_X__cl_70__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe matters relating to electronic service."
      }
    }
  ]
}
