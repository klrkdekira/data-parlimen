        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_10__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_10__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_10__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_10__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_10__subsec_1__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_10__subsec_1__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_10__subsec_1__para_i"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The Coordinating Committee shall have the following functions:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_10__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_10__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "coordinating the implementation of this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_10__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_10__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to make recommendations on matters relating to Malaysian land border security or for matters provided for under this Act to the High Level Committee;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_10__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_10__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "implementing all the decisions made by the High Level Committee;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_10__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_10__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "formulating policies and programmes to prevent any smuggling activities or other illegal activities at the Malaysian land border;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_10__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_10__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "monitoring any smuggling activities or other illegal activities at the Malaysian land border and to secure response from the relevant Government agencies and organizations;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_10__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_10__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "certifying the recommendations made by the Agency to the High Level Committee;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_10__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_10__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "considering measures to secure any smuggling activities or other illegal activities at the Malaysian land border;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_10__subsec_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_10__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "cooperating and coordinating with Government agencies and international organizations on any smuggling activities or other illegal activities at the Malaysian land border; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_10__subsec_1__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_10__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "performing any other functions for the proper implementation of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The Coordinating Committee may establish any committee as the Coordinating Committee thinks necessary or expedient to assist the Coordinating Committee in the performance of its functions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_8__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "A Coordinating Committee is established for the purpose of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_8__subsec_2",
