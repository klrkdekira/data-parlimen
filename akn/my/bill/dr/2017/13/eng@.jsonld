      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_9__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_9__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_9__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "The Coordinating Committee shall meet as often as may be necessary."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "Seven members, including the Chairman, shall form the quorum of a meeting of the Coordinating Committee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_9__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "The Coordinating Committee may invite any person not being a member of the Coordinating Committee to attend its meetings to advise the Coordinating Committee on any matter under discussion."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_9__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "The Agency may appoint from amongst the officers of the Agency to be the secretariat for the Coordinating Committee. Functions of Coordinating Committee"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_I__cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Malaysian Border Security Agency Act 2017."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_I__cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_I__cl_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_I__cl_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_I",
      "schema:name": {
        "@language": "en",
        "@value": "In this Act, unless the context otherwise requires—"
      },
      "schema:text": {
        "@language": "en",
        "@value": "“Agency” means the Malaysian Border Security Agency established under section 3; “Government Entities” includes—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_I__cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_I__cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "any ministry, department, office, agency, authority, commission, committee, board or council of the Federal Government, or of any of the State Governments, established under any written law or otherwise;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_I__cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_I__cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "any local authorities; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_I__cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_I__cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "the security forces; “High Level Committee” means the High Level Committee established under subsection 5(1); “Coordinating Committee” means the Coordinating Committee of the Agency established under subsection 8(1); “Commissioner General” means the Commissioner General of the Agency appointed under subsection 11(1); “Minister” means the Minister charged with the responsibility for internal security; “officer of the Agency” includes the Commissioner General and the Deputies Commissioner General appointed under section 11, and any officer of the Agency appointed under subsection 13(1); “Malaysian land border” means land border between Malaysia and Thailand, Malaysia and Indonesia, and Malaysia and Brunei."
      }
    },
