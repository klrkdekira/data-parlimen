      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "The Agency shall, subject to this Act, be employed at the Malaysian land border for securing any smuggling activities or other illegal activities at the Malaysian land border. Functions of Agency"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_II__cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_II__cl_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_II__cl_4__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_II__cl_4__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_II__cl_4__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_II__cl_4__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_II__cl_4__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_II__cl_4__para_h"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "The Agency shall have the following functions:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_II__cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "to carry out Malaysian land border control;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_II__cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "to make recommendations on matters relating to Malaysian land border security or for matters provided for under this Act to the High Level Committee and the Coordinating Committee;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_II__cl_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "to receive any report of the commission of an offence in relation to smuggling activities or other illegal activities at the Malaysian land border;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_II__cl_4__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "to prevent and suppress the commission of an offence in relation to smuggling activities or other illegal activities at the Malaysian land border;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_II__cl_4__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "to coordinate the implementation of enforcement by the Agency with other agencies at the Malaysian land border;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_II__cl_4__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "to monitor any smuggling activities or other illegal activities at the Malaysian land border;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_II__cl_4__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "to formulate policies and programmes to prevent any smuggling activities or other illegal activities at the Malaysian land border; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_II__cl_4__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "generally to perform any other function for ensuring Malaysian land border security and wellbeing or do all matters incidental to its functions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_10"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "COORDINATING COMMITTEE Coordinating Committee"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_10__subsec_1",
