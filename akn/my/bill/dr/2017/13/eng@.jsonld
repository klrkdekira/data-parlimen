        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_III__cl_6__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_III__cl_6__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_III__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_III__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The High Level Committee shall meet as often as may be necessary."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_III__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_III__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "Seven members, including the Chairman, shall form the quorum of a meeting of the High Level Committee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_III__cl_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_III__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The High Level Committee may invite any person not being a member of the High Level Committee to attend its meetings to advise the High Level Committee on any matter under discussion."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_III__cl_6__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_III__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The Agency may appoint from amongst the officers of the Agency to be the secretariat for the High Level Committee. Function of High Level Committee"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_III__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "The High Level Committee shall deliberate and decide on the recommendations made by the Coordinating Committee and the Agency or any matter relating to Malaysian land border security."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_II__cl_3",
      "@type": "akn:clause",
