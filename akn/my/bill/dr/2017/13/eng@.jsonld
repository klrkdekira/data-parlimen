      "schema:text": {
        "@language": "en",
        "@value": "The Coordinating Committee shall consist of the following members:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_8__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_8__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Secretary General of the Ministry charged with the responsibility for internal security as Chairman;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_8__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_8__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Commissioner General;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_8__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_8__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Director General of the National Security, National Security Council;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_8__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_8__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Director General of the Royal Malaysian Customs Department;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_8__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_8__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Director General of the Immigration Department of Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_8__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_8__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Director General of the Department of Wildlife and National Parks, Peninsular Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_8__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_8__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Director General of Agriculture, Department of Agriculture;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/eng@/~part_IV__cl_8__subsec_2__para_h",
