      "schema:text": {
        "@language": "ms",
        "@value": "Menteri yang dipertanggungkan dengan tanggungjawab bagi hal ehwal luar negeri;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_III__cl_5__subsec_2__para_k",
