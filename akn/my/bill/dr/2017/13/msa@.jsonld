    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_III__cl_5__subsec_2__para_s",
      "@type": "akn:paragraph",
      "eli:number": "s",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_III__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah Lembaga Kenaf dan Tembakau Negara. Mesyuarat Jawatankuasa Peringkat Tertinggi"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_III__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_III__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_III__cl_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_III__cl_6__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_III__cl_6__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_III__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_III__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatankuasa Peringkat Tertinggi hendaklah bermesyuarat seberapa kerap yang perlu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_III__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_III__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Tujuh orang anggota, termasuk Pengerusi, hendaklah membentuk kuorum suatu mesyuarat Jawatankuasa Peringkat Tertinggi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_III__cl_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_III__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatankuasa Peringkat Tertinggi boleh mengundang mana-mana orang yang bukan anggota Jawatankuasa Peringkat Tertinggi untuk menghadiri mesyuaratnya bagi menasihati Jawatankuasa Peringkat Tertinggi mengenai apa-apa perkara yang sedang dibincangkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_III__cl_6__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_III__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Agensi boleh melantik dalam kalangan pegawai Agensi untuk menjadi urus setia bagi Jawatankuasa Peringkat Tertinggi. Fungsi Jawatankuasa Peringkat Tertinggi"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_III__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatankuasa Peringkat Tertinggi hendaklah menimbang teliti dan memutuskan syor yang dibuat oleh Jawatankuasa Penyelaras dan Agensi atau apa-apa perkara yang berhubungan dengan keselamatan sempadan darat Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_II__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_II__cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_II__cl_3__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_II__cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu agensi dengan nama “Agensi Kawalan Sempadan Malaysia” ditubuhkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_II__cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Agensi hendaklah, tertakluk kepada Akta ini, digunakan khidmatnya di sempadan darat Malaysia bagi mengawal apa-apa kegiatan penyeludupan atau aktiviti lain yang menyalahi undang-undang di sempadan darat Malaysia. Fungsi Agensi"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_II__cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_II__cl_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_II__cl_4__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_II__cl_4__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_II__cl_4__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_II__cl_4__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_II__cl_4__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_II__cl_4__para_h"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Agensi hendaklah mempunyai fungsi yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_II__cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menjalankan kawalan sempadan darat Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_II__cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk membuat syor mengenai perkara yang berhubungan dengan keselamatan sempadan darat Malaysia atau bagi perkara yang diperuntukkan di bawah Akta ini kepada Jawatankuasa Peringkat Tertinggi dan Jawatankuasa Penyelaras;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_II__cl_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menerima apa-apa laporan bagi pelakuan suatu kesalahan berhubung dengan kegiatan penyeludupan atau aktiviti lain yang menyalahi undang-undang di sempadan darat Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_II__cl_4__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mencegah dan menyekat pelakuan suatu kesalahan berhubung dengan kegiatan penyeludupan atau aktiviti lain yang menyalahi undang-undang di sempadan darat Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_II__cl_4__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menyelaras pelaksanaan penguatkuasaan oleh Agensi dengan agensi lain di sempadan darat Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_II__cl_4__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memantau apa-apa kegiatan penyeludupan atau aktiviti lain yang menyalahi undang-undang di sempadan darat Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_II__cl_4__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk merumus dasar dan program untuk mencegah apa-apa kegiatan penyeludupan atau aktiviti lain yang menyalahi undang-undang di sempadan darat Malaysia; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_II__cl_4__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "secara amnya untuk melaksanakan apa-apa fungsi lain bagi memastikan kesejahteraan dan keselamatan sempadan darat Malaysia atau melakukan segala perkara yang bersampingan dengan fungsinya."
      }
    },
    {
