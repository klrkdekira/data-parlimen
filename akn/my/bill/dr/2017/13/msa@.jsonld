      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_IV__cl_8__subsec_2__para_v",
      "@type": "akn:paragraph",
      "eli:number": "v",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_IV__cl_8__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "wakil daripada Kementerian Pertahanan. Mesyuarat Jawatankuasa Penyelaras"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_IV__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_IV__cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_IV__cl_9__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_IV__cl_9__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_IV__cl_9__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_IV__cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_IV__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatankuasa Penyelaras hendaklah bermesyuarat seberapa kerap yang perlu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_IV__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_IV__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Tujuh orang anggota, termasuk Pengerusi, hendaklah membentuk kuorum suatu mesyuarat Jawatankuasa Penyelaras."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_IV__cl_9__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_IV__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatankuasa Penyelaras boleh mengundang mana-mana orang yang bukan anggota Jawatankuasa Penyelaras untuk menghadiri mesyuaratnya bagi menasihati Jawatankuasa Penyelaras mengenai apa-apa perkara yang sedang dibincangkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_IV__cl_9__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_IV__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Agensi boleh melantik mana-mana pegawai dalam kalangan pegawai Agensi untuk menjadi urus setia bagi Jawatankuasa Penyelaras. Fungsi Jawatankuasa Penyelaras"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_I__cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_I__cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Agensi Kawalan Sempadan Malaysia 2017."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_I__cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta. Tafsiran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_I__cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_I__cl_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_I__cl_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_I",
      "schema:name": {
        "@language": "ms",
        "@value": "Dalam Akta ini, melainkan jika konteksnya menghendaki makna yang lain—"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "“Agensi” ertinya Agensi Kawalan Sempadan Malaysia yang ditubuhkan di bawah seksyen 3; “Entiti Kerajaan” termasuklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_I__cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_I__cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana kementerian, jabatan, pejabat, agensi, pihak berkuasa, suruhanjaya, jawatankuasa, lembaga atau majlis bagi Kerajaan Persekutuan, atau bagi mana-mana Kerajaan Negeri, yang ditubuhkan di bawah mana-mana undang-undang bertulis atau selainnya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_I__cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_I__cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana pihak berkuasa tempatan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_I__cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_I__cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pasukan keselamatan; “Jawatankuasa Peringkat Tertinggi” ertinya Jawatankuasa Peringkat Tertinggi yang ditubuhkan di bawah subseksyen 5(1); “Jawatankuasa Penyelaras” ertinya Jawatankuasa Penyelaras Agensi yang ditubuhkan di bawah subseksyen 8(1); “Komisioner Jeneral” ertinya Komisioner Jeneral Agensi yang dilantik di bawah subseksyen 11(1); “Menteri” ertinya Menteri yang dipertanggungkan dengan tanggungjawab bagi keselamatan dalam negeri; “pegawai Agensi” termasuklah Komisioner Jeneral dan Timbalan-timbalan Komisioner Jeneral yang dilantik di bawah seksyen 11, dan mana-mana pegawai Agensi yang dilantik di bawah subseksyen 13(1); “sempadan darat Malaysia” ertinya sempadan darat antara Malaysia dengan Thailand, Malaysia dengan Indonesia, dan Malaysia dengan Brunei."
      }
    },
