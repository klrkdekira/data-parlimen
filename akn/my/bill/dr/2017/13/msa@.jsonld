      "schema:text": {
        "@language": "ms",
        "@value": "Jawatankuasa Penyelaras hendaklah mempunyai fungsi yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_IV__cl_10__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_IV__cl_10__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menyelaras pelaksanaan Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_IV__cl_10__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_IV__cl_10__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk membuat syor mengenai perkara yang berhubungan dengan keselamatan sempadan darat Malaysia atau bagi perkara yang diperuntukkan di bawah Akta ini kepada Jawatankuasa Peringkat Tertinggi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_IV__cl_10__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_IV__cl_10__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "melaksanakan segala keputusan yang dibuat oleh Jawatankuasa Peringkat Tertinggi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_IV__cl_10__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_IV__cl_10__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "merumus dasar dan program untuk mencegah apa-apa kegiatan penyeludupan atau aktiviti lain yang menyalahi undang-undang di sempadan darat Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_IV__cl_10__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_IV__cl_10__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "memantau apa-apa kegiatan penyeludupan atau aktiviti lain yang menyalahi undang-undang di sempadan darat Malaysia dan mendapatkan maklum balas daripada agensi Kerajaan dan organisasi yang berkaitan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_IV__cl_10__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_IV__cl_10__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "memperakukan syor yang dibuat oleh Agensi kepada Jawatankuasa Peringkat Tertinggi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_IV__cl_10__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_IV__cl_10__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mempertimbangkan langkah-langkah bagi mengawal apa-apa kegiatan penyeludupan atau aktiviti lain yang menyalahi undang-undang di sempadan darat Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_IV__cl_10__subsec_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_IV__cl_10__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bekerjasama dan menyelaras dengan agensi Kerajaan dan organisasi antarabangsa mengenai apa-apa kegiatan penyeludupan atau aktiviti lain yang menyalahi undang-undang di sempadan darat Malaysia; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_IV__cl_10__subsec_1__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_IV__cl_10__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "melaksanakan apa-apa fungsi lain bagi pelaksanaan sewajarnya Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_IV__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_IV__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatankuasa Penyelaras boleh menubuhkan apa-apa jawatankuasa sebagaimana yang difikirkan perlu atau suai manfaat oleh Jawatankuasa Penyelaras untuk membantu Jawatankuasa Penyelaras dalam menjalankan fungsinya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/13/msa@/~part_IV__cl_8",
      "@type": "akn:clause",
