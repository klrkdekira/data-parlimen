      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/15/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 200 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/15/msa@/~cl_18__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/15/msa@/~cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “apa-apa kacau ganggu” perkataan “di suatu terminal atau”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/15/msa@/~cl_18__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/15/msa@/~cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perenggan (b) dengan perenggan yang berikut: “(b) mengamang, menggalang atau menghalang seseorang pemegang lesen, pemegang lesen terminal, pemegang lesen perniagaan pengantaraan atau pengendali berlesen atau seorang pekerja pemegang lesen, pemegang lesen terminal, pemegang lesen perniagaan pengantaraan atau pengendali berlesen itu, termasuk seorang pegawai kereta api, daripada mengadakan perkhidmatan pengangkutan awam darat atau dalam pelaksanaan kewajipan pekerja sedemikian,”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/15/msa@/~cl_18__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/15/msa@/~cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “pemegang lesen” di mana-mana jua terdapat perkataan “, pemegang lesen terminal, pemegang lesen perniagaan pengantaraan”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/15/msa@/~cl_18__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/15/msa@/~cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “pengendali berlesen itu dari” perkataan “terminal,”. Pindaan seksyen 210"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/15/msa@/~cl_19",
