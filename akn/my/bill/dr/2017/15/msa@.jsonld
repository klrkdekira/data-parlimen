    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/15/msa@/~cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/15/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memasukkan selepas Jadual Kedua jadual yang berikut: “JADUAL KETIGA [Seksyen 2] PERKHIDMATAN PENGANGKUTAN AWAM DARAT DI BAWAH PERNIAGAAN PENGANTARAAN 1. Perkhidmatan kenderaan perkhidmatan awam.”. Kecualian dan peralihan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/15/msa@/~cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/15/msa@/~cl_32__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/15/msa@/~cl_32__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/15/msa@/~cl_32__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/15/msa@/~cl_32__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/15/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/15/msa@/~cl_32__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/15/msa@/~cl_32",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang mengendalikan atau mengadakan apa-apa perkhidmatan yang berhubungan dengan perniagaan pengantaraan, sebelum tarikh permulaan kuat kuasa Akta ini, hendaklah membuat permohonan bagi suatu lesen mengikut Akta ini dalam masa satu tahun dari tarikh permulaan kuat kuasa Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/15/msa@/~cl_32__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/15/msa@/~cl_32",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa permohonan bagi suatu lesen yang belum selesai pada tarikh permulaaan kuat kuasa Akta ini hendaklah diuruskan di bawah Akta ibu sebagaimana yang dipinda oleh Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/15/msa@/~cl_32__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/15/msa@/~cl_32",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa tindakan, penyiasatan atau prosiding yang dimulakan atau yang belum selesai sebaik sebelum tarikh permulaan kuat kuasa Akta ini hendaklah, selepas tarikh permulaan kuat kuasa Akta ini, diteruskan seolah-olah Akta ibu tidak dipinda oleh Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/15/msa@/~cl_32__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/15/msa@/~cl_32",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa obligasi, liabiliti, penalti atau hukuman yang terakru atau dikenakan di bawah Akta ibu, boleh diteruskan, dikuatkuasakan, dikenakan dan diuruskan, mengikut mana-mana yang berkenaan, seolah-olah Akta ibu tidak dipinda oleh Akta ini."
      }
    },
