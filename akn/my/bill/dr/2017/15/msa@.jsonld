      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “a licensee, licensed operator or terminal licensee” dengan perkataan “a licensee, licensed operator, terminal licensee or an intermediation business licensee”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/15/msa@/~cl_22__para_b__subpara_i__subpara_B",
      "@type": "akn:subparagraph",
