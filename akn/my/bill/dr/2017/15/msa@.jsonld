      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/15/msa@/~cl_22__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/15/msa@/~cl_22__para_b__subpara_i__subpara_A",
