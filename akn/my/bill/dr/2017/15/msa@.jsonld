      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 171 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/15/msa@/~cl_12__para_a",
      "@type": "akn:paragraph",
