      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1), dengan menggantikan perkataan “dan pemegang lesen terminal” dengan perkataan “, pemegang lesen terminal dan pemegang lesen perniagaan pengantaraan”; dan"
      }
    },
