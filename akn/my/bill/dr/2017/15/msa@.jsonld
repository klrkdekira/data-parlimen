      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/15/msa@/~cl_22__para_b__subpara_i__subpara_A",
      "@type": "akn:subparagraph",
