      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 237 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/15/msa@/~cl_22__para_a",
      "@type": "akn:paragraph",
