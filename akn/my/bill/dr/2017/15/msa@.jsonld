      "schema:text": {
        "@language": "ms",
        "@value": "dalam teks bahasa kebangsaan, dengan menggantikan perkataan “atau pemegang lesen terminal” di mana-mana jua terdapat dengan perkataan “, pemegang lesen terminal atau pemegang lesen perniagaan pengantaraan”; dan"
      }
    },
