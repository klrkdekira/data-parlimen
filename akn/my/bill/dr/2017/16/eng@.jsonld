      "schema:text": {
        "@language": "en",
        "@value": "Section 30 of the principal Act is amended by substituting for the words “under subsection 15(3) or under section 22” the words “under subsection 15(3), section 22 or 26c”. Amendment of section 31"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/16/eng@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/16/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by substituting for section 31 the following section: “31. Notwithstanding sections 17 and 26a, where the Minister allows in full an appeal against an order revoking a licence or an intermediation business licence granted under this Act, the validity of the licence or intermediation business licence shall thereupon be extended by a period corresponding to that during which the licence or intermediation business licence was of no effect and such extended period shall accordingly be inserted in the licence or intermediation business licence.”. Amendment of section 33"
      }
