    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/16/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/16/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Commercial Vehicles Licensing Board (Amendment) Act 2017."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/16/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/16/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette and the Minister may appoint different dates for the coming into operation of different provisions of this Act. Amendment of section 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/16/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/16/eng@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/16/eng@/~cl_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/16/eng@/~cl_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/16/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Commercial Vehicles Licensing Board Act 1987 [Act 334], which is referred to as the “principal Act” in this Act, is amended in section 2—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/16/eng@/~cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/16/eng@/~cl_20__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/16/eng@/~cl_20__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/16/eng@/~cl_20__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/16/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/16/eng@/~cl_20__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/16/eng@/~cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who was operating or providing any service relating to an intermediation business, before the date of coming into operation of this Act, shall make an application for a licence in accordance with this Act within one year from the date of coming into operation of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/16/eng@/~cl_20__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/16/eng@/~cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "Any action, investigation or proceedings commenced or pending immediately before the date of coming into operation of this Act shall, after the date of coming into operation of this Act, be continued as if the principal Act had not been amended by this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/16/eng@/~cl_20__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/16/eng@/~cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "Any such obligation, liability, penalty, or punishment accrued or incurred under the principal Act, may be continued, enforced, imposed and be dealt with, as the case may be, as if the principal Act had not been amended by this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/16/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/16/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the definition of “express bus” the following definition: ‘ “e-hailing vehicle” means a motor vehicle having a seating capacity of four persons and not more than eleven persons (including the driver) used for the carriage of persons on any journey in consideration of a single or separate fares for each of them, in which the arrangement, booking or transaction, and the fare for such journey are facilitated through an electronic mobile application provided by an intermediation business;’;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/16/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/16/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "in the definition of “licence”, by inserting after the words “section 18” the words “except an intermediation business licence issued under Part IVa”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/16/eng@/~cl_2__para_c",
