      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “lesen” perkataan “atau lesen perniagaan pengantaraan”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/16/msa@/~cl_12__para_b__subpara_ii",
