      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “dalam perniagaan pemegang lesen” dengan perkataan “dalam perniagaan pemegang lesen atau pemegang lesen perniagaan pengantaraan”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/16/msa@/~cl_12__para_b__subpara_ii__subpara_B",
      "@type": "akn:subparagraph",
      "eli:number": "B",
