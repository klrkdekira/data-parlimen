      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 33 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/16/msa@/~cl_10__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/16/msa@/~cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menomborkan semula seksyen yang sedia ada sebagai subseksyen (1); dan Lembaga Pelesenan Kenderaan Perdagangan (Pindaan) 11"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/16/msa@/~cl_10__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/16/msa@/~cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (1) yang dinomborkan semula subseksyen yang berikut: “(2) Bagi maksud Akta ini, subseksyen (1) tidak terpakai bagi kenderaan e-hailing.”. Pindaan seksyen 36"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/16/msa@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/16/msa@/~cl_11__para_a",
