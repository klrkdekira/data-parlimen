      "schema:text": {
        "@language": "ms",
        "@value": "dalam teks bahasa kebangsaan, dengan memasukkan selepas perkataan “jika pemegang lesen” perkataan “atau pemegang lesen perniagaan pengantaraan”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/16/msa@/~cl_12__para_b__subpara_ii__subpara_C",
