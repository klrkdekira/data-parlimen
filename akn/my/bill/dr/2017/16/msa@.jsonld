      "schema:text": {
        "@language": "ms",
        "@value": "dalam teks bahasa Inggeris, dengan memasukkan selepas perkataan “in the case of the holder” perkataan “of a licence or the holder of an intermediation business licence”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/16/msa@/~cl_12__para_b__subpara_iii",
