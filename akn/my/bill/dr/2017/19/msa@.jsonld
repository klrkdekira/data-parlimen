      "schema:name": {
        "@language": "ms",
        "@value": "RUU Perihal Dagangan (Pindaan) 2017"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/19/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
