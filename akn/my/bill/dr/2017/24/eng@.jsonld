        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "REQUIREMENTS FOR PERMIT TO ACCESS BIOLOGICAL RESOURCES Application for permit for commercial or potential commercial purpose"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who intends to access a biological resource or traditional knowledge associated with a biological resource including through an authorized intermediary for commercial or potential commercial purposes shall apply for a permit to the relevant Competent Authority in the form and manner as may be prescribed and which shall be accompanied by payment of the prescribed fee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_2__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_2__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_2__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_2__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_2__para_k",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_2__para_l",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_2__para_m",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_2__para_n",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_2__para_o",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_2__para_p"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The Competent Authority may, after receiving the application under subsection (1), approve the application, if the following matters have been satisfied:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "a benefit sharing agreement has been established in accordance with section 22;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of access to a biological resource or traditional knowledge associated with a biological resource, as the case may be, the applicant has obtained the prior informed consent in accordance with section 23;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the application is not for any threatened taxa;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the application is not for any endemic species, rare species or any species protected under any federal or state law;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the access is not likely to result in adverse effects on the livelihood or cultural practices including religious, ceremonial or other traditional or customary practices of indigenous and local communities;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of access to human genetic resource, its use is not for the purposes contrary to ethical values or the public interest;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the access may not result in adverse environmental impact which may be difficult to control and mitigate;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the access may not cause genetic erosion or affect any function of the ecosystem;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_2__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the access may not adversely affect food security;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_2__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the use of the biological resource is not for the purposes contrary to the national or State interest;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_2__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the use of the biological resource is not for the development of biological or chemical weapons, or for military or terrorist purposes;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_2__para_l",
      "@type": "akn:paragraph",
      "eli:number": "l",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the use of the biological resource is not for the purposes associated with genetic use restriction technology;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_2__para_m",
      "@type": "akn:paragraph",
      "eli:number": "m",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the applicant has not committed an offence under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_2__para_n",
      "@type": "akn:paragraph",
      "eli:number": "n",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the applicant has not been adjudicated a bankrupt or, in the case of a company, has not been wound up;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_2__para_o",
      "@type": "akn:paragraph",
      "eli:number": "o",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the application complies with the requirements of this Act or any other written law; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_2__para_p",
      "@type": "akn:paragraph",
      "eli:number": "p",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the use of the biological resources is not contrary to the related international agreements or instruments to which Malaysia is a party."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The Competent Authority shall refuse the application if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "any of the grounds specified in subsection (2) is not fulfilled; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "after consultation with the National Competent Authority, the applicant is from, or otherwise based or operating in, jurisdictions which do not provide for adequate and effective measures that requires biological resources utilized within its jurisdiction to be accessed in accordance with prior informed consent and that mutually agreed terms to be established as provided under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (3), the Competent Authority may issue a permit relating to paragraphs (2)(c) and (d) if the Competent Authority is satisfied that the application for permit does not undermine the conservation and sustainable use of biodiversity."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "After giving due consideration to the application under subsections (1) and (2), the Competent Authority may—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "approve the application, with or without condition, and issue a permit to the applicant; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "refuse the application, stating the grounds for refusal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_6__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who accesses a biological resource or traditional knowledge associated with a biological resource without a permit under subsection (1) or contravenes any condition imposed on the permit under subsection (5) commits an offence and shall, on conviction, be liable—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "where such person is an individual, to a fine not exceeding five hundred thousand ringgit or to imprisonment for a term not exceeding ten years or to both; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_12__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "where such person is a body corporate, to a fine not exceeding five million ringgit. Issue of permit for commercial or potential commercial purpose"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_13__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_13__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_13__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_13__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_13__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_13__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The Competent Authority shall issue a permit for commercial or potential commercial purpose which contains particulars as may be determined by the National Competent Authority in consultation with the Competent Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "Upon issuance of the permit under subsection (1), there shall be no change of use in relation to the biological resource as specified in the permit except upon a fresh application being made and a permit issued under this section."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_13__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_13__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_13__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The Competent Authority may at any time after issuing a permit under subsection (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_13__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_13__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "impose any additional condition on the permit as it thinks necessary or expedient; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_13__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_13__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "amend or revoke any condition imposed on the permit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_13__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Competent Authority invokes subsection (3), the Competent Authority shall give the permit holder a written notice of its intention to do so and opportunity to make written representations within the period specified in the notice."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_13__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "After the expiry of the period specified in the notice, and after considering any representation made by the permit holder, the Competent Authority shall decide whether to impose, vary or revoke any condition under subsection (3)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_13__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The Competent Authority shall give the permit holder a written notice of its decision under subsection (5) as soon as practicable and the decision shall take effect on a date specified in the written notice."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_13__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_13__subsec_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_13__subsec_7__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (2) or any condition imposed on the permit under subsection (3) commits an offence and shall, on conviction, be liable—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_13__subsec_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_13__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "where such person is an individual, to a fine not exceeding two hundred thousand ringgit or to imprisonment for a term not exceeding ten years or to both; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_13__subsec_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_13__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "where such person is a body corporate, to a fine not exceeding five hundred thousand ringgit. Permit for commercial or potential commercial purpose not transferable"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_14__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "A holder of a permit shall not transfer the permit or assign any right, duty, liability or obligation under the permit to any other person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_14__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_14__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) commits an offence and shall, on conviction, be liable—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_14__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_14__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "where such person is an individual, to a fine not exceeding two hundred thousand ringgit or to imprisonment for a term not exceeding ten years or to both; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_14__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_14__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "where such person is a body corporate, to a fine not exceeding five hundred thousand ringgit. Application for permit for non-commercial purpose"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who intends to access a biological resource or traditional knowledge associated with a biological resource, including through an authorized intermediary for non-commercial purpose shall apply for a permit to the relevant Competent Authority in the form and manner as may be prescribed and shall be accompanied with a copy of a statutory declaration duly completed as specified in the Second Schedule and payment of the prescribed fee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "Any activity undertaken under subsection (1) shall be in collaboration with a public higher education institution, public research institution or Government agency, unless the relevant Competent Authority is satisfied that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the applicant is a non-profit organization based or registered in Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "local researchers are involved in the activity; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "a program for capacity building is included in the activity."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_3__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_3__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_3__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_3__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_3__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_3__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_3__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_3__para_k",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_3__para_l",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_3__para_m",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_3__para_n",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_3__para_o",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_3__para_p"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "The Competent Authority may, after receiving the application under subsection (1), approve the application, if the following matters have been satisfied:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the application is not for commercial or potential commercial purpose;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of access to a biological resource or traditional knowledge associated with a biological resource, as the case may be, the applicant has obtained the prior informed consent in accordance with section 23;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the application is not for any threatened taxa;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the application is not for any endemic species, rare species or any species protected under any Federal or State law;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_3__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the access is not likely to result in adverse effects on the livelihood or cultural practices including religious, ceremonial or other traditional or customary practices of indigenous and local communities;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_3__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of access to human genetic resource, its use is not for the purposes contrary to ethical values or the public interest;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_3__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the access may not result in adverse environmental impact which may be difficult to control and mitigate;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_3__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the access may not cause genetic erosion or affect any function of the ecosystem;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_3__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the access may not adversely affect food security;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_3__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the use of the biological resource is not for the purposes contrary to the national or State interest;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_3__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the use of the biological resource is not for the development of biological or chemical weapons, or for military or terrorist purposes;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_3__para_l",
      "@type": "akn:paragraph",
      "eli:number": "l",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the use of the biological resource is not for the purposes associated with genetic use restriction technology;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_3__para_m",
      "@type": "akn:paragraph",
      "eli:number": "m",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the applicant has not committed an offence under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_3__para_n",
      "@type": "akn:paragraph",
      "eli:number": "n",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the applicant has not been adjudicated a bankrupt or, in the case of a company, has not been wound up;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_3__para_o",
      "@type": "akn:paragraph",
      "eli:number": "o",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the application complies with the requirements of this Act or any other written law; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_3__para_p",
      "@type": "akn:paragraph",
      "eli:number": "p",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the use of the biological resources is not contrary to related international agreements or instruments to which Malaysia is a party."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "The Competent Authority shall refuse the application if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "any of the grounds specified in subsection (3) is not fulfilled; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "after consultation with the National Competent Authority, the applicant is from, or otherwise based or operating in, jurisdictions which do not provide for adequate and effective measures that requires biological resources utilized within its jurisdiction to be accessed in accordance with prior informed consent and that mutually agreed terms to be established as provided under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (4), the Competent Authority may issue a permit relating to paragraphs (3)(c) and (d) if the Competent Authority is satisfied that the application for permit does not undermine the conservation and sustainable use of biodiversity."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_6__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "After giving due consideration to the application under subsections (1) and (3), the Competent Authority may—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "approve the application, with or without condition, and issue a permit to the applicant; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "refuse the application, stating the grounds for refusal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_7__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who accesses a biological resource or traditional knowledge associated with a biological resource without a permit under subsection (1) or contravenes any condition imposed on the permit under subsection (6) commits an offence and shall, on conviction, be liable—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "where such person is an individual, to a fine not exceeding one hundred thousand ringgit or to imprisonment for a term not exceeding seven years or to both; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_15__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "where such person is a body corporate, to a fine not exceeding one million ringgit. Issue of permit for non-commercial purpose"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_16__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_16__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_16__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_16__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_16__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_16__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_16__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_16__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The Competent Authority shall issue a permit for non-commercial purpose which contains particulars as may be determined by the National Competent Authority in consultation with the Competent Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "Upon issuance of the permit under subsection (1), there shall be no change of use in relation to the biological resource as specified in the permit except upon a fresh application being made and a permit issued under this section."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_16__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_16__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_16__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The Competent Authority may at any time after issuing a permit under subsection (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_16__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_16__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "impose any condition on the permit as it thinks necessary or expedient; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_16__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_16__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "amend or revoke any condition imposed on the permit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_16__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Competent Authority invokes subsection (3), the Comptetent Authority shall give the permit holder a written notice of its intention to do so and opportunity to make written representations within the period specified in the notice."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_16__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "After the expiry of the period specified in the notice, and after considering any representation made by the permit holder, the Competent Authority shall decide whether to impose, vary or revolve any condition under subsection (3)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_16__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The Competent Authority shall give the permit holder a written notice of its decision under subsection (5) as soon as practicable and the decision shall take effect on a date specified in the written notice."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_16__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_16__subsec_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_16__subsec_7__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (2) or any condition imposed on the permit under subsection (3) commits an offence and shall, on conviction, be liable—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_16__subsec_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_16__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "where such person is an individual, to a fine not exceeding one hundred thousand ringgit or to imprisonment for a term not exceeding seven years or to both; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_16__subsec_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_16__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "where such person is a body corporate, to a fine not exceeding five hundred thousand ringgit. Decision to be informed"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "The Competent Authority shall inform its decision in writing to the applicant and notify the National Competent Authority as soon as practicable of the outcome of any application relating to permits made under this Act. Circumstances where permit is not required"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_18__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_18__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_18__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III",
      "schema:name": {
        "@language": "en",
        "@value": "No permit is required—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_18__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "by any person employed or studying and carrying out research for non-commercial purpose in or under the authority of, a public higher education institution, public research institution or Government agency within Malaysia, subject to such conditions as may be prescribed and subject to prior informed consent of the relevant indigenous and local community has been obtained for any access to a biological resource and traditional knowledge associated with a biological resource referred to in subsection 23(1);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_18__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "for the exchange of biological resources between persons within a public higher education institution, public research institution or Government agency within Malaysia or between such institutions or agencies within Malaysia for non-commercial purpose, unless otherwise required by a Competent Authority and subject to such conditions as may be prescribed; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_18__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "by any person or institution in or outside Malaysia who accesses a biological resource from a permit holder under subsection 15(1) or the person or institution under paragraph (a), at the request of such permit holder or the person or institution, for the purpose of carrying out or continuing any research for non-commercial purpose. Transfer of biological resource or results of research in relation to biological resource"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_19__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_19__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_19__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_19__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "No person or institution referred to in paragraphs 18(a) and (b) shall transfer any biological resource or traditional knowledge or results of research in relation to a biological resource or traditional knowledge to a person or institution other than that referred to in paragraphs 18(a) and (b) without the prior approval of the Competent Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_19__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "Where the approval is given by the Competent Authority for the transfer, such transfer shall be subject to such conditions as may be prescribed and the transferee shall be required to apply for a permit under this Act, unless otherwise decided by the relevant Competent Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_19__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "A permit holder or the person or institution referred to in paragraphs 18(a) and (b) shall notify the Competent Authority of the access and such access may be subject to such terms and conditions as may be imposed by the Competent Authority. Permit for non-commercial purpose not to be used for commercial purpose"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_20__para_b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "No person issued with a permit for non-commercial purpose, and no person or institution referred to in paragraphs 18(a) and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_20__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "and the transferee referred to in subsection 19(2) shall carry out, or allow others to carry out, research and development for commercial purposes on any biological resource or traditional knowledge associated with the biological resource, unless the person obtains a permit for commercial or potential commercial purpose under section 13 and a benefit sharing agreement has been entered into in accordance with section 22. Possession, etc., of biological resource and traditional knowledge associated with biological resource"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_21__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_21__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_21__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_21__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_21__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who is not an authorized intermediary and who has in his possession or under his control a biological resource or traditional knowledge associated with a biological resource and—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_21__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_21__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "supplies, sells, offers or advertises for sale; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_21__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_21__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "offers for profit, gain or benefit, such biological resource or traditional knowledge associated with a biological resource to a person who requires a permit under this Act commits an offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_21__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_21__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_21__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who commits an offence under subsection (1) shall, on conviction, be liable—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_21__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_21__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "where such person is an individual, to a fine not exceeding five hundred thousand ringgit, or to imprisonment for a term not exceeding ten years or to both; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_21__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_21__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "where such person is a body corporate, to a fine not exceeding five million ringgit. Benefit sharing agreement"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_22__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_22__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_22__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_22__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_22__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_22__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "An applicant for a permit for access to a biological resource or traditional knowledge associated with a biological resource, for commercial or potential commercial purposes shall enter into a benefit-sharing agreement with the resource provider."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_22__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "A benefit-sharing agreement shall be based upon mutually agreed terms and provide for fair and equitable benefit sharing."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_22__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Federal Government or State Authority is not the resource provider under subsection (1), it may require the applicant to pay a percentage of any monetary benefits derived under the benefit sharing agreement as it may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_22__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "Any such monetary benefits shall be deposited into a fund as may be established by the Federal Government or State Government."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_22__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "The Competent Authority shall use any payment or any part of the payment received under this Part towards the conservation of biodiversity and the sustainable use of its components and for such other incidental expenses. Requirement for prior informed consent and mutually agreed terms, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "The prior informed consent of the relevant indigenous and local community shall be obtained for any access to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a biological resource on land to which such indigenous and local community have a right as established by law; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "traditional knowledge associated with a biological resource that is held by such indigenous and local community."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "The prior informed consent of indigenous and local communities shall be obtained in accordance with customary laws and practices, protocols and procedures of indigenous and local communities, as the case may be."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who intends to access the biological resource or traditional knowledge in subsection (1) for commercial or potential commercial purposes under subsection 12(1) shall enter into a benefit sharing agreement with the relevant indigenous and local community."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "Any prior informed consent shall be obtained from and benefit sharing agreement entered into with—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "the representative, organisation or body identified in accordance with the customary laws and practices, protocols and procedures of the said indigenous and local communities; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23__subsec_4__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23__subsec_4__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "where no such representative or organisation of the traditional knowledge associated with a biological resource can be identified—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23__subsec_4__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23__subsec_4__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "with the holders of the traditional knowledge associated with a biological resource within the indigenous and local communities; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23__subsec_4__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23__subsec_4__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "with the Federal Government or State Authority, as the case may be, if the holders of the traditional knowledge associated with a biological resource cannot be identified."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "Any monetary benefit obtained from the benefit sharing agreement entered under subparagraph (4)(b)(ii) shall be deposited into a fund as may be established by the Federal or the State Government and any benefit, including where applicable non- monetary benefit, shall be applied for the interest of indigenous and local communities taking into account the advice of the advisory body established under subsection 9(2)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23__subsec_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23__subsec_6__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "Where the same traditional knowledge associated with a biological resource is shared by more than one indigenous or local community—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23__subsec_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "the applicant shall obtain the prior informed consent of and enter into benefit sharing agreement with the duly identified representative or organization of all the holders of the traditional knowledge associated with the biological resource; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23__subsec_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "where it is not practicable in all the circumstances of the case to ascertain all such holders, and this is proven to the satisfaction of the Competent Authority, the applicant shall obtain the prior informed consent of, and enter into the benefit sharing agreement with the duly identified representatives or organisation of such of the holders as the applicant may ascertain."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23__subsec_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23__subsec_7__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23__subsec_7__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "In the event that there is a claim by any indigenous and local community that it is the rightful holder of the traditional knowledge associated with a biological resource after the application is approved, the Competent Authority shall—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23__subsec_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "determine the said claim in consultation with the indigenous and local community whose prior informed consent has been obtained and benefit sharing agreement entered into;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23__subsec_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "if the claim is proven to the satisfaction of the Competent Authority, declare that the said indigenous and local community is entitled to share the benefits due to the indigenous and local community under the benefit sharing agreement; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23__subsec_7__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_III__cl_23__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "determine the quantum or nature of benefits to which the indigenous and local community is entitled under paragraph (b), in consultation with all the indigenous and local communities concerned."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_10__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_10__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_10__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_10__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_10__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The Competent Authorities shall have the following functions:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_10__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_10__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to deal with all the applications for access to a biological resource or traditional knowledge associated with a biological resource within its jurisdiction and the sharing of benefits arising from the utilisation of the biological resource or traditional knowledge associated with a biological resource;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_10__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_10__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to maintain a record of all access applications and decisions relating to such applications, including the permits issued;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_10__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_10__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to prepare an annual report concerning such access applications and decisions relating to such applications including permits issued and to submit the report and copies of the permits to the National Competent Authority on or before such date as the National Competent Authority may determine; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_10__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_10__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to do such other things as it deems fit to enable it to perform its functions effectively or which are incidental to the performance of its functions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The Competent Authorities shall have the powers to do all things necessary or expedient for or in connection with the performance of its functions under this Act. Advisory Committee"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_11__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_11__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_11__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "The National Competent Authority shall establish an Advisory Committee and appoint such number of persons with experience, knowledge and expertise on matters relating to the scientific, legal, technical, ethical and other relevant disciplines to be the members of the Advisory Committee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "The members of Advisory Committee appointed under subsection (1) and any other person invited to any meeting of the Advisory Committee may be paid such allowances and other expenses as the National Competent Authority may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_11__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "A member of the Advisory Committee appointed under subsection (1) shall, unless he sooner resigns or vacates his office or his appointment is sooner revoked, hold office for a term not exceeding two years and shall be eligible for reappointment."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_11__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "The Advisory Committee shall, upon request, provide advice on scientific, legal, technical, ethical and other relevant disciplines to the National Competent Authority and the Competent Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_7__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "An authority to be known as the “National Competent Authority” is established."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_7__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_7__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "The National Competent Authority shall consist of the following members:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_7__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_7__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Secretary General of the Ministry responsible for natural resources and environment who shall be the Chairman; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_7__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_7__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "such number of persons to be appointed by the Minister. Functions of the National Competent Authority"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_8__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_8__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_8__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_8__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_8__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_8__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_8__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_8__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_8__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_8__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_8__para_k"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "The National Competent Authority shall have the following functions:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "to coordinate the implementation and enforcement of the provisions of this Act by the Competent Authorities;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "to determine the fees payable upon consultation with the Competent Authorities;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_8__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "to communicate with other countries and the secretariat established under any treaty, agreement, convention or protocol relating to access and benefit sharing in relation to a biological resource, as appropriate, on matters under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_8__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "to implement and to fulfill the requirements under any treaty, agreement, convention or protocol relating to access and benefit sharing in relation to a biological resource to which Malaysia is a party where such treaty, agreement, convention or protocol relates to the purposes of this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_8__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "to create awareness and to provide training, education and information relating to access and benefit sharing in relation to a biological resource;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_8__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "to keep and maintain a register of permits issued by the Competent Authorities and information relating to the permit;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_8__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "to establish measures under subsection 30(1) with the aim of monitoring and tracking of a biological resource or traditional knowledge associated with a biological resource accessed;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_8__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "to support customary laws and practices of indigenous and local communities, and the development of community protocols and procedures by the indigenous and local communities, as the case may be;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_8__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "to establish and maintain a clearing house mechanism under section 32;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_8__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "to act as Competent Authority for all ex-situ collections where the origin of the biological resource cannot be ascertained with due diligence and which do not come within the jurisdiction of any other Competent Authority; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_8__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "to do such other things as it deems fit to enable it to perform its functions effectively or which are incidental to the performance of its functions. Competent Authorities"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_9__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_9__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_9__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_9__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "The Competent Authorities as specified in the First Schedule shall have jurisdiction over all matters relating to access to a biological resource in the region as specified in the First Schedule."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "The Competent Authorities shall establish an advisory body to deal with matters relating to indigenous and local communities and traditional knowledge associated with the biological resource comprising representatives of indigenous and local communities whose advice shall be sought and taken into account."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_9__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "The Competent Authorities may, if it thinks necessary, establish such committee to facilitate the carrying out of its functions under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_9__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "Any member of advisory body appointed under subsection (2), other person invited to any meeting of the advisory body and member of committee established under subsection (3) may be paid such allowances and other expenses as the Competent Authorities may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_9__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "The Competent Authorities shall consult and seek the advice of the National Competent Authority in the exercise of its powers and performance of its functions under this Act. Functions and powers of the Competent Authorities"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_24",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_25",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_26",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_27"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "PERMIT, REGISTER, RECORDS AND DISPOSAL Permit as evidence of compliance"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_24__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_24__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_24__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "The Competent Authority shall, upon issuance of the permit under section 13 or 16, forward to the National Competent Authority a copy of such permit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_24__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_24__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_24__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_24__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_24__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_24__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_24__subsec_2__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "The permit referred to in subsection (1) shall be evidence of the following information:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_24__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_24__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the prior informed consent of the Competent Authority for access to the biological resource;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_24__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_24__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the prior informed consent of the indigenous and local community under section 23 for access to a biological resource or traditional knowledge associated with a biological resource, as the case may be;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_24__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_24__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the origin of the biological resource accessed;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_24__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_24__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the establishment of a benefit sharing agreement with the resource provider where applicable;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_24__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_24__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the person to whom the permit is issued; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_24__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_24__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the use for which the permit is issued. Register of permits"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "The National Competent Authority shall keep and maintain a register of permits issued by the Competent Authorities. Records"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_26__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_26__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_26__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_26__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_26__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_26__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_26__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_26__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_26__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_26__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_26__subsec_1__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who is issued with a permit for access to a biological resource or traditional knowledge associated with a biological resource shall keep the following record:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_26__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_26__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the description of the biological resource or traditional knowledge associated with the biological resource, including available unique identifiers;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_26__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_26__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the date or dates of access;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_26__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_26__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the place of access;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_26__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_26__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the quantity or size of the biological resource (such as weight or physical dimension);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_26__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_26__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the common and scientific name of, or given to, the biological resource;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_26__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_26__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the location where the biological resource is kept; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_26__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_26__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the particulars about any subsequent physical disposition of the biological resource, including the names and addresses of others having possession of the biological resource or a part of the biological resource."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_26__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "A copy of the records referred to in subsection (1) shall be furnished to the National Competent Authority and Competent Authority within thirty days after the biological resource is taken or any other period as determined by the National Competent Authority and Competent Authority, respectively."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_26__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "A record referred to in subsection (1) shall be kept by the permit holder while the biological resource or traditional knowledge associated with a biological resource is in the holder’s possession and for twenty years after the end of the period of use. Disposal of biological resource"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_27__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_27__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_27__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "If a permit holder does not intend to keep the biological resource for which the holder has a record in accordance with subsection 26(1), the permit holder shall offer the biological resource to the Competent Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_27__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IV__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "If the Competent Authority does not agree to take the biological resource in the circumstances mentioned in subsection (1), the permit holder shall dispose of the biological resource in a manner as may be determined by the Competent Authority and the permit holder shall forthwith furnish a report of the disposal of the biological resource to the Competent Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX",
      "@type": "akn:part",
      "eli:number": "IX",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_35",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_36",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_37",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_38",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_39",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_40",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_41",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_42",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_43",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_45",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_46",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_47",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_48",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_49"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "POWERS RELATING TO ENFORCEMENT, SEIZURE, ARREST, ETC. Enforcement officers"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_35",
      "@type": "akn:clause",
      "eli:number": "35",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX",
      "schema:text": {
        "@language": "en",
        "@value": "The enforcement officers are any officer appointed by the Minister upon recommendation of the Competent Authority. Power of investigation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_36",
      "@type": "akn:clause",
      "eli:number": "36",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_36__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_36__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_36__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_36__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "An enforcement officer shall have all the powers necessary to carry out an investigation under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_36__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "In any case relating to the commission of an offence under this Act, any enforcement officer carrying out an investigation may exercise all or any of the special powers in relation to police investigation in seizable cases given by the Criminal Procedure Code [Act 593]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_36__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "This section shall not be construed as limiting or affecting any similar powers conferred on any person under any other written law. Authority card"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_37",
      "@type": "akn:clause",
      "eli:number": "37",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_37__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_37__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_37__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "There shall be issued to each enforcement officer under section 35 an authority card to be signed by an officer duly designated by the relevant Competent Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_37__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "Whenever such enforcement officer exercises any of the powers under this Act, he shall, on demand, produce to the person against whom the power is being exercised the authority card issued to him under subsection (1). Power to enter premises"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_38__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_38__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_38__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX",
      "schema:name": {
        "@language": "en",
        "@value": "An enforcement officer may at any time enter any premises for the purpose of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_38__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "inspecting any biological resource, conveyance, machinery, contrivance, equipment, book, record, document or other article as he considers necessary;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_38__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "verifying the accuracy of records or statements or any information given to an enforcement officer; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_38__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "collecting any biological resource. Access to computerized data"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX",
      "schema:text": {
        "@language": "en",
        "@value": "Any enforcement officer conducting a search under this Act shall be given access to computerized data whether stored in a computer or otherwise, and for such purpose, shall be provided with the necessary password, encryption code, decryption code, software or hardware and any other means required to enable comprehension of computerized data. Seizure of thing, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX",
      "schema:text": {
        "@language": "en",
        "@value": "Any biological resource, conveyance, machinery, contrivance, equipment, book, record, document or other article that an enforcement officer reasonably suspects has been used or will be used in the commission of any offence under this Act may be seized and detained by the enforcement officer. Power to stop, search and seize conveyances"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_41",
      "@type": "akn:clause",
      "eli:number": "41",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_41__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_41__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_41__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_41__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "If an enforcement officer has reasonable cause to suspect that any conveyance is carrying any biological resource, machinery, contrivance, equipment, book, record, document or other article in respect of which an offence under this Act is being or has been committed, he may stop and examine the conveyance and may, if on examination he has reasonable cause to believe that such conveyance is or has been used for the commission of such offence, seize such conveyance and any biological resource, machinery, contrivance, equipment, book, record, document or other article found in the conveyance that is reasonably believed to furnish evidence of the commission of such offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_41__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_41__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_41__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "The person in control or in charge of the conveyance shall, if required to do so by the enforcement officer—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_41__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_41__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "stop the conveyance and allow the enforcement officer to examine it; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_41__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_41__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "open all parts of the conveyance for examination and take all measures necessary to enable or facilitate the carrying out of such examination as the enforcement officer considers necessary."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_41__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "A person who contravenes subsection (2) commits an offence and shall, on conviction, be liable to a fine not exceeding one hundred thousand ringgit or imprisonment for a term not exceeding seven years or to both. Notice of seizure"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_42",
      "@type": "akn:clause",
      "eli:number": "42",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_42__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_42__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_42__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_42__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "Where any seizure is made under this Act, the enforcement officer making the seizure shall give a notice in writing of the seizure and the grounds of the seizure to the owner of the biological resource, conveyance, machinery, contrivance, equipment, book, record, document or other article seized by delivering a copy of such notice to the owner, if the owner or his whereabouts are known."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_42__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_42__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_42__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_42__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "A notice under subsection (1) need not be given if the seizure is made in the presence of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_42__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_42__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the owner or his agent;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_42__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_42__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the occupier of the premises; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_42__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_42__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the person in control or in charge of the conveyance where the seizure is made under section 40."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_42__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "Where any biological resource, conveyance, machinery, contrivance, equipment, book, record, document or other article are stored, kept or found, the enforcement officer seizing the items shall prepare a list of the items seized and immediately deliver a copy signed by him to the owner or person in charge of the place, premises or conveyance which has been searched, or to such owner’s or person’s agent or servant, at that place, premises or conveyance. Temporary return of conveyance, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_43",
      "@type": "akn:clause",
      "eli:number": "43",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_43__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_43__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_43__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "Where any conveyance, machinery, contrivance or equipment is seized under this Act, the court may temporarily return the conveyance, machinery, contrivance or equipment to the owner of the conveyance, machinery, contrivance or equipment or the person from whose possession, custody or control it was seized, subject to such terms and conditions as the court may impose, and subject in any case to sufficient security being furnished to the satisfaction of the court that the conveyance, machinery, contrivance or equipment shall be surrendered to the court on demand and that such terms and conditions, if any, shall be complied with."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_43__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_43__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_43__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "Where any seized conveyance, machinery, contrivance or equipment is temporarily returned under subsection (1), a person who—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_43__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_43__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "fails, on demand, to surrender the conveyance, machinery, contrivance or equipment to the court; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_43__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_43__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "contravenes any of the terms or conditions imposed under subsection (1), commits an offence and shall, on conviction, be liable to a fine not exceeding one hundred thousand ringgit or to imprisonment for a term not exceeding seven years or to both. Forfeiture of seized biological resource, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44",
      "@type": "akn:clause",
      "eli:number": "44",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44__subsec_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44__subsec_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44__subsec_11"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "Any biological resource, conveyance, machinery, contrivance, equipment, book, record, document or other article seized in exercise of any power conferred under this Act shall be liable to forfeiture."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44__subsec_10",
      "@type": "akn:subsection",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44__subsec_10__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44__subsec_10__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall be liable under subsection (9) unless the decision of repatriation has been made by the Competent Authority within—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44__subsec_10__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44__subsec_10",
      "schema:text": {
        "@language": "en",
        "@value": "where there are no proceedings instituted, twelve months from the date on which the biological resource were imported into Malaysia; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44__subsec_10__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44__subsec_10",
      "schema:text": {
        "@language": "en",
        "@value": "six months from the date the proceedings for the offence in connection with such importation into Malaysia are concluded."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44__subsec_11",
      "@type": "akn:subsection",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44__subsec_11__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44__subsec_11__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (9) commits an offence and shall, on conviction, be liable—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44__subsec_11__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44__subsec_11",
      "schema:text": {
        "@language": "en",
        "@value": "where such person is an individual, to a fine not exceeding one hundred thousand ringgit or to imprisonment for a term not exceeding seven years or to both; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44__subsec_11__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44__subsec_11",
      "schema:text": {
        "@language": "en",
        "@value": "where such person is a body corporate, to a fine not exceeding one hundred and fifty thousand ringgit. Property in forfeited biological resource, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "An order for the forfeiture of any biological resource, conveyance, machinery, contrivance, equipment, book, record, document or other article shall be made if it is proved to the satisfaction of the court that an offence under this Act has been committed and that the biological resource, conveyance, machinery, contrivance, equipment, book, record, document or other article was the subject matter of or was used in the commission of the offence, even though no person has been convicted of such offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "If there is no prosecution with regard to any biological resource, conveyance, machinery, contrivance, equipment, book, record, document or other article seized under this Act, such biological resource, conveyance, machinery, contrivance, equipment, book, record, document or other article shall be taken and deemed to be forfeited at the expiration of a period of one calendar month from the date of service of a notice to the last known address of the person from whom the biological resource, conveyance, machinery, contrivance. equipment, book, record, document or other article was seized indicating that there is no prosecution in respect of such biological resource, conveyance, machinery, contrivance, equipment, book, record, document or other article unless before the expiration of that period a claim thereto is made in the manner set out in subsections (4), (5), (6) and (7)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "Any person asserting that he is the owner of the biological resource, conveyance, machinery, contrivance, equipment, book, record, document or other article referred to in subsection (3) and that it is not liable to forfeiture may personally or by his agent authorized in writing, give written notice to the enforcement officer in whose possession such biological resource, conveyance, machinery, contrivance, equipment, book, record, document or other article is held that he claims the biological resource, conveyance, machinery, contrivance, equipment, book, record, document or other article."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "On receipt of the notice referred to in subsection (4), the enforcement officer shall refer the claim to a Magistrate for his decision."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "The Magistrate to whom a matter is referred under subsection (5) shall issue a summons requiring the person asserting that he is the owner of the biological resource, conveyance, machinery, contrivance, equipment, book, record, document or other article and the person from whom it was seized to appear before him, and when they appear or they fail to appear, due service of the summons having been proved, the Magistrate shall proceed to the examination of the matter."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "If it is proved that an offence under this Act or any of its subsidiary legislation has been committed and that the biological resource, conveyance, machinery, contrivance, equipment, book, record, document or other article referred to in subsection (6) was the subject matter of or was used in the commission of such offence, the Magistrate shall order the biological resource, conveyance, machinery, contrivance, equipment, book, record, document or other article to be forfeited, and shall, in the absence of such proof, order its release."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "Any biological resource, conveyance, machinery, contrivance, equipment, book, record, document or other article forfeited or deemed to be forfeited shall be delivered to the Competent Authority and shall be disposed of in such manner as the Competent Authority thinks fit, including repatriation under subsection (9) if the Competent Authority so decides."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44__subsec_9__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44__subsec_9__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "When a decision of repatriation is made under this Act in respect of any biological resource which has been imported into Malaysia in contravention of this Act, and the biological resource was brought into Malaysia in a conveyance, the owner or importer of the biological resource or his agent shall, if required in writing by the Competent Authority, provide or be responsible for—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44__subsec_9__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44__subsec_9",
      "schema:text": {
        "@language": "en",
        "@value": "the free passage for the return of the biological resource to the place at which the biological resource was shipped to Malaysia, or to any other port or place designated by the Competent Authority; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44__subsec_9__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_44__subsec_9",
      "schema:text": {
        "@language": "en",
        "@value": "where required, proper maintenance and storage of the biological resource during the voyage, flight or journey."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_45",
      "@type": "akn:clause",
      "eli:number": "45",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX",
      "schema:text": {
        "@language": "en",
        "@value": "Any biological resource, conveyance, machinery, contrivance, equipment, book, record, document or other article forfeited or deemed to be forfeited under this Act shall be the property of the Competent Authority. Release of seized biological resource, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_46",
      "@type": "akn:clause",
      "eli:number": "46",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding section 44, the Competent Authority may, where it thinks fit, at any time direct that any biological resource, conveyance, machinery, contrivance, equipment, book, record, document or other article seized under this Act be released to the person from whose possession, custody or control it was seized. Cost of holding seized biological resource, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_47",
      "@type": "akn:clause",
      "eli:number": "47",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX",
      "schema:text": {
        "@language": "en",
        "@value": "Where any biological resource, conveyance, machinery, contrivance, equipment, book, record, document or other article seized or surrendered under this Act is held in the custody of the Competent Authority pending completion of any proceedings in respect of an offence under this Act, the cost of holding it in custody shall, in the event of any person being convicted of such offence, be a debt due to the Competent Authority or Government, as the case may be, by such person and shall be recoverable accordingly. No costs or damages arising from seizure to be recoverable"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_48",
      "@type": "akn:clause",
      "eli:number": "48",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall in any proceedings before any court in respect of the seizure of any biological resource, conveyance, machinery, contrivance, equipment, book, record, document or other article seized or surrendered in the exercise or the purported exercise of any power conferred under this Act, be entitled to the costs of such proceedings or to any damages or other relief unless such seizure was made without reasonable cause. Additional powers"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_49",
      "@type": "akn:clause",
      "eli:number": "49",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_49__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_49__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_49__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_49__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_49__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_49__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_49",
      "schema:text": {
        "@language": "en",
        "@value": "An enforcement officer shall, for the purposes of the execution of this Act or any of its subsidiary legislation, have power to do all or any of the following acts:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_49__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_49__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to require the production of records, accounts and documents and to inspect, examine and copy any of the records, accounts and documents;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_49__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_49__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to require the production of any identification document from any person in relation to any case or offence under this Act or any of its subsidiary legislation;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_49__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_49__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to make such enquiry as may be necessary to ascertain whether the provisions of this Act or any of its subsidiary legislation have been complied with."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_49__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_IX__cl_49",
      "schema:text": {
        "@language": "en",
        "@value": "A person who fails to comply with a request made under subsection (1) commits an offence and shall, on conviction, be liable to a fine not exceeding one hundred thousand ringgit or to imprisonment for a term not exceeding seven years or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_1__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_1__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Access to Biological Resources and Benefit Sharing Act 2017."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subsection (3), this Act comes into operation on a date to be appointed by the Minister by notification in the Gazette and the Minister may appoint different dates for the coming into operation of different provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_1__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation in the States of Sabah and Sarawak on such date as the Minister may, after consultation with the State Authorities, appoint by notification in the Gazette. Non-application of the Act"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall not apply to the specific biological or genetic resource covered by and for the purpose of any specialized instrument on access to biological resources and benefit sharing to which Malaysia is a party. Act to be read with other laws"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_3__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_3__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall be read together with any other written laws relating to access to biological resources and benefit sharing arising from the utilization of the biological resource."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "The provisions of this Act shall be in addition to, and not in derogation of, the provisions in any other law for the time being in force, relating to forests, wildlife, animals, fishery and international trade in endangered species, except for matters that fall within the provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_3__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "Nothing in this Act shall be interpreted as restricting the right of a State to take action relating to access to biological resources and benefit sharing arising from their utilization, provided that such action is consistent with the objective and provisions of this Act. Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
