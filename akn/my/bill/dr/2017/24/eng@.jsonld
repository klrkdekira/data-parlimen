      "schema:text": {
        "@language": "en",
        "@value": "any readily recognizable part or derivative of an animal;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_4__list_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_4__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "wildlife as defined under the Wildlife Conservation Act 2010 [Act 716]; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_4__list_1__para_d",
