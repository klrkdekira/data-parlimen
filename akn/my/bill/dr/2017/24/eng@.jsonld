      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_4__list_6",
      "schema:text": {
        "@language": "en",
        "@value": "in relation to an animal, to harvest, catch, capture, trap and kill or obtain in any other way;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_4__list_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_4__list_6",
      "schema:text": {
        "@language": "en",
        "@value": "in relation to a plant specimen, to collect, harvest, pick, gather and cut or obtain in any other way;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_4__list_6__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_4__list_6",
      "schema:text": {
        "@language": "en",
        "@value": "in relation to other biological resources including microorganisms, to collect, pick or obtain in any other way; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_4__list_6__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_4__list_6",
      "schema:text": {
        "@language": "en",
        "@value": "to obtain a biological resource in any other way; “threatened taxa” means critically endangered, endangered or vulnerable species as listed respectively in Appendices I, II and III of the Third Schedule of the International Trade in Endangered Species Act 2008 [Act 686]. Access to a biological resource"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_5__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_5__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_5__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "A person is said to have access to a biological resource if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_5__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the taking of a biological resource from its natural habitat or place where it is kept, grown or found including in the market for the purpose of research and development; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_5__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "there is a reasonable prospect as determined by the Competent Authority that a biological resource taken by the person will be subject to research and development."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_5__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_5__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_5__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_5__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_5__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_5__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_5__subsec_2__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_5__subsec_2__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_5__subsec_2__para_i"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "Access to a biological resource shall not include the following activities:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_5__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "fishing for commerce, recreation or game;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_5__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "taking animals or plants for food;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_5__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "taking biological resource that has been cultivated or tended for any purpose other than the purpose of research and development;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_5__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "taking natural produce including oils and honey for any purpose other than the purpose of research and development;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_5__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "collecting plant reproductive material for propagation;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_5__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "carrying out commercial forestry;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_5__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "in relation to indigenous and local communities, for the use and exchange of the biological resource among themselves in the exercise of their traditional and customary practices;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_5__subsec_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "taking of a biological resource by any person that is—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_5__subsec_2__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_5__subsec_2__para_i__subpara_ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "a living modified organism as defined in the Biosafety Act 2007 [Act 678] for which intellectual property rights have been granted and subsist; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_5__subsec_2__para_i__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_5__subsec_2__para_i__subpara_ii__subpara_i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_5__subsec_2__para_i",
      "schema:text": {
        "@language": "en",
        "@value": "a plant variety for which a breeder’s right has been granted and subsists under the Protection of New Plant Varieties Act 2004 [Act 634]; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_5__subsec_2__para_i__subpara_ii__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_5__subsec_2__para_i__subpara_ii",
      "schema:text": {
        "@language": "en",
        "@value": "access to a biological resource exempted under section 60. Small farmers’ rights"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_6__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_6__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_6__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "Nothing in this Act shall be interpreted to limit the right of a small farmer—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_6__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_6__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to save, use, exchange and sell farm-saved seed or propagating material; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_6__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_6__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to undertake conventional breeding or traditional practices in use in agriculture, horticulture, poultry farming, dairy farming, animal husbandry or bee keeping."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this section, “small farmer” has the meaning assigned to it in the Protection of New Plant Varieties Act 2004."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_V",
      "@type": "akn:part",
      "eli:number": "V",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_V__cl_28",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_V__cl_29"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "REVOCATION OF PERMITS AND APPEALS Revocation of permit"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VI",
      "@type": "akn:part",
      "eli:number": "VI",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VI__cl_30",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VI__cl_31"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "MONITORING AND TRACKING Measures for monitoring and tracking"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VII",
      "@type": "akn:part",
      "eli:number": "VII",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VII__cl_32",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VII__cl_33"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "CLEARING HOUSE MECHANISM Establishment of clearing house mechanism"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VIII",
      "@type": "akn:part",
      "eli:number": "VIII",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VIII__cl_34",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "USER MEASURES Measures to support laws of other countries"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VIII__cl_34",
      "@type": "akn:clause",
      "eli:number": "34",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VIII__cl_34__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VIII__cl_34__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VIII__cl_34__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VIII__cl_34__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VIII__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "Any person shall provide permit or its equivalent as evidence of compliance with the law or other regulatory requirements of a Party to the Nagoya Protocol to the relevant authority, before using or commercialising biological resource or traditional knowledge associated with a biological resource accessed from the jurisdiction of such Party, if that Party requires such permit or its equivalent."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VIII__cl_34__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VIII__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of subsection (1), the National Competent Authority shall establish measures aimed at preventing the use or commercialisation within Malaysia of a biological resource or traditional knowledge associated with a biological resource, which is not accompanied by a permit or its equivalent."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VIII__cl_34__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VIII__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "A notification by a Competent Authority of the other Party to the Protocol to the National Competent Authority that it has not issued a permit or its equivalent for access to its biological resource or traditional knowledge associated with a biological resource, or mutually agreed terms have been established, shall be prima facie evidence of the notification."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VII__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "The National Competent Authority shall establish and maintain a clearing house mechanism as a means for sharing of information relating to access and benefit sharing and information provided by a Competent Authority to the National Competent Authority as required by this Act. Posting and confidential information"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VII__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VII__cl_33__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VII__cl_33__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VII__cl_33__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VII__cl_33__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VII__cl_33__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VII__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "A copy of the permit including the information in the permit sent to the National Competent Authority under this Act shall, at the same time, be posted on the website of the clearing house mechanism by any authorized person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VII__cl_33__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VII__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "The information under subsection (1) shall not be posted if it is classified as confidential as determined by the relevant Competent Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VII__cl_33__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VII__cl_33__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VII__cl_33__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VII__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of subsection (2), information is classified to be confidential if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VII__cl_33__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VII__cl_33__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "it is culturally sensitive; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VII__cl_33__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VII__cl_33__subsec_3__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VII__cl_33__subsec_3__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VII__cl_33__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "disclosed, it may—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VII__cl_33__subsec_3__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VII__cl_33__subsec_3__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "damage a person’s commercial interests;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VII__cl_33__subsec_3__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VII__cl_33__subsec_3__para_b__subpara_ii__subpara_i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VII__cl_33__subsec_3__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "result in a risk to the biodiversity; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VII__cl_33__subsec_3__para_b__subpara_ii__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VII__cl_33__subsec_3__para_b__subpara_ii",
      "schema:text": {
        "@language": "en",
        "@value": "be detrimental to the national interest."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VII__cl_33__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VII__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "Any determination as to confidentiality under subparagraph (3)(b)(i) shall be made upon the application of the applicant."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VI__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VI__cl_30__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VI__cl_30__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VI__cl_30__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VI__cl_30__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VI__cl_30__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VI__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "The National Competent Authority, in consultation with the Competent Authority and other relevant agencies shall establish measures for the purpose of monitoring and tracking the biological resource or traditional knowledge associated with a biological resource."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VI__cl_30__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VI__cl_30__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VI__cl_30__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VI__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "Such measures shall include—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VI__cl_30__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VI__cl_30__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the designation of checkpoints; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VI__cl_30__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VI__cl_30__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the requirement for the production of the permit at the checkpoints established."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VI__cl_30__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VI__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "The checkpoints designated under paragraph (2)(a) shall include offices or authorities dealing with applications for patent, product registration or approval and public research funding grants."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VI__cl_30__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VI__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "The authorities responsible for the checkpoints shall inform the National Competent Authority and the relevant Competent Authority in writing of the production of the permit under paragraph (2)(b). Notification for application of patent"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VI__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VI__cl_31__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VI__cl_31__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VI__cl_31__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VI__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "Any person applying for a patent, whether in or outside Malaysia, in relation to a biological resource or traditional knowledge associated with a biological resource accessed shall notify to the National Competent Authority in writing within thirty days from the date of the application."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VI__cl_31__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VI__cl_31__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VI__cl_31__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VI__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) commits an offence and shall, on conviction, be liable—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VI__cl_31__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VI__cl_31__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "where such person is an individual, to a fine not exceeding one hundred thousand ringgit or to imprisonment for a term not exceeding seven years or to both; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VI__cl_31__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_VI__cl_31__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "where such person is a body corporate, to a fine of not exceeding five hundred thousand ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_V__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_V__cl_28__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_V__cl_28__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_V__cl_28__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_V__cl_28__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_V__cl_28__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_V__cl_28__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_V__cl_28__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_V__cl_28__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_V__cl_28__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_V__cl_28__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_V__cl_28__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_V__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "The Competent Authority may at any time revoke any permit issued under this Act on all or any of the following grounds:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_V__cl_28__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_V__cl_28__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the permit holder has contravened any provisions of this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_V__cl_28__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_V__cl_28__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the permit holder has contravened any of the conditions of the permit;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_V__cl_28__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_V__cl_28__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the permit was issued as a result of false, misleading or inaccurate information;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_V__cl_28__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_V__cl_28__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the permit was obtained improperly or illegally; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_V__cl_28__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_V__cl_28__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the permit holder has been convicted of an offence under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_V__cl_28__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_V__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "Before revoking the permit, the Competent Authority shall give the permit holder an opportunity to be heard."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_V__cl_28__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_V__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Competent Authority revokes the permit under subsection (1), the Competent Authority shall immediately notify the permit holder and the National Competent Authority of the decision and grounds for the revocation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_V__cl_28__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_V__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "Upon such notification, the permit holder shall immediately surrender the permit, any research results and related documents, and the accessed biological resource to the Competent Authority that issued the permit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_V__cl_28__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_V__cl_28__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_V__cl_28__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_V__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "Any permit holder who contravenes subsection (4) commits an offence and shall, on conviction, be liable—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_V__cl_28__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_V__cl_28__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "where such person is an individual, to a fine not exceeding two hundred thousand ringgit or to imprisonment for a term not exceeding ten years or to both, and in the case of a continuing offence, to a further fine not exceeding five thousand ringgit for each day during which the offence continues after conviction; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_V__cl_28__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_V__cl_28__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "where such person is a body corporate, to a fine not exceeding five hundred thousand ringgit, and in the case of a continuing offence, to a further fine not exceeding ten thousand ringgit for each day during which the offence continues after conviction. Appeal against revocation of permit"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_V__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_V__cl_29__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_V__cl_29__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_V__cl_29__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_V__cl_29__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_V__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "A person who is aggrieved by the revocation of the permit may, within thirty days after being informed in writing of the revocation, appeal against such decision to the Court."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_V__cl_29__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_V__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "The Court may, after considering an appeal made under subsection (1), confirm or set aside the decision appealed against."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_V__cl_29__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_V__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this section, “Court” means the High Court of Malaya and the High Court in Sabah and Sarawak or either of the High Court in Malaya and the High Court in Sabah and Sarawak, as the case may require."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X",
      "@type": "akn:part",
      "eli:number": "X",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_50",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_51",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_52",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_53",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_54",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_55",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_56",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_57",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_58",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_59",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_60",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_61",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_63"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "GENERAL Payment into fund"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_50",
      "@type": "akn:clause",
      "eli:number": "50",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_50__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_50__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X",
      "schema:text": {
        "@language": "en",
        "@value": "Except for the money received by a Competent Authority under section 22 and subsection 23(5), all moneys received under this Act by a Competent Authority shall be paid into and form part of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_50__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "where the Competent Authority is under the jurisdiction of the Federal Government, the Consolidated Fund; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_50__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "where the Competent Authority is under the jurisdiction of the State Government, the State Consolidated Fund. Compounding of offences"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_51",
      "@type": "akn:clause",
      "eli:number": "51",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_51__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_51__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_51__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_51__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_51__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_51__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_51__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_51__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_51__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_51",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, with the approval of the Public Prosecutor, make regulations prescribing—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_51__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_51__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any offence under this Act and any regulations made under the Act that may be compounded;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_51__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_51__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the criteria for compounding such offence; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_51__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_51__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the method and procedure for compounding such offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_51__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_51",
      "schema:text": {
        "@language": "en",
        "@value": "The Competent Authority may, with the consent in writing of the Public Prosecutor, compound any offence committed by any person under this Act and prescribed to be a compoundable offence by making a written offer to the person suspected to have committed the offence to compound the offence upon payment to the Competent Authority of an amount of money not exceeding fifty per centum of the amount of maximum fine for that offence within such time as may be specified in his written offer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_51__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_51",
      "schema:text": {
        "@language": "en",
        "@value": "An offer under subsection (2) may be made at any time after the offence has been committed but before any prosecution for it has been instituted."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_51__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_51",
      "schema:text": {
        "@language": "en",
        "@value": "If the amount specified in the offer is not paid within the time specified in the offer or such extended time as the Competent Authority may grant, prosecution for the offence may be instituted at any time after that against the person to whom the offer was made."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_51__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_51",
      "schema:text": {
        "@language": "en",
        "@value": "Where an offence has been compounded under subsection (2), no prosecution shall be instituted in respect of the offence against the person to whom the offer to compound was made, and any biological resource, conveyance, machinery, contrivance, equipment, book, record, document or other article seized in connection with the offence may be forfeited or released by the Competent Authority in accordance with sections 44 and 46, subject to such terms and conditions as the Competent Authority thinks fit. Institution of prosecution"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_52",
      "@type": "akn:clause",
      "eli:number": "52",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X",
      "schema:text": {
        "@language": "en",
        "@value": "No prosecution for or in relation to any offence under this Act shall be instituted except by or with the written consent of the Public Prosecutor. False declaration"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_53",
      "@type": "akn:clause",
      "eli:number": "53",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_53__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_53__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_53__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_53__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_53__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_53",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who makes, orally or in writing, signs or furnishes any declaration, return, certificate or other document or information required under this Act which is untrue, inaccurate or misleading in any particular commits an offence and shall, on conviction, be liable—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_53__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_53__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "where such person is an individual, to a fine not exceeding fifty thousand ringgit or to imprisonment for a term not exceeding three years or to both; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_53__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_53__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "where such person is a body corporate, to a fine not exceeding five hundred thousand ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_53__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_53__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_53__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_53",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_53__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_53__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "without lawful authority alters, forges, mutilates or defaces any permit, certificate or registration; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_53__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_53__subsec_2__para_b__subpara_aa",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_53__subsec_2__para_b__subpara_ab"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_53__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "knowingly makes use of any permit, certificate or registration which has been so altered, forged, mutilated or defaced, commits an offence and shall, on conviction, be liable—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_53__subsec_2__para_b__subpara_aa",
      "@type": "akn:subparagraph",
      "eli:number": "aa",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_53__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "where such person is an individual, to a fine not exceeding one hundred thousand ringgit or to imprisonment for a term not exceeding seven years or to both; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_53__subsec_2__para_b__subpara_ab",
      "@type": "akn:subparagraph",
      "eli:number": "ab",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_53__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "where such person is a body corporate, to a fine not exceeding five hundred thousand ringgit. Offence committed by body corporate"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_54",
      "@type": "akn:clause",
      "eli:number": "54",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_54__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_54__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X",
      "schema:text": {
        "@language": "en",
        "@value": "Where a body corporate commits an offence under this Act or any of its subsidiary legislation, any person who at the time of the commission of the offence was a director, manager, secretary or other similar officer of the body corporate or was purporting to act in any such capacity or was in any manner or to any extent responsible for the management of any of the affairs of the body corporate or was assisting in such management—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_54__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_54",
      "schema:text": {
        "@language": "en",
        "@value": "may be charged severally or jointly in the same proceedings with the body corporate; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_54__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_54__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_54__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_54",
      "schema:text": {
        "@language": "en",
        "@value": "where the body corporate is found to have committed the offence, shall be deemed to commit that offence and shall, on conviction, be liable to the penalty applicable to an individual unless, having regard to the nature of his functions in that capacity and to all circumstances, he proves—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_54__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_54__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "that the offence was committed without his knowledge, consent or connivance; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_54__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_54__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "that he took all reasonable precautions and had exercised due diligence to prevent the commission of the offence. Offence by partner, servant or authorised intermediary"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_55",
      "@type": "akn:clause",
      "eli:number": "55",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_55__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_55__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who would have been liable to any penalty under this Act for any act, omission, neglect or default if the act, omission, neglect or default is committed by him personally shall be liable to the same penalty if the act, omission, neglect or default is committed by his partner, servant or authorised intermediary unless he proves—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_55__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_55",
      "schema:text": {
        "@language": "en",
        "@value": "that the act, omission, neglect or default was committed without his knowledge, consent or connivance; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_55__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_55",
      "schema:text": {
        "@language": "en",
        "@value": "that he took all reasonable precautions and had exercised due diligence to prevent the act, omission, neglect or default. Public servant"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_56",
      "@type": "akn:clause",
      "eli:number": "56",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X",
      "schema:text": {
        "@language": "en",
        "@value": "Every member, officer, servant or agent of the National Competent Authority or Competent Authority while discharging his duties as such member, officer, servant or agent shall be deemed to be a public servant within the meaning of the Penal Code [Act 574]. Protection against suit and legal proceedings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_57",
      "@type": "akn:clause",
      "eli:number": "57",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_57__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_57__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X",
      "schema:text": {
        "@language": "en",
        "@value": "No action shall lie or prosecution shall be brought, instituted or maintained in any court against—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_57__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_57",
      "schema:text": {
        "@language": "en",
        "@value": "any member, officer or enforcement officer of the National Competent Authority and Competent Authority; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_57__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_57",
      "schema:text": {
        "@language": "en",
        "@value": "any other person for or on account of or in respect of any act done or purported to be done by him under the order, direction or instruction of the National Competent Authority or Competent Authority, enforcement officer or any other officer duly appointed by the National Competent Authority or Competent Authority, if the act was done in good faith and in a reasonable belief that it was necessary for the purpose intended to be served by it and for the carrying into effect the provisions of this Act. Protection of informers"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_58",
      "@type": "akn:clause",
      "eli:number": "58",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_58__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_58__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_58__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_58__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_58",
      "schema:text": {
        "@language": "en",
        "@value": "Except as provided in subsections (2) and (3), no witness in any civil or criminal proceeding shall be obliged or permitted to disclose the name or address of an informer or the substance of the information received from him or to state any matter which might lead to his discovery."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_58__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_58",
      "schema:text": {
        "@language": "en",
        "@value": "If any book, record, account, document or computerized data which is in evidence or liable to inspection in any civil or criminal proceeding contains any entry in which any informer is named or described or which might lead to his discovery, the court shall cause all such passages to be concealed from view or to be obliterated so far only as may be necessary to protect the informer from discovery."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_58__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_58",
      "schema:text": {
        "@language": "en",
        "@value": "If on the trial for any offence under this Act or any of its subsidiary legislation, the court after full enquiry into the case believes that the informer willfully made in his complaint a material statement which he knew or believed to be false or did not believe to be true, or if in any other proceeding the court is of the opinion that justice cannot be fully done between the parties in that proceeding without the discovery of the informer, the court may require the production of the original complaint, if in writing, and permit enquiry and require full disclosure, concerning the informer. Rewards"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_59",
      "@type": "akn:clause",
      "eli:number": "59",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X",
      "schema:text": {
        "@language": "en",
        "@value": "The National Competent Authority or Competent Authority may order such rewards as it thinks fit to be paid to any person for services rendered in connection with the detection of any offence under this Act or any of its subsidiary legislation, or in connection with any seizures made under this Act. Power to exempt"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_60",
      "@type": "akn:clause",
      "eli:number": "60",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_60__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_60__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_60__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_60__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_60__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_60__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_60__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_60",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, by order published in the Gazette, exempt the following from all or any of the provisions of this Act:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_60__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_60__subsec_1__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_60__subsec_1__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_60__subsec_1__para_a__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_60__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a specific biological resource or a specific collection of biological resources, including future additions to the collection and for such purpose as the Minister may specify, if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_60__subsec_1__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_60__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "the resource is held as a specimen away from its natural environment, whether in a collection or otherwise, by a government department or agency and the access to the biological resource is administered by the said department or agency in a manner consistent with the objective of this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_60__subsec_1__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_60__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "there is a request in writing by the government department or agency holding the biological resource in accordance with subparagraph (1)(a)(i); or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_60__subsec_1__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_60__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "there are existing exchange and use practices that provides for access and benefit sharing of biological resource consistent with the objective of this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_60__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_60__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any person or class of persons or any biological resource, including any use of a biological resource, upon recommendation of the relevant Competent Authority and in consultation with the National Competent Authority and the relevant advisory body established under subsection 9(2) where the interest of indigenous and local communities may be affected, subject to such terms and conditions as the Minister thinks fit to impose."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_60__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_60",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may prescribe different procedures in respect of a specified biological resource or a specified collection of biological resource to promote the conservation of biodiversity."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_60__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_60",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister shall obtain the consent of the relevant State Authority before making any exemption under paragraph (1)(a) where the biological resource is within the jurisdiction of that particular State Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_60__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_60",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, upon recommendation of the relevant Competent Authority and in consultation with the National Competent Authority and the relevant advisory body established under subsection 9(2) where the interest of indigenous and local communities may be affected, revoke any order made under subsection (1) if he satisfied that such exemption should no longer be granted. Power to amend Schedules"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_61",
      "@type": "akn:clause",
      "eli:number": "61",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_61__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_61__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_61__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_61",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subsection (2), the Minister may, by order published in the Gazette, amend the Schedules."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_61__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_61",
      "schema:text": {
        "@language": "en",
        "@value": "The First Schedule may only be amended with the consent of the relevant State Authority. Power to make regulations"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62",
      "@type": "akn:clause",
      "eli:number": "62",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, after consultation with the National Competent Authority and Competent Authority, and where necessary and applicable, the advisory body established under subsection 9(2), make such regulations as may be expedient or necessary for the better carrying out of the provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_2__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_2__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_2__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_2__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_2__para_k",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_2__para_l",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_2__para_m",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_2__para_n"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to the generality of subsection (1), the regulations may be made for the following:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe the manner of applying for access to a biological resource and traditional knowledge associated with a biological resource under this Act, the particulars to be supplied by an applicant, the duration, terms, conditions and restrictions to be impose upon issuance of a permit;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe the terms and conditions for access to a biological resource and traditional knowledge associated with a biological resource under paragraphs 18(a) and (b);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to provide for special procedures for a specified biological resource or a specified collection of biological resource to advance conservation of biodiversity;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to provide for standard procedures or codes for access and benefit sharing for biological resources generally or specified biological resource or collections of biological resource and traditional knowledge associated with a biological resource;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe the manner for access to a biological resource and traditional knowledge associated with a biological resource by an authorised intermediary;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to provide for the cancellation of the permit;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to provide for matters relating to fees and charges;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to provide the procedure for appeals;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_2__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to provide for the composition, allowances, procedures and incidental matters relating to the establishment and conduct of the advisory body, committee and Advisory Committee;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_2__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to provide for the minimum terms for a benefit sharing agreement;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_2__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to provide the measures aimed at preventing the use within Malaysia, of a biological resource or traditional knowledge associated with a biological resource, which is not accompanied by a permit or its equivalent and evidence that mutually agreed terms have been established;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_2__para_l",
      "@type": "akn:paragraph",
      "eli:number": "l",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to provide the measures for the purpose of monitoring and tracking the biological resource accessed;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_2__para_m",
      "@type": "akn:paragraph",
      "eli:number": "m",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to provide the essential elements for obtaining the prior informed consent of the indigenous and local communities; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_2__para_n",
      "@type": "akn:paragraph",
      "eli:number": "n",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to provide for such other matters as are contemplated by, or necessary for giving full effect to, the provisions of this Act and for their due administration."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62",
      "schema:text": {
        "@language": "en",
        "@value": "The regulations made under subsection (1) may prescribe any act in contravention of the regulations to be an offence and may prescribe penalties—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "where such person is an individual, to a fine not exceeding two hundred thousand ringgit or to imprisonment for a term not exceeding ten years or to both; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_62__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "where such person is a body corporate, to a fine not exceeding five hundred thousand ringgit. Transitional provisions"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_63",
      "@type": "akn:clause",
      "eli:number": "63",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_63__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_63__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_63__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_63__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_63__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_63",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who, on the date of the coming into operation of this Act, is accessing a biological resource or traditional knowledge associated with a biological resource to which this Act applies with the consent of the resource provider shall, within twelve months from the date of the coming into operation of this Act, make an application for a permit under section 12 or 15, as the case may be."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_63__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_63",
      "schema:text": {
        "@language": "en",
        "@value": "Pending the determination of such application, such person may continue accessing the biological resource or traditional knowledge associated with a biological resource."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_63__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_63__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_63__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_63",
      "schema:text": {
        "@language": "en",
        "@value": "After the date of the coming into operation of this Act, any person who is in possession of a biological resource or traditional knowledge associated with the biological resource in respect of which this Act would apply and there is no benefit sharing agreement entered, shall enter into such agreement with the resource provider if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_63__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_63__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "there is a new use of the biological resource or traditional knowledge associated with the biological resource; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_63__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_63__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "there is development of a new product arising from the biological resource or traditional knowledge associated with the biological resource."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_63__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_X__cl_63",
      "schema:text": {
        "@language": "en",
        "@value": "Upon the conclusion of the benefit sharing agreement under subsection (3), the Competent Authority shall issue a permit under section 12 for access of the biological resource or traditional knowledge associated with the biological resource."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "[Subsection 9(1)] COMPETENT AUTHORITIES Biological Resource Region Federal Territory of All covered under this Act Kuala Lumpur, Labuan and Putrajaya All covered under this Act Johore All covered under this Act Kedah All covered under this Act Kelantan All covered under this Act Malacca All covered under this Act Negeri Sembilan All covered under this Act Pahang All covered under this Act Penang All covered under this Act Perak All covered under this Act Perlis All covered under this Act Selangor All covered under this Act Terengganu All covered under this Act Sabah All covered under this Act Sarawak"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~sched_2",
      "@type": "akn:schedule",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~sched_2__para_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~sched_2__para_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "[Subsection 15(1)] Form 1 STATUTORY DECLARATION APPLICATION FOR A PERMIT FOR NON-COMMERCIAL PURPOSE I ………………… [name of applicant] (NRIC No./Passport No. ………………) of ……………………………… [address] solemnly and sincerely declare the following:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~sched_2__para_1",
      "@type": "akn:paragraph",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~sched_2__para_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~sched_2__para_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~sched_2__para_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~sched_2__para_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~sched_2__para_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~sched_2",
      "schema:text": {
        "@language": "en",
        "@value": "That in relation to ……………………………………………….. [insert the biological resource, traditional knowledge associated with the biological resource, purpose for access and use], I—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~sched_2__para_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~sched_2__para_1",
      "schema:text": {
        "@language": "en",
        "@value": "do not intend to use the biological resource or traditional knowledge associated with the biological resource, to which the proposed action relates, for commercial or potential commercial purposes;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~sched_2__para_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~sched_2__para_1",
      "schema:text": {
        "@language": "en",
        "@value": "undertake to give a written report on the results of any research on a biological resource or traditional knowledge associated with the biological resource to the Competent Authority;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~sched_2__para_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~sched_2__para_1",
      "schema:text": {
        "@language": "en",
        "@value": "undertake to offer a taxonomic duplicate of the biological resource collected to the Competent Authority;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~sched_2__para_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~sched_2__para_1",
      "schema:text": {
        "@language": "en",
        "@value": "undertake not to give the biological resource to any person other than the Competent Authority without its prior written permission; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~sched_2__para_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~sched_2__para_1",
      "schema:text": {
        "@language": "en",
        "@value": "undertake not to carry out, or allow others to carry out, research or development for commercial or potential commercial purposes on any biological resource, or derivative, or in relation to traditional knowledge associated with the biological resource, unless he obtains a permit for commercial or potential commercial purposes in accordance with section 12 and a benefit sharing agreement has been entered into in accordance with subsection 22(1) of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~sched_2__para_2",
      "@type": "akn:paragraph",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~sched_2",
      "schema:text": {
        "@language": "en",
        "@value": "I am aware that a person who intentionally makes a false statement in a statutory declaration is guilty of an offence under section 53 of this Act. And I make this solemn declaration conscientiously believing the same to be true and by virtue of the provisions of the Statutory Declarations Act 1960. ⎩ Subscribed and solemnly declared by the abovenamed ............................................................................................. ⎪ at.......................................................................................... ⎨ in the State of ..................................................................... ⎪ this...................................................................., 20............. ⎧ Before me, ............................................................ (Signature of Sessions Court Judge, Magistrate or Commissioner for Oaths)"
      }
    }
  ]
}
