      "schema:name": {
        "@language": "en",
        "@value": "In this Act, unless the context otherwise requires—"
      },
      "schema:text": {
        "@language": "en",
        "@value": "“advisory body” means a body comprising indigenous and local communities established by the Competent Authority under subsection 9(2); “Advisory Committee” means a committee established by the National Competent Authority under section 11; “animal” includes—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_4__list_1",
