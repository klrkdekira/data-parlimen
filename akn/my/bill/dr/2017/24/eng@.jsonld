      "schema:text": {
        "@language": "en",
        "@value": "any mammal (other than man), bird, reptile, amphibian, arthropod, or other vertebrate or invertebrate, whether alive or dead, and the egg, young or immature form derived from them;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_4__list_1__para_b",
