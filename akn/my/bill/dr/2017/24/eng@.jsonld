      "schema:text": {
        "@language": "en",
        "@value": "Federal Government, or State Authority possessing biological resources in in-situ conditions;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_4__list_5__para_b",
