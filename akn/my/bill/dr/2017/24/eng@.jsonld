        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_4__list_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_4"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_4__list_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_4__list_4",
      "schema:text": {
        "@language": "en",
        "@value": "any species of plant or any part of such species whether alive or dead and includes the stem, branch, tuber, bulb, corm, stock, budwood, cutting, layer, slip, sucker, root, leaf, flower, fruit, seed or any other part or product whatsoever of a plant whether severed or attached; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_4__list_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
