      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_4__list_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_4__list_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/24/eng@/~part_I__cl_4"
    },
