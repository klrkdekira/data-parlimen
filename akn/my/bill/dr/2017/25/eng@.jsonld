        "@value": "Legal Aid (Amendment) Bill 2017"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/25/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
