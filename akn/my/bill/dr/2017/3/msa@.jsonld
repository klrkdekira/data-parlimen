      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “memerintahkan pelupusan” perkataan “barang,”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/3/msa@/~cl_16__para_b",
