    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/33/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/33/msa@/~cl_1__subsec_1",
