      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1), dengan memotong perkataan “dengan usaha bersama mereka”; (Perkahwinan dan Perceraian) (Pindaan)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/33/msa@/~cl_6__para_b",
      "@type": "akn:paragraph",
