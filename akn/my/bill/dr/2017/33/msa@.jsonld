      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/33/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/33/msa@/~cl_6__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/33/msa@/~cl_6__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (a), dengan memasukkan selepas perkataan “aset itu” perkataan “atau pembayaran perbelanjaan untuk faedah keluarga”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/33/msa@/~cl_6__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/33/msa@/~cl_6__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan (a) perenggan yang berikut: “(aa) takat sumbangan yang telah diberikan oleh pihak lain yang tidak memperoleh aset itu untuk kebajikan keluarga dengan menjaga rumah atau menyayangi keluarga;”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/33/msa@/~cl_6__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/33/msa@/~cl_6__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (c), dengan menggantikan koma di hujung perenggan itu dengan koma bernoktah; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/33/msa@/~cl_6__para_b__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/33/msa@/~cl_6__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan (c) perenggan yang berikut: “(d) tempoh perkahwinan itu;”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/33/msa@/~cl_6__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/33/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong subseksyen (3) dan (4). Pindaan seksyen 95"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/33/msa@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
