        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/33/msa@/~cl_6__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/33/msa@/~cl_6__para_b__subpara_iii",
