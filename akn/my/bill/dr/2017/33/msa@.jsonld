      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/33/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 95 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/33/msa@/~cl_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/33/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “hilang upaya dari segi jasmani atau otak” perkataan “atau sedang mengikuti pelajaran atau latihan lanjut atau lebih tinggi”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/33/msa@/~cl_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/33/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “tidak lagi berada dalam keadaan hilang upaya itu” perkataan “atau selesai pelajaran atau latihan lanjut atau lebih tinggi itu”. Peralihan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/33/msa@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/33/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa tindakan atau prosiding yang bermula atau belum selesai sebaik sebelum tarikh permulaan kuat kuasa Akta ini hendaklah, selepas tarikh permulaan kuat kuasa Akta ini, diteruskan di bawah peruntukan Akta ibu sebagaimana yang dipinda oleh Akta ini."
      }
    }
  ]
}
