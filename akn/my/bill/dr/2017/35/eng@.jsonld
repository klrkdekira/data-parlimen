        "@value": "[Sections 2 and 48] HEALTHCARE SERVICES"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/eng@/~sched_1__para_1",
      "@type": "akn:paragraph",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/eng@/~sched_1",
      "schema:name": {
        "@language": "en",
        "@value": "Services of healthcare professionals and healthcare para-professionals"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/eng@/~sched_1__para_2",
      "@type": "akn:paragraph",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/eng@/~sched_1",
      "schema:text": {
        "@language": "en",
        "@value": "Service for the screening, diagnosis, or treatment of persons suffering from, or believed to be suffering from, any disease, injury or disability of mind or body"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/eng@/~sched_1__para_3",
      "@type": "akn:paragraph",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/eng@/~sched_1",
      "schema:text": {
        "@language": "en",
        "@value": "Service for curing or alleviating any abnormal condition of the human body by the application of any apparatus, equipment, instrument or device, or any other medical technology"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/eng@/~sched_1__para_4",
      "@type": "akn:paragraph",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/eng@/~sched_1",
      "schema:name": {
        "@language": "en",
        "@value": "Service for preventive or promotive health purposes"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/eng@/~sched_1__para_5",
      "@type": "akn:paragraph",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/eng@/~sched_1",
      "schema:name": {
        "@language": "en",
        "@value": "Protection, supervision and rehabilitation services"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/eng@/~sched_1__para_6",
      "@type": "akn:paragraph",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/eng@/~sched_1",
      "schema:name": {
        "@language": "en",
        "@value": "Accommodation for the purposes of any healthcare services"
      }
    },
