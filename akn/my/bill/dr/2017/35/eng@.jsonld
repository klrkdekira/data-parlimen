      ],
      "schema:name": {
        "@language": "en",
        "@value": "Private Aged Healthcare Facilities and Services Bill 2017"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/eng@/~part_I",
      "@type": "akn:part",
      "eli:number": "I",
