      "schema:text": {
        "@language": "ms",
        "@value": "PERMULAAN Tajuk ringkas dan permulaan kuat kuasa"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II",
      "@type": "akn:part",
      "eli:number": "II",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II__cl_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II__cl_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "KELULUSAN UNTUK MENYEDIAKAN DAN LESEN UNTUK MENGENDALIKAN KEMUDAHAN DAN PERKHIDMATAN JAGAAN KESIHATAN WARGA EMAS SWASTA Kelulusan dan lesen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III",
      "@type": "akn:part",
      "eli:number": "III",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_10"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "KELULUSAN Permohonan kelulusan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_10__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_10__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Pemegang kelulusan tidak boleh memindahkan atau menyerah hak kelulusan melainkan jika kelulusan Ketua Pengarah diperoleh terlebih dahulu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Permohonan pemindahan atau penyerahan hak suatu kelulusan hendaklah dibuat kepada Ketua Pengarah mengikut cara yang ditentukan oleh Ketua Pengarah dan hendaklah disertakan dengan fi yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_10__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_10__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_10__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pemegang kelulusan yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_10__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_10__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "jika pemegang kelulusan ialah seorang individu, didenda tidak melebihi sepuluh ribu ringgit; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_10__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_10__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "jika pemegang kelulusan ialah suatu pertubuhan perbadanan, perkongsian atau pertubuhan, didenda tidak melebihi tiga puluh ribu ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_6__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu permohonan kelulusan untuk menyediakan suatu kemudahan dan perkhidmatan jagaan kesihatan warga emas swasta hendaklah dibuat kepada Ketua Pengarah mengikut cara yang ditentukan oleh Ketua Pengarah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu permohonan kelulusan hendaklah disertakan dengan fi yang ditetapkan. Penolakan untuk memproses permohonan kelulusan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_7__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah boleh menolak untuk memproses suatu permohonan kelulusan atau boleh menghendaki supaya permohonan itu dipinda atau dilengkapkan dan dikemukakan semula atau supaya suatu permohonan baharu dikemukakan untuk menggantikannya sekiranya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "permohonan itu tidak dibuat mengikut cara yang ditentukan oleh Ketua Pengarah; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "pemohon tidak menunjukkan bukti bahawa dia layak dan sesuai untuk diberikan kelulusan. Perkara untuk dipertimbangkan bagi kelulusan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_8__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_8__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_8__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_8__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_8__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Ketua Pengarah memutuskan untuk meneruskan dengan permohonan kelulusan, dalam memutuskan sama ada atau tidak untuk memberikan kelulusan, Ketua Pengarah hendaklah menimbangkan perkara yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "jenis premis yang di dalamnya kemudahan dan perkhidmatan jagaan kesihatan warga emas akan disediakan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "perkhidmatan jagaan kesihatan yang akan disediakan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_8__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "kemudahan dan perkhidmatan jagaan kesihatan warga emas swasta yang telah sedia ada di dalam kawasan yang berhubungan dengan permohonan kelulusan itu dan akses kepadanya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_8__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "keperluan kemudahan dan perkhidmatan jagaan kesihatan warga emas swasta pada masa sekarang dan masa hadapan di dalam kawasan yang berhubungan dengan permohonan kelulusan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_8__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa perkara lain yang difikirkan relevan oleh Ketua Pengarah. Pemberian kelulusan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_9__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_9__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Setelah menimbangkan permohonan kelulusan, Ketua Pengarah boleh memberikan kelulusan untuk menyediakan suatu kemudahan dan perkhidmatan jagaan kesihatan warga emas swasta. Warga Emas Swasta"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Kelulusan hendaklah dalam bentuk dan mengandungi butir-butir yang ditentukan oleh Ketua Pengarah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_9__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_III__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Kelulusan adalah tertakluk kepada pembayaran fi yang ditetapkan. Pemindahan atau penyerahan hak kelulusan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II__cl_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II__cl_4__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II__cl_4__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II__cl_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang tidak boleh menyediakan suatu kemudahan dan perkhidmatan jagaan kesihatan warga emas swasta bagi empat warga emas atau lebih tanpa kelulusan di bawah subseksyen 9(1) atau mengendalikan kemudahan dan perkhidmatan jagaan kesihatan warga emas swasta bagi empat warga emas atau lebih tanpa lesen di bawah Bahagian IV."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II__cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu permohonan untuk kelulusan atau lesen boleh dibuat oleh dan diberikan kepada seorang individu, suatu badan berkanun, suatu perkongsian atau suatu pertubuhan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II__cl_4__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II__cl_4__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II__cl_4__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II__cl_4__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II__cl_4__subsec_3__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II__cl_4__subsec_3__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II__cl_4__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal seorang individu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II__cl_4__subsec_3__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II__cl_4__subsec_3__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "didenda tidak melebihi tiga puluh ribu ringgit; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II__cl_4__subsec_3__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II__cl_4__subsec_3__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi kesalahan yang berterusan, didenda selanjutnya tidak melebihi satu ribu ringgit bagi tiap-tiap hari atau sebahagian daripada sehari selama kesalahan itu berterusan selepas sabitan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II__cl_4__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II__cl_4__subsec_3__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II__cl_4__subsec_3__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II__cl_4__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal suatu pertubuhan perbadanan, perkongsian atau pertubuhan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II__cl_4__subsec_3__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II__cl_4__subsec_3__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "didenda tidak melebihi satu ratus ribu ringgit; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II__cl_4__subsec_3__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II__cl_4__subsec_3__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi kesalahan yang berterusan, didenda selanjutnya tidak melebihi tiga ribu ringgit bagi tiap-tiap hari atau sebahagian daripada sehari selama kesalahan itu berterusan selepas sabitan. Warga Emas Swasta Premis bagi kemudahan dan perkhidmatan jagaan kesihatan warga emas swasta berlesen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II__cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II__cl_5__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II__cl_5__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II__cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II__cl_5__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II__cl_5__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II__cl_5__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II__cl_5__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang hendaklah menyediakan dan mengendalikan suatu kemudahan dan perkhidmatan jagaan kesihatan warga emas swasta berlesen hanya di premis yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II__cl_5__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu kemudahan berkediaman;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II__cl_5__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu kemudahan jagaan harian;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II__cl_5__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa premis yang ditetapkan oleh Menteri; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II__cl_5__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa premis yang menggabungkan spesifikasi mana-mana dua premis atau lebih dalam perenggan (a) hingga (c)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II__cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu “kemudahan jagaan harian” dalam perenggan (1)(b) ertinya suatu kemudahan tanpa tempat kediaman yang di dalamnya kemudahan dan perkhidmatan jagaan kesihatan warga emas disediakan selama suatu tempoh berterusan yang melebihi tiga jam sehari sekurang-kurangnya tiga hari seminggu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II__cl_5__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah boleh menentukan standard atau kehendak yang berlainan bagi jenis premis yang berlainan yang di dalamnya kemudahan dan perkhidmatan jagaan kesihatan warga emas akan disediakan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_11",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_12",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_13",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_14",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_15",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_16",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_17",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_18",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_19"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "LESEN Permohonan lesen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_11__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_11__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_11__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu permohonan lesen untuk mengendalikan kemudahan dan perkhidmatan jagaan kesihatan warga emas swasta hendaklah hanya dibuat oleh seorang pemegang kelulusan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Permohonan lesen hendaklah dibuat kepada Ketua Pengarah mengikut cara yang ditentukan oleh Ketua Pengarah dalam tempoh tiga tahun dari tarikh kelulusan diberikan berkenaan dengan kemudahan dan perkhidmatan jagaan kesihatan warga emas swasta itu yang berhubungan dengan permohonan lesen itu atau apa-apa tempoh lanjutan yang dibenarkan oleh Ketua Pengarah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_11__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Permohonan lesen hendaklah disertakan dengan fi yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_11__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika tiada permohonan lesen dibuat dalam tempoh yang dinyatakan dalam subseksyen (2) kelulusan itu hendaklah disifatkan terbatal. Penolakan untuk memproses permohonan lesen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah boleh menolak untuk memproses suatu permohonan lesen, atau boleh menghendaki supaya permohonan itu dipinda atau dilengkapkan dan dikemukakan semula atau supaya suatu permohonan baharu dikemukakan untuk menggantikannya sekiranya permohonan itu tidak dibuat mengikut cara yang ditentukan oleh Ketua Pengarah. Pemeriksaan premis"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_13__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Ketua Pengarah memutuskan untuk meneruskan dengan permohonan lesen, Ketua Pengarah hendaklah melantik dua orang atau lebih untuk memeriksa premis yang di dalamnya kemudahan dan perkhidmatan jagaan kesihatan warga emas swasta itu akan disediakan untuk memastikan sama ada atau tidak premis itu mematuhi standard atau kehendak."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Orang yang dilantik di bawah subseksyen (1) hendaklah mengemukakan laporan pemeriksaan itu kepada Ketua Pengarah dengan seberapa segera yang dapat dilaksanakan. Pemberian lesen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_14__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_14__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Ketua Pengarah berpuas hati dengan laporan pemeriksaan di bawah subseksyen 13(2), Ketua Pengarah boleh memberikan lesen untuk mengendalikan kemudahan dan perkhidmatan jagaan kesihatan warga emas swasta di premis itu. Warga Emas Swasta"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Lesen hendaklah dalam bentuk dan mengandungi butir-butir yang ditentukan oleh Ketua Pengarah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_14__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Lesen adalah tertakluk kepada pembayaran fi yang ditetapkan. Lesen sementara"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_15__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_15__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_15__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_15__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_15__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_15__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_15__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_15__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun laporan pemeriksaan premis yang tidak memuaskan, Ketua Pengarah boleh memberikan suatu lesen sementara sekiranya difikirkan oleh Ketua Pengarah bahawa pemohon lesen di bawah seksyen 11 boleh menjalankan kerja-kerja pembetulan untuk mematuhi standard atau kehendak."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Lesen sementara hendaklah dalam bentuk dan mengandungi butir-butir yang ditentukan oleh Ketua Pengarah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_15__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Lesen sementara adalah tertakluk kepada pembayaran fi yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_15__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Kerja-kerja pembetulan di bawah subseksyen (1) hendaklah dijalankan dalam tempoh dua belas bulan dari tarikh lesen sementara diberikan atau apa-apa tempoh lanjut yang dibenarkan oleh Ketua Pengarah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_15__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pemegang lesen sementara boleh pada bila-bila masa dalam tempoh yang dinyatakan dalam subseksyen (4) memberitahu Ketua Pengarah mengenai pematuhannya dengan standard atau kehendak."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_15__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Selepas habis tempoh dalam subseksyen (4) atau setelah diberitahu tentang pematuhan di bawah subseksyen (5), yang mana lebih awal, pemeriksaan premis hendaklah dijalankan untuk membolehkan Ketua Pengarah menimbangkan semula permohonan lesen itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_15__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 13 hendaklah terpakai bagi pemeriksaan premis di bawah seksyen ini. Pertimbangan semula permohonan lesen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_16__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_16__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_16__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_16__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_16__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_16__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_16__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_16__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_16__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah boleh menimbangkan semula permohonan lesen berdasarkan laporan pemeriksaan premis dan Ketua Pengarah boleh setelah menimbangkan semula permohonan itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_16__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_16__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "memberikan lesen;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_16__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_16__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menolak permohonan itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_16__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_16__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "melanjutkan lesen sementara bagi apa-apa tempoh yang dibenarkan oleh Ketua Pengarah untuk membolehkan standard atau kehendak dipatuhi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Setelah habis tempoh lanjut lesen sementara dalam perenggan (1)(c), pemeriksaan premis hendaklah dijalankan untuk membolehkan Ketua Pengarah selanjutnya menimbangkan semula permohonan lesen itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_16__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Ketua Pengarah berpuas hati dengan laporan pemeriksaan premis di bawah subseksyen (2), Ketua Pengarah boleh memberikan lesen."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_16__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Lesen hendaklah dalam bentuk dan mengandungi butir-butir yang ditentukan oleh Ketua Pengarah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_16__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Lesen adalah tertakluk kepada pembayaran fi yang ditetapkan. Kesahan lesen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Lesen adalah sah bagi tempoh tiga tahun dari tarikh lesen itu dikeluarkan melainkan jika dibatalkan terlebih dahulu. Pembaharuan lesen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_18__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_18__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu permohonan pembaharuan lesen hendaklah dibuat mengikut cara yang ditentukan oleh Ketua Pengarah dan hendaklah disertakan dengan fi yang ditetapkan. Warga Emas Swasta"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah hendaklah menentukan tempoh lesen apabila diperbaharui. Pemindahan atau penyerahan hak lesen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_19__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_19__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_19__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_19__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Pemegang lesen atau pemegang lesen sementara tidak boleh memindahkan atau menyerah hak lesen atau lesen sementara, melainkan jika kelulusan Ketua Pengarah diperoleh terlebih dahulu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_19__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Permohonan pemindahan atau penyerahan hak suatu lesen atau lesen sementara hendaklah dibuat kepada Ketua Pengarah mengikut cara yang ditentukan oleh Ketua Pengarah dan hendaklah disertakan dengan fi yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_19__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_19__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_19__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pemegang lesen atau pemegang lesen sementara yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_19__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_19__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "jika pemegang lesen atau pemegang lesen sementara ialah seorang individu, didenda tidak melebihi sepuluh ribu ringgit; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_19__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IV__cl_19__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "jika pemegang lesen atau pemegang lesen sementara ialah suatu pertubuhan perbadanan, perkongsian atau pertubuhan, didenda tidak melebihi tiga puluh ribu ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX",
      "@type": "akn:part",
      "eli:number": "IX",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_42",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_43",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_44",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_45",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_46",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_47",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_48",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_49",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_50",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_51",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_52",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_53"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "AM Selain warga emas boleh diterima masuk"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_42",
      "@type": "akn:clause",
      "eli:number": "42",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX",
      "schema:text": {
        "@language": "ms",
        "@value": "Pemegang lesen boleh menerima masuk orang yang berumur di bawah enam puluh tahun sebagai orang yang menerima jagaan ke kemudahan dan perkhidmatan jagaan kesihatan warga emas berlesen dan penerimaan masuk itu hendaklah berdasarkan kriteria yang ditetapkan oleh Menteri selepas berunding dengan Menteri yang dipertanggungkan dengan tanggungjawab bagi Akta Pusat Jagaan 1993. Daftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_43",
      "@type": "akn:clause",
      "eli:number": "43",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_43__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_43__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_43__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah hendaklah menyenggarakan suatu Daftar mengenai semua kemudahan dan perkhidmatan jagaan kesihatan warga emas swasta berlesen dalam kedua-dua bentuk fizikal dan elektronik dalam bentuk dan mengikut cara yang ditentukan oleh Ketua Pengarah. Warga Emas Swasta"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_43__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang boleh, apabila membayar fi yang ditetapkan, memeriksa dan membuat salinan atau cabutan butiran daripada Daftar. Garis panduan dan arahan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_44",
      "@type": "akn:clause",
      "eli:number": "44",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah boleh mengeluarkan garis panduan dan arahan yang difikirkan perlu atau suai manfaat oleh Ketua Pengarah bagi pelaksanaan yang wajar Akta ini. Pewakilan kuasa"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_45",
      "@type": "akn:clause",
      "eli:number": "45",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_45__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_45__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_45__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_45",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah boleh mewakilkan apa-apa kuasa atau kewajipan Ketua Pengarah, selain kuasa di bawah seksyen 44, kepada mana-mana pegawai di bawah kawalan, arahan dan penyeliaan Ketua Pengarah tertakluk kepada syarat, batasan atau sekatan yang difikirkan patut oleh Ketua Pengarah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_45__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_45",
      "schema:text": {
        "@language": "ms",
        "@value": "Pewakilan di bawah seksyen ini tidak menghalang Ketua Pengarah sendiri daripada melaksanakan atau menjalankan pada bila-bila masa mana-mana kuasa atau kewajipan yang diwakilkan itu. Rayuan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_46",
      "@type": "akn:clause",
      "eli:number": "46",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_46__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_46__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_46__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_46__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana orang terkilan dengan apa-apa arahan atau apa-apa keputusan yang dibuat oleh Ketua Pengarah atau mana-mana orang yang kepadanya kuasa atau kewajipan Ketua Pengarah telah diwakilkan, orang itu boleh merayu kepada Menteri, dalam tempoh tiga puluh hari atau apa-apa tempoh lanjut yang dibenarkan oleh Menteri dari tarikh arahan atau keputusan yang dirayu itu dibuat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_46__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh mengesahkan, mengakas atau mengubah apa-apa arahan atau keputusan yang dirayu itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_46__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh membuat peraturan-peraturan untuk menetapkan tatacara rayuan. Kuasa untuk mengecualikan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_47",
      "@type": "akn:clause",
      "eli:number": "47",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, melalui perintah yang disiarkan dalam Warta, mengecualikan mana-mana kemudahan dan perkhidmatan jagaan kesihatan warga emas swasta daripada pemakaian mana-mana peruntukan Akta ini. Kuasa untuk meminda Jadual"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_48",
      "@type": "akn:clause",
      "eli:number": "48",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, melalui perintah yang disiarkan dalam Warta, meminda mana-mana Jadual bagi Akta ini. Kuasa untuk membuat peraturan-peraturan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_49",
      "@type": "akn:clause",
      "eli:number": "49",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_49__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_49__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_49__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_49",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh membuat peraturan-peraturan yang perlu atau suai manfaat bagi pelaksanaan yang wajar Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_49__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_49__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_49__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_49",
      "schema:text": {
        "@language": "ms",
        "@value": "Peraturan-peraturan yang dibuat di bawah Akta ini boleh menetapkan apa-apa tindakan atau peninggalan dalam pelanggaran peraturan-peraturan menjadi suatu kesalahan dan boleh menetapkan denda:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_49__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_49__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal pemegang lesen yang merupakan seorang individu, tidak melebihi sepuluh ribu ringgit dan bagi kesalahan yang berterusan, didenda selanjutnya tidak melebihi satu ribu ringgit bagi tiap-tiap hari atau sebahagian daripada sehari selama kesalahan itu berterusan selepas sabitan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_49__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_49__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal pemegang lesen yang merupakan suatu pertubuhan perbadanan, perkongsian atau pertubuhan, tidak melebihi dua puluh ribu ringgit dan bagi kesalahan yang berterusan, didenda selanjutnya tidak melebihi lima ribu ringgit bagi tiap-tiap hari atau sebahagian daripada sehari selama kesalahan itu berterusan selepas sabitan. Penalti am"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_50",
      "@type": "akn:clause",
      "eli:number": "50",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_50__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_50__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_50__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_50",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang melanggar mana-mana peruntukan Akta ini atau apa-apa peraturan-peraturan yang dibuat di bawah Akta ini yang baginya tiada diperuntukkan peruntukan yang nyata yang menjadikan pelanggarannya suatu kesalahan melakukan suatu kesalahan. Warga Emas Swasta"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_50__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_50__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_50__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_50",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melakukan kesalahan di bawah Akta ini atau apa-apa peraturan-peraturan yang dibuat di bawah Akta ini yang baginya tiada diperuntukkan hukuman yang nyata hendaklah, apabila disabitkan, boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_50__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_50__subsec_2__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_50__subsec_2__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_50__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal seorang individu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_50__subsec_2__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_50__subsec_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "didenda tidak melebihi lima ribu ringgit; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_50__subsec_2__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_50__subsec_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi kesalahan yang berterusan, didenda selanjutnya tidak melebihi lima ratus ringgit bagi tiap-tiap hari atau sebahagian daripada sehari selama kesalahan itu berterusan selepas sabitan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_50__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_50__subsec_2__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_50__subsec_2__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_50__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal suatu pertubuhan perbadanan, perkongsian atau pertubuhan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_50__subsec_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_50__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "didenda tidak melebihi dua puluh ribu ringgit; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_50__subsec_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_50__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi kesalahan yang berterusan, didenda selanjutnya tidak melebihi satu ribu lima ratus ringgit bagi tiap-tiap hari atau sebahagian daripada sehari selama kesalahan itu berterusan selepas sabitan. Kesalahan oleh pertubuhan perbadanan, perkongsian atau pertubuhan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_51",
      "@type": "akn:clause",
      "eli:number": "51",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_51__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_51__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_51__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_51__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_51__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_51__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_51",
      "schema:text": {
        "@language": "ms",
        "@value": "Sekiranya sesuatu pertubuhan perbadanan, perkongsian atau pertubuhan melakukan suatu kesalahan di bawah Akta ini atau apa-apa peraturan-peraturan yang dibuat di bawah Akta ini, seseorang yang pada masa perlakuan kesalahan itu ialah seorang pengarah, ketua pegawai eksekutif, ketua pegawai operasi, pengurus, setiausaha atau pegawai lain yang seumpamanya dalam pertubuhan perbadanan, perkongsian atau pertubuhan itu atau yang berupa bertindak atas mana-mana sifat sedemikian atau yang dengan apa-apa cara atau pada apa-apa takat bertanggungjawab bagi pengurusan apa-apa hal ehwal pertubuhan perbadanan, perkongsian atau pertubuhan itu atau yang membantu dalam pengurusan sedemikian—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_51__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_51__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "boleh dituduh secara berasingan atau bersesama dalam prosiding yang sama bersekali dengan pertubuhan perbadanan, perkongsian atau pertubuhan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_51__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_51__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_51__subsec_1__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_51__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "sekiranya pertubuhan perbadanan, perkongsian atau pertubuhan itu didapati bersalah melakukan kesalahan itu, hendaklah disifatkan bersalah atas kesalahan itu melainkan jika, dengan mengambil kira jenis fungsinya atas sifat itu dan segala hal keadaan, dia membuktikan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_51__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_51__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa kesalahan itu telah dilakukan tanpa pengetahuannya, persetujuannya atau pembiarannya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_51__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_51__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa dia telah mengambil segala langkah berjaga-jaga yang munasabah dan telah menjalankan segala usaha yang wajar untuk mengelakkan perlakuan kesalahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_51__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_51",
      "schema:text": {
        "@language": "ms",
        "@value": "Bilamana mana-mana ejen atau pekerja semasa menjalankan pekerjaannya melakukan atau meninggalkan sesuatu perbuatan yang dilakukan atau ditinggalkan oleh prinsipal atau majikannya akan menjadi suatu kesalahan terhadap Akta ini atau apa-apa peraturan-peraturan yang dibuat di bawah Akta ini, ejen atau pekerja itu hendaklah bersalah melakukan kesalahan, dan subseksyen (3) hendaklah terpakai bagi prinsipal atau majikannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_51__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_51__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_51__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_51__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_51",
      "schema:text": {
        "@language": "ms",
        "@value": "Sekiranya mana-mana orang yang akan bertanggungan di bawah Akta ini atau apa-apa peraturan-peraturan yang dibuat di bawah Akta ini kepada apa-apa hukuman atau penalti untuk apa-apa tindakan, peninggalan, kecuaian atau keingkaran, dia hendaklah bertanggungan kepada hukuman atau penalti yang sama untuk setiap tindakan, peninggalan, kecuaian atau keingkaran mana-mana pekerja atau ejennya, atau pekerja ejen itu, sekiranya tindakan, peninggalan, kecuaian atau keingkaran itu telah dilakukan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_51__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_51__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "oleh pekerjanya dalam menjalankan pekerjaannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_51__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_51__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "oleh ejen yang bertindak bagi pihak orang itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_51__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_51__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "oleh pekerja ejen itu dalam menjalankan pekerjaan yang baginya dia diambil kerja oleh ejen itu atau sebaliknya bagi pihak ejen yang bertindak bagi pihak orang itu. Warga Emas Swasta Pengkompaunan kesalahan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_52",
      "@type": "akn:clause",
      "eli:number": "52",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_52__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_52__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_52__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_52__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_52__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_52__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_52__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_52__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_52__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_52",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, dengan kelulusan Pendakwa Raya, membuat peraturan-peraturan untuk menetapkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_52__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_52__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana kesalahan di bawah Akta ini dan apa-apa peraturan-peraturan yang dibuat di bawah Akta yang boleh dikompaun;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_52__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_52__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "kriteria bagi mengkompaun kesalahan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_52__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_52__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "kaedah dan tatacara bagi mengkompaun kesalahan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_52__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_52",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah boleh, dengan keizinan bertulis Pendakwa Raya, mengkompaun mana-mana kesalahan yang dilakukan oleh mana-mana orang di bawah Akta ini atau apa-apa peraturan-peraturan yang dibuat di bawah Akta ini dan ditetapkan sebagai suatu kesalahan boleh dikompaun dengan membuat suatu tawaran bertulis kepada orang yang disyaki telah melakukan kesalahan itu untuk mengkompaun kesalahan itu apabila dibayar kepada Ketua Pengarah suatu jumlah wang yang tidak melebihi lima puluh peratus amaun denda maksimum bagi kesalahan itu dalam masa yang dinyatakan dalam tawaran bertulisnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_52__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_52",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu tawaran di bawah subseksyen (2) boleh dibuat pada bila-bila masa selepas kesalahan itu dilakukan tetapi sebelum apa-apa pendakwaan baginya dimulakan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_52__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_52",
      "schema:text": {
        "@language": "ms",
        "@value": "Sekiranya amaun yang dinyatakan dalam tawaran itu tidak dibayar dalam tempoh yang dinyatakan dalam tawaran itu atau dalam apa-apa masa lanjutan yang dibenarkan oleh Ketua Pengarah, pendakwaan bagi kesalahan itu boleh dimulakan pada bila-bila masa selepas itu terhadap orang yang kepadanya tawaran itu dibuat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_52__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_52",
      "schema:text": {
        "@language": "ms",
        "@value": "Sekiranya suatu kesalahan telah dikompaun di bawah seksyen ini, tiada pendakwaan boleh dimulakan berkenaan dengan kesalahan itu terhadap orang yang kepadanya tawaran untuk mengkompaun itu dibuat, dan mana-mana dokumen atau benda yang disita berkaitan kesalahan itu boleh dilepaskan oleh Ketua Pengarah, tertakluk kepada apa-apa syarat yang difikirkan patut oleh Ketua Pengarah. Kecualian dan peralihan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_53",
      "@type": "akn:clause",
      "eli:number": "53",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_53__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_53__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_53__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_53__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_53__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_53",
      "schema:text": {
        "@language": "ms",
        "@value": "Pada tarikh permulaan kuat kuasa Akta ini, pusat jagaan yang berdaftar di bawah Akta Pusat Jagaan 1993 yang menyediakan jagaan kepada empat warga emas atau lebih hendaklah disifatkan telah dilesenkan di bawah Akta ini sehingga lima tahun dari tarikh permulaan kuat kuasa Akta ini atau apa-apa tempoh selanjutnya yang dibenarkan oleh Ketua Pengarah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_53__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_53",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengendali pusat jagaan di bawah subseksyen (1) hendaklah memohon kelulusan dan lesen di bawah Akta ini dalam tempoh lima tahun, atau tempoh selanjutnya yang dibenarkan oleh Ketua Pengarah mengikut subseksyen (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_53__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_53",
      "schema:text": {
        "@language": "ms",
        "@value": "Sementara keputusan untuk memberikan kelulusan dan lesen kepada pusat jagaan di bawah subseksyen (2) dibuat, pusat jagaan itu hendaklah terus disifatkan telah dilesenkan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_53__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_IX__cl_53",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa keputusan, perintah, rayuan, arahan, siasatan, perbicaraan dan prosiding yang telah dibuat, diambil atau dimulakan di bawah Akta Pusat Jagaan 1993 berhubung dengan pusat jagaan di bawah subseksyen (1) sebaik sebelum tarikh permulaan kuat kuasa Akta ini hendaklah diteruskan atau dimuktamadkan di bawah dan mengikut peruntukan Akta Pusat Jagaan 1993."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_I__cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_I__cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Kemudahan dan Perkhidmatan Jagaan Kesihatan Warga Emas Swasta 2017."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_I__cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta. Tafsiran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_I",
      "schema:name": {
        "@language": "ms",
        "@value": "Dalam Akta ini, melainkan jika konteksnya menghendaki makna yang lain—"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "“ditetapkan” ertinya ditetapkan oleh Menteri melalui peraturan-peraturan yang dibuat di bawah Akta ini; “Inspektor” ertinya Inspektor yang dilantik di bawah subseksyen 87(1) Akta Kemudahan dan Perkhidmatan Jagaan Kesihatan Swasta 1998 [Akta 586]; “kelulusan” ertinya kelulusan yang diberikan di bawah subseksyen 9(1) untuk menyediakan suatu kemudahan dan perkhidmatan jagaan kesihatan warga emas swasta dan “pemegang kelulusan” ertinya pemegang suatu kelulusan yang berhubungan dengan kemudahan dan perkhidmatan jagaan kesihatan warga emas swasta itu; “kemudahan dan perkhidmatan jagaan kesihatan warga emas swasta” ertinya mana-mana premis yang di dalamnya perkhidmatan jagaan kesihatan disediakan untuk warga emas; “kemudahan dan perkhidmatan jagaan kesihatan warga emas swasta berlesen” ertinya mana-mana kemudahan dan perkhidmatan jagaan kesihatan warga emas swasta yang dilesenkan di bawah Bahagian IV; “Ketua Pengarah” ertinya Ketua Pengarah Kesihatan, Malaysia; “lesen” ertinya lesen yang diberikan di bawah Bahagian IV untuk mengendalikan suatu kemudahan dan perkhidmatan jagaan kesihatan warga emas swasta dan “pemegang lesen” ertinya pemegang suatu lesen yang berhubungan dengan kemudahan dan perkhidmatan jagaan kesihatan warga emas swasta itu; “lesen sementara” ertinya lesen sementara yang diberikan di bawah Bahagian IV dan “pemegang lesen sementara” ertinya pemegang suatu lesen sementara; “Menteri” ertinya Menteri yang dipertanggungkan dengan tanggungjawab bagi kesihatan; “oran g y ang be rta ngg ung jaw ab ” e rtin ya o ra ng y an g dipertanggungkan dengan tanggungjawab di bawah subseksyen 23(2); “orang yang menerima jagaan” ertinya mana-mana orang yang menerima perkhidmatan jagaan kesihatan di suatu kemudahan dan perkhidmatan jagaan kesihatan warga emas swasta berlesen; “pemberi jagaan” ertinya mana-mana orang, selain seorang profesional jagaan kesihatan, yang menguruskan jagaan peribadi mana-mana orang yang menerima jagaan; Warga Emas Swasta “perkhidmatan jagaan kesihatan” ertinya mana-mana perkhidmatan yang dinyatakan dalam Jadual Pertama; “pertubuhan” ertinya mana-mana pertubuhan yang didaftarkan di bawah Akta Pertubuhan 1966 [Akta 335] atau Akta Koperasi 1993 [Akta 502]; “pertubuhan perbadanan” ertinya mana-mana badan yang diperbadankan di bawah Akta Syarikat 2016 [Akta 777] atau badan berkanun yang diperbadankan dan ditubuhkan di bawah mana-mana undang-undang bertulis; “profesional jagaan kesihatan” ertinya mana-mana orang yang dinyatakan dalam Jadual Kedua; “saudara” ertinya mana-mana orang yang ada pertalian darah atau perhubungan perkahwinan atau pengangkatan di sisi undang-undang, atau seorang penjaga di sisi undang-undang; “standard atau kehendak” ertinya standard atau kehendak yang ditentukan oleh Ketua Pengarah di bawah subseksyen 5(3); “warga emas” ertinya mana-mana orang yang berumur enam puluh tahun atau lebih. Ketidakpakaian"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_I__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_I__cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_I__cl_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_I__cl_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_I",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ini tidak terpakai bagi—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_I__cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_I__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "kemudahan dan perkhidmatan jagaan kesihatan swasta berlesen di bawah Akta Kemudahan dan Perkhidmatan Jagaan Kesihatan Swasta 1998;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_I__cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_I__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "pusat jagaan berdaftar di bawah Akta Pusat Jagaan 1993 [Akta 506] kecuali pusat jagaan berdaftar di bawah Akta Pusat Jagaan 1993 yang disifatkan telah dilesenkan di bawah Akta ini menurut seksyen 53; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_I__cl_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_I__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "premis yang di dalamnya seseorang individu menyediakan jagaan kesihatan kepada saudaranya yang ialah seorang warga emas."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_V",
      "@type": "akn:part",
      "eli:number": "V",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_V__cl_20",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_V__cl_21",
