      "schema:name": {
        "@language": "ms",
        "@value": "RUU Kemudahan dan Perkhidmatan Jagaan Kesihatan Warga Emas Swasta 2017"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_I",
      "@type": "akn:part",
      "eli:number": "I",
