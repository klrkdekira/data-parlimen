        "@value": "PEMBATALAN Alasan pembatalan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_VII",
      "@type": "akn:part",
      "eli:number": "VII",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_VII__cl_35",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_VII__cl_36",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/35/msa@/~part_VII__cl_37"
      ],
