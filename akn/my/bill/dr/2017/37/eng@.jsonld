      "schema:text": {
        "@language": "en",
        "@value": "in the national language text—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/37/eng@/~cl_5__para_a__subpara_i",
      "@type": "akn:subparagraph",
