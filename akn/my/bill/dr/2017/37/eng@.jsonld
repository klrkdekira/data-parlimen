      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the words “pegawai Agensi” the words “dan anggota Pasukan Sukarelawan Maritim Malaysia”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/37/eng@/~cl_5__para_a__subpara_ii",
      "@type": "akn:subparagraph",
