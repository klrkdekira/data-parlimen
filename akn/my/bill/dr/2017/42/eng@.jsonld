      ],
      "schema:name": {
        "@language": "en",
        "@value": "Income Tax (Amendment) Bill 2017"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/42/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/42/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Income Tax (Amendment) Act 2017. Amendment of section 112a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/42/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/42/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Income Tax Act 1967 [Act 53], which is referred to as the “principal Act” in this Act, is amended in subsection 112a(1), by substituting for the word “132b” the words “132, 132a and 132b, where such arrangement relates to the furnishing of a country-by-country report,”. Amendment of section 113a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/42/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/42/eng@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/42/eng@/~cl_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/42/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Subsection 113a(1) of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/42/eng@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/42/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by renumbering it as section 113a; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/42/eng@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/42/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the word “132b”, wherever it appears, the words “132, 132a or 132b, where such arrangement relates to the automatic exchange of information or the furnishing of a country-by-country report,”. Amendment of section 119b"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/42/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/42/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 119b of the principal Act is amended by substituting for the word “132b”, wherever it appears, the words “132, 132a and 132b, where such arrangement relates to the automatic exchange of information or the furnishing of a country-by-country report,”."
      }
    }
  ]
