      ],
      "schema:name": {
        "@language": "ms",
        "@value": "RUU Cukai Pendapatan (Pindaan) 2017"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/42/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/42/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Cukai Pendapatan (Pindaan) 2017. Pindaan seksyen 112a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/42/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/42/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Cukai Pendapatan 1967 [Akta 53], yang disebut “Akta ibu” dalam Akta ini, dipinda dalam subseksyen 112a(1), dengan menggantikan perkataan “132b” dengan perkataan “132, 132a or 132b, where such arrangement relates to the furnishing of a country-by-country report,”. Pindaan seksyen 113a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/42/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/42/msa@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/42/msa@/~cl_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/42/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 113a(1) Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/42/msa@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/42/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menomborkannya semula sebagai seksyen 113a; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/42/msa@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/42/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “132b”, di mana-mana jua terdapat, dengan perkataan “132, 132a and 132b, where such arrangement relates to the automatic exchange of information or the furnishing of a country-by-country report,”. Pindaan seksyen 119b"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/42/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/42/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 119b Akta ibu dipinda dengan menggantikan perkataan “132b”, di mana-mana jua terdapat, dengan perkataan “132, 132a and 132b, where such arrangement relates to the automatic exchange of information or the furnishing of a country-by-country report,”."
      }
    }
  ]
}
