      "schema:name": {
        "@language": "ms",
        "@value": "RUU Timbang Tara (Pindaan) 2017"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/43/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/43/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/43/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/43/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/43/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/43/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Timbang Tara (Pindaan) 2017."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/43/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/43/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta. Pindaan am"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/43/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/43/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Timbang Tara 2005 [Akta 646], yang disebut “Akta ibu” dalam Akta ini, dipinda dengan menggantikan perkataan “Pusat Timbang Tara Serantau Kuala Lumpur” di mana-mana jua terdapat dengan perkataan “Pusat Timbang Tara Antarabangsa Asia (Malaysia)”. Perubahan nama"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/43/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/43/msa@/~cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/43/msa@/~cl_3__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/43/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/43/msa@/~cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/43/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua sebutan mengenai Pusat Timbang Tara Serantau Kuala Lumpur dalam mana-mana undang-undang bertulis atau dalam apa-apa surat cara, surat ikatan, hakmilik, dokumen, bon, perjanjian atau perkiraan kerja yang wujud sebaik sebelum permulaan kuat kuasa Akta ini hendaklah, apabila Akta ini mula berkuat kuasa, ditafsirkan sebagai sebutan mengenai Pusat Timbang Tara Antarabangsa Asia (Malaysia)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/43/msa@/~cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/43/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua perbuatan di bawah Akta ini, kelulusan, arahan, notis, garis panduan, pekeliling, nota panduan, nota amalan, keputusan, pemberitahuan, pengecualian dan tindakan eksekutif lain, tidak kira bagaimana jua disebut, dilakukan, diberikan atau dibuat oleh Pusat Timbang Tara Serantau Kuala Lumpur sebelum permulaan kuat kuasa Akta ini hendaklah terus berkuat kuasa dan berkesan sepenuhnya, sehingga dipinda, digantikan, ditamatkan atau dibatalkan."
      }
    }
  ]
}
