        "@language": "ms",
        "@value": "dalam nota bahu, dengan memasukkan selepas perkataan “Kesan” perkataan “penggantungan,”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/44/msa@/~cl_7__para_b",
