      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/44/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 5(3) Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/44/msa@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/44/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “lima puluh ribu” dengan perkataan “lima ratus ribu”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/44/msa@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
