      "schema:text": {
        "@language": "en",
        "@value": "Purpose Title B. 4 Election Commission B. 12 Contribution to Statutory Funds B. 13 Ministry of Foreign Affairs B. 28 Ministry of Transport B. 42 Ministry of Health B. 48 Ministry of Women, Family and Community Development B. 63 Ministry of Education TOTAL"
      }
    }
