        "@value": "Supplementary Supply (2016) Bill 2017"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/5/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/5/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Supplementary Supply (2016) Act 2017. Additional expenditure for the year 2016"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/5/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/5/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The issue is hereby authorized of a sum not exceeding three billion eighty-one million four hundred and thirteen thousand twenty-six ringgit (RM3,081,413,026) from the Consolidated Fund for additional expenditure on the services and purposes specified in the Schedule for the year 2016 not provided for or not fully provided for by the Supply Act 2016 [Act A1503]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/5/eng@/~sched_1",
