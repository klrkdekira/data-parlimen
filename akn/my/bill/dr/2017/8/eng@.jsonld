      ],
      "schema:name": {
        "@language": "en",
        "@value": "Labuan Business Activity Tax (Amendment) Bill 2017"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/8/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/8/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Labuan Business Activity Tax (Amendment) Act 2017. Amendment of section 21"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/8/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/8/eng@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/8/eng@/~cl_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/8/eng@/~cl_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/8/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The Labuan Business Activity Tax Act 1990 [Act 445] is amended in section 21—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/8/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/8/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by renumbering the existing section as subsection (1);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/8/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/8/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "in the renumbered subsection (1), in paragraph (b), by deleting the words “and prescribing penalties for any contravention or failure to comply with any of the provisions of any regulations made under this paragraph”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/8/eng@/~cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2017/8/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the renumbered subsection (1) the following subsection: “(2) The regulations made under this section may prescribe a penalty of a fine not exceeding one million ringgit or imprisonment for a term not exceeding two years or both for any contravention or failure to comply with any of the provisions of the regulations.”."
      }
    }
  ]
