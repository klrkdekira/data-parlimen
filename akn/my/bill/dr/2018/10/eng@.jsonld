      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII",
      "@type": "akn:part",
      "eli:number": "VIII",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_48",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_49",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_50",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_51",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_52",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_53",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_54"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "SPECIAL PROVISIONS RELATING TO DESIGNATED AREAS Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_48",
      "@type": "akn:clause",
      "eli:number": "48",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII",
      "schema:text": {
        "@language": "en",
        "@value": "In this Part, “Malaysia” excludes the designated areas and the special areas. Application"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_49",
      "@type": "akn:clause",
      "eli:number": "49",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this Part, this Act shall not apply to any taxable goods manufactured in the designated areas other than petroleum. Sales tax relating to taxable goods imported into or transported to or from designated areas"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_50",
      "@type": "akn:clause",
      "eli:number": "50",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_50__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_50__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_50__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII",
      "schema:name": {
        "@language": "en",
        "@value": "Notwithstanding anything to the contrary contained in this Act—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_50__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_50__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_50__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_50__para_a__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "no sales tax shall be levied and payable on any taxable goods—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_50__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_50__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "imported into the designated areas or transported to the designated areas from Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_50__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_50__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "transported between the designated areas; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_50__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_50__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "transported from the designated areas to the special areas, other than any taxable goods which the Minister may from time to time declare by order published in the Gazette;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_50__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "sales tax shall be levied and payable on all taxable goods transported to Malaysia from the designated areas as if such transportation to Malaysia were importation into Malaysia; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_50__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "the sale value of taxable goods liable to sales tax in accordance with paragraph (b) shall be determined in accordance with subsection 9(2). Transportation of taxable goods from or to designated areas to or from Malaysia"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_51",
      "@type": "akn:clause",
      "eli:number": "51",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_51__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_51__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_51__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_51__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_51__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_51",
      "schema:text": {
        "@language": "en",
        "@value": "Where taxable goods are transported—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_51__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_51__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "from the designated areas to Malaysia; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_51__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_51__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "from Malaysia to the designated areas, the provisions of this Act shall, with such modifications and adaptations as may be necessary, apply as if such goods were imported into, or exported from, Malaysia from or to a place outside Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_51__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_51__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_51__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_51",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to the generality of subsection (1), Part X shall apply to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_51__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_51__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "taxable goods transported to or from the designated areas from or to Malaysia; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_51__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_51__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "persons, and vehicles, vessels and aircrafts, transporting such goods. Declaration of taxable goods transported from designated areas to Malaysia"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_52",
      "@type": "akn:clause",
      "eli:number": "52",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII",
      "schema:text": {
        "@language": "en",
        "@value": "The person in charge of any vehicle, vessel or aircraft on which taxable goods are transported from the designated areas to Malaysia shall make a declaration substantially in the form as prescribed under the Customs Act 1967 giving particulars of the taxable goods transported in such vehicle, vessel or aircraft. Collection of sales tax in designated areas"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_53",
      "@type": "akn:clause",
      "eli:number": "53",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_53__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_53__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_53__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII",
      "schema:name": {
        "@language": "en",
        "@value": "In making regulations under section 106, the Minister may provide—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_53__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_53",
      "schema:text": {
        "@language": "en",
        "@value": "for the collection in the designated areas of sales tax payable in respect of taxable goods transported or about to be transported from or to the designated areas to or from Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_53__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_53",
      "schema:text": {
        "@language": "en",
        "@value": "for the limitation or restriction of vehicles, vessels and aircrafts which may be used to transport taxable goods; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_53__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_53",
      "schema:text": {
        "@language": "en",
        "@value": "for the licensing or control of persons, or vehicles, vessels or aircrafts, transporting taxable goods. Application of section 40 to taxable goods transported to designated areas"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII__cl_54",
      "@type": "akn:clause",
      "eli:number": "54",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VIII",
      "schema:text": {
        "@language": "en",
        "@value": "Section 40 shall apply to taxable goods, other than any goods declared by the Minister under paragraph 50(a) to be taxable on importation into the designated areas, transported from Malaysia to the designated areas as if such goods had been exported or re-exported, as the case may be."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_42",
      "@type": "akn:clause",
      "eli:number": "42",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_42__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_42__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_42__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_42__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General may, at any time, make a public ruling on the application of any provision of this Act in relation to any person or class of persons, or any type of business activities."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_42__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General may withdraw, either wholly or partly, any public ruling made under this section."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_42__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding any provision of this Act, where a public ruling under subsection (1) applies to any person in relation to a business activity and the person applies the provision in the manner stated in the ruling, the Director General shall apply the provision in relation to the person and the business activities in accordance with the ruling. Customs ruling"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_43",
      "@type": "akn:clause",
      "eli:number": "43",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_43__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_43__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_43__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_43__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_43__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_43__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_43__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_43__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "Any person may apply, in the prescribed form together with the prescribed fee, to the Director General for a customs ruling in respect of any one or more of the following matters:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_43__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_43__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the classification of taxable goods;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_43__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_43__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the determination of a taxable person;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_43__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_43__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the principles to be adopted for the purposes of determination of sale value of taxable goods; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_43__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_43__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any other matters as determined by the Director General."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_43__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_43__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_43__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "An application for a customs ruling under subsection (1) may be made—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_43__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_43__subsec_2__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_43__subsec_2__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_43__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "in respect of imported goods—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_43__subsec_2__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_43__subsec_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "at any time before the goods, that are the subject matter of the application, are to be imported or intended to be imported into Malaysia; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_43__subsec_2__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_43__subsec_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "at any later time, if permitted by the Director General; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_43__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_43__subsec_2__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_43__subsec_2__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_43__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "in respect of manufactured goods—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_43__subsec_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_43__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "at any time before the goods, that are the subject matter of the application, are to be manufactured; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_43__subsec_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_43__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "at any later time, if permitted by the Director General."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_43__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "An applicant may withdraw his application at any time before a customs ruling is made and any payment made relating to the application for the customs ruling shall be forfeited by the Director General. Making of customs ruling"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_44",
      "@type": "akn:clause",
      "eli:number": "44",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_44__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_44__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_44__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_44__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subsection (3), the Director General shall make a customs ruling in respect of any matter specified in the application made under section 43 and such customs ruling shall bind the applicant."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_44__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "Any customs ruling made under subsection (1) may be subject to such conditions as the Director General deems fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_44__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_44__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_44__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_44__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General may decline to make a customs ruling if, in his opinion—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_44__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_44__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the information given by the applicant is insufficient to do so;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_44__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_44__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the application is for a hypothetical situation; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_44__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_44__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "any pending appeal under section 96 involves the subject matter referred to in the application. Amendment, modification or revocation of customs ruling"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_45",
      "@type": "akn:clause",
      "eli:number": "45",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_45__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_45__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_45__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_45__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_45__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_45__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_45__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_45__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_45__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_45",
      "schema:text": {
        "@language": "en",
        "@value": "A customs ruling may be amended, modified or revoked by the Director General if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_45__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_45__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the customs ruling contains an error which needs to be corrected;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_45__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_45__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the customs ruling was based on an error of fact or law;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_45__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_45__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "there is a change in law relating to sales tax; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_45__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_45__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "there is a change in the material fact or circumstances on which the customs ruling was based."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_45__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_45",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General shall, immediately after making the amendment, modification or revocation, give notice in writing to the applicant referred to in section 43 of the amendment, modification or revocation and, subject to subsection (3), such amended, modified or revoked customs ruling shall take effect from the date stated in the notice."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_45__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_45__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_45__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_45__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_45",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (2), where a customs ruling has the effect of causing or increasing any sales tax liability in respect of any taxable goods, and—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_45__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_45__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the taxable goods are imported within three months of the date the notice of the amendment, modification or revocation is given pursuant to a binding contract entered into before that date;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_45__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_45__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the taxable goods have left the place of manufacture or warehouse in the country from which the goods are being exported for direct shipment to Malaysia on the date the notice of the amendment, modification or revocation of the customs ruling is given; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_45__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_45__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the taxable goods are imported on or before the date the notice of the amendment, modification or revocation is given but have not been released for home consumption, the customs ruling which was made prior to the amendment, modification or revocation under this section shall be applied to such taxable goods."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_45__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_45",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (2) and subject to section 39, if the amendment, modification or revocation of a customs ruling has the effect of decreasing any sales tax liability in respect of any taxable goods, any higher sales tax that has been paid shall be treated as if the higher sales tax has been paid in error. Director General to declare customs rulings to be null, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_46",
      "@type": "akn:clause",
      "eli:number": "46",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General shall, by a notice, declare a customs ruling made under section 44 to be null, void and of no effect if the ruling has been obtained by the applicant referred to in section 43 by way of fraud, misrepresentation or falsification of facts. Different customs rulings on same subject matter"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII__cl_47",
      "@type": "akn:clause",
      "eli:number": "47",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "Where an applicant referred to in section 43 receives two or more different customs rulings on the same subject matter, such rulings shall be treated as being null and void, and such applicant shall immediately notify the Director General who shall, within thirty days from the date of notification, make a new customs ruling."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_35",
      "@type": "akn:clause",
      "eli:number": "35",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_35__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_35__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_35__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_35__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_35__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_35__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_35__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_35__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_35__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, by order published in the Gazette and subject to such conditions as he deems fit, exempt—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_35__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_35__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any goods or class of goods from the whole or any part of the sales tax; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_35__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_35__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any person or class of persons from payment of the whole or any part of the sales tax which may be charged and levied on any taxable goods manufactured or imported."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_35__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "Any order made under subsection (1) shall be laid before the Dewan Rakyat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_35__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_35__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_35__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_35__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, in any particular case and subject to such conditions as he deems fit—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_35__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_35__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "exempt any person or class of persons from payment of the whole or any part of the sales tax which may be charged and levied on any taxable goods manufactured or imported;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_35__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_35__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "exempt any registered manufacturer or class of registered manufacturers from charging and collecting sales tax on taxable goods; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_35__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_35__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "direct the Director General to make a refund to any person or class of persons of the whole or any part of the sales tax or penalty paid by such persons or class of persons."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_35__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "Where a registered manufacturer sold any taxable goods to a person or class of persons exempted under paragraph (1)(b) or (3)(a), the registered manufacturer shall be exempted from charging and collecting sales tax due and payable on such taxable goods."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_35__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "Where any person who is exempted under paragraph (1)(b) or (3)(a) fails to comply with any conditions to which the exemption relates, any sales tax that has been the subject of the exemption shall become due and payable by the person on the date on which any of the conditions failed to be complied with."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_35__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "Where a person who has been granted exemption under paragraph (1)(b) or (3)(a) has paid any of the sales tax to which the exemption relates and has been granted approval by the Minister for a refund of the amount of the sales tax which has been paid, the person shall be entitled to such refund. Claim for refund of sales tax in relation to bad debt"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_36",
      "@type": "akn:clause",
      "eli:number": "36",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_36__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_36__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_36__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_36__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_36__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_36__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_36__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who is, or has ceased to be, a registered manufacturer may make a claim to the Director General for a refund of the whole or any part of any sales tax paid by him in respect of taxable goods if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_36__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_36__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the whole or any part of the sales tax payable to such person has been written off in his accounts as bad debts; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_36__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_36__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Director General is satisfied that all reasonable efforts have been made by such person to recover the sales tax."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_36__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_36__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_36__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "Where the person who makes a claim for a refund under subsection (1) in relation to bad debt—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_36__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_36__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "has not received any payment in respect of the sale of taxable goods, such person may make a claim for a refund of the whole of the sales tax paid; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_36__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_36__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "has received any payment in respect of the taxable goods, such person may make a claim for the difference between the sales tax paid and the amount calculated in accordance with the following formula: A x C B where A is the payment received in respect of the sale of such taxable goods; B is the sale value of such taxable goods plus sales tax payable on such taxable goods; and C is the sales tax payable on such taxable goods."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_36__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "The person referred to in subsection (1) may make a claim for a refund of the whole or any part of any sales tax in relation to the bad debt within six years from the date the sales tax is paid by him and the Director General may refund the whole or any part of the sales tax after being satisfied that the person has properly established the claim."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_36__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this section, “bad debt” means an outstanding amount of the payment in respect of the sale of taxable goods including the sales tax which is due to a person who is, or has ceased to be, a registered manufacturer but has not been paid to, and is irrecoverable by, the person. Repayment of sales tax in relation to bad debt"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_37",
      "@type": "akn:clause",
      "eli:number": "37",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "Where a refund of sales tax has been made under section 36 by the Director General to the person referred to in subsection 36(1) and any payment in respect of the sale of taxable goods for which the sales tax is payable is subsequently received by the person, the person shall repay to the Director General an amount calculated in accordance with the following formula: AxC B where A is the payment received in respect of the sale of such taxable goods; B is the sale value of such taxable goods plus sales tax payable on such taxable goods; and C is the sales tax payable on such taxable goods. Payment of sales tax, etc., short paid or erroneously refunded"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38__subsec_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "Where—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the whole or any part of any sales tax due and payable, surcharge accrued, or penalty, fee or other money payable, under this Act has not been paid by a person; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the whole or any part of any sales tax due and payable, surcharge accrued, or penalty, fee or other money payable, after having been paid, has been erroneously refunded to a person, the Director General shall demand from the person to pay the sales tax, surcharge, penalty, fee or other money, or the deficient sales tax, surcharge, penalty, fee or other money, or to repay the refund erroneously paid to him."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "The demand under subsection (1) shall be made within six years from the date on which—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the sales tax, surcharge, penalty, fee or other money was payable, or the deficient sales tax, surcharge, penalty, fee or other money was paid; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the refund was made."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "Upon receipt of the demand under subsection (1), the person shall—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "pay the sales tax, surcharge, penalty, fee or other money, or the deficient sales tax, surcharge, penalty, fee or other money; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "repay the refund erroneously paid to him."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to subsection (1), any goods belonging to the person referred to in subsection (1), which may be in customs control or excise control or at a place specified in the registration under section 13, may be seized until the sales tax, surcharge, penalty, fee or other money, or the deficient sales tax, surcharge, penalty, fee or other money, are paid, or the refund erroneously paid to him is repaid."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "If the sales tax, surcharge, penalty, fee or other money or the deficient sales tax, surcharge, penalty, fee or other money, or the refund to be repaid remains unpaid, as the case maybe, the Director General may sell such goods seized under subsection (4)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "after giving not less than thirty days’ notice in writing to the person or his agent if the name and address of such person or agent is known to the Director General; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "after giving due notice in the Gazette if the name and address of such person or his agent is not known to the Director General."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38__subsec_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38__subsec_6__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38__subsec_6__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38__subsec_6__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "The proceeds of the sale of any goods seized under subsection (4) shall be applied to the payment of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38__subsec_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "the sales tax, surcharge, penalty, fee or other money;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38__subsec_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "the deficient sales tax, surcharge, penalty, fee or other money;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38__subsec_6__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "the refund erroneously paid; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38__subsec_6__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "the recovery of the amount due or other charges which may be due in respect of selling off such goods, and the surplus, if any, shall be paid to the person, and if the person cannot be found within one month of the sale, such surplus shall be paid into the Consolidated Fund."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "If at the sale of any goods seized under subsection (4) no sufficient bid is forthcoming to defray the sales tax, surcharge, penalty, fee or other money payable or the deficient sales tax, surcharge, penalty, fee or other money payable or the refund erroneously paid, as the case may be, the goods shall be forfeited to the Government and shall be disposed of in such manner as the Director General may direct."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "Every auction sales of any goods seized under subsection (4) shall be conducted by or in the presence of a senior officer of sales tax. Refund of sales tax, etc., overpaid or erroneously paid"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_39__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_39__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_39__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_39__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_39__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_39__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_39__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_39__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_39",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_39__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_39__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "has overpaid or erroneously paid any sales tax, surcharge, penalty, fee or other money; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_39__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_39__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "is entitled to the refund under subsection 35(6) or 41(3), may make a claim for refund in the prescribed form."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_39__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_39__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_39__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_39",
      "schema:text": {
        "@language": "en",
        "@value": "A claim for refund under subsection (1) shall be made to the Director General within one year from the time—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_39__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_39__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "such overpayment or erroneous payment occurred; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_39__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_39__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "such entitlement of the refund under subsection 35(6) or 41(3) occurred."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_39__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_39",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General may make such refund in respect of the claim under subsection (1) after being satisfied that the person has properly established the claim."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_39__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_39",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General may reduce or disallow any refund due in respect of the claim under subsection (1) to the extent that the refund would unjustly enrich the person referred to in subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_39__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_39",
      "schema:text": {
        "@language": "en",
        "@value": "A claim for refund under this section shall be supported by such evidence as required by the Director General. Drawback"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_40__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_40__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_40__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General may allow drawback of the full amount of sales tax paid by a person in respect of taxable goods which are subsequently exported by the person from Malaysia subject to the regulations made under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_40__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "This section shall not apply to petroleum. Remission of sales tax, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_41",
      "@type": "akn:clause",
      "eli:number": "41",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_41__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_41__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_41__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_41__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may remit the whole or any part of the sales tax due and payable under this Act where he deems fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_41__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General may remit the whole or any part of the surcharge accrued, or penalty, fee or other money payable, under this Act where he deems fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_41__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_VI__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "Where a person who has been granted remission under subsection (1) or (2) has paid any of the sales tax, surcharge, penalty, fee or other money to which the remission relates, he shall be entitled to a refund of the amount of sales tax, surcharge, penalty, fee or other money which had been remitted."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_21__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_21__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_21__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_21__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_21__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "Every registered manufacturer who sells any taxable goods shall issue an invoice containing prescribed particulars in the national language or English language to the purchaser in respect of the transaction."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_21__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_21__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_21__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "No invoice showing an amount which purports to be sales tax shall be issued on the sale of any goods—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_21__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_21__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "which are not taxable goods; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_21__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_21__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "by a person who is not a registered manufacturer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_21__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "The amount of sales tax payable shall be collected by the registered manufacturer from the purchaser in addition to the price and any other amount due and payable by the purchaser in respect of the taxable goods."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_21__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1), (2) or (3) commits an offence. Production of invoices by computer"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_22__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_22__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of any provision under this Act relating to an invoice, a registered manufacturer shall be treated as having issued an invoice to a purchaser notwithstanding that there is no delivery of any equivalent document in paper form to the purchaser if the prescribed particulars referred to in subsection 21(1) are recorded in a computer and—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_22__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "are transmitted or made available to the purchaser by electronic means; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_22__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "are produced on any material other than paper and are delivered to the purchaser. Credit notes and debit notes"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "Where any taxable goods is sold by any registered manufacturer which involves the issuance and receipt of credit notes or debit notes under the prescribed circumstances and conditions, the registered manufacturer shall make deduction or addition of sales tax in his returns accordingly, and the credit notes and debit notes shall contain the prescribed particulars. Duty to keep records"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "(1) Every taxable person shall keep complete and true records written up to date of all transactions which affect or may affect his liability to sales tax, including the following records: (a) all records of sales of taxable goods by or to that taxable person including invoices, receipts, debit notes and credit notes; (b) all records of importation and exportation of taxable goods; and (c) all other records as the Director General may determine. (2) Any record kept under this section shall be— (a) preserved for a period of seven years from the latest date to which the record relates; (b) in the national language or English language; and (c) kept in Malaysia, except as otherwise approved by the Director General and subject to such conditions as he deems fit. (3) Where the record is in an electronically readable form, the record shall be kept in such manner as to enable the record to be readily accessible and convertible into writing. (4) Where the record is originally in a manual form and is subsequently converted into an electronic form, the record shall be retained in its original form prior to the conversion. (5) A copy of the record shall be admissible in evidence in any proceedings to the same extent as the record itself. (6) Any person who contravenes subsection (1), (2), (3) or (4) commits an offence and shall, on conviction, be liable to a fine not exceeding fifty thousand ringgit or to imprisonment for a term not exceeding three years or to both. Taxable period"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_25__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_25__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_25__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_25__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_25__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_25__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "The first taxable period of every taxable person shall begin from the date he should have been registered under section 13 and end on the last day of the following month and the subsequent taxable period shall be a period of two months ending on the last day of any month of any calendar year."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_25__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (1), the Director General may determine a different taxable period in respect of petroleum subject to such conditions as the Director General deems fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_25__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "A taxable person may apply in writing to the Director General for a taxable period other than the period as determined under subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_25__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_25__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_25__subsec_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_25__subsec_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General may, upon receiving any application under subsection (3)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_25__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_25__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "allow the application and the taxable period shall be the period as applied for;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_25__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_25__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "refuse the application and the taxable period shall remain as determined under subsection (1); or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_25__subsec_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_25__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "vary the length of the taxable period or the date on which the taxable period begins or ends."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_25__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General may, as he deems fit, reassign the taxable person to any taxable period other than the period to which he has been previously determined under subsection (1), (2) or (4). Furnishing of returns and payment of sales tax due and payable"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_26__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_26__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_26__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_26__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_26__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_26__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_26__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_26__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_26__subsec_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_26__subsec_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_26__subsec_11",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_26__subsec_12"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_26__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "Every taxable person shall, in respect of his taxable period, account for the sales tax due in a return as may be prescribed and the return shall be furnished to the Director General in the prescribed manner not later than the last day of the month following the end of his taxable period to which the return relates."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_26__subsec_10",
      "@type": "akn:subsection",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subsection (12), prosecution for the offence under subsection (8) may be instituted after the expiry of the period specified in paragraph (9)(c)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_26__subsec_11",
      "@type": "akn:subsection",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "The court may order that any taxable person who is convicted for the offence under subsection (8) to pay the penalty as specified in subsection (9)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_26__subsec_12",
      "@type": "akn:subsection",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "No prosecution for the offence under subsection (8) shall be instituted against any taxable person who has paid the amount of sales tax due and payable, and the penalty specified under subsection (9) within the period specified in subsection (9). Power to assess"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_26__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "Where a taxable period has been varied under paragraph 25(4)(c) and notwithstanding subsection (1), the return shall be furnished within thirty days from the end of the varied taxable period."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_26__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "Any registered manufacturer who ceases to be liable to be registered under section 17 or ceases to manufacture taxable goods under section 18 shall, not later than thirty days after such cessation, or such later date as the Director General may allow, furnish a return containing particulars as the Director General may determine in respect of that part of the last taxable period during which the person was registered."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_26__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "Where any registered manufacturer who ceases to carry on business as a manufacturer has in stock any taxable goods on which sales tax due and payable has not been paid and where subsection 11(4) does not apply, such registered manufacturer shall include particulars of those goods in the return to be furnished by him for his last taxable period as if such goods had been sold by him during such taxable period, and he shall pay the sales tax accordingly."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_26__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "Any taxable person who is required to furnish a return under this section shall pay to the Director General the amount of sales tax due and payable by him in respect of the taxable period to which the return relates not later than the last day on which he is required to furnish the return."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_26__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "The return referred to in subsections (1), (2), (3) and (4) shall be furnished whether or not there is sales tax to be paid."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_26__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_26__subsec_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_26__subsec_7__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "Any taxable person who—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_26__subsec_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_26__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "contravenes subsection (1), (2), (3) or (4); or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_26__subsec_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_26__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "furnishes an incorrect return, commits an offence and shall, on conviction, be liable to a fine not exceeding fifty thousand ringgit or to imprisonment for a term not exceeding three years or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_26__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "Any taxable person who fails to pay to the Director General the amount of sales tax due and payable under subsection (5) commits an offence and shall, on conviction, be liable to a fine not exceeding fifty thousand ringgit or to imprisonment for a term not exceeding three years or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_26__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_26__subsec_9__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_26__subsec_9__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_26__subsec_9__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "Where any sales tax due and payable is not paid wholly or partly by any taxable person after the last day on which it is due and payable under subsection (5) and no prosecution is instituted, the taxable person shall pay—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_26__subsec_9__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_26__subsec_9",
      "schema:text": {
        "@language": "en",
        "@value": "for the first thirty-day period that the sales tax is not paid wholly or partly after the expiry of the period specified under subsection (5), a penalty of ten per cent of the amount of sales tax which remains unpaid;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_26__subsec_9__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_26__subsec_9",
      "schema:text": {
        "@language": "en",
        "@value": "for the second thirty-day period that the sales tax is not paid wholly or partly after the expiry of the period specified under subsection (5), an additional penalty of fifteen per cent of the amount of sales tax which remains unpaid; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_26__subsec_9__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_26__subsec_9",
      "schema:text": {
        "@language": "en",
        "@value": "for the third thirty-day period that the sales tax is not paid wholly or partly after the expiry of the period specified under subsection (5), an additional penalty of fifteen per cent of the amount of sales tax which remains unpaid."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_10"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "Where any taxable person—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_10",
      "@type": "akn:subsection",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General may make any alteration in or addition to the assessment made under this section as he deems fit to ensure the correctness of the assessment and shall forthwith notify the person in writing. Recovery of sales tax, etc., as civil debt"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "fails to apply for registration under section 13;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "fails to furnish a return under section 26; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "furnishes a return which appears to the Director General to be incomplete or incorrect, the Director General may assess to the best of his judgment the amount of sales tax due and payable, and the penalty payable under subsection 26(9), if any, by the taxable person and shall forthwith notify him of the assessment in writing."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "Where an amount has been paid to any person as being a refund of sales tax under this Act which ought not to have been paid to him, the Director General may assess the amount of the refund as being sales tax due and payable by him and shall forthwith notify him of the assessment in writing."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "The assessment under subsections (1) and (2) shall not be made more than six years from the date on which the sales tax was due and payable or from the date on which the refund of sales tax was made, as the case may be, except where in the opinion of the Director General any form of fraud or wilful default has been committed by or on behalf of any person in relation to the sales tax or refund, the Director General may, for the purposes of making good any loss of sales tax or payment of refund of sales tax attributable to the fraud or wilful default, make an assessment at any time."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "The proper officer of sales tax may assess the sales tax payable on any taxable goods imported by any person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "Where any taxable person has obtained control of any taxable goods or has imported any taxable goods, the Director General may require him to account for the taxable goods."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_6__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_6__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "Where the taxable person fails to account for the taxable goods under subsection (5) by reason that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "the taxable goods have been sold by him;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "the taxable goods have been exported or removed by way of sale; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_6__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "the taxable goods have been lost or destroyed, the Director General may assess to the best of his judgement the amount of sales tax that would have been chargeable in respect of the taxable goods if the goods had been sold by him and shall forthwith notify the taxable person of the assessment in writing."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_7__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_7__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "Where—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "the Director General has made an assessment of sales tax under subsection (1) in respect of paragraph (1)(a) or (b);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "the sales tax assessed under paragraph (a) has been paid but no return has been furnished for the taxable period to which the assessment relates; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_7__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "the taxable person fails to furnish a return for any subsequent taxable period, the Director General may, as he deems fit, assess an amount of sales tax greater than that which he otherwise would have considered to be appropriate."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_8__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_8__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "Where it appears to the Director General that the amount which ought to have been assessed in an assessment under subsection (1), (2), (4), (6) or (7) exceeds the amount which was so assessed, he may—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_8",
      "schema:text": {
        "@language": "en",
        "@value": "under the same provision as that assessment was made; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_8",
      "schema:text": {
        "@language": "en",
        "@value": "within the taxable period during which that assessment could have been made, make a supplementary assessment of the amount of the excess and shall forthwith notify the taxable person in writing accordingly."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "Where an amount of sales tax and penalty, if any, has been assessed and notified to any taxable person under subsection (1), (2), (6) or (8), it shall be deemed to be an amount of sales tax due and payable, and penalty payable, by him and may be recovered accordingly and the amount of sales tax and penalty, if any, shall be paid by the taxable person, whether or not that taxable person appeals against the assessment, to the Director General unless or except to the extent that the assessment has been withdrawn or reduced by the Director General."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_28__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_28__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_28__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_28__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_28__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_28__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to any other remedy and notwithstanding any review or appeal against any decision of the Director General under section 96, any sales tax due and payable, any surcharge accruing, or any penalty, fee or other money payable, under this Act, may be recovered as a civil debt due to the Government."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_28__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_28__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_28__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "Where an invoice shows a sale of taxable goods as having taken place with sales tax chargeable on the goods, there shall be recoverable from the person who issued the invoice an amount equal to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_28__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_28__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "that which is shown in the invoice as sales tax; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_28__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_28__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "so much of the total amount shown as payable as is to be taken as representing sales tax, if the sales tax is not separately shown in the invoice, for the sale of such taxable goods."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_28__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_28__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_28__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_28__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection (2) shall apply whether or not—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_28__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_28__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the invoice is an invoice issued under section 21 or 22;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_28__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_28__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the sale of the taxable goods shown on the invoice actually takes or has taken place or the amount shown as sales tax or any amount of sales tax is or was chargeable on the sale of the taxable goods; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_28__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_28__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the person issuing the invoice is a registered manufacturer, and any amount recoverable from the person under subsection (2) shall be recoverable as such and shall otherwise be recoverable as a civil debt due to the Government."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_28__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_28__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_28__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "In any proceedings to recover the sales tax, surcharge, penalty, fee or other money under subsection (1), the production of a certificate signed by the Director General—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_28__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_28__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "stating that any sales tax, surcharge, penalty, fee or other money and the amount shown in the certificate as due and payable, accruing or payable, in any return, assessment or notice made under this Act from a person named in the certificate; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_28__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_28__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "giving the address of the person and purporting to be a copy of or an extract from any notice of assessment, shall be conclusive evidence of the sales tax, surcharge, penalty, fee or other money and the amount as due and payable, accruing or payable, in any return, assessment or notice and shall be sufficient authority for the court to give judgement for that amount."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_28__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "Any penalty imposed under this Act shall, for the purposes of this Act and the Limitation Act 1953 [Act 254], the Limitation Ordinance of Sabah [Sabah Cap. 72] or the Limitation Ordinance of Sarawak [Sarawak Cap. 49], as the case may be, be recoverable as if the penalty were sales tax due and payable under this Act and accordingly subsection 6(4) of the Limitation Act 1953, section 3 of the Limitation Ordinance of Sabah or section 3 of the Limitation Ordinance of Sarawak, as the case may be, shall not apply to that penalty. Power to collect sales tax, etc., from person owing money to taxable person"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_29__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_29__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_29__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_29__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_29__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_29__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_29__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_29__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_29__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "Where any sum by way of sales tax is due and payable, surcharge is accrued, or penalty, fee or other money is payable, by a taxable person, the Director General may, by notice in writing, require—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_29__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any person by whom any money is due or accruing or may become due and payable to the taxable person;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_29__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any person who holds or may subsequently hold money for or on account of the taxable person;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_29__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any person who holds or may subsequently hold money for or on account of any other person for payment to the taxable person; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_29__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any person having authority from any other person to pay money to the taxable person, to pay to the Director General forthwith, or within such time as the Director General allows, such money, not being salary or wages due or accruing to the taxable person, or so much of such money as is sufficient to pay the sum due and payable, accruing or payable, by the taxable person as aforesaid."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_29__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "A copy of the notice under subsection (1) shall be forwarded to the taxable person at his last known address."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_29__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "All payments made pursuant to a notice under subsection (1) shall be deemed to be made on behalf of the taxable person and with the authority of the taxable person and of all other persons concerned."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_29__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_29__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_29__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this section, the Director General may require any person to give him information—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_29__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_29__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "as to any money, fund or asset which may be held by the person for any other person; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_29__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_29__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "of any money due and payable by him to any other person. Recovery of sales tax before payable from persons about to leave Malaysia"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "If the Director General has reason to believe that any person is about or is likely to leave Malaysia before any sales tax due by him becomes payable in accordance with the provisions of this Act, the sales tax shall, if the Director General deems fit, be payable on such earlier date as the Director General determines and the person shall be notified accordingly. Recovery of sales tax, etc., from persons about to leave Malaysia without paying sales tax, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_31__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_31__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_31__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_31__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_31__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_31__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_31__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_31__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_31__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_31__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_31__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_31__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Director General has reason to believe that any person is about or is likely to leave Malaysia without paying—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_31__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_31__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any sales tax due and payable by him under subsection 26(5);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_31__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_31__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any penalty payable by him under subsection 26(9);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_31__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_31__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any surcharge accrued by him under subsection 32(3);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_31__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_31__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any fee payable by him under this Act; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_31__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_31__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any other money recoverable from him under this Act, the Director General may issue to the Director General of Immigration a notice containing particulars of the person and the offence committed with a request that the person be prevented from leaving Malaysia unless he pays the sales tax, surcharge, penalty, fee or other money, or furnishes security to the satisfaction of the Director General for its payment."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_31__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to any order issued or made under any written law for the time being in force relating to immigration, the Director General of Immigration who receives a request under subsection (1) in respect of a person shall exercise all measures which may include the removal and retention of any certificate of identity, passport, exit permit or other travel documents in relation to that person as may be necessary to give effect to the request."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_31__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General shall cause the notice under subsection (1) to be served personally or by registered post on the person to whom the notice relates."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_31__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "The non-receipt of the notice under subsection (1) by that person referred to in subsection (3) shall not invalidate anything done under this section."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_31__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "Where the person in respect of whom a notice has been issued under subsection (1) produces, on or after the date of the notice, a written statement signed by the Director General stating that all the sales tax, surcharge, penalty, fee or other money specified in the notice have been paid, or that security has been furnished for its payment, that statement shall be sufficient authority for allowing that person to leave Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_31__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "No legal proceedings shall be instituted or maintained against the Federal Government, a State Government or any other public officer in respect of anything lawfully done under this section. Payment by instalments"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_32__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_32__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_32__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_32__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_32__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General may allow any sales tax due and payable, or penalty payable, to be paid by instalments under the prescribed circumstances in such amounts and on such dates as the Director General may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_32__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "Where the sales tax is allowed to be paid by instalments, the penalty under subsection 26(9) shall cease to be calculated from the date the Director General allows the payment by instalments."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_32__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "Where there is a default in payment of any instalment under subsection (1) on its due date for payment of the balance of the amount due and payable, the whole outstanding balance shall become due and payable on that date and shall, without any further notice being served on the person liable to pay the amount due, be subject to a surcharge equals to ten per cent of that balance and the surcharge shall be recoverable as if it were due and payable under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_32__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "Nothing in subsections (1) and (3) shall prejudice the exercise of the rights and powers under this section by the Director General to seize or sell any goods belonging to the person liable to pay such sales tax, penalty or surcharge for recovery of the amount payable under subsections (1) and (3) or any outstanding balance of the sales tax, penalty or surcharge. Goods subject to customs or excise control not to be delivered until sales tax paid as demanded"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_33__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_33__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_33__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "In the case of imported taxable goods, no person shall be entitled to obtain delivery of such goods from the customs control or excise control until the amount of the sales tax assessed by the proper officer of sales tax on those goods has been paid in full."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_33__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (1), any person may obtain delivery of imported taxable petroleum from the customs control or excise control whether or not any part of or all of the sales tax due and payable on such taxable petroleum have been paid. Liability of directors, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_34",
      "@type": "akn:clause",
      "eli:number": "34",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_34__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_34__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_34__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_34__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_34__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_34__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_34__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_34__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding any written law to the contrary, but subject to subsection (2) in relation to a company that is being wound up, where sales tax is due and payable, surcharge is accrued, or penalty, fee or other money is payable, under this Act by any company, limited liability partnership, firm, society or other body of persons—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_34__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_34__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the directors of the company;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_34__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_34__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the compliance officer who is appointed amongst the partners of the limited liability partnership or if no compliance officer is appointed as such, any one or all of the partners of the limited liability partnership;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_34__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_34__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the partners of the firm;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_34__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_34__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the office-bearers of the society; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_34__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_34__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the persons responsible for the management of the body of persons, as the case may be, shall together with the company, limited liability partnership, firm, society or other body of persons be jointly and severally liable for the sales tax, surcharge, penalty, fee or other money."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_34__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "In relation to a company that is being wound up, the directors of the company shall only be liable where the assets of the company are insufficient to meet the amount due, after paying any sum having priority under the Companies Act 2016 [Act 777] in relation to the application of the assets of the company in the winding-up over the sales tax, surcharge, penalty, fee or other money."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_X",
      "@type": "akn:part",
      "eli:number": "X",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_X__cl_62",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_X__cl_63",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_X__cl_64",
