      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "TRIALS AND PROCEEDINGS Jurisdiction to try offences"
      }
    },
    {
