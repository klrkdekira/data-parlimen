        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_X__cl_72"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "ENFORCEMENT Persons bound to give information"
      }
    },
    {
