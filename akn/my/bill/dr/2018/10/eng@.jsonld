      "schema:text": {
        "@language": "en",
        "@value": "IMPOSITION AND SCOPE OF SALES TAX Imposition and scope of sales tax"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_10__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_10__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_10__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_10__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_10__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "Sales tax shall be charged and levied at the rate fixed in accordance with subsection (2) on the taxable goods sold, used or disposed of or imported, by reference to the sale value of the taxable goods as determined under section 9."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_10__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_10__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, by order published in the Gazette—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_10__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_10__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "fix the rate of sales tax to be charged and levied under this Act; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_10__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_10__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "vary or amend the rate of sales tax fixed under paragraph (a)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_10__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_10__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_10__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "Any order made under subsection (2) shall—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_10__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_10__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "be laid before the Dewan Rakyat at the next meeting of the Dewan Rakyat; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_10__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_10__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "at the expiration of one hundred and twenty days from being laid under paragraph (a) or of such extended period as the Dewan Rakyat may, by resolution, direct, cease to have effect in whole if the order is not confirmed, or in part in so far as the order is not confirmed, by a resolution passed by the Dewan Rakyat within the said one hundred and twenty days or, if such period has been extended, within such extended period."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_10__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "Where an order ceases to have effect in whole or in part as provided under subsection (3), any sales tax charged and levied in pursuance of such order or such part of the order as ceases to have effect shall, subject to subsections (5) and (6), be refundable to the person by whom such sales tax was paid."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_10__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "Unless the Minister otherwise directs, no sales tax refundable under subsection (4) shall be refunded, unless the person by whom the sales tax was paid makes a claim in writing to the Director General within one year from the date on which the order ceases to have effect in whole or in part, and the claim shall contain such particulars as the Director General may require."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_10__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General may reduce or disallow any sales tax refundable under subsection (4) to the extent that the refund would unjustly enrich the person by whom the sales tax was paid. Sales tax due"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_11__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_11__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_11__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "The sales tax chargeable under paragraph 8(1)(a) shall be due at the time the taxable goods are sold, disposed of otherwise than by sale, or first used otherwise than as materials in the manufacture of taxable goods, by the taxable person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_11__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_11__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_11__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_11__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Minister may determine different time for sales tax to be due in respect of petroleum subject to such conditions as the Minister deems fit; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_11__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_11__subsec_2__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_11__subsec_2__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_11__subsec_2__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_11__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "where any sale of taxable goods is made by any person, who is a taxable person under this Act, within the period beginning from 1 June 2018 and ending immediately before the effective date, and the taxable goods are delivered on or after the effective date—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_11__subsec_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_11__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "the sale of such taxable goods shall be deemed to have been made on the date such taxable goods are delivered notwithstanding any payment, wholly or partly, is received or invoice is issued, for such taxable goods during such period;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_11__subsec_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_11__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "any payment received within such period or on or after the effective date, or invoice issued within such period, shall be deemed to have been received or issued on the date such taxable goods are delivered; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_11__subsec_2__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_11__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "sales tax shall be charged and levied on such taxable goods and shall become due on the date such taxable goods are delivered."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_11__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "Where the taxable goods referred to in subparagraph (2)(b) are petroleum, the sales tax in respect of such petroleum shall be due at the time as determined under subparagraph (2)(a)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_11__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_11__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_11__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "Where any registered manufacturer who ceases to carry on business as a manufacturer is succeeded in such business by another person who—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_11__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_11__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "purchases from the registered manufacturer any stock of taxable goods which is on hand at the date of cessation; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_11__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_11__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "acquires any stock of taxable goods as a trustee, receiver, liquidator, donee, or beneficiary of such registered manufacturer, no sales tax shall be due on such purchase or acquisition."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_8__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_8__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_8__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_8__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_8__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "A tax to be known as sales tax shall be charged and levied on all taxable goods—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_8__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_8__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "manufactured in Malaysia by a registered manufacturer and sold, used or disposed of by him; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_8__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_8__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "imported into Malaysia by any person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "Sales tax on any importation of taxable goods into Malaysia shall be levied and payable as if it were a customs duty or an excise duty and as if the imported taxable goods are dutiable and liable to customs duty or excise duty."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_8__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall be construed as one with the Customs Act 1967 and the Excise Act 1976 [Act 176] with regards to the importation or exportation of goods including goods in transit and the movement of goods under customs control or excise control."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_8__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "Where there is any inconsistency between the provisions of the Customs Act 1967 or the Excise Act 1976 and the provisions of this Act, the provisions of this Act shall prevail. Determination of sale value of taxable goods"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_9__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_9__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_9__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_9__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "In the case of taxable goods—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_9__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_9__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "sold by a taxable person; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_9__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_9__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_9__subsec_1__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_9__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "manufactured by a taxable person and—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_9__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_9__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "used by him otherwise than as materials in the manufacture of the taxable goods; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_9__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_9__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "disposed of by him otherwise than by sale, the sale value of such taxable goods shall be determined in accordance with the regulations made under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_9__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_9__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_9__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "In the case of taxable goods imported into Malaysia, the sale value of the taxable goods shall be the sum of the following amounts:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_9__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_9__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the value of such taxable goods for the purpose of customs duty as determined in accordance with the Customs Act 1967;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_9__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_9__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the amount of customs duty, if any, paid or to be paid on such taxable goods; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_9__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_9__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the amount of excise duty, if any, paid or to be paid on such taxable goods."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_9__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_III__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "Where any registered manufacturer receives taxable goods from any person to be manufactured and subsequently return the goods so manufactured to such person, the sale value of the goods so manufactured shall, subject to approval of the Director General, be the amount that the manufacturer charges for work performed by him. Rate of sales tax"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_4__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_4__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_4__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_4__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General shall have the superintendence of all matters relating to sales tax, subject to the direction and control of the Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to the general direction and supervision of the Director General, a senior officer of sales tax shall have and exercise all powers conferred on the Director General by or under this Act, other than those conferred under sections 7, 41, 42 and 105."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_4__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "Any person, other than an officer of sales tax, may be appointed by, or employed with the concurrence of, the Director General for any duty or service relating to sales tax and such person shall be deemed to be an officer of sales tax for that duty or service."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_4__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General may, by authorization in writing, confer on any officer of sales tax not being a senior officer of sales tax all or any of the powers of a senior officer of sales tax for a period not exceeding ninety days in respect of any one authorization."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_4__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "Any officer of sales tax shall have the duties and powers to enforce and ensure due compliance with the provisions of this Act. Persons appointed or employed to be public servants"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "Every person appointed or employed under subsection 4(3) for any duty or service relating to sales tax shall be deemed to be a public servant within the meaning of the Penal Code [Act 574]. Recognition of office"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_6__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "Every officer of sales tax when discharging his duties shall, on demand made by any person, declare his office and produce to the person the authority card or badge prescribed under section 8a of the Customs Act 1967 or in the case of any officer of sales tax not being an officer of customs, any other authority card as may be approved by the Director General."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "It shall not be an offence for any person to refuse to comply with any request, demand or order made by any officer of sales tax acting or purporting to act under this Act if the officer refuses to declare his office and produce his authority card or badge on demand being made by the person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_6__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_6__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "Any person, not being an officer of sales tax, who unlawfully wears, uses, possesses or displays, otherwise than in the course of a stage play or other theatrical performance—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_6__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_6__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "any uniform prescribed under section 8a of the Customs Act 1967 or any dress having the appearance of, or bearing the distinctive marks of, such uniform; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_6__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_6__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "any prescribed authority card or badge, or authority card as approved by the Director General, referred to in subsection (1), commits an offence and shall, on conviction, be liable to a fine not exceeding fifty thousand ringgit or to imprisonment for a term not exceeding three years or to both. Confidentiality of information"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_7__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_7__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_7__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_7__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "Every person, having any official duty or being appointed or employed under this Act, shall regard and deal with all documents, information, returns or declarations relating to the business, sale value of the goods of any taxable person or the sale value of imported goods as confidential."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_7__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_7__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subsection (4), every person having possession or control over any document, information, return or declaration or copies thereof in relation to the business or the sale value of the goods of any taxable person or the sale value of imported goods, who at any time, otherwise than for the purposes of this Act or with the express authority of the Director General—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_7__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_7__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "communicates or attempts to communicate the information or anything contained in the document, return or declaration or copies thereof to any person; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_7__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_7__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "suffers or permits any person to have access to any information or to anything contained in the document, return or declaration or copies thereof, commits an offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_7__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "No person having any official duty or being appointed or employed under this Act or who is referred to in subsection (4) shall be required to produce in any matters or proceedings in any court or tribunal any document, information, return or declaration or to divulge or communicate in the matters or proceedings any matter or thing, coming under his notice in the performance of his duties under this Act, except as may be necessary for the purposes of carrying into effect the provisions of this Act or in order to institute a prosecution or in the course of a prosecution for any offence committed under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_7__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General may, as he deems fit, transmit or communicate any document, information, return or declaration referred to in subsection (1) or anything contained therein, to the Chief Statistician of the Department of Statistics Malaysia which may be required in the performance of his official duty."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_7__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (4), the Minister may, as he deems fit, allow the Director General to transmit or communicate any document, information, return or declaration referred to in subsection (1) or anything contained therein to any other person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_12",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_13",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_14",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_16",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_17",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_18",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_19",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_20"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "REGISTRATION Liability to be registered"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_12__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_12__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_12__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, by order published in the Gazette, determine the total sale value of taxable goods for the purpose of registration of any manufacturer under this Part."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_12__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_12__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subsection (3), any manufacturer of taxable goods is liable to be registered at the following time, whichever is the earlier:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_12__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_12__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "at the end of any month, where the total sale value of all his taxable goods in that month and the eleven months immediately preceding that month has exceeded the total sale value of taxable goods determined under subsection (1); or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_12__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_12__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "at the end of any month, where there are reasonable grounds for believing that the total sale value of all his taxable goods in that month and the eleven months immediately succeeding that month will exceed the total sale value of taxable goods determined under subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_12__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_12__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_12__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The total sale value of all taxable goods of a manufacturer in the month and the eleven months immediately preceding that month referred to in paragraph (2)(a) shall be disregarded if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_12__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_12__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the registration of the manufacturer is cancelled, otherwise than under subsection 19(3), during that period; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_12__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_12__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the Director General is satisfied that before the manufacturer’s registration is cancelled, he has given all information required by the Director General in order to determine whether to cancel the registration or not."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_12__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "Where any person succeeds any business from a registered manufacturer as specified in subsection 11(4), such person shall be deemed to be a manufacturer who is liable to be registered on the date he succeeded the business. Application for registration"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_13__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_13__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_13__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_13__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "Any manufacturer who is liable to be registered under section 12 shall apply to the Director General for registration as a registered manufacturer in the prescribed form not later than the last day of the month following the month in which he is liable to be registered as referred to in paragraph 12(2)(a) or (b)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "Upon receipt of the application under subsection (1), the Director General may approve the registration, subject to such conditions as he deems fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_13__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General shall register the manufacturer under subsection (1) with effect from the first day of the month following the month in which the application under subsection (1) is made or from such earlier date as may be agreed between the Director General and the manufacturer but such date shall not be earlier than the date he becomes liable to be registered."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_13__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "Where any manufacturer fails to comply with subsection (1), the Director General shall register the manufacturer on the date as the Director General may determine but not earlier than the date he is liable to be registered under section 12."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_13__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "Any manufacturer who fails to comply with subsection (1) commits an offence. Voluntary registration"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_14__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "Any manufacturer who is not liable to be registered under section 12 may apply to the Director General for registration as a registered manufacturer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "Upon receipt of the application under subsection (1), the Director General may approve the registration from such date as he may determine subject to such conditions as he deems fit. Direction to treat persons as single taxable person"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_11"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding section 12, where the Director General is satisfied that any separation of business activities is artificial, he may make a direction requiring that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_10",
      "@type": "akn:subsection",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_10__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_10__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_10__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_10__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_10__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "Where any direction is made under subsection (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_10__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_10",
      "schema:text": {
        "@language": "en",
        "@value": "the single taxable person carrying on the business specified in the direction shall be registered in such name as the persons named in the direction may jointly nominate by notice in writing given to the Director General not later than fourteen days after the date the direction is served on the last of such persons named in the direction or, in default of such nomination, in such name as may be specified in the direction;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_10__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_10",
      "schema:text": {
        "@language": "en",
        "@value": "any taxable goods manufactured by one of the constituent members in the course of the activities of the single taxable person shall be treated as being taxable goods manufactured by the single taxable person;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_10__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_10",
      "schema:text": {
        "@language": "en",
        "@value": "each of the constituent members shall be jointly and severally liable for any sales tax due and payable by the single taxable person;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_10__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_10",
      "schema:text": {
        "@language": "en",
        "@value": "without prejudice to paragraph (c), any failure by the single taxable person to comply with any requirement imposed under this Act shall be treated as a failure by each of the constituent members severally; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_10__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_10",
      "schema:text": {
        "@language": "en",
        "@value": "subject to paragraphs (a) to (d), the constituent members shall be treated as a partnership carrying on the business of the single taxable person and any question as to the scope of the activities of that business at any time shall be determined accordingly."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_11",
      "@type": "akn:subsection",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_11__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_11__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "Where it appears to the Director General that any person who is one of the constituent members should no longer be regarded as such for the purposes of paragraphs (10)(c) and (d) and the Director General gives notice in writing to that effect, that person—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_11__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_11",
      "schema:text": {
        "@language": "en",
        "@value": "shall not have any liability by virtue of paragraphs (10)(c) and (d) for anything done after the date specified in that notice; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_11__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_11",
      "schema:text": {
        "@language": "en",
        "@value": "on the date as specified in that notice, shall be treated as having ceased to be a member of the partnership referred to in paragraph (10)(e). Registration of partnership"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the persons named in that direction be treated as a single taxable person carrying on business activities described in that direction with effect from the date as specified in the direction; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the single taxable person referred to in paragraph (a) to be registered with effect from the date as specified in the direction."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of subsection (1), in determining whether any separation of business activities is artificial, regard shall be had to the extent to which the different persons carrying on those business activities are closely bound to one another by financial, economic and organizational links."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General may make a direction under subsection (1) naming any person if the Director General is satisfied that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the person is manufacturing or has manufactured taxable goods;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the activities in the course of which the person manufactures or has manufactured those taxable goods form only part of certain activities in the business and that the other activities in that business, whether or not that other activities are similar to the activities carried on by that person, are being carried on concurrently or previously, or both, by one or more other persons; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "if all taxable goods manufactured in that business were taken into account, the person carrying on that business would, at the time of such direction is made, be required to be registered by virtue of section 12."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "Any direction made under subsection (1) shall be served on each of the persons named in it."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "Where, after a direction had been made under subsection (1), it appears to the Director General that any person who has not been named in that direction is manufacturing taxable goods in the course of activities which should be regarded as part of the business activities, the Director General may make and serve on that person a supplementary direction adding that person’s name to those of the persons named in the direction under subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "Upon the addition of the person’s name in the direction under subsection (5), that person shall be treated as a single taxable person carrying on the business activities described in the direction under subsection (1) with effect from the date as specified in the direction."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "Where, immediately before any direction including a supplementary direction is made, any person named in the direction has been registered in respect of taxable goods manufactured by him as specified in subsection (3) or (5), his registration shall be revoked by the Director General with effect from the date the single taxable person is registered under subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "Upon the revocation of registration under subsection (7), the person whose registration has been revoked together with all other persons named in the direction under subsection (1) shall be treated as a single taxable person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "In relation to a business specified in a direction, the persons named in such direction together with any person named in a supplementary direction relating to that business, being the persons who together are to be treated as a single taxable person, are referred to as the “constituent members” in subsections (10) and (11)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_16__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_16__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_16__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_16__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_16__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_16__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_16__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_16__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_16__subsec_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_16__subsec_10"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_16__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_16__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_16__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The registration of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_16__subsec_10",
      "@type": "akn:subsection",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this section, a partnership excludes a limited liability partnership. Cessation of liability to be registered"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_16__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_16__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "persons carrying on a business in a partnership as a registered manufacturer shall be in the name of the firm; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_16__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_16__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the same persons carrying on separate businesses in a partnership as a registered manufacturer shall be in the separate names of the respective firms."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "In determining whether taxable goods are manufactured by the persons referred to in subsection (1), no account shall be taken of any change in the partnership."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_16__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_16__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_16__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who ceases to be a partner in a partnership shall—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_16__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_16__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "notify the Director General in writing of the date of cessation within thirty days from the date of cessation; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_16__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_16__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "pay for the proportion of the partnership’s liability on any sales tax due and payable on any taxable goods manufactured by the partnership until the date of cessation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_16__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "Where any person ceases to be a partner in a partnership under subsection (3) during any taxable period, any notice, whether of assessment or otherwise, which is served on the partnership and relates to the taxable period or to any other taxable period during the whole or part of which he was a partner in the partnership, shall be deemed as to have been served also on him."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_16__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_16__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_16__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding any written law to the contrary, any notice, whether of assessment or otherwise, which is addressed to a partnership by the name in which it is registered under this Act, and is served in accordance with this Act shall be deemed—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_16__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_16__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "as having been properly served on the partnership; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_16__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_16__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "where subsection (4) applies, as having been properly served on any previous partner."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_16__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "Subsections (1) and (3) shall not affect the extent to which a partner is liable for sales tax owed by the firm under any other written law."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_16__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "Where a person is a partner in a firm during part only of a taxable period, his liability for sales tax on the sale of taxable goods by the firm during the taxable period shall be the proportion of the firm’s liability as may be just."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_16__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "Where any notice is required to be given by a partnership under this Act, it shall be the joint and several liability of all partners to give the notice, except that if a notice is given by any of the partners, it shall be regarded as sufficient compliance with the requirement."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_16__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes paragraph (3)(a) or (b) commits an offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_17__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subsection (2), any registered manufacturer shall cease to be liable to be registered at the end of any month where the Director General is satisfied that the total sale value of all his taxable goods in that month and the eleven months immediately succeeding that month (“hereinafter referred to as “the period of twelve months”) does not exceed the total sale value of taxable goods determined under subsection 12(1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "A registered manufacturer shall not cease to be liable to be registered by virtue of subsection (1) where the Director General is satisfied that the reason the total sale value of all his taxable goods does not exceed the total sale value of taxable goods determined under subsection 12(1) is that in the period of twelve months referred to in subsection (1) he temporarily ceases manufacturing such taxable goods, or suspends manufacturing such taxable goods for a period of thirty days or more. Notification of cessation of liability"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_18__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_18__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_18__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_18__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "A manufacturer registered under section 13 or 14—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_18__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_18__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "who ceases to manufacture taxable goods; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_18__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_18__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "who ceases to be liable to be registered under section 17, as the case may be, shall notify the Director General in writing of that fact and the date of cessation within thirty days from the date of cessation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) commits an offence. Cancellation of registration"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_19__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_19__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_19__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_19__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_19__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "Where a registered manufacturer makes a notification under section 18, the Director General may cancel the manufacturer’s registration from the date the registered manufacturer ceased to manufacture taxable goods or ceased to be liable to be registered under section 17, as the case may be, or from such later date as the Director General may determine if he is satisfied that the registered manufacturer can be deregistered."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_19__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "Where there is no notification made under section 18 and the Director General is satisfied that a registered manufacturer has ceased to manufacture taxable goods or has ceased to be liable to be registered under section 17, the Director General may cancel his registration from the date the registered manufacturer ceased to manufacture taxable goods or ceased to be liable to be registered under section 17, as the case may be, or from such later date as the Director General may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_19__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_19__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_19__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Director General is satisfied that on the day on which a manufacturer was registered—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_19__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_19__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of a manufacturer who was registered under section 13, the manufacturer was not liable to be registered under section 12 or has ceased to manufacture taxable goods; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_19__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_19__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of a manufacturer who was registered under section 14, the manufacturer was not manufacturing taxable goods or has ceased to manufacture taxable goods, the Director General may cancel the registration of the manufacturer with effect from the date as determined by the Director General in the notification in writing to such manufacturer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_19__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General may cancel the registration of a registered manufacturer under subsection 14(2) if the registered manufacturer is in breach of any conditions imposed in relation to such registration with effect from the date of the breach or from such later date as the Director General may determine. Exemptions from registration"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_20__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_20__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_20__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, by order published in the Gazette, exempt any class of persons from registration under section 13 subject to such conditions as he deems fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_20__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IV__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding that any person is exempted by virtue of subsection (1), such person may apply to be registered as a registered manufacturer and the provisions of this Act shall apply to such person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX",
      "@type": "akn:part",
      "eli:number": "IX",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_55",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_56",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_57",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_58",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_59",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_60",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_61"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "SPECIAL PROVISIONS RELATING TO SPECIAL AREAS Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_55",
      "@type": "akn:clause",
      "eli:number": "55",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX",
      "schema:text": {
        "@language": "en",
        "@value": "In this Part, “Malaysia” excludes the special areas and the designated areas. Application"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_56",
      "@type": "akn:clause",
      "eli:number": "56",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this Part, this Act shall not apply to any taxable goods manufactured in the special areas. Sales tax relating to taxable goods imported into or transported to or from special areas"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_57",
      "@type": "akn:clause",
      "eli:number": "57",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_57__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_57__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_57__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX",
      "schema:name": {
        "@language": "en",
        "@value": "Notwithstanding anything to the contrary contained in this Act—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_57__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_57__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_57__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_57__para_a__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_57",
      "schema:text": {
        "@language": "en",
        "@value": "no sales tax shall be levied and payable on any taxable goods—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_57__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_57__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "imported into the special areas or transported to the special areas from Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_57__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_57__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "transported between the special areas; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_57__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_57__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "transported from the special areas to the designated areas, other than any taxable goods which the Minister may from time to time declare by order published in the Gazette;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_57__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_57",
      "schema:text": {
        "@language": "en",
        "@value": "sales tax shall be levied and payable on all taxable goods transported to Malaysia from the special areas as if such transportation to Malaysia were importation into Malaysia; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_57__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_57",
      "schema:text": {
        "@language": "en",
        "@value": "the sale value of taxable goods liable to sales tax in accordance with paragraph (b) shall be determined in accordance with subsection 9(2). Transportation of taxable goods from or to special areas to or from Malaysia"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_58",
      "@type": "akn:clause",
      "eli:number": "58",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_58__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_58__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_58__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_58__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_58__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_58",
      "schema:text": {
        "@language": "en",
        "@value": "Where taxable goods are transported—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_58__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_58__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "from the special areas to Malaysia; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_58__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_58__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "from Malaysia to the special areas, the provisions of this Act shall, with such modifications and adaptations as may be necessary, apply as if such goods were imported into, or exported from, Malaysia from or to a place outside Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_58__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_58__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_58__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_58",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to the generality of subsection (1), Part X shall apply to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_58__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_58__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "taxable goods transported to or from the special areas from or to Malaysia; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_58__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_58__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "persons, and vehicles, vessels and aircrafts, transporting such goods. Declaration of taxable goods transported from special areas to Malaysia"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_59",
      "@type": "akn:clause",
      "eli:number": "59",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX",
      "schema:text": {
        "@language": "en",
        "@value": "The person in charge of any vehicle, vessel or aircraft on which taxable goods are transported from the special areas to Malaysia shall make a declaration substantially in the form as prescribed under the Customs Act 1967 giving particulars of the taxable goods transported in such vehicle, vessel or aircraft. Collection of sales tax in special areas"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_60",
      "@type": "akn:clause",
      "eli:number": "60",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_60__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_60__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_60__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX",
      "schema:name": {
        "@language": "en",
        "@value": "In making regulations under section 106, the Minister may provide—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_60__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_60",
      "schema:text": {
        "@language": "en",
        "@value": "for the collection in the special areas of sales tax payable in respect of taxable goods transported or about to be transported from or to the special areas to or from Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_60__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_60",
      "schema:text": {
        "@language": "en",
        "@value": "for the limitation or restriction of vehicles, vessels or aircrafts which may be used to transport taxable goods; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_60__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_60",
      "schema:text": {
        "@language": "en",
        "@value": "for the licensing or control of persons, or vehicles, vessels or aircrafts, transporting taxable goods. Application of section 40 to taxable goods transported to special areas"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX__cl_61",
      "@type": "akn:clause",
      "eli:number": "61",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_IX",
      "schema:text": {
        "@language": "en",
        "@value": "Section 40 shall apply to taxable goods, other than any goods declared by the Minister under paragraph 57(a) to be taxable on importation into the special areas, transported from Malaysia to the special areas as if such goods had been exported or re-exported, as the case may be."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_I__cl_1__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_I__cl_1__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Sales Tax Act 2018."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette and the Minister may appoint different dates for the coming into operation of different Parts or different provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_I__cl_1__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (2), the Minister may, by notification in the Gazette, appoint the effective date for the charging and levying of sales tax under this Act. Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_I__cl_2__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_I__cl_2__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_I__cl_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_I__cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "In this Act, unless the context otherwise requires— “this Act” includes any subsidiary legislation made under this Act; “goods” means all kinds of movable property; “taxable goods” means goods of a class or kind not exempted from sales tax; “sales tax” means the tax payable under this Act; “prescribed” means prescribed by the Minister in the regulations made under this Act; “document” has the meaning assigned to it under section 3 of the Evidence Act 1950 [Act 56]; “licensed warehouse” means any warehouse or place licensed under section 65 of the Customs Act 1967 [Act 235]; “customs warehouse” has the meaning assigned to it under subsection 2(1) of the Customs Act 1967; “licensed manufacturing warehouse” means a licensed warehouse in respect of which an additional licence to carry on any manufacturing process has been granted under section 65a of the Customs Act 1967; “sale” includes barter, disposal of goods with a right of purchase or on terms providing that the seller retains an interest in the goods, and delivery of goods under any conditions as to future payment; “designated areas” means Labuan, Langkawi and Tioman; “special areas” means any free zone, licensed warehouse and licensed manufacturing warehouse, and the Joint Development Area; “Joint Development Area” has the meaning assigned to it under section 2 of the Malaysia-Thailand Joint Authority Act 1990 [Act 440]; “customs ruling” means any customs ruling made by the Director General under section 44; “Director General” means the Director General of Customs and Excise appointed under subsection 3(1) of the Customs Act 1967; “computer” has the meaning assigned to it under section 3 of the Evidence Act 1950; “Labuan” means the Island of Labuan and its dependent islands, namely Rusukan Besar, Rusukan Kecil, Keraman, Burong, Papan and Daat; “Langkawi” means the Island of Langkawi and all adjacent islands lying nearer to the Island of Langkawi than to the mainland; “Minister” means the Minister charged with the responsibility for finance; “taxable person” means a registered manufacturer or a manufacturer who is liable to be registered under section 12; “officer of sales tax” means any officer of customs as defined in subsection 2(1) of the Customs Act 1967 and includes any person appointed or employed under subsection 4(3); “proper officer of sales tax” means any senior officer of sales tax or officer of sales tax acting in the fulfilment of his duties under this Act, whether such duties are assigned to him specially or generally, or expressly or by implication; “senior officer of sales tax” means any senior officer of customs as defined in subsection 2(1) of the Customs Act 1967; “conveyance” includes any vessel, train, vehicle, aircraft or any other means of transport by which persons or goods can be carried; “manufacturer” means a person who engages in the manufacture of goods; “registered manufacturer” means a manufacturer registered under section 13 or 14; “regulations” means regulations made under section 106; “limited liability partnership” has the meaning assigned to it under section 2 of the Limited Liability Partnerships Act 2012 [Act 743]; “business” includes any trade, commerce or manufacture, or any concern in the nature of trade, commerce or manufacture; “petroleum” has the meaning assigned to it under subsection 2(1) of the Customs Act 1967; “effective date” means the date appointed under subsection 1(3); “taxable period” means any period as determined or provided for under section 25; “Tioman” means the Island of Tioman and the islands of Soyak, Rengis, Tumok, Tulai, Chebeh, Labas, Sepoi and Jahat; “Customs Appeal Tribunal” means the Customs Appeal Tribunal established under section 141b of the Customs Act 1967; “surcharge” means the surcharge referred to in subsection 32(3); “free zone” has the meaning assigned to it under subsection 2(1) of the Free Zones Act 1990 [Act 438]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_I__cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_I__cl_2__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_I__cl_2__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_I__cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "For the purpose of this Act—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_I__cl_2__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_I__cl_2__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "goods shall be deemed to be under customs control whilst the goods are deposited or held in any customs warehouse or licensed warehouse, post office, or in any conveyance, pipeline or place from which the goods may not be removed except with the permission of the proper officer of sales tax; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_I__cl_2__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_I__cl_2__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "goods shall be deemed to be under excise control whilst the goods are deposited or held in any distillery, brewery or other places of manufacture, or in any public excise warehouse, licensed warehouse, post office, or in any conveyance, pipeline or place from which the goods may not be removed except with the permission of the proper officer of sales tax. Meaning of “manufacture”"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_I__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_I__cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_I__cl_3__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_I__cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_I__cl_3__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_I__cl_3__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_I__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "In this Act, “manufacture” means—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_I__cl_3__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_I__cl_3__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "in relation to goods other than petroleum, the conversion by manual or mechanical means of organic or inorganic materials into a new product by changing the size, shape, composition, nature or quality of such materials and includes the assembly of parts into a piece of machinery or other products, but does not include the installation of machinery or equipment for the purpose of construction; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_I__cl_3__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_I__cl_3__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "in relation to petroleum, any process of separation, purification, refining, conversion and blending."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_I__cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_I__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "If any question arises as to the meaning of “manufacture” under subsection (1), such question shall be decided by the Minister whose decision shall be final."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_V",
      "@type": "akn:part",
