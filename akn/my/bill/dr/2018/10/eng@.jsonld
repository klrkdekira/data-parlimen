        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_X__cl_67",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_X__cl_68",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_X__cl_69",
