      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_XIII",
      "@type": "akn:part",
      "eli:number": "XIII",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/eng@/~part_XIII__cl_107",
