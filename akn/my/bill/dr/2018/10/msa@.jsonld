        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_98",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_99",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_100",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_101",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_102",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_103",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_104",
