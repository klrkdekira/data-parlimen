      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "AM Pengelakan cukai jualan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XIII",
      "@type": "akn:part",
      "eli:number": "XIII",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XIII__cl_107",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XIII__cl_108",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XIII__cl_109"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "KECUALIAN DAN PERALIHAN Pendaftaran pada tarikh permulaan kuat kuasa"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XIII__cl_107",
      "@type": "akn:clause",
      "eli:number": "107",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XIII__cl_107__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XIII__cl_107__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XIII__cl_107__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XIII__cl_107__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XIII__cl_107__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XIII__cl_107",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun seksyen 13, mana-mana orang yang mengilang barang sebelum tarikh efektif yang barang itu merupakan barang bercukai pada tarikh efektif hendaklah, dalam masa tiga puluh hari dari tarikh permulaan kuat kuasa Akta ini, memohon kepada Ketua Pengarah untuk didaftarkan sebagai pengilang berdaftar jika terdapat alasan yang munasabah untuk mempercayai bahawa jumlah nilai jualan bagi semua barang bercukainya dalam bulan tarikh efektif itu dan sebelas bulan sebaik selepas bulan itu akan melebihi jumlah nilai jualan barang bercukai yang ditentukan dalam subseksyen 12(1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XIII__cl_107__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XIII__cl_107",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah hendaklah mendaftarkan orang yang disebut dalam subseksyen (1) berkuat kuasa dari hari pertama bagi bulan selepas bulan yang permohonan itu dibuat, dan orang itu hendaklah mengenakan cukai jualan ke atas barang bercukai yang dijual, digunakan atau dilupuskan oleh orang itu berkuat kuasa dari hari itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XIII__cl_107__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XIII__cl_107__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XIII__cl_107__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XIII__cl_107",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang mengilang barang sebelum tarikh efektif yang barang itu merupakan barang bercukai pada tarikh efektif dan telah membuat permohonan sebelum tarikh efektif kepada Ketua Pengarah untuk didaftarkan sebagai pengilang berdaftar di bawah Akta ini—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XIII__cl_107__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XIII__cl_107__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah disifatkan sebagai telah didaftarkan mengikut seksyen 13 pada tarikh efektif jika terdapat alasan yang munasabah untuk mempercayai bahawa jumlah nilai jualan semua barang bercukainya dalam bulan bagi tarikh efektif dan sebelas bulan sebaik selepas bulan itu akan melebihi jumlah nilai jualan barang bercukai yang ditentukan di bawah subseksyen 12(1); dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XIII__cl_107__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XIII__cl_107__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah mengenakan cukai jualan ke atas barang bercukai yang dijual, digunakan atau dilupuskan oleh orang itu berkuat kuasa dari tarikh efektif."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XIII__cl_107__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XIII__cl_107__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XIII__cl_107__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XIII__cl_107",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengilang yang didaftarkan di bawah Akta Cukai Barang dan Perkhidmatan 2014 [Akta 762] sebelum tarikh efektif dan mengilang barang bercukai pada tarikh efektif—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XIII__cl_107__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XIII__cl_107__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah disifatkan sebagai telah didaftarkan mengikut seksyen 13 pada tarikh efektif jika terdapat alasan yang munasabah untuk mempercayai bahawa jumlah nilai jualan semua barang bercukainya dalam bulan bagi tarikh efektif dan sebelas bulan sebaik selepas bulan itu akan melebihi jumlah nilai jualan barang bercukai yang ditentukan di bawah subseksyen 12(1); dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XIII__cl_107__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XIII__cl_107__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah mengenakan cukai jualan ke atas barang bercukai yang dijual, digunakan atau dilupuskan oleh pengilang itu berkuat kuasa dari tarikh efektif. Perjanjian berperingkat atau berkala"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XIII__cl_108",
      "@type": "akn:clause",
      "eli:number": "108",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XIII__cl_108__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XIII__cl_108__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XIII__cl_108__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XIII__cl_108__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XIII__cl_108",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika apa-apa jualan barang bercukai dibuat di bawah suatu perjanjian bagi suatu tempoh atau secara berperingkat bagi suatu tempoh sama ada atau tidak pada lat tempoh yang tetap dan tempoh itu bermula sebelum 1 Jun 2018 dan berakhir selepas tarikh efektif, bahagian jualan yang dihubungkaitkan dengan bahagian bagi tempoh selepas tarikh efektif hendaklah dikenakan cukai jualan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XIII__cl_108__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XIII__cl_108",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika jualan yang disebut dalam subseksyen (1) dibuat di bawah suatu waranti sama ada yang nyata, tersirat atau dikehendaki oleh undang-undang dan nilai waranti itu dimasukkan ke dalam harga barang itu, tiada cukai jualan boleh dikenakan ke atas penggantian barang itu di bawah waranti itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XIII__cl_108__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XIII__cl_108",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen (1) tidak terpakai bagi penjualan barang yang cukai barang dan perkhidmatan di bawah Akta Cukai Barang dan Perkhidmatan 2014 telah dibayar atas penjualan barang itu setakat yang diliputi oleh invois itu. Perkara yang dilakukan pada menjangkakan Akta ini diperbuat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XIII__cl_109",
      "@type": "akn:clause",
      "eli:number": "109",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XIII",
      "schema:text": {
        "@language": "ms",
        "@value": "Segala perbuatan dan perkara yang dilakukan oleh atau bagi pihak Ketua Pengarah sebagai persediaan bagi atau pada menjangkakan pembuatan Akta ini dan apa-apa perbelanjaan yang dilakukan berhubung dengannya hendaklah disifatkan sebagai telah dibenarkan di bawah Akta ini, dengan syarat bahawa perbuatan dan perkara yang dilakukan itu adalah selaras dengan niat dan maksud am Akta ini, dan segala hak dan obligasi yang diperoleh atau ditanggung akibat pelakuan perbuatan atau perkara itu termasuk apa-apa perbelanjaan yang dilakukan berhubung dengannya hendaklah apabila Akta ini mula berkuat kuasa disifatkan sebagai hak dan obligasi Ketua Pengarah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_100",
      "@type": "akn:clause",
      "eli:number": "100",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII",
      "schema:text": {
        "@language": "ms",
        "@value": "Pemulaan prosiding atau pengenaan suatu penalti, denda atau tempoh pemenjaraan di bawah Akta ini atau pengkompaunan suatu kesalahan di bawah seksyen 95 tidak boleh melepaskan mana-mana orang daripada tanggungan untuk membayar cukai jualan, surcaj, penalti, fi atau wang lain di bawah Akta ini. Penyampaian notis, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_101",
      "@type": "akn:clause",
      "eli:number": "101",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_101__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_101__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_101__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_101__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_101__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_101__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_101__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_101",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap notis, arahan atau dokumen lain yang dikehendaki oleh Akta ini supaya disampaikan kepada mana-mana orang boleh disampaikan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_101__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_101__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "secara ke diri kepada orang itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_101__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_101__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menghantarnya kepada orang itu melalui pos berdaftar; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_101__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_101__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "melalui perkhidmatan elektronik di bawah seksyen 102."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_101__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_101__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_101__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_101",
      "schema:text": {
        "@language": "ms",
        "@value": "Notis, arahan atau dokumen lain yang dihantar melalui pos berdaftar kepada seseorang hendaklah disifatkan telah disampaikan kepada orang itu pada masa ia sepatutnya telah diserahkan kepada orang itu dalam perjalanan biasa pos itu jika notis, arahan atau dokumen lain itu telah dialamatkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_101__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_101__subsec_2__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_101__subsec_2__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_101__subsec_2__para_a__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_101__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal suatu syarikat, perkongsian liabiliti terhad, firma, pertubuhan atau kumpulan orang yang lain—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_101__subsec_2__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_101__subsec_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "ke pejabat berdaftarnya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_101__subsec_2__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_101__subsec_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "ke alamatnya yang terakhir diketahui; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_101__subsec_2__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_101__subsec_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "kepada mana-mana orang yang diberi kuasa olehnya untuk menerima penyampaian proses; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_101__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_101__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal orang perseorangan, ke alamatnya yang terakhir diketahui."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_101__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_101",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seseorang telah memberikan persetujuannya bagi suatu notis disampaikan kepadanya melalui perkhidmatan elektronik, notis itu hendaklah disifatkan telah disampaikan pada masa apabila notis elektronik itu dihantar ke akaunnya melalui perkhidmatan elektronik itu. Penggunaan perkhidmatan elektronik"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_102",
      "@type": "akn:clause",
      "eli:number": "102",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_102__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_102__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_102__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_102__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_102__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_102__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_102__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_102",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun apa-apa peruntukan lain Akta ini dan tertakluk kepada peraturan-peraturan yang dibuat di bawah Akta ini, Ketua Pengarah boleh menyediakan suatu perkhidmatan elektronik kepada mana-mana pengguna berdaftar bagi—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_102__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_102__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pemfailan atau pengemukaan apa-apa permohonan, penyata, perisytiharan atau apa-apa dokumen lain; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_102__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_102__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "penyampaian apa-apa notis, arahan, perintah, permit, resit atau apa-apa dokumen lain."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_102__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_102",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu notis elektronik dibuat dan dihantar kepada Ketua Pengarah, Ketua Pengarah tidak bertanggungan terhadap apa-apa kerugian atau kerosakan yang dialami oleh pengguna berdaftar itu atas sebab apa-apa kesilapan atau peninggalan tidak kira dengan apa jua sifat atau tidak kira bagaimana jua sekali pun berbangkit yang terdapat dalam apa-apa notis elektronik yang diperoleh oleh pengguna berdaftar itu di bawah perkhidmatan elektronik jika kesilapan atau peninggalan itu dibuat dengan suci hati dan dalam penjalanan biasa penunaian kewajipan Ketua Pengarah atau berlaku atau timbul akibat daripada apa-apa kecacatan atau kegagalan dalam perkhidmatan elektronik itu atau dalam kelengkapan yang digunakan bagi penyediaan perkhidmatan elektronik itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_102__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_102",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa notis elektronik yang dibuat dan dihantar oleh pengguna berdaftar hendaklah disifatkan sebagai telah difailkan, dikemukakan atau disampaikan pada masa notis elektronik itu diterima oleh Ketua Pengarah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_102__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_102",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini, “pengguna berdaftar” ertinya mana-mana orang yang diberi kuasa secara bertulis oleh Ketua Pengarah untuk mengakses dan menggunakan perkhidmatan elektronik. Perlindungan pegawai cukai jualan daripada tanggungan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_103",
      "@type": "akn:clause",
      "eli:number": "103",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada pegawai cukai jualan atau orang lain yang diambil kerja oleh Kerajaan dalam penjalanan pelaksanaan kewajipannya di bawah Akta ini bertanggungan untuk membayar apa-apa kerugian yang dialami berkenaan dengan apa-apa barang yang disebabkan oleh kebakaran, kecurian, kerosakan atau sebab lain semasa barang itu berada dalam kawalan kastam atau kawalan eksais atau dalam jagaan atau kawalan sah pegawai cukai jualan itu atau orang lain yang diambil kerja oleh Kerajaan dalam penjalanan pelaksanaan kewajipannya di bawah Akta ini melainkan jika kerugian itu disebabkan oleh pengabaian atau keingkaran yang disengajakan olehnya. Ganjaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_104",
      "@type": "akn:clause",
      "eli:number": "104",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah boleh memerintahkan apa-apa ganjaran sebagaimana yang difikirkan patut olehnya supaya dibayar kepada mana-mana pegawai cukai jualan atau orang lain bagi perkhidmatan yang diberikan berkaitan dengan pengesanan apa-apa kesalahan terhadap Akta ini. Kuasa Ketua Pengarah untuk mengenakan fi"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_105",
      "@type": "akn:clause",
      "eli:number": "105",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_105__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_105__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah boleh mengenakan apa-apa fi sebagaimana yang difikirkan munasabah olehnya berkenaan dengan apa-apa perkhidmatan yang diberikan olehnya atau mana-mana pegawai cukai jualan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_105__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_105",
      "schema:text": {
        "@language": "ms",
        "@value": "yang tidak dikehendaki untuk diberikan di bawah Akta ini; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_105__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_105",
      "schema:text": {
        "@language": "ms",
        "@value": "yang baginya tiada fi ditetapkan oleh mana-mana undang-undang bertulis. Kuasa membuat peraturan-peraturan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_106",
      "@type": "akn:clause",
      "eli:number": "106",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_106__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_106__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_106__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_106__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_106",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh membuat peraturan-peraturan yang perlu atau suai manfaat bagi maksud melaksanakan peruntukan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_106__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_106__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_106__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_106__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_106__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_106__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_106__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_106__subsec_2__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_106__subsec_2__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_106__subsec_2__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_106__subsec_2__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_106__subsec_2__para_k",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_106__subsec_2__para_l",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_106__subsec_2__para_m"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_106",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan keluasan subseksyen (1), Menteri boleh menetapkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_106__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_106__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "semua perkara yang berhubungan dengan pendaftaran pengilang;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_106__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_106__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "semua perkara yang berhubungan dengan tempoh bercukai;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_106__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_106__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "semua perkara yang berhubungan dengan penentuan nilai jualan barang bercukai;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_106__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_106__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "semua perkara yang berhubungan dengan pengemukaan penyata dan pembayaran cukai jualan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_106__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_106__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "semua perkara yang berhubungan dengan pembayaran balik, pulang balik dan peremitan cukai jualan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_106__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_106__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "semua perkara yang berhubungan dengan ketetapan awam dan ketetapan kastam;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_106__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_106__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "semua perkara yang berhubungan dengan perkhidmatan elektronik;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_106__subsec_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_106__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "semua perkara yang berhubungan dengan invois, nota kredit dan nota debit;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_106__subsec_2__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_106__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "semua perkara yang berhubungan dengan pejabat bagi pentadbiran cukai jualan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_106__subsec_2__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_106__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "semua fi yang dikehendaki untuk ditetapkan oleh Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_106__subsec_2__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_106__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "semua borang yang hendaklah ditetapkan bagi maksud Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_106__subsec_2__para_l",
      "@type": "akn:paragraph",
      "eli:number": "l",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_106__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "semua perkara yang berhubungan dengan petroleum; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_106__subsec_2__para_m",
      "@type": "akn:paragraph",
      "eli:number": "m",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_106__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa perkara lain yang dikehendaki untuk ditetapkan oleh Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_106__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_106",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana peraturan-peraturan yang dibuat di bawah subseksyen (1) boleh menetapkan suatu perbuatan atau peninggalan yang melanggar peraturan-peraturan itu sebagai suatu kesalahan dan boleh menetapkan hukuman denda yang tidak melebihi tiga puluh ribu ringgit atau pemenjaraan selama tempoh yang tidak melebihi dua tahun atau kedua-duanya bagi kesalahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86",
      "@type": "akn:clause",
      "eli:number": "86",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang, dengan niat untuk mengelak atau untuk membantu mana-mana orang lain mengelak cukai jualan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "meninggalkan daripada suatu penyata apa-apa maklumat berhubung dengan apa-apa perkara yang menjejaskan amaun cukai jualan yang boleh dikenakan olehnya atau orang lain;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat apa-apa pernyataan atau catatan palsu dalam mana-mana penyata, tuntutan atau permohonan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "memberikan apa-apa jawapan palsu, sama ada secara bertulis atau selainnya, bagi apa-apa soalan yang ditanya atau permintaan untuk mendapatkan maklumat yang dibuat di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menyediakan atau menyenggarakan, atau membenarkan penyediaan atau penyenggaraan, apa-apa buku akaun palsu, invois palsu atau rekod palsu yang lain, atau memalsukan atau membenarkan pemalsuan apa-apa buku akaun, invois atau rekod; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat, menggunakan atau membenarkan penggunaan apa-apa fraud, tipu daya atau helah, melakukan suatu kesalahan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melakukan suatu kesalahan di bawah subseksyen (1) boleh, apabila disabitkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi kesalahan pertama, didenda tidak kurang daripada sepuluh kali ganda dan tidak lebih daripada dua puluh kali ganda amaun cukai jualan atau dipenjarakan selama tempoh tidak melebihi lima tahun atau kedua-duanya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi kesalahan kedua atau kesalahan yang berikutnya, didenda tidak kurang daripada dua puluh kali ganda dan tidak lebih daripada empat puluh kali ganda amaun cukai jualan atau dipenjarakan selama tempoh tidak melebihi tujuh tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud subseksyen (2), jika amaun cukai jualan itu tidak boleh ditentukan, orang itu boleh didenda tidak kurang daripada lima puluh ribu ringgit dan tidak lebih daripada lima ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tujuh tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang membantu dalam, atau menasihati berkenaan dengan, penyediaan apa-apa penyata jika penyata itu mengakibatkan suatu kenyataan yang kurang benar terhadap tanggungan cukai jualan seorang yang lain, melainkan jika orang itu memuaskan hati mahkamah bahawa bantuan atau nasihat itu telah diberikan dengan penelitian yang munasabah, melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak kurang daripada dua ribu ringgit dan tidak lebih daripada dua puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tiga tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86__subsec_5__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86__subsec_5__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa sebutan di bawah perenggan (1)(e) berhubung dengan seseorang yang membuat, menggunakan atau membenarkan penggunaan apa-apa fraud, tipu daya atau helah termasuk sebutan mengenai seorang yang, tanpa kuasa pegawai cukai jualan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "memusnahkan, merosakkan, memadamkan, mengubah atau memanipulasi data yang disimpan dalam, atau yang digunakan berkaitan dengan, suatu komputer;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86__subsec_5__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86__subsec_5__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "memasukkan ke dalam, atau merekodkan atau menyimpan di dalam, suatu komputer melalui apa-apa cara data bagi maksud—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86__subsec_5__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86__subsec_5__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "memusnahkan, merosakkan, memadamkan, mengubah atau memanipulasi data lain yang disimpan dalam komputer itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86__subsec_5__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86__subsec_5__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "mengusik, mengganggu atau menghalang penggunaan secara sah komputer itu, atau data yang disimpan dalam komputer itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86__subsec_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "selainnya menggunakan komputer, yang maksud atau kesannya adalah untuk mengelak cukai jualan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud subseksyen (5), “data” termasuklah apa-apa program komputer atau bahagian daripada suatu program komputer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_86",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam mana-mana pendakwaan di bawah seksyen ini, apa-apa pengelakan cukai jualan hendaklah disifatkan berada dalam pengetahuan tertuduh melainkan jika dibuktikan sebaliknya oleh tertuduh. Memberi maklumat tidak betul yang berhubungan dengan tanggungan terhadap cukai jualan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_87",
      "@type": "akn:clause",
      "eli:number": "87",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan apa-apa tanggungan lain yang dilakukan di bawah Akta ini, mana-mana orang yang memberikan apa-apa maklumat yang tidak betul berhubung dengan apa-apa perkara yang memberi kesan ke atas tanggungannya sendiri terhadap cukai jualan atau tanggungan mana-mana orang lain terhadap cukai jualan melakukan suatu kesalahan dan boleh, apabila disabitkan, dipenjarakan selama tempoh tidak melebihi tiga tahun atau didenda tidak melebihi lima puluh ribu ringgit atau kedua-duanya. Mendapatkan pembayaran balik secara tidak wajar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_88",
      "@type": "akn:clause",
      "eli:number": "88",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_88__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_88__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang menyebabkan atau cuba untuk menyebabkan pembayaran balik oleh Ketua Pengarah di bawah seksyen 10, 36 atau 39 kepada dirinya atau kepada mana-mana orang lain apa-apa amaun yang melebihi amaun yang sepatutnya boleh dibayar balik kepadanya atau kepada orang lain itu melakukan suatu kesalahan dan boleh, apabila disabitkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_88__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_88",
      "schema:text": {
        "@language": "ms",
        "@value": "didenda tidak melebihi lima puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tiga tahun atau kedua-duanya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_88__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_88",
      "schema:text": {
        "@language": "ms",
        "@value": "dikenakan penalti dua kali ganda amaun yang dibayar balik yang melebihi amaun yang sepatutnya boleh dibayar balik. Pekerja boleh membuat urusan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_89",
      "@type": "akn:clause",
      "eli:number": "89",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_89__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_89__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_89__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_89",
      "schema:text": {
        "@language": "ms",
        "@value": "Pekerja bagi mana-mana orang boleh membuat urusan secara am dengan mana-mana pegawai cukai jualan yang hak bagi pihak orang itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_89__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_89",
      "schema:text": {
        "@language": "ms",
        "@value": "Pegawai cukai jualan yang hak boleh menolak untuk membuat urusan dengan pekerja itu melainkan jika orang yang disebut di bawah subseksyen (1) memperkenalkan pekerja itu kepada pegawai cukai jualan yang hak itu sebagai mempunyai kuasa untuk membuat urusan. Membuat urusan bagi pihak orang kena cukai"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_90",
      "@type": "akn:clause",
      "eli:number": "90",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_90__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_90__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_90__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_90__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_90",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada seksyen 89, tiada seorang pun boleh membuat apa-apa urusan berhubung dengan Akta ini bagi pihak mana-mana orang kena cukai, kecuali tentang perkara yang berkaitan dengan apa-apa pembayaran balik, peremitan, pengecualian, atau apa-apa perkara lain sebagaimana yang diluluskan oleh Ketua Pengarah, di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_90__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_90__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_90__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_90",
      "schema:text": {
        "@language": "ms",
        "@value": "Orang yang membuat urusan tentang mana-mana perkara yang dinyatakan dalam subseksyen (1) bagi pihak orang kena cukai hendaklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_90__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_90__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mengemukakan surat kuasa daripada orang kena cukai yang diwakilinya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_90__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_90__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "jika apa-apa borang yang ditetapkan dikehendaki supaya dikemukakan bagi maksud perkara yang sedang dibuat, mengemukakan borang itu yang telah ditandatangani oleh orang kena cukai itu, kecuali jika dibenarkan selainnya oleh pegawai kanan cukai jualan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_90__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_90",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1) melakukan suatu kesalahan. Kesalahan oleh orang yang diberi kuasa dan orang yang tidak diberi kuasa"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_91",
      "@type": "akn:clause",
      "eli:number": "91",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_91__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_91__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII",
      "schema:name": {
        "@language": "ms",
        "@value": "Mana-mana orang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_91__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_91__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_91__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_91__para_a__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_91__para_a__subpara_iv"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_91",
      "schema:text": {
        "@language": "ms",
        "@value": "yang merupakan pekerja bagi orang kena cukai atau orang yang diberi kuasa di bawah seksyen 90 yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_91__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_91__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "memegang bagi kegunaan dirinya sendiri atau selainnya apa-apa bahagian daripada amaun cukai jualan atau penalti yang dipungut di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_91__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_91__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "selain dengan suci hati, menuntut daripada mana-mana orang suatu amaun yang melebihi apa-apa taksiran cukai jualan yang genap masa dan kena dibayar, atau penalti yang kena dibayar, di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_91__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_91__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "mengemukakan apa-apa penyata, pernyataan atau laporan yang palsu, sama ada secara bertulis atau selainnya, bagi amaun cukai jualan atau penalti yang dipungut atau diterima olehnya di bawah Akta ini; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_91__para_a__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_91__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "memfraud mana-mana orang, menggelapkan apa-apa wang, atau selainnya menggunakan kedudukannya untuk berurusan secara salah sama ada dengan Ketua Pengarah atau mana-mana individu lain; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_91__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_91",
      "schema:text": {
        "@language": "ms",
        "@value": "yang tidak diberi kuasa di bawah Akta ini yang memungut atau cuba untuk memungut apa-apa cukai jualan atau penalti di bawah Akta ini, melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tiga tahun atau kedua-duanya. Halangan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_92",
      "@type": "akn:clause",
      "eli:number": "92",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang dengan apa-apa cara menghalang, mengamang atau menggalang mana-mana pegawai cukai jualan yang hak dalam menunaikan kewajipannya di bawah Akta ini melakukan suatu kesalahan dan boleh, apabila disabitkan, dipenjarakan selama tempoh tidak melebihi lima tahun atau didenda tidak melebihi satu ratus ribu ringgit atau kedua-duanya. Kesalahan oleh syarikat, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_93",
      "@type": "akn:clause",
      "eli:number": "93",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_93__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_93__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_93__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_93__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_93__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_93",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana syarikat, perkongsian liabiliti terhad, firma, pertubuhan atau kumpulan orang yang lain melakukan suatu kesalahan di bawah Akta ini, seseorang yang pada masa pelakuan kesalahan itu ialah seorang pengarah, pegawai pematuhan, pekongsi, pengurus, setiausaha atau pegawai lain yang seumpamanya bagi syarikat, perkongsian liabiliti terhad, firma, pertubuhan atau kumpulan orang yang lain itu atau yang berupa sebagai bertindak atas sifat itu atau yang dengan apa-apa cara atau sehingga apa-apa takat bertanggungjawab bagi pengurusan apa-apa hal ehwal syarikat, perkongsian liabiliti terhad, firma, pertubuhan atau kumpulan orang yang lain itu atau membantu dalam pengurusannya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_93__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_93__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "boleh dipertuduh secara berasingan atau bersesama dalam prosiding yang sama bersekali dengan syarikat, perkongsian liabiliti terhad, firma, pertubuhan atau kumpulan orang yang lain itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_93__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_93__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_93__subsec_1__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_93__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika syarikat, perkongsian liabiliti terhad, firma, pertubuhan atau kumpulan orang yang lain itu didapati bersalah atas kesalahan itu, hendaklah disifatkan bersalah atas kesalahan itu melainkan jika, dengan mengambil kira jenis fungsinya atas sifat itu dan segala hal keadaan, dia membuktikan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_93__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_93__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa kesalahan itu telah dilakukan tanpa pengetahuannya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_93__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_93__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa kesalahan itu telah dilakukan tanpa persetujuan atau pembiarannya dan bahawa dia telah mengambil segala langkah yang munasabah dan menjalankan segala usaha yang wajar untuk menghalang pelakuan kesalahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_93__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_93__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_93__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_93__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_93",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana orang boleh dikenakan di bawah Akta ini apa-apa hukuman, penalti atau pelucuthakan bagi apa-apa perbuatan, peninggalan, pengabaian atau keingkaran, dia boleh dikenakan hukuman, penalti atau pelucuthakan yang sama bagi tiap-tiap perbuatan, peninggalan, pengabaian atau keingkaran itu oleh pekerja atau ejen orang itu, atau pekerja ejen orang itu, jika perbuatan, peninggalan, pengabaian atau keingkaran itu telah dilakukan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_93__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_93__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "oleh pekerja orang itu dalam penjalanan pekerjaannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_93__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_93__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "oleh ejen orang itu apabila bertindak bagi pihak orang itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_93__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_93__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "oleh pekerja ejen orang itu semasa bertindak dalam penjalanan pekerjaannya dengan ejen orang itu atau selainnya bagi pihak ejen orang itu yang bertindak bagi pihak orang itu. Penalti am"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_94",
      "@type": "akn:clause",
      "eli:number": "94",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melakukan suatu kesalahan di bawah Akta ini yang baginya tiada penalti diperuntukkan dengan nyata boleh, apabila disabitkan, didenda tidak melebihi tiga puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi dua tahun atau kedua-duanya. Pengkompaunan kesalahan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_95",
      "@type": "akn:clause",
      "eli:number": "95",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_95__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_95__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_95__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_95__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_95__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_95__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_95__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_95__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_95__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_95",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, dengan kelulusan Pendakwa Raya, membuat peraturan-peraturan yang menetapkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_95__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_95__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa kesalahan di bawah Akta ini atau mana-mana peraturan-peraturan yang dibuat di bawah Akta ini sebagai suatu kesalahan yang boleh dikompaun;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_95__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_95__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "kriteria untuk mengkompuan kesalahan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_95__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_95__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "kaedah dan tatacara untuk mengkompaun kesalahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_95__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_95",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pegawai kanan cukai jualan boleh, dengan keizinan secara bertulis oleh Pendakwa Raya, pada bila-bila masa sebelum sesuatu pertuduhan dimulakan, mengkompaun mana-mana kesalahan yang ditetapkan sebagai suatu kesalahan yang boleh dikompaun dengan membuat suatu tawaran bertulis kepada orang yang disyaki dengan munasabah telah melakukan kesalahan itu untuk mengkompaun kesalahan itu apabila dibayar kepada Ketua Pengarah suatu jumlah wang yang tidak melebihi lima puluh peratus daripada amaun denda maksimum yang orang itu boleh dikenakan jika dia disabitkan atas kesalahan itu, dalam apa-apa masa sebagaimana yang dinyatakan dalam tawaran bertulis itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_95__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_95",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu tawaran di bawah subseksyen (2) boleh dibuat pada bila-bila masa selepas kesalahan itu dilakukan tetapi sebelum apa-apa pendakwaan baginya dimulakan, dan jika amaun yang dinyatakan dalam tawaran itu tidak dibayar dalam masa yang dinyatakan dalam tawaran itu, atau apa-apa tempoh lanjutan sebagaimana yang diberikan oleh Ketua Pengarah, pendakwaan bagi kesalahan itu boleh dimulakan pada bila-bila masa selepas itu terhadap orang yang kepadanya tawaran itu dibuat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_95__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_95",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu kesalahan telah dikompaun di bawah subseksyen (2), tiada pendakwaan boleh dimulakan berkenaan dengan kesalahan itu terhadap orang yang kepadanya tawaran untuk mengkompaun itu dibuat, dan apa-apa dokumen atau benda yang disita berkenaan dengan kesalahan itu boleh dilepaskan oleh Ketua Pengarah, tertakluk kepada apa-apa terma sebagaimana yang difikirkan patut oleh Ketua Pengarah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_95__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_95",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua jumlah wang yang diterima oleh Ketua Pengarah di bawah seksyen ini hendaklah dibayar ke dalam dan menjadi sebahagian daripada Kumpulan Wang Disatukan. Kajian semula dan rayuan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_96",
      "@type": "akn:clause",
      "eli:number": "96",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_96__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_96__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_96__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_96__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_96__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_96__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_96__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_96",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang terkilan dengan apa-apa keputusan Ketua Pengarah boleh memohon kepada Ketua Pengarah untuk kajian semula ke atas apa-apa keputusannya dalam masa tiga puluh hari dari tarikh orang itu diberitahu mengenai keputusan itu dengan syarat bahawa tiada rayuan telah dibuat ke atas keputusan yang sama kepada Tribunal Rayuan Kastam atau mahkamah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_96__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_96",
      "schema:text": {
        "@language": "ms",
        "@value": "Permohonan bagi kajian semula di bawah subseksyen (1) hendaklah dibuat dalam borang yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_96__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_96",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika permohonan bagi kajian semula telah dibuat di bawah subseksyen (1), Ketua Pengarah hendaklah membuat kajian semula dan memberitahu keputusan kajian semula itu kepada orang itu, jika dapat dilaksanakan, dalam masa enam puluh hari dari tarikh permohonan itu diterima."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_96__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_96",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada kajian semula boleh dibuat bagi apa-apa perkara yang berhubungan dengan kompaun."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_96__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_96",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang terkilan dengan apa-apa keputusan Ketua Pengarah di bawah subseksyen (3) atau mana-mana peruntukan lain Akta ini, kecuali apa-apa perkara yang berhubungan dengan kompaun, boleh merayu kepada Tribunal Rayuan Kastam secara bertulis dalam masa tiga puluh hari dari tarikh pemberitahuan keputusan itu kepada orang yang terkilan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_96__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_96",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana cukai jualan yang genap masa dan kena dibayar di bawah Akta ini hendaklah dibayar walaupun apa-apa kajian semula atau rayuan telah dibuat di bawah seksyen ini. Pelikuidasi syarikat hendaklah memberikan notis penggulungan, dan mengetepikan cukai jualan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_97",
      "@type": "akn:clause",
      "eli:number": "97",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_97__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_97__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_97__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_97__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_97__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_97__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_97__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_97__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_97",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu ketetapan diluluskan dan menjadi berkuat kuasa, atau suatu perintah dibuat, bagi penggulungan sesuatu syarikat yang merupakan pengilang berdaftar atau pengimport, pelikuidasi syarikat itu hendaklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_97__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_97__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "memberikan notis mengenai penggulungan syarikat itu kepada Ketua Pengarah dalam masa empat belas hari selepas ketetapan itu berkuat kuasa atau perintah itu dibuat;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_97__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_97__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "sebelum melupuskan apa-apa aset syarikat itu, mengetepikan apa-apa jumlah wang daripada aset itu sebagaimana yang didapati oleh Ketua Pengarah sebagai mencukupi untuk mengadakan peruntukan bagi apa-apa cukai jualan yang atau yang akan selepas itu menjadi genap masa dan kena dibayar berkenaan dengan syarikat itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_97__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_97__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "membayar cukai jualan yang disebut dalam perenggan (b)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_97__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_97",
      "schema:text": {
        "@language": "ms",
        "@value": "Pelikuidasi mana-mana syarikat yang disebut dalam subseksyen (1) yang tidak memberikan notis kepada Ketua Pengarah dalam masa yang dinyatakan dalam perenggan (1)(a) atau tidak mengadakan peruntukan bagi pembayaran cukai jualan sebagaimana yang dikehendaki di bawah perenggan (1)(c) hendaklah bertanggungan sendiri bagi apa-apa cukai jualan yang atau yang akan menjadi genap masa dan kena dibayar sebagaimana yang disebut terdahulu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_97__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_97",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pelikuidasi yang tidak mematuhi subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi sepuluh ribu ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_97__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_97",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika dua orang atau lebih dilantik sebagai pelikuidasi atau dikehendaki oleh undang-undang untuk menjalankan penggulungan syarikat yang disebut dalam subseksyen (1), kewajipan dan tanggungan yang dikenakan ke atas seorang pelikuidasi di bawah seksyen ini hendaklah dikenakan ke atas semua orang itu secara bersesama dan berasingan, tertakluk kepada suatu hak sumbangan antara mereka sebagaimana dalam hal kontrak. Pelantikan penerima hendaklah diberitahu kepada Ketua Pengarah"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_98",
      "@type": "akn:clause",
      "eli:number": "98",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_98__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_98__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_98__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_98__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_98__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_98",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seorang penerima bagi harta pengilang berdaftar atau pengimport dilantik, penerima itu hendaklah memberikan notis mengenai pelantikan itu kepada Ketua Pengarah dalam masa empat belas hari selepas itu, dan hendaklah sebelum melupuskan apa-apa aset pengilang berdaftar atau pengimport mengetepikan apa-apa jumlah wang daripada aset sebagaimana yang didapati oleh Ketua Pengarah sebagai mencukupi untuk mengadakan peruntukan bagi apa-apa cukai jualan yang atau yang akan selepas itu menjadi genap masa dan kena dibayar berkenaan dengan barang bercukai yang telah dijual atau dikilangkan oleh pengilang berdaftar atau pengimport itu sebelum pelantikan penerima itu, dan hendaklah membayar cukai jualan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_98__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_98",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana penerima yang dilantik di bawah subseksyen (1) yang tidak memberikan notis kepada Ketua Pengarah dalam masa yang dinyatakan dalam subseksyen (1) atau tidak mengadakan peruntukan bagi pembayaran cukai jualan sebagaimana yang dikehendaki di bawah subseksyen itu hendaklah bertanggungan sendiri bagi apa-apa cukai jualan yang atau yang akan menjadi genap masa dan kena dibayar sebagaimana yang disebut terdahulu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_98__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_98",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana penerima yang tidak mematuhi subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi sepuluh ribu ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_98__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_98",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika dua orang atau lebih dilantik sebagai penerima, kewajipan dan tanggungan yang dikenakan ke atas seorang penerima di bawah seksyen ini hendaklah dikenakan ke atas semua orang itu secara bersesama dan berasingan, tertakluk kepada suatu hak sumbangan antara mereka sebagaimana dalam hal kontrak. Pengilang berdaftar hendaklah mengemukakan perakuan audit"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII__cl_99",
      "@type": "akn:clause",
      "eli:number": "99",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XII",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah boleh menghendaki pengilang berdaftar untuk mengemukakan suatu perakuan audit setiap tahun yang ditandatangani oleh seorang akauntan awam yang bukan dalam penggajian pengilang berdaftar itu, berhubung dengan rekod yang dikehendaki untuk disimpan oleh pengilang berdaftar itu di bawah seksyen 24 berkenaan dengan pengeluaran dan penjualan barang bercukai pengilang berdaftar itu yang dikilangkan olehnya. Cukai jualan, dsb., hendaklah kena dibayar walau apa pun apa-apa prosiding, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_73",
      "@type": "akn:clause",
      "eli:number": "73",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun mana-mana undang-undang bertulis yang berlawanan, Mahkamah Sesyen hendaklah mempunyai bidang kuasa untuk membicarakan apa-apa kesalahan di bawah Akta ini dan mengenakan hukuman di bawah Akta ini bagi mana-mana kesalahan itu. Keterangan melalui perakuan, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_74",
      "@type": "akn:clause",
      "eli:number": "74",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_74__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_74__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_74__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_74__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_74__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_74__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_74__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_74__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_74",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa perakuan yang ditandatangani oleh Ketua Pengarah yang menyatakan bahawa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_74__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_74__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang pengilang adalah atau tidak, pada mana-mana tarikh, didaftarkan di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_74__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_74__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa penyata tidak dikemukakan atau telah tidak dikemukakan pada mana-mana tarikh;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_74__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_74__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa cukai jualan yang ditunjukkan sebagai genap masa dan kena dibayar dalam apa-apa penyata atau taksiran telah tidak dibayar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_74__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_74__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa penalti dan amaun penalti yang ditunjukkan sebagai terhutang daripada seseorang yang dinamakan dalam perakuan itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_74__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_74__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa ketetapan umum yang dibuat di bawah seksyen 42 atau ketetapan kastam yang dibuat di bawah seksyen 43, hendaklah menjadi keterangan prima facie mengenai fakta yang dinyatakan dalam perakuan itu tanpa dibuktikan tandatangan pada perakuan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_74__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_74__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_74__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_74__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_74",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam apa-apa prosiding berkenaan dengan apa-apa kesalahan di bawah Akta ini yang dalamnya kewujudan, perihalan, klasifikasi, komposisi, kuantiti, kualiti atau nilai, atau apa-apa perkara lain berhubung dengan, apa-apa barang yang dipulangkan, dijual atau dimusnahkan di bawah seksyen 71 menjadi persoalan, apa-apa dokumen yang dikemukakan oleh Pendakwa Raya yang berupa suatu perakuan berkenaan dengan apa-apa perkara yang diberikan dan ditandatangani oleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_74__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_74__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang juruanalisis mengikut pengertian subseksyen 75(4);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_74__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_74__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang pegawai kanan cukai jualan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_74__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_74__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang, tanpa mengambil kira sama ada atau tidak dia seorang pegawai awam, yang diberi kuasa oleh atau bagi pihak Menteri sama ada secara am atau dalam apa-apa hal tertentu, bagi maksud seksyen ini, hendaklah boleh diterima sebagai keterangan dan kemuktamadannya tidak boleh dicabar atas alasan bahawa barang yang berkenaan dengannya perakuan itu diberikan tidak dikemukakan di hadapan mahkamah sama ada sebahagiannya atau keseluruhannya, dan perakuan itu hendaklah menjadi keterangan bagi kandungannya, termasuk fakta yang dinyatakan dalam perakuan itu, tanpa dibuktikan tandatangan pada perakuan itu. Pengemukaan perakuan analisis"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_75",
      "@type": "akn:clause",
      "eli:number": "75",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_75__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_75__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_75__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_75__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_75__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_75__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_75__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_75",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam apa-apa pendakwaan di bawah Akta ini, suatu perakuan analisis yang berupa sebagai ditandatangani oleh seorang juruanalisis hendaklah, apabila perakuan itu dikemukakan oleh Pendakwa Raya, menjadi keterangan yang mencukupi mengenai fakta yang dinyatakan dalam perakuan itu melainkan jika tertuduh menghendaki supaya juruanalisis itu dipanggil sebagai saksi, yang dalam hal demikian dia hendaklah memberikan notis mengenai perkara itu kepada Pendakwa Raya tidak kurang daripada tiga hari genap sebelum perbicaraan bermula."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_75__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_75",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Pendakwa Raya berhasrat untuk memberikan sebagai keterangan apa-apa perakuan analisis, dia hendaklah menyerahkan suatu salinan perakuan itu kepada tertuduh tidak kurang daripada sepuluh hari genap sebelum perbicaraan bermula."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_75__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_75",
      "schema:text": {
        "@language": "ms",
        "@value": "Juruanalisis adalah terikat untuk menyatakan yang benar dalam perakuan analisis yang ditandatangani sendiri oleh mereka."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_75__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_75__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_75__subsec_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_75__subsec_4__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_75__subsec_4__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_75",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini, “juruanalisis” ertinya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_75__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_75__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang ahli kimia berdaftar di bawah Akta Ahli Kimia 1975 [Akta 158] atau seorang yang diberi kuasa di bawah seksyen 23a Akta itu, atau pekerjanya yang bekerja di bawah penyeliaannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_75__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_75__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang ahli farmasi berdaftar di bawah Akta Pendaftaran Ahli Farmasi 1951 [Akta 371] atau pekerjanya yang bekerja di bawah penyeliaannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_75__subsec_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_75__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang jurutera berdaftar di bawah Akta Pendaftaran Jurutera 1967 [Akta 138]; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_75__subsec_4__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_75__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang ahli geologi berdaftar di bawah Akta Geologi 2008 [Akta 689]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_75__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_75",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seorang juruanalisis dipanggil sebagai saksi oleh tertuduh di bawah subseksyen (1), juruanalisis itu hendaklah dipanggil atas perbelanjaan tertuduh itu melainkan jika mahkamah mengarahkan selainnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_75__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_75",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh melantik mana-mana orang yang layak atau golongan orang yang layak, melalui pemberitahuan dalam Warta, sebagai juruanalisis bagi maksud seksyen ini. Bukti mengenai pendaftaran atau pelesenan pengangkut di Malaysia atau Singapura"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_76",
      "@type": "akn:clause",
      "eli:number": "76",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika dalam mana-mana pendakwaan di bawah Akta ini adalah relevan untuk menentukan butir-butir mengenai pendaftaran atau pelesenan apa-apa pengangkut yang didaftarkan atau dilesenkan di mana-mana pelabuhan atau tempat di Malaysia atau Singapura, suatu perakuan yang berupa sebagai ditandatangani oleh pegawai yang bertanggungjawab di bawah mana-mana undang-undang bertulis di Malaysia atau di Singapura bagi pendaftaran atau pelesenan pengangkut itu hendaklah menjadi keterangan prima facie mengenai semua butir-butir berkenaan dengan pendaftaran atau pelesenan yang terkandung dalam perakuan itu, dan beban untuk membuktikan ketidaktepatan apa-apa butir yang dinyatakan dalam perakuan itu hendaklah terletak pada orang yang menafikannya. Cara penyitaan tidak boleh diperiksa dalam perbicaraan di hadapan mahkamah atau rayuan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_77",
      "@type": "akn:clause",
      "eli:number": "77",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam mana-mana perbicaraan di hadapan mana-mana mahkamah atau dalam apa-apa prosiding rayuan yang berhubungan dengan penyitaan barang yang tertakluk kepada pelucuthakan di bawah Akta ini, mahkamah hendaklah meneruskan perbicaraan atau mendengar rayuan atas merit kes sahaja, tanpa memeriksa cara atau bentuk apa-apa penyitaan dibuat, kecuali setakat yang cara dan bentuk penyitaan itu boleh menjadi keterangan atas merit itu. Obligasi kerahsiaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_78",
      "@type": "akn:clause",
      "eli:number": "78",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_78__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_78__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_78__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_78",
      "schema:text": {
        "@language": "ms",
        "@value": "Kecuali sebagaimana yang diperuntukkan di bawah seksyen 79, nama, nombor kad pengenalan, nombor pasport dan alamat pemberi maklumat, atau apa-apa maklumat lain yang boleh membawa kepada identiti pemberi maklumat itu, dan bahan maklumat yang diterima daripada pemberi maklumat hendaklah disimpan rahsia dan tidak boleh dizahirkan oleh mana-mana pegawai cukai jualan atau mana-mana orang yang dalam perjalanan biasa kewajipannya memiliki, atau mempunyai kawalan ke atas atau akses kepada, maklumat itu kepada mana-mana orang kecuali pegawai cukai jualan yang hak."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_78__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_78",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, dipenjarakan selama tempoh tidak melebihi tujuh tahun atau didenda tidak melebihi satu ratus ribu ringgit atau kedua-duanya. Perlindungan pemberi maklumat daripada diketahui"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_79",
      "@type": "akn:clause",
      "eli:number": "79",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_79__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_79__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_79__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_79__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_79",
      "schema:text": {
        "@language": "ms",
        "@value": "Kecuali sebagaimana yang diperuntukkan kemudiannya, tiada saksi dalam mana-mana prosiding sivil atau jenayah berkewajipan atau dibenarkan untuk menzahirkan nama, alamat atau apa-apa maklumat mengenai pemberi maklumat, atau bahan maklumat yang diterima daripada pemberi maklumat, atau menyatakan apa-apa perkara yang mungkin membawa kepada pemberi maklumat itu diketahui."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_79__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_79",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana dokumen yang dikemukakan sebagai keterangan atau yang boleh diperiksa dalam mana-mana prosiding sivil atau jenayah mengandungi apa-apa catatan yang dalamnya mana-mana pemberi maklumat dinamakan atau diperihalkan atau yang mungkin membawa kepada dirinya diketahui, mahkamah hendaklah menyebabkan semua petikan itu disembunyikan daripada pandangan atau dipadamkan setakat yang perlu bagi melindungi pemberi maklumat itu daripada diketahui."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_79__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_79",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika dalam perbicaraan bagi apa-apa kesalahan di bawah Akta ini mahkamah, selepas siasatan penuh ke atas kes itu, mempercayai bahawa pemberi maklumat membuat dengan sengaja dalam aduannya suatu pernyataan material yang diketahuinya sebagai palsu atau tidak dipercayainya sebagai benar, atau jika dalam apa-apa prosiding lain mahkamah berpendapat bahawa keadilan tidak boleh dilaksanakan sepenuhnya antara pihak-pihak dalam prosiding itu tanpa pemberi maklumat itu diketahui, adalah sah bagi mahkamah untuk menghendaki pengemukaan aduan asal, jika secara bertulis, dan membenarkan siasatan dan menghendaki penzahiran sepenuhnya berkenaan dengan pemberi maklumat itu. Barang yang boleh disita boleh dilucuthakkan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_80",
      "@type": "akn:clause",
      "eli:number": "80",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_80__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_80__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_80__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_80__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_80",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua barang yang boleh disita di bawah peruntukan Akta ini boleh dilucuthakkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_80__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_80",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini dan seksyen 71, 81, 82, 83 dan 85, perkataan “barang” hendaklah disifatkan sebagai termasuk bekas muatan dan pengangkut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_80__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_80",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua barang yang dilucut hak hendaklah diserahkan kepada pegawai cukai jualan yang hak dan hendaklah dilupuskan mengikut arahan Ketua Pengarah. Mahkamah hendaklah memerintahkan pelupusan barang yang disita"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_81",
      "@type": "akn:clause",
      "eli:number": "81",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_81__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_81__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_81__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_81__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_81__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_81",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu perintah bagi pelucuthakan atau bagi pelepasan apa-apa jua barang yang boleh dilucuthakkan di bawah Akta ini hendaklah dibuat oleh mahkamah yang di hadapannya pendakwaan berkenaan dengan pelucuthakan itu telah diadakan, dan suatu perintah bagi melucuthakkan barang itu hendaklah dibuat jika dibuktikan sehingga memuaskan hati mahkamah bahawa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_81__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_81__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu kesalahan di bawah Akta ini telah dilakukan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_81__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_81__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "barang itu merupakan hal perkara atau telah digunakan dalam pelakuan kesalahan itu walaupun tiada seorang pun telah disabitkan atas mana-mana kesalahan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_81__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_81",
      "schema:text": {
        "@language": "ms",
        "@value": "Amaun yang dijamin di bawah perenggan 71(1)(a) atau subseksyen 71(2) atau amaun yang diperoleh melalui jualan di bawah perenggan 71(1)(c) hendaklah dilucuthakkan oleh mahkamah jika dibuktikan dengan memuaskan hati mahkamah bahawa suatu kesalahan di bawah Akta ini telah dilakukan dan bahawa barang yang berkenaan dengannya amaun itu telah dijamin atau diperoleh melalui jualan, mengikut mana-mana yang berkenaan, ialah hal perkara atau telah digunakan dalam pelakuan kesalahan itu walaupun tiada seorang pun telah disabitkan atas kesalahan itu. Barang yang disita yang berkenaan dengannya tiada pendakwaan, atau hasil jualannya, terlucut hak jika tidak dituntut"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_82",
      "@type": "akn:clause",
      "eli:number": "82",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_82__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_82__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_82__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_82__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_82__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_82__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_82__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_82__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_82__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_82__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_82",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika tiada pendakwaan dibuat berhubung dengan apa-apa barang yang disita di bawah Akta ini, barang itu atau hasil jualan barang itu yang dipegang menurut perenggan 71(1)(c) hendaklah diambil dan disifatkan sebagai terlucut hak apabila habis tempoh tiga puluh hari dari tarikh notis penyitaan barang itu diberikan di bawah subseksyen 69(3) melainkan jika, sebelum habis tempoh itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_82__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_82__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu tuntutan ke atas barang itu atau hasil jualan barang itu dibuat di bawah subseksyen (2);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_82__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_82__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu permohonan bertulis dibuat bagi pemulangan barang itu di bawah perenggan 71(1)(a) atau (b); atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_82__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_82__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "barang itu dipulangkan di bawah perenggan 71(1)(a) atau (b)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_82__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_82",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang menegaskan bahawa dia ialah pemunya barang itu atau hasil jualan barang itu, mengikut mana-mana yang berkenaan, dan bahawa barang atau hasil jualan barang itu tidak boleh dilucuthakkan boleh, secara ke diri atau melalui ejennya yang diberi kuasa secara bertulis, memberikan notis bertulis kepada mana-mana pegawai kanan cukai jualan bahawa dia menuntut barang atau hasil jualan barang itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_82__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_82",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika terdapat suatu tuntutan atau permohonan bertulis yang dibuat dalam tempoh tiga puluh hari yang disebut dalam subseksyen (1) dan tiada pendakwaan berkenaan dengan barang itu, pegawai kanan cukai jualan hendaklah, apabila habis tempoh tiga puluh hari itu, merujukkan tuntutan atau permohonan itu kepada Ketua Pengarah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_82__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_82__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_82__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_82",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila dirujuk oleh pegawai kanan cukai jualan di bawah subseksyen (3), Ketua Pengarah boleh mengarahkan pegawai kanan cukai jualan itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_82__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_82__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk melepaskan barang itu atau hasil jualan barang itu atau jaminan yang dikemukakan di bawah perenggan 71(1)(a) atau subseksyen 71(2); atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_82__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_82__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "melalui maklumat dalam borang yang ditetapkan, untuk merujukkan perkara itu kepada Hakim Mahkamah Sesyen bagi suatu keputusan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_82__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_82__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_82__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_82",
      "schema:text": {
        "@language": "ms",
        "@value": "Mahkamah Sesyen hendaklah mengeluarkan suatu saman yang menghendaki orang yang menegaskan bahawa dia ialah pemunya barang itu atau hasil jualan barang itu, dan orang yang daripadanya barang itu disita, supaya hadir di hadapannya, dan apabila mereka hadir atau ingkar untuk hadir, selepas penyampaian sewajarnya saman itu dibuktikan, Mahkamah Sesyen hendaklah meneruskan pemeriksaan mengenai perkara itu, dan apabila ada bukti bahawa suatu kesalahan terhadap Akta ini telah dilakukan dan bahawa barang itu merupakan hal perkara, atau telah digunakan dalam pelakuan kesalahan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_82__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_82__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah memerintahkan barang itu atau hasil jualan barang itu atau amaun yang dijamin di bawah perenggan 71(1)(a) atau subseksyen 71(2) dilucuthakkan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_82__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_82__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "jika tiada bukti sedemikian, boleh memerintahkan pelepasan barang itu atau hasil jualan barang itu atau jaminan yang dikemukakan di bawah perenggan 71(1)(a) atau subseksyen 71(2)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_82__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_82",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam mana-mana prosiding di bawah subseksyen (6), seksyen 83 hendaklah terpakai bagi orang yang menegaskan bahawa dia ialah pemunya barang itu atau hasil jualan barang itu dan bagi orang yang daripadanya barang itu disita seolah-olah pemunya atau orang itu merupakan tertuduh dalam suatu pendakwaan di bawah Akta ini. Beban pembuktian"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_83",
      "@type": "akn:clause",
      "eli:number": "83",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_83__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_83__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_83__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_83__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI",
      "schema:name": {
        "@language": "ms",
        "@value": "Jika apa-apa pertikaian timbul dalam mana-mana pendakwaan sama ada—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_83__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_83",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa cukai jualan telah dibayar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_83__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_83",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa barang yang disita telah secara sah diimport atau dieksport;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_83__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_83",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa barang bukan merupakan barang bercukai; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_83__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_83",
      "schema:text": {
        "@language": "ms",
        "@value": "tertuduh berhak kepada suatu pengecualian cukai jualan, beban pembuktian bagi pertikaian itu hendaklah terletak pada tertuduh dalam pendakwaan. Perintah mahkamah"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_84",
      "@type": "akn:clause",
      "eli:number": "84",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_84__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_84__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_84__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_84__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_84",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana orang didapati bersalah atas suatu kesalahan di bawah Akta ini, mahkamah yang di hadapannya orang itu didapati bersalah hendaklah memerintahkan orang itu supaya membayar kepada Ketua Pengarah amaun cukai jualan yang genap masa dan kena dibayar, atau penalti yang kena dibayar, di bawah Akta ini, jika ada, sebagaimana yang diperakukan oleh Ketua Pengarah dan cukai jualan atau penalti itu hendaklah didapatkan semula mengikut cara yang sama seperti suatu denda sebagaimana yang diperuntukkan di bawah seksyen 283 Kanun Tatacara Jenayah [Akta 593]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_84__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_84",
      "schema:text": {
        "@language": "ms",
        "@value": "Sebagai tambahan kepada subseksyen (1), mahkamah mempunyai bidang kuasa sivil setakat amaun cukai jualan yang genap masa dan kena dibayar itu, atau penalti yang kena dibayar itu dan perintah itu boleh dikuatkuasakan dalam segala hal sebagai suatu penghakiman muktamad mahkamah yang memihak kepada Ketua Pengarah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_84__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_84",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana orang didapati tidak bersalah atas suatu kesalahan di bawah Akta ini, dan jika dia telah membayar amaun cukai jualan yang genap masa dan kena dibayar, atau penalti yang kena dibayar, di bawah Akta ini menurut seksyen 100 berkenaan dengan kesalahan yang dipertuduh, mahkamah boleh memerintahkan supaya amaun yang telah dibayar itu dibayar balik kepada orang itu jika tiada notis rayuan difailkan. Tiada kos atau ganti rugi yang berbangkit daripada penyitaan boleh didapatkan balik melainkan jika penyitaan dibuat tanpa sebab yang munasabah atau sebab yang barangkali"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI__cl_85",
      "@type": "akn:clause",
      "eli:number": "85",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_XI",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun, dalam apa-apa prosiding di hadapan mana-mana mahkamah berkenaan dengan penyitaan apa-apa barang, dokumen, artikel atau benda dalam menjalankan atau berupa sebagai menjalankan apa-apa kuasa yang diberikan di bawah Akta ini, berhak untuk mendapatkan kos prosiding itu atau apa-apa ganti rugi atau relief lain, selain suatu perintah bagi pemulangan barang, dokumen, artikel atau benda itu atau pembayaran nilai barang, dokumen, artikel atau benda itu, melainkan jika penyitaan itu telah dibuat tanpa sebab yang munasabah atau sebab yang barangkali."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_62",
      "@type": "akn:clause",
      "eli:number": "62",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_62__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_62__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_62__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_62__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_62__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_62",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap orang yang mempunyai maklumat mengenai apa-apa perkara yang menjadi kewajipan pegawai cukai jualan yang hak untuk menyiasat hendaklah, apabila dikehendaki oleh pegawai itu untuk berbuat demikian, memberikan maklumat itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_62__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_62__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_62__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_62",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap orang yang dikehendaki oleh pegawai cukai jualan yang hak untuk mengemukakan apa-apa barang, dokumen, artikel atau benda lain yang dalam kuasa orang itu untuk mengemukakannya, dan yang merupakan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_62__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_62__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "barang, dokumen, artikel atau benda yang digunakan dalam mana-mana transaksi atau perkara lain yang berhubungan dengan cukai jualan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_62__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_62__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "barang, dokumen, artikel atau benda yang menjadi kewajipan pegawai cukai jualan yang hak untuk menyiasatnya di bawah Akta ini, hendaklah mengemukakan barang, dokumen, artikel atau benda itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_62__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_62",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika apa-apa maklumat, barang, dokumen, artikel atau benda bukan dalam bahasa kebangsaan atau bahasa Inggeris, mana- mana pegawai cukai jualan yang hak boleh melalui notis secara bertulis menghendaki pembekal atau, atas kegagalan pembekal berbuat demikian, mana-mana orang lain, untuk mengemukakan dalam tempoh yang munasabah suatu terjemahan bagi maklumat, barang, dokumen, artikel atau benda itu dalam bahasa kebangsaan atau bahasa Inggeris sebagaimana yang ditentukan oleh pegawai cukai jualan yang hak itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_62__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_62__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_62__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_62",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_62__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_62__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "yang melanggar subseksyen (1) atau (2); atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_62__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_62__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "yang tidak mengemukakan suatu terjemahan yang dikehendaki di bawah subseksyen (3), melakukan suatu kesalahan. Kuasa untuk mengambil sampel"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_63",
      "@type": "akn:clause",
      "eli:number": "63",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_63__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_63__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_63__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_63__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_63__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_63__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_63",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pegawai kanan cukai jualan boleh pada bila-bila masa, jika kewajipannya menghendaki sedemikian, mengambil sampel apa-apa barang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_63__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_63__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menentukan sama ada sampel itu ialah barang daripada perihalan yang boleh dikenakan cukai jualan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_63__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_63__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menentukan cukai jualan yang kena dibayar ke atas barang itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_63__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_63__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi apa-apa maksud lain sebagaimana yang difikirkannya perlu, dan sampel itu boleh dilupuskan mengikut apa-apa cara yang diarahkannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_63__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_63",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada apa-apa pembayaran boleh dibuat bagi apa-apa sampel yang diambil di bawah subseksyen (1), tetapi pegawai cukai jualan yang hak hendaklah memberikan suatu resit untuk sampel itu. Akses kepada tempat atau premis"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_64",
      "@type": "akn:clause",
      "eli:number": "64",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_64__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_64__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_64__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_64__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_64__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_64__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_64__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_64",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud Akta ini, mana-mana pegawai kanan cukai jualan hendaklah pada setiap masa mempunyai akses kepada mana-mana tempat atau premis di mana pengilang atau pengimport menjalankan perniagaannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_64__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_64",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana pegawai kanan cukai jualan menjalankan kuasanya di bawah subseksyen (1), orang yang menjalankan perniagaannya atau mana-mana orang lain yang berada di tempat atau di premis pada masa ia dimasuki hendaklah memberikan kepada pegawai itu segala kemudahan dan bantuan yang munasabah untuk menjalankan kewajipannya di bawah seksyen ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_64__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_64__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_64__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_64__subsec_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_64__subsec_3__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_64__subsec_3__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_64__subsec_3__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_64__subsec_3__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_64",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana pegawai kanan cukai jualan memasuki mana-mana tempat atau premis mengikut seksyen ini, dia boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_64__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_64__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "menghendaki pengilang atau pengimport itu, mengikut mana-mana yang berkenaan, mengemukakan apa-apa barang, dokumen, artikel atau benda, yang pengilang atau pengimport itu dikehendaki untuk menyimpannya di bawah peruntukan Akta ini, atau yang berhubungan dengan mana-mana barang bercukai;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_64__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_64__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "memeriksa apa-apa barang, dokumen, artikel atau benda dan mengambil salinan apa-apa dokumen;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_64__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_64__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "menyita dan menahan apa-apa barang, dokumen, artikel atau benda yang, pada pendapatnya, ia boleh memberikan keterangan mengenai pelakuan apa-apa kesalahan di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_64__subsec_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_64__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "menghendaki mana-mana pengilang atau pengimport, atau mana-mana orang yang diambil kerja oleh pengilang atau pengimport itu, untuk menjawab soalan yang berhubungan dengan apa-apa barang, dokumen, artikel atau benda, atau apa-apa catatan dalam mana-mana dokumen, atau mana-mana barang bercukai;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_64__subsec_3__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_64__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "menghendaki apa-apa bekas, sampul atau bekas muatan lain, di tempat atau di premis itu dibuka;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_64__subsec_3__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_64__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "atas risiko dan perbelanjaan pengilang atau pengimport itu, membuka dan memeriksa apa-apa bungkusan, atau apa-apa barang atau bahan, di tempat atau di premis itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_64__subsec_3__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_64__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "mengambil sampel apa-apa barang mengikut seksyen 63."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_64__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_64",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika pegawai kanan cukai jualan yang bertindak di bawah seksyen ini tidak mendapat akses kepada mana-mana tempat atau premis di mana seseorang pengilang atau pengimport menjalankan perniagaannya, atau kepada mana-mana bekas muatan yang terdapat di dalam tempat atau premis itu, dia boleh, pada bila-bila masa, memasuki tempat atau premis itu, dan membuka bekas muatan itu mengikut apa-apa cara, jika perlu dengan kekerasan, sebagaimana yang difikirkan perlu olehnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_64__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_64",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika, apabila memasuki mana-mana tempat atau premis di bawah peruntukan seksyen ini, apa-apa barang bercukai dijumpai yang berhubungan dengannya apa-apa kesalahan di bawah peruntukan Akta ini telah dilakukan, barang bercukai itu boleh dilucuthakkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_64__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_64",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (2) melakukan suatu kesalahan. Akses kepada maklumat berekod atau data berkomputer"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_65",
      "@type": "akn:clause",
      "eli:number": "65",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_65__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_65__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_65__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_65__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_65",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pegawai kanan cukai jualan yang menjalankan kuasanya di bawah seksyen 64, 66, 67 dan 68 hendaklah diberi akses kepada apa-apa maklumat berekod atau data berkomputer, sama ada disimpan dalam komputer atau selainnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_65__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_65__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_65__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_65",
      "schema:text": {
        "@language": "ms",
        "@value": "Sebagai tambahan, seseorang pegawai kanan cukai jualan yang menjalankan kuasanya di bawah seksyen 64, 66, 67 dan 68—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_65__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_65__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "boleh memeriksa pengendalian mana-mana komputer dan apa-apa perkakas atau bahan yang berkaitan yang dia mempunyai sebab yang munasabah untuk mengesyaki digunakan atau telah digunakan berkaitan dengan maklumat atau data itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_65__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_65__subsec_2__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_65__subsec_2__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_65__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "boleh menghendaki—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_65__subsec_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_65__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "orang yang olehnya atau bagi pihaknya pegawai kanan cukai jualan mempunyai sebab yang munasabah untuk mengesyaki komputer itu digunakan atau telah digunakan berkaitan dengan maklumat atau data itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_65__subsec_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_65__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "orang yang menjaga, atau selainnya terlibat dalam, pengendalian komputer, perkakas atau bahan itu berkaitan dengan maklumat atau data itu, untuk memberi pegawai itu apa-apa bantuan yang munasabah sebagaimana yang dikehendaki olehnya bagi maksud seksyen ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_65__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_65",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud subseksyen (1), “akses” termasuklah diberi kata laluan, kod penyulitan, kod penyahsulitan, perisian atau perkakasan yang perlu dan apa-apa cara lain yang dikehendaki untuk membolehkan maklumat berekod atau data berkomputer itu difahami. Majistret boleh mengeluarkan waran geledah"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_66",
      "@type": "akn:clause",
      "eli:number": "66",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_66__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_66__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_66__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_66__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_66__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_66",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila mana-mana Majistret mendapati, berdasarkan maklumat bertulis dengan bersumpah dan selepas apa-apa siasatan yang difikirkan perlu olehnya, bahawa terdapat sebab yang munasabah untuk mempercayai bahawa di dalam mana-mana tempat, premis atau pengangkut, ada disembunyikan atau disimpan apa-apa barang, dokumen, artikel atau benda yang boleh memberikan keterangan mengenai pelakuan suatu kesalahan di bawah Akta ini, Majistret itu boleh mengeluarkan suatu waran yang memberi kuasa kepada mana-mana pegawai kanan cukai jualan yang dinamakan dalamnya, pada bila-bila masa dan dengan atau tanpa bantuan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_66__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_66__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memasuki tempat, premis atau pengangkut itu dan untuk menggeledah dan menyita barang, dokumen, artikel atau benda; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_66__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_66__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menangkap mana-mana orang yang berada di dalam tempat, premis atau pengangkut itu yang dalam milikannya barang, dokumen, artikel atau benda itu dijumpai atau yang disyaki dengan munasabah sebagai telah menyembunyikan atau menyimpan barang, dokumen, artikel atau benda itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_66__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_66__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_66__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_66__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_66",
      "schema:text": {
        "@language": "ms",
        "@value": "Pegawai kanan cukai jualan yang diberi kuasa di bawah subseksyen (1) boleh, jika perlu untuk berbuat demikian—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_66__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_66__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "memecah buka mana-mana pintu luar atau pintu dalam tempat, premis atau pengangkut itu dan memasuki tiap-tiap bahagiannya, jika perlu dengan kekerasan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_66__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_66__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mengalihkan dengan kekerasan apa-apa halangan kepada kemasukan untuk menggeledah atau menyita sebagaimana yang dia diberi kuasa untuk melakukannya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_66__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_66__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menahan tiap-tiap orang yang dijumpai di dalam tempat, premis atau pengangkut itu sehingga penggeledahan itu selesai. Penggeledahan boleh dilakukan tanpa waran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_67",
      "@type": "akn:clause",
      "eli:number": "67",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila pegawai kanan cukai jualan mendapati bahawa terdapat sebab yang munasabah untuk mempercayai bahawa di dalam mana-mana tempat, premis atau pengangkut ada disembunyikan atau disimpan apa-apa barang, dokumen, artikel atau benda yang boleh memberikan keterangan mengenai pelakuan apa-apa kesalahan di bawah Akta ini dan jika dia mempunyai alasan yang munasabah untuk mempercayai bahawa oleh sebab kelewatan dalam memperoleh suatu waran geledah barang, dokumen, artikel atau benda itu mungkin akan dipindahkan, dia boleh menjalankan di dalam, ke atas dan berkenaan dengan tempat, premis atau pengangkut itu, semua kuasa di bawah seksyen 66 mengikut cara yang sama seolah-olah dia telah diberi kuasa untuk berbuat sedemikian oleh suatu waran yang dikeluarkan di bawah seksyen itu. Kuasa untuk memberhentikan dan memeriksa pengangkut"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_68",
      "@type": "akn:clause",
      "eli:number": "68",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_68__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_68__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_68__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_68__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_68",
      "schema:text": {
        "@language": "ms",
        "@value": "Pegawai cukai jualan yang hak boleh memberhentikan dan memeriksa mana-mana pengangkut bagi maksud menentukan sama ada apa-apa barang yang berkenaan dengannya dia mempunyai sebab untuk mempercayai bahawa suatu kesalahan di bawah Akta ini telah dilakukan terdapat di dalam pengangkut itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_68__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_68__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_68__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_68__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_68",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika dikehendaki oleh pegawai cukai jualan yang hak itu untuk berbuat demikian, orang yang mengawal atau menjaga pengangkut itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_68__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_68__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah memberhentikan pengangkut itu dan membenarkan pegawai cukai jualan yang hak itu untuk memeriksanya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_68__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_68__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah memindahkan pengangkut itu ke tempat lain untuk pemeriksaan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_68__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_68__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak boleh meneruskan perjalanan sehingga kebenaran untuk berbuat demikian diberikan oleh pegawai cukai jualan yang hak itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_68__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_68",
      "schema:text": {
        "@language": "ms",
        "@value": "Orang yang mengawal atau menjaga pengangkut yang diperiksa di bawah seksyen ini hendaklah, atas permintaan pegawai cukai jualan yang hak, membuka semua bahagian pengangkut itu untuk diperiksa oleh pegawai cukai jualan yang hak itu dan mengambil segala langkah yang perlu untuk membolehkan pemeriksaan sebagaimana yang difikirkan perlu oleh pegawai cukai jualan yang hak itu untuk dibuat. Penyitaan barang, dsb., yang menjadi perkara kesalahan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_69",
      "@type": "akn:clause",
      "eli:number": "69",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_69__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_69__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_69__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_69__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_69__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_69__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_69__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_69__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_69",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pegawai cukai jualan yang hak boleh menyita di mana-mana tempat sama ada di atas tanah atau di perairan wilayah mana-mana yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_69__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_69__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "semua barang, dokumen, artikel atau benda yang berkenaan dengannya pegawai cukai jualan yang hak itu mempunyai sebab yang munasabah untuk mengesyaki bahawa telah berlaku apa-apa kesalahan di bawah Akta ini, apa-apa pelanggaran mana-mana peruntukan Akta ini, atau apa-apa kemungkiran mana-mana syarat yang tertakluk kepadanya suatu pendaftaran telah diluluskan di bawah seksyen 13 dan 14;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_69__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_69__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa bekas muatan, bungkusan atau pengangkut yang dalamnya barang, dokumen, artikel atau benda itu mungkin telah dijumpai atau yang telah digunakan berkaitan dengan kesalahan, pelanggaran atau kemungkiran yang disebut dalam perenggan (a); dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_69__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_69__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa barang, dokumen, artikel atau benda lain yang semunasabahnya dipercayai mempunyai kaitan dengan kesalahan, pelanggaran atau kemungkiran yang disebut dalam perenggan (a)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_69__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_69__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_69__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_69",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud perenggan (1)(b)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_69__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_69__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "jika pengangkut itu ialah suatu kapal, kapal itu tidak boleh melebihi dua ratus tan bersih daripada tanan berdaftarnya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_69__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_69__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "jika pengangkut itu ialah pesawat udara, pesawat udara itu ialah selain pesawat udara yang terlibat dalam pengangkutan antarabangsa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_69__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_69",
      "schema:text": {
        "@language": "ms",
        "@value": "Bilamana apa-apa barang, dokumen, artikel, benda, bekas muatan, bungkusan atau pengangkut disita di bawah Akta ini, pegawai cukai jualan yang hak hendaklah dengan serta-merta memberikan notis secara bertulis tentang penyitaan itu dan alasan penyitaan itu kepada pemunya barang, dokumen, artikel, benda, bekas muatan, bungkusan atau pengangkut itu, jika diketahui, sama ada dengan menyampaikan notis itu kepadanya secara ke diri atau melalui pos ke tempat kediamannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_69__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_69__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_69__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_69",
      "schema:text": {
        "@language": "ms",
        "@value": "Peruntukan seksyen ini yang berhubungan dengan penyitaan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_69__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_69__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa barang, dokumen, artikel atau benda hendaklah terpakai bagi semua kandungan apa-apa bekas muatan, bungkusan atau pengangkut yang di dalamnya barang, dokumen, artikel, atau benda itu dijumpai, dan apa-apa artikel yang digunakan untuk menyembunyikan barang, dokumen, artikel atau benda itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_69__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_69__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa pengangkut hendaklah terpakai bagi takal, kelengkapan dan peralatan pengangkut itu dan jika pengangkut itu ialah kenderaan haiwan, bagi mana-mana haiwan yang dengannya pengangkut itu ditarik. Pemeriksaan atau ujian berkadar barang yang disita"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_70",
      "@type": "akn:clause",
      "eli:number": "70",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_70__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_70__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_70__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_70__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_70",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila apa-apa barang yang disyaki merupakan barang bercukai atau selainnya barang yang boleh disita telah disita, memadai untuk dibuka dan diperiksa lima peratus sahaja bagi setiap perihalan bungkusan atau bekas muatan yang di dalamnya barang-barang itu terkandung."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_70__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_70",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika apa-apa barang yang disita di bawah Akta ini perlu diuji, memadai untuk menguji hanya suatu sampel yang tidak melebihi lima peratus daripada isi padu atau berat barang yang diperiksa di bawah subseksyen (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_70__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_70",
      "schema:text": {
        "@language": "ms",
        "@value": "Mahkamah hendaklah menganggap bahawa barang yang terkandung di dalam bungkusan atau bekas muatan yang tidak dibuka itu adalah sama jenis, kuantiti dan kualitinya dengan barang yang dijumpai di dalam bungkusan atau bekas muatan yang seumpamanya yang telah dibuka. Pemulangan atau pelupusan barang, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_71",
      "@type": "akn:clause",
      "eli:number": "71",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_71__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_71__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_71__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_71__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_71__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_71__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_71__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_71__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_71__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_71__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_71__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_71",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud penyiasatan, jika mana-mana barang telah disita di bawah Bahagian ini, seorang pegawai kanan cukai jualan boleh, mengikut budi bicaranya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_71__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_71__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "memulangkan barang itu secara sementara kepada pemunyanya atau kepada orang yang daripadanya milikan, jagaan atau kawalan barang itu disita, atau kepada mana-mana orang sebagaimana yang dipertimbangkan oleh pegawai kanan cukai jualan itu sebagai berhak kepada barang itu, tertakluk kepada apa-apa terma dan syarat sebagaimana yang dikenakan oleh pegawai kanan cukai jualan itu dan jaminan yang mencukupi dikemukakan sehingga memuaskan hati pegawai kanan cukai jualan itu bahawa barang itu hendaklah diserahkan balik kepada pegawai kanan cukai jualan itu atas permintaan yang dibuat oleh pegawai kanan cukai jualan itu dan bahawa terma dan syarat itu, jika ada, hendaklah dipatuhi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_71__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_71__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "memulangkan barang itu kepada pemunyanya atau kepada orang yang daripadanya milikan, jagaan atau kawalan barang itu disita, atau kepada mana-mana orang sebagaimana yang dipertimbangkan oleh pegawai kanan cukai jualan itu sebagai berhak kepada barang itu, dengan kebebasan bagi orang yang kepadanya barang itu dipulangkan sedemikian untuk melupuskan barang itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_71__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_71__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menjual atau memusnahkan barang itu, sebagaimana yang wajar dalam hal keadaan itu, jika barang itu ialah makhluk hidup atau jika, pada pendapat pegawai kanan cukai jualan itu, barang itu bersifat mudah rosak atau berbahaya atau mungkin merosot dengan cepat dari segi kualiti atau nilai, dan jika barang itu dijual, pegawai kanan cukai jualan itu hendaklah memegang hasil jualan untuk mematuhi keputusan apa-apa pendakwaan atau tuntutan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_71__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_71__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_71__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_71",
      "schema:text": {
        "@language": "ms",
        "@value": "Pemulangan barang di bawah perenggan (1)(b) hendaklah tertakluk kepada jaminan yang dikemukakan sehingga memuaskan hati pegawai kanan cukai jualan dalam suatu amaun yang tidak kurang daripada amaun yang, pada pendapat pegawai kanan cukai jualan itu, mewakili—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_71__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_71__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "nilai jualan barang itu, pada tarikh barang itu dipulangkan sedemikian; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_71__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_71__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "cukai jualan yang genap masa dan kena dibayar berkenaan dengan barang itu, jika ada, bagi pembayaran amaun yang dijamin kepada Ketua Pengarah sekiranya mahkamah membuat suatu perintah bagi pelucuthakan di bawah seksyen 81."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_71__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_71",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila mana-mana barang dipulangkan atau dilupuskan di bawah subseksyen (1), suatu dokumen yang berupa suatu perakuan mengikut subseksyen 74(2) hendaklah dikeluarkan oleh pegawai kanan cukai jualan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_71__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_71__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_71__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_71",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_71__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_71__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak menyerahkan balik apabila diminta kepada pegawai kanan cukai jualan barang yang dipulangkan secara sementara kepadanya di bawah perenggan (1)(a); atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_71__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_71__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak mematuhi atau melanggar mana-mana terma atau syarat yang dikenakan di bawah perenggan (1)(a), melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi sepuluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi satu tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_71__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_71",
      "schema:text": {
        "@language": "ms",
        "@value": "Liabiliti jenayah mana-mana orang di bawah subseksyen (4) adalah sebagai tambahan kepada apa-apa liabiliti lain yang orang itu atau mana-mana orang lain boleh dikenakan di bawah terma dan syarat yang berhubungan dengan pemulangan barang di bawah perenggan (1)(a)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_71__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_71",
      "schema:text": {
        "@language": "ms",
        "@value": "Peruntukan subseksyen (4) tidak terpakai bagi seseorang yang menjadi penggerenti atau penjamin orang yang kepadanya barang dipulangkan di bawah perenggan (1)(a)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_71__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_71",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, sama ada secara am atau dalam mana-mana kes atau kelas kes tertentu, memberi apa-apa arahan kepada Ketua Pengarah sebagaimana yang difikirkan perlu olehnya atau suai manfaat berkenaan dengan penjalanan kuasa yang diberikan kepada pegawai kanan cukai jualan di bawah subseksyen (1). Kuasa menangkap"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72",
      "@type": "akn:clause",
      "eli:number": "72",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pegawai cukai jualan yang hak boleh menangkap tanpa waran—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang yang didapati melakukan atau cuba untuk melakukan, atau mengambil kerja atau menolong mana-mana orang untuk melakukan, atau bersubahat dalam pelakuan, suatu kesalahan di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang yang disyakinya dengan munasabah ada dalam milikannya apa-apa barang, dokumen, artikel atau benda yang boleh disita di bawah Akta ini; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang yang disyakinya dengan munasabah telah melakukan suatu kesalahan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72",
      "schema:text": {
        "@language": "ms",
        "@value": "Pegawai cukai jualan yang hak boleh memeriksa atau menyebabkan supaya diperiksa mana-mana orang yang ditangkap di bawah subseksyen (1) dengan syarat bahawa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang yang meminta supaya dirinya diperiksa dengan kehadiran seorang pegawai kanan cukai jualan tidak boleh diperiksa kecuali dengan kehadiran dan di bawah penyeliaan pegawai kanan cukai jualan itu, tetapi orang itu boleh ditahan sehingga ketibaan pegawai kanan cukai jualan itu, atau dibawa ke mana-mana pejabat atau balai polis di mana pegawai kanan cukai jualan itu boleh ditemui;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "barang dan bagasi orang yang meminta dirinya hadir semasa barang dan bagasi itu diperiksa dan dia menghadirkan dirinya dalam masa yang munasabah tidak boleh diperiksa kecuali dengan kehadirannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "tiada seorang pun boleh diperiksa kecuali oleh seorang yang lain yang sama jantina, dan pemeriksaan itu hendaklah dijalankan dengan memberikan perhatian teliti kepada kesopanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pegawai cukai jualan yang membuat tangkapan di bawah subseksyen (1) hendaklah, tanpa kelengahan yang tidak perlu, membawa orang yang ditangkap itu ke balai polis yang paling hampir, dan selepas itu orang itu hendaklah diperlakukan mengikut undang-undang yang berhubungan dengan tatacara jenayah yang sedang berkuat kuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana orang yang boleh ditangkap di bawah Akta ini tidak ditangkap pada masa pelakuan kesalahan itu yang baginya dia boleh ditangkap sedemikian, atau selepas ditangkap dia melepaskan dirinya, dia boleh pada bila-bila masa selepas itu ditangkap dan diperlakukan seolah-olah dia telah ditangkap pada masa dia melakukan kesalahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pegawai cukai jualan yang hak boleh menyebabkan diambil gambar, kesan jari dan ibu jari dan apa-apa bentuk pengenalan lain yang mungkin dikehendaki di bawah mana-mana undang-undang bertulis lain mana-mana orang yang dipertuduh atas suatu kesalahan terhadap Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72__subsec_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72__subsec_6__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72__subsec_6__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap orang yang ditangkap sedemikian boleh dilepaskan daripada jagaan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72__subsec_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "apabila dia mendepositkan apa-apa jumlah wang yang munasabah sebagaimana yang dikehendaki oleh pegawai cukai jualan yang hak;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72__subsec_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "apabila dia menyempurnakan suatu bon, dengan mana-mana penjamin atau penjamin-penjamin, sebagaimana yang dikehendaki oleh pegawai cukai jualan yang hak; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72__subsec_6__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "apabila dia mendepositkan apa-apa jumlah wang yang munasabah sebagaimana yang dikehendaki oleh pegawai cukai jualan yang hak dan dia menyempurnakan suatu bon, dengan mana-mana penjamin atau penjamin-penjamin, sebagaimana yang dikehendaki oleh pegawai cukai jualan yang hak."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72__subsec_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72__subsec_7__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang telah dilepaskan daripada jagaan di bawah subseksyen (6) boleh ditangkap tanpa waran oleh mana-mana pegawai cukai jualan yang hak—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72__subsec_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72__subsec_7",
      "schema:text": {
        "@language": "ms",
        "@value": "jika pegawai itu mempunyai alasan yang munasabah untuk mempercayai bahawa mana-mana syarat yang tertakluk kepadanya orang itu dilepaskan atau selainnya dibenarkan untuk dijamin telah atau berkemungkinan akan dimungkiri; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72__subsec_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_X__cl_72__subsec_7",
      "schema:text": {
        "@language": "ms",
        "@value": "apabila diberitahu secara bertulis oleh penjamin orang itu bahawa orang itu berkemungkinan akan memungkiri mana-mana syarat yang tertakluk kepadanya orang itu dilepaskan dan bahawa penjamin itu berhasrat untuk dilepaskan daripada obligasinya sebagai penjamin."
      }
    }
  ]
}
