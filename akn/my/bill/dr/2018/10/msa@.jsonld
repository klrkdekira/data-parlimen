      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III",
      "@type": "akn:part",
      "eli:number": "III",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_11"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "PENGENAAN DAN SKOP CUKAI JUALAN Pengenaan dan skop cukai jualan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_10__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_10__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_10__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_10__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_10__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Cukai jualan hendaklah dikenakan dan dilevikan pada kadar yang ditetapkan mengikut subseksyen (2) ke atas barang bercukai yang dijual, digunakan atau dilupuskan atau diimport, dengan merujuk kepada nilai jualan barang bercukai sebagaimana yang ditentukan di bawah seksyen 9."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_10__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_10__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, melalui perintah yang disiarkan dalam Warta—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_10__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_10__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menetapkan kadar cukai jualan yang hendak dikenakan dan dilevikan di bawah Akta ini; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_10__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_10__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mengubah atau meminda kadar cukai jualan yang ditetapkan di bawah perenggan (a)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_10__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_10__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_10__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa perintah yang dibuat di bawah subseksyen (2) hendaklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_10__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_10__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dibentangkan di hadapan Dewan Rakyat pada mesyuarat Dewan Rakyat yang berikutnya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_10__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_10__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "apabila habis tempoh satu ratus dua puluh hari daripada dibentangkan di bawah perenggan (a) atau apa-apa tempoh lanjutan sebagaimana yang diarahkan, melalui ketetapan, oleh Dewan Rakyat, terhenti berkuat kuasa secara keseluruhannya jika perintah itu tidak disahkan, atau sebahagiannya setakat yang perintah itu tidak disahkan, oleh suatu ketetapan yang diluluskan oleh Dewan Rakyat dalam tempoh satu ratus dua puluh hari itu atau, jika tempoh itu telah dilanjutkan, dalam tempoh yang dilanjutkan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_10__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu perintah terhenti berkuat kuasa secara keseluruhannya atau sebahagiannya sebagaimana yang diperuntukkan di bawah subseksyen (3), apa-apa cukai jualan yang telah dikenakan dan dilevikan menurut perintah itu atau apa-apa bahagian perintah itu sebagaimana yang terhenti berkuat kuasa hendaklah, tertakluk kepada subseksyen (5) dan (6), kena dibayar balik kepada orang yang membayar cukai jualan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_10__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Melainkan jika Menteri mengarahkan selainnya, tiada cukai jualan yang kena dibayar balik di bawah subseksyen (4) boleh dibayar balik, melainkan jika orang yang membayar cukai jualan itu membuat suatu tuntutan secara bertulis kepada Ketua Pengarah dalam masa satu tahun dari tarikh perintah itu terhenti berkuat kuasa secara keseluruhan atau sebahagiannya, dan tuntutan itu hendaklah mengandungi apa-apa butir sebagaimana yang dikehendaki oleh Ketua Pengarah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_10__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah boleh mengurangkan atau tidak membenarkan apa-apa cukai jualan yang kena dibayar balik di bawah subseksyen (4) setakat yang pembayaran balik itu akan secara tidak patut memperkaya orang yang membayar cukai jualan itu. Cukai jualan yang genap masa"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_11__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_11__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_11__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Cukai jualan yang boleh dikenakan di bawah perenggan 8(1)(a) hendaklah menjadi genap masa pada masa barang bercukai itu dijual, dilupuskan selain dengan cara jualan, atau pertama kali digunakan selain sebagai bahan dalam pengilangan barang bercukai, oleh orang kena cukai."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_11__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_11__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_11__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_11__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh menentukan masa yang berlainan bagi cukai jualan menjadi genap masa berkenaan dengan petroleum tertakluk kepada apa-apa syarat sebagaimana yang difikirkan patut oleh Menteri; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_11__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_11__subsec_2__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_11__subsec_2__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_11__subsec_2__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_11__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "jika apa-apa jualan barang bercukai dibuat oleh mana-mana orang, yang merupakan orang bercukai di bawah Akta ini, dalam tempoh bermula dari 1 Jun 2018 dan berakhir sebaik sebelum tarikh efektif, dan barang bercukai itu dihantar pada atau selepas tarikh efektif—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_11__subsec_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_11__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "jualan barang bercukai itu hendaklah disifatkan telah dibuat pada tarikh barang bercukai itu dihantar walaupun apa-apa pembayaran, secara keseluruhannya atau sebahagiannya, diterima atau invois dikeluarkan, bagi barang bercukai itu dalam tempoh itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_11__subsec_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_11__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa pembayaran yang diterima dalam tempoh itu atau pada atau selepas tarikh efektif, atau invois dikeluarkan dalam tempoh itu, hendaklah disifatkan telah diterima atau dikeluarkan pada tarikh barang bercukai itu dihantar; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_11__subsec_2__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_11__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "cukai jualan hendaklah dikenakan dan dilevikan ke atas barang bercukai itu dan hendaklah menjadi genap masa pada tarikh barang bercukai itu dihantar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_11__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika barang bercukai yang disebut dalam subperenggan (2)(b) ialah petroleum, cukai jualan berkenaan dengan petroleum itu hendaklah menjadi genap masa pada masa yang ditentukan di bawah subperenggan (2)(a)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_11__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_11__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_11__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana pengilang berdaftar yang berhenti menjalankan perniagaan sebagai pengilang digantikan dalam perniagaan itu oleh orang lain yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_11__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_11__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "membeli daripada pengilang berdaftar itu apa-apa stok barang bercukai yang ada dalam tangan pada tarikh pemberhentian itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_11__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_11__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "memperoleh apa-apa stok barang bercukai sebagai seorang pemegang amanah, penerima, pelikuidasi, penerima derma, atau benefisiari bagi pengilang berdaftar itu, tiada cukai jualan boleh menjadi genap masa ke atas pembelian atau pemerolehan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_8__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_8__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_8__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_8__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_8__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu cukai yang dikenali sebagai cukai jualan hendaklah dikenakan dan dilevikan ke atas semua barang bercukai—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_8__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_8__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "yang dikilangkan di Malaysia oleh pengilang berdaftar dan dijual, digunakan atau dilupuskan olehnya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_8__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_8__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "yang diimport ke dalam Malaysia oleh mana-mana orang."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Cukai jualan ke atas apa-apa pengimportan barang bercukai ke dalam Malaysia hendaklah dilevikan dan kena dibayar seolah- olah ia suatu duti kastam atau duti eksais dan seolah-olah barang bercukai yang diimport itu adalah berduti dan boleh dikenakan duti kastam atau duti eksais."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_8__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini hendaklah ditafsirkan bersekali dengan Akta Kastam 1967 dan Akta Eksais 1976 [Akta 176] berkenaan dengan pengimportan atau pengeksportan barang termasuk barang dalam transit dan pergerakan barang di bawah kawalan kastam atau kawalan eksais."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_8__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika terdapat apa-apa ketidakselarasan antara peruntukan Akta Kastam 1967 atau Akta Eksais 1976 dengan peruntukan Akta ini, peruntukan Akta ini hendaklah terpakai. Penentuan nilai jualan barang bercukai"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_9__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_9__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_9__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_9__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam hal barang bercukai—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_9__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_9__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "yang dijual oleh orang kena cukai; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_9__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_9__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_9__subsec_1__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_9__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "yang dikilangkan oleh orang kena cukai dan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_9__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_9__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "digunakan olehnya selain sebagai bahan bagi mengilang barang bercukai; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_9__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_9__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dilupuskan olehnya selain dengan cara jualan, nilai jualan barang bercukai itu hendaklah ditentukan mengikut peraturan-peraturan yang dibuat di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_9__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_9__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_9__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam hal barang bercukai yang diimport ke dalam Malaysia, nilai jualan barang bercukai itu hendaklah jumlah amaun yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_9__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_9__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "nilai barang bercukai itu bagi maksud duti kastam sebagaimana yang ditentukan mengikut Akta Kastam 1967;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_9__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_9__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "amaun duti kastam, jika ada, yang telah dibayar atau kena dibayar ke atas barang bercukai itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_9__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_9__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "amaun duti eksais, jika ada, yang telah dibayar atau kena dibayar ke atas barang bercukai itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_9__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_III__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana pengilang berdaftar menerima barang bercukai daripada mana-mana orang untuk dikilangkan dan kemudiannya memulangkan barang yang telah dikilangkan sedemikian kepada orang itu, nilai jualan barang yang dikilangkan sedemikian hendaklah, tertakluk kepada kelulusan Ketua Pengarah, merupakan amaun yang dikenakan oleh pengilang itu bagi kerja yang telah dilakukan olehnya. Kadar cukai jualan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_4__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_4__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_4__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_4__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah hendaklah mempunyai pengawasan ke atas semua perkara yang berhubungan dengan cukai jualan, tertakluk kepada arahan dan kawalan Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada arahan dan penyeliaan am Ketua Pengarah, seorang pegawai kanan cukai jualan hendaklah mempunyai dan menjalankan semua kuasa yang diberikan kepada Ketua Pengarah oleh atau di bawah Akta ini, selain yang diberikan di bawah seksyen 7, 41, 42 dan 105."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_4__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang, selain seorang pegawai cukai jualan, boleh dilantik oleh, atau diambil kerja dengan persetujuan, Ketua Pengarah untuk apa-apa kewajipan atau perkhidmatan yang berhubungan dengan cukai jualan dan orang itu hendaklah disifatkan sebagai pegawai cukai jualan bagi kewajipan atau perkhidmatan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_4__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah boleh, melalui pemberian kuasa secara bertulis, memberi mana-mana pegawai cukai jualan yang bukan pegawai kanan cukai jualan kesemua atau mana-mana kuasa seorang pegawai kanan cukai jualan bagi tempoh tidak melebihi sembilan puluh hari berkenaan dengan mana-mana satu pemberian kuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_4__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pegawai cukai jualan hendaklah mempunyai kewajipan dan kuasa untuk menguatkuasakan dan memastikan pematuhan sewajarnya peruntukan Akta ini. Orang yang dilantik atau diambil kerja hendaklah menjadi pekhidmat awam"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap orang yang dilantik atau diambil kerja di bawah subseksyen 4(3) bagi apa-apa kewajipan atau perkhidmatan yang berhubungan dengan cukai jualan hendaklah disifatkan sebagai pekhidmat awam mengikut pengertian Kanun Keseksaan [Akta 574]. Pengiktirafan jawatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_6__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap pegawai cukai jualan apabila menunaikan kewajipannya hendaklah, apabila diminta oleh mana-mana orang, mengisytiharkan jawatannya dan mengemukakan kepada orang itu kad kuasa atau lencana yang ditetapkan di bawah seksyen 8a Akta Kastam 1967 atau dalam hal mana-mana pegawai cukai jualan yang bukan seorang pegawai kastam, apa-apa kad kuasa lain sebagaimana yang diluluskan oleh Ketua Pengarah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Tidaklah menjadi suatu kesalahan bagi mana-mana orang yang enggan mematuhi apa-apa permintaan, tuntutan atau perintah yang dibuat oleh mana-mana pegawai cukai jualan yang bertindak atau yang berupa sebagai bertindak di bawah Akta ini jika pegawai itu enggan mengisytiharkan jawatannya dan mengemukakan kad kuasa atau lencananya apabila diminta oleh orang itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_6__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_6__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang, yang bukan seorang pegawai cukai jualan, yang memakai, menggunakan, memiliki atau mempamerkan dengan cara yang menyalahi undang-undang, selain semasa suatu pertunjukan pentas atau persembahan teater yang lain—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_6__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_6__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa pakaian seragam yang ditetapkan di bawah seksyen 8a Akta Kastam 1967 atau apa-apa pakaian yang kelihatan seperti, atau yang mengandungi tanda tersendiri yang terdapat pada, pakaian seragam itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_6__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_6__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa kad kuasa atau lencana yang ditetapkan, atau kad kuasa sebagaimana yang diluluskan oleh Ketua Pengarah, yang disebut dalam subseksyen (1), melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tiga tahun atau kedua-duanya. Kerahsiaan maklumat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_7__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_7__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_7__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_7__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap orang, yang mempunyai apa-apa kewajipan rasmi atau yang dilantik atau yang diambil kerja di bawah Akta ini, hendaklah menganggap dan menguruskan semua dokumen, maklumat, penyata atau perisytiharan yang berhubungan dengan perniagaan, nilai jualan barang mana-mana orang kena cukai atau nilai jualan barang yang diimport sebagai rahsia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_7__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_7__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada subseksyen (4), tiap-tiap orang yang mempunyai milikan atau kawalan ke atas apa-apa dokumen, maklumat, penyata atau perisytiharan atau salinannya berhubung dengan perniagaan atau nilai jualan barang mana-mana orang kena cukai atau nilai jualan barang yang diimport, yang pada bila-bila masa, selainnya bagi maksud Akta ini atau dengan kuasa nyata Ketua Pengarah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_7__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_7__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menyampaikan atau cuba untuk menyampaikan maklumat itu atau apa-apa jua yang terkandung dalam dokumen, penyata atau perisytiharan itu atau salinannya kepada mana-mana orang; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_7__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_7__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "membiarkan atau membenarkan mana-mana orang untuk mempunyai akses kepada apa-apa maklumat itu atau kepada apa-apa jua yang terkandung dalam dokumen, penyata atau perisytiharan itu atau salinannya, melakukan suatu kesalahan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_7__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun yang mempunyai apa-apa kewajipan rasmi atau yang dilantik atau yang diambil kerja di bawah Akta ini atau yang disebut dalam subseksyen (4) boleh dikehendaki untuk mengemukakan dalam apa-apa perkara atau prosiding dalam mana-mana mahkamah atau tribunal apa-apa dokumen, maklumat, penyata atau perisytiharan atau untuk mendedahkan atau menyampaikan dalam perkara atau prosiding itu apa-apa perkara atau benda, yang dibawa kepada pengetahuannya dalam melaksanakan kewajipannya di bawah Akta ini, kecuali sebagaimana yang perlu bagi maksud melaksanakan peruntukan Akta ini atau bagi memulakan suatu pendakwaan atau dalam penjalanan suatu pendakwaan bagi apa-apa kesalahan yang dilakukan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_7__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah boleh, sebagaimana yang difikirkan patut olehnya, menghantar atau menyampaikan apa-apa dokumen, maklumat, penyata atau perisytiharan yang disebut dalam subseksyen (1) atau apa-apa jua yang terkandung dalamnya, kepada Ketua Perangkaan Jabatan Perangkaan Malaysia yang boleh dikehendaki dalam melaksanakan kewajipan rasminya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_7__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (4), Menteri boleh, sebagaimana yang difikirkan patut olehnya, membenarkan Ketua Pengarah untuk menghantar atau menyampaikan apa-apa dokumen, maklumat, penyata atau perisytiharan yang disebut dalam subseksyen (1) atau apa-apa jua yang terkandung dalamnya kepada mana-mana orang lain."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_12",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_13",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_14",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_15",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_16",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_17",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_18",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_19",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_20"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "PENDAFTARAN Tanggungan untuk berdaftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_12__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_12__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_12__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, melalui perintah yang disiarkan dalam Warta, menentukan jumlah nilai jualan barang bercukai bagi maksud pendaftaran mana-mana pengilang di bawah Bahagian ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_12__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_12__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada subseksyen (3), mana-mana pengilang barang bercukai bertanggungan untuk berdaftar pada masa yang berikut, mana-mana yang lebih awal:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_12__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_12__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pada akhir mana-mana bulan, jika jumlah nilai jualan semua barang bercukainya dalam bulan itu dan sebelas bulan sebaik sebelum bulan itu telah melebihi jumlah nilai jualan barang bercukai yang ditentukan di bawah subseksyen (1); atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_12__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_12__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pada akhir mana-mana bulan, jika terdapat alasan yang munasabah untuk mempercayai bahawa jumlah nilai jualan semua barang bercukainya dalam bulan itu dan sebelas bulan sebaik selepas bulan itu akan melebihi jumlah nilai jualan barang bercukai yang ditentukan di bawah subseksyen (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_12__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_12__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_12__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Jumlah nilai jualan semua barang bercukai seorang pengilang dalam bulan itu dan sebelas bulan sebaik sebelum bulan itu yang disebut dalam perenggan (2)(a) tidak boleh diambil kira jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_12__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_12__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "pendaftaran pengilang itu dibatalkan, selain di bawah subseksyen 19(3), dalam tempoh itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_12__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_12__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah berpuas hati bahawa sebelum pendaftaran pengilang itu dibatalkan, dia telah memberikan semua maklumat yang dikehendaki oleh Ketua Pengarah bagi menentukan sama ada untuk membatalkan pendaftaran itu atau tidak."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_12__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana orang menggantikan apa-apa perniagaan pengilang berdaftar sebagaimana yang dinyatakan dalam subseksyen 11(4), orang itu hendaklah disifatkan sebagai pengilang yang bertanggungan untuk berdaftar pada tarikh dia menggantikan perniagaan itu. Permohonan bagi pendaftaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_13__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_13__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_13__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_13__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pengilang yang bertanggungan untuk berdaftar di bawah seksyen 12 hendaklah memohon kepada Ketua Pengarah untuk didaftarkan sebagai seorang pengilang berdaftar dalam borang yang ditetapkan tidak lewat daripada hari terakhir bagi bulan selepas bulan yang dia bertanggungan untuk berdaftar sebagaimana yang disebut dalam perenggan 12(2)(a) atau (b)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila permohonan di bawah subseksyen (1) diterima, Ketua Pengarah boleh meluluskan pendaftaran itu, tertakluk kepada apa-apa syarat yang difikirkan patut olehnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_13__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah hendaklah mendaftarkan pengilang di bawah subseksyen (1) berkuat kuasa dari hari pertama bagi bulan selepas bulan yang permohonan di bawah subseksyen (1) dibuat atau dari tarikh yang lebih awal sebagaimana yang dipersetujui antara Ketua Pengarah dengan pengilang itu tetapi tarikh itu tidak boleh lebih awal daripada tarikh pengilang itu menjadi bertanggungan untuk berdaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_13__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana pengilang tidak mematuhi subseksyen (1), Ketua Pengarah hendaklah mendaftarkan pengilang itu pada tarikh sebagaimana yang ditentukan oleh Ketua Pengarah tetapi tidak boleh lebih awal daripada tarikh pengilang itu bertanggungan untuk berdaftar di bawah seksyen 12."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_13__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pengilang yang tidak mematuhi subseksyen (1) melakukan suatu kesalahan. Pendaftaran sukarela"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_14__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pengilang yang tidak bertanggungan untuk berdaftar di bawah seksyen 12 boleh memohon kepada Ketua Pengarah untuk didaftarkan sebagai seorang pengilang berdaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila permohonan di bawah subseksyen (1) diterima, Ketua Pengarah boleh meluluskan pendaftaran itu dari apa-apa tarikh sebagaimana yang ditentukannya tertakluk kepada apa-apa syarat yang difikirkan patut olehnya. Arahan untuk menganggap orang sebagai orang kena cukai tunggal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "(1) Walau apa pun seksyen 12, jika Ketua Pengarah berpuas hati bahawa apa-apa pengasingan aktiviti perniagaan adalah dibuat-buat, dia boleh membuat suatu arahan yang menghendaki supaya— (a) orang yang dinamakan dalam arahan itu dianggap sebagai orang kena cukai tunggal yang menjalankan aktiviti perniagaan yang diperihalkan dalam arahan itu berkuat kuasa dari tarikh yang dinyatakan dalam arahan itu; dan (b) orang kena cukai tunggal yang disebut dalam perenggan (a) didaftarkan berkuat kuasa dari tarikh yang dinyatakan dalam arahan itu. (2) Bagi maksud subseksyen (1), dalam menentukan sama ada apa-apa pengasingan aktiviti perniagaan adalah dibuat-buat, hendaklah diambil kira setakat yang orang yang berlainan yang menjalankan aktiviti perniagaan itu berkait rapat antara satu sama lain melalui hubungan kewangan, ekonomi dan organisasi. (3) Ketua Pengarah boleh membuat arahan di bawah subseksyen (1) dengan menamakan mana-mana orang jika Ketua Pengarah berpuas hati bahawa— (a) orang itu mengilang atau telah mengilang barang bercukai; (b) aktiviti yang dalam penjalanannya orang itu mengilang atau telah mengilang barang bercukai itu menjadi hanya sebahagian daripada aktiviti tertentu dalam perniagaan itu dan bahawa aktiviti lain dalam perniagaan itu, sama ada atau tidak aktiviti lain itu serupa dengan aktiviti yang dijalankan oleh orang itu, sedang dijalankan serentak atau dijalankan sebelum itu, atau kedua-duanya, oleh seorang yang lain atau lebih daripada seorang yang lain; dan (c) jika semua barang bercukai yang dikilangkan dalam perniagaan itu diambil kira, orang yang menjalankan perniagaan itu akan, pada masa arahan itu dibuat, dikehendaki untuk berdaftar menurut kuasa seksyen 12. (4) Apa-apa arahan yang dibuat di bawah subseksyen (1) hendaklah disampaikan kepada setiap orang yang dinamakan dalam arahan itu. (5) Jika, selepas suatu arahan dibuat di bawah subseksyen (1), Ketua Pengarah mendapati bahawa mana-mana orang yang tidak dinamakan dalam arahan itu mengilang barang bercukai dalam penjalanan aktiviti yang sepatutnya dianggap sebagai sebahagian daripada aktiviti perniagaan itu, Ketua Pengarah boleh membuat dan menyampaikan kepada orang itu suatu arahan tambahan dengan menambah nama orang itu kepada nama orang yang dinamakan dalam arahan di bawah subseksyen (1). (6) Apabila nama orang itu ditambah dalam arahan di bawah subseksyen (5), orang itu hendaklah dianggap sebagai orang kena cukai tunggal yang menjalankan aktiviti perniagaan yang diperihalkan dalam arahan di bawah subseksyen (1) berkuat kuasa dari tarikh yang dinyatakan dalam arahan itu. (7) Jika, sebaik sebelum apa-apa arahan termasuk suatu arahan tambahan dibuat, mana-mana orang yang dinamakan dalam arahan itu telah didaftarkan berkenaan dengan barang bercukai yang dikilangkan olehnya sebagaimana yang dinyatakan dalam subseksyen (3) atau (5), pendaftarannya hendaklah dibatalkan oleh Ketua Pengarah berkuat kuasa dari tarikh orang kena cukai tunggal itu didaftarkan di bawah subseksyen (1). (8) Apabila pendaftaran dibatalkan di bawah subseksyen (7), orang yang pendaftarannya telah dibatalkan bersama dengan semua orang lain yang dinamakan dalam arahan di bawah subseksyen (1) hendaklah dianggap sebagai orang kena cukai tunggal. (9) Berhubung dengan suatu perniagaan yang dinyatakan dalam suatu arahan, orang yang dinamakan dalam arahan itu bersama dengan mana-mana orang yang dinamakan dalam suatu arahan tambahan yang berhubungan dengan perniagaan itu, sebagai orang yang bersama-sama dianggap sebagai orang kena cukai tunggal, disebut sebagai “anggota konstituen” dalam subseksyen (10) dan (11) . (10) Jika apa-apa arahan dibuat di bawah subseksyen (1)— (a) orang kena cukai tunggal yang menjalankan perniagaan yang dinyatakan dalam arahan itu hendaklah didaftarkan atas apa-apa nama sebagaimana yang dicadangkan oleh orang yang dinamakan dalam arahan itu secara bersama melalui notis secara bertulis yang diberikan kepada Ketua Pengarah tidak lewat daripada empat belas hari selepas tarikh arahan itu disampaikan kepada orang yang terakhir daripada orang yang dinamakan dalam arahan itu atau, jika tiada apa-apa cadangan, atas apa-apa nama yang dinyatakan dalam arahan itu; (b) apa-apa barang bercukai yang dikilangkan oleh salah seorang anggota konstituen dalam penjalanan aktiviti orang kena cukai tunggal itu hendaklah dianggap sebagai barang bercukai yang dikilangkan oleh orang kena cukai tunggal itu; (c) setiap anggota konstituen hendaklah secara bersesama dan berasingan bertanggungan bagi apa-apa cukai jualan yang genap masa dan kena dibayar oleh orang kena cukai tunggal itu; (d) tanpa menjejaskan perenggan (c), apa-apa kegagalan oleh orang kena cukai tunggal untuk mematuhi apa-apa kehendak yang dikenakan di bawah Akta ini hendaklah dianggap sebagai kegagalan oleh setiap anggota konstituen secara berasingan; dan (e) tertakluk kepada perenggan (a) hingga (d), anggota konstituen hendaklah dianggap sebagai suatu perkongsian yang menjalankan perniagaan orang kena cukai tunggal itu dan apa-apa persoalan mengenai skop aktiviti perniagaan itu pada bila-bila masa hendaklah ditentukan dengan sewajarnya. (11) Jika Ketua Pengarah mendapati bahawa mana-mana orang yang merupakan salah seorang daripada anggota konstituen tidak boleh lagi dianggap sedemikian bagi maksud perenggan (10)(c) dan (d) dan Ketua Pengarah memberikan notis secara bertulis bagi maksud sedemikian, orang itu— (a) tidak lagi mempunyai apa-apa tanggungan menurut kuasa perenggan (10)(c) dan (d) bagi apa-apa jua yang dilakukan selepas tarikh yang dinyatakan dalam notis itu; dan (b) pada tarikh yang dinyatakan dalam notis itu, hendaklah dianggap sebagai telah terhenti menjadi anggota perkongsian yang disebut dalam perenggan (10)(e). Pendaftaran perkongsian"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_16__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_16__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_16__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_16__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_16__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_16__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_16__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_16__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_16__subsec_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_16__subsec_10"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_16__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_16__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_16__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftaran bagi—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_16__subsec_10",
      "@type": "akn:subsection",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini, suatu perkongsian tidak termasuk suatu perkongsian liabiliti terhad. Pemberhentian tanggungan untuk berdaftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_16__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_16__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "orang yang menjalankan perniagaan dalam suatu perkongsian sebagai pengilang berdaftar hendaklah atas nama firma itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_16__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_16__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "orang yang sama yang menjalankan perniagaan yang berasingan dalam suatu perkongsian sebagai pengilang berdaftar hendaklah atas nama yang berasingan bagi firma-firma itu masing-masing."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam menentukan sama ada barang bercukai dikilangkan oleh orang yang disebut dalam subseksyen (1), tiada apa-apa perubahan dalam perkongsian itu boleh diambil kira."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_16__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_16__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_16__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang terhenti menjadi pekongsi dalam suatu perkongsian hendaklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_16__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_16__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "memberitahu Ketua Pengarah secara bertulis mengenai tarikh pemberhentian itu dalam masa tiga puluh hari dari tarikh pemberhentian itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_16__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_16__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "membayar perkadaran tanggungan perkongsian itu ke atas apa-apa cukai jualan yang genap masa dan kena dibayar ke atas apa-apa barang bercukai yang dikilangkan oleh perkongsian itu sehingga tarikh pemberhentian itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_16__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana orang terhenti menjadi pekongsi dalam suatu perkongsian di bawah subseksyen (3) dalam apa-apa tempoh bercukai, apa-apa notis, sama ada mengenai taksiran atau selainnya, yang disampaikan kepada perkongsian itu dan yang berhubungan dengan tempoh bercukai itu atau dengan apa-apa tempoh bercukai yang lain yang semasa keseluruhan atau sebahagian daripada tempoh bercukai itu dia ialah pekongsi dalam perkongsian itu, hendaklah disifatkan sebagai telah disampaikan juga kepadanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_16__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_16__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_16__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun mana-mana undang-undang bertulis yang berlawanan, apa-apa notis, sama ada mengenai taksiran atau selainnya, yang dialamatkan kepada suatu perkongsian mengikut nama yang dengannya perkongsian itu didaftarkan di bawah Akta ini, dan disampaikan mengikut Akta ini hendaklah disifatkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_16__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_16__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "sebagai telah disampaikan dengan sewajarnya kepada perkongsian itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_16__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_16__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "jika subseksyen (4) terpakai, sebagai telah disampaikan dengan sewajarnya kepada mana-mana pekongsi yang terdahulu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_16__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen (1) dan (3) tidaklah menjejaskan takat yang seorang pekongsi bertanggungan bagi cukai jualan yang terhutang oleh firma itu di bawah mana-mana undang-undang bertulis yang lain."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_16__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seseorang itu merupakan pekongsi dalam suatu firma dalam sebahagian daripada suatu tempoh bercukai sahaja, tanggungannya bagi cukai jualan ke atas jualan barang bercukai oleh firma itu dalam tempoh bercukai itu hendaklah mengikut perkadaran tanggungan firma itu sebagaimana yang patut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_16__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika apa-apa notis dikehendaki supaya diberikan oleh suatu perkongsian di bawah Akta ini, hendaklah menjadi tanggungan bersesama dan berasingan semua pekongsi untuk memberikan notis itu, kecuali jika suatu notis diberikan oleh mana-mana pekongsi, ia hendaklah dianggap sebagai pematuhan yang mencukupi bagi kehendak itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_16__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar perenggan (3)(a) atau (b) melakukan suatu kesalahan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_17__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada subseksyen (2), mana-mana pengilang berdaftar hendaklah terhenti daripada bertanggungan untuk berdaftar pada akhir mana-mana bulan jika Ketua Pengarah berpuas hati bahawa jumlah nilai jualan semua barang bercukainya dalam bulan itu dan sebelas bulan sebaik selepas bulan itu (“selepas ini disebut sebagai “tempoh dua belas bulan”) tidak melebihi jumlah nilai jualan barang bercukai yang ditentukan di bawah subseksyen 12(1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Seorang pengilang berdaftar tidak terhenti daripada bertanggungan untuk berdaftar menurut kuasa subseksyen (1) jika Ketua Pengarah berpuas hati bahawa sebab bagi jumlah nilai jualan semua barang bercukainya tidak melebihi jumlah nilai jualan barang bercukai yang ditentukan di bawah subseksyen 12(1) adalah dalam tempoh dua belas bulan yang disebut dalam subseksyen (1) dia berhenti mengilangkan barang bercukai itu secara sementara, atau menggantung pengilangan barang bercukai itu untuk tempoh tiga puluh hari atau lebih. Pemberitahuan pemberhentian tanggungan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_18__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_18__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_18__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_18__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Seorang pengilang yang didaftarkan di bawah seksyen 13 atau 14—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_18__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_18__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "yang berhenti mengilang barang bercukai; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_18__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_18__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "yang terhenti bertanggungan untuk berdaftar di bawah seksyen 17, mengikut mana-mana yang berkenaan, hendaklah memberitahu Ketua Pengarah secara bertulis mengenai hakikat itu dan tarikh pemberhentian itu dalam masa tiga puluh hari dari tarikh pemberhentian itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1) melakukan suatu kesalahan. Pembatalan pendaftaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_19__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_19__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_19__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_19__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_19__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika pengilang berdaftar membuat suatu pemberitahuan di bawah seksyen 18, Ketua Pengarah boleh membatalkan pendaftaran pengilang itu dari tarikh pengilang berdaftar itu berhenti mengilang barang bercukai atau terhenti bertanggungan untuk berdaftar di bawah seksyen 17, mengikut mana-mana yang berkenaan, atau dari apa-apa tarikh terkemudian sebagaimana yang ditentukan oleh Ketua Pengarah jika dia berpuas hati bahawa pengilang berdaftar itu boleh dibatalkan pendaftarannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_19__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika tiada pemberitahuan dibuat di bawah seksyen 18 dan Ketua Pengarah berpuas hati bahawa pengilang berdaftar telah berhenti mengilang barang bercukai atau telah terhenti bertanggungan untuk berdaftar di bawah seksyen 17, Ketua Pengarah boleh membatalkan pendaftarannya dari tarikh pengilang berdaftar itu berhenti mengilang barang bercukai atau terhenti bertanggungan untuk berdaftar di bawah seksyen 17, mengikut mana-mana yang berkenaan, atau dari apa-apa tarikh terkemudian sebagaimana yang ditentukan oleh Ketua Pengarah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_19__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_19__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_19__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Ketua Pengarah berpuas hati bahawa pada hari pengilang didaftarkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_19__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_19__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal seorang pengilang yang telah didaftarkan di bawah seksyen 13, pengilang itu telah tidak bertanggungan untuk berdaftar di bawah seksyen 12 atau telah berhenti mengilang barang bercukai; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_19__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_19__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal seorang pengilang yang telah didaftarkan di bawah seksyen 14, pengilang itu telah tidak mengilang barang bercukai atau telah berhenti mengilang barang bercukai, Ketua Pengarah boleh membatalkan pendaftaran pengilang itu berkuat kuasa dari tarikh sebagaimana yang ditentukan oleh Ketua Pengarah dalam pemberitahuan secara bertulis kepada pengilang itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_19__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah boleh membatalkan pendaftaran seorang pengilang berdaftar di bawah subseksyen 14(2) jika pengilang berdaftar itu memungkiri apa-apa syarat yang dikenakan berhubung dengan pendaftaran itu berkuat kuasa dari tarikh kemungkiran itu atau dari apa-apa tarikh terkemudian sebagaimana yang ditentukan oleh Ketua Pengarah. Pengecualian daripada pendaftaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_20__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_20__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_20__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, melalui perintah yang disiarkan dalam Warta, mengecualikan mana-mana golongan orang daripada pendaftaran di bawah seksyen 13 tertakluk kepada apa-apa syarat yang difikirkan patut olehnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_20__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IV__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Walaupun mana-mana orang dikecualikan menurut kuasa subseksyen (1), orang itu boleh memohon untuk didaftarkan sebagai pengilang berdaftar dan peruntukan Akta ini hendaklah terpakai bagi orang itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX",
      "@type": "akn:part",
      "eli:number": "IX",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_55",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_56",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_57",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_58",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_59",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_60",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_61"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "PERUNTUKAN KHAS YANG BERHUBUNGAN DENGAN KAWASAN KHAS Tafsiran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_55",
      "@type": "akn:clause",
      "eli:number": "55",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam Bahagian ini, “Malaysia” tidak termasuk kawasan khas dan kawasan ditetapkan. Pemakaian"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_56",
      "@type": "akn:clause",
      "eli:number": "56",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud Bahagian ini, Akta ini tidak terpakai bagi apa-apa barang bercukai yang dikilangkan di dalam kawasan khas. Cukai jualan yang berhubungan dengan barang bercukai yang diimport ke dalam atau diangkut ke atau dari kawasan khas"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_57",
      "@type": "akn:clause",
      "eli:number": "57",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_57__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_57__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_57__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX",
      "schema:name": {
        "@language": "ms",
        "@value": "Walau apa pun apa-apa jua yang berlawanan yang terkandung dalam Akta ini—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_57__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_57__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_57__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_57__para_a__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_57",
      "schema:text": {
        "@language": "ms",
        "@value": "tiada cukai jualan boleh dilevikan dan kena dibayar ke atas apa-apa barang bercukai—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_57__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_57__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "yang diimport ke dalam kawasan khas atau diangkut ke kawasan khas dari Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_57__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_57__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "yang diangkut di antara kawasan khas; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_57__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_57__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "yang diangkut dari kawasan khas ke kawasan ditetapkan, selain apa-apa barang bercukai yang diisytiharkan oleh Menteri dari semasa ke semasa melalui perintah yang disiarkan dalam Warta;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_57__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_57",
      "schema:text": {
        "@language": "ms",
        "@value": "cukai jualan hendaklah dilevikan dan kena dibayar ke atas semua barang bercukai yang diangkut ke Malaysia dari kawasan khas seolah-olah pengangkutan itu ke Malaysia ialah pengimportan ke dalam Malaysia; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_57__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_57",
      "schema:text": {
        "@language": "ms",
        "@value": "nilai jualan barang bercukai yang boleh dikenakan cukai jualan mengikut perenggan (b) hendaklah ditentukan mengikut subseksyen 9(2). Pengangkutan barang bercukai dari atau ke kawasan khas ke atau dari Malaysia"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_58",
      "@type": "akn:clause",
      "eli:number": "58",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_58__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_58__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_58__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_58__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_58__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_58",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika barang-barang bercukai diangkut—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_58__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_58__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dari kawasan khas ke Malaysia; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_58__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_58__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dari Malaysia ke kawasan khas, peruntukan Akta ini hendaklah, dengan apa-apa pengubahsuaian dan penyesuaian yang perlu, terpakai seolah-olah barang itu telah diimport ke dalam, atau dieksport dari, Malaysia dari atau ke suatu tempat di luar Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_58__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_58__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_58__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_58",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan keluasan subseksyen (1), Bahagian X hendaklah terpakai bagi—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_58__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_58__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "barang bercukai yang diangkut ke atau dari kawasan khas dari atau ke Malaysia; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_58__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_58__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "orang, dan kenderaan, kapal dan pesawat udara, yang mengangkut barang itu. Perisytiharan barang bercukai yang diangkut dari kawasan khas ke Malaysia"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_59",
      "@type": "akn:clause",
      "eli:number": "59",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX",
      "schema:text": {
        "@language": "ms",
        "@value": "Orang yang menjaga mana-mana kenderaan, kapal atau pesawat udara yang di dalamnya barang bercukai diangkut dari kawasan khas ke Malaysia hendaklah membuat suatu perisytiharan yang secara substantialnya dalam bentuk sebagaimana yang ditetapkan di bawah Akta Kastam 1967 yang memberikan butir-butir mengenai barang bercukai yang diangkut di dalam kenderaan, kapal atau pesawat udara itu. Pemungutan cukai jualan di dalam kawasan khas"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_60",
      "@type": "akn:clause",
      "eli:number": "60",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_60__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_60__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_60__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam membuat peraturan-peraturan di bawah seksyen 106, Menteri boleh mengadakan peruntukan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_60__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_60",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi pemungutan di dalam kawasan khas cukai jualan yang kena dibayar berkenaan dengan barang bercukai yang diangkut atau yang hendak diangkut dari atau ke kawasan khas ke atau dari Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_60__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_60",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi had atau sekatan kenderaan, kapal atau pesawat udara yang boleh digunakan untuk mengangkut barang bercukai; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_60__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_60",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi pelesenan atau pengawalan orang, atau kenderaan, kapal atau pesawat udara, yang mengangkut barang bercukai. Pemakaian seksyen 40 bagi barang bercukai yang diangkut ke kawasan khas"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX__cl_61",
      "@type": "akn:clause",
      "eli:number": "61",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_IX",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 40 hendaklah terpakai bagi barang bercukai, selain apa-apa barang yang diisytiharkan oleh Menteri di bawah perenggan 57(a) sebagai kena cukai apabila diimport ke dalam kawasan khas, diangkut dari Malaysia ke kawasan khas seolah-olah barang itu telah dieksport atau dieksport semula, mengikut mana-mana yang berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_I__cl_1__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_I__cl_1__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_I__cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Cukai Jualan 2018."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_I__cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta dan Menteri boleh menetapkan tarikh yang berlainan bagi permulaan kuat kuasa Bahagian yang berlainan atau peruntukan yang berlainan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_I__cl_1__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_I__cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (2), Menteri boleh, melalui pemberitahuan dalam Warta, menetapkan tarikh efektif bagi mengenakan dan melevikan cukai jualan di bawah Akta ini. Tafsiran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_I__cl_2__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_I__cl_2__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_I__cl_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_I__cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam Akta ini, melainkan jika konteksnya menghendaki makna yang lain— “Akta ini” termasuklah apa-apa perundangan subsidiari yang dibuat di bawah Akta ini; “barang” ertinya semua jenis harta alih; “barang bercukai” ertinya barang daripada kelas atau jenis yang tidak dikecualikan daripada cukai jualan; “cukai jualan” ertinya cukai yang kena dibayar di bawah Akta ini; “ditetapkan” ertinya ditetapkan oleh Menteri dalam peraturan-peraturan yang dibuat di bawah Akta ini; “dokumen” mempunyai erti yang diberikan kepadanya di bawah seksyen 3 Akta Keterangan 1950 [Akta 56]; “gudang berlesen” ertinya apa-apa gudang atau tempat yang dilesenkan di bawah seksyen 65 Akta Kastam 1967 [Akta 235]; “gudang kastam” mempunyai erti yang diberikan kepadanya di bawah subseksyen 2(1) Akta Kastam 1967; “gudang pengilangan berlesen” ertinya suatu gudang berlesen yang berkenaan dengannya suatu lesen tambahan untuk menjalankan apa-apa proses pengilangan telah diberikan di bawah seksyen 65a Akta Kastam 1967; “jualan” termasuklah barter, pelupusan barang dengan hak untuk membeli atau atas terma yang memperuntukkan bahawa penjual mengekalkan kepentingan dalam barang itu, dan penghantaran barang di bawah apa-apa syarat berkenaan dengan pembayaran pada masa hadapan; “kawasan ditetapkan” ertinya Labuan, Langkawi dan Tioman; “kawasan khas” ertinya mana-mana zon bebas, gudang berlesen dan gudang pengilangan berlesen, dan Kawasan Pembangunan Bersama; “Kawasan Pembangunan Bersama” mempunyai erti yang diberikan kepadanya di bawah seksyen 2 Akta Pihak Berkuasa Bersama Malaysia-Thailand 1990 [Akta 440]; “ketetapan kastam” ertinya apa-apa ketetapan kastam yang dibuat oleh Ketua Pengarah di bawah seksyen 44; “Ketua Pengarah” ertinya Ketua Pengarah Kastam dan Eksais yang dilantik di bawah subseksyen 3(1) Akta Kastam 1967; “komputer” mempunyai erti yang diberikan kepadanya di bawah seksyen 3 Akta Keterangan 1950; “Labuan” ertinya Pulau Labuan dan pulau-pulau tanggungannya, iaitu Rusukan Besar, Rusukan Kecil, Keraman, Burong, Papan dan Daat; “Langkawi” ertinya Pulau Langkawi dan semua pulau yang berdampingan dengannya yang terletak lebih hampir dengan Pulau Langkawi daripada tanah besar; “Menteri” ertinya Menteri yang dipertanggungkan dengan tanggungjawab bagi kewangan; “orang kena cukai” ertinya seorang pengilang berdaftar atau pengilang yang bertanggungan untuk berdaftar di bawah seksyen 12; “pegawai cukai jualan” ertinya mana-mana pegawai kastam sebagaimana yang ditakrifkan dalam subseksyen 2(1) Akta Kastam 1967 dan termasuk mana-mana orang yang dilantik atau diambil kerja di bawah subseksyen 4(3); “pegawai cukai jualan yang hak” ertinya mana-mana pegawai kanan cukai jualan atau pegawai cukai jualan yang bertindak dalam menunaikan kewajipannya di bawah Akta ini, sama ada kewajipan itu ditugaskan kepadanya secara khusus atau am, atau secara nyata atau tersirat; “pegawai kanan cukai jualan” ertinya mana-mana pegawai kanan kastam sebagaimana yang ditakrifkan dalam subseksyen 2(1) Akta Kastam 1967; “pengangkut” termasuklah apa-apa vesel, kereta api, kenderaan, pesawat udara atau apa-apa cara pengangkutan lain yang dengannya orang atau barang boleh dibawa; “pengilang” ertinya seseorang yang melibatkan diri dalam pengilangan barang; “pengilang berdaftar” ertinya seorang pengilang yang didaftarkan di bawah seksyen 13 atau 14; “peraturan-peraturan” ertinya peraturan-peraturan yang dibuat di bawah seksyen 106; “perkongsian liabiliti terhad” mempunyai erti yang diberikan kepadanya di bawah seksyen 2 Akta Perkongsian Liabiliti Terhad 2012 [Akta 743]; “perniagaan” termasuklah apa-apa tred, perdagangan atau pengilangan, atau apa-apa usaha daripada jenis tred, perdagangan atau pengilangan; “petroleum” mempunyai erti yang diberikan kepadanya di bawah subseksyen 2(1) Akta Kastam 1967; “surcaj” ertinya surcaj yang disebut dalam subseksyen 32(3); “tarikh efektif” ertinya tarikh yang ditetapkan di bawah subseksyen 1(3); “tempoh bercukai” ertinya apa-apa tempoh sebagaimana yang ditentukan atau diperuntukkan di bawah seksyen 25; “Tioman” ertinya Pulau Tioman dan pulau-pulau Soyak, Rengis, Tumok, Tulai, Chebeh, Labas, Sepoi dan Jahat; “Tribunal Rayuan Kastam” ertinya Tribunal Rayuan Kastam yang ditubuhkan di bawah seksyen 141B Akta Kastam 1967; “zon bebas” mempunyai erti yang diberikan kepadanya di bawah subseksyen 2(1) Akta Zon Bebas 1990 [Akta 438]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_I__cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_I__cl_2__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_I__cl_2__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_I__cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud Akta ini—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_I__cl_2__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_I__cl_2__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "barang hendaklah disifatkan berada di bawah kawalan kastam semasa barang itu didepositkan atau dipegang di dalam mana-mana gudang kastam atau gudang berlesen, pejabat pos, atau di dalam mana-mana pengangkut, saluran paip atau tempat yang daripadanya barang itu tidak boleh dipindahkan kecuali dengan kebenaran pegawai cukai jualan yang hak; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_I__cl_2__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_I__cl_2__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "barang hendaklah disifatkan berada di bawah kawalan eksais semasa barang itu didepositkan atau dipegang di dalam mana-mana kilang penyulingan, kilang bir atau tempat pengilangan lain, atau di dalam mana-mana gudang eksais awam, gudang berlesen, pejabat pos, atau di dalam mana-mana pengangkut, saluran paip atau tempat yang daripadanya barang itu tidak boleh dipindahkan kecuali dengan kebenaran pegawai cukai jualan yang hak. Maksud “mengilang”"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_I__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_I__cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_I__cl_3__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_I__cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_I__cl_3__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_I__cl_3__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_I__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam Akta ini, “mengilang” ertinya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_I__cl_3__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_I__cl_3__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "berhubung dengan barang selain petroleum, penukaran secara manual atau mekanikal bahan-bahan organik atau bukan organik kepada suatu produk baharu dengan mengubah saiz, bentuk, komposisi, sifat atau kualiti bahan-bahan itu dan termasuklah pemasangan bahagian-bahagian ke dalam suatu jentera atau produk lain, tetapi tidak termasuk pemasangan jentera atau kelengkapan bagi maksud pembinaan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_I__cl_3__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_I__cl_3__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "berhubung dengan petroleum, apa-apa proses pemisahan, penulenan, penapisan, penukaran dan pengadunan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_I__cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_I__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika apa-apa persoalan timbul tentang erti “mengilang” di bawah subseksyen (1), persoalan itu hendaklah diputuskan oleh Menteri yang keputusannya adalah muktamad."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_V",
      "@type": "akn:part",
      "eli:number": "V",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_V__cl_21",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_V__cl_22",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_V__cl_23",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_V__cl_24",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_V__cl_25",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/10/msa@/~part_V__cl_26",
