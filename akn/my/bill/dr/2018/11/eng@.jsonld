      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III",
      "@type": "akn:part",
      "eli:number": "III",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_11"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "IMPOSITION AND SCOPE OF SERVICE TAX Imposition and scope of service tax"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_10__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_10__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_10__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_10__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_10__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "Service tax shall be charged and levied at the rate fixed in accordance with subsection (2) on the taxable services by reference to the value of the taxable services provided as determined under section 9."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_10__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_10__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, by order published in the Gazette—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_10__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_10__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "fix the rate of service tax to be charged and levied under this Act; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_10__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_10__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "vary or amend the rate of service tax fixed under paragraph (a)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_10__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_10__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_10__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "Any order made under subsection (2) shall—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_10__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_10__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "be laid before the Dewan Rakyat at the next meeting of the Dewan Rakyat; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_10__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_10__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "at the expiration of one hundred and twenty days from being laid under paragraph (a) or of such extended period as the Dewan Rakyat may, by resolution, direct, cease to have effect in whole if the order is not confirmed, or in part in so far as the order is not confirmed, by a resolution passed by the Dewan Rakyat within the said one hundred and twenty days or, if such period has been extended, within such extended period."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_10__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "Where an order ceases to have effect in whole or in part as provided under subsection (3), any service tax charged and levied in pursuance of the order or such part of the order as ceases to have effect shall, subject to subsections (5) and (6), be refundable to the persons by whom such service tax was paid."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_10__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "Unless the Minister otherwise directs, no service tax refundable under subsection (4) shall be refunded, unless the person by whom the service tax was paid makes a claim in writing to the Director General within one year from the date on which the order ceases to have effect in whole or in part, and the claim shall contain such particulars as the Director General may require."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_10__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General may reduce or disallow any service tax refundable under subsection (4) to the extent that the refund would unjustly enrich the person by whom the service tax was paid. Service tax due"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_11__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_11__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_11__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "The service tax chargeable under section 7 shall be due at the time when payment is received for the taxable service provided to the customer by the registered person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "Where the whole or any part of the payment for any taxable service provided by the registered person is not received from the customer within a period of twelve months from the date of the invoice for the taxable service provided, service tax shall be due on the day following that period of twelve months."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_11__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_11__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_11__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_11__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_11__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_11__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the service tax required to be accounted in any return made under subsection 26(3) shall be due on the day the return is required to be furnished to the Director General;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_11__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_11__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the service tax in respect of betting and gaming which are prescribed to be taxable services shall be due at the time as prescribed;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_11__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_11__subsec_3__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_11__subsec_3__para_c__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_11__subsec_3__para_c__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_11__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "where an arrangement or agreement for the provision of any taxable service is made by any person, who is a taxable person under this Act, within the period beginning from 1 June 2018 and ending immediately before the effective date, and the taxable service is provided or performed on or after the effective date—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_11__subsec_3__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_11__subsec_3__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "the arrangement or agreement for the provision of such taxable service shall be deemed to have been made on the date such taxable service is provided or performed notwithstanding any payment, wholly or partly, is received or invoice is issued, for such taxable service during such period;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_11__subsec_3__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_11__subsec_3__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "any payment received within such period or on or after the effective date, or invoice issued within such period, shall be deemed to have been received or issued on the date such taxable service is provided or performed; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_11__subsec_3__para_c__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_11__subsec_3__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "service tax shall be charged and levied on such taxable service and shall become due on the date such taxable service is provided or performed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_11__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "Where the taxable service referred to in paragraph (3)(c) are betting and gaming, the service tax in respect of such betting and gaming shall be due at the time as prescribed under paragraph (3)(b)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "A tax to be known as service tax shall be charged and levied on any taxable services provided in Malaysia by a registered person in carrying on his business. Taxable service"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may prescribe any service to be a taxable service. Determination of value of taxable service"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_9__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_9__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_9__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_9__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this Act, the value of taxable service on which service tax is payable shall be determined as follows:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_9__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_9__subsec_1__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_9__subsec_1__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_9__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of taxable service for—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_9__subsec_1__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_9__subsec_1__para_a__subpara_i__subpara_A",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_9__subsec_1__para_a__subpara_i__subpara_B"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_9__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "the sale of goods by a taxable person to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_9__subsec_1__para_a__subpara_i__subpara_A",
      "@type": "akn:subparagraph",
      "eli:number": "A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_9__subsec_1__para_a__subpara_i",
      "schema:text": {
        "@language": "en",
        "@value": "a person not connected with the taxable person, the actual price for which the goods are sold; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_9__subsec_1__para_a__subpara_i__subpara_B",
      "@type": "akn:subparagraph",
      "eli:number": "B",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_9__subsec_1__para_a__subpara_i",
      "schema:text": {
        "@language": "en",
        "@value": "a person connected with the taxable person, the price at which the goods would have been sold in the ordinary course of business to a person not connected with the taxable person; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_9__subsec_1__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_9__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "the provision of goods, where the goods are provided for free, the price at which the goods would have been sold in the ordinary course of business to a person not connected with the taxable person;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_9__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_9__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_9__subsec_1__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_9__subsec_1__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_9__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of taxable service, other than the taxable service specified in paragraph (a)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_9__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_9__subsec_1__para_b__subpara_i__subpara_A",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_9__subsec_1__para_b__subpara_i__subpara_B"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_9__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "provided by a taxable person to a person not connected with the taxable person—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_9__subsec_1__para_b__subpara_i__subpara_A",
      "@type": "akn:subparagraph",
      "eli:number": "A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_9__subsec_1__para_b__subpara_i",
      "schema:text": {
        "@language": "en",
        "@value": "the actual value of the taxable service provided; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_9__subsec_1__para_b__subpara_i__subpara_B",
      "@type": "akn:subparagraph",
      "eli:number": "B",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_9__subsec_1__para_b__subpara_i",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of premium for insurance policy, or takaful contribution for takaful certificate, the actual premium or contribution paid;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_9__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_9__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "provided by a taxable person to a person connected with the taxable person, the value of the taxable service which would have been provided in the ordinary course of business to a person not connected with the taxable person; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_9__subsec_1__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_9__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "where the taxable service are provided for free, the value of taxable service which would have been provided in the ordinary course of business to a person not connected with the taxable person; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_9__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_9__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of betting and gaming which are prescribed to be taxable services, the value of such betting and gaming shall be as prescribed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_III__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "For the purpose of this section— “goods” means goods as prescribed; “person connected with the taxable person” means a person connected with the taxable person as prescribed. Rate of service tax"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_3__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_3__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_3__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_3__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General shall have the superintendence of all matters relating to service tax, subject to the direction and control of the Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to the general direction and supervision of the Director General, a senior officer of service tax shall have and exercise all powers conferred on the Director General by or under this Act, other than those conferred under sections 6, 40, 41 and 90."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_3__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "Any person, other than an officer of service tax may be appointed by, or employed with the concurrence of, the Director General for any duty or service relating to service tax and such person shall be deemed to be an officer of service tax for that duty or service."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_3__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General may, by authorization in writing, confer on any officer of service tax not being a senior officer of service tax all or any of the powers of a senior officer of service tax for a period not exceeding ninety days in respect of any one authorization."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_3__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "Any officer of service tax shall have the duties and powers to enforce and ensure due compliance with the provisions of this Act. Persons appointed or employed to be public servants"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "Every person appointed or employed under subsection 3(3) for any duty or service relating to the service tax shall be deemed to be a public servant within the meaning of the Penal Code [Act 574]. Recognition of office"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_5__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_5__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "Every officer of service tax when discharging his duties shall, on demand made by any person, declare his office and produce to the person the authority card or badge prescribed under section 8a of the Customs Act 1967 or in the case of any officer of service tax not being an officer of customs, any other authority card as may be approved by the Director General."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "It shall not be an offence for any person to refuse to comply with any request, demand or order made by any officer of service tax acting or purporting to act under this Act if the officer refuses to declare his office and produce his authority card or badge on demand being made by the person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_5__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_5__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_5__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "Any person, not being an officer of service tax, who unlawfully wears, uses, possesses or displays, otherwise than in the course of a stage play or other theatrical performance—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_5__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_5__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "any uniform prescribed under section 8a of the Customs Act 1967 or any dress having the appearance of, or bearing the distinctive marks of, such uniform; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_5__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_5__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "any prescribed authority card or badge, or authority card as approved by the Director General, referred to in subsection (1), commits an offence and shall, on conviction, be liable to a fine not exceeding fifty thousand ringgit or to imprisonment for a term not exceeding three years or to both. Confidentiality of information"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_6__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_6__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_6__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "Every person, having any official duty or being appointed or employed under this Act, shall regard and deal with all documents, information, returns or declarations relating to the business or value of the provision of services by any taxable person as confidential."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_6__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_6__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subsection (4), every person having possession or control over any document, information, return or declaration or copies thereof in relation to the business or the value of the provision of services by any taxable person, who at any time, otherwise than for the purposes of this Act or with the express authority of the Director General—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_6__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_6__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "communicates or attempts to communicate the information or anything contained in the document, return or declaration or copies thereof to any person; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_6__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_6__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "suffers or permits any person to have access to any information or to anything contained in the document, return or declaration or copies thereof, commits an offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "No person having any official duty or being appointed or employed under this Act or who is referred to in subsection (4) shall be required to produce in any matters or proceedings in any court or tribunal any document, information, return or declaration or to divulge or communicate in the matters or proceedings of any matter or thing, coming under his notice in the performance of his duties under this Act, except as may be necessary for the purposes of carrying into effect the provisions of this Act or in order to institute a prosecution or in the course of a prosecution for any offence committed under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_6__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General may, as he deems fit, transmit or communicate any document, information, return or declaration referred to in subsection (1) or anything contained therein, to the Chief Statistician of the Department of Statistics Malaysia which may be required in the performance of his official duty."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_6__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (4), the Minister may, as he deems fit, allow the Director General to transmit or communicate any document, information, return or declaration referred to in subsection (1) or anything contained therein to any other person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_12",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_13",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_14",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_16",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_17",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_18",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_19",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_20"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "REGISTRATION Liability to be registered"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_12__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_12__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_12__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_12__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_12__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may prescribe—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_12__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_12__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any person who provides any taxable service; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_12__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_12__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the total value of taxable services of the person referred to in paragraph (a), for the purpose of registration of the person under this Part."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_12__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_12__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who provides any taxable service is liable to be registered at the following time, whichever is the earlier:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_12__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_12__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "at the end of any month, where the total value of all his taxable services in that month and the eleven months immediately preceding that month has exceeded the total value of taxable service prescribed under subsection (1); or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_12__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_12__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "at the end of any month, where there are reasonable grounds for believing that the total value of all his taxable services in that month and the eleven months immediately succeeding that month will exceed the total value of taxable services prescribed under subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_12__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (2), the Minister may prescribe that any person who provides taxable services shall be liable to be registered on the date of the commencement of the business."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_12__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_12__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_12__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The total value of all taxable services of a person providing taxable services in the month and the eleven months immediately preceding that month referred to in paragraph (2)(a) shall be disregarded if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_12__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_12__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "the registration of the person providing the taxable services is cancelled, otherwise than under subsection 20(3), during that period; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_12__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_12__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "the Director General is satisfied that before the person’s registration is cancelled, he has given all information required by the Director General in order to determine whether to cancel the registration or not. Application for registration"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_13__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_13__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_13__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_13__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who is liable to be registered under section 12 shall apply to the Director General for registration as a registered person in the prescribed form not later than the last day of the month following the month in which he is liable to be registered as referred to in paragraph 12(2)(a) or (b) or subsection 12(3)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "Upon receipt of the application under subsection (1), the Director General may approve the registration, subject to such conditions as he deems fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_13__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General shall register the person under subsection (1) with effect from the first day of the month following the month in which the application under subsection (1) is made or from such earlier date as may be agreed between the Director General and the person but such date shall not be earlier than the date the person becomes liable to be registered."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_13__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "Where any person fails to comply with subsection (1), the Director General shall register that person on the date as the Director General may determine but not earlier than the date he is liable to be registered under section 12."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_13__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who fails to comply with subsection (1) commits an offence. Voluntary registration"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_14__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who is not liable to be registered under section 12 may apply to the Director General for registration as a registered person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "Upon receipt of the application under subsection (1), the Director General may approve the registration from such date as he may determine subject to such conditions as he deems fit. Direction to treat persons as single taxable person"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_11"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding section 12, where the Director General is satisfied that any separation of business activities is artificial, he may make a direction requiring that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_10",
      "@type": "akn:subsection",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_10__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_10__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_10__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_10__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_10__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "Where any direction is made under subsection (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_10__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_10",
      "schema:text": {
        "@language": "en",
        "@value": "the single taxable person carrying on the business specified in the direction shall be registered in such name as the persons named in the direction may jointly nominate by notice in writing given to the Director General not later than fourteen days after the date the direction is served on the last of such persons named in the direction or, in default of such nomination, in such name as may be specified in the direction;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_10__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_10",
      "schema:text": {
        "@language": "en",
        "@value": "any taxable service provided by one of the constituent members in the course of the activities of the single taxable person shall be treated as being taxable service provided by the single taxable person;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_10__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_10",
      "schema:text": {
        "@language": "en",
        "@value": "each of the constituent members shall be jointly and severally liable for any service tax due and payable by the single taxable person;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_10__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_10",
      "schema:text": {
        "@language": "en",
        "@value": "without prejudice to paragraph (c), any failure by the single taxable person to comply with any requirement imposed under this Act shall be treated as a failure by each of the constituent members severally; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_10__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_10",
      "schema:text": {
        "@language": "en",
        "@value": "subject to paragraphs (a) to (d), the constituent members shall be treated as a partnership carrying on the business of the single taxable person and any question as to the scope of the activities of that business at any time shall be determined accordingly."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_11",
      "@type": "akn:subsection",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_11__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_11__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "Where it appears to the Director General that any person who is one of the constituent members should no longer be regarded as such for the purposes of paragraphs (10)(c) and (d) and the Director General gives notice in writing to that effect, that person—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_11__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_11",
      "schema:text": {
        "@language": "en",
        "@value": "shall not have any liability by virtue of paragraphs (10)(c) and (d) for anything done after the date specified in that notice; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_11__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_11",
      "schema:text": {
        "@language": "en",
        "@value": "on the date as specified in the notice, shall be treated as having ceased to be a member of the partnership referred to in paragraph (10)(e). Registration of partnership"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the persons named in that direction be treated as a single taxable person carrying on the business activities described in that direction with effect from the date as specified in the direction; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the single taxable person referred to in paragraph (a) to be registered with effect from the date as specified in the direction."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of subsection (1), in determining whether any separation of business activities is artificial, regard shall be had to the extent to which the different persons carrying on those business activities are closely bound to one another by financial, economic and organizational links."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General may make a direction under subsection (1) naming any person if the Director General is satisfied that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the person is providing or has provided any taxable service;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the activities in the course of which the person provides or has provided those taxable service form only part of certain activities in the business and that the other activities in that business, whether or not that other activities are similar to the activities carried on by that person, are being carried on concurrently or previously, or both, by one or more other persons; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "if all the taxable services provided in that business were taken into account, the person carrying on that business would, at the time of such direction is made, be required to be registered by virtue of section 12."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "Any direction made under subsection (1) shall be served on each of the persons named in it."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "Where, after a direction had been made under subsection (1), it appears to the Director General that any person who has not been named in that direction is providing any taxable services in the course of activities which should be regarded as part of the business activities, the Director General may make and serve on that person a supplementary direction adding that person’s name to those of the persons named in the direction under subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "Upon the addition of the person’s name in the direction under subsection (5), that person shall be treated as a single taxable person carrying on the business activities described in the direction under subsection (1) with effect from the date as specified in the direction."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "Where, immediately before any direction including a supplementary direction is made, any person named in the direction has been registered in respect of the taxable service provided by him as specified in subsection (3) or (5), his registration shall be revoked by the Director General with effect from the date the single taxable person is registered under subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "Upon the revocation of registration under subsection (7), the person whose registration has been revoked together with all other persons named in the direction under subsection (1) shall be treated as a single taxable person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "In relation to a business specified in a direction, the persons named in such direction together with any person named in a supplementary direction relating to that business, being the persons who together are to be treated as a single taxable person, are referred to as “the constituent members” in subsections (10) and (11)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_16__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_16__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_16__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_16__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_16__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_16__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_16__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_16__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_16__subsec_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_16__subsec_10"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_16__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_16__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_16__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The registration of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_16__subsec_10",
      "@type": "akn:subsection",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this section, a partnership excludes a limited liability partnership. Registration of branches or divisions"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_16__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_16__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "persons carrying on a business in a partnership as a registered person shall be in the name of the firm; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_16__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_16__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the same persons carrying on separate businesses in a partnership as a registered person shall be in the separate names of the respective firms."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "In determining whether taxable services are provided to or by the persons referred to in subsection (1), no account shall be taken of any change in the partnership."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_16__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_16__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_16__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who ceases to be a partner in a partnership shall—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_16__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_16__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "notify the Director General in writing of the date of cessation within thirty days from the date of cessation; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_16__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_16__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "pay for the proportion of the partnership’s liability on any service tax due and payable on any taxable services provided by the partnership until the date of cessation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_16__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "Where any person ceases to be a partner in a partnership under subsection (3) during any taxable period, any notice, whether of assessment or otherwise, which is served on the partnership and relates to the taxable period or to any other taxable period during the whole or part of which he was a partner in the partnership, shall be deemed as to have been served also on him."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_16__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_16__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_16__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding any written law to the contrary, any notice, whether of assessment or otherwise, which is addressed to a partnership by the name in which it is registered under this Act, and is served in accordance with this Act shall be deemed—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_16__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_16__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "as having been properly served on the partnership; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_16__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_16__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "where subsection (4) applies, as having been properly served on any previous partner."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_16__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "Subsections (1) and (3) shall not affect the extent to which a partner is liable for service tax owed by the firm under any other written law."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_16__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "Where a person is a partner in a firm during part only of a taxable period, his liability for service tax on any taxable service provided by the firm during the taxable period shall be the proportion of the firm’s liability as may be just."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_16__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "Where any notice is required to be given by a partnership under this Act, it shall be the joint and several liabilities of all partners to give the notice, except that if a notice is given by any of the partners, it shall be regarded as sufficient compliance with the requirement."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_16__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes paragraph (3)(a) or (b) commits an offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_17__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_17__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_17__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_17__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_17__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "Where any business of a registered person is carried on by one or more branches or divisions, the registered person may apply to the Director General, in the prescribed form, for any of the branches or divisions to be registered in the name of the branch or division."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_17__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_17__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_17__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_17__subsec_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General may approve an application made under subsection (1) subject to such conditions as he deems fit if he is satisfied that the registered person has fulfilled the following requirements:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_17__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_17__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "it is likely to cause real difficulty for the registered person to submit a single return in respect of all the branches or divisions but for the separate registration;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_17__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_17__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "each branch or division maintains a separate account in respect of its activities;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_17__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_17__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "each branch or division is separately identifiable by reference to the nature of the activities carried on by or the location of the branch or division; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_17__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_17__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "each branch or division has the same taxable period."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_17__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_17__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_17__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_17__subsec_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_17__subsec_3__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General may, at any time, by notice in writing to the registered person, cancel the registration approved under subsection (2) in respect of any or all of the branches or divisions if he is satisfied that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_17__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_17__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the registered person has failed to comply with any condition imposed by the Director General under subsection (2);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_17__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_17__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "any of the requirements referred to in subsection (2) has ceased to apply;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_17__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_17__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the registered person has provided any false, misleading or inaccurate declaration or information in his application under subsection (1); or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_17__subsec_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_17__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "it is necessary for the protection of the revenue."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_17__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Director General cancels the registration in accordance with subsection (3), the cancellation shall have effect from the date as the Director General may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_17__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subsection (6), the registered person may apply in writing to the Director General for any branch or division separately registered under subsection (2) to cease to be so registered, and the Director General may cancel the separate registration with effect from the date of application or from such later date as the Director General may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_17__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "A registered person registered under subsection (2) shall remain registered for a period of not less than two years or such other shorter period as the Director General may determine. Cessation of liability to be registered"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_18__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_18__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subsection (2), any registered person shall cease to be liable to be registered at the end of any month where the Director General is satisfied that the total value of all his taxable services in that month and the eleven months immediately succeeding that month (hereinafter referred to as “the period of twelve months”) does not exceed the total value of taxable services prescribed under paragraph 12(1)(b)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "A registered person shall not cease to be liable to be registered by virtue of subsection (1) where the Director General is satisfied that the reason the total value of all his taxable services does not exceed the total value of taxable services prescribed under paragraph 12(1)(b) is that in the period of twelve months referred to in subsection (1) he temporarily ceases providing such taxable services, or suspends providing such taxable services, for a period of thirty days or more. Notification of cessation of liability"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_19__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_19__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_19__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_19__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_19__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "A person registered under section 13 or 14—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_19__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_19__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "who ceases to carry on business of providing taxable services; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_19__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_19__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "who ceases to be liable to be registered under section 18, as the case may be, shall notify the Director General in writing of that fact and the date of cessation within thirty days from the date of cessation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_19__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) commits an offence. Cancellation of registration"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_20__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_20__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_20__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_20__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_20__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "Where a registered person makes a notification under section 19, the Director General may cancel the person’s registration from the date the registered person ceased to provide taxable services or ceased to be liable to be registered under section 18, as the case may be, or from such later date as the Director General may determine if he is satisfied that the registered person can be deregistered."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_20__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "Where there is no notification made under section 19 and the Director General is satisfied that a registered person has ceased to provide taxable services or has ceased to be liable to be registered under section 18, the Director General may cancel his registration from the date the registered person ceased to provide taxable services or ceased to be liable to be registered under section 18, as the case may be, or from such later date as the Director General may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_20__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_20__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_20__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Director General is satisfied that on the day on which a person was registered—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_20__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_20__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of a person who was registered under section 13, the person was not liable to be registered under section 12 or has ceased to provide taxable services; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_20__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_20__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of a person who was registered under section 14, the person was not providing taxable services or has ceased to provide taxable services, the Director General may cancel the registration of such person with effect from the date as determined by the Director General in the notification in writing to such person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_20__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IV__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General may cancel the registration of a registered person under subsection 14(2) if the registered person is in breach of any conditions imposed in relation to such registration with effect from the date of the breach or from such later date as determined by the Director General."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IX",
      "@type": "akn:part",
      "eli:number": "IX",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IX__cl_52",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IX__cl_53",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IX__cl_54",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IX__cl_55",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IX__cl_56"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "SPECIAL PROVISIONS RELATING TO SPECIAL AREAS Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IX__cl_52",
      "@type": "akn:clause",
      "eli:number": "52",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IX",
      "schema:text": {
        "@language": "en",
        "@value": "In this Part, “Malaysia” excludes the special areas and designated areas. Taxable service provided within or between special areas, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IX__cl_53",
      "@type": "akn:clause",
      "eli:number": "53",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IX",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding section 7, no service tax shall be charged and levied on any taxable service provided within or between special areas or between special areas and designated areas unless the Minister otherwise prescribes by order under section 56. Taxable service provided by person whose principal place of business located in special areas"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IX__cl_54",
      "@type": "akn:clause",
      "eli:number": "54",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IX",
      "schema:text": {
        "@language": "en",
        "@value": "Service tax shall be charged by any person whose principal place of business is located in a special area on any taxable service provided by him within Malaysia. Taxable service provided to special areas by registered person whose principal place of business located in Malaysia"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IX__cl_55",
      "@type": "akn:clause",
      "eli:number": "55",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IX",
      "schema:text": {
        "@language": "en",
        "@value": "Service tax shall be charged by any registered person whose principal place of business is located in Malaysia who provides any taxable service to a special area. Power of Minister to impose service tax"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IX__cl_56",
      "@type": "akn:clause",
      "eli:number": "56",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_IX",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, by order published in the Gazette, prescribe any service provided within or between special areas or between special areas and designated areas to be chargeable to service tax."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_I__cl_1__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_I__cl_1__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Service Tax Act 2018."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette and the Minister may appoint different dates for the coming into operation of different parts or different provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_I__cl_1__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (2), the Minister may, by notification in the Gazette, appoint the effective date for the charging and levying of service tax under this Act. Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_I__cl_2__subsec_1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_I__cl_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_I__cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "In this Act, unless the context otherwise requires— “this Act” includes any subsidiary legislation made under this Act; “service tax” means the tax payable under this Act; “prescribed” means prescribed by the Minister in the regulations made under this Act; “document” has the meaning assigned to it under section 3 of the Evidence Act 1950 [Act 56]; “licensed warehouse” means any warehouse or place licensed under section 65 of the Customs Act 1967 [Act 235]; “licensed manufacturing warehouse” means a licensed warehouse in respect of which an additional licence to carry on any manufacturing process has been granted under section 65a of the Customs Act 1967; “designated areas” means Labuan, Langkawi and Tioman; “special areas” means any free zone, licensed warehouse and licensed manufacturing warehouse, and the Joint Development Area; “Joint Development Area” has the meaning assigned to it under section 2 of the Malaysia-Thailand Joint Authority Act 1990 [Act 440]; “customs ruling” means any customs ruling made by the Director General under section 43; “Director General” means the Director General of Customs and Excise appointed under subsection 3(1) of the Customs Act 1967; “computer” has the meaning assigned to it under section 3 of the Evidence Act 1950; “Labuan” means the Island of Labuan and its dependent islands, namely, Rusukan Besar, Rusukan Kecil, Keraman, Burong, Papan and Daat; “Langkawi” means the Island of Langkawi and all adjacent islands lying nearer to Langkawi Island than to the mainland; “Minister” means the Minister charged with the responsibility for finance; “registered person” means a person registered under section 13 or 14; “taxable person” means a registered person or a person who is liable to be registered under section 12; “officer of service tax” means any officer of customs as defined in subsection 2(1) of the Customs Act 1967 and includes any person employed under subsection 3(3); “proper officer of service tax” means any senior officer of service tax or officer of service tax acting in the fulfilment of his duties under this Act, whether such duties are assigned to him specially or generally, or expressly or by implication; “senior officer of service tax” means any senior officer of customs as defined in subsection 2(1) of the Customs Act 1967; “regulations” means regulations made under section 91; “taxable service” means any service which is prescribed to be a taxable service under section 8; “limited liability partnership” has the meaning assigned to it under section 2 of the Limited Liability Partnership Act 2012 [Act 743]; “business” includes any trade, commerce, profession or vocation, or any concern in the nature of trade, commerce, profession or vocation; “surcharge” means the surcharge referred to in subsection 32(3); “effective date” means the date appointed under subsection 1(3); “taxable period” means any period as determined or provided for under section 25; “Tioman” means the Island of Tioman and the islands of Soyak, Rengis, Tumok, Tulai, Chebeh, Labas, Sepoi and Jahat; “Customs Appeal Tribunal” means the Customs Appeal Tribunal established under section 141b of the Customs Act 1967; “free zone” has the meaning assigned to it under subsection 2(1) of the Free Zones Act 1990 [Act 438]."
      }
    },
