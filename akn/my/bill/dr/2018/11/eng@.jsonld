      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII",
      "@type": "akn:part",
      "eli:number": "XIII",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_92",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_93",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_94",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_95"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "SAVINGS AND TRANSITIONAL Registration on the commencement date"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_92",
      "@type": "akn:clause",
      "eli:number": "92",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_92__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_92__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_92__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_92__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_92__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_92",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding section 13, any person who provides services before the effective date which services are taxable services on the effective date shall, within thirty days from the date of the coming into operation of this Act, apply to the Director General to be registered as a registered person if there are reasonable grounds for believing that the total value of his taxable services provided in the month of effective date and eleven months immediately succeeding that month will exceed the total value of taxable services as prescribed in subsection 12(1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_92__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_92",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General shall register the person referred to in subsection (1) with effect from the first day of the month following the month in which the application is made and the person shall charge the service tax on the taxable service provided by the person with effect from such day."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_92__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_92__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_92__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_92",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who provides services before the effective date which services are taxable services on the effective date and has made an application before the effective date to the Director General to be registered as a registered person under this Act—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_92__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_92__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "shall be deemed to have been registered in accordance with section 13 on the effective date, if there are reasonable grounds for believing that the total value of his taxable services provided in the month of the effective date and eleven months immediately succeeding that month will exceed the amount of total value of taxable services as prescribed in subsection 12(1); and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_92__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_92__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "shall charge the service tax on the taxable services provided by the person with effect from the effective date."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_92__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_92__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_92__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_92",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who is registered under the Goods and Services Tax Act 2014 [Act 762] before the effective date and provides taxable services on the effective date—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_92__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_92__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "shall be deemed to have been registered in accordance with section 13 on the effective date, if there are reasonable grounds for believing that the total value of his taxable services provided in the month of the effective date and eleven months immediately succeeding that month will exceed the amount of total value of taxable services as prescribed in subsection 12(1); and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_92__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_92__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "shall charge the service tax on the taxable services provided by the person with effect from the effective date. Progressive or periodic agreement"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_93",
      "@type": "akn:clause",
      "eli:number": "93",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_93__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_93__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_93__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_93__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_93__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_93",
      "schema:text": {
        "@language": "en",
        "@value": "Where any taxable service is provided under an agreement for a period or progressively over a period whether or not at regular intervals and that period begins before 1 June 2018 and ends after the effective date, the proportion of the service which is attributed to the part of the period after the effective date shall be chargeable to service tax."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_93__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_93",
      "schema:text": {
        "@language": "en",
        "@value": "The services provided under subsection (1) shall be taken to be made continuously and uniformly throughout the period of that agreement."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_93__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_93",
      "schema:text": {
        "@language": "en",
        "@value": "Where the services referred to in subsection (1) is provided under a warranty whether expressed, implied or required by law and the value of the warranty is included in the value of the services provided, no service tax shall be charged on the services provided under such warranty."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_93__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_93",
      "schema:text": {
        "@language": "en",
        "@value": "Subsections (1) and (2) shall not apply to a provision of services where goods and services tax under the Goods and Services Tax Act 2014 has been paid on the services to the extent covered by the invoice. Rights granted for life"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_94",
      "@type": "akn:clause",
      "eli:number": "94",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_94__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_94__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_94__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_94__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_94__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_94__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_94",
      "schema:text": {
        "@language": "en",
        "@value": "This section shall apply where—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_94__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_94__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a registered person, who is a club or other similar body, provides taxable services under an agreement;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_94__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_94__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the agreement provides whether expressly or implicitly that a right is to be granted or exercisable for the rest of the person’s life or for a period of not less than thirty years; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_94__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_94__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the rights is granted or first exercisable before the effective date."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_94__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_94__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_94__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_94",
      "schema:text": {
        "@language": "en",
        "@value": "Where any payment for rights granted or exercisable for the rest of the person’s life or for a period of not less than thirty years is paid by existing or new members of a club or other similar body for any rights to use facilities of the club or other similar body, the provision of services on which any payment is made—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_94__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_94__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "before the effective date, shall not be chargeable to service tax; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_94__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_94__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "on or after the effective date, shall be chargeable to service tax. Things done in anticipation of the enactment of this Act"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII__cl_95",
      "@type": "akn:clause",
      "eli:number": "95",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XIII",
      "schema:text": {
        "@language": "en",
        "@value": "All acts and things done by or on behalf of the Director General in preparation for or in anticipation of the enactment of this Act and any expenditure incurred in relation thereto shall be deemed to have been authorized under this Act, provided that the acts and things done are consistent with the general intention and purposes of this Act, and all rights and obligations acquired or incurred as a result of the doing of those acts or things including any expenditure incurred in relation thereto shall upon the coming into operation of this Act be deemed to be the rights and obligations of the Director General."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71",
      "@type": "akn:clause",
      "eli:number": "71",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who, with the intent to evade or assist any other person to evade service tax—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "omits from a return any information in relation to any matter affecting the amount of service tax chargeable by him or other person;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "makes a false statement or entry in any return, claim or application;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "gives any false answer, whether in writing or otherwise, to any question asked or request for information made under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "prepares or maintains, or authorizes the preparation or maintenance of, any false book of accounts, false invoices or other false records, or falsifies or authorizes the falsification of any book of accounts, invoices or records; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "makes, uses or authorizes the use of any fraud, artifice or contrivance, commits an offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who commits an offence under subsection (1) shall, on conviction—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "for the first offence, be liable to a fine of not less than ten times and not more than twenty times the amount of service tax or to imprisonment for a term not exceeding five years or to both; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "for a second or subsequent offence, be liable to a fine of not less than twenty times and not more than forty times the amount of service tax or to imprisonment for a term not exceeding seven years or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of subsection (2), where the amount of service tax cannot be ascertained, the person shall be liable to a fine of not less than fifty thousand ringgit and not more than five hundred thousand ringgit or to imprisonment for a term not exceeding seven years or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who assists in, or advises with respect to, the preparation of any return where the return results in an understatement of the liability for service tax of another person, unless he satisfies the court that the assistance or advice was given with reasonable care, commits an offence and shall, on conviction, be liable to a fine of not less than two thousand ringgit and not more than twenty thousand ringgit or to imprisonment for a term not exceeding three years or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71__subsec_5__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71__subsec_5__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71",
      "schema:text": {
        "@language": "en",
        "@value": "Any reference in paragraph (1)(e) in relation to a person who makes, uses or authorizes the use of any fraud, artifice or contrivance includes a reference to a person who, without the authority of the officer of service tax—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "destroys, damages, erases, alters or manipulates data stored in, or used in connection with, a computer;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71__subsec_5__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71__subsec_5__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "introduces into, or records or stores in, a computer by any means data for the purpose of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71__subsec_5__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71__subsec_5__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "destroying, damaging, erasing, altering or manipulating other data stored in that computer; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71__subsec_5__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71__subsec_5__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "interfering with, interrupting or obstructing the lawful use of that computer, or the data stored in that computer; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71__subsec_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "otherwise uses a computer, the purpose or effect of which is to evade service tax."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of subsection (5), “data” includes any computer programme or part of a computer programme."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_71",
      "schema:text": {
        "@language": "en",
        "@value": "In any prosecution under this section, any evasion of service tax shall be deemed to be with the knowledge of the accused unless the contrary be proved by the accused. Giving incorrect information relating to liability to service tax"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_72",
      "@type": "akn:clause",
      "eli:number": "72",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to any other liability incurred under this Act, any person who gives any incorrect information in relation to any matter affecting his own liability to service tax or the liability of any other person to service tax commits an offence and shall, on conviction, be liable to imprisonment for a term not exceeding three years or to a fine not exceeding fifty thousand ringgit or to both. Improperly obtaining refund"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_73",
      "@type": "akn:clause",
      "eli:number": "73",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_73__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_73__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who causes or attempts to cause the refund by the Director General under subsection 10(4), 35(1) or 38(1) to himself or to any other person of any amount in excess of the amount properly so refundable to him or to that other person commits an offence and shall, on conviction, be liable—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_73__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_73",
      "schema:text": {
        "@language": "en",
        "@value": "to a fine not exceeding fifty thousand ringgit or to imprisonment for a term not exceeding three years or to both; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_73__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_73",
      "schema:text": {
        "@language": "en",
        "@value": "to a penalty of two times the amount refunded in excess of the amount properly so refundable. Employee may transact business"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_74",
      "@type": "akn:clause",
      "eli:number": "74",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_74__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_74__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_74__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_74",
      "schema:text": {
        "@language": "en",
        "@value": "An employee of any person may transact business generally with any proper officer of service tax on behalf of such person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_74__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_74",
      "schema:text": {
        "@language": "en",
        "@value": "A proper officer of service tax may refuse to transact business with such employee unless the person referred to under subsection (1) identifies such employee to such proper officer of service tax as empowered to transact. Transaction of business on behalf of taxable person"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_75",
      "@type": "akn:clause",
      "eli:number": "75",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_75__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_75__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_75__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_75__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_75",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to section 74, no person shall transact any business in relation to this Act on behalf of any taxable person, except on matters with regard to any refund, remission, exemption, or any other matters as approved by the Director General, under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_75__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_75__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_75__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_75",
      "schema:text": {
        "@language": "en",
        "@value": "The person who transacts business on any of the matters stated in subsection (1) on behalf of a taxable person shall—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_75__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_75__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "produce a letter of authorization from the taxable person whom he represents; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_75__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_75__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "where any prescribed form is required to be submitted for the purposes of the matters being transacted, submit the form that has been signed by the taxable person, except where otherwise allowed by a senior officer of service tax."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_75__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_75",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) commits an offence. Offences by authorized and unauthorized persons"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_76",
      "@type": "akn:clause",
      "eli:number": "76",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_76__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_76__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII",
      "schema:name": {
        "@language": "en",
        "@value": "Any person—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_76__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_76__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_76__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_76__para_a__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_76__para_a__subpara_iv"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_76",
      "schema:text": {
        "@language": "en",
        "@value": "being an employee of a taxable person or a person authorized under section 75 who—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_76__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_76__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "withholds for his own use or otherwise any portion of the amount of service tax or penalties collected under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_76__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_76__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "otherwise than in good faith, demands from any person an amount in excess of any assessment of service tax due and payable, or penalties payable, under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_76__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_76__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "submits any false return, statement or report, whether in writing or otherwise, of the amount of service tax or penalty collected or received by him under this Act; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_76__para_a__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_76__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "defrauds any person, embezzles any money, or otherwise uses his position so as to deal wrongfully either with the Director General or any other individual; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_76__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_76",
      "schema:text": {
        "@language": "en",
        "@value": "not being authorized under this Act who collects or attempts to collect any service tax or penalty under this Act, commits an offence and shall, on conviction, be liable to a fine not exceeding fifty thousand ringgit or to imprisonment for a term not exceeding three years or to both. Obstruction"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_77",
      "@type": "akn:clause",
      "eli:number": "77",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who in any way obstructs, assaults or hinders any proper officer of service tax in the discharge of his functions under this Act commits an offence and shall, on conviction, be liable to imprisonment for a term not exceeding five years or to a fine not exceeding one hundred thousand ringgit or to both. Offences by company, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_78",
      "@type": "akn:clause",
      "eli:number": "78",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_78__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_78__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_78__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_78__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_78__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_78",
      "schema:text": {
        "@language": "en",
        "@value": "Where any company, limited liability partnership, firm, society or other body of persons commits an offence under this Act, a person who at the time of the commission of the offence was a director, compliance officer, partner, manager, secretary or other similar officer of the company, limited liability partnership, firm, society or other body of persons or was purporting to act in such capacity or was in any manner or to any extent responsible for the management of any of the affairs of the company, limited liability partnership, firm, society or other body of persons or was assisting in its management—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_78__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_78__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "may be charged severally or jointly in the same proceedings with the company, limited liability partnership, firm, society or other body of persons; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_78__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_78__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_78__subsec_1__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_78__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "if the company, limited liability partnership, firm, society or the body of persons is found guilty of the offence, shall be deemed to be guilty of that offence unless, having regard to the nature of his functions in that capacity and to all circumstances, he proves—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_78__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_78__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "that the offence was committed without his knowledge; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_78__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_78__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "that the offence was committed without his consent or connivance and that he had taken all reasonable precautions and exercised due diligence to prevent the commission of the offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_78__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_78__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_78__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_78__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_78",
      "schema:text": {
        "@language": "en",
        "@value": "Where any person is liable under this Act to any punishment or penalty for any act, omission, neglect or default, such person shall be liable to the same punishment or penalty for every such act, omission, neglect or default of the person’s employee or agent, or of the employee of the person’s agent, if the act, omission, neglect or default was committed—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_78__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_78__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "by that person’s employee in the course of his employment;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_78__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_78__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "by that person’s agent when acting on behalf of that person; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_78__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_78__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "by the employee of that person’s agent when acting in the course of his employment by the person’s agent or otherwise on behalf of the person’s agent acting on behalf of that person. General penalty"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_79",
      "@type": "akn:clause",
      "eli:number": "79",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who commits an offence under this Act for which no penalty is expressly provided shall, on conviction, be liable to a fine not exceeding thirty thousand ringgit or to imprisonment for a term not exceeding two years or to both. Compounding of offences"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_80",
      "@type": "akn:clause",
      "eli:number": "80",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_80__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_80__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_80__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_80__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_80__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_80__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_80__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_80__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_80__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_80",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, with the approval of the Public Prosecutor, make regulations prescribing—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_80__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_80__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any offence under this Act or any regulations made under this Act as an offence which may be compounded;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_80__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_80__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the criteria for compounding such offence; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_80__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_80__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the method and procedure for compounding such offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_80__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_80",
      "schema:text": {
        "@language": "en",
        "@value": "Any senior officer of service tax may, with the consent in writing of the Public Prosecutor, at any time before a charge is being instituted, compound any offence prescribed as an offence which may be compounded by making a written offer to the person reasonably suspected of having committed the offence to compound the offence upon payment to the Director General of a sum of money not exceeding fifty per centum of the amount of the maximum fine to which the person would have been liable to if he had been convicted of the offence, within such time as may be specified in the written offer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_80__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_80",
      "schema:text": {
        "@language": "en",
        "@value": "An offer under subsection (2) may be made at any time after the offence has been committed but before any prosecution for it has been instituted, and where the amount specified in the offer is not paid within the time specified in the offer, or such extended time as the Director General may grant, prosecution for the offence may be instituted at any time after that against the person to whom the offer was made."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_80__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_80",
      "schema:text": {
        "@language": "en",
        "@value": "Where an offence has been compounded under subsection (2), no prosecution shall be instituted in respect of the offence against the person to whom the offer to compound was made, and any document or thing seized in connection with the offence may be released by the Director General, subject to such terms as the Director General thinks fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_80__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_80",
      "schema:text": {
        "@language": "en",
        "@value": "All sums of moneys received by the Director General under this section shall be paid into and form part of the Consolidated Fund. Review and appeal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_81",
      "@type": "akn:clause",
      "eli:number": "81",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_81__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_81__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_81__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_81__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_81__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_81__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_81__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_81",
      "schema:text": {
        "@language": "en",
        "@value": "Any person aggrieved by any decision of the Director General may apply to the Director General for review of any of his decision within thirty days from the date the person has been notified of such decision provided that no appeal has been made on the same decision to the Customs Appeal Tribunal or court."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_81__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_81",
      "schema:text": {
        "@language": "en",
        "@value": "An application for review under subsection (1) shall be made in the prescribed form."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_81__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_81",
      "schema:text": {
        "@language": "en",
        "@value": "Where an application for review has been made under subsection (1), the Director General shall make the review and notify the decision of the review to the person, where practicable, within sixty days from the date of the receipt of such application."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_81__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_81",
      "schema:text": {
        "@language": "en",
        "@value": "No review may be made in any matter relating to compound."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_81__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_81",
      "schema:text": {
        "@language": "en",
        "@value": "Any person aggrieved by any decision of the Director General under subsection (3) or any other provision of this Act, except any matter relating to compound, may appeal to the Customs Appeal Tribunal in writing within thirty days from the date of notification of the decision to the aggrieved person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_81__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_81",
      "schema:text": {
        "@language": "en",
        "@value": "Any service tax due and payable under this Act shall be paid notwithstanding any review or appeal has been made under this section. Liquidator of company to give notice of winding-up, and set aside service tax"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_82",
      "@type": "akn:clause",
      "eli:number": "82",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_82__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_82__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_82__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_82__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_82__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_82__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_82__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_82__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_82",
      "schema:text": {
        "@language": "en",
        "@value": "Where a resolution is passed and becomes effective, or an order is made, for the winding-up of a company which is a registered person, the liquidator of the company shall—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_82__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_82__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "give notice of the winding up of the company to the Director General within fourteen days after the resolution is effective or order is made;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_82__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_82__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "before disposing of any of the assets of the company, set aside such sum out of the assets as appears to the Director General to be sufficient to provide for any service tax that is or will thereafter become due and payable in respect of the company; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_82__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_82__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "pay the service tax referred to in paragraph (b)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_82__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_82",
      "schema:text": {
        "@language": "en",
        "@value": "A liquidator of any company referred to in subsection (1) who fails to give notice to the Director General within the time specified in paragraph (1)(a) or fails to provide for payment of the service tax as required under paragraph (1)(c) shall be personally liable for any service tax that is or will become due and payable as aforesaid."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_82__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_82",
      "schema:text": {
        "@language": "en",
        "@value": "Any liquidator who fails to comply with subsection (1) commits an offence and shall, on conviction, be liable to a fine not exceeding ten thousand ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_82__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_82",
      "schema:text": {
        "@language": "en",
        "@value": "Where two or more persons are appointed as liquidators or are required by law to carry out the winding-up of the company referred to in subsection (1), the obligations and liabilities attaching to a liquidator under this section shall attach to all such persons jointly and severally, subject to a right of contribution between themselves as in cases of contract. Appointment of receiver to be notified to Director General"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_83",
      "@type": "akn:clause",
      "eli:number": "83",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_83__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_83__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_83__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_83__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_83__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_83",
      "schema:text": {
        "@language": "en",
        "@value": "Where a receiver of the property of a registered person is appointed, the receiver shall give notice of such appointment to the Director General within fourteen days thereafter, and shall before disposing of any of the assets of the registered person set aside such sum out of the assets as appears to the Director General to be sufficient to provide for any service tax that is or will thereafter become due and payable in respect of the taxable services provided by the registered person before the appointment of the receiver, and shall pay such service tax."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_83__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_83",
      "schema:text": {
        "@language": "en",
        "@value": "Any receiver appointed under subsection (1) who fails to give notice to the Director General within the time specified in subsection (1) or fails to provide for the payment of the taxable service tax as required under that subsection shall be personally liable for any service tax that is or will become due and payable as aforesaid."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_83__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_83",
      "schema:text": {
        "@language": "en",
        "@value": "Any receiver who fails to comply with subsection (1) commits an offence and shall, on conviction, be liable to a fine not exceeding ten thousand ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_83__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_83",
      "schema:text": {
        "@language": "en",
        "@value": "Where two or more persons are appointed receivers, the obligations and liabilities attaching to a receiver under this section shall attach to all such persons jointly and severally, subject to a right of contribution between themselves as in cases of contract. Registered person to submit audit certificate"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_84",
      "@type": "akn:clause",
      "eli:number": "84",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General may require a registered person to submit annually an audit certificate, signed by a public accountant not in the employment of the registered person, in relation to the records required to be kept by the registered person under section 24 in respect of the taxable services provided by the registered person. Service tax, etc., to be payable notwithstanding any proceedings, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_85",
      "@type": "akn:clause",
      "eli:number": "85",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII",
      "schema:text": {
        "@language": "en",
        "@value": "The institution of proceedings or the imposition of a penalty, fine or term of imprisonment under this Act or the compounding of an offence under section 80 shall not relieve any person from the liability to pay for any service tax, surcharge, penalty, fees or other money under this Act. Service of notices, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_86",
      "@type": "akn:clause",
      "eli:number": "86",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_86__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_86__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_86__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_86__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_86__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_86__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_86__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_86",
      "schema:text": {
        "@language": "en",
        "@value": "Every notice, direction or other document required by this Act to be served on any person may be served—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_86__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_86__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "personally on that person;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_86__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_86__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "by sending it to that person by registered post; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_86__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_86__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "by the electronic service under section 87."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_86__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_86__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_86__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_86",
      "schema:text": {
        "@language": "en",
        "@value": "The notice, direction or other document sent by registered post to a person shall be deemed to have been served on that person at the time at which it would have been delivered to that person in the ordinary course of the post if such notice, direction or other document was addressed—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_86__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_86__subsec_2__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_86__subsec_2__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_86__subsec_2__para_a__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_86__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of a company, limited liability partnership, firm, society or other body of persons—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_86__subsec_2__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_86__subsec_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "to its registered office;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_86__subsec_2__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_86__subsec_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "to its last known address; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_86__subsec_2__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_86__subsec_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "to any person authorized by it to accept service of process; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_86__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_86__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of an individual, to his last known address."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_86__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_86",
      "schema:text": {
        "@language": "en",
        "@value": "Where a person has given his consent for a notice to be served on him through the electronic service, the notice shall be deemed to have been served at the time when the electronic notice is transmitted to his account through the electronic service. Use of electronic service"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_87",
      "@type": "akn:clause",
      "eli:number": "87",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_87__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_87__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_87__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_87__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_87__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_87__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_87__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_87",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding any other provision of this Act and subject to the regulations made under this Act, the Director General may provide an electronic service to any registered user for—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_87__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_87__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the filing or furnishing of any application, return, declaration or any other document; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_87__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_87__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the service of any notice, direction, order, permit, receipt or any other document."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_87__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_87",
      "schema:text": {
        "@language": "en",
        "@value": "Where an electronic notice is made and transmitted to the Director General, the Director General shall not be liable for any loss or damage suffered by the registered user by reason of any error or omission of whatever nature or however arising appearing in any electronic notice obtained by the registered user under the electronic service if the error or omission was made in good faith and in the ordinary course of the discharge of the duties of the Director General or occurred or arose as a result of any defect or breakdown in the electronic service or in the equipment used for the provision of the electronic service."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_87__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_87",
      "schema:text": {
        "@language": "en",
        "@value": "Any electronic notice made and transmitted by the registered user shall be deemed to have been filed, furnished or served at the time the electronic notice is received by the Director General."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_87__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_87",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this section, “registered user” means any person who is authorized in writing by the Director General to gain access to and use the electronic service. Protection of officer of service tax from liability"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_88",
      "@type": "akn:clause",
      "eli:number": "88",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII",
      "schema:text": {
        "@language": "en",
        "@value": "No officer of service tax or other person employed by the Government in the course of carrying out his duties under this Act shall be liable to make good any loss sustained in respect of any goods, documents, articles or things by fire, theft, damage or other causes while the goods, documents, articles or things in the lawful custody or control of the officer or other person employed by the Government in the course of carrying out his duties under this Act unless the loss is caused by his wilful neglect or default. Rewards"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_89",
      "@type": "akn:clause",
      "eli:number": "89",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General may order such rewards as he may deem fit to be paid to any officer of service tax or other person for services rendered in connection with the detection of any offences against this Act. Power of Director General to charge fees"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_90",
      "@type": "akn:clause",
      "eli:number": "90",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_90__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_90__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General may charge such fee as he may consider reasonable in respect of any service rendered by him or any officer of service tax—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_90__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_90",
      "schema:text": {
        "@language": "en",
        "@value": "which is not required to be rendered under this Act; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_90__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_90",
      "schema:text": {
        "@language": "en",
        "@value": "for which no fee is prescribed by any written law. Power to make regulations"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII__cl_91",
      "@type": "akn:clause",
      "eli:number": "91",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XII",
      "schema:text": {
        "@language": "en",
        "@value": "(1) The Minister may make regulations as may be necessary or expedient for the purposes of carrying into effect the provisions of this Act. (2) Without prejudice to the generality of subsection (1), Minister may prescribe— (a) all matters relating to registration of registered person; (b) all matters relating to taxable period; (c) all matters relating to determination of value of taxable service; (d) all matters relating to furnishing returns and payment of service tax; (e) all matters relating to refund and remission of service tax; (f) all matters relating to public ruling and customs ruling; (g) all matters relating to electronic service; (h) all matters relating to invoices, credit notes and debit notes; (i) all matters relating to the offices for the administration of service tax; (j) all fees required by this Act to be prescribed; (k) all forms to be prescribed for the purposes of this Act; or (l) any other matters required by this Act to be prescribed. (2) Any regulations made under this section may prescribe an act or omission in contravention of the regulations to be an offence and may prescribe penalties of a fine not exceeding thirty thousand ringgit or to imprisonment for a term not exceeding two years or both for such offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_64",
      "@type": "akn:clause",
      "eli:number": "64",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding any written law to the contrary, a Sessions Court shall have jurisdiction to try any offence under this Act and to impose punishment under this Act for any such offence. Evidence by certificate, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_65",
      "@type": "akn:clause",
      "eli:number": "65",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_65__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_65__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_65__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_65__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_65__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI",
      "schema:name": {
        "@language": "en",
        "@value": "Any certificate signed by the Director General stating that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_65__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_65",
      "schema:text": {
        "@language": "en",
        "@value": "a person was or was not, on any date, registered under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_65__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_65",
      "schema:text": {
        "@language": "en",
        "@value": "any return has not been furnished or had not been furnished on any date;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_65__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_65",
      "schema:text": {
        "@language": "en",
        "@value": "any service tax shown as due and payable in any return or assessment has not been paid;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_65__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_65",
      "schema:text": {
        "@language": "en",
        "@value": "any penalty and the amount of the penalty shown as due from a person named in the certificate; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_65__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_65",
      "schema:text": {
        "@language": "en",
        "@value": "any public ruling made under section 41 or customs ruling made under section 43, shall be prima facie evidence of the facts stated in the certificate without proof of the signature to the certificate. Obligation of secrecy"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_66",
      "@type": "akn:clause",
      "eli:number": "66",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_66__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_66__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_66__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_66",
      "schema:text": {
        "@language": "en",
        "@value": "Except as provided under section 67, the name, identification card number, passport number and address of an informer, or any other information which can lead to the identity of the informer, and the substance of the information received from an informer shall be kept secret and shall not be disclosed by any officer of service tax or any person who in the ordinary course of his duties comes into possession of, or has control of or access to, the information to any person except the proper officer of service tax."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_66__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_66",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) commits an offence and shall, on conviction, be liable to imprisonment for a term not exceeding seven years or to a fine not exceeding one hundred thousand ringgit or to both. Protection of informers from discovery"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_67",
      "@type": "akn:clause",
      "eli:number": "67",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_67__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_67__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_67__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_67__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_67",
      "schema:text": {
        "@language": "en",
        "@value": "Except as hereinafter provided, no witness in any civil or criminal proceedings shall be obliged or permitted to disclose the name, address or any information of an informer, or the substance of the information received from an informer, or state any matter which might lead to the discovery of the informer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_67__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_67",
      "schema:text": {
        "@language": "en",
        "@value": "If any documents which are produced in evidence or liable to inspection in any civil or criminal proceedings contain any entry in which any informer is named or described or which might lead to his discovery, the court shall cause all the passages to be concealed from view or to be obliterated so far only as may be necessary to protect the informer from discovery."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_67__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_67",
      "schema:text": {
        "@language": "en",
        "@value": "If in the trial for any offence under this Act, the court, after full enquiry into the case, believes that the informer wilfully made in his complaint a material statement which he knew to be false or did not believe to be true, or if in any other proceedings the court is of the opinion that justice cannot fully be done between the parties thereto without the discovery of the informer, it shall be lawful for the court to require the production of the original complaint, if in writing, and permit enquiry and require full disclosure concerning the informer. Burden of proof"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_68",
      "@type": "akn:clause",
      "eli:number": "68",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_68__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_68__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_68__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_68__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI",
      "schema:name": {
        "@language": "en",
        "@value": "Where any dispute arises in any prosecution as to whether—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_68__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_68",
      "schema:text": {
        "@language": "en",
        "@value": "any service tax has been paid;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_68__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_68",
      "schema:text": {
        "@language": "en",
        "@value": "any provision of service is not liable to service tax chargeable under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_68__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_68",
      "schema:text": {
        "@language": "en",
        "@value": "any value upon which service tax is chargeable under this Act; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_68__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_68",
      "schema:text": {
        "@language": "en",
        "@value": "any amount of service tax chargeable under this Act is subject to any deduction, the burden of proof of such dispute shall lie on the accused in the prosecution. Court order"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_69",
      "@type": "akn:clause",
      "eli:number": "69",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_69__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_69__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_69__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_69__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_69",
      "schema:text": {
        "@language": "en",
        "@value": "Where any person is found guilty of an offence under this Act, the court before which that person is found guilty shall order the person to pay to the Director General the amount of service tax due and payable or penalty payable, under this Act, if any, as certified by the Director General and such service tax or penalty shall be recoverable in the same manner as a fine as provided under section 283 of the Criminal Procedure Code [Act 593]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_69__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_69",
      "schema:text": {
        "@language": "en",
        "@value": "In addition to subsection (1), the court has civil jurisdiction to the extent of the amount of service tax due and payable or penalty payable and the order is enforceable in all respects as a final judgement of the court in favour of the Director General."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_69__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_69",
      "schema:text": {
        "@language": "en",
        "@value": "Where any person is found not guilty of an offence under this Act, and if he has paid the amount of service tax due and payable or penalty payable under this Act pursuant to section 85 in respect of the offence charged, the court may order the amount paid to be refunded to such person where no notice of appeal is filed. No costs or damages arising from seizure to be recoverable unless seizure without reasonable or probable cause"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI__cl_70",
      "@type": "akn:clause",
      "eli:number": "70",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_XI",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall, in any proceedings before any court in respect of the seizure of any goods, documents, articles or things in exercise or the purported exercise of any power conferred under this Act, be entitled to the costs of the proceedings or to any damages or other relief, other than an order for the return of such goods, documents, articles or things or the payment of the value of such goods, documents, articles or things, unless such seizure was made without reasonable or probable cause."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_57",
      "@type": "akn:clause",
      "eli:number": "57",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_57__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_57__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_57__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_57__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_57__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_57",
      "schema:text": {
        "@language": "en",
        "@value": "Every person having information about any matter into which it is the duty of the proper officer of service tax to inquire shall, upon being required by the officer to do so, give such information."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_57__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_57__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_57__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_57",
      "schema:text": {
        "@language": "en",
        "@value": "Every person required by the proper officer of service tax to produce any goods, documents, articles or things which are within the power of such person to produce, and which are—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_57__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_57__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "goods, documents, articles or things used in any transaction or other matter relating to service tax; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_57__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_57__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "goods, documents, articles or things into which it is the duty of the proper officer of service tax to inquire under this Act, shall produce such goods, documents, articles or things."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_57__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_57",
      "schema:text": {
        "@language": "en",
        "@value": "Where any information, goods, documents, articles or things are not in the national language or English language, any proper officer of service tax may by notice in writing require the person or any other person to produce within a reasonable period a translation of the information, goods, documents, articles or things in the national language or English language as the proper officer of service tax may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_57__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_57__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_57__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_57",
      "schema:text": {
        "@language": "en",
        "@value": "Any person—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_57__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_57__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "who contravenes subsection (1) or (2); or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_57__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_57__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "who fails to produce a translation as required under subsection (3), commits an offence. Access to places or premises"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_58",
      "@type": "akn:clause",
      "eli:number": "58",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_58__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_58__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_58__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_58__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_58__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_58__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_58",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this Act, any senior officer of service tax shall at all times have access to any place or premises where a person providing services carries on his business."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_58__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_58",
      "schema:text": {
        "@language": "en",
        "@value": "Where any senior officer of service tax exercises his powers under subsection (1), the person who carries on his business or any other person present at the place or premises at that time of entry shall provide to the officer all reasonable facilities and assistance for the exercise of his duties under this section."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_58__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_58__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_58__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_58__subsec_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_58__subsec_3__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_58__subsec_3__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_58__subsec_3__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_58",
      "schema:text": {
        "@language": "en",
        "@value": "Where any senior officer of service tax enters upon any place or premises in accordance with this section, he may—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_58__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_58__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "require the person providing services who carries on his business at such place or premises or any other person present at such place or premises, as the case may be, to produce any goods, documents, articles or things, which such person is required to keep under the provisions of this Act, or which relates to any taxable service;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_58__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_58__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "examine any goods, documents, articles or things and take copies of any documents;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_58__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_58__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "seize and detain any goods, documents, articles or things which, in his opinion, may afford evidence of the commission of any offence under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_58__subsec_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_58__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "require the person providing services who carries on his business at such place or premises or any other person present at such place or premises, or any person employed by such person to answer questions relating to any goods, documents, articles or things, or any entry in any documents, or any taxable service;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_58__subsec_3__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_58__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "require any container, envelope or other receptacle in such place or premises to be opened; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_58__subsec_3__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_58__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "at the risk and expense of the person providing services who carries on his business at such place or premises or any other person present at such place or premises, open and examine any package, or any goods or materials, in such place or premises."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_58__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_58",
      "schema:text": {
        "@language": "en",
        "@value": "Where the senior officer of service tax acting under this section is unable to obtain access to any place or premises where a person providing services carries on his business, or to any receptacle contained in the place or premises, he may, at any time, enter such place or premises, and open such receptacle in such manner, if necessary by force, as he may think necessary."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_58__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_58",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (2) commits an offence. Access to recorded information or computerized data"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_59",
      "@type": "akn:clause",
      "eli:number": "59",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_59__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_59__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_59__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_59__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_59",
      "schema:text": {
        "@language": "en",
        "@value": "Any senior officer of service tax exercising his powers under sections 58, 60 and 61 shall be given access to any recorded information or computerized data, whether stored in a computer or otherwise."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_59__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_59__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_59__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_59",
      "schema:text": {
        "@language": "en",
        "@value": "In addition, a senior officer of service tax exercising his powers under sections 58, 60 and 61—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_59__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_59__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "may inspect the operation of any computer and any associated apparatus or material which he has reasonable cause to suspect is or has been used in connection with the information or data; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_59__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_59__subsec_2__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_59__subsec_2__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_59__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "may require—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_59__subsec_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_59__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "the person by whom or on whose behalf the senior officer of service tax has reasonable cause to suspect the computer is or has been so used in connection with the information or data; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_59__subsec_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_59__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "the person having charge of, or is otherwise concerned with, the operation of the computer, apparatus or material in connection with the information or data, to provide the officer with such reasonable assistance as he may require for the purpose of this section."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_59__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_59",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of subsection (1), “access” includes being provided with the necessary password, encryption code, decryption code, software or hardware and any other means required to enable comprehension of recorded information or computerized data. Magistrate may issue search warrant"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_60",
      "@type": "akn:clause",
      "eli:number": "60",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_60__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_60__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_60__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_60__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_60__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_60",
      "schema:text": {
        "@language": "en",
        "@value": "Whenever it appears to any Magistrate, upon written information upon oath and after any inquiry which he may think necessary, that there is reasonable cause to believe that in any place, premises or conveyance, there are concealed or deposited any goods, documents, articles or things which may afford evidence of the commission of an offence under this Act, the Magistrate may issue a warrant authorizing any senior officer of service tax named therein, at any time and with or without assistance—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_60__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_60__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to enter the place, premises or conveyance and to search for and seize the goods, documents, articles or things; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_60__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_60__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to arrest any person being in the place, premises or conveyance in whose possession the goods, documents, articles or things are found or who may reasonably be suspected as having concealed or deposited such goods, documents, articles or things."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_60__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_60__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_60__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_60__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_60",
      "schema:text": {
        "@language": "en",
        "@value": "The senior officer of service tax authorized under subsection (1) may, if it is necessary so to do—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_60__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_60__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "break open any outer or inner door of the place, premises or conveyance and enter every part thereof, if necessary forcibly;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_60__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_60__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "remove by force any obstruction to the entry to search or to seize as he is empowered to effect; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_60__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_60__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "detain every person found in the place, premises or conveyance until the search has been completed. Search may be made without warrant"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_61",
      "@type": "akn:clause",
      "eli:number": "61",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X",
      "schema:text": {
        "@language": "en",
        "@value": "Whenever it appears to the senior officer of service tax that there is reasonable cause to believe that in any place, premises or conveyance there are concealed or deposited any goods, documents, articles or things which may afford evidence of the commission of any offence under this Act and if he has reasonable grounds for believing that by reason of the delay in obtaining a search warrant the goods, documents, articles or things are likely to be removed, he may exercise in, upon and in respect of the place, premises or conveyance, all the powers under section 60 in the same manner as if he was empowered so to do by a warrant issued under that section. Seizure of goods, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_62",
      "@type": "akn:clause",
      "eli:number": "62",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_62__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_62__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_62__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_62__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_62__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_62__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_62__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_62",
      "schema:text": {
        "@language": "en",
        "@value": "Any proper officer of service tax may seize in any place any of the following:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_62__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_62__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "all goods, documents, articles or things in respect of which the proper officer of service tax has reasonable cause to suspect that there has been committed any offence under this Act, any violation of any of the provisions of this Act, or any breach of any condition subject to which a registration has been approved under sections 13 and 14; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_62__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_62__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any other goods, documents, articles or things which may reasonably be believed to have a bearing on the offence, violation or breach referred to in paragraph (a)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_62__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_62",
      "schema:text": {
        "@language": "en",
        "@value": "Whenever any goods, documents, articles or things are seized under this Act, the proper officer of service tax shall forthwith give notice in writing of such seizure and the grounds of the seizure to the owner of the goods, documents, articles or things, if known, either by delivering such notice to him personally or by post at his place of abode."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_62__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_62",
      "schema:text": {
        "@language": "en",
        "@value": "The provisions of this section relating to the seizure of any goods, documents, articles or things shall apply to all contents of any receptacles or packages in which the goods, documents, articles or things are found, and to any articles used to conceal the goods, documents, articles or things."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_62__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_62__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_62__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_62",
      "schema:text": {
        "@language": "en",
        "@value": "Where a senior officer of service tax is satisfied that the goods, documents, articles or things seized are not required for the purposes of investigation, prosecution or any proceedings under this Act, he may release the goods, documents, articles or things to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_62__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_62__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "the owner of the goods, documents, articles or things; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_62__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_62__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "the person from whose possession, custody or control, the goods, documents, articles or things were seized. Power of arrest"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63",
      "@type": "akn:clause",
      "eli:number": "63",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63",
      "schema:text": {
        "@language": "en",
        "@value": "Any proper officer of service tax may arrest without warrant—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any person found committing or attempting to commit, or employing or aiding any person to commit, or abetting the commission of, an offence under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any person whom he may reasonably suspect to have in his possession any goods, documents, articles or things liable to seizure under this Act; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any person whom he may reasonably suspect to have committed an offence under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63",
      "schema:text": {
        "@language": "en",
        "@value": "The proper officer of service tax may search or cause to be searched any person arrested under subsection (1) provided that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "any person who requests that his person be searched in the presence of a senior officer of service tax shall not be searched except in the presence of and under the supervision of such senior officer of service tax, but such person may be detained until the arrival of such senior officer of service tax, or taken to any office or police station where such senior officer of service tax may be found;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the goods and baggage of the person who requests to be present when the goods and baggage are searched and so presents himself within a reasonable time shall not be searched except in his presence; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "no person shall be searched except by another person of the same gender, and such search shall be conducted with strict regard to decency."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63",
      "schema:text": {
        "@language": "en",
        "@value": "Any proper officer of service tax making an arrest under subsection (1) shall, without unnecessary delay, bring the person arrested to the nearest police station, and thereafter the person shall be dealt with in accordance with the law relating to criminal procedure for the time being in force."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63",
      "schema:text": {
        "@language": "en",
        "@value": "If any person liable to be arrested under this Act is not arrested at the time of committing the offence for which he is so liable, or after arrest makes his escape, he may at any time thereafter be arrested and dealt with as if he had been arrested at the time of committing such offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63",
      "schema:text": {
        "@language": "en",
        "@value": "Any proper officer of service tax may cause to be taken photographs, finger and thumb impressions and any other form of identification that may be required under any other written law of any person charged with an offence against this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63__subsec_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63__subsec_6__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63__subsec_6__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63",
      "schema:text": {
        "@language": "en",
        "@value": "Every person so arrested may be released from custody—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63__subsec_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "on his depositing such reasonable sum of money as the proper officer of service tax may require;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63__subsec_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "on his executing a bond, with such surety or sureties, as the proper officer of service tax may require; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63__subsec_6__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "on his depositing such reasonable sum of money as the proper officer may require and his executing a bond, with such surety or sureties, as the proper officer of service tax may require."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63__subsec_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63__subsec_7__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who has been released from custody under subsection (6) may be arrested without warrant by any proper officer of service tax—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63__subsec_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "if such officer has reasonable grounds for believing that any conditions subject to which such person was released or otherwise admitted to bail has been or is likely to be breached; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63__subsec_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/11/eng@/~part_X__cl_63__subsec_7",
      "schema:text": {
        "@language": "en",
        "@value": "on being notified in writing by the surety of such person that such person is likely to breach any conditions subject to which such person was released and that the surety wishes to be relieved of his obligation as surety."
      }
    }
  ]
}
