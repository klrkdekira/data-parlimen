      "schema:text": {
        "@language": "en",
        "@value": "by deleting the proviso; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/12/eng@/~cl_3__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/12/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (7) the following subsection: “(8) Notwithstanding subsection (7), a senior officer of customs may refuse to transact business with such employee unless such person or firm has furnished a signed authority authorizing such employee to transact business on behalf of such person or firm.”. Amendment of section 141c"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/12/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/12/eng@/~cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/12/eng@/~cl_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/12/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 141c of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/12/eng@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/12/eng@/~cl_4__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/12/eng@/~cl_4__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/12/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/12/eng@/~cl_4__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/12/eng@/~cl_4__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (a), by substituting for the words “a Chairman and a Deputy Chairman” the words “a Chairman and not more than two Deputy Chairmen”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/12/eng@/~cl_4__para_a__subpara_ii",
      "@type": "akn:subparagraph",
