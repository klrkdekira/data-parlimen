      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/13/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Free Zones (Amendment) Act 2018. (2) This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Amendment of section 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/13/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/13/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Free Zones Act 1990 [Act 438], which is referred to as the “principal Act” in this Act, is amended in subsection 2(1) by deleting the definitions of “sales tax”, “service” and “service tax”."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/13/eng@/~cl_3",
      "@type": "akn:clause",
