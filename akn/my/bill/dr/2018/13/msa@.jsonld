      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/13/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan “dan perkhidmatan”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/13/msa@/~cl_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/13/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “, dihasilkan atau dibekalkan” dengan perkataan “atau dihasilkan”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/13/msa@/~cl_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/13/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “, duti eksais, cukai jualan atau cukai perkhidmatan” dengan perkataan “atau duti eksais”. Pindaan seksyen 6"
      }
    },
    {
