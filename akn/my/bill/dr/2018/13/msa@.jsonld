      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 21 Akta ibu dipinda dengan memotong perkataan “, Akta Cukai Jualan 1972, Akta Cukai Perkhidmatan 1975”. Pindaan seksyen 22"
      }
    },
    {
