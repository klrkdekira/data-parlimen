      "schema:text": {
        "@language": "ms",
        "@value": "dalam nota bahu, dengan memotong perkataan “dan perkhidmatan”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/13/msa@/~cl_3__para_b",
      "@type": "akn:paragraph",
