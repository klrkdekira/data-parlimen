      ],
      "schema:name": {
        "@language": "en",
        "@value": "Anti-Fake News (Repeal) Bill 2018"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/14/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/14/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Anti-Fake News (Repeal) Act 2018. Repeal and savings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/14/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/14/eng@/~cl_2__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/14/eng@/~cl_2__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/14/eng@/~cl_2__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/14/eng@/~cl_2__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/14/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/14/eng@/~cl_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/14/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "The Anti-Fake News Act 2018 [Act 803] is repealed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/14/eng@/~cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/14/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "The repeal of the Anti-Fake News Act 2018 shall not affect any order made under the repealed Act prior to the date of coming into operation of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/14/eng@/~cl_2__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/14/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "On the date of coming into operation of this Act, any application for an order under the repealed Act made prior to the date of coming into operation of this Act or any proceedings in respect of such application pending under the repealed Act may be continued as if the repealed Act is still in force."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/14/eng@/~cl_2__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/14/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "On the date of coming into operation of this Act, any investigation, prosecution or proceedings in respect of any offence under the repealed Act pending under the repealed Act may be continued as if the repealed Act is still in force."
      }
    }
  ]
}
