      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/15/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Purpose Title B. 10 Treasury B. 11 Treasury General Services B. 15 Ministry of Economic Affairs B. 22 Ministry of Rural Development B. 23 Ministry of Water, Land and Natural Resources B. 26 Ministry of Entrepreneur Development B. 28 Ministry of Transport B. 30 Ministry of Energy, Science, Technology, Environment and Climate Change B. 32 Ministry of Territories B. 43 Ministry of Housing and Local Government Purpose Title B. 45 Ministry of Youth and Sports B. 46 Ministry of Human Resources B. 47 Ministry of Communications and Multimedia B. 62 Ministry of Home Affairs B. 63 Education ToTal"
      }
