      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/15/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Supply (Reallocation of Appropriated Expenditure) Act 2018."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/15/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/15/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act is deemed to have come into operation on 2 July 2018. Reallocation of appropriated expenditure for the year 2018"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/15/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/15/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The issue is hereby authorized of a sum not exceeding three billion sixty-five million one hundred and thirteen thousand and eight hundred and ninety-six ringgit (RM3,065,113,896) from the Consolidated Fund for expenditure on the services and purposes specified in the Schedule for the year 2018 not provided for or not fully provided for by the Supply Act 2018 [Act A1557]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/15/eng@/~sched_1",
