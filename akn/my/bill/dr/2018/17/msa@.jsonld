      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan “dan kaedah-kaedah yang dibuat di bawah seksyen 253”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_79__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
