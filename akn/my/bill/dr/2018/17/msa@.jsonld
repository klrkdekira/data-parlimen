      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1) dan (5), dengan menggantikan perkataan “seorang pegawai dilantik” dengan perkataan “seorang pegawai pengangkutan awam darat atau pegawai pengangkutan jalan”; dan"
      }
    },
