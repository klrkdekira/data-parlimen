      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perenggan (a) dengan perenggan yang berikut: “(a) Ketua Pengarah Pengangkutan Awam Darat atau mana-mana pegawai pengangkutan awam darat;”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_72__para_a__subpara_ii",
