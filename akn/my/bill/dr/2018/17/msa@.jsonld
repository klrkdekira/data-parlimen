      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (8), dengan menggantikan perkataan “kaedah-kaedah yang dibuat oleh Suruhanjaya di bawah perenggan 253(1)(aa)” dengan perkataan “peraturan-peraturan yang dibuat di bawah perenggan 252(1)(ty)”; dan"
      }
    },
