    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 14(1) Akta ibu dipinda dengan menggantikan perkataan “Suruhanjaya” dengan perkataan “Menteri”. Pemotongan seksyen 15"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memotong seksyen 15. Pindaan seksyen 23"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan 23(1)(a) Akta ibu dipinda dengan memasukkan selepas perkataan “Ketua Pengarah” perkataan “Pengangkutan Jalan”. Pindaan seksyen 33"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 33 Akta ibu dipinda dengan memotong perkataan “Menteri yang bertanggungjawab bagi pengangkutan dan”. Pindaan seksyen 42"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan 42(1)(a) Akta ibu dipinda dengan memasukkan selepas perkataan “Ketua Pengarah” perkataan “Pengangkutan Jalan”. Pindaan seksyen 58"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan 58(1)(a) Akta ibu dipinda dengan memasukkan selepas perkataan “Ketua Pengarah” perkataan “Pengangkutan Jalan”. Pindaan seksyen 69"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_16__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_16__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 69 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_16__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2), dengan menggantikan perkataan “Suruhanjaya” dengan perkataan “Menteri”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_16__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “kaedah-kaedah” di mana-mana jua terdapat dengan perkataan “peraturan-peraturan”. Pindaan seksyen 71"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 71(1) Akta ibu dipinda dengan menggantikan perkataan “kaedah-kaedah yang dibuat oleh Suruhanjaya di bawah perenggan 253(1)(mm)” di mana-mana jua terdapat dengan perkataan “peraturan-peraturan yang dibuat di bawah perenggan 252(1)(tak)”. Pindaan seksyen 72"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan 72(1)(b) Akta ibu dipinda dengan menggantikan perkataan “oleh mana-mana Entiti Kerajaan” dengan perkataan “di bawah mana-mana undang-undang bertulis”. Pindaan seksyen 73"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 73(1) Akta ibu dipinda dengan memasukkan selepas perkataan “Ketua Pengarah” perkataan “Pengangkutan Jalan”. Pindaan seksyen 74"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Pengangkutan Awam Darat (Pindaan) 2018."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta. Pindaan am"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Pengangkutan Awam Darat 2010 [Akta 715], yang disebut “Akta ibu” dalam Akta ini, dipinda dengan menggantikan perkataan “Suruhanjaya” di mana-mana jua terdapat termasuk dalam nota bahu dengan perkataan “Ketua Pengarah Pengangkutan Awam Darat” kecuali dalam subseksyen 11(1), subseksyen 12f(1), subseksyen 14(1), subseksyen 69(2), subseksyen 71(1), subseksyen 74(1), (2) dan (4), subseksyen 83(5), perenggan 84(2)(a), subseksyen 97(4), subseksyen 101(3), subseksyen 111(1), subseksyen 112(1), perenggan 112(3)(a), subseksyen 112(4), subseksyen 117(8) dan (11), subseksyen 128(4), seksyen 149, seksyen 211, seksyen 228, seksyen 235, seksyen 238, subseksyen 252(1) dan seksyen 255. Pindaan seksyen 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
