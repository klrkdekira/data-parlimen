      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_20__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_20__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “yang dibenarkan oleh Suruhanjaya, memberi Suruhanjaya” dengan perkataan “yang dibenarkan oleh Ketua Pengarah Pengangkutan Awam Darat, memberi Ketua Pengarah Pengangkutan Awam Darat”;"
