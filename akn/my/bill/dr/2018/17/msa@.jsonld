      "schema:text": {
        "@language": "ms",
        "@value": "dalam takrif “undang-undang pengangkutan awam darat”, dengan menggantikan perkataan “Akta Suruhanjaya Pengangkutan Awam Darat 2010” dengan perkataan “Akta Pengangkutan Jalan 1987”. Pemotongan Bab 1 Bahagian II"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memotong Bab 1 Bahagian II. Pindaan seksyen 11"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan 113(1)(e) Akta ibu dipinda dengan menggantikan perkataan “oleh mana-mana Entiti Kerajaan” dengan perkataan “di bawah mana-mana undang-undang bertulis”. Pindaan seksyen 117"
      }
    },
    {
