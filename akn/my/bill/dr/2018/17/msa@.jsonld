      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memotong seksyen 256, 257 dan 258. Kecualian"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_82",
      "@type": "akn:clause",
      "eli:number": "82",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_82__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_82__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_82__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_82__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_82__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_82__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_82__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_82__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_82",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa tindakan atau keputusan yang dibuat, atau pendaftaran, perintah, arahan, pekeliling, garis panduan, arahan atau kelulusan yang diberikan di bawah, atau mengikut, atau menurut kuasa Akta ibu oleh Suruhanjaya, sebelum tarikh permulaan kuat kuasa Akta ini hendaklah disifatkan sebagai telah dibuat atau diberikan di bawah, atau mengikut, atau menurut kuasa, Akta ini oleh Ketua Pengarah Pengangkutan Awam Darat, dan hendaklah terus berkuat kuasa berhubung dengan orang yang perkara itu terpakai baginya sehingga dibatalkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_82__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_82",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pegawai dilantik yang dilantik di bawah Akta ibu sebelum tarikh permulaan kuat kuasa Akta ini hendaklah terus menjadi pegawai pengangkutan awam darat di bawah Akta ini sehingga pelantikan pegawai dilantik itu dibatalkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_82__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_82",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa lesen yang dikeluarkan oleh Suruhanjaya sebelum tarikh permulaan kuat kuasa Akta ini hendaklah disifatkan telah dikeluarkan oleh Ketua Pengarah Pengangkutan Awam Darat dan hendaklah terus berkuat kuasa berhubung dengan orang yang perkara itu terpakai baginya sehingga dibatalkan atau sehingga tarikh habis tempohnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_82__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_82",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa permohonan bagi suatu lesen yang belum selesai pada tarikh permulaaan kuat kuasa Akta ini hendaklah diuruskan di bawah Akta ibu sebagaimana yang dipinda oleh Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_82__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_82",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa tindakan, penyiasatan atau prosiding yang dimulakan atau yang belum selesai sebaik sebelum tarikh permulaan kuat kuasa Akta ini hendaklah, selepas tarikh permulaan kuat kuasa Akta ini, diteruskan seolah-olah Akta ibu tidak dipinda oleh Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_82__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_82",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa obligasi, liabiliti, penalti atau hukuman yang terakru atau dikenakan di bawah Akta ibu, boleh diteruskan, dikuatkuasakan, dikenakan dan diuruskan, mengikut mana-mana yang berkenaan, seolah-olah Akta ibu tidak dipinda oleh Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_82__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_82",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua wang yang ada pada, atau kena dibayar kepada, Kumpulan Wang Pengangkutan Awam Darat, pada tarikh permulaan kuat kuasa Akta ini, hendaklah dipindahkan kepada Kerajaan. Rancangan Induk Pengangkutan Awam Darat Negara"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_83",
      "@type": "akn:clause",
      "eli:number": "83",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa dasar atau perancangan termasuk Rancangan Induk Pengangkutan Awam Darat Negara yang dibuat oleh Suruhanjaya, pada tarikh permulaan kuat kuasa Akta ini, dibatalkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 13 Akta ibu dipinda dengan memotong subseksyen (7). Pindaan seksyen 14"
      }
    }
  ]
}
