      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 74 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_20__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
