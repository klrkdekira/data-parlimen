      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 254 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/17/msa@/~cl_79__para_a",
