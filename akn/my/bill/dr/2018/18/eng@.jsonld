      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/eng@/~cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/eng@/~cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "All applications or other matters which are pending approval under the principal Act shall, on the date of coming into operation of this Act, be continued as if the principal Act had not been amended by this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/eng@/~cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/eng@/~cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "Any order or proceedings which is pending under the principal Act shall, before the date of coming into operation of this Act, continued as if the principal Act had not been amended by this Act."
      }
    }
