      ],
      "schema:name": {
        "@language": "ms",
        "@value": "RUU Jalan, Parit dan Bangunan (Pindaan) 2018"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_1__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_1__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_1__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Jalan, Parit dan Bangunan (Pindaan) 2018."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri berhubung dengan sesuatu Negeri, selepas berunding dengan Pihak Berkuasa Negeri itu, melalui pemberitahuan dalam Warta dan Menteri boleh, selepas berunding dengan Pihak Berkuasa Negeri, menetapkan tarikh yang berlainan bagi permulaan kuat kuasa Akta ini di kawasan pihak berkuasa tempatan yang berlainan atau bahagian-bahagian kawasan pihak berkuasa tempatan yang berlainan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_1__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa di Wilayah Persekutuan Kuala Lumpur, Wilayah Persekutuan Putrajaya dan Wilayah Persekutuan Labuan pada tarikh yang ditetapkan oleh Menteri yang bertanggungjawab bagi Wilayah Persekutuan Kuala Lumpur, Wilayah Persekutuan Putrajaya dan Wilayah Persekutuan Labuan melalui pemberitahuan dalam Warta."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_1__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_1__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_1__subsec_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_1__subsec_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (3), Pihak Berkuasa Negeri boleh, melalui pemberitahuan dalam Warta—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_1__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_1__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "mengecualikan mana-mana bahagian mana-mana kawasan pihak berkuasa tempatan daripada mana-mana peruntukan Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_1__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_1__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "meluaskan mana-mana atau kesemua peruntukan Akta ini supaya terpakai bagi keseluruhan atau mana-mana kawasan atau bahagian mana-mana kawasan dalam Negeri itu yang bukan di bawah mana-mana pihak berkuasa tempatan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_1__subsec_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_1__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat apa-apa ubah suaian, pindaan atau perubahan kepada peruntukan Akta ini sebagaimana yang perlu bagi maksud pemakaiannya di bawah perenggan (b). Pindaan seksyen 3"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Jalan, Parit dan Bangunan 1974 [Akta 133], yang disebut “Akta ibu” dalam Akta ini, dipinda dalam seksyen 3—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif “betung” takrif yang berikut: ‘ “cerun” ertinya kecerunan permukaan tanah atau batu sama ada dibina atau wujud secara semula jadi termasuk apa-apa binaan yang melawan daya dan momen cerun itu;’; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif “cerun” takrif yang berikut: ‘ “geoteknikal” ertinya bidang kejuruteraan berhubung dengan sifat tanah dan batuan yang termasuklah jenis, keadaan, profil, reka bentuk struktur, penstabilan cerun dan kerja-kerja pemantauan lain berkaitan dengan sifat tanah dan batuan itu;’. Pindaan seksyen 39"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 39 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1), dengan menggantikan perkataan “lima ratus” dengan perkataan “lima puluh ribu”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_3__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_3__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_3__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_3__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan “dengan sengaja”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_3__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_3__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “satu ribu” dengan perkataan “satu ratus ribu”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (2) subseksyen yang berikut: “(3) Walau apa pun subseksyen (1) dan (2), pihak berkuasa tempatan boleh memberi notis secara bertulis untuk mengarahkan orang itu untuk membetulkan pengalihan, mengambil tempat atau membuat apa-apa perubahan kepada turap, papak atau bahan lain jalan awam atau pagar atau tiang-tiang jalan awam itu atau melaksanakan apa-apa pembaikan bagi kerosakan yang dilakukan pada jalan, siar kaki, jalan kaki lima, kerja atau harta, atau mana-mana bahagiannya. (4) Mana-mana orang yang tidak mematuhi arahan yang disebut dalam subseksyen (3), pihak berkuasa tempatan pada bila-bila masa selepas habis tempoh masa yang dinyatakan dalam notis boleh dengan sendirinya menyebabkan supaya kerja itu dilakukan dan menuntut kos dan belanjanya daripada orang itu.”. Pindaan seksyen 70"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 70(2) Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (a), dengan memotong perkataan “dan” di hujung perenggan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (b), dengan menggantikan noktah di hujung perenggan itu dengan perkataan “; dan”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perengan (b) perenggan yang berikut: “(c) kepada pihak berkuasa tempatan atau pihak berkuasa berkanun berkaitan suatu laporan geoteknikal bagi binaan yang melibatkan cerun dengan kecerunan yang lebih daripada dua puluh lima darjah dan jumlah ketinggian menegak yang lebih daripada sepuluh meter yang laporan itu hendaklah ditentusahkan oleh Pemeriksa Bertauliah yang berdaftar dengan Lembaga Jurutera di bawah Akta Pendaftaran Jurutera 1967 [Akta 138].”. Pindaan seksyen 85a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_5__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_5__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_5__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_5__para_e",
