      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “Pemunya sesuatu bangunan” perkataan “atau tanah dengan cerun”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_5__para_e__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_5__para_e",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “menyebabkan bangunan” perkataan “atau cerun”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_5__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
