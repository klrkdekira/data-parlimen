      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (6)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_5__para_g__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_5__para_g",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “bangunan” di mana-mana jua terdapat perkataan “atau cerun”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_5__para_g__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_5__para_g__subpara_ii__subpara_A",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_5__para_g__subpara_ii__subpara_B"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_5__para_g",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (c)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_5__para_g__subpara_ii__subpara_A",
      "@type": "akn:subparagraph",
      "eli:number": "A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_5__para_g__subpara_ii",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “kestabilan atau keutuhan struktur” dengan perkataan “kestabilan atau keutuhan struktur atau cerun”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_5__para_g__subpara_ii__subpara_B",
      "@type": "akn:subparagraph",
      "eli:number": "B",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_5__para_g__subpara_ii",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “siasatan struktur” dengan perkataan “siasatan struktur atau cerun”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_5__para_g__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_5__para_g__subpara_iii__subpara_A",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_5__para_g__subpara_iii__subpara_B",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_5__para_g__subpara_iii__subpara_C"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_5__para_g",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (d)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_5__para_g__subpara_iii__subpara_A",
      "@type": "akn:subparagraph",
      "eli:number": "A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_5__para_g__subpara_iii",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “siasatan struktur” dengan perkataan “siasatan struktur atau cerun”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_5__para_g__subpara_iii__subpara_B",
      "@type": "akn:subparagraph",
      "eli:number": "B",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_5__para_g__subpara_iii",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subperenggan (ii) dengan subperenggan yang berikut: “(ii) menyemak pelan struktur bangunan atau cerun itu bersama dengan kiraan struktur atau laporan geoteknikalnya, atau dengan tujuan untuk menentukan apa-apa kekurangan pada unsur struktur bangunan atau cerun itu;”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_5__para_g__subpara_iii__subpara_C",
      "@type": "akn:subparagraph",
      "eli:number": "C",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_5__para_g__subpara_iii",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subperenggan (ii) subperenggan yang berikut: “(iia) jika pelan struktur, kiraan struktur atau laporan geoteknikal yang disebut dalam subperenggan (ii) tidak boleh didapati, jurutera hendaklah membina semula pelan, kiraan atau laporan itu jika dikehendaki sedemikian oleh pihak berkuasa tempatan, dengan tujuan untuk menentukan apa-apa kekurangan pada unsur struktur bangunan atau cerun itu;”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_5__para_g__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_5__para_g",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (e), dengan menggantikan perkataan “siasatan struktur” dengan perkataan “siasatan struktur atau cerun”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_5__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (7)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_5__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_5__para_i__subpara_ii",
