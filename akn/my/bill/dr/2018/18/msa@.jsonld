      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (5)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_5__para_f__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_5__para_f",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “bangunan itu atau menyebabkan bangunan itu” dengan perkataan “bangunan atau cerun itu atau menyebabkan bangunan atau cerun itu”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_5__para_f__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_5__para_f",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “pemunya bangunan itu” perkataan “atau tanah dengan cerun itu”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_5__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_5__para_g__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/18/msa@/~cl_5__para_g__subpara_ii",
