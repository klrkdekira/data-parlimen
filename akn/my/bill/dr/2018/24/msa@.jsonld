      "schema:text": {
        "@language": "ms",
        "@value": "Akta Cukai Pendapatan 1967, yang disebut “Akta ibu” dalam Bab ini, dipinda dalam subseksyen 2(1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/24/msa@/~chp_II__cl_4__para_a",
