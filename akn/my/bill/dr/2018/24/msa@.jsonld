      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah hanya diberikan kepada syarikat itu mengikut subseksyen 29(5) Akta ibu, seolah-olah Akta ibu tidak dipinda, bagi tempoh tujuh tahun taksiran berturut-turut dan tempoh itu bermula sebaik selepas tahun taksiran 2018; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/24/msa@/~sched_3__chp_III__para_39__para_b",
