      "schema:text": {
        "@language": "ms",
        "@value": "PINDAAN KEPADA AKTA PENGGALAKAN PELABURAN 1986 Permulaan kuat kuasa pindaan kepada Akta Penggalakan Pelaburan 1986"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/24/msa@/~sched_3__chp_III__para_31",
      "@type": "akn:paragraph",
      "eli:number": "31",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/24/msa@/~sched_3__chp_III__para_31__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/24/msa@/~sched_3__chp_III__para_31__subsec_2",
