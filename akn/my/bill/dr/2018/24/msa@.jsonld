      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa amaun elaun pada akhir tempoh itu yang masih belum diberikan kepada syarikat itu, oleh sebab ketidakcukupan atau ketiadaan pendapatan larasan daripada perniagaannya bagi tempoh itu, tidak boleh diambil kira bagi maksud Akta ibu. Pindaan seksyen 29a"
      }
    },
