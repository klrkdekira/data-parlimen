        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/24/msa@/~chp_II__cl_21",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/24/msa@/~chp_II__cl_22",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/24/msa@/~chp_II__cl_23",
