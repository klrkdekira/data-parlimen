        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/24/msa@/~chp_II__cl_9__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/24/msa@/~chp_II",
      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 39(1) Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/24/msa@/~chp_II__cl_9__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/24/msa@/~chp_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan “or” di hujung perenggan (p);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/24/msa@/~chp_II__cl_9__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/24/msa@/~chp_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan noktah di hujung perenggan (q) dengan perkataan “; or”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/24/msa@/~chp_II__cl_9__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/24/msa@/~chp_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan (q) perenggan yang berikut: “(r) a sum equal to ninety seven per cent of any expenditure incurred in relation to a payment made by a person, who is a resident, to any Labuan company.”. Peruntukan khas yang berhubungan dengan seksyen 43"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/24/msa@/~chp_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/24/msa@/~chp_I",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Kewangan 2018. Pindaan Akta"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/24/msa@/~chp_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/24/msa@/~chp_I",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Cukai Pendapatan 1967 [Akta 53], Akta Penggalakan Pelaburan 1986 [Akta 327], Akta Setem 1949 [Akta 378], Akta Cukai Keuntungan Harta Tanah 1976 [Akta 169], Akta Cukai Aktiviti Perniagaan Labuan 1990 [Akta 445], Akta Cukai Perkhidmatan 2018 [Akta 807] dan Akta Cukai Jualan 2018 [Akta 806] dipinda mengikut cara yang dinyatakan masing-masing dalam Bab II, III, IV, V, VI, VII dan VIII."
      }
    },
