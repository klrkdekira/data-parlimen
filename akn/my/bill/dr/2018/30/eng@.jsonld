      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/30/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "in subparagraph (1)(iii)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/30/eng@/~cl_8__para_d__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/30/eng@/~cl_8__para_d",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the words “in the case of prohibited goods” the words “other than cigarettes containing tobacco and intoxicating liquor”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/30/eng@/~cl_8__para_d__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/30/eng@/~cl_8__para_d",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsubparagraph (aa) the following subsubparagraph: “(aa) be liable for the first offence to a fine of not less than ten times the value of the goods or fifty thousand ringgit, whichever is the greater amount, and of not more than twenty times the value of the goods or five hundred thousand ringgit, whichever is the greater amount, or to imprisonment for a term not exceeding five years or to both; and”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/30/eng@/~cl_8__para_d__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
