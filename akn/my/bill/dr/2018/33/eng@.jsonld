      ],
      "schema:name": {
        "@language": "en",
        "@value": "Administration of Islamic Law (Federal Territories) (Amendment) Bill 2018"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/33/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/33/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/33/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/33/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/33/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/33/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Administration of Islamic Law (Federal Territories) (Amendment) Act 2018."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/33/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/33/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Yang di-Pertuan Agong by notification in the Gazette. Amendment of section 7"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/33/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/33/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Administration of Islamic Law (Federal Territories) Act 1993 [Act 505], which is referred to as the “principal Act” in this Act, is amended in paragraph 7(2)(f) by substituting for the words “Islamic schools” the words “Islamic religious school”. Substitution of section 97"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/33/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/33/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by substituting for section 97 the following section: “Islamic religious school 97. The Majlis shall have the power— (a) to register and regulate an Islamic religious school; and (b) for the purpose of safeguarding the interest of the public and the students of the Islamic religious school— (i) to take over the administration of an Islamic religious school; (ii) to cease the operation of an Islamic religious school; (iii) to enter and inspect an Islamic religious school; and (iv) to take such action as the Majlis considers necessary to ensure that the affairs of the Islamic religious school are in compliance with the provisions of this Act and the rules made under this Act.”. Amendment of section 99"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/33/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/33/eng@/~cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/33/eng@/~cl_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/33/eng@/~cl_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/33/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 99 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/33/eng@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/33/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by renumbering the existing provision as subsection (1);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/33/eng@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/33/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for paragraph (j) the following paragraph: “(j) the registration and regulation of Islamic religious school and activities relating to Islamic religious teaching and learning.”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/33/eng@/~cl_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/33/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (1) as renumbered the following subsection: “(2) Any rules made under this Act may prescribe for any act or omission in contravention of the rules to be an offence and may prescribe penalties of a fine not exceeding five thousand ringgit or imprisonment for a term not exceeding three years or both for such offence.”."
      }
    }
  ]
}
