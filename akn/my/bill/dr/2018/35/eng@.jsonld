    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/35/eng@/~cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/35/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "Any action or proceedings under sections 7 and 28a of the principal Act and matters relating to such action or proceedings commenced or pending immediately before the date of coming into operation of this Act shall, on the date of coming into operation of this Act, be continued as if the principal Act had not been amended by this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/35/eng@/~cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/35/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "Any action commenced on or after the date of coming into operation of this Act of which the cause of action accrued before the date of coming into operation of this Act shall be continued as if the principal Act had not been amended by this Act."
      }
    }
  ]
}
