      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/35/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Civil Law (Amendment) Act 2018."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/35/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/35/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Amendment of section 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/35/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/35/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Civil Law Act 1956 [Act 67], which is referred to as the “principal Act” in this Act, is amended in section 2 by inserting after the definition of “executor” the following definition: ‘ “persons with disabilities” has the meaning assigned to it in the Persons with Disabilities Act 2008 [Act 685];’. Amendment of section 7"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/35/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
