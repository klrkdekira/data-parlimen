      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the shoulder note the following shoulder note: “Compensation to persons entitled for loss occasioned by death”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/35/eng@/~cl_3__para_b",
