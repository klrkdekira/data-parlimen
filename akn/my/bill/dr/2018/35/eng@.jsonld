      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (3b) the following subsection: “(3b) A claim for damages for bereavement shall only be for the benefit of— (a) the spouse of the person deceased; (b) the child of the person deceased; and (c) the parents of the person deceased.”;"
      }
    },
