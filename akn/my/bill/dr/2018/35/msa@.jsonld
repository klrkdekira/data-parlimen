    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/35/msa@/~cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/35/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa tindakan atau prosiding di bawah seksyen 7 dan 28a Akta ibu dan perkara yang berhubungan dengan tindakan atau prosiding itu yang telah dimulakan atau belum selesai sebaik sebelum tarikh permulaan kuat kuasa Akta ini hendaklah, pada tarikh permulaan kuat kuasa Akta ini, diteruskan seolah-olah Akta ibu tidak dipinda oleh Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/35/msa@/~cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/35/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa tindakan yang dimulakan pada atau selepas tarikh permulaan kuat kuasa Akta ini bagi apa-apa kausa tindakan yang terakru sebelum tarikh permulaan kuat kuasa Akta ini hendaklah diteruskan seolah-olah Akta ibu tidak dipinda oleh Akta ini."
      }
    }
  ]
}
