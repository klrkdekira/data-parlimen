      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 7 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2018/35/msa@/~cl_3__para_a",
