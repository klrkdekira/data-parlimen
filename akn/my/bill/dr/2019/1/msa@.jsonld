      "schema:name": {
        "@language": "ms",
        "@value": "RUU Perbekalan Tambahan (2018) 2019"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/1/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/1/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Perbekalan Tambahan (2018) 2019. Perbelanjaan tambahan bagi tahun 2018"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/1/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/1/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Maka dengan ini dibenarkan pengeluaran sejumlah wang yang tidak melebihi empat bilion satu ratus tiga puluh tiga juta tiga ratus enam puluh ribu tujuh ratus enam puluh ringgit (RM4,133,360,760) daripada Kumpulan Wang Disatukan bagi perbelanjaan tambahan untuk perkhidmatan dan maksud yang dinyatakan dalam Jadual bagi tahun 2018 yang tidak diperuntukkan atau yang tidak diperuntukkan dengan sepenuhnya oleh Akta Perbekalan 2018 [Akta A1557]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/1/msa@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/1/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Maksud Tajuk B. 4 Suruhanjaya Pilihan Raya B. 6 Jabatan Perdana Menteri B. 9 Suruhanjaya Pencegahan Rasuah Malaysia B. 10 Perbendaharaan B. 12 Peruntukan kepada Kumpulan Wang Terkanun B. 13 Kementerian Luar Negeri B. 42 Kementerian Kesihatan B. 60 Kementerian Pertahanan B. 62 Kementerian Dalam Negeri B. 63 Kementerian Pendidikan Jumlah"
      }
    }
  ]
