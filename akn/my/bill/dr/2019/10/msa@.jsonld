        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_123",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_124",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_125",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_126",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_127",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_128",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_129",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_130",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_131",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_132",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_133",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_134",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_135",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_136",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_137",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_138",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_139"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI",
      "schema:text": {
        "@language": "ms",
        "@value": "Kuasa penangkapan, penggeledahan, penyitaan dsb. Kuasa menangkap"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_119",
      "@type": "akn:clause",
      "eli:number": "119",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_119__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_119__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_119__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_119",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana Penolong Pengawal boleh menangkap tanpa waran mana-mana orang yang dipercayainya dengan munasabah telah melakukan atau cuba untuk melakukan suatu kesalahan di bawah seksyen 99 hingga 102 Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_119__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_119",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana Penolong Pengawal yang membuat tangkapan di bawah subseksyen (1) hendaklah tanpa kelengahan yang tidak perlu, membawa orang yang ditangkap itu ke balai polis yang paling hampir, dan selepas itu orang itu hendaklah diperlakukan sebagaimana yang diperuntukkan oleh undang-undang yang berhubungan dengan tatacara jenayah yang sedang berkuat kuasa. Kuasa untuk memasuki premis, memeriksa dan menyita barang-barang, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_120",
      "@type": "akn:clause",
      "eli:number": "120",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_120__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_120__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_120__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_120__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_120__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_120__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_120__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_120__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_120",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana Penolong Pengawal boleh, pada bila-bila masa yang munasabah, menjalankan kuasa yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_120__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_120__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dia boleh, bagi maksud menentukan sama ada apa-apa kesalahan di bawah Akta ini telah dilakukan, memeriksa apa-apa barang-barang, dokumen, bahan, artikel atau benda dan memasuki mana-mana premis selain premis yang digunakan sebagai tempat kediaman sahaja;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_120__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_120__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia ada sebab yang munasabah untuk mengesyaki bahawa suatu kesalahan di bawah Akta ini telah dilakukan, dia boleh menyita dan menahan apa-apa barang-barang, dokumen, bahan, artikel atau benda bagi maksud menentukan, dengan cara menguji atau dengan cara lain, sama ada kesalahan itu telah dilakukan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_120__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_120__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dia boleh menyita dan menahan apa-apa barang-barang, dokumen, bahan, artikel atau benda yang dia ada sebab untuk mempercayai mungkin dikehendaki sebagai keterangan dalam apa-apa prosiding bagi suatu kesalahan di bawah Akta ini; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_120__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_120__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dia boleh, bagi maksud menjalankan kuasanya di bawah subseksyen ini, menyita barang-barang, dokumen, bahan, artikel atau benda, tetapi hanya jika dan setakat yang semunasabahnya perlu untuk memastikan bahawa peruntukan Akta ini dan peruntukan mana-mana perintah yang dibuat di bawah Akta ini dituruti dengan sewajarnya, menghendaki mana-mana orang yang mempunyai kuasa untuk berbuat demikian supaya memecah buka apa-apa bekas atau membuka apa-apa mesin penjualan dan, jika orang itu tidak mematuhi kehendak itu, dia sendiri boleh berbuat demikian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_120__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_120",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang Penolong Pengawal yang menyita apa-apa barang-barang, dokumen, bahan, artikel atau benda dalam menjalankan kuasanya di bawah seksyen ini hendaklah memberitahu orang yang daripadanya barang-barang, dokumen, bahan, artikel atau benda itu disita dan, dalam hal barang-barang, dokumen, bahan, artikel atau benda yang disita daripada mesin penjualan, orang yang nama dan alamatnya dinyatakan pada mesin itu sebagai tuan punyanya atau, jika tiada nama dan alamat dinyatakan sedemikian, penduduk premis tempat mesin itu berada atau penduduk premis yang padanya mesin itu dilekatkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_120__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_120",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika barang-barang, dokumen, bahan, artikel atau benda yang disita oleh Penolong Pengawal pada menjalankan kuasanya di bawah seksyen ini adalah disebabkan oleh jenis, saiz atau amaunnya tidak praktik untuk dipindahkan dari tempat barang-barang, dokumen, bahan, artikel atau benda itu dijumpai, dia boleh dengan apa-apa cara mengelak barang-barang atau dokumen itu di dalam premis atau bekas yang di dalamnya barang-barang, dokumen, bahan, artikel atau benda itu dijumpai dan menjadi suatu kesalahan bagi mana-mana orang tanpa kuasa yang sah untuk memecahkan, mengganggu atau merosakkan lak itu atau untuk memindahkan barang-barang, dokumen, bahan, artikel atau benda itu atau untuk cuba berbuat demikian. Majistret boleh mengeluarkan waran geledah"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_121",
      "@type": "akn:clause",
      "eli:number": "121",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_121__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_121__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_121__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_121__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_121__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_121__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_121__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_121__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_121",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila ternyata pada seseorang Majistret, berdasarkan maklumat bertulis dengan bersumpah dan selepas apa-apa siasatan yang difikirkannya perlu, bahawa terdapat alasan yang munasabah untuk mempercayai bahawa mana-mana orang telah melakukan atau sedang melakukan suatu kesalahan di bawah Akta ini, sehingga apa-apa keterangan atau benda yang perlu dalam pelaksanaan suatu penyiasatan bagi apa-apa kesalahan mungkin ditemui di dalam mana-mana premis, Majistret itu boleh mengeluarkan suatu waran yang memberikan kuasa kepada mana-mana Penolong Pengawal yang dinamakan di dalam waran untuk memasuki premis itu pada bila-bila masa, dengan atau tanpa bantuan, dan jika perlu dengan menggunakan kekerasan untuk menggeledah dan menyita apa-apa keterangan atau benda itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_121__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_121",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang Penolong Pengawal yang memasuki mana-mana premis di bawah seksyen ini boleh membawa bersama-samanya mana-mana orang lain dan apa-apa kelengkapan yang ternyata padanya perlu dan apabila meninggalkan mana-mana premis yang telah dimasukinya menurut kuasa waran di bawah subseksyen yang terdahulu dia hendaklah, jika premis itu tidak diduduki atau penduduknya tidak ada buat sementara waktu, meninggalkan premis itu dalam keadaan yang betul-betul selamat daripada penceroboh sebagaimana keadaan premis itu didapati olehnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_121__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_121",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan keluasan subseksyen (1), waran yang dikeluarkan oleh Majistret boleh memberikan kuasa penggeledahan dan penyitaan apa-apa barang-barang, dokumen, bahan, artikel atau benda yang mengandungi atau dengan munasabahnya disyaki mengandungi maklumat tentang apa-apa kesalahan yang disyaki telah dilakukan atau selainnya perlu untuk melaksanakan suatu penyiasatan bagi apa-apa kesalahan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_121__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_121",
      "schema:text": {
        "@language": "ms",
        "@value": "Penolong Pengawal yang menjalankan penggeledahan di bawah subseksyen (1) boleh, bagi maksud menyiasat kesalahan itu, memeriksa mana-mana orang yang berada di dalam atau di premis itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_121__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_121",
      "schema:text": {
        "@language": "ms",
        "@value": "Penolong Pengawal yang membuat pemeriksaan ke atas seseorang di bawah subseksyen (4) boleh menyita, atau mengambil milikan, dan menyimpan dalam jagaan selamat semua benda selain pakaian yang perlu yang dijumpai pada orang itu, dan apa-apa benda lain, yang berkenaan dengannya terdapat sebab untuk mempercayai bahawa benda itu merupakan peralatan atau keterangan mengenai kesalahan itu, dan benda itu boleh ditahan sehingga mahkamah mengeluarkan perintah pelupusan terhadapnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_121__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_121",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika, oleh sebab jenis, saiz atau amaunnya, adalah tidak praktik untuk memindahkan apa-apa barang-barang, dokumen, bahan, artikel atau benda yang disita di bawah seksyen ini, Penolong Pengawal yang menyita itu hendaklah dengan apa-apa cara mengelak premis atau bekas yang di dalamnya dijumpai barang-barang, dokumen, bahan, artikel atau benda itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_121__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_121",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang, tanpa kuasa yang sah, memecahkan, mengganggu atau merosakkan lak yang disebut dalam subseksyen (6) atau memindahkan apa-apa barang-barang, dokumen, bahan, artikel atau benda yang dilak atau cuba untuk berbuat demikian melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi satu ratus ribu ringgit. Penggeledahan boleh dilakukan tanpa waran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_122",
      "@type": "akn:clause",
      "eli:number": "122",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Penolong Pengawal berpuas hati atas maklumat yang diterima bahawa dia mempunyai sebab yang munasabah untuk mempercayai bahawa oleh sebab kelengahan dalam mendapatkan waran geledah di bawah seksyen 121 penyiasatan akan terjejas atau keterangan mengenai pelakuan pelanggaran atau kesalahan mungkin diganggu, dipindahkan, dirosakkan atau dimusnahkan, Penolong Pengawal boleh memasuki premis dan menjalankan di dalam, pada dan berkenaan dengan premis itu semua kuasa yang disebut dalam seksyen 121 dengan cara yang sepenuhnya dan secukupnya seolah-olah dia diberi kuasa untuk berbuat demikian oleh suatu waran yang dikeluarkan di bawah seksyen itu. Akses kepada maklumat berekod atau data berkomputer, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_123",
      "@type": "akn:clause",
      "eli:number": "123",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_123__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_123__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_123__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_123__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_123__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_123",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana Penolong Pengawal yang menjalankan kuasanya di bawah seksyen 120, 121 dan 122 hendaklah diberi akses kepada apa-apa maklumat berekod atau data berkomputer atau berdigital, sama ada yang disimpan dalam suatu komputer atau selainnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_123__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_123__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_123__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_123",
      "schema:text": {
        "@language": "ms",
        "@value": "Sebagai tambahan, Penolong Pengawal dalam menjalankan kuasanya di bawah seksyen 120, 121 dan 122—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_123__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_123__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "boleh memeriksa dan meneliti pengendalian apa-apa komputer dan apa-apa radas atau bahan yang dia ada sebab munasabah untuk mengesyaki sedang atau telah digunakan berkaitan dengan maklumat atau data itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_123__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_123__subsec_2__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_123__subsec_2__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_123__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "boleh menghendaki—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_123__subsec_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_123__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "orang yang, olehnya atau bagi pihaknya, pegawai itu ada sebab munasabah untuk mengesyaki, komputer itu sedang atau telah digunakan berkaitan dengan maklumat atau data itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_123__subsec_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_123__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "orang yang bertanggungjawab, atau yang selainnya terlibat dengan, pengendalian komputer, radas atau bahan itu berkaitan dengan maklumat atau data, untuk memberinya apa-apa bantuan yang munasabah sebagaimana yang dikehendaki olehnya bagi maksud seksyen ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_123__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_123",
      "schema:text": {
        "@language": "ms",
        "@value": "Penolong Pengawal boleh membuat salinan atau mengambil cabutan maklumat berekod, data berkomputer atau berdigital itu jika difikirkannya perlu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_123__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_123",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini, “akses” termasuk diberi kata laluan yang perlu, kod penyulitan, kod penyahsulitan, perisian atau perkakasan yang perlu atau apa-apa cara lain yang dikehendaki untuk membolehkan pemahaman maklumat berekod dan data berkomputer atau berdigital itu. Pemberian maklumat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_124",
      "@type": "akn:clause",
      "eli:number": "124",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_124__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_124__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_124__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_124__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_124__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_124__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_124__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_124__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_124",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_124__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_124__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mengetahui atau mempunyai sebab untuk mengesyaki bahawa seorang Penolong Pengawal sedang bertindak, atau bercadang untuk bertindak, berkaitan dengan suatu penyiasatan yang sedang, atau akan, dijalankan di bawah atau bagi maksud Akta ini dan menzahirkan kepada mana-mana orang lain maklumat atau apa-apa perkara lain yang mungkin akan menjejaskan penyiasatan itu atau penyiasatan yang dicadangkan itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_124__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_124__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mengetahui atau mempunyai sebab untuk mengesyaki bahawa suatu penzahiran telah dibuat kepada seorang Penolong Pengawal dan menzahirkan kepada mana-mana orang lain maklumat atau apa-apa perkara lain yang mungkin akan menjejaskan apa-apa penyiasatan yang mungkin dijalankan berikutan dengan penzahiran itu, melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi satu ratus ribu ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_124__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_124__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_124__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_124",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada apa-apa jua dalam subseksyen (1) menjadikannya suatu kesalahan jika seseorang peguam bela dan peguam cara atau pekerjanya menzahirkan apa-apa maklumat atau perkara lain—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_124__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_124__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "kepada pelanggannya atau wakil pelanggannya berkaitan dengan pemberian nasihat kepada pelanggan itu dalam perjalanan dan bagi maksud khidmat profesional peguam bela dan peguam cara itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_124__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_124__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "kepada mana-mana orang yang menjangkakan, atau berkaitan dengan dan bagi maksud, apa-apa prosiding undang-undang."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_124__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_124",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen (2) tidaklah terpakai berhubung dengan apa-apa maklumat atau perkara lain yang dizahirkan dengan tujuan untuk melaksanakan apa-apa maksud yang menyalahi undang-undang."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_124__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_124__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_124__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_124",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam apa-apa prosiding terhadap seseorang bagi suatu kesalahan di bawah seksyen ini, hendaklah menjadi pembelaan jika orang itu membuktikan bahawa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_124__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_124__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dia tidak mengetahui atau mengesyaki bahawa penzahiran yang dibuat di bawah perenggan (1)(b) berkemungkinan menjejaskan penyiasatan itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_124__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_124__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dia mempunyai kuasa sah atau alasan yang munasabah untuk membuat penzahiran itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_124__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_124",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang Penolong Pengawal atau mana-mana orang lain tidak melakukan suatu kesalahan di bawah seksyen ini berkenaan dengan apa-apa jua perkara yang telah dibuat olehnya dalam perjalanan tindakan yang berkaitan dengan penguatkuasaan, atau penguatkuasaan yang dicadangkan, bagi Akta ini. Waran boleh diterima walaupun cacat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_125",
      "@type": "akn:clause",
      "eli:number": "125",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu waran geledah yang dikeluarkan di bawah Akta ini adalah sah dan boleh dikuatkuasakan walau apa pun kecacatan, kesilapan atau peninggalan dalamnya atau dalam permohonan bagi waran itu dan apa-apa barang-barang, dokumen, bahan, artikel atau benda yang disita di bawah waran itu boleh diterima sebagai keterangan dalam mana-mana prosiding di bawah Akta ini. Senarai benda yang disita"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_126",
      "@type": "akn:clause",
      "eli:number": "126",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_126__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_126__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_126__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_126",
      "schema:text": {
        "@language": "ms",
        "@value": "Kecuali sebagaimana yang diperuntukkan dalam subseksyen (2), jika apa-apa barang-barang, dokumen, bahan, artikel atau benda disita di bawah Bahagian ini, Penolong Pengawal yang melakukan penyitaan itu hendaklah dengan secepat yang dapat dilaksanakan menyediakan senarai benda yang disita itu dan dengan segera menyerahkan suatu salinan senarai itu yang ditandatangani olehnya kepada penghuni premis yang digeledah itu, atau kepada ejen atau pekhidmatnya, di premis itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_126__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_126",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika premis itu tidak berpenghuni, Penolong Pengawal yang melakukan penyitaan itu hendaklah di mana-mana mungkin menampalkan senarai benda yang disita itu di tempat yang mudah dilihat di premis itu. Pelucuthakan barang-barang, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_127",
      "@type": "akn:clause",
      "eli:number": "127",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_127__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_127__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_127__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_127__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_127__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_127__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_127__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_127__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_127",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua barang-barang, dokumen, bahan, artikel atau benda yang disita pada menjalankan apa-apa kuasa yang diberikan di bawah Akta ini boleh dilucuthakkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_127__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_127",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu perintah bagi melucuthakkan atau melepaskan apa-apa barang-barang, dokumen, bahan, artikel atau benda yang disita dalam menjalankan apa-apa kuasa yang diberikan di bawah Akta ini hendaklah dibuat oleh mahkamah yang di hadapannya pendakwaan berkenaan dengannya telah dijalankan dan suatu perintah bagi melucuthakkan barang-barang, dokumen, bahan, artikel atau benda itu hendaklah dibuat jika dibuktikan dengan memuaskan hati mahkamah bahawa suatu kesalahan di bawah Akta ini telah dilakukan dan bahawa barang-barang, dokumen, bahan, artikel atau benda itu ialah hal perkara atau telah digunakan dalam melakukan kesalahan itu, walaupun tiada orang telah disabitkan atas kesalahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_127__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_127",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika tiada pendakwaan berkenaan dengan mana-mana barang-barang, dokumen, bahan, artikel atau benda yang disita pada menjalankan apa-apa kuasa yang diberikan di bawah Akta ini, barang-barang itu hendaklah dikira dan disifatkan dilucuthakkan apabila habis tempoh satu bulan kalendar dari tarikh ia disita melainkan jika suatu tuntutan mengenainya dibuat sebelum tarikh itu mengikut cara yang dinyatakan kemudian daripada ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_127__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_127",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang menegaskan bahawa dia ialah pemunya barang-barang, dokumen, bahan, artikel atau bahan itu dan bahawa ia tidak boleh dilucuthakkan boleh dengan sendirinya atau melalui ejennya yang diberi kuasa secara bertulis memberikan notis bertulis kepada Penolong Pengawal bahawa dia menuntut barang-barang, dokumen, bahan, artikel atau benda itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_127__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_127",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila diterima notis itu Penolong Pengawal hendaklah merujukkan tuntutan itu kepada Pengawal yang boleh mengarahkan supaya barang-barang, dokumen, bahan, artikel atau bahan itu dilepaskan atau dilucuthakkan atau boleh mengarahkan Penolong Pengawal supaya merujukkan perkara itu kepada mahkamah untuk keputusan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_127__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_127",
      "schema:text": {
        "@language": "ms",
        "@value": "Mahkamah yang kepadanya perkara itu dirujukkan hendaklah mengeluarkan suatu saman yang menghendaki orang yang menegaskan bahawa dia ialah pemunya barang-barang, dokumen, bahan, artikel atau benda itu dan orang yang daripadanya barang-barang, dokumen, bahan, artikel atau bahan itu telah disita supaya hadir di hadapannya dan apabila dia hadir atau tidak hadir, selepas dibuktikan bahawa saman itu telah disampaikan dengan sewajarnya, mahkamah hendaklah meneruskan pemeriksaan perkara itu dan apabila dibuktikan bahawa suatu kesalahan di bawah Akta ini telah dilakukan dan bahawa barang-barang, dokumen, bahan, artikel atau benda itu ialah hal perkara kesalahan itu atau telah digunakan dalam melakukan kesalahan itu hendaklah memerintahkan supaya barang-barang itu dilucuthakkan atau boleh, jika tidak dibuktikan sedemikian, memerintahkan supaya barang-barang itu dilepaskan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_127__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_127",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua benda yang dilucuthakkan atau disifatkan dilucuthakkan hendaklah diserahkan kepada Penolong Pengawal dan hendaklah dilupuskan mengikut arahan Pengawal. Pelepasan benda yang disita"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_128",
      "@type": "akn:clause",
      "eli:number": "128",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_128__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_128__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_128__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_128",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika apa-apa barang-barang, dokumen, bahan, artikel atau benda telah disita di bawah Akta ini, Penolong Pengawal yang melakukan penyitaan itu boleh melepaskan barang-barang, dokumen, bahan, artikel atau benda itu kepada orang yang ditentukan olehnya sebagai berhak secara sah kepadanya, jika dia berpuas hati bahawa barang-barang, dokumen, bahan, artikel atau benda itu tidak dikehendaki selainnya bagi maksud apa-apa prosiding di bawah Akta ini, atau bagi maksud apa-apa pendakwaan di bawah mana-mana undang-undang bertulis yang lain, dan sekiranya sedemikian Penolong Pengawal yang melakukan penyitaan itu, Kerajaan Persekutuan, Pengawal atau mana-mana orang yang bertindak bagi pihak Kerajaan Persekutuan atau Pengawal tidak boleh dikenakan apa-apa prosiding oleh mana-mana orang jika penyitaan dan pelepasan barang-barang, dokumen, bahan, artikel atau benda itu telah dibuat dengan suci hati."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_128__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_128",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu rekod bertulis hendaklah dibuat oleh Penolong Pengawal yang melakukan pelepasan itu bagi apa-apa perkara di bawah subseksyen (1) dengan menyatakan secara terperinci hal keadaan, dan sebab bagi, pelepasan itu, dan dia hendaklah menghantar satu salinan rekod itu kepada Pendakwa Raya dalam masa tujuh hari selepas pelepasannya itu. Penyitaan barang-barang mudah musnah"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_129",
      "@type": "akn:clause",
      "eli:number": "129",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika apa-apa barang-barang, dokumen, bahan, artikel atau bahan yang disita pada menjalankan kuasa yang diberikan oleh Akta ini merupakan barang-barang yang mudah musnah sifatnya atau jika jagaan barang-barang itu melibatkan perbelanjaan dan kesusahan yang tidak munasabah, barang-barang itu boleh dijual oleh Penolong Pengawal pada bila-bila masa dan hasil jualan itu boleh dipegang untuk mematuhi keputusan apa-apa pendakwaan atau tuntutan di bawah seksyen ini. Tiada kos atau ganti rugi yang berbangkit daripada penyitaan boleh didapatkan balik"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_130",
      "@type": "akn:clause",
      "eli:number": "130",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun, dalam apa-apa prosiding di hadapan mana-mana mahkamah berkenaan dengan apa-apa barang-barang, dokumen, bahan, artikel atau benda yang disita dalam menjalankan atau yang berupa sebagai menjalankan mana-mana kuasa yang diberikan di bawah Akta ini, berhak kepada kos prosiding itu atau kepada apa-apa ganti rugi atau relief lain melainkan jika penyitaan itu dibuat tanpa sebab yang munasabah. Galangan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_131",
      "@type": "akn:clause",
      "eli:number": "131",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_131__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_131__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3",
      "schema:name": {
        "@language": "ms",
        "@value": "Mana-mana orang yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_131__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_131",
      "schema:text": {
        "@language": "ms",
        "@value": "enggan untuk memberi mana-mana Penolong Pengawal akses kepada mana-mana premis yang Penolong Pengawal itu berhak kepadanya di bawah Akta ini atau dalam melaksanakan apa-apa kewajipan yang dikenakan atau kuasa yang diberikan oleh Akta ini; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_131__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_131",
      "schema:text": {
        "@language": "ms",
        "@value": "mengamang, menggalang, menghalang atau melengahkan mana-mana Penolong Pengawal dalam membuat apa-apa kemasukan yang Penolong Pengawal itu berhak membuatnya di bawah Akta ini atau dalam melaksanakan apa-apa kewajipan yang dikenakan atau kuasa yang diberikan oleh Akta ini, melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi satu ratus ribu ringgit. Keterangan ejen provokasi boleh diterima"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_132",
      "@type": "akn:clause",
      "eli:number": "132",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_132__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_132__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_132__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_132",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun mana-mana rukun undang-undang atau peruntukan Akta ini atau mana-mana undang-undang bertulis lain yang berlawanan, tiada ejen provokasi boleh dikira sebagai tidak boleh dipercayai hanya oleh sebab dia cuba untuk bersubahat atau telah bersubahat dalam melakukan suatu kesalahan oleh mana-mana orang di bawah Akta ini jika cubaan untuk bersubahat atau pensubahatan itu adalah semata-mata bagi maksud mendapatkan keterangan terhadap orang itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_132__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_132",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun mana-mana rukun undang-undang atau peruntukan Akta ini atau mana-mana undang-undang bertulis lain yang berlawanan, apa-apa pernyataan, sama ada lisan atau bertulis yang dibuat kepada ejen provokasi itu oleh mana-mana orang yang selepas itu dipertuduh atas suatu kesalahan di bawah Akta ini boleh diterima sebagai keterangan dalam perbicaraannya. Mengambil sampel"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_133",
      "@type": "akn:clause",
      "eli:number": "133",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_133__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_133__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_133__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_133__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_133",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika apa-apa barang-barang, dokumen, bahan, artikel atau bahan yang menjadi hal perkara suatu kesalahan di bawah Akta ini terdapat dalam dua atau lebih bungkusan atau bekas yang sama perihalnya, hendaklah dikira sehingga dibuktikan sebaliknya bahawa semua bungkusan atau bekas itu mengandungi barang-barang yang sama jenis, kuantiti dan kualiti."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_133__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_133",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika bungkusan atau bekas mengandungi barang-barang yang melanggar peruntukan Akta ini atau yang selainnya boleh disita telah pun disita, adalah mencukupi untuk membuka dan memeriksa satu peratus atau tidak kurang daripada lima sampel, mengikut mana-mana yang lebih kurang, daripada kandungan dalam setiap bungkusan atau bekas yang disita itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_133__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_133",
      "schema:text": {
        "@language": "ms",
        "@value": "Mahkamah hendaklah menganggap bahawa lebihan sampel yang terkandung dalam bungkusan atau bekas itu adalah sama jenis dengan sampel yang diperiksa. Bidang kuasa untuk membicarakan kesalahan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_134",
      "@type": "akn:clause",
      "eli:number": "134",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun apa-apa yang berlawanan dalam mana-mana undang-undang bertulis, mahkamah sesyen hendaklah mempunyai bidang kuasa untuk membicarakan apa-apa kesalahan di bawah Akta ini dan mengenakan hukuman penuh bagi apa-apa kesalahan sedemikian. Pemulaan pendakwaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_135",
      "@type": "akn:clause",
      "eli:number": "135",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada pendakwaan bagi atau berhubung dengan mana-mana kesalahan di bawah Akta ini boleh dimulakan kecuali oleh atau dengan keizinan bertulis Pendakwa Raya. Pengkompaunan kesalahan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_136",
      "@type": "akn:clause",
      "eli:number": "136",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_136__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_136__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_136__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_136__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_136__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_136__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_136__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_136__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_136__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_136",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, dengan kelulusan Pendakwa Raya, membuat peraturan-peraturan yang menetapkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_136__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_136__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa kesalahan di bawah Akta ini atau mana-mana peraturan-peraturan yang dibuat di bawah Akta ini sebagai suatu kesalahan yang boleh dikompaun;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_136__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_136__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "kriteria untuk mengkompuan kesalahan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_136__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_136__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "kaedah dan tatacara untuk mengkompaun kesalahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_136__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_136",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengawal boleh, dengan keizinan secara bertulis oleh Pendakwa Raya, pada bila-bila masa sebelum sesuatu pertuduhan dimulakan, mengkompaun mana-mana kesalahan yang ditetapkan sebagai suatu kesalahan yang boleh dikompaun dengan membuat suatu tawaran bertulis kepada orang yang disyaki dengan munasabah telah melakukan kesalahan itu untuk mengkompaun kesalahan itu apabila dibayar Pengawal suatu jumlah wang yang tidak melebihi lima puluh peratus daripada amaun denda maksimum yang orang itu boleh dikenakan jika dia disabitkan atas kesalahan itu, dalam apa-apa masa sebagaimana yang dinyatakan dalam tawaran bertulis itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_136__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_136",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu tawaran di bawah subseksyen (2) boleh dibuat pada bila-bila masa selepas kesalahan itu dilakukan tetapi sebelum apa-apa pendakwaan baginya dimulakan, dan jika amaun yang dinyatakan dalam tawaran itu tidak dibayar dalam masa yang dinyatakan dalam tawaran itu, atau apa-apa tempoh lanjutan sebagaimana yang diberikan oleh Pengawal, pendakwaan bagi kesalahan itu boleh dimulakan pada bila-bila masa selepas itu terhadap orang yang kepadanya tawaran itu dibuat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_136__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_136",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu kesalahan telah dikompaun di bawah subseksyen (2), tiada pendakwaan boleh dimulakan berkenaan dengan kesalahan itu terhadap orang yang kepadanya tawaran untuk mengkompaun itu dibuat, dan Pengawal boleh melucuthakkan atau memulangkan apa-apa barang-barang, dokumen, bahan, artikel atau benda yang disita berkenaan dengan kesalahan itu, tertakluk kepada apa-apa terma sebagaimana yang difikirkan patut oleh Pengawal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_136__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_136",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua jumlah wang yang diterima oleh Pengawal di bawah seksyen ini hendaklah dibayar ke dalam dan menjadi sebahagian daripada Kumpulan Wang Disatukan Persekutuan. Prinsipal bertanggungjawab bagi perbuatan pekhidmat atau ejen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_137",
      "@type": "akn:clause",
      "eli:number": "137",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_137__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_137__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika pekhidmat atau ejen seseorang melakukan suatu kesalahan atau membuat apa-apa atau meninggalkan daripada melakukan apa-apa perbuatan (yang jika dibuat atau ditinggalkan oleh orang itu akan menjadi suatu kesalahan di bawah Akta ini), orang itu hendaklah, walaupun orang itu tiada pengetahuan mengenai kesalahan itu, disifatkan melakukan kesalahan itu dan boleh dihukum bagi kesalahan itu melainkan jika dia membuktikan bahawa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_137__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_137",
      "schema:text": {
        "@language": "ms",
        "@value": "perbuatan atau peninggalan yang diadukan itu bukan dalam skop biasa pekerjaan pekhidmat atau agensi ejen itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_137__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_137",
      "schema:text": {
        "@language": "ms",
        "@value": "perbuatan atau peninggalan yang diadukan itu telah dilakukan atau ditinggalkan tanpa dipersetujui atau dibiarkan olehnya dan bahawa dia telah menjalankan segala usaha wajar untuk mengelakkan pembuatan atau peninggalan itu sebagaimana yang sepatutnya dilakukannya dengan mengambil kira segala hal keadaan kes itu. Kesalahan oleh pertubuhan perbadanan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_138",
      "@type": "akn:clause",
      "eli:number": "138",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_138__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_138__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_138__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_138__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_138__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_138",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika sesuatu pertubuhan perbadanan melakukan suatu kesalahan di bawah Akta ini, mana-mana orang yang pada masa pelakuan kesalahan itu ialah seorang pengarah, ketua pegawai eksekutif, ketua pegawai operasi, pengurus, setiausaha atau pegawai lain yang seumpamanya bagi pertubuhan perbadanan itu atau yang berupa bertindak atas mana-mana sifat sedemikian atau yang mengikut apa-apa cara atau sehingga apa-apa takat bertanggungjawab bagi pengurusan apa-apa hal ehwal pertubuhan perbadanan itu atau yang membantu dalam pengurusan sedemikian—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_138__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_138__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "boleh dipertuduh secara berasingan atau bersesama dalam prosiding yang sama bersekali dengan pertubuhan perbadanan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_138__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_138__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_138__subsec_1__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_138__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika pertubuhan perbadanan itu didapati bersalah melakukan kesalahan itu, hendaklah disifatkan bersalah melakukan kesalahan itu melainkan jika, dengan mengambil kira jenis fungsinya atas sifat itu dan segala hal keadaan, dia membuktikan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_138__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_138__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa kesalahan itu telah dilakukan tanpa pengetahuan, persetujuan atau pembiarannya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_138__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_138__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa dia telah mengambil segala langkah berjaga-jaga yang munasabah dan telah menjalankan segala usaha yang wajar untuk mengelakkan pelakuan kesalahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_138__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_138__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_138__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_138__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_138",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana orang di bawah Akta ini boleh dikenakan apa-apa hukuman atau penalti bagi perbuatan, peninggalan, pengabaian atau keingkarannya, dia boleh dikenakan hukuman atau penalti yang sama bagi tiap-tiap perbuatan, peninggalan, pengabaian atau keingkaran mana-mana pekerja atau ejennya, atau pekerja ejen itu, jika perbuatan, peninggalan, pengabaian atau keingkaran itu telah dilakukan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_138__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_138__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "oleh pekerja orang itu dalam masa penggajiannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_138__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_138__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "oleh ejen itu semasa bertindak bagi pihak orang itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_138__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_138__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "oleh pekerja ejen itu dalam masa penggajian pekerja itu dengan ejen itu atau selainnya bagi pihak ejen yang bertindak bagi pihak orang itu. Perlindungan Pengawal, Timbalan Pengawal, Penolong Pengawal atau mana-mana orang lain"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_139",
      "@type": "akn:clause",
      "eli:number": "139",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_139__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_139__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada tindakan atau pendakwaan boleh dibawa, dimulakan atau dikekalkan dalam mana-mana mahkamah terhadap—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_139__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_139",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengawal, Timbalan Pengawal, Penolong Pengawal atau mana-mana orang lain berkenaan dengan apa-apa perbuatan yang diperintahkan atau yang dilakukan bagi maksud melaksanakan Akta ini; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_139__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_139",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang lain berkenaan dengan apa-apa perbuatan yang dilakukan atau berupa sebagai dilakukan olehnya di bawah perintah, arahan atau suruhan Pengawal jika perbuatan itu dilakukan dengan suci hati dan kepercayaan munasabah bahawa ia perlu bagi maksud yang dihasratkan untuk dicapai dengannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100",
      "@type": "akn:clause",
      "eli:number": "100",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini dan seksyen 102, seseorang dengan salah memakaikan suatu cap dagangan berdaftar pada barang-barang atau perkhidmatan itu apabila—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dia memakaikan cap dagangan atau tanda yang mungkin menyebabkan kesilapan cap dagangan itu dengan barang-barang atau perkhidmatan tanpa persetujuan tuan punya cap dagangan berdaftar; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal pemakaian pada barang-barang, barang-barang itu bukan barang-barang tulen tuan punya berdaftar atau pemegang lesen cap dagangan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud subseksyen (1), suatu cap dagangan hendaklah disifatkan dipakaikan pada barang-barang atau perkhidmatan jika ia digunakan dalam—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa tanda atau iklan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa invois, katalog, surat perniagaan, kertas perniagaan, senarai harga atau dokumen komersial lain, termasuk apa-apa dokumen sedemikian dalam apa-apa medium, dan barang-barang itu dihantar, atau perkhidmatan yang disediakan, kepada seseorang menurut permintaan atau perintah yang dibuat dengan merujuk kepada cap dagangan sebagaimana yang digunakan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud subseksyen (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_3__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_3__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu tanda hendaklah disifatkan dipakaikan pada barang- barang jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_3__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_3__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "ia dipakaikan pada barang-barang itu sendiri; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_3__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_3__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "ia dipakaikan pada apa-apa pembalut, label, gelendong atau benda di dalam atau dengan yang barang-barang itu dijual, ditawarkan atau didedahkan bagi jualan atau dalam milikan bagi maksud perdagangan atau pengilangan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu tanda hendaklah disifatkan sebagai dipakaikan pada barang-barang atau perkhidmatan jika ia digunakan dalam cara yang mungkin membawa orang untuk mempercayai bahawa ia merujuk, memperihalkan atau menamakan barang-barang atau perkhidmatan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang dengan salah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_4__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_4__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "memakaikan cap dagangan berdaftar pada barang-barang di bawah subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_4__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_4__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "jika orang itu ialah suatu pertubuhan perbadanan, didenda tidak melebihi lima belas ribu ringgit bagi setiap barang-barang yang diletakkan suatu cap dagangan berdaftar yang dipakaikan dengan salah, dan bagi kesalahan yang kedua atau yang berikutnya, didenda tidak melebihi tiga puluh ribu ringgit bagi setiap barang-barang yang diletakkan suatu cap dagangan berdaftar yang dipakaikan dengan salah; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_4__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_4__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "jika orang itu bukan suatu pertubuhan perbadanan, didenda tidak melebihi sepuluh ribu ringgit bagi setiap barang-barang yang diletakkan suatu cap dagangan berdaftar yang dipakaikan dengan salah atau dipenjarakan selama tempoh tidak melebihi tiga tahun atau kedua-duanya, dan bagi kesalahan kedua atau yang berikutnya, didenda tidak melebihi dua puluh ribu ringgit bagi setiap barang yang diletakkan suatu cap dagangan berdaftar yang dipakaikan dengan salah, atau dipenjarakan selama tempoh tidak melebihi lima tahun atau kedua-duanya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_4__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_4__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "memakaikan cap dagangan berdaftar pada perkhidmatan di bawah subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_4__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_4__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "jika orang itu ialah suatu pertubuhan perbadanan, didenda tidak melebihi satu ratus ribu ringgit; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_4__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_4__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "jika orang itu bukan suatu pertubuhan perbadanan, didenda tidak melebihi tujuh puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tiga tahun."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam subseksyen (3)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "“label” termasuklah apa-apa gegelang atau tiket; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "“pembalut” termasuk apa-apa penyumbat, kaca, botol, bekas, kotak, kapsul, sarung, bingkai atau pembungkus."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_100",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam suatu pendakwaan di bawah seksyen ini, beban untuk membuktikan persetujuan tuan punya berdaftar cap dagangan itu hendaklah terletak pada tertuduh. Membuat atau memiliki artikel untuk melakukan kesalahan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_101",
      "@type": "akn:clause",
      "eli:number": "101",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_101__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_101__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV",
      "schema:name": {
        "@language": "ms",
        "@value": "Mana-mana orang yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_101__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_101",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat suatu artikel yang direka atau disesuaikan secara spesifik untuk membuat salinan cap dagangan berdaftar atau tanda yang mungkin menyebabkan kesilapan bagi cap dagangan itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_101__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_101",
      "schema:text": {
        "@language": "ms",
        "@value": "mempunyai dalam milikan, jagaan atau kawalannya apa-apa artikel sebagaimana dalam perenggan (a), mengetahui atau mempunyai sebab untuk mempercayai bahawa ia telah, atau akan, digunakan untuk, atau dalam penjalanan melakukan suatu kesalahan terhadap seksyen 99 dan 100, melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi satu juta ringgit atau dipenjarakan selama tempoh tidak melebihi lima tahun atau kedua-duanya. Mengimport atau menjual dsb., barang-barang dengan cap dagangan yang dipakaikan dengan salah"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_102",
      "@type": "akn:clause",
      "eli:number": "102",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_102__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_102__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_102__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_102__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_102__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_102__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_102",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_102__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_102__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mengimport ke Malaysia bagi maksud perdagangan atau pengilangan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_102__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_102__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menjual atau menawarkan atau mendedahkan bagi jualan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_102__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_102__subsec_1__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_102__subsec_1__para_c__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_102__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mempunyai dalam milikan, jagaan atau kawalannya bagi maksud perdagangan atau pengilangan, apa-apa barang-barang yang suatu cap dagangan berdaftar dipakaikan dengan salah di bawah seksyen 100, melainkan jika dia membuktikan bahawa telah mengambil segala langkah berjaga-jaga yang munasabah terhadap melakukan suatu kesalahan di bawah seksyen ini, dia telah, pada masa pelakuan kesalahan yang dikatakan itu, tiada sebab untuk mengesyaki ketulenan cap dagangan dan atas permintaan yang dibuat oleh Penolong Pengawal, dia memberikan semua maklumat dalam pengetahuannya berkenaan dengan orang-orang yang daripadanya dia memperoleh barang itu, melakukan suatu kesalahan dan boleh, apabila disabitkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_102__subsec_1__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_102__subsec_1__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "jika orang itu ialah suatu pertubuhan perbadanan, didenda tidak melebihi lima belas ribu ringgit bagi setiap barang-barang yang dipakaikan dengan salah cap dagangan itu, dan bagi kesalahan kedua atau yang berikutnya, didenda tidak melebihi tiga puluh ribu ringgit bagi setiap barang-barang cap dagangan berdaftar yang dipakai dengan salah itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_102__subsec_1__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_102__subsec_1__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "jika orang itu bukan suatu pertubuhan perbadanan, didenda tidak melebihi sepuluh ribu ringgit bagi setiap barang-barang yang dipakaikan dengan salah cap dagangan berdaftar atau dipenjarakan selama tempoh tidak melebihi tiga tahun atau kedua-duanya, dan bagi kesalahan kedua atau yang berikutnya, didenda tidak melebihi dua puluh ribu ringgit bagi setiap barang-barang yang dipakaikan dengan salah cap dagangan berdaftar, atau dipenjarakan selama tempoh tidak melebihi lima tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_102__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_102",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud perenggan (1)(c), seseorang yang mempunyai dalam milikannya tiga barang atau lebih barang-barang yang dipakaikan dengan salah cap dagangan berdaftar itu disifatkan sebagai mempunyai dalam milikan barang-barang bagi maksud perdagangan atau pengilangan. Catatan palsu kepada Pejabat Cap Dagangan atau dalam Daftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_103",
      "@type": "akn:clause",
      "eli:number": "103",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_103__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_103__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_103__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_103__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV",
      "schema:name": {
        "@language": "ms",
        "@value": "Mana-mana orang yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_103__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_103",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat atau menyebabkan dibuat suatu catatan palsu kepada Pejabat Cap Dagangan atau dalam Daftar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_103__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_103",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat atau menyebabkan dibuat suatu catatan palsu dalam mana-mana salinan yang diperakui yang disimpan di Pejabat Cap Dagangan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_103__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_103",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat atau menyebabkan dibuat apa-apa suatu benda palsu yang berupa sebagai suatu salinan catatan dalam Daftar atau untuk difailkan dengan Pejabat Cap Dagangan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_103__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_103",
      "schema:text": {
        "@language": "ms",
        "@value": "mengemukakan atau memberikan atau menyebabkan dikemukakan atau diberikan sebagai keterangan apa-apa benda yang disebut dalam perenggan (c), mengetahui atau mempunyai alasan untuk mempercayai bahawa catatan atau benda itu palsu, melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi lima tahun atau kedua-duanya. Menyatakan dengan palsu cap dagangan sebagai berdaftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_104",
      "@type": "akn:clause",
      "eli:number": "104",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_104__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_104__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_104__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_104__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_104__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_104",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_104__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_104__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menyatakan dengan palsu bahawa cap dagangan itu ialah cap dagangan berdaftar; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_104__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_104__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat penyataan palsu mengenai barang-barang atau perkhidmatan yang cap dagangan itu berdaftar, mengetahui atau mempunyai sebab untuk mempercayai bahawa pernyataan itu palsu melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi sepuluh ribu ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_104__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_104",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini, penggunaan dalam penjalanan perdagangan di Malaysia berhubung dengan suatu cap dagangan bagi perkataan “berdaftar” atau apa-apa perkataan atau simbol lain yang membawa sebutan secara nyata atau tersirat bagi pendaftaran, hendaklah disifatkan sebagai pernyataan mengenai pendaftaran di bawah Akta ini melainkan jika ditunjukkan bahawa sebutan itu adalah untuk pendaftaran di tempat lain selain di dalam Malaysia dan bahawa cap dagangan itu sebenarnya telah didaftarkan bagi barang-barang atau perkhidmatan dalam persoalan. Kesalahan yang berhubungan dengan ketidakpatuhan terhadap saman atau keengganan untuk memberikan keterangan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_105",
      "@type": "akn:clause",
      "eli:number": "105",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_105__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_105__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_105__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_105__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_105__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_105__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_105",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar boleh, bagi maksud Akta ini—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_105__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_105__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "memanggil saksi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_105__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_105__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menerima keterangan atas sumpah; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_105__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_105__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menghendaki pengemukaan suatu dokumen atau artikel."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_105__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_105",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang mengingkari suatu saman atau permintaan di bawah subseksyen (1) tanpa apa-apa sebab yang sah di sisi undang-undang melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi dua ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tiga bulan atau kedua-duanya. Menyatakan dengan palsu cap dagangan itu sebagai pendaftaran antarabangsa terlindung yang menamakan Malaysia"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_106",
      "@type": "akn:clause",
      "eli:number": "106",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_106__subsec_1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_106__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_106__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_106__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_106",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_106__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_106__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Menyatakan dengan palsu suatu cap dagangan sebagai pendaftaran antarabangsa terlindung yang menamakan Malaysia; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_106__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_106__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat pernyataan palsu mengenai barang-barang atau perkhidmatan yang pendaftaran antarabangsa terlindung yang menamakan Malaysia memberikan perlindungan di dalam Malaysia, mengetahui atau mempunyai sebab untuk mempercayai bahawa pernyataan itu palsu melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi sepuluh ribu ringgit. Penyalahgunaan nama “Pejabat Cap Dagangan”"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_107",
      "@type": "akn:clause",
      "eli:number": "107",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang menggunakan di tempat perniagaannya atau apa-apa dokumen yang dikeluarkan olehnya atau sebaliknya, perkataan “Pejabat Cap Dagangan” atau apa-apa perkataan lain yang mencadangkan bahawa tempat perniagaannya ialah, atau secara rasminya berkaitan dengan, Pejabat Cap Dagangan melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi dua tahun atau kedua-duanya. Orang yang tidak berdaftar yang mengamalkan, dsb., sebagai ejen cap dagangan berdaftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_108",
      "@type": "akn:clause",
      "eli:number": "108",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang menjalankan perniagaan, beramal, bertindak, memperihalkan dirinya, mengaku dirinya atau membenarkan dirinya diperihalkan atau diakui, sebagai ejen cap dagangan tanpa didaftarkan di bawah Akta ini melakukan suatu kesalahan dan hendaklah, apabila disabitkan, didenda tidak melebihi lima puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi dua tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_99",
      "@type": "akn:clause",
      "eli:number": "99",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_99__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_99__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_99__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_99__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_99__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_99",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melancungkan suatu cap dagangan berdaftar dengan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_99__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_99__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat suatu tanda yang serupa atau hampir serupa dengan cap dagangan berdaftar dengan niat untuk menipu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_99__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_99__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "memalsukan cap dagangan berdaftar tulen, sama ada dengan perubahan, penambahan, pemadaman, penghapusan separa atau sebaliknya, tanpa persetujuan tuan punya berdaftar cap dagangan itu melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi satu juta ringgit atau dipenjarakan selama tempoh tidak melebihi lima tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_99__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV__cl_99",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam suatu pendakwaan di bawah seksyen ini, beban untuk membuktikan persetujuan tuan punya berdaftar cap dagangan itu hendaklah terletak pada tertuduh. Memakaikan dengan salah suatu cap dagangan pada barang-barang atau perkhidmatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_68",
      "@type": "akn:clause",
      "eli:number": "68",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_68__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_68__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X",
      "schema:name": {
        "@language": "ms",
        "@value": "Dalam Bahagian ini—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_68__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_68",
      "schema:text": {
        "@language": "ms",
        "@value": "“lesen” termasuklah suatu sublesen dan “pemegang lesen” hendaklah ditafsirkan dengan sewajarnya dan sebutan mengenai suatu lesen atau pemegang lesen termasuk sebutan mengenai suatu sublesen atau pemegang lesen; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_68__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_68",
      "schema:text": {
        "@language": "ms",
        "@value": "“lesen eksklusif” ertinya suatu lesen, sama ada umum atau terhad, yang membenarkan pemegang lesen, sehingga mengetepikan semua orang lain termasuk orang yang memberikan lesen itu, menggunakan cap dagangan berdaftar itu mengikut cara yang dibenarkan oleh lesen itu, dan ungkapan “pemegang lesen eksklusif” hendaklah ditafsirkan sewajarnya. Pelesenan cap dagangan berdaftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_69",
      "@type": "akn:clause",
      "eli:number": "69",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_69__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_69__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_69__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_69__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_69__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_69__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_69__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_69__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_69",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu lesen untuk menggunakan cap dagangan berdaftar boleh jadi umum atau terhad."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_69__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_69__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_69__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_69",
      "schema:text": {
        "@language": "ms",
        "@value": "Lesen terhad boleh terpakai—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_69__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_69__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "berhubungan dengan beberapa tetapi bukan semua barang-barang atau perkhidmatan yang baginya cap dagangan itu didaftarkan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_69__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_69__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "berhubungan dengan penggunaan cap dagangan mengikut cara tertentu atau tempat tertentu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_69__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_69",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu lesen tidak boleh berkuat kuasa melainkan jika lesen itu dalam bentuk bertulis dan ditandatangani oleh atau bagi pihak pemberi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_69__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_69__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_69__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_69",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu lesen untuk menggunakan cap dagangan berdaftar hendaklah mengikat setiap pengganti dalam hakmilik kepada kepentingan pihak pemberi—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_69__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_69__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "kecuali mana-mana orang yang, dengan suci hati dan tanpa apa-apa notis, sebenar atau konstruktif, mengenai lesen itu, telah memberikan balasan yang berharga bagi kepentingan dalam cap dagangan berdaftar itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_69__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_69__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "melainkan jika lesen itu memperuntukkan selainnya, dan apa-apa sebutan mengenai melakukan apa-apa dengan, atau tanpa, persetujuan tuan punya berdaftar cap dagangan hendaklah ditafsirkan dengan sewajarnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_69__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_69",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap orang hendaklah disifatkan mempunyai notis mengenai suatu lesen jika butir-butir yang ditentukan oleh Pendaftar mengenai pemberian lesen itu dicatatkan dalam Daftar di bawah subseksyen 65(1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_69__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_69",
      "schema:text": {
        "@language": "ms",
        "@value": "Sekiranya lesen memperuntukkan sedemikian, suatu sublesen boleh diberikan oleh pemegang lesen."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_69__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_69",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen ini hendaklah terpakai, dengan pengubahsuaian yang perlu, bagi suatu lesen eksklusif. Hak pemegang lesen dalam hal pelanggaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_70",
      "@type": "akn:clause",
      "eli:number": "70",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_70__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_70__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_70__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_70__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_70__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_70__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_70__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_70__subsec_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_70__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_70",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen ini berkuat kuasa berkenaan dengan hak pemegang lesen berhubung dengan pelanggaran cap dagangan berdaftar kecuali bagi seseorang pemegang lesen eksklusif di bawah subseksyen 71(1) dan (2), pemegang lesen berhak untuk membawa prosiding pelanggaran atas namanya sendiri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_70__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_70",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pemegang lesen adalah berhak, melainkan jika lesennya atau mana-mana lesen yang dalamnya kepentingannya diperoleh, memperuntukkan selainnya, untuk meminta tuan punya berdaftar cap dagangan itu untuk mengambil prosiding pelanggaran berkenaan dengan apa-apa perkara yang menyentuh kepentingannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_70__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_70",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud subseksyen (2), jika tuan punya berdaftar enggan atau tidak membawa prosiding pelanggaran dalam masa dua bulan selepas diminta, pemegang lesen boleh membawa prosiding itu atas namanya sendiri seolah-olah dia ialah tuan punya berdaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_70__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_70",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika prosiding pelanggaran dibawa oleh seseorang pemegang lesen menurut seksyen ini, pemegang lesen itu tidak boleh, tanpa kebenaran Mahkamah, meneruskan tindakan itu melainkan jika tuan punya berdaftar itu dimasukkan sama ada sebagai plaintif atau ditambah sebagai defendan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_70__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_70",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen (4) tidak menyentuh pemberian relief interlokutori ke atas suatu permohonan oleh pemegang lesen bersendirian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_70__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_70",
      "schema:text": {
        "@language": "ms",
        "@value": "Seorang tuan punya berdaftar yang ditambah sebagai defendan di bawah subseksyen (4) tidak boleh dipertanggungkan dengan apa-apa kos dalam tindakan itu melainkan jika dia mengambil bahagian dalam prosiding itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_70__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_70",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam prosiding pelanggaran yang dibawa oleh tuan punya berdaftar, apa-apa kerugian yang dialami atau berkemungkinan dialami oleh seseorang pemegang lesen hendaklah diambil kira dan Mahkamah boleh memberikan apa-apa arahan sebagaimana yang difikirkan patut oleh Mahkamah setakat yang plaintif memegang hasil apa-apa remedi kewangan bagi pihak seorang pemegang lesen."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_70__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_70",
      "schema:text": {
        "@language": "ms",
        "@value": "Peruntukan seksyen ini terpakai berhubung dengan pemegang lesen eksklusif jika atau setakat yang dia ada, di bawah subseksyen 71(1) dan (2), hak dan remedi pemegang serah hak seolah-olah dia ialah tuan punya berdaftar cap dagangan itu. Pemegang lesen eksklusif mempunyai hak dan remedi pemegang serah hak"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_71",
      "@type": "akn:clause",
      "eli:number": "71",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_71__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_71__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_71__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_71__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_71__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_71__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_71__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_71__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_71__subsec_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_71__subsec_10"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_71__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_71",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu lesen eksklusif boleh memperuntukkan bahawa pemegang lesen hendaklah, setakat yang diperuntukkan oleh lesen itu, hak dan remedi yang sama berkenaan dengan perkara yang berlaku selepas pemberian lesen seolah-olah lesen itu telah menjadi suatu penyerahhakan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_71__subsec_10",
      "@type": "akn:subsection",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_71",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen (5) hingga (8) berkuat kuasa tertakluk kepada apa-apa perjanjian yang bertentangan antara pemegang lesen eksklusif dengan tuan punya berdaftar cap dagangan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_71__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_71",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika atau setakat peruntukan yang disebut dalam subseksyen (1), pemegang lesen adalah berhak, tertakluk kepada peruntukan lesen dan seksyen ini, untuk membawa prosiding pelanggaran terhadap mana-mana orang selain tuan punya berdaftar, atas namanya sendiri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_71__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_71",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana hak dan remedi hak pemegang lesen eksklusif adalah bersamaan dengan tuan punya berdaftar dan sebutan mengenai tuan punya berdaftar yang berhubungan dengan pelanggaran hendaklah ditafsirkan dengan sewajarnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_71__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_71",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam suatu tindakan yang dibawa oleh pemegang lesen eksklusif di bawah seksyen ini, seorang defendan boleh menggunakan untuk dirinya apa-apa pembelaan yang boleh digunakan olehnya seolah-olah tindakan itu dibawa oleh tuan punya berdaftar cap dagangan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_71__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_71",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika prosiding bagi pelanggaran cap dagangan berdaftar yang dibawa oleh tuan punya berdaftar atau pemegang lesen eksklusif itu berkaitan keseluruhannya atau sebahagiannya dengan suatu pelanggaran yang berkenaan dengannya mereka mempunyai hak tindakan bersama, tuan punya berdaftar atau pemegang lesen eksklusif itu tidak boleh, tanpa kebenaran Mahkamah, meneruskan tindakan itu melainkan jika yang satu sama ada dimasukkan sebagai plaintif atau ditambah sebagai defendan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_71__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_71",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen (5) tidak menyentuh pemberian relief interlokutori atas permohonan oleh tuan punya berdaftar cap dagangan atau pemegang lesen eksklusif bersendirian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_71__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_71",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang ditambah sebagai defendan di bawah subseksyen (4) tidaklah boleh dikenakan apa-apa kos dalam tindakan itu melainkan jika dia mengambil bahagian dalam prosiding itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_71__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_71__subsec_8__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_71__subsec_8__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_71__subsec_8__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_71",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu tindakan bagi pelanggaran suatu cap dagangan berdaftar yang dibawa berkaitan secara keseluruhannya atau sebahagiannya dengan pelanggaran yang berkenaan dengannya tuan punya berdaftar dan pemegang lesen eksklusif mempunyai atau pernah mempunyai hak tindakan bersama—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_71__subsec_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_71__subsec_8__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_71__subsec_8__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_71__subsec_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Mahkamah hendaklah menilai ganti rugi dengan mengambil kira—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_71__subsec_8__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_71__subsec_8__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "syarat lesen; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_71__subsec_8__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_71__subsec_8__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa remedi kewangan yang telah diawardkan atau tersedia kepada mana-mana daripada mereka berkenaan dengan pelanggaran itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_71__subsec_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_71__subsec_8",
      "schema:text": {
        "@language": "ms",
        "@value": "tiada akaun keuntungan boleh diarahkan sekiranya award ganti rugi telah dibuat, atau akaun keuntungan telah diarahkan, dengan memihak kepada orang yang lain berkenaan dengan pelanggaran itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_71__subsec_8__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_71__subsec_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Mahkamah hendaklah, jika suatu akaun keuntungan diarahkan, membahagikan keuntungan antara mereka sebagaimana yang difikirkan adil oleh Mahkamah, tertakluk kepada apa-apa perjanjian antara mereka."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_71__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_X__cl_71",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen (8) hendaklah terpakai sama ada atau tidak tuan punya berdaftar dan pemegang lesen eksklusif kedua-dua merupakan pihak dalam tindakan itu, dan jika kedua-duanya bukan merupakan pihak, Mahkamah boleh memberikan apa-apa arahan sebagaimana yang difikirkan patut olehnya setakat yang pihak kepada prosiding itu memegang hasil apa-apa remedi kewangan bagi pihak yang lain."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_11",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_12"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "[Seksyen 72] CAP KOLEKTIF Tafsiran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_1",
      "@type": "akn:paragraph",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1",
      "schema:name": {
        "@language": "ms",
        "@value": "Dalam Jadual ini—"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "“persatuan” ertinya suatu organisasi yang didaftarkan dengan sewajarnya mengikut undang-undang penubuhannya tetapi tidak diperbadankan mengikut undang-undang yang berhubungan dengan syarikat, dan termasuklah kelab, kesatuan sekerja dan pertubuhan yang diperbadankan dengan sewajarnya. Tanda yang cap kolektif boleh terdiri daripada"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_10",
      "@type": "akn:paragraph",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Seorang anggota persatuan yang atas namanya suatu cap kolektif itu didaftarkan tidak mempunyai hak untuk menghalang anggota lain persatuan itu daripada menggunakan cap kolektif itu mengikut kaedah-kaedah persatuan. Alasan bagi pembatalan pendaftaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_11",
      "@type": "akn:paragraph",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_11__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_11__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_11__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Sebagai tambahan kepada alasan pembatalan yang diperuntukkan dalam seksyen 45 dan 46, pendaftaran suatu cap kolektif boleh dibatalkan oleh Mahkamah atas alasan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_11__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_11",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa cara cap kolektif itu telah digunakan oleh tuan punya telah menyebabkan ia bertanggungan untuk mengelirukan orang awam mengikut cara yang disebut dalam subperenggan 4(1);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_11__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_11",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa tuan punya tidak menuruti, atau memastikan pematuhan, kaedah-kaedah yang mengawal penggunaan cap kolektif itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_11__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_11__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_11__para_c__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_11__para_c__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_11__para_c__subpara_iv"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_11",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa pindaan kepada kaedah-kaedah yang difailkan oleh tuan punya berdaftar—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_11__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_11__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak lagi mematuhi subperenggan 5(2), (3) dan (4);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_11__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_11__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "bertentangan dengan kepentingan awam atau moral;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_11__para_c__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_11__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak mengandungi atau terdiri daripada apa-apa perkara skandal atau yang menyalahi atau sebaliknya tidak berhak untuk mendapat perlindungan oleh mana-mana mahkamah undang-undang; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_11__para_c__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_11__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak mengandungi suatu perkara yang pada pendapat Pendaftar adalah atau mungkin memudaratkan kepentingan awam atau keselamatan negara. Alasan bagi ketidaksahan pendaftaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_12",
      "@type": "akn:paragraph",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Sebagai tambahan kepada alasan ketidaksahan yang diperuntukkan dalam seksyen 47, pendaftaran suatu cap kolektif boleh diisytiharkan tidak sah oleh Mahkamah atas alasan bahawa cap kolektif didaftarkan dengan melanggar peruntukan subperenggan 4(1) atau subperenggan 6(1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_2",
      "@type": "akn:paragraph",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Berhubung dengan suatu cap kolektif, sebutan dalam takrif cap dagangan di bawah seksyen 3 yang membezakan barang-barang atau perkhidmatan satu perusahaan daripada perusahaan-perusahaan yang lain hendaklah ditafsirkan sebagai sebutan untuk membezakan barang-barang atau perkhidmatan anggota persatuan yang merupakan tuan punya cap kolektif daripada anggota persatuan yang lain. Cap kolektif yang terdiri daripada petunjuk geografi"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_3",
      "@type": "akn:paragraph",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_3__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_3__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_3__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_3__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_3__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_3__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun perenggan 23(1)(c), 4(a) dan (b), suatu cap kolektif yang terdiri daripada petunjuk geografi boleh didaftarkan sebagai cap kolektif, bagi menetapkan tempat asal geografi barang-barang atau perkhidmatan tertakluk kepada alasan yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_3__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_3__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "ia mengandungi suatu terma individu daripada terma berbilang komponen, yang serupa dengan nama umum apa-apa barang-barang atau perkhidmatan di Malaysia, jika pendaftaran bagi cap kolektif itu dimohon berhubung dengan barang-barang atau perkhidmatan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_3__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_3__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "ia mengandungi suatu nama varieti tumbuhan atau suatu baka haiwan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_3__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_3__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "barang-barang atau perkhidmatan itu tidak berasal dari negara, rantau atau lokaliti yang ditunjukkan dalam subsubperenggan 5(3)(a);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_3__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_3__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "penggunaan cap kolektif berhubung dengan barang-barang atau perkhidmatan yang bersifat sedemikian rupa sehingga mengelirukan orang awam tentang tempat asalnya yang sebenar; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_3__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_3__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika wujud kebarangkalian kekeliruan di pihak orang awam disebabkan petunjuk geografi itu serupa dengan atau hampir serupa, dan mempunyai tempat asal geografi yang sama seperti, suatu petunjuk geografi terdahulu yang telah didaftarkan di bawah Akta Petunjuk Geografi 2000."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Tuan punya berdaftar suatu cap kolektif di bawah subperenggan (1) tidak berhak untuk melarang penggunaan tanda atau petunjuk asal geografi mengikut amalan jujur dalam perkara perindustrian atau komersial termasuk oleh seseorang yang berhak untuk menggunakan nama geografi itu, dengan syarat bahawa penggunaannya oleh seseorang yang menjalankan aktivitinya di dalam kawasan geografi yang dinyatakan dalam Daftar yang hendaklah berkenaan dengan barang-barang atau perkhidmatan yang dinyatakan dalam Daftar mengikut kualiti, reputasi atau ciri-ciri yang dinyatakan dalam Daftar. Cap kolektif tidak boleh mengelirukan mengenai ciri-ciri atau signifikan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_4",
      "@type": "akn:paragraph",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_4__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_4__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu cap kolektif tidak boleh didaftarkan jika orang awam mungkin dikelirukan mengenai ciri-ciri atau signifikan cap kolektif itu, terutamanya jika cap kolektif itu mungkin dikira sebagai sesuatu selain daripada cap kolektif."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud subperenggan (1), Pendaftar boleh menghendaki bahawa suatu cap kolektif yang berkenaan dengannya permohonan itu dibuat bagi pendaftaran termasuk beberapa petunjuk bahawa ia ialah cap kolektif."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_4__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun seksyen 33, suatu permohonan boleh dipinda supaya mematuhi apa-apa kehendak lain. Kaedah-kaedah yang mengawal penggunaan cap kolektif"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_5",
      "@type": "akn:paragraph",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_5__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_5__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_5__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Sebagai tambahan kepada kehendak di bawah seksyen 17, pemohon suatu cap kolektif hendaklah memfailkan kaedah-kaedah yang mengawal penggunaan cap kolektif dengan Pendaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_5__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_5__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_5__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_5__subsec_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Kaedah-kaedah di bawah subperenggan (1) hendaklah menyatakan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_5__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "orang yang dibenarkan untuk menggunakan cap kolektif;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_5__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "syarat keanggotaan persatuan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_5__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "syarat penggunaan cap kolektif, jika ada; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_5__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa sekatan terhadap penyalahgunaan cap kolektif, jika ada."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_5__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_5__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_5__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_5__subsec_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_5__subsec_3__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Sebagai tambahan kepada subperenggan (2), jika permohonan cap kolektif terdiri daripada petunjuk geografi di bawah subperenggan 3(1), pemohon hendaklah memfailkan kaedah-kaedah yang menyatakan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_5__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_5__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa negara, rantau atau lokaliti yang barang-barang atau perkhidmatan itu berasal;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_5__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_5__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "kualiti, reputasi atau ciri-ciri lain barang-barang atau perkhidmatan yang pada dasarnya boleh dikaitkan dengan tempat asal geografinya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_5__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_5__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "perlindungan atau pendaftaran sedia ada bagi petunjuk geografi di dalam negara, rantau atau lokaliti tempat asal itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_5__subsec_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_5__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "penggunaan petunjuk geografi di dalam negara itu, rantau atau lokaliti tempat asal itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_5__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud subperenggan (2) dan (3), Pendaftar boleh menghendaki kehendak lanjut untuk dinyatakan dalam kaedah-kaedah sebagaimana yang difikirkannya patut. Kelulusan kaedah-kaedah dan permohonan bagi pendaftaran cap kolektif"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_6",
      "@type": "akn:paragraph",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_6__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_6__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_6__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_6__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_6__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_6__subsec_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_6__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_6__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_6__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_6__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Cap kolektif tidak boleh didaftarkan melainkan jika kaedah-kaedah yang mengawal penggunaan cap kolektif—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_6__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_6__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menyatakan semua kehendak yang terkandung dalam subperenggan 5(2), (3) dan (4);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_6__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_6__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak bertentangan dengan kepentingan awam atau moral;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_6__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_6__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak mengandungi atau terdiri daripada apa-apa perkara skandal atau yang menyalahi atau yang sebaliknya tidak berhak mendapat perlindungan oleh mana-mana mahkamah undang-undang; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_6__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_6__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak mengandungi perkara yang pada pendapat Pendaftar adalah atau mungkin memudaratkan kepentingan atau keselamatan negara."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Pemohon hendaklah memfailkan kaedah-kaedah di bawah perenggan 5 kepada Pendaftar dalam tempoh sebagaimana yang ditetapkan dan jika pemohon tidak berbuat demikian, permohonan bagi pendaftaran cap kolektif hendaklah disifatkan ditarik balik."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar hendaklah menimbangkan sama ada kehendak di bawah subperenggan (1) dipenuhi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_6__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika didapati oleh Pendaftar bahawa kehendak di bawah subperenggan (1) tidak dipenuhi, dia hendaklah memberitahu pemohon dan memberinya peluang dalam tempoh yang ditentukan oleh Pendaftar, untuk membuat representasi atau memfailkan kaedah-kaedah yang dipinda."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_6__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika pemohon memberi jawapan dalam tempoh sebagaimana yang ditentukan oleh Pendaftar tetapi gagal untuk memuaskan Pendaftar bahawa kehendak di bawah subperenggan (1) dipenuhi, atau untuk memfailkan kaedah-kaedah yang telah dipinda supaya memenuhi kehendak itu, Pendaftar boleh menolak permohonan bagi pendaftaran cap kolektif."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_6__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika pemohon gagal menjawab dalam tempoh yang dinyatakan, permohonan bagi pendaftaran cap kolektif hendaklah disifatkan ditarik balik."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_6__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika didapati oleh Pendaftar bahawa kehendak di bawah subperenggan (1) dan kehendak bagi pendaftaran di bawah Bahagian IV, dipenuhi, Pendaftar hendaklah menerima permohonan itu dan hendaklah meneruskan permohonan itu mengikut seksyen 31 dan 35."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_6__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Kaedah-kaedah itu hendaklah disiarkan mengikut seksyen 31 dan notis bangkangan boleh diberikan berhubungan dengan perkara di bawah subperenggan (1), sebagai tambahan kepada apa-apa alasan lain yang permohonannya mungkin dibangkang. Pemeriksaan kaedah-kaedah"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_7",
      "@type": "akn:paragraph",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Kaedah-kaedah yang mengawal penggunaan cap kolektif berdaftar hendaklah terbuka kepada pemeriksaan awam dengan cara yang sama seperti Daftar di bawah seksyen 15. Pindaan kaedah-kaedah cap kolektif berdaftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_8",
      "@type": "akn:paragraph",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_8__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_8__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Pindaan kaedah-kaedah yang mengawal penggunaan cap kolektif berdaftar tidak berkuat kuasa melainkan jika kaedah-kaedah yang dipinda difailkan dengan Pendaftar mengikut bentuk yang ditentukan oleh Pendaftar bersama dengan pembayaran fi yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar hendaklah, selepas menimbangkan kehendak di bawah subperenggan (1), menyebabkan kaedah-kaedah yang dipinda itu diterima dan disiarkan dalam Jurnal Rasmi Harta Intelek."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_8__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang boleh memfailkan suatu notis bangkangan yang berhubungan dengan perkara-perkara di bawah subperenggan 6(1) mengikut bentuk yang ditentukan oleh Pendaftar dalam tempoh yang ditetapkan selepas kaedah-kaedah yang dipinda itu telah disiarkan dalam Jurnal Rasmi Harta Intelek di bawah subperenggan (2). Hak pengguna yang dibenarkan berkaitan dengan prosiding pelanggaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_9",
      "@type": "akn:paragraph",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_9__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_9__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_9__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_9__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_9__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Peruntukan yang berikut hendaklah terpakai berhubung dengan pengguna cap kolektif berdaftar yang berhubung dengan pemegang lesen cap dagangan:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_9__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_9__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "subseksyen 54(4);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_9__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_9__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "subseksyen 60(2);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_9__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_9__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "seksyen 70; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_9__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_9__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "seksyen 87."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_1__para_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam prosiding pelanggaran yang dibawa oleh tuan punya berdaftar suatu cap kolektif, apa-apa kerugian yang dialami atau mungkin dialami oleh pengguna yang dibenarkan hendaklah diambil kira dan Mahkamah boleh memberikan apa-apa arahan sebagaimana yang difikirkannya patut setakat yang plaintif memegang apa-apa hasil remedi kewangan bagi pihak pengguna itu. Pengehadan atas hak yang diberikan oleh cap kolektif berdaftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2",
      "@type": "akn:schedule",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_11",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_12"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "[Seksyen 73] CAP PERAKUAN Tanda yang cap perakuan boleh terdiri daripada"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_1",
      "@type": "akn:paragraph",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Berhubung dengan suatu cap perakuan, sebutan dalam takrif cap dagangan di bawah seksyen 3 untuk membezakan barang-barang atau perkhidmatan satu perusahaan daripada perusahaan-perusahaan yang lain hendaklah ditafsirkan sebagai sebutan untuk membezakan barang-barang atau perkhidmatan yang diperakui daripadan yang tidak diperakui. Cap perakuan yang terdiri daripada petunjuk geografi"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_10",
      "@type": "akn:paragraph",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_10__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_10__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_10__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_10__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Peruntukan yang berikut hendaklah terpakai berhubung dengan pengguna yang dibenarkan cap perakuan berdaftar berkenaan dengan pemegang lesen cap dagangan:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_10__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_10__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "subseksyen 54(4);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_10__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_10__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "subseksyen 60(2); dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_10__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_10__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "seksyen 87."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam prosiding pelanggaran yang dibawa oleh tuan punya berdaftar suatu cap perakuan, apa-apa kerugian yang dialami atau yang mungkin dialami oleh pengguna yang dibenarkan hendaklah diambil kira dan Mahkamah boleh memberikan apa-apa arahan sebagaimana yang difikirkannya patut setakat yang mana plaintif memegang apa-apa hasil remedi kewangan bagi pihak pengguna itu. Alasan bagi pembatalan pendaftaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_11",
      "@type": "akn:paragraph",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_11__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_11__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_11__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_11__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_11__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Sebagai tambahan kepada alasan pembatalan yang diperuntukkan dalam seksyen 45 dan 46, pendaftaran suatu cap perakuan boleh dibatalkan oleh Mahkamah atas alasan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_11__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_11",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa tuan punya berdaftar telah mula menjalankan perniagaan sedemikian di bawah perenggan 3;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_11__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_11",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa cara cap perakuan itu digunakan oleh tuan punya berdaftar telah menyebabkannya mengelirukan orang awam mengikut cara yang disebut dalam subperenggan 4(1);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_11__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_11",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa tuan punya tidak menuruti, atau memastikan pematuhan, kaedah-kaedah yang mengawal penggunaan cap perakuan itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_11__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_11__para_d__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_11__para_d__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_11__para_d__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_11__para_d__subpara_iv"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_11",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa pindaan kepada kaedah-kaedah yang difailkan oleh tuan punya berdaftar—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_11__para_d__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_11__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak lagi mematuhi subperenggan 5(2), (3) and (4);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_11__para_d__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_11__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "bertentangan dengan kepentingan awam atau moral;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_11__para_d__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_11__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak mengandungi atau terdiri daripada apa-apa perkara skandal atau yang menyalahi atau sebaliknya tidak berhak untuk mendapat perlindungan oleh mana-mana mahkamah undang-undang; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_11__para_d__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_11__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak mengandungi suatu perkara yang pada pendapat Pendaftar adalah atau mungkin memudaratkan kepentingan awam atau keselamatan negara;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_11__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_11",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa tuan punya berdaftar itu tidak lagi kompeten untuk memperakui barang-barang atau perkhidmatan yang cap perakuan itu didaftarkan. Alasan bagi ketidaksahan pendaftaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_12",
      "@type": "akn:paragraph",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_12__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_12__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_12__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Sebagai tambahan kepada alasan ketidaksahan yang diperuntukkan dalam seksyen 47, pendaftaran suatu cap perakuan boleh diisytiharkan tidak sah oleh Mahkamah atas alasan bahawa cap perakuan itu didaftarkan dengan melanggar—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_12__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_12",
      "schema:text": {
        "@language": "ms",
        "@value": "perenggan 3;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_12__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_12",
      "schema:text": {
        "@language": "ms",
        "@value": "subperenggan 4(1); atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_12__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_12",
      "schema:text": {
        "@language": "ms",
        "@value": "subperenggan 6(1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_2",
      "@type": "akn:paragraph",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_2__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_2__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_2__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_2__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_2__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_2__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_2__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun perenggan 23(1)(c), 4(a) dan (b), suatu cap perakuan yang terdiri daripada petunjuk geografi boleh didaftarkan sebagai cap perakuan, bagi menetapkan tempat asal geografi barang-barang atau perkhidmatan tertakluk kepada alasan yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_2__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_2__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "ia mengandungi suatu terma individu daripada terma berbilang komponen, yang serupa dengan nama umum apa-apa barang-barang atau perkhidmatan di Malaysia, jika pendaftaran bagi cap perakuan itu dimohon berhubung dengan barang-barang atau perkhidmatan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_2__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_2__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "ia mengandungi suatu nama varieti tumbuhan atau suatu baka haiwan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_2__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_2__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "barang-barang atau perkhidmatan itu tidak berasal dari negara, rantau atau lokaliti yang ditunjukkan dalam subsubperenggan 5(3)(a);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_2__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_2__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "penggunaan cap perakuan berhubung dengan barang-barang atau perkhidmatan yang bersifat sedemikian rupa sehingga mengelirukan orang awam tentang tempat asalnya yang sebenar; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_2__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_2__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika wujud kebarangkalian kekeliruan bagi pihak orang awam disebabkan petunjuk geografi itu serupa dengan atau hampir serupa dengan , dan mempunyai tempat asal geografi yang sama seperti, suatu petunjuk geografi terdahulu yang telah didaftarkan di bawah Akta Petunjuk Geografi 2000."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Tuan punya berdaftar suatu cap perakuan di bawah subperenggan (1) tidak berhak untuk melarang penggunaan tanda atau petunjuk asal geografi mengikut amalan jujur dalam perkara perindustrian atau komersial, dengan syarat penggunaannya oleh seseorang yang menjalankan aktivitinya di dalam kawasan geografi yang dinyatakan dalam Daftar yang hendaklah berkenaan dengan barang-barang atau perkhidmatan yang dinyatakan dalam Daftar mengikut kualiti, reputasi atau ciri-ciri yang dinyatakan dalam Daftar. Sifat perniagaan tuan punya"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_3",
      "@type": "akn:paragraph",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Cap perakuan tidak boleh didaftarkan jika tuan punya menjalankan perniagaan yang melibatkan dalam pembekalan barang-barang atau perkhidmatan yang tuan punya berdaftar itu perakukan. Cap perakuan tidak boleh mengelirukan mengenai ciri-ciri atau signifikan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_4",
      "@type": "akn:paragraph",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_4__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_4__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu cap perakuan tidak boleh didaftarkan jika orang awam mungkin dikelirukan mengenai ciri-ciri atau signifikan cap perakuan itu, terutamanya jika cap perakuan itu mungkin dikira sebagai sesuatu selain daripada cap perakuan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud subperenggan (1), Pendaftar boleh menghendaki bahawa suatu cap perakuan yang berkenaan dengan suatu permohonan itu dibuat bagi pendaftaran termasuk beberapa petunjuk bahawa ia ialah cap perakuan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_4__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen 33(3), suatu permohonan boleh dipinda supaya mematuhi apa-apa kehendak lain. Kaedah-kaedah yang mengawal penggunaan cap perakuan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_5",
      "@type": "akn:paragraph",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_5__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_5__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_5__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Sebagai tambahan kepada kehendak di bawah seksyen 17, pemohon cap perakuan hendaklah memfailkan kaedah-kaedah yang mengawal penggunaan cap perakuan dengan Pendaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_5__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_5__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_5__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_5__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_5__subsec_2__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Kaedah-kaedah di bawah subperenggan (1) hendaklah menyatakan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_5__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "orang yang dibenarkan menggunakan cap perakuan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_5__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "ciri-ciri yang diperakui oleh cap perakuan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_5__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "bagaimana tuan punya akan menguji ciri-ciri itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_5__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "bagaimana tuan punya mengawasi penggunaan cap perakuan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_5__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "prosedur untuk menyelesaikan pertikaian antara tuan punya dengan pengguna yang dibenarkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_5__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_5__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_5__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_5__subsec_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_5__subsec_3__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Sebagai tambahan kepada subperenggan (2), jika permohonan cap perakuan terdiri daripada petunjuk geografi di bawah subperenggan 2(1), pemohon hendaklah memfailkan kaedah-kaedah yang menyatakan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_5__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_5__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "negara, rantau atau lokaliti yang barang-barang atau perkhidmatan itu berasal;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_5__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_5__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "kualiti, reputasi atau ciri-ciri lain barang-barang atau perkhidmatan yang pada asasnya boleh dikaitkan dengan tempat asal geografinya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_5__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_5__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "perlindungan atau pendaftaran sedia ada petunjuk geografi di dalam negara, rantau atau lokaliti tempat asal itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_5__subsec_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_5__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "penggunaan petunjuk geografi di dalam negara itu, rantau atau lokaliti tempat asal itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_5__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud subperenggan (2) dan (3), Pendaftar boleh menghendaki kehendak lanjut untuk dinyatakan dalam kaedah-kaedah sebagaimana yang difikirkannya patut. Kelulusan kaedah-kaedah dan permohonan bagi pendaftaran cap perakuan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_6",
      "@type": "akn:paragraph",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_6__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_6__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_6__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_6__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_6__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_6__subsec_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_6__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_6__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Cap perakuan tidak boleh didaftarkan melainkan jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_6__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_6__subsec_1__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_6__subsec_1__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_6__subsec_1__para_a__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_6__subsec_1__para_a__subpara_iv"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_6__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "kaedah-kaedah yang mengawal penggunaan cap perakuan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_6__subsec_1__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_6__subsec_1__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "menyatakan semua kehendak yang terkandung dalam subperenggan 5(2), (3) dan (4);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_6__subsec_1__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_6__subsec_1__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak bertentangan dengan kepentingan awam atau moral;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_6__subsec_1__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_6__subsec_1__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak mengandungi atau terdiri daripada apa-apa perkara skandal atau yang menyalahi atau yang sebaliknya tidak berhak mendapat perlindungan oleh mana-mana mahkamah undang-undang; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_6__subsec_1__para_a__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_6__subsec_1__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak mengandungi perkara yang pada pendapat Pendaftar adalah atau mungkin memudaratkan kepentingan awam atau keselamatan negara; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_6__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_6__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pemohon adalah kompeten untuk memperakui barang-barang atau perkhidmatan yang cap perakuan itu hendak didaftarkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Pemohon hendaklah memfailkan kaedah-kaedah di bawah perenggan 5 kepada Pendaftar dalam tempoh sebagaimana yang ditetapkan dan jika pemohon tidak berbuat demikian, permohonan bagi pendaftaran cap perakuan hendaklah disifatkan ditarik balik."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar hendaklah menimbangkan sama ada kehendak di bawah subperenggan (1) dipenuhi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_6__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika didapati oleh Pendaftar bahawa kehendak di bawah subperenggan (1) tidak dipenuhi, dia hendaklah memaklumkan pemohon dan memberinya peluang dalam tempoh yang ditentukan oleh Pendaftar, untuk membuat representasi atau memfailkan kaedah-kaedah yang dipinda."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_6__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika pemohon memberi jawapan dalam tempoh sebagaimana yang ditentukan oleh Pendaftar tetapi gagal memuaskan Pendaftar bahawa kehendak di bawah subperenggan (1) dipenuhi, atau untuk memfailkan kaedah-kaedah yang telah dipinda bagi memenuhi kehendak itu, Pendaftar boleh menolak permohonan itu bagi pendaftaran cap perakuan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_6__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika pemohon gagal menjawab dalam tempoh yang dinyatakan, permohonan bagi pendaftaran cap perakuan hendaklah disifatkan ditarik balik."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_6__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika didapati oleh Pendaftar kehendak di bawah subperenggan (1) dan kehendak bagi pendaftaran di bawah Bahagian IV, dipenuhi, Pendaftar hendaklah menerima permohonan itu dan hendaklah meneruskan permohonan itu mengikut seksyen 31 dan 35."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_6__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Kaedah-kaedah itu hendaklah disiarkan mengikut seksyen 31 dan notis bangkangan boleh diberikan berhubungan dengan perkara-perkara di bawah subperenggan (1), sebagai tambahan kepada apa-apa alasan lain yang permohonannya mungkin dibangkang. Pemeriksaan kaedah-kaedah"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_7",
      "@type": "akn:paragraph",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Kaedah-kaedah yang mengawal penggunaan cap perakuan berdaftar hendaklah terbuka kepada pemeriksaan awam dengan cara yang sama seperti Daftar di bawah seksyen 15. Pindaan kaedah-kaedah cap perakuan berdaftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_8",
      "@type": "akn:paragraph",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_8__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_8__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Pindaan kaedah-kaedah yang mengawal penggunaan cap perakuan berdaftar tidak berkuat kuasa melainkan jika kaedah-kaedah yang dipinda difailkan dengan Pendaftar mengikut bentuk yang ditentukan oleh Pendaftar bersama dengan pembayaran fi yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar hendaklah, selepas menimbangkan kehendak di bawah subperenggan (1), menyebabkan kaedah-kaedah yang dipinda itu diterima dan disiarkan dalam Jurnal Rasmi Harta Intelek."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_8__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang boleh memfailkan suatu notis bangkangan yang berhubungan dengan perkara di bawah subperenggan 6(1) mengikut bentuk yang ditentukan oleh Pendaftar dalam tempoh yang ditetapkan selepas kaedah-kaedah yang dipinda itu disiarkan dalam Jurnal Rasmi Harta Intelek di bawah subperenggan (2). Persetujuan penyerahhakan cap perakuan berdaftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2__para_9",
      "@type": "akn:paragraph",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~sched_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Penyerahhakan atau perpindahan lain cap perakuan berdaftar hendaklah tidak berkuat kuasa tanpa persetujuan Pendaftar. Hak pengguna yang dibenarkan berkaitan dengan prosiding pelanggaran"
      }
    }
  ]
}
