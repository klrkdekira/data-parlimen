      "schema:text": {
        "@language": "ms",
        "@value": "PELBAGAI DAN AM Jurnal Rasmi Harta Intelek"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_148",
      "@type": "akn:clause",
      "eli:number": "148",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_148__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_148__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_148__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_148__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_148__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_148__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_148__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_148__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_148__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_148",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar hendaklah menerbitkan suatu Jurnal Rasmi Harta Intelek yang hendaklah mengandungi—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_148__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_148__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "semua perkara yang berhubungan dengan cap dagangan yang dikehendaki untuk disiarkan di bawah Akta ini; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_148__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_148__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa maklumat atau perkara lain yang berhubungan dengan cap dagangan sebagaimana yang difikirkan perlu oleh Pendaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_148__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_148",
      "schema:text": {
        "@language": "ms",
        "@value": "Jurnal Rasmi Harta Intelek hendaklah menyediakan kepada orang awam atas bayaran fi yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_148__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_148",
      "schema:text": {
        "@language": "ms",
        "@value": "Penyiaran dalam Jurnal Rasmi Harta Intelek hendaklah menjadi notis yang mencukupi mengenai apa-apa perkara yang dikehendaki untuk disiarkan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_148__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_148",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesalinan Jurnal Rasmi Harta Intelek hendaklah atas pengemukaanya diterima dalam prosiding undang-undang sebagai keterangan tanpa bukti lanjut diberikan bahawa salinan itu telah disiarkan sedemikian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_148__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_148",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesalinan Jurnal Rasmi Harta Intelek hendaklah menjadi keterangan prima facie tentang fakta yang dinyatakan dalamnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_148__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_148",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Jurnal Rasmi Harta Intelek diterbitkan dalam lebih daripada satu bentuk, tarikh penyiaran Jurnal Rasmi Harta Intelek itu hendaklah disifatkan sebagai tarikh Jurnal Rasmi Harta Intelek pertama disiarkan mengikut apa-apa jua bentuk. Pemfailan elektronik"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_149",
      "@type": "akn:clause",
      "eli:number": "149",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_149__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_149__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_149__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_149__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_149__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_149__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_149",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar boleh mengadakan suatu perkhidmatan pemfailan secara elektronik bagi dokumen yang dikehendaki oleh Akta ini untuk difailkan dengan Pendaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_149__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_149",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu dokumen yang difailkan secara elektronik di bawah seksyen ini hendaklah disifatkan telah memenuhi kehendak bagi pemfailan jika dokumen itu disampaikan atau dihantar kepada Pendaftar mengikut apa-apa cara sebagaimana ditentukan oleh Pendaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_149__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_149",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu dokumen yang dikehendaki supaya dicap, ditandatangani atau dimeterai hendaklah, jika dokumen itu difailkan secara elektronik, diperakui sebagai salinan benar atau disahkan mengikut apa-apa cara sebagaimana ditentukan oleh Pendaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_149__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_149",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu dokumen yang dikehendaki supaya ditandatangani dan diaku saksi di bawah Akta ini difailkan secara elektronik, kehendak bagi pengakuaksian tandatangan tidak terpakai."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_149__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_149",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu dokumen difailkan secara elektronik dengan Pendaftar, Pendaftar tidak bertanggungan bagi apa-apa kehilangan atau kerosakan yang dialami oleh mana-mana orang disebabkan oleh apa-apa kesalahan atau peninggalan daripada apa-apa jua jenis atau walau bagaimanapun berbangkit yang terdapat dalam mana-mana dokumen yang diperoleh oleh mana-mana orang di bawah perkhidmatan yang disebut dalam subseksyen (1), jika kesalahan atau peninggalan itu berlaku atau berbangkit akibat daripada apa-apa kecacatan atau kerosakan dalam perkhidmatan itu atau dalam kelengkapan yang digunakan bagi menyediakan perkhidmatan itu atau tanpa pengetahuan Pendaftar. Mengeluarkan dokumen secara elektronik"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_150",
      "@type": "akn:clause",
      "eli:number": "150",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar boleh, melalui cara elektronik, mengeluarkan suatu dokumen yang sepatutnya oleh Pendaftar di bawah Akta ini. Alamat untuk penyampaian"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_151",
      "@type": "akn:clause",
      "eli:number": "151",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_151__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_151__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_151__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_151__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_151__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_151__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_151__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_151__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_151",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud Akta ini, suatu alamat untuk perkhidmatan di Malaysia seorang pemohon, mana-mana orang yang menentang pendaftaran cap dagangan, mana-mana orang lain yang terlibat dalam apa-apa prosiding di hadapan Pendaftar, yang menetap atau menjalankan perniagaan secara prinsipalnya di Malaysia hendaklah diberikan dengan Pendaftar dalam cara sebagaimana ditentukan oleh Pendaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_151__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_151",
      "schema:text": {
        "@language": "ms",
        "@value": "Alamat yang diberikan dengan Pendaftar di bawah subseksyen (1) hendaklah dimasukkan ke dalam rekod Pendaftar atau Daftar dan hendaklah disifatkan sebagai alamat untuk perkhidmatan orang itu di bawah subseksyen (1) untuk semua prosiding di hadapan Pendaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_151__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_151",
      "schema:text": {
        "@language": "ms",
        "@value": "Alamat untuk perkhidmatan boleh diubah apabila memaklumkan Pendaftar dalam borang yang ditentukan olehnya dan dalam tempoh yang ditetapkan yang hendaklah dimasukkan ke dalam rekod Pendaftar atau Daftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_151__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_151",
      "schema:text": {
        "@language": "ms",
        "@value": "Setelah menerima permintaan perubahan dalam subseksyen (3), bersama dengan pembayaran fi yang ditetapkan, Pendaftar hendaklah mengubah alamat untuk perkhidmatan orang di bawah subseksyen (1) yang boleh menjejaskan sebahagian atau semua permohonannya untuk pendaftaran atau cap dagangan berdaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_151__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_151",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar boleh enggan meneruskan permohonan atau pendaftaran cap dagangan jika alamat perkhidmatan sebagaimana yang dinyatakan dalam subseksyen (1) tidak diberikan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_151__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_151",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika orang yang dinyatakan dalam subseksyen (1) tidak menetap atau menjalankan perniagaan di Malaysia, dia hendaklah melantik dan memberi kuasa kepada ejen cap dagangan berdaftar untuk bertindak baginya dalam cara yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_151__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_151",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila orang yang disebut dalam subseksyen (1) melantik dan membenarkan ejen cap dagangan berdaftar untuk bertindak baginya, alamat perkhidmatan ejen cap dagangan berdaftar yang hendaklah dimasukkan ke dalam rekod atau Daftar Pendaftar itu hendaklah disifatkan sebagai alamat untuk perkhidmatan orang di bawah subseksyen (1) untuk semua prosiding di hadapan Pendaftar. Kuasa Pendaftar untuk membenarkan pindaan dokumen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_152",
      "@type": "akn:clause",
      "eli:number": "152",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_152__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_152__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_152__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_152__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_152__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_152__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_152__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_152__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_152",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar boleh, apabila suatu permohonan mengikut bentuk yang ditentukan oleh Pendaftar bersama dengan pembayaran fi yang ditetapkan dan atas apa-apa terma mengenai kos sebagaimana yang difikirkannya adil, sama ada untuk maksud meminda suatu kesalahan perkeranian atau kesilapan yang jelas, membenarkan pindaan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_152__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_152__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu permohonan untuk pendaftaran cap dagangan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_152__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_152__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "notis bangkangan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_152__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_152__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "kenyataan balas; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_152__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_152__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa dokumen yang difikirkan patut oleh Pendaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_152__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_152__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_152__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_152",
      "schema:text": {
        "@language": "ms",
        "@value": "Pindaan yang terpakai di bawah subseksyen (1), tidak dibenarkan, di bawah seksyen ini jika pindaan itu akan memberi kesan yang substansial kepada—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_152__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_152__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "identiti cap dagangan sebagaimana yang dinyatakan dalam permohonan sebelum pindaan atau tanpa diperluaskan dengan apa-apa cara hak yang diberikan oleh pendaftaran cap dagangan yang sedia ada; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_152__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_152__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "kandungan dokumen yang difailkan dengan Pejabat Cap Dagangan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_152__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_152",
      "schema:text": {
        "@language": "ms",
        "@value": "Keputusan Pendaftar di bawah subseksyen (1) atau (2) adalah tertakluk kepada rayuan kepada Mahkamah. Kuasa Pendaftar untuk membenarkan pelanjutan masa"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_153",
      "@type": "akn:clause",
      "eli:number": "153",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_153__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_153__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_153__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_153__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_153__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_153",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika oleh Akta ini, suatu masa dinyatakan dalam mana perbuatan atau benda itu hendak dilakukan, Pendaftar boleh, melainkan jika diperuntukkan dengan nyata atau diarahkan oleh mahkamah, atas permohonan dalam borang yang ditentukan oleh Pendaftar, melanjutkan masa sama ada sebelum atau selepas tamat tempohnya apabila fi yang ditetapkan dibayar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_153__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_153",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen (1) tidak terpakai bagi seksyen 26, 27 dan 28 kecuali jika keadaan di bawah subseksyen (3) terpakai."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_153__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_153__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_153__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_153__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_153",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika atas sebab—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_153__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_153__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu kesilapan atau peninggalan oleh orang itu atau oleh ejen cap dagangan berdaftarnya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_153__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_153__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "keadaan di luar kawalan orang itu atau oleh ejen cap dagangan berdaftarnya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_153__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_153__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu kesilapan atau tindakan di pihak Pejabat Cap Dagangan, suatu perbuatan berhubung dengan permohonan bagi pendaftaran suatu cap dagangan atau dalam prosiding di bawah Akta ini (yang bukan prosiding dalam mahkamah) yang dikehendaki dilakukan dalam masa yang tertentu belum dilakukan sedemikian, Pendaftar boleh melanjutkan masa untuk melakukan tindakan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_153__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_153",
      "schema:text": {
        "@language": "ms",
        "@value": "Masa yang diperlukan untuk melakukan tindakan di bawah subseksyen (3) boleh dilanjutkan walaupun masa itu telah tamat tempoh. Cara memberikan keterangan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_154",
      "@type": "akn:clause",
      "eli:number": "154",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_154__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_154__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_154__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_154__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_154",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud subseksyen 105(1), dalam semua prosiding di hadapan Pendaftar, keterangan hendaklah diberikan dengan cara akuan berkanun dalam ketiadaan arahan yang sebaliknya, tetapi dalam sesuatu hal yang difikirkannya patut, Pendaftar boleh mengambil keterangan viva voce sebagai ganti atau sebagai tambahan kepada keterangan dengan cara akaun."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_154__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_154",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana akuan berkanun itu boleh, dalam hal suatu rayuan, digunakan di hadapan Mahkamah sebagai ganti keterangan dengan cara afidavit, tetapi jika digunakan sedemikian ia hendaklah mempunyai segala beban dan akibat keterangan dengan cara afidavit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_154__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_154",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam apa-apa tindakan atau prosiding berhubungan dengan suatu cap dagangan, Pendaftar atau Mahkamah, mengikut mana-mana yang berkenaan, hendaklah menerima keterangan tentang kelaziman perdagangan yang berkenaan atau keterangan tentang kelaziman perniagaan dalam penyediaan perkhidmatan yang berkenaan dan keterangan tentang mana-mana cap dagangan atau nama dagangan atau nama perniagaan atau cara gayanya yang relevan yang digunakan dengan sah oleh orang lain. Menjalankan kuasa budi bicara"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_155",
      "@type": "akn:clause",
      "eli:number": "155",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika apa-apa kuasa budi bicara diberikan kepada Pendaftar oleh Akta ini, Pendaftar tidak boleh menjalankan kuasa itu bertentangan dengan pemohon bagi pendaftaran cap dagangan atau tuan punya berdaftar yang berkenaan tanpa, jika dikehendaki dengan sewajarnya berbuat demikian dalam tempoh yang ditetapkan, memberi pemohon itu suatu peluang untuk didengar. Kuasa Pendaftar untuk menetapkan dokumen sebagai rahsia"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_156",
      "@type": "akn:clause",
      "eli:number": "156",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_156__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_156__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_156__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_156__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_156__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_156__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_156",
      "schema:text": {
        "@language": "ms",
        "@value": "Mengikut peraturan-peraturan, Pendaftar boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_156__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_156__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menghendaki maklumat yang dinyatakan dalam dokumen yang telah difailkan, atau yang akan difailkan, berhubung dengan suatu cap dagangan yang disimpan di Pejabat Cap Dagangan adalah rahsia; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_156__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_156__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat apa-apa kehendak tertakluk kepada syarat atau pengehadan yang dinyatakan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_156__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_156__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mengubah atau membatalkan apa-apa kehendak, syarat atau pengehadan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_156__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_156",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini, prosedur yang berkaitan dengan membuat, mengubah atau membatalkan apa-apa kehendak, syarat atau pengehadan hendaklah sebagaimana ditetapkan. Penyesuaian entri kepada pengelasan baharu"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_157",
      "@type": "akn:clause",
      "eli:number": "157",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_157__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_157__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_157__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_157__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_157__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_157",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar boleh menimbangkan keperluan untuk melaksanakan apa-apa pindaan atau penggantian pengelasan barang-barang atau perkhidmatan bagi maksud pendaftaran cap dagangan termasuk membuat pindaan catatan sedia ada pada Daftar itu supaya sesuai dengan pengelasan baharu sebagaimana yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_157__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_157",
      "schema:text": {
        "@language": "ms",
        "@value": "Pindaan yang dibuat di bawah subseksyen (1) tidak boleh melanjutkan hak yang diberikan oleh pendaftaran itu, kecuali jika didapati oleh Pendaftar bahawa pematuhan terhadap kehendak itu akan melibatkan kerumitan yang tidak wajar dan bahawa apa-apa pelanjutan tidak akan menjadi substansial dan tidak akan menjejaskan hak mana-mana orang."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_157__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_157__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_157__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_157",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_157__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_157__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "menghendaki tuan punya berdaftar, dalam apa-apa tempoh yang ditetapkan itu, untuk memfailkan cadangan untuk pindaan pada Daftar; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_157__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_157__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "membatalkan mana-mana barang-barang atau perkhidmatan yang berkaitan sebagaimana yang dikenal pasti oleh Pendaftar atau menolak untuk membaharui pendaftaran cap dagangan itu sekiranya tuan punya berdaftar gagal berbuat demikian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_157__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_157",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana cadangan sedemikian yang dibuat di bawah perenggan (3)(a) hendaklah disiarkan dalam Jurnal Rasmi Harta Intelek dan boleh dibangkang mengikut seksyen 35. Kos yang diaward oleh Pendaftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_158",
      "@type": "akn:clause",
      "eli:number": "158",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_158__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_158__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_158__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_158__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_158",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam segala prosiding di hadapan Pendaftar, Pendaftar hendaklah mempunyai kuasa untuk mengaward kepada mana-mana pihak apa-apa kos termasuk penetapan kos sebagaimana yang Pendaftar boleh pertimbangkan dengan munasabah dan untuk mengarahkan bagaimana dan oleh pihak-pihak mana kos itu hendak dibayar, dan apa-apa perintah itu boleh, dengan keizinan Mahkamah, dilaksanakan mengikut cara sama seperti suatu hukuman atau perintah Mahkamah bagi maksud yang serupa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_158__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_158",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu pihak kepada apa-apa prosiding di hadapan seorang Pendaftar yang berhasrat untuk mendapatkan kos atau mempunyai kos yang hendak ditetapkan hendaklah memohon kepada Pendaftar dengan cara yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_158__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_158",
      "schema:text": {
        "@language": "ms",
        "@value": "Kos yang diaward oleh Pendaftar di bawah subseksyen (1) boleh, jika tidak dibayar dituntut dalam suatu mahkamah yang berbidang kuasa berwibawa sebagai hutang yang kena dibayar oleh orang yang terhadapnya kos itu telah diberi kepada orang yang untuk faedahnya kos itu telah diberi. Cap dagangan tidak berdaftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_159",
      "@type": "akn:clause",
      "eli:number": "159",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_159__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_159__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_159__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_159",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada sesiapa jua hendaklah berhak untuk mengambil apa-apa tindakan untuk mencegah atau mendapatkan ganti rugi bagi pelanggaran terhadap suatu cap dagangan tidak berdaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_159__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_159",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (1), tiada apa-apa jua dalam Akta ini boleh disifatkan sebagai menjejaskan hak untuk mengambil tindakan terhadap mana-mana orang bagi mengelirupakan barang-barang atau perkhidmatan sebagai barang-barang atau perkhidmatan seorang yang lain atau remedi berkenaan dengan barang-barang atau perkhidmatan. Garis panduan atau arahan amalan oleh Pendaftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_160",
      "@type": "akn:clause",
      "eli:number": "160",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_160__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_160__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_160__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_160__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_160__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_160__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_160__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_160",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar boleh mengeluarkan garis panduan atau arahan amalan mengenai apa-apa perkara."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_160__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_160",
      "schema:text": {
        "@language": "ms",
        "@value": "Garis panduan atau arahan amalan yang dikeluarkan oleh Pendaftar di bawah seksyen ini hendaklah disiarkan dalam Jurnal Rasmi Harta Intelek dan hendaklah berkuat kuasa dari tarikh yang dinyatakan dalam garis panduan atau arahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_160__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_160",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang dinyatakan dalam peruntukan di bawah Akta ini hendaklah mematuhi garis panduan dan arahan amalan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_160__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_160",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar boleh mengubah, mengkaji semula atau membatalkan apa-apa garis panduan atau arahan amalan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_160__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_160",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada subseksyen (4), prosedur yang dinyatakan dalam subseksyen (2) dan (3) hendaklah terpakai berkenaan dengan apa-apa perubahan, kajian semula atau pembatalan garis panduan atau arahan amalan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_160__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_160__subsec_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_160__subsec_6__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_160",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang, pemohon atau tuan punya berdaftar yang tidak mematuhi mana-mana garis panduan atau arahan amalan Pendaftar, jika garis panduan atau arahan amalan terpakai kepada orang, pemohon atau tuan punya berdaftar itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_160__subsec_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_160__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "disifatkan telah gagal untuk memenuhi kehendak sebagaimana yang dikehendaki oleh Pendaftar yang menjadikan permohonan sebagai ditarik balik, luput, ditolak, dibatalkan atau sebagaimana yang ditentukan oleh Pendaftar; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_160__subsec_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_160__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi sepuluh ribu ringgit. Kuasa untuk meminda Jadual"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_161",
      "@type": "akn:clause",
      "eli:number": "161",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_161__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_161__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_161__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_161",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, melalui perintah yang disiarkan dalam Warta, meminda Jadual Pertama dan Kedua."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_161__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_161__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_161__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_161__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_161",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri hendaklah, sebelum membuat suatu pindaan kepada Jadual Pertama atau Kedua—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_161__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_161__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menyiarkan notis mengenai niatnya dalam Jurnal Rasmi Harta Intelek untuk membuat pindaan dan pindaan yang dicadangkan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_161__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_161__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "memberikan sekurang-kurangnya tiga puluh hari dari tarikh notis untuk membolehkan apa-apa penghujahan dibuat oleh anggota persatuan, badan kompeten atau orang awam berhubung dengan pindaan yang dicadangkan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_161__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_161__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "memberikan pertimbangan yang sewajarnya kepada apa-apa penghujahan yang dibuat. Kuasa untuk membuat peraturan-peraturan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162",
      "@type": "akn:clause",
      "eli:number": "162",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada peruntukan Akta ini, Menteri boleh membuat peraturan-peraturan bagi maksud melaksanakan peruntukan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2__para_k",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2__para_l",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2__para_m",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2__para_n",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2__para_o",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2__para_p",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2__para_q",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2__para_r",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2__para_s",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2__para_t"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162",
      "schema:text": {
        "@language": "ms",
        "@value": "Pada khususnya dan tanpa menyentuh keluasan subseksyen (1), peraturan-peraturan itu boleh membuat peruntukan bagi semua atau mana-mana bagi maksud berikut—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengawal selia amalan, selain daripada yang berhubungan dengan prosiding di hadapan mahkamah atau yang berkaitan dengannya, termasuk penyampaian dokumen;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengelaskan barang-barang atau perkhidmatan bagi maksud pendaftaran cap dagangan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengadakan peruntukan bagi semua perkara yang berhubungan dengan pendaftaran cap dagangan termasuklah pembaharuan cap dagangan berdaftar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengadakan peruntukan bagi semua perkara yang berkaitan dengan pengubahan atau pemotongan sukarela bagi cap dagangan berdaftar, pembatalan atau ketidaksahan pendaftaran, atau pembetulan Daftar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menjamin dan mengawal selia penerbitan dan penjualan atau pengedaran mengikut apa-apa cara yang difikirkan patut oleh Menteri bagi salinan cabutan cap dagangan dan dokumen lain daripada rekod atau Daftar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan fi yang akan dibayar berkenaan dengan apa-apa perkara atau benda yang dikehendaki bagi maksud Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengawal selia semua perkara yang berhubungan dengan ejen cap dagang berdaftar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengawal selia perkara yang berhubungan dengan penyenaraian pendaftaran barang-barang atau perkhidmatan yang terdiri daripada lebih daripada satu kelas dalam satu permohonan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengawal selia semua perkara yang berhubungan dengan pembahagian permohonan bagi pendaftaran atau cap dagangan berdaftar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengawal selia semua perkara yang berhubungan dengan penggabungan permohonan bagi pendaftaran atau cap dagangan berdaftar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengawal selia semua perkara yang berhubungan dengan cap perakuan dan cap kolektif;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2__para_l",
      "@type": "akn:paragraph",
      "eli:number": "l",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengawal selia semua perkara yang berhubungan dengan suatu siri cap dagangan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2__para_m",
      "@type": "akn:paragraph",
      "eli:number": "m",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengawal selia secara umum mengenai perkara-perkara yang berkaitan dengan operasi perniagaan yang berhubungan dengan cap dagangan yang dijalankan di mana-mana Pejabat Cap Dagangan sama ada atau tidak secara khusus ditetapkan tetapi supaya tidak bercanggah dengan mana-mana peruntukan Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2__para_n",
      "@type": "akn:paragraph",
      "eli:number": "n",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengawal selia perkara-perkara dalam menentukan sama ada suatu cap dagangan terkenal dan telah memenuhi syarat yang ditetapkan di bawah Perkara 6bis Konvensyen Paris dan Perkara 16 Perjanjian TRIPS;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2__para_o",
      "@type": "akn:paragraph",
      "eli:number": "o",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengawal selia penggunaan cap dagangan termasuk bagaimana cap dagangan itu dipakaikan pada atau dipakaikan berhubung dengan barang-barang atau perkhidmatan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2__para_p",
      "@type": "akn:paragraph",
      "eli:number": "p",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengawal selia perkara yang berkaitan dengan penggunaan cap dagangan dalam internet;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2__para_q",
      "@type": "akn:paragraph",
      "eli:number": "q",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengadakan peruntukan bagi cara dan kesan suatu pemotongan dan bagi melindungi kepentingan orang lain yang mempunyai hak dalam cap dagangan berdaftar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2__para_r",
      "@type": "akn:paragraph",
      "eli:number": "r",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengawal selia semua perkara yang berkaitan dengan langkah-langkah sempadan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2__para_s",
      "@type": "akn:paragraph",
      "eli:number": "s",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan catatan, butir-butir atau perkara yang dicatatkan ke dalam rekod atau Daftar; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2__para_t",
      "@type": "akn:paragraph",
      "eli:number": "t",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan bagi semua perkara yang berhubungan dengan rayuan yang difailkan di Mahkamah berikutan keputusan Pendaftar yang berhubungan dengan masa untuk memulakan tindakan atau cara permohonan dibuat untuk pelanjutan masa itu, tertakluk kepada peruntukan kaedah-kaedah mahkamah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVIII__cl_162",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada peruntukan Akta ini, Jawatankuasa Kaedah-Kaedah yang ditubuhkan di bawah Akta Mahkamah Kehakiman 1964, boleh membuat kaedah-kaedah bagi mahkamah untuk mengawal amalan dan tatacara berhubung dengan prosiding di hadapan Mahkamah atau yang berkenaan dengannya dan juga kos bagi prosiding itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_140",
      "@type": "akn:clause",
      "eli:number": "140",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_140__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_140__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_140__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_140__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_140__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_140__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_140",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu salinan tiap-tiap permohonan kepada Mahkamah, termasuk rayuan kepada Mahkamah Rayuan atau Mahkamah Persekutuan, yang berhubungan dengan permohonan bagi pendaftaran atau cap dagangan berdaftar hendaklah difailkan dengan Pendaftar oleh pihak-pihak kepada permohonan itu ke Mahkamah mengikut cara sebagaimana yang ditentukan oleh Pendaftar dalam tempoh yang ditetapkan, tanpa perlu menamakan Pendaftar sebagai suatu pihak."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_140__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_140",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila menerima permohonan di bawah subseksyen (1), Pendaftar boleh mengubah status permohonan atau pendaftaran cap dagangan itu sebagaimana yang difikirkan patut oleh Pendaftar, tertakluk kepada syarat, arahan, petunjuk, perintah atau penghakiman Mahkamah selanjutnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_140__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_140",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa perintah atau penghakiman yang dibuat oleh Mahkamah apabila selesai permohonan yang difailkan di bawah subseksyen (1) hendaklah difailkan dengan Pendaftar mengikut cara sebagaimana yang ditentukan oleh Pendaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_140__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_140",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar, di bawah subseksyen (3), hendaklah mematuhi dan menguatkuasakan perintah atau penghakiman Mahkamah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_140__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_140",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Pendaftar berpendapat bahawa publisiti harus diberikan dalam menguatkuasakan perintah Mahkamah, dia boleh menyiarkannya dalam Jurnal Rasmi Harta Intelek. Kehadiran Pendaftar dalam prosiding yang melibatkan Pendaftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_141",
      "@type": "akn:clause",
      "eli:number": "141",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_141__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_141__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_141__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_141__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_141__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_141",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam mana-mana prosiding undang-undang di hadapan Mahkamah termasuklah yang melibatkan permohonan bagi—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_141__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_141__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pembatalan bagi pendaftaran cap dagangan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_141__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_141__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pengisytiharan ketidaksahan pendaftaran cap dagangan, Pendaftar hendaklah mempunyai hak untuk hadir dan didengar, dan hendaklah hadir jika diarahkan oleh Mahkamah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_141__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_141",
      "schema:text": {
        "@language": "ms",
        "@value": "Melainkan jika selainnya diarahkan oleh Mahkamah, Pendaftar, sebagai ganti hadir dan didengar, boleh mengemukakan kepada Mahkamah suatu pernyataan secara bertulis yang ditandatangani olehnya, memberikan butir-butir prosiding di hadapannya berhubung dengan perkara yang dipersoalkan itu atau butir-butir alasan mengenai suatu keputusan yang telah diberi olehnya mengenai perkara itu atau butir-butir amalan pejabat dalam hal yang serupa, atau butir-butir apa-apa perkara lain yang difikirkannya patut berkaitan dengan persoalan itu, dan dalam pengetahuannya sebagai Pendaftar, yang difikirkannya patut, dan pernyataan itu hendaklah disifatkan sebagai menjadi sebahagian daripada keterangan dalam prosiding itu. Kos prosiding di hadapan Mahkamah"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_142",
      "@type": "akn:clause",
      "eli:number": "142",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam semua prosiding di hadapan Mahkamah, Mahkamah boleh, mengikut budi bicaranya, mengawardkan mana-mana pihak termasuk Pendaftar apa-apa kos sebagaimana yang difikirkannya munasabah tetapi Pendaftar tidak boleh diperintahkan untuk membayar kos mana-mana pihak lain. Perakuan kesahan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_143",
      "@type": "akn:clause",
      "eli:number": "143",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika dalam sesuatu prosiding di sisi undang-undang yang kesahan suatu cap dagangan berdaftar dipersoalkan dan keputusan dibuat memihak tuan punya berdaftar itu, maka Mahkamah bolehlah memperakui yang demikian dan jika Mahkamah memperakui sedemikian dalam suatu prosiding undang-undang yang kemudian, yang kesahan pendaftaran dipersoalkan tuan punya berdaftar apabila memperoleh suatu perintah atau penghakiman muktamad yang memihak kepadanya hendaklah mendapat kos, bayaran dan perbelanjaan penuh sebagai antara peguam cara dengan pelanggan, melainkan jika dalam perbicaraan yang kemudian itu Mahkamah memperakui bahawa tuan punya berdaftar itu tidak patut mendapatnya. Nilai keterangan bagi salinan yang diperakui oleh Pendaftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_144",
      "@type": "akn:clause",
      "eli:number": "144",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII",
      "schema:text": {
        "@language": "ms",
        "@value": "Salinan atau cabutan daripada apa-apa bentuk atau dokumen yang difailkan di pejabat cap dagangan yang Pendaftar diperakui sebagai suatu salinan atau cabutan yang benar yang ditandatangani dan dimeteraikan oleh Pendaftar hendaklah diterima sebagai keterangan dalam apa-apa prosiding yang mempunyai kesahan yang sama dengan dokumen asal. Salinan dokumen yang dimeterai hendaklah menjadi keterangan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_145",
      "@type": "akn:clause",
      "eli:number": "145",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_145__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_145__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_145__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_145__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_145__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_145",
      "schema:text": {
        "@language": "ms",
        "@value": "Salinan atau cabutan bercetak atau bertulis atau daripada Daftar yang berupa sebagai diperakui oleh Pendaftar dan dimeterai dengan meterainya boleh diterima sebagai keterangan dalam mana-mana prosiding di hadapan mana-mana mahkamah tanpa apa-apa bukti lagi atau pengemukaan yang asal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_145__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_145",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu pemberitahuan atau perakuan pendaftaran boleh diterima sebagai keterangan dalam mana-mana prosiding di hadapan mana-mana mahkamah undang-undang tanpa apa-apa bukti lagi atau pengemukaan yang asal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_145__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_145",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu perakuan yang berupa sebagai ditandatangani oleh Pendaftar mengenai apa-apa perbuatan yang dia diberi kuasa untuk melakukan dan yang dia telah atau belum lakukan menjadi keterangan prima facie dalam prosiding di hadapan mana-mana mahkamah undang-undang mengenai hal yang dia telah melakukan atau belum melakukan perbuatan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_145__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_145__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_145__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_145",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun dalam penggajian Perbadanan dikehendaki hadir ke mahkamah bagi maksud untuk mengemukakan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_145__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_145__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa dokumen yang berhubungan dengan permohonan cap dagangan atau cap dagangan berdaftar yang boleh diperoleh di bawah peruntukan Akta ini; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_145__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_145__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa dokumen yang ditetapkan sebagai rahsia, tidak terbuka untuk pemeriksaan awam atau diadakan kepada mana-mana pihak ketiga mengikut Akta ini. Maklumat elektronik, dsb., yang diperakui oleh Pendaftar boleh diterima sebagai keterangan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_146",
      "@type": "akn:clause",
      "eli:number": "146",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa bentuk, maklumat atau dokumen, salinan atau cabutan daripada apa-apa bentuk, maklumat atau dokumen yang difailkan secara elektronik dengan Pendaftar atau yang dikeluarkan oleh Pendaftar, hendaklah menjadi cabutan sebenar daripada apa- apa bentuk, maklumat atau dokumen yang difailkan dengan atau dikemukakan kepada Pendaftar sebagaimana yang dikehendaki di bawah Akta ini dan hendaklah menjadi keterangan prima facie tentang perkara yang dinyatakan mengikut bentuk, maklumat, dokumen, salinan atau cabutan itu. Menteri boleh mengisytiharkan dokumen negara asing mengenai cap dagangan sebagai boleh diterima sebagai keterangan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_147",
      "@type": "akn:clause",
      "eli:number": "147",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_147__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_147__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_147__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_147__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_147__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_147__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_147",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, dengan perintah yang disiarkan dalam Warta, mengisytiharkan apa-apa dokumen atau kelas dokumen suatu negara asing menjadi boleh diterima sebagai keterangan dalam mana-mana pembicaraan di hadapan Mahkamah jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_147__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_147__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dokumen itu dimeterai dengan meterai pegawai yang diberi kuasa atau kerajaan negara asing itu dan meterai itu mengenai cap dagangan yang didaftarkan di dalam atau diiktiraf sebaliknya oleh negara asing itu atau jika tiada apa-apa meterai, perlu disertakan perakuan yang ditandatangani oleh pegawai yang diberi kuasa itu yang bermaksud dokumen hendaklah menjadi keterangan mengenai perkara yang terkandung di dalamnya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_147__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_147__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "negara asing itu atau sebahagian daripadanya telah membuat perkiraan salingan dengan Kerajaan Malaysia mengenai kebolehterimaan dokumen itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_147__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_147__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_147__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_147__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_147",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_147__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_147__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "“cap dagangan” ertinya apa-apa tanda termasuklah yang berikut atau apa-apa gabungan yang berikut, iaitu, apa-apa huruf, perkataan, nama, tandatangan, angka, logo, jenama, tajuk, label, tiket, bentuk barang-barang atau bungkusannya, warna (sama ada warna tunggal atau suatu gabungan warna), bunyi, bau, hologram, kedudukan, urutan gerakan yang digunakan atau diniatkan untuk digunakan berhubung dengan barang-barang atau perkhidmatan bagi maksud menunjukkan atau untuk menunjukkan suatu kaitan dalam penjalanan perdagangan antara barang-barang atau perkhidmatan dan seseorang yang mempunyai hak sama ada sebagai tuan punya atau pemegang lesen untuk menggunakan cap dagangan (di negara asing itu) sama ada dengan atau tanpa apa-apa petunjuk identiti orang itu dan yang didaftarkan atau diiktiraf sebaliknya oleh negara asing sebagai cap dagangan (di bawah mana-mana undang-undang bertulis yang berkuat kuasa di dalam negara asing itu yang berhubungan dengan cap dagangan) tetapi tidak termasuk cap dagangan suatu negara asing yang lain yang didaftarkan di dalam atau diiktiraf sebaliknya oleh negara asing menurut perkiraan salingan antara negara asing dan negara asing lain;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_147__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_147__subsec_2__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_147__subsec_2__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_147__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "“dokumen” ertinya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_147__subsec_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_147__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu salinan cabutan bercetak atau bertulis atau rekod cap dagangan lain yang disimpan dan disenggara di dalam negara asing di bawah mana-mana undang-undang bertulis yang berkuat kuasa di dalam negara asing itu yang berhubungan dengan cap dagangan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_147__subsec_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_147__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa dokumen lain mengenai apa-apa perkara atau perbuatan berhubungan dengan cap dagangan yang didaftarkan dalam negara asing itu atau pun yang diiktiraf oleh negara asing itu sebagai cap dagangan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_147__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_147__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "“pegawai yang diberi kuasa” ertinya seseorang atau pihak berkuasa yang diberi kuasa oleh kerajaan negara asing untuk menyimpan dan menyenggara suatu daftar atau rekod cap dagangan lain di bawah mana-mana undang-undang bertulis yangberkuat kuasa di negara asing itu berkenaan dengan cap dagangan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_147__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVII__cl_147",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi mengelakkan keraguan, seksyen ini tidak boleh ditafsirkan untuk memberi pengiktirafan cap dagangan mana-mana negara asing bagi maksud pendaftaran di bawah Akta ini tetapi hendaklah ditafsirkan hanya dengan sebutan kebolehterimaan dokumen negara asing sebagai keterangan dalam mana-mana prosiding di hadapan Mahkamah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_1",
      "@type": "akn:chapter",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_1__cl_109",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_1__cl_110",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_1__cl_111",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_1__cl_112"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI",
      "schema:text": {
        "@language": "ms",
        "@value": "Penyiasatan dan aduan Tafsiran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_1__cl_109",
      "@type": "akn:clause",
      "eli:number": "109",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_1__cl_109__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_1__cl_109__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_1",
      "schema:name": {
        "@language": "ms",
        "@value": "Bagi maksud Bahagian ini—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_1__cl_109__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_1__cl_109",
      "schema:text": {
        "@language": "ms",
        "@value": "“Pengawal”, “Timbalan Pengawal” atau “Penolong Pengawal” ertinya Pengawal, Timbalan Pengawal atau Penolong Pengawal, Perihal Dagangan, yang dilantik di bawah seksyen 3 Akta Perihal Dagangan 2011 [Akta 730]; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_1__cl_109__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_1__cl_109",
      "schema:text": {
        "@language": "ms",
        "@value": "“premis” ertinya apa-apa tempat, yang tidak bergerak atau sebaliknya yang ditubuhkan atau didirikan oleh mana-mana orang, sama ada tempat itu ada atau tiada kepungan, dan termasuklah kenderaan, pesawat udara, kapal dan apa-apa vesel lain. Kuasa Pengawal, Timbalan Pengawal atau Penolong Pengawal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_1__cl_110",
      "@type": "akn:clause",
      "eli:number": "110",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_1__cl_110__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_1__cl_110__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_1__cl_110__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_1__cl_110__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_1__cl_110__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_1__cl_110__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_1__cl_110",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengawal hendaklah melaksanakan kewajipan yang dikenakan dan menjalankan kuasa yang diberikan kepadanya tertakluk kepada arahan dan kawalan am Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_1__cl_110__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_1__cl_110",
      "schema:text": {
        "@language": "ms",
        "@value": "Timbalan Pengawal dan Penolong Pengawal hendaklah berada di bawah arahan dan kawalan Pengawal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_1__cl_110__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_1__cl_110",
      "schema:text": {
        "@language": "ms",
        "@value": "Timbalan Pengawal boleh melaksanakan segala kewajipan yang dikenakan dan menjalankan segala kuasa yang diberikan kepada Pengawal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_1__cl_110__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_1__cl_110",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengawal dan Timbalan Pengawal boleh melaksanakan segala kewajipan yang dikenakan dan menjalankan segala kuasa yang diberikan kepada Penolong Pengawal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_1__cl_110__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_1__cl_110",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengawal atau Timbalan Pengawal boleh secara bertulis mewakilkan semua atau mana-mana kuasa, kewajipan atau fungsinya di bawah Bahagian ini kepada mana-mana Penolong Pengawal. Kuasa penyiasatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_1__cl_111",
      "@type": "akn:clause",
      "eli:number": "111",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_1__cl_111__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_1__cl_111__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_1__cl_111__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_1__cl_111",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Penolong Pengawal mempunyai alasan yang munasabah untuk mengesyaki bahawa apa-apa kesalahan sedang atau akan dilakukan di bawah Akta ini, Penolong Pengawal boleh menjalankan apa-apa penyiasatan yang difikirkannya suai manfaat bagi pentadbiran wajar Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_1__cl_111__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_1__cl_111",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana Penolong Pengawal yang menyiasat apa-apa pelakuan kesalahan di bawah Akta ini boleh menjalankan semua atau mana-mana kuasa berhubung dengan penyiasatan polis dalam kes boleh tangkap yang diperuntukkan oleh Kanun Tatacara Jenayah [Akta 593]. Aduan kepada Penolong Pengawal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_1__cl_112",
      "@type": "akn:clause",
      "eli:number": "112",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_1__cl_112__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_1__cl_112__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_1__cl_112__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_1__cl_112__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_1__cl_112__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_1__cl_112",
      "schema:text": {
        "@language": "ms",
        "@value": "Penolong Pengawal boleh, apabila mendapat aduan daripada seseorang, menjalankan penyiasatan terhadap mana-mana orang yang telah atau sedang melakukan apa-apa kesalahan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_1__cl_112__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_1__cl_112",
      "schema:text": {
        "@language": "ms",
        "@value": "Aduan yang dibuat di bawah subseksyen (1) hendaklah menyatakan orang yang terhadapnya aduan itu dibuat atau premis tempat kesalahan yang dikatakan itu dilakukan dan butiran mengenai kesalahan yang dikatakan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_1__cl_112__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_1__cl_112",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika aduan yang dibuat di bawah subseksyen (1) berhubung dengan suatu cap dagangan yang tidak serupa dengan cap dagangan berdaftar, mana-mana tuan punya berdaftar atau pemegang lesen hendaklah mendapatkan pengesahan Pendaftar mengikut bentuk yang ditentukan oleh Pendaftar bersama dengan pembayaran fi yang ditetapkan untuk dikemukakan kepada Penolong Pengawal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_1__cl_112__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_1__cl_112",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengesahan Pendaftar di bawah subseksyen (3), hendaklah menjadi keterangan prima facie dalam mana-mana prosiding di hadapan mana-mana mahkamah undang-undang."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2",
      "@type": "akn:chapter",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_113",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_114",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_115",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_116",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_117",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_118"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI",
      "schema:text": {
        "@language": "ms",
        "@value": "Kuasa mengumpul maklumat Kuasa Penolong Pengawal untuk menghendaki pemberian maklumat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_113",
      "@type": "akn:clause",
      "eli:number": "113",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_113__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_113__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_113__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_113__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_113__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_113__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_113__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_113__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_113",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen ini terpakai jika Penolong Pengawal dalam menjalankan penyiasatan di bawah Bahagian ini mempunyai sebab untuk mempercayai bahawa mana-mana orang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_113__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_113__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mempunyai apa-apa maklumat atau apa-apa dokumen yang berkaitan dengan pelaksanaan kuasa dan fungsi Penolong Pengawal di bawah Akta ini; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_113__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_113__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "berupaya memberikan apa-apa keterangan yang Penolong Pengawal mempunyai sebab untuk mempercayai adalah berkaitan dengan pelaksanaan kuasa dan fungsi Penolong Pengawal di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_113__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_113__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_113__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_113__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_113__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_113__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_113__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_113__subsec_2__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_113",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun peruntukan mana-mana undang-undang bertulis lain, Penolong Pengawal, dengan notis bertulis, boleh mengarahkan mana-mana orang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_113__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_113__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "supaya memberi Penolong Pengawal, dalam tempoh dan mengikut cara dan bentuk yang dinyatakan dalam notis itu, apa-apa maklumat atau dokumen yang disebut dalam subseksyen (1);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_113__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_113__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "supaya mengemukakan kepada Penolong Pengawal, dalam tempoh dan mengikut cara yang dinyatakan dalam notis itu, apa-apa maklumat atau dokumen yang disebut dalam subseksyen (1), sama ada dalam bentuk fizikal atau elektronik;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_113__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_113__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "supaya membuat salinan, atau cabutan daripada, apa-apa dokumen yang disebut dalam subseksyen (1) dan supaya mengemukakan salinan atau cabutan dokumen itu kepada Penolong Pengawal dalam tempoh dan mengikut cara yang dinyatakan dalam notis itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_113__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_113__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "jika orang itu seorang individu, supaya hadir di hadapan Penolong Pengawal pada masa dan di tempat yang dinyatakan dalam notis itu untuk memberikan apa-apa maklumat, sama ada secara lisan atau bertulis, dan untuk mengemukakan apa-apa dokumen yang disebut dalam subseksyen (1), sama ada dalam bentuk fizikal atau elektronik;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_113__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_113__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "jika orang itu suatu pertubuhan perbadanan atau badan awam, supaya menyebabkan pegawai yang berkaitan dan berkelayakan bagi pertubuhan atau badan itu untuk hadir di hadapan Penolong Pengawal pada masa dan di tempat yang dinyatakan dalam notis itu untuk memberikan apa-apa maklumat, sama ada secara lisan atau bertulis, dan untuk mengemukakan apa-apa dokumen yang disebut dalam subseksyen (1), sama ada dalam bentuk fizikal atau elektronik;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_113__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_113__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "jika orang itu suatu perkongsian, supaya menyebabkan individu yang merupakan seorang pekongsi dalam perkongsian itu atau pekerja perkongsian itu untuk hadir di hadapan Penolong Pengawal pada masa dan di tempat yang dinyatakan dalam notis itu untuk memberikan apa-apa maklumat, sama ada secara lisan atau bertulis, dan untuk mengemukakan apa-apa dokumen yang disebut dalam subseksyen (1), sama ada dalam bentuk fizikal atau elektronik; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_113__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_113__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "supaya membuat suatu pernyataan kepada Penolong Pengawal dengan memberikan suatu penjelasan mengenai apa-apa maklumat atau dokumen yang disebut dalam subseksyen (1) dalam tempoh dan mengikut cara dan bentuk yang dinyatakan dalam notis itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_113__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_113__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_113__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_113",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Penolong Pengawal mengarahkan mana-mana orang supaya mengemukakan apa-apa dokumen di bawah subseksyen (2) dan dokumen itu tiada dalam jagaan orang itu, orang itu hendaklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_113__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_113__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "menyatakan, sepanjang pengetahuan dan kepercayaannya, di mana dokumen itu boleh dijumpai; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_113__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_113__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "mengenal pasti, sepanjang pengetahuan dan kepercayaannya, orang yang terakhir mempunyai jagaan ke atas dokumen itu dan menyatakan, sepanjang pengetahuan dan kepercayaannya, di mana orang terakhir yang disebut itu boleh dijumpai."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_113__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_113",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang diarahkan supaya memberikan maklumat di bawah subseksyen (2) atau (3) hendaklah memastikan bahawa maklumat yang diberikan itu adalah benar, tepat dan lengkap dan orang itu hendaklah memberikan representasi yang nyata yang bermaksud sedemikian, termasuk suatu perisytiharan bahawa dia tidak menyedari mengenai apa-apa maklumat lain yang akan menjadikan maklumat yang diberikan itu tidak benar atau mengelirukan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_113__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_113",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang enggan atau tidak mematuhi arahan yang dibuat oleh Penolong Pengawal di bawah seksyen ini melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima puluh ribu ringgit. Penolong Pengawal boleh memegang simpan dokumen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_114",
      "@type": "akn:clause",
      "eli:number": "114",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_114__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_114__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_114__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_114__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_114__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_114",
      "schema:text": {
        "@language": "ms",
        "@value": "Penolong Pengawal boleh mengambil dan memegang simpan selama apa-apa tempoh yang difikirkannya perlu, milikan mana-mana dokumen yang diperoleh di bawah Bahagian ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_114__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_114",
      "schema:text": {
        "@language": "ms",
        "@value": "Orang yang memberikan dokumen itu berhak untuk dibekalkan, dengan secepat yang dapat dilaksanakan, suatu salinan yang diperakui sah oleh Penolong Pengawal sebagai suatu salinan benar dokumen itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_114__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_114",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun peruntukan mana-mana undang-undang bertulis yang lain, salinan yang diperakui sah bagi dokumen itu boleh diterima sebagai keterangan seolah-olah salinan itu ialah dokumen asal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_114__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_114",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Penolong Pengawal berpuas hati bahawa dokumen itu tidak lagi perlu dipegang simpan, Penolong Pengawal boleh mengembalikan dokumen itu kepada orang yang memberikan dokumen itu, dengan secepat yang dapat dilaksanakan. Kerahsiaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_115",
      "@type": "akn:clause",
      "eli:number": "115",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_115__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_115__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_115__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_115__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_115",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang menzahirkan atau menggunakan apa-apa maklumat atau dokumen rahsia berkenaan dengan suatu perusahaan tertentu atau hal ehwal seseorang individu yang diperoleh menurut kuasa mana-mana peruntukan Akta ini melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima ratus ribu ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_115__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_115__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_115__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_115__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_115__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_115__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_115__subsec_2__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_115",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada apa-apa jua dalam subseksyen (1) boleh berkuat kuasa untuk menghalang penzahiran maklumat jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_115__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_115__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "penzahiran itu dibuat dengan persetujuan orang yang daripadanya maklumat atau dokumen itu diperoleh;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_115__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_115__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "penzahiran itu dibuat dalam hal keadaan maklumat yang diberikan itu dirangka dengan cara yang sebegitu rupa sehingga sumber maklumat itu tidak dapat dipastikan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_115__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_115__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "maklumat itu telah sedia ada dalam domain awam;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_115__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_115__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "penzahiran itu dibuat bagi memudahkan pelaksanaan fungsi atau kuasa Pengawal, Timbalan Pengawal atau Penolong Pengawal;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_115__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_115__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "penzahiran itu dibuat secara munasabah semasa apa-apa prosiding di bawah Akta ini dengan syarat bahawa penzahiran itu tidak dibuat berlawanan dengan apa-apa arahan Pengawal, Timbalan Pengawal atau Penolong Pengawal yang di hadapannya prosiding itu berjalan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_115__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_115__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "penzahiran itu dibuat berkaitan dengan penyiasatan terhadap suatu kesalahan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_115__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_115",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini, “maklumat rahsia” ertinya maklumat perdagangan, perniagaan atau perindustrian yang dipunyai oleh mana-mana orang, yang mempunyai nilai ekonomi dan secara amnya tidak tersedia kepada atau diketahui oleh orang lain. Komunikasi terlindung"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_116",
      "@type": "akn:clause",
      "eli:number": "116",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_116__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_116__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_116__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_116__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_116__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_116",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh dikehendaki, di bawah mana-mana peruntukan Bahagian ini, supaya memberikan atau menzahirkan apa-apa komunikasi antara seorang penasihat undang-undang profesional dengan pelanggannya yang dilindungi daripada penzahiran mengikut seksyen 126 Akta Keterangan 1950 [Akta 56]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_116__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_116",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengawal boleh menghendaki seseorang peguam bela dan peguam cara untuk mengemukakan apa-apa dokumen di bawah seksyen 114."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_116__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_116__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_116__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_116",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika dokumen yang dikehendaki di bawah subseksyen (2) mengandungi komunikasi terlindung, yang dibuat oleh atau bagi pihak atau kepada peguam bela dan peguam cara itu atas sifatnya sebagai seorang peguam bela dan peguam cara—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_116__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_116__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "peguam bela dan peguam cara itu hendaklah berhak untuk enggan mematuhi kehendak itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_116__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_116__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "orang yang kepadanya atau olehnya atau bagi pihaknya komunikasi terlindung itu dibuat atau, jika orang itu ialah pertubuhan perbadanan yang di bawah penerimaan atau sedang digulung, penerima atau pelikuidasi, mengikut mana-mana yang berkenaan, boleh bersetuju bahawa peguam bela dan peguam cara itu hendaklah mematuhi kehendak itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_116__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_116",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun perenggan (3)(b), jika peguam bela dan peguam cara itu enggan untuk mematuhi kehendak itu, peguam bela dan peguam cara itu hendaklah dengan segera memberi Pengawal secara bertulis nama dan alamat orang yang kepadanya atau olehnya atau bagi pihaknya komunikasi terlindung itu dibuat. Memberikan maklumat, keterangan atau dokumen palsu atau yang mengelirukan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_117",
      "@type": "akn:clause",
      "eli:number": "117",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang tidak menzahirkan atau meninggalkan untuk memberikan apa-apa maklumat, keterangan atau dokumen yang berkaitan, atau memberikan apa-apa maklumat, keterangan atau dokumen yang diketahuinya atau dia ada sebab untuk mempercayai adalah palsu atau mengelirukan, dalam penjalanan penyiasatan oleh Penolong Pengawal, melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi satu ratus ribu ringgit. Pemusnahan, penyembunyian, pencacatan dan pengubahan rekod"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_118",
      "@type": "akn:clause",
      "eli:number": "118",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_118__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_118__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2",
      "schema:name": {
        "@language": "ms",
        "@value": "Seseorang yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_118__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_118",
      "schema:text": {
        "@language": "ms",
        "@value": "memusnahkan, menyembunyikan, mencacatkan atau mengubah; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_118__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_2__cl_118",
      "schema:text": {
        "@language": "ms",
        "@value": "menghantar atau cuba untuk menghantar atau berkomplot dengan mana-mana orang lain untuk mengalihkan dari premisnya atau menghantar ke luar Malaysia, apa-apa barang-barang, dokumen, bahan, artikel atau benda yang disimpan atau disenggarakan dengan niat untuk memfraud Penolong Pengawal atau untuk menghalang, melengahkan atau menggalang penjalanan suatu penyiasatan atau penjalanan mana-mana kuasa Penolong Pengawal di bawah Akta ini melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi satu ratus ribu ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3",
      "@type": "akn:chapter",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XVI__chp_3__cl_119",
