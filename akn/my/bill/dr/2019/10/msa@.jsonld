        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_171",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_172",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_173",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_174",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_175",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_176",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_177",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_178",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_179",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_180",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_181",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_182"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX",
      "schema:text": {
        "@language": "ms",
        "@value": "Peruntukan peralihan bagi cap dagangan Tafsiran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_164",
      "@type": "akn:clause",
      "eli:number": "164",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_164__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_164__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_164__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_164__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_164",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun pemansuhan, subseksyen yang berikut hendaklah terpakai."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_164__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_164",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam Bab ini, “cap berdaftar sedia ada” ertinya suatu cap dagangan, cap dagangan perakuan atau cap dagangan pertahanan yang didaftarkan di bawah Akta yang dimansuhkan sebaik sahaja permulaan kuat kuasa Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_164__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_164__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_164__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_164",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud Bab ini—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_164__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_164__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu permohonan hendaklah dikira sebagai belum selesai pada permulaan kuat kuasa Akta ini jika ia dibuat tetapi belum dimuktamadkan sebelum permulaan kuat kuasa Akta ini; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_164__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_164__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "tarikh yang permohonan itu dibuat hendaklah diambil kira sebagai tarikh pemfailan di bawah Akta yang dimansuhkan. Cap berdaftar sedia ada"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_165",
      "@type": "akn:clause",
      "eli:number": "165",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_165__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_165__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_165__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_165__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_165__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_165__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_165__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_165",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana cap berdaftar sedia ada yang disimpan dalam Daftar di bawah Akta yang dimansuhkan, tertakluk kepada peruntukan Bahagian ini, hendaklah menjadi suatu cap dagangan berdaftar bagi maksud Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_165__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_165",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana cap berdaftar sedia ada yang didaftarkan sebagai cap dagangan perakuan dalam Daftar yang disimpan di bawah Akta yang dimansuhkan hendaklah menjadi suatu cap perakuan berdaftar bagi maksud Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_165__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_165",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana cap berdaftar sedia ada yang didaftarkan sebagai satu siri cap dagangan dalam Daftar yang disimpan di bawah Akta yang dimansuhkan hendaklah juga didaftarkan dalam Daftar yang disimpan di bawah Akta ini bagi maksud Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_165__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_165",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana petunjuk bahawa cap berdaftar sedia ada dikaitkan dengan apa-apa cap lain hendaklah terhenti berkuat kuasa pada permulaan kuat kuasa Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_165__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_165",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu syarat, penafian atau pengehadan yang dicatatkan dalam Daftar di bawah Akta yang dimansuhkan berhubung dengan suatu cap berdaftar sedia ada sebaik sebelum permulaan kuat kuasa Akta ini hendaklah disatukan dalam Daftar yang disimpan di bawah Akta ini dan berkuat kuasa seolah-olah telah disatukan dalam Daftar menurut seksyen 36 Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_165__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_165",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 37 dan 38 Akta ini boleh terpakai berhubungan dengan cap berdaftar sedia ada di bawah Akta yang dimansuhkan pada permulaan kuat kuasa Akta ini. Kesan pendaftaran berhubung dengan pelanggaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_166",
      "@type": "akn:clause",
      "eli:number": "166",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_166__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_166__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_166__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_166",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 48, 49, 50, 51 dan 54 Akta ini terpakai berhubung dengan cap berdaftar sedia ada dari permulaan kuat kuasa Akta ini dan seksyen 56 Akta ini terpakai berhubung dengan pelanggaran cap berdaftar sedia ada yang dilakukan selepas permulaan kuat kuasa Akta ini, tertakluk kepada subseksyen (2)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_166__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_166",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 38 dan 51 Akta yang dimansuhkan terus terpakai berhubung dengan pelanggaran yang dilakukan sebelum permulaan kuat kuasa Akta ini. Barang-barang, bahan atau artikel yang melanggar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_167",
      "@type": "akn:clause",
      "eli:number": "167",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 59 Akta ini terpakai bagi barang-barang, bahan atau artikel yang melanggar sama ada permohonan bagi perintah itu dibuat sebelum atau selepas permulaan kuat kuasa Akta ini. Hak dan remedi pemegang lesen atau pengguna yang dibenarkan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_168",
      "@type": "akn:clause",
      "eli:number": "168",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_168__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_168__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_168__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_168",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 70 Akta ini terpakai bagi lesen yang diberikan sebelum permulaan kuat kuasa Akta ini hanya berhubung dengan pelanggaran yang dilakukan selepas permulaan kuat kuasa Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_168__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_168",
      "schema:text": {
        "@language": "ms",
        "@value": "Subperenggan 9(2) Jadual Kedua Akta ini hanya terpakai berhubung dengan pelanggaran yang dilakukan selepas permulaan kuat kuasa Akta ini. Ketuanpunyaan bersama cap berdaftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_169",
      "@type": "akn:clause",
      "eli:number": "169",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_169__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_169__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_169__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_169",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 63 Akta ini terpakai dari mula berkuat kuasanya Akta ini kepada cap berdaftar sedia ada yang dua atau lebih orang sebelum permulaan kuat kuasa didaftarkan sebagai tuan punya bersama."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_169__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_169",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika dua atau lebih orang yang didaftarkan sebagai tuan punya bersama bersama di bawah seksyen 21 Akta yang dimansuhkan hendaklah terus wujud seolah-olah Akta ini tidak diperbuat. Penyerahhakan, dsb., cap berdaftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_170",
      "@type": "akn:clause",
      "eli:number": "170",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_170__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_170__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_170__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_170__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_170__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_170__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_170__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_170",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 64 Akta ini terpakai bagi transaksi yang berlaku selepas permulaan kuat kuasa Akta ini berhubung dengan suatu cap berdaftar sedia ada dan Akta yang dimansuhkan terus terpakai berhubung dengan transaksi yang berlaku sebelum permulaan kuat kuasa Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_170__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_170",
      "schema:text": {
        "@language": "ms",
        "@value": "Catatan sedia ada di bawah seksyen 47 Akta yang dimansuhkan akan dipindahkan pada permulaan kuat kuasa Akta ini dalam Daftar yang disimpan di bawah Akta ini dan berkuat kuasa seolah-olah ia dibuat di bawah seksyen 65 Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_170__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_170",
      "schema:text": {
        "@language": "ms",
        "@value": "Permohonan bagi pendaftaran di bawah seksyen 47 Akta yang dimansuhkan yang belum selesai di hadapan Pendaftar pada permulaan kuat kuasa Akta ini atau yang telah ditentukan oleh Pendaftar tetapi belum dimuktamadkan sebelum mula berkuat kuasanya Akta ini hendaklah dikira sebagai permohonan bagi pendaftaran di bawah seksyen 65 dan 67 Akta ini dan hendaklah diteruskan dengan sewajarnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_170__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_170",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud subseksyen (3), Pendaftar boleh menghendaki pemohon untuk meminda permohonannya supaya mematuhi kehendak Akta ini dan subseksyen (2) hendaklah terpakai berhubung dengan apa-apa catatan yang terhasil dalam Daftar itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_170__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_170",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika sebelum permulaan kuat kuasa Akta ini, seseorang telah berhak dengan penyerahhakan atau perpindahan kepada cap berdaftar sedia ada tetapi belum mendaftarkan haknya, apa-apa permohonan bagi pendaftaran selepas permulaan kuat kuasa Akta ini hendaklah dibuat di bawah seksyen 64 Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_170__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_170",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud subseksyen (3) dan (5), subseksyen 47(3) Akta yang dimansuhkan hendaklah terus terpakai berkenaan dengan kesan kegagalan untuk didaftarkan. Pelesenan cap berdaftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_171",
      "@type": "akn:clause",
      "eli:number": "171",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_171__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_171__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_171__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_171__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_171__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_171__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_171",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 69 Akta ini terpakai hanya berhubung dengan lesen yang diberikan selepas permulaan kuat kuasa Akta ini dan Akta yang dimansuhkan terus terpakai berhubung dengan lesen yang diberikan sebelum permulaan kuat kuasa sehingga lesen itu habis tempoh."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_171__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_171",
      "schema:text": {
        "@language": "ms",
        "@value": "Catatan sedia ada di bawah seksyen 48 Akta yang dimansuhkan hendaklah dipindahkan pada permulaan Akta ini kepada Daftar yang disimpan di bawah Akta ini dan berkuat kuasa seolah-olah ia dibuat di bawah seksyen 65 Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_171__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_171",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu permohonan bagi pendaftaran sebagai pengguna berdaftar yang belum selesai di hadapan Pendaftar pada permulaan kuat kuasa Akta ini atau yang telah ditentukan oleh Pendaftar tetapi belum dimuktamadkan sebelum permulaan kuat kuasa Akta ini dikira sebagai suatu permohonan bagi pendaftaran suatu lesen di bawah seksyen 65 atau 67 Akta ini dan hendaklah diteruskan dengan sewajarnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_171__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_171",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar boleh menghendaki pemohon untuk meminda permohonannya supaya mematuhi kehendak Akta ini dan subseksyen (2) hendaklah terpakai berhubungan dengan apa-apa catatan yang terhasil dalam Daftar itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_171__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_171",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa prosiding yang belum selesai pada permulaan kuat kuasa Akta ini di bawah subseksyen 49(1) Akta yang dimansuhkan hendaklah diuruskan di bawah Akta yang dimansuhkan dan apa-apa perubahan yang perlu hendaklah dibuat pada Daftar di bawah Akta ini. Permohonan yang belum selesai bagi pendaftaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_172",
      "@type": "akn:clause",
      "eli:number": "172",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_172__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_172__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_172__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_172__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_172__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_172__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_172",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu permohonan bagi pendaftaran suatu cap di bawah Akta yang dimansuhkan yang belum selesai pada permulaan kuat kuasa Akta ini hendaklah diuruskan di bawah Akta yang dimansuhkan, tertakluk kepada subseksyen yang berikut, dan jika didaftarkan, cap itu hendaklah dikira bagi maksud seksyen ini sebagai cap berdaftar sedia ada."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_172__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_172",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 22 Akta yang dimansuhkan hendaklah tidaklah boleh diambil kira selepas mula berkuat kuasanya Akta ini untuk suatu permohonan bagi pendaftaran."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_172__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_172",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 34 dan 35 Akta ini hendaklah terpakai bagi suatu permohonan bagi pendaftaran suatu cap di bawah Akta yang dimansuhkan yang sedang menunggu penyiaran pada permulaan kuat kuasa Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_172__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_172",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 32, 33 dan 155 Akta ini hendaklah terpakai bagi suatu permohonan bagi pendaftaran suatu cap di bawah Akta yang dimansuhkan yang sedang menunggu pendaftaran pada permulaan kuat kuasa Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_172__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_172",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 37 atau 38 Akta ini boleh terpakai berhubungan dengan suatu permohonan bagi pendaftaran suatu cap di bawah Akta yang dimansuhkan yang sedang menunggu pendaftaran pada permulaan kuat kuasa Akta ini. Penukaran permohonan yang belum selesai"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_173",
      "@type": "akn:clause",
      "eli:number": "173",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_173__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_173__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_173__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_173__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_173",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam hal permohonan yang menunggu pendaftaran yang belum diperiksa di bawah Akta yang dimansuhkan sebelum permulaan kuat kuasa Akta ini, pemohon boleh memberikan notis kepada Pendaftar menuntut kebolehdaftaran cap itu ditentukan mengikut peruntukan Akta ini ."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_173__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_173",
      "schema:text": {
        "@language": "ms",
        "@value": "Notis itu hendaklah difailkan mengikut bentuk yang ditentukan oleh Pendaftar bersama dengan pembayaran fi yang ditetapkan dalam masa dua bulan dari tarikh permulaan kuat kuasa Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_173__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_173",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu notis yang difailkan di bawah subseksyen (2) hendaklah tidak boleh dibatalkan dan hendaklah mempunyai kesan bahawa permohonan itu hendaklah dikira seolah-olah permohonan bagi pendaftaran dibuat selepas permulaan kuat kuasa Akta ini. Cap dagangan yang didaftarkan mengikut pengelasan lama"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_174",
      "@type": "akn:clause",
      "eli:number": "174",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_174__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_174__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_174__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_174",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar boleh menjalankan kuasa yang diberikan oleh Peraturan-peraturan di bawah seksyen 159 Akta ini untuk memastikan bahawa mana-mana cap berdaftar sedia ada yang tidak menepati sistem pengelasan sebagaiman yang ditetapkan di bawah seksyen 19 Akta ini di dibuat supaya menepati dengan sistem itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_174__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_174",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen (1) hendaklah terpakai bagi cap berdaftar sedia ada yang dikelaskan mengikut pengelasan sebagaimana yang dinyatakan dalam Jadual Ketiga Peraturan-Peraturan Cap Dagangan 1997 [P.U. (A) 460/1997]. Tuntutan keutamaan permohonan konvensyen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_175",
      "@type": "akn:clause",
      "eli:number": "175",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_175__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_175__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_175__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_175",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika sebelum Akta ini berkuat kuasa, seseorang telah memfailkan permohonan bagi perlindungan suatu cap dagangan di dalam negara Konvensyen sebelum permulaan kuat kuasa Akta ini, seksyen 26, 27 atau 28 Akta ini hendaklah terpakai bagi suatu permohonanyang dibuat bagi pendaftaran di bawah Akta ini dibuat selepas permulaan kuat kuasa Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_175__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_175",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada apa-apa jua dalam seksyen ini memberi kesan kepada prosiding permohonan bagi pendaftaran di bawah Akta yang dimansuhkan yang dibuat sebelum permulaan kuat kuasa Akta ini. Tempoh dan pembaharuan pendaftaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_176",
      "@type": "akn:clause",
      "eli:number": "176",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_176__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_176__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_176__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_176__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_176",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 39(1) Akta ini hendaklah terpakai berhubung dengan pendaftaran suatu cap dagangan berhubung dengan suatu permohonan yang dibuat selepas permulaan kuat kuasa Akta ini dan undang-undang yang dimansuhkan hendaklah terus terpakai berhubung dengan suatu cap dagangan yang didaftarkan sebelum permulaan kuat kuasa Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_176__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_176",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 39 (2) dan seksyen 40 Akta ini hendaklah terpakai jika pembaharuan cap berdaftar sedia ada di bawah Akta yang dimansuhkan itu yang menjadi genap masa pada atau selepas permulaan kuat kuasa Akta ini dan Akta yang dimansuhkan hendaklah terus terpakai bagi cap berdaftar sedia ada jika pembaharuannya tidak menjadi genap masa pada atau selepas permulaan kuat kuasa Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_176__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_176",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud subseksyen (2), fi pembaharuan di bawah Akta ini hendaklah terpakai tidak kira apa-apa fi telah dibayar sebelum permulaan kuat kuasa Akta ini. Pendaftaran yang belum selesai bagi penukaran cap berdaftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_177",
      "@type": "akn:clause",
      "eli:number": "177",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Permohonan di bawah seksyen 44 Akta yang dimansuhkan yang belum selesai pada permulaan kuat kuasa Akta ini hendaklah diuruskan di bawah Akta yang dimansuhkan dan apa-apa perubahan yang perlu hendaklah dibuat pada Daftar dalam Akta ini. Pembatalan bagi ketiadaan penggunaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_178",
      "@type": "akn:clause",
      "eli:number": "178",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_178__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_178__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_178__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_178__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_178",
      "schema:text": {
        "@language": "ms",
        "@value": "Permohonan di bawah seksyen 46 Akta yang dimansuhkan yang belum selesai pada permulaan kuat kuasa Akta ini hendaklah diuruskan di bawah Akta yang dimansuhkan dan apa-apa perubahan yang perlu hendaklah dibuat pada Daftar dalam Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_178__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_178",
      "schema:text": {
        "@language": "ms",
        "@value": "Permohonan di bawah seksyen 46 Akta ini boleh dibuat berhubung dengan suatu cap berdaftar sedia ada selepas permulaan kuat kuasa Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_178__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_178",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (2), permohonan pembatalan pendaftaran cap berdaftar sedia ada yang didaftarkan di bawah seksyen 57 Akta yang dimansuhkan hanya boleh dibuat lima tahun selepas permulaan kuat kuasa Akta ini. Permohonan bagi pembetulan, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_179",
      "@type": "akn:clause",
      "eli:number": "179",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_179__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_179__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_179__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_179",
      "schema:text": {
        "@language": "ms",
        "@value": "Permohonan di bawah seksyen 43 atau 45 Akta yang dimansuhkan yang belum selesai pada permulaan kuat kuasa Akta ini hendaklah diuruskan di bawah Akta yang dimansuhkan dan apa-apa perubahan yang perlu hendaklah dibuat pada Daftar dalam Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_179__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_179",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud prosiding di bawah seksyen 47 Akta ini sebagaimana yang terpakai berhubung dengan suatu cap berdaftar sedia ada, peruntukan Akta ini hendaklah disifatkan telah berkuat kuasa pada setiap masa yang material, kecuali tidak ada bantahan terhadap kesahan pendaftaran cap berdaftar yang sedia ada boleh diambil atas alasan yang dinyatakan dalam subseksyen 24(3) Akta ini. Kaedah-kaedah mengenai penggunaan cap perakuan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_180",
      "@type": "akn:clause",
      "eli:number": "180",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_180__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_180__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_180__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_180",
      "schema:text": {
        "@language": "ms",
        "@value": "Kaedah-kaedah yang mengawal penggunaan cap dagangan perakuan berdaftar sedia ada yang didepositkan di Pejabat Pusat Cap Dagangan menurut seksyen 56 Akta yang dimansuhkan hendaklah dikira selepas permulaan kuat kuasa Akta ini seolah-olah ia difailkan mengikut Jadual Kedua Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_180__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_180",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa permintaan bagi pindaan kaedah-kaedah yang belum selesai pada permulaan kuat kuasa Akta ini hendaklah diuruskan mengikut Akta ini. Ejen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_181",
      "@type": "akn:clause",
      "eli:number": "181",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_181__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_181__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_181__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_181",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftaran ejen yang dimohon di bawah Akta yang dimansuhkan sebelum permulaan kuat kuasa Akta ini hendaklah terus berkuat kuasa dan hendaklah mempunyai kuat kuasa seolah- olah dibuat di bawah seksyen 97 Akta ini dan jika didaftarkan, ejen itu hendaklah dikira sebagai ejen cap dagangan berdaftar di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_181__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_181",
      "schema:text": {
        "@language": "ms",
        "@value": "Kehendak bagi pembaharuan pendaftaran ejen cap dagangan di bawah Akta ini hendaklah terpakai bagi pendaftaran ejen yang diperoleh di bawah Akta yang dimansuhkan. Garis panduan, dsb., mengenai perkara peralihan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2__cl_182",
      "@type": "akn:clause",
      "eli:number": "182",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XIX__chp_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar boleh mengeluarkan garis panduan atau arahan amalan untuk mengadakan peruntukan bagi apa-apa perkara yang berkuat kuasa sebelum permulaan kuat kuasa Akta ini diuruskan mengikut apa-apa cara untuk memastikan perkara itu bertepatan dengan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XI__cl_72",
      "@type": "akn:clause",
      "eli:number": "72",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XI__cl_72__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XI__cl_72__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XI__cl_72__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XI__cl_72",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu cap kolektif ialah suatu tanda yang membezakan barang-barang atau perkhidmatan anggota persatuan yang merupakan tuan punya tanda daripada anggota persatuan yang lain."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XI__cl_72__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XI__cl_72",
      "schema:text": {
        "@language": "ms",
        "@value": "Peruntukan Akta ini terpakai bagi cap kolektif tertakluk kepada peruntukan Jadual Pertama. Cap perakuan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XI__cl_73",
      "@type": "akn:clause",
      "eli:number": "73",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XI__cl_73__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XI__cl_73__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XI__cl_73__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XI__cl_73",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu cap perakuan hendaklah menjadi suatu tanda yang menunjukkan bahawa barang-barang atau perkhidmatan itu yang berkaitan dengan tanda itu hendaklah digunakan adalah diperakui oleh tuan punya cap berkenaan dengan tempat asal, bahan, cara pengilangan barang-barang atau pelaksanaan perkhidmatan, kualiti, ketepatan atau ciri-ciri lain."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XI__cl_73__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XI__cl_73",
      "schema:text": {
        "@language": "ms",
        "@value": "Peruntukan Akta ini terpakai bagi cap perakuan tertakluk kepada peruntukan Jadual Kedua."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_XV",
