      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_I__cl_2__subsec_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_I__cl_2__subsec_1__list_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_I__cl_2__subsec_1__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "cara penggunaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_I__cl_2__subsec_1__list_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_I__cl_2__subsec_1__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "penggunaan di dalam sesuatu kawasan wilayah di dalam Malaysia; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_I__cl_2__subsec_1__list_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_I__cl_2__subsec_1__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "penggunaan berhubung dengan barang-barang yang akan dieksport ke suatu pasaran di luar Malaysia atau penggunaan berhubung dengan perkhidmatan yang akan disediakan di suatu tempat di luar Malaysia; “Penolong Pendaftar” dan “Timbalan Pendaftar” ertinya orang yang dilantik di bawah subseksyen 10(3) untuk menjadi Penolong Pendaftar Cap Dagangan atau Timbalan Pendaftar Cap Dagangan; “Perbadanan” ertinya Perbadanan Harta Intelek Malaysia yang ditubuhkan di bawah Akta Perbadanan Harta Intelek Malaysia 2002 [Akta 617]; “perdagangan” termasuklah apa-apa perniagaan atau profesion; “Perjanjian TRIPS” ertinya Perjanjian mengenai Aspek yang berhubungan dengan Perdagangan bagi Hak Harta Intelek 1994 yang merupakan Lampiran 1C kepada Perjanjian Penubuhan Pertubuhan Perdagangan Dunia; “permohonan konvensyen” ertinya suatu permohonan bagi perlindungan cap dagangan di dalam suatu negara konvensyen; “perpindahan” ertinya perpindahan dengan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_I__cl_2__subsec_1__list_3",
      "@type": "akn:list",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_I__cl_2__subsec_1__list_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_I__cl_2__subsec_1__list_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_I__cl_2__subsec_1__list_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_I__cl_2__subsec_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_I__cl_2__subsec_1__list_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_I__cl_2__subsec_1__list_3",
      "schema:text": {
        "@language": "ms",
        "@value": "kuat kuasa undang-undang;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_I__cl_2__subsec_1__list_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_I__cl_2__subsec_1__list_3",
      "schema:text": {
        "@language": "ms",
        "@value": "pemberian berwasiat; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_I__cl_2__subsec_1__list_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_I__cl_2__subsec_1__list_3",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa cara pemindahmilikan lain kecuali penyerahhakan; “petunjuk geografi” mempunyai erti yang sama yang diberikan kepadanya di bawah seksyen 2 Akta Petunjuk Geografi 2000 [Akta 602]; “tanda” termasuklah apa-apa huruf, perkataan, nama, tandatangan, angka, logo, jenama, tajuk, label, tiket, bentuk barang-barang atau bungkusannya, warna, bunyi, bau, hologram, kedudukan, urutan gerakan atau apa-apa gabungannya; “transaksi boleh daftar” ertinya transaksi yang ditentukan oleh Pendaftar dalam garis panduan atau arahan amalan di bawah seksyen 160; “tuan punya berdaftar” ertinya orang yang pada masa sekarang tercatat dalam Daftar sebagai tuan punya berdaftar cap dagangan itu. Takrif “cap dagangan”"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_I__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_I__cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_I__cl_3__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_I__cl_3__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_I__cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_I__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "“Cap dagangan” ertinya apa-apa tanda yang boleh dinyatakan secara grafik yang boleh membezakan barang-barang atau perkhidmatan satu perusahaan daripada perusahaan-perusahaan yang lain."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_I__cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_I__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu tanda boleh menjadi suatu cap dagangan walaupun tanda itu digunakan berhubung dengan perkhidmatan sampingan kepada suatu perdagangan atau perniagaan perusahaan dan sama ada atau tidak perkhidmatan itu disediakan untuk wang atau nilaian wang."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_I__cl_3__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_I__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Sebutan mengenai cap dagangan dalam Akta ini, melainkan jika konteksnya menghendaki makna yang lain, termasuklah sebutan mengenai cap kolektif atau cap perakuan. Takrif “cap dagangan terkenal”"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_I__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_I__cl_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_I__cl_4__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_I__cl_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_I__cl_4__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_I__cl_4__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_I__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "“Cap dagangan terkenal” ertinya apa-apa cap dagangan yang terkenal di Malaysia dan yang dipunyai oleh seseorang yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_I__cl_4__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_I__cl_4__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "merupakan rakyat suatu negara Konvensyen; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_I__cl_4__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_I__cl_4__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "berdomisil, atau mempunyai perusahaan perindustrian atau komersial yang sebenar dan berhasil, di dalam suatu negara Konvensyen, sama ada atau tidak orang itu menjalankan perniagaan, atau mempunyai nama baik, di Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_I__cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_I__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam menentukan sama ada suatu cap dagangan itu ialah cap dagangan terkenal di Malaysia, Pendaftar atau Mahkamah hendaklah mengambil kira kriteria sebagaimana yang ditetapkan. Takrif “cap dagangan terdahulu”"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_I__cl_5",
