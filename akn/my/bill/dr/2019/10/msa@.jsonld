        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_40",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_41"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "TEMPOH DAN PEMBAHARUAN CAP DAGANGAN BERDAFTAR Tempoh dan pembaharuan pendaftaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII",
      "@type": "akn:part",
