    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_III",
      "@type": "akn:part",
      "eli:number": "III",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_III__cl_14",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_III__cl_15"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "DAFTAR CAP DAGANGAN Daftar Cap Dagangan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_III__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_III__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_III__cl_14__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_III__cl_14__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_III__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_III__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar hendaklah menyimpan dan menyenggara suatu daftar yang dinamakan Daftar Cap Dagangan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_III__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_III__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Daftar hendaklah mengandungi semua perkara dan butir-butir yang berhubungan dengan cap dagangan sebagaimana yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_III__cl_14__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_III__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Daftar hendaklah disimpan mengikut bentuk sebagaimana yang ditentukan oleh Pendaftar. Pemeriksaan Daftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_III__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_III__cl_15__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_III__cl_15__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_III__cl_15__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_III__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Daftar hendaklah terbuka untuk pemeriksaan awam tertakluk kepada syarat sebagaimana yang ditetapkan, atas permohonan mengikut bentuk yang ditentukan oleh Pendaftar bersama dengan pembayaran fi yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_III__cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_III__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada syarat dalam subseksyen (1), salinan yang diperaku atau cabutan apa-apa catatan dalam Daftar yang dimeteraikan dengan meterai Pendaftar hendaklah diberikan kepada mana-mana orang atas permohonan mengikut bentuk yang ditentukan oleh Pendaftar bersama dengan pembayaran fi yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_II__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_II__cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_II__cl_10__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_II__cl_10__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_II__cl_10__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_II__cl_10__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_II__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah Perbadanan hendaklah menjadi Pendaftar Cap Dagangan dan mempunyai kawalan terhadap Pejabat Cap Dagangan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_II__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar hendaklah melaksanakan kewajipan yang dikenakan dan menjalankan kuasa yang diberikan ke atasnya di bawah Akta ini bagi pentadbiran yang sepatutnya Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_II__cl_10__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbadanan boleh melantik, atas apa-apa terma dan syarat sebagaimana Perbadanan boleh tentukan, dalam kalangan orang dalam penggajian Perbadanan, apa-apa bilangan Timbalan Pendaftar Cap Dagangan, Penolong Pendaftar Cap Dagangan dan pegawai lain yang perlu bagi pentadbiran yang sepatutnya Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_II__cl_10__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada arahan dan kawalan am Pendaftar dan kepada apa-apa syarat atau sekatan yang dikenakan oleh Pendaftar, seseorang Timbalan Pendaftar atau seseorang Penolong Pendaftar boleh menjalankan apa-apa fungsi Pendaftar di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_II__cl_10__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar hendaklah mempunyai meterai dengan reka bentuk yang diluluskan oleh Perbadanan dan teraan meterai itu hendaklah diberikan pengiktirafan kehakiman dan diterima sebagai keterangan. Perlindungan Pendaftar, Timbalan Pendaftar, Penolong Pendaftar dan pegawai lain"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_II__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_II__cl_11__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_II__cl_11__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada tindakan, guaman, pendakwaan atau prosiding lain boleh dibawa, dimulakan atau dikekalkan dalam mana-mana mahkamah terhadap—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_II__cl_11__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_II__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar, Timbalan Pendaftar, Penolong Pendaftar atau pegawai lain, berkenaan dengan apa-apa perbuatan yang diperintahkan atau dilakukan bagi maksud melaksanakan Akta ini; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_II__cl_11__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_II__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana pegawai lain berkenaan dengan apa-apa perbuatan yang dilakukan atau berupa sebagai dilakukan olehnya di bawah perintah, arahan atau suruhan Pendaftar jika perbuatan itu dilakukan dengan suci hati dan kepercayaan munasabah bahawa ia perlu bagi maksud yang dihasratkan untuk dicapai dengannya. Pejabat Cap Dagangan dan pejabat cawangan lain"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_II__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_II__cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_II__cl_12__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_II__cl_12__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_II__cl_12__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_II__cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_II__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Pejabat Pusat Cap Dagangan dan pejabat wilayah cap dagangan yang ditubuhkan di bawah Akta yang dimansuhkan hendaklah dikenali sebagai Pejabat Cap Dagangan dan pejabat cawangan, masing-masing."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_II__cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_II__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Tambahan kepada subseksyen (1), bagi maksud Akta ini, apa-apa bilangan pejabat cawangan bagi Pejabat Dagangan sebagaimana yang perlu boleh ditubuhkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_II__cl_12__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_II__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa dokumen yang dikehendaki di bawah Akta ini untuk difailkan di Pejabat Cap Dagangan boleh difailkan di mana-mana bagi pejabat cawangan Pejabat Cap Dagangan dan sebutan dalam Akta ini mengenai pengemukaan di Pejabat Cap Dagangan termasuklah sebutan mengenai pengemukaan di sesuatu pejabat cawangan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_II__cl_12__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_II__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua komunikasi dengan Pejabat Cap Dagangan hendaklah dalam bahasa kebangsaan atau bahasa Inggeris. Pendapat dan carian awal oleh Pendaftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_II__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_II__cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_II__cl_13__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_II__cl_13__subsec_3",
