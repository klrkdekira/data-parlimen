        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_44",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_46",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_47"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "PENGUBAHAN, PEMBETULAN, PEMOTONGAN, PEMBATALAN DAN KETIDAKSAHAN Pengubahan cap dagangan berdaftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII",
      "@type": "akn:part",
      "eli:number": "VIII",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "KESAN CAP DAGANGAN BERDAFTAR"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1",
      "@type": "akn:chapter",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_48",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_49",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_50",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_51",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_52",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_53"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII",
      "schema:text": {
        "@language": "ms",
        "@value": "Hak tuan punya berdaftar cap dagangan berdaftar Hak yang diberikan oleh cap dagangan berdaftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_48",
      "@type": "akn:clause",
      "eli:number": "48",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_48__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_48__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_48__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_48__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_48__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_48__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_48__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_48__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_48",
      "schema:text": {
        "@language": "ms",
        "@value": "Tuan punya berdaftar cap dagangan mempunyai hak eksklusif—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_48__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_48__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menggunakan cap dagangan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_48__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_48__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk membenarkan orang lain untuk menggunakan cap dagangan itu, berhubung dengan barang-barang atau perkhidmatan yang baginya cap dagangan itu didaftarkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_48__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_48",
      "schema:text": {
        "@language": "ms",
        "@value": "Tuan punya berdaftar mempunyai hak untuk mendapatkan relief bagi pelanggaran cap dagangannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_48__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_48",
      "schema:text": {
        "@language": "ms",
        "@value": "Perbuatan yang terjumlah kepada pelanggaran cap dagangan dinyatakan dalam seksyen 54 dan sebutan mengenai pelanggaran suatu cap dagangan berdaftar hendaklah ditafsirkan dengan sewajarnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_48__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_48__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_48__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_48",
      "schema:text": {
        "@language": "ms",
        "@value": "Hak itu hendaklah terakru kepada tuan punya dari tarikh pendaftaran cap dagangan itu kecuali bahawa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_48__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_48__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "tiada prosiding pelanggaran boleh dimulakan sebelum tarikh cap dagangan itu sebenarnya didaftarkan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_48__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_48__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "tiada kesalahan di bawah seksyen 99 hingga 102 dilakukan oleh apa-apa yang dibuat sebelum tarikh cap dagangan itu sebenarnya didaftarkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_48__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_48",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika cap dagangan didaftarkan tertakluk kepada apa-apa penafian, syarat, pindaan, pengubahsuaian atau pengehadan, hak tuan punya disekat oleh penafian, syarat, pindaan, pengubahsuaian atau pengehadan itu. Pengehadan atas hak jika cap dagangan yang hampir serupa, dsb., didaftarkan oleh orang berlainan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_49",
      "@type": "akn:clause",
      "eli:number": "49",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika cap dagangan yang secara substansial adalah serupa atau hampir serupa telah didaftarkan oleh lebih daripada satu orang sama ada berkenaan dengan barang-barang atau perkhidmatan yang sama atau berbeza di bawah seksyen 25, tuan punya berdaftar mana-mana satu cap dagangan itu tidak mempunyai hak untuk menghalang tuan punya berdaftar mana-mana cap dagangan yang lain daripada menggunakan cap dagangan itu kecuali setakat yang tuan punya pertama yang disebutkan dibenarkan untuk melakukannya di bawah pendaftaran cap dagangannya. Cap dagangan yang terdiri daripada tanda yang diterima sebagai tanda yang memperihalkan artikel, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_50",
      "@type": "akn:clause",
      "eli:number": "50",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_50__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_50__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_50__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_50__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_50__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_50",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen ini terpakai jika cap dagangan berdaftar mengandungi atau terdiri daripada, suatu tanda yang, selepas tarikh pendaftaran cap dagangan, diterima secara amnya dalam perdagangan yang berkaitan sebagai tanda yang memperihalkan atau ialah nama suatu artikel, bahan atau perkhidmatan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_50__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_50__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_50__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_50",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud subseksyen (1), jika cap dagangan itu terdiri daripada tanda itu, tuan punya berdaftar—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_50__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_50__subsec_2__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_50__subsec_2__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_50__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak mempunyai apa-apa hak eksklusif untuk menggunakan, atau membenarkan orang lain untuk menggunakan, cap dagangan itu berhubungan dengan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_50__subsec_2__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_50__subsec_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "artikel atau bahan atau barang-barang lain dengan perihal yang sama; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_50__subsec_2__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_50__subsec_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "perkhidmatan atau perkhidmatan lain dengan perihal yang sama, dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_50__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_50__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dikira sebagai tidak lagi mempunyai hak eksklusif itu dari dan termasuk hari yang ditentukan oleh Mahkamah di bawah subseksyen (4)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_50__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_50__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_50__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_50",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud subseksyen (1), jika cap dagangan itu mengandungi tanda itu, tuan punya berdaftar—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_50__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_50__subsec_3__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_50__subsec_3__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_50__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak mempunyai apa-apa hak eksklusif untuk menggunakan, atau membenarkan orang lain untuk menggunakan, tanda itu berhubung dengan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_50__subsec_3__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_50__subsec_3__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "artikel atau bahan atau barang-barang lain dengan perihal yang sama; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_50__subsec_3__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_50__subsec_3__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "perkhidmatan atau perkhidmatan lain dengan perihal yang sama; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_50__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_50__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dikira sebagai terhenti untuk mempunyai hak eksklusif itu dari hari yang ditentukan oleh Mahkamah di bawah subseksyen (4)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_50__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_50",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud subseksyen (2) dan (3), Mahkamah boleh menentukan hari yang suatu tanda mula-mula diterima secara amnya dalam perdagangan yang berkaitan sebagaimana tanda yang memperihalkan atau ialah nama artikel, bahan atau perkhidmatan. Cap dagangan yang berhubungan dengan artikel, dsb., yang dahulunya dihasilkan di bawah paten"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_51",
      "@type": "akn:clause",
      "eli:number": "51",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_51__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_51__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_51__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_51__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_51__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_51__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_51",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen ini terpakai jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_51__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_51__subsec_1__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_51__subsec_1__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_51__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu cap dagangan berdaftar mengandungi atau terdiri daripada cap dagangan yang memperihalkan atau ialah nama bagi—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_51__subsec_1__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_51__subsec_1__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu artikel atau bahan yang dahulunya dieksploitasi di bawah suatu paten; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_51__subsec_1__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_51__subsec_1__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "perkhidmatan yang dahulunya disediakan sebagai proses yang dipatenkan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_51__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_51__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "sekurang-kurangnya sudah dua tahun sejak paten habis tempoh atau terhenti; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_51__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_51__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tanda itu merupakan satu-satunya cara yang diketahui umum untuk memperihalkan atau mengenal pasti artikel, bahan atau perkhidmatan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_51__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_51__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_51__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_51",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika cap dagangan itu mengandungi atau terdiri daripada tanda dalam perenggan (1)(a), tuan punya berdaftar—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_51__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_51__subsec_2__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_51__subsec_2__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_51__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak mempunyai apa-apa hak eksklusif untuk menggunakan, atau membenarkan orang lain untuk menggunakan, cap dagangan atau tanda itu berhubungan dengan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_51__subsec_2__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_51__subsec_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "artikel atau bahan atau barang-barang lain dengan perihal yang sama; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_51__subsec_2__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_51__subsec_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "perkhidmatan atau perkhidmatan lain dengan perihal yang sama; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_51__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_51__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dikira terhenti dari mempunyai hak eksklusif itu dari akhir tempoh dua tahun selepas paten itu tamat tempoh atau terhenti. Pendaftaran ialah keterangan prima facie"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_52",
      "@type": "akn:clause",
      "eli:number": "52",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_52__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_52__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_52__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam semua prosiding undang-undang yang berhubungan dengan cap dagangan berdaftar—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_52__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_52",
      "schema:text": {
        "@language": "ms",
        "@value": "Daftar itu hendaklah menjadi keterangan prima facie mengenai apa-apa yang terkandung dalam Daftar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_52__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_52",
      "schema:text": {
        "@language": "ms",
        "@value": "pendaftaran butir-butir yang ditetapkan bagi apa-apa transaksi yang boleh didaftarkan di bawah seksyen 65 hendaklah menjadi keterangan prima facie mengenai transaksi itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_52__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_52__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_52__para_c__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_52",
      "schema:text": {
        "@language": "ms",
        "@value": "pendaftaran seseorang sebagai tuan punya berdaftar cap dagangan hendaklah menjadi keterangan prima facie mengenai—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_52__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_52__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "kesahan pendaftaran asal cap dagangan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_52__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_52__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa penyerahhakan atau perpindahan terkemudian. Pendaftaran muktamad"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_53",
      "@type": "akn:clause",
      "eli:number": "53",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_53__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_53__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_53__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam semua prosiding undang-undang yang berhubungan dengan suatu cap dagangan dalam Daftar, pendaftaran asal cap dagangan itu hendaklah, selepas habis lima tahun dari tarikh pendaftaran itu, dikira sebagai sah mengenai semua perkara melainkan jika dibuktikan bahawa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_53__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_53",
      "schema:text": {
        "@language": "ms",
        "@value": "pendaftaran asal itu telah diperoleh secara fraud;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_53__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_53",
      "schema:text": {
        "@language": "ms",
        "@value": "cap dagangan itu bersalahan dengan perenggan 23(5)(a), (c), (d) atau (e); atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_53__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_1__cl_53",
      "schema:text": {
        "@language": "ms",
        "@value": "cap dagangan itu, pada permulaan prosiding, lagi tidak distingtif bagi barang-barang atau perkhidmatan tuan punya berdaftar itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2",
      "@type": "akn:chapter",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_54",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_57",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_58",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_59",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_60",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_61"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII",
      "schema:text": {
        "@language": "ms",
        "@value": "Pelanggaran Cap Dagangan Perbuatan yang terjumlah sebagai pelanggaran cap dagangan berdaftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_54",
      "@type": "akn:clause",
      "eli:number": "54",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_54__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_54__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_54__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_54__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_54__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_54",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang melanggar suatu cap dagangan berdaftar jika dia menggunakan tanda yang serupa dengan cap dagangan berhubungan dengan barang-barang atau perkhidmatan yang serupa dengan orang yang baginya ia didaftarkannya, dalam penjalanan perdagangan, tanpa persetujuan tuan punya berdaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_54__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_54__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_54__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_54",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang melanggar suatu cap dagangan berdaftar jika, tanpa persetujuan tuan punya cap dagangan itu, dia menggunakan dalam penjalanan perdagangan suatu tanda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_54__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_54__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "yang serupa dengan cap dagangan itu dan digunakan berhubungan dengan barang-barang atau perkhidmatan yang hampir serupa dengan barang-barang atau perkhidmatan yang baginya cap dagangan itu didaftarkan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_54__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_54__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "hampir serupa dengan cap dagangan itu dan digunakan berhubung dengan barang-barang atau perkhidmatan yang serupa dengan atau hampir serupa dengan barang- barang atau perkhidmatan yang baginya cap dagangan itu didaftarkan, menyebabkan kebarangkalian kekeliruan di pihak orang awam."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_54__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_54__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_54__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_54__subsec_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_54__subsec_3__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_54__subsec_3__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_54__subsec_3__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_54__subsec_3__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_54__subsec_3__para_h"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_54",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini, seseorang menggunakan suatu tanda jika dia—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_54__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_54__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "memakaikan tanda itu pada barang-barang atau pembungkusan barang-barang;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_54__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_54__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "menawarkan atau mendedahkan barang-barang dengan tanda itu bagi jualan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_54__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_54__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "meletakkan barang-barang di pasaran dengan tanda itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_54__subsec_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_54__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "menyimpan barang-barang dengan tanda itu bagi maksud menawarkan atau mendedahkan barang-barang itu bagi jualan atau meletakkannya di pasaran;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_54__subsec_3__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_54__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "menawarkan atau membekalkan perkhidmatan dengan tanda itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_54__subsec_3__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_54__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "mengimport atau mengeksport barang-barang dengan tanda itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_54__subsec_3__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_54__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "menggunakan tanda itu pada invois, katalog, surat perniagaan, kertas kerja perniagaan, senarai harga atau dokumen komersial lain, termasuk apa-apa dokumen dalam apa-apa perantara; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_54__subsec_3__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_54__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "menggunakan tanda itu dalam iklan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_54__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_54__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_54__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_54",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_54__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_54__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "memakaikan cap dagangan berdaftar pada apa-apa bahan yang digunakan atau diniatkan untuk digunakan bagi pelabelan atau pembungkusan barang-barang; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_54__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_54__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "menggunakan suatu tanda pada apa-apa dokumen yang diperihalkan dalam perenggan (3)(g) atau (h), hendaklah dikira sebagai pihak yang menggunakan bahan yang melanggar cap dagangan berdaftar itu jika semasa dia memakaikan cap dagangan itu, dia mengetahui atau mempunyai alasan untuk mempercayai bahawa pemakaian cap dagangan itu tidak mendapat kebenaran daripada tuan punya berdaftar cap dagangan itu atau pemegang lesennya. Perbuatan yang tidak terjumlah sebagai pelanggaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55",
      "@type": "akn:clause",
      "eli:number": "55",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun seksyen 54, seseorang tidak melanggar suatu cap dagangan berdaftar apabila—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55__subsec_1__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55__subsec_1__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dia menggunakan dengan suci hati—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55__subsec_1__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55__subsec_1__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "namanya sendiri atau nama tempat perniagaannya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55__subsec_1__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55__subsec_1__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "nama pendahulunya dalam perniagaan atau nama tempat perniagaan pendahulunya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55__subsec_1__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dia menggunakan dengan suci hati suatu tanda untuk menunjukkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "jenis, kualiti, kuantiti, kegunaan spesifik, nilai, tempat asal geografi atau ciri-ciri lain barang-barang atau perkhidmatan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "masa pengeluaran barang-barang atau pemberian perkhidmatan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dia menggunakan cap dagangan itu untuk menunjukkan kegunaan barang-barang itu yang termasuklah aksesori atau alat ganti atau perkhidmatan, dan penggunaan itu adalah mengikut amalan jujur dalam perkara perindustrian atau komersial."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun seksyen 54, seseorang tidak melanggar suatu cap dagangan berdaftar apabila menggunakan suatu cap dagangan tidak berdaftar yang serupa dengan atau hampir serupa dengan cap dagangan berdaftar itu berhubungan dengan barang-barang atau perkhidmatan yang serupa dengan atau hampir serupa dengan barang-barang atau perkhidmatan yang baginya cap dagangan itu didaftarkan jika dia telah, atau dia dan pendahulunya dalam perniagaan telah, secara terus menggunakan dalam perdagangan cap dagangan yang tidak berdaftar berkenaan dengan barang-barang atau perkhidmatan dari masa sebelum—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "tarikh pendaftaran cap dagangan berdaftar itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "tarikh tuan punya berdaftar, atau yang pendulunya dalam perniagaan, atau orang yang merupakan pengguna berdaftar di bawah Akta yang dimansuhkan, mula-mula menggunakan cap dagangan itu, mengikut mana-mana yang lebih awal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55__subsec_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55__subsec_3__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun apa-apa jua yang terkandung dalam Akta ini, seseorang yang menggunakan cap dagangan berdaftar tidak melanggar cap dagangan itu jika penggunaan itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "adalah bagi maksud bukan komersial;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "adalah bagi maksud pelaporan berita atau ulasan berita;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "telah pada bila-bila masa secara nyata atau tersirat telah dipersetujui oleh tuan punya berdaftar atau pemegang lesen; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55__subsec_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi cap dagangan, yang merupakan salah satu daripada dua atau lebih cap dagangan berdaftar yang secara substansial adalah serupa, pada pelaksanaan hak penggunaan cap dagangan yang diberikan itu oleh pendaftaran sebagaimana yang diperuntukkan oleh Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_55",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun apa-apa jua yang terkandung dalam Akta ini, suatu cap dagangan berdaftar tidak dilanggar oleh penggunaan cap dagangan berdaftar lain berhubung dengan barang-barang atau perkhidmatan yang didaftarkan olehnya terkemudian itu. Tindakan ke atas pelanggaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56",
      "@type": "akn:clause",
      "eli:number": "56",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_9"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56",
      "schema:text": {
        "@language": "ms",
        "@value": "Tuan punya berdaftar berhak untuk memulakan prosiding Mahkamah terhadap mana-mana orang yang telah melanggar atau sedang melanggar cap dagangan berdaftarnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56",
      "schema:text": {
        "@language": "ms",
        "@value": "Tuan punya berdaftar hendaklah mempunyai hak tindakan yang sama dalam subseksyen (1) terhadap mana-mana orang yang telah melakukan perbuatan yang berkemungkinan akan menyebabkan bahawa pelanggaran berlaku."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_3__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam tindakan ke atas pelanggaran, Mahkamah boleh memberikan relief termasuk yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu injunksi tertakluk kepada apa-apa syarat yang difikirkan patut oleh Mahkamah yang termasuk untuk menghalang barang-barang yang melibatkan pelanggaran daripada memasuki saluran perdagangan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "ganti rugi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "akaun keuntungan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam apa-apa hal yang subseksyen (7) terpakai, award bagi apa-apa ganti rugi tambahan sebagaimana yang difikirkan sesuai dalam hal keadaan itu oleh Mahkamah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun perenggan (3)(a), atas permohonan plaintif bagi injunksi interim, apabila Mahkamah berpuas hati bahawa pelanggaran itu melibatkan penggunaan suatu cap dagangan lancung berhubung dengan barang-barang atau perkhidmatan, Mahkamah boleh memerintahkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "penyitaan atau pengambilan jagaan barang-barang, bahan atau artikel yang disyaki adalah berkaitan dengan pelanggaran itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "pembelian bukti dokumentasi yang berkaitan dengan pelanggaran itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila Mahkamah mengaward apa-apa ganti rugi di bawah perenggan (3)(b), Mahkamah boleh juga membuat suatu perintah di bawah perenggan (3)(c) bagi suatu akaun keuntungan yang boleh dikaitkan dengan pelanggaran itu yang tidak diambil kira dalam pengiraan ganti rugi itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56",
      "schema:text": {
        "@language": "ms",
        "@value": "Kecuali sebagaimana yang diperuntukkan dalam subseksyen (5), relief yang disebut dalam perenggan (3)(b), (c) dan (d) adalah saling eksklusif."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_7__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_7__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam apa-apa tindakan ke atas pelanggaran suatu cap dagangan berdaftar jika pelanggaran melibatkan penggunaan cap dagangan lancung berhubung dengan barang-barang atau perkhidmatan, plaintif adalah berhak, atas pilihannya, kepada—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_7",
      "schema:text": {
        "@language": "ms",
        "@value": "ganti rugi dan akaun keuntungan yang boleh dikaitkan dengan pelanggaran itu yang tidak diambil kira dalam pengiraan ganti rugi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_7",
      "schema:text": {
        "@language": "ms",
        "@value": "akaun keuntungan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_7__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_7",
      "schema:text": {
        "@language": "ms",
        "@value": "ganti rugi tambahan yang dipertimbangkan sesuai dalam keadaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_8__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_8__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_8__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_8__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56",
      "schema:text": {
        "@language": "ms",
        "@value": "Menurut perenggan (7) (c), Mahkamah hendaklah mengambil kira—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_8",
      "schema:text": {
        "@language": "ms",
        "@value": "pelanggaran cap dagangan berdaftar itu secara terang-terangan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_8",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa manfaat yang ditunjukkan telah terakru kepada defendan oleh sebab pelanggaran itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_8__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_8",
      "schema:text": {
        "@language": "ms",
        "@value": "keperluan untuk menghukum defendan bagi tindakan pelanggaran itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_8__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_8",
      "schema:text": {
        "@language": "ms",
        "@value": "semua perkara lain yang berkaitan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_56",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun tuntutan bagi keutamaan yang dibuat di bawah seksyen 26, 27 atau 28, tiada apa-apa jua dalam seksyen ini memberikan hak kepada tuan punya berdaftar untuk mendapatkan apa-apa relief di bawah subseksyen (3) ke atas pelanggaran atau apa-apa yang berlaku sebelum tarikh permohonan perlindungan cap dagangan itu dibuat dan tidak didaftarkan di Malaysia. Hal keadaan yang tindakan tidak boleh dimulakan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_57",
      "@type": "akn:clause",
      "eli:number": "57",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Tindakan bagi pelanggaran tidak boleh dimulakan berkenaan dengan suatu perbuatan yang dilakukan selepas pendaftaran cap dagangan telah habis tempoh atau telah disifatkan dikeluarkan dan sebelum ia dibaharui atau dimasukkan semula di bawah seksyen 39. Perintah bagi pemadaman, dsb., tanda yang menyalahi"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_58",
      "@type": "akn:clause",
      "eli:number": "58",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_58__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_58__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_58__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_58__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_58__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_58__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_58",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada subseksyen (3), jika seseorang didapati melanggar suatu cap dagangan berdaftar, Mahkamah boleh membuat suatu perintah yang menghendakinya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_58__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_58__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menyebabkan tanda yang menyalahi itu dipadam, dihapuskan atau dihancurkan daripada apa-apa barang, bahan atau artikel yang melanggar yang dalam milikan, jagaan atau kawalannya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_58__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_58__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika adalah tidak semunasabahnya praktikal bagi tanda yang menyalahi itu dipadamkan, dihapuskan atau dihancurkan, memastikan pemusnahan barang-barang, bahan atau artikel yang dipersoal itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_58__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_58",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu perintah di bawah subseksyen (1) tidak dipatuhi atau ternyata kepada Mahkamah bahawa ada kemungkinan yang perintah itu tidak akan dipatuhi, Mahkamah boleh memerintahkan supaya barang-barang, bahan atau artikel yang melanggar itu diserahkan kepada mana-mana orang sebagaimana yang diarahkan oleh Mahkamah untuk memadamkan, menghapuskan atau menghancurkan tanda itu, atau selainnya memusnahkan tanda itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_58__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_58__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_58__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_58",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seseorang yang didapati telah melanggar suatu cap dagangan berdaftar mempunyai dalam milikan, jagaan atau kawalannya apa-apa barang-barang lancung, Mahkamah hendaklah memerintahkan supaya barang-barang lancung itu diserahkan kepada orang itu sebagaimana yang diarahkan oleh Mahkamah bagi pemusnahan jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_58__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_58__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "plaintif memohon kepada Mahkamah untuk mendapatkan perintah itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_58__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_58__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Mahkamah berpendapat bahawa tidak ada keadaan luar biasa yang membenarkan penolakan terhadap perintah itu. Perintah bagi penyerahan barang-barang, bahan atau artikel yang melanggar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_59",
      "@type": "akn:clause",
      "eli:number": "59",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_59__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_59__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_59__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_59__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_59",
      "schema:text": {
        "@language": "ms",
        "@value": "Mahkamah boleh, sebagai tambahan kepada apa-apa relief yang diberikan di bawah seksyen 56 dan 58 dalam apa-apa tindakan ke atas pelanggaran suatu cap dagangan berdaftar, memerintahkan supaya apa-apa barang-barang, bahan atau artikel yang melanggar yang dalam milikan defendan atau di hadapan Mahkamah diserahkan kepada plaintif."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_59__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_59",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Mahkamah membuat suatu perintah di bawah subseksyen (1), Mahkamah juga hendaklah membuat suatu perintah di bawah seksyen 60 melainkan jika Mahkamah menentukan bahawa terdapat alasan untuk tidak membuat apa-apa perintah itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_59__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_59",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang kepadanya apa-apa barang-barang, bahan atau artikel yang melanggar diserahkan menurut suatu perintah di bawah subseksyen (1) hendaklah, jika suatu perintah di bawah seksyen 60 tidak dibuat pada masa pembuatan perintah di bawah subseksyen (1), memegang simpan barang-barang, bahan atau artikel itu sementara menunggu keputusan permohonan di bawah seksyen 60. Perintah bagi pelupusan barang-barang, bahan atau artikel yang melanggar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_60",
      "@type": "akn:clause",
      "eli:number": "60",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_60__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_60__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_60__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_60__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_60__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_60__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_60__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_60__subsec_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_60__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_60__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_60__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_60",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika barang-barang, bahan atau artikel yang melanggar telah diserahkan menurut suatu perintah di bawah seksyen 59, suatu permohonan boleh dibuat kepada Mahkamah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_60__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_60__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi suatu perintah bahawa barang-barang, bahan atau artikel itu dimusnahkan, atau dilucuthakkan kepada orang yang difikirkan patut oleh Mahkamah; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_60__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_60__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi suatu keputusan bahawa tiada apa-apa perintah di bawah perenggan (a) hendaklah dibuat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_60__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_60__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_60__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_60",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam menimbangkan perintah, jika ada, yang hendak dibuat, Mahkamah hendaklah mengambil kira—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_60__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_60__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "sama ada remedi lain yang ada untuk suatu tindakan pelanggaran cap dagangan berdaftar adalah mencukupi sebagai pampasan kepada plaintif dan melindungi kepentingannya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_60__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_60__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "keperluan untuk memastikan bahawa tiada barang-barang, bahan atau artikel yang melanggar dilupuskan dengan cara yang akan menjejaskan plaintif."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_60__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_60__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_60__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_60",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (2), jika barang-barang yang melanggar adalah barang lancung, Mahkamah hendaklah memerintahkan supaya barang-barang itu dimusnahkan jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_60__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_60__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "plaintif memohon kepada Mahkamah untuk mendapatkan perintah itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_60__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_60__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Mahkamah berpendapat bahawa tidak ada keadaan luar biasa yang membenarkan penolakan perintah itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_60__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_60",
      "schema:text": {
        "@language": "ms",
        "@value": "Mahkamah hendaklah mengeluarkan arahan mengenai penyampaian notis kepada orang yang mempunyai kepentingan dalam barang-barang, bahan atau artikel yang melanggar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_60__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_60__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_60__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_60",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang mempunyai kepentingan dalam barang-barang, bahan atau artikel yang melanggar adalah berhak—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_60__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_60__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk hadir dalam prosiding bagi suatu permohonan untuk mendapatkan suatu perintah di bawah seksyen ini, sama ada atau tidak notis disampaikan kepada orang itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_60__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_60__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk merayu terhadap apa-apa perintah yang dibuat, sama ada atau tidak orang itu hadir dalam prosiding itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_60__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_60",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu perintah yang dibuat di bawah seksyen ini tidak akan berkuat kuasa sehingga akhir tempoh yang suatu notis rayuan boleh diberikan atau, jika sebelum akhir tempoh itu notis rayuan diberikan dengan sewajarnya, sehingga keputusan muktamad ke atas atau pembehentian prosiding rayuan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_60__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_60",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada subseksyen (3), jika terdapat lebih daripada seorang yang berminat dengan barang-barang, bahan atau artikel yang melanggar itu, Mahkamah boleh mengarahkan supaya barang-barang, bahan atau artikel itu dijual, atau diluluskan selainnya, dan hasilnya dibahagikan, dan hendaklah dibuat apa-apa perintah lain yang difikirkannya patut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_60__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_60",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Mahkamah memutuskan bahawa tiada perintah dibuat di bawah seksyen ini, orang yang ada dalam milikan, jagaan atau kawalannya barang-barang, bahan atau artikel yang melanggar sebelum diserahkan, adalah berhak untuk mendapatkan kembali barang-barang, bahan atau artikel itu. Remedi bagi ancaman tidak berasas prosiding pelanggaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_61",
      "@type": "akn:clause",
      "eli:number": "61",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_61__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_61__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_61__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_61__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_61__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_61__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_61__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_61__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_61__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_61__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_61",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seseorang mengancam orang lain dengan prosiding pelanggaran cap dagangan berdaftar selain—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_61__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_61__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pemakaian cap dagangan pada barang-barang atau bahan yang digunakan atau diniatkan untuk digunakan bagi pelabelan atau pembungkusan barang-barang;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_61__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_61__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pengimportan barang-barang yang kepadanya, atau kepada pembungkusan yang kepadanya, cap dagangan telah dipakaikan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_61__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_61__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pembekalan perkhidmatan di bawah cap dagangan, mana-mana orang yang terkilan boleh membawa prosiding untuk relief di bawah seksyen ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_61__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_61__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_61__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_61__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_61",
      "schema:text": {
        "@language": "ms",
        "@value": "Relief yang boleh dipohon adalah bagi mana-mana yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_61__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_61__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "perisytiharan bahawa ancaman itu tidak boleh dibenarkan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_61__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_61__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "injunksi terhadap penerusan ancaman; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_61__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_61__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "ganti rugi berkenaan dengan apa-apa kerugian yang dia telah tanggung olehnya akibat ancaman itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_61__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_61",
      "schema:text": {
        "@language": "ms",
        "@value": "Plaintif adalah berhak kepada relief dalam subseksyen (2) melainkan jika defendan menunjukkan bahawa perbuatan yang berkenaan dengannya prosiding itu terancam merupakan atau jika dilakukan akan menjadi suatu pelanggaran terhadap cap dagangan berdaftar berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_61__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_61",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika defendan menunjukkan bahawa perbuatan yang berkenaan dengannya prosiding itu terancam merupakan atau jika dilakukan akan menjadi pelanggaran terhadap cap dagangan berdaftar berkenaan, plaintif bagaimanapun adalah berhak untuk mendapat relief jika dia menunjukkan bahawa pendaftaran cap dagangan itu tidak sah atau boleh dibatalkan dalam hal yang berkaitan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_61__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_61",
      "schema:text": {
        "@language": "ms",
        "@value": "Pemberitahuan semata-mata bahawa suatu cap dagangan telah didaftarkan, atau suatu permohonan bagi pendaftaran telah dibuat, tidak boleh menjadi ancaman prosiding bagi maksud seksyen ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_61__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VIII__chp_2__cl_61",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada apa-apa jua dalam seksyen ini boleh menyebabkan seseorang peguam bela dan peguam cara dikenakan suatu tindakan di bawah seksyen ini berkenaan dengan sesuatu perbuatan yang dilakukan olehnya dalam keupayaan profesionalnya bagi pihak pelanggan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_42",
      "@type": "akn:clause",
      "eli:number": "42",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_42__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_42__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_42__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_42__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_42",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada subseksyen (2), suatu cap dagangan berdaftar tidak boleh diubah dalam Daftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_42__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_42",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar boleh, atas permintaan tuan punya berdaftar mengikut bentuk yang ditentukan oleh Pendaftar bersama dengan pembayaran fi yang ditetapkan, membenarkan pengubahan cap dagangan berdaftar, dan jika cap dagangan itu termasuk nama atau alamat tuan punyanya, pengubahan itu terhad kepada pengubahan nama atau alamat itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_42__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_42",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengubahan suatu cap dagangan berdaftar tidak boleh menyentuh identiti cap dagangan itu secara substansial. Pembetulan Daftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_43",
      "@type": "akn:clause",
      "eli:number": "43",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_43__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_43__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_43__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_43__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_43__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_43__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_43__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_43__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar boleh, atas permintaan tuan punya berdaftar itu mengikut bentuk yang ditentukan oleh Pendaftar bersama dengan pembayaran fi yang ditetapkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_43__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_43__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "membetulkan suatu kesilapan atau mencatatkan apa-apa perubahan tentang nama, alamat atau perihal tuan punya berdaftar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_43__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_43__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "membetulkan butir-butir perihal barang-barang atau perkhidmatan yang berkenaan dengannya cap dagangan didaftarkan tanpa memperluas dalam apa-apa cara hak yang diberikan dengan pendaftaran cap dagangan sedia ada; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_43__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_43__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mencatatkan suatu penafian yang berhubungan dengan cap dagangan itu tanpa memperluas dalam apa-apa cara hak yang diberikan dengan pendaftaran cap dagangan sedia ada."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_43__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar boleh, atas permintaan oleh seorang pemegang lesen suatu cap dagangan mengikut bentuk yang ditentukan oleh Pendaftar bersama dengan pembayaran fi yang ditetapkan, membetulkan suatu kesilapan atau mencatatkan apa-apa perubahan tentang nama, alamat atau perihal pemegang lesen itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_43__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar boleh membuat apa-apa pembetulan dalam Daftar yang berbangkit daripada subseksyen (1) dan (2) dan boleh, atas budi bicaranya, membetulkan apa-apa kesilapan atau peninggalan dari segi perkeranian berkenaan dengan apa-apa pendaftaran cap dagangan dalam Daftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_43__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu pemberitahuan mengenai pendaftaran hendaklah dikeluarkan oleh Pendaftar mengenai kelulusan pembetulan sebagaimana yang diminta di bawah subseksyen (1) dan (2), dan pembuatan, jika ada, pembetulan di bawah subseksyen (3). Pemotongan sukarela cap dagangan berdaftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_44",
      "@type": "akn:clause",
      "eli:number": "44",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_44__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_44__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_44__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_44",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar hendaklah memotong pendaftaran cap dagangan berkenaan dengan beberapa atau semua barang-barang atau perkhidmatan atas permintaan tuan punya berdaftar mengikut bentuk yang ditentukan oleh Pendaftar bersama dengan pembayaran fi yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_44__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_44__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_44__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_44",
      "schema:text": {
        "@language": "ms",
        "@value": "Sebelum memotong pendaftaran cap dagangan itu, Pendaftar hendaklah memberitahu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_44__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_44__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang yang direkodkan di bawah Bahagian IX sebagai menuntut hak berkenaan dengan, atau kepentingan dalam, cap dagangan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_44__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_44__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "orang yang kepadanya cap dagangan itu telah diserah hak atau dipindahkan dalam hal yang penyerahhakan atau perpindahan cap dagangan itu belum direkodkan oleh Pendaftar selepas suatu permohonan dibuat kepada Pendaftar untuk merekodkan penyerahhakan atau perpindahan cap dagangan itu. Pembatalan pendaftaran oleh Pendaftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45",
      "@type": "akn:clause",
      "eli:number": "45",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_9"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar hendaklah membatalkan pendaftaran suatu cap dagangan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika suatu notis bangkangan terhadap pendaftaran telah difailkan, mengikut subseksyen 35(1), Pendaftar tidak mengambil kira bangkangan itu dalam membuat keputusan untuk mendaftarkan cap dagangan itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika sebelum pendaftaran, mana-mana orang telah memohon suatu perlanjutan tempoh bagi pemfailan suatu notis bangkangan terhadap pendaftaran, Pendaftar tidak mengambil kira permohonan bagi perlanjutan masa itu dalam membuat keputusan untuk mendaftarkan cap dagangan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45",
      "schema:text": {
        "@language": "ms",
        "@value": "Pembatalan di bawah subseksyen (1) hendaklah tertakluk kepada bila Pendaftar menyedari kegagalannya untuk mengambil kira bangkangan atau permohonan bagi perlanjutan masa untuk memfailkan notis bangkangan dalam masa dua bulan dari notis itu difailkan atau permohonan itu telah dibuat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar hendaklah membatalkan pendaftaran cap dagangan itu dalam masa satu bulan dari masa dia menyedari kegagalan untuk mengambil kira bangkangan atau permohonan bagi perlanjutan masa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subsekyen (1), (2) dan (3), Pendaftar boleh membatalkan pendaftaran cap dagangan, dalam tempoh dua belas bulan dari tarikh pendaftaran cap dagangan, jika Pendaftar berpuas hati bahawa adalah munasabah untuk membatalkan pendaftaran itu, dengan mengambil kira—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa obligasi Malaysia yang berkaitan di bawah perjanjian atau konvensyen antarabangsa; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_4__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_4__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa hal keadaan khas yang menjadikannya sesuai—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_4__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_4__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk tidak mendaftarkan cap dagangan itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_4__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_4__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mendaftarkan cap dagangan itu hanya jika pendaftaran itu tertakluk kepada penafian, syarat, pindaan, pengubahsuaian atau pengehadan yang baginya pendaftaran itu tidak tertakluk."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (2), jika Pendaftar menyedari kegagalan itu terkemudian, dia boleh membatalkan pendaftaran di bawah subseksyen (4)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_6__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45",
      "schema:text": {
        "@language": "ms",
        "@value": "Sebelum pembatalan cap dagangan, Pendaftar hendaklah memberikan suatu notis mengenai cadangan pembatalan mengikut cara sebagaimana yang ditentukan oleh Pendaftar kepada orang yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "tuan punya berdaftar cap dagangan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang yang direkodkan di bawah Bahagian IX sebagai menuntut suatu hak berkenaan dengan, atau suatu kepentingan dalam, cap dagangan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_7__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar tidak boleh membatalkan pendaftaran cap dagangan tanpa memberikan peluang untuk didengar kepada orang yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_7",
      "schema:text": {
        "@language": "ms",
        "@value": "tuan punya berdaftar cap dagangan itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_7",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang yang direkodkan di bawah Bahagian IX sebagai menuntut suatu hak berkenaan dengan, atau suatu kepentingan dalam, cap dagangan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_8__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_8__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Pendaftar membatalkan pendaftaran di bawah seksyen ini—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_8",
      "schema:text": {
        "@language": "ms",
        "@value": "pendaftaran itu hendaklah disifatkan tidak pernah berlaku; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_8",
      "schema:text": {
        "@language": "ms",
        "@value": "pendaftaran yang dibatalkan hendaklah tertakluk kepada pemeriksaan atau prosiding lanjut sebagaimana yang ditentukan oleh Pendaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_45",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar tidak mempunyai kewajipan untuk menimbangkan sama ada atau tidak untuk membatalkan apa-apa pendaftaran walau apa pun apa-apa permintaan kepada Pendaftar untuk berbuat demikian. Pembatalan pendaftaran oleh Mahkamah atas ketiadaan penggunaan cap dagangan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_46",
      "@type": "akn:clause",
      "eli:number": "46",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_46__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_46__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_46__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_46__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_46__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_46__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_46__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_46__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_46__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_46__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftaran cap dagangan boleh dibatalkan oleh Mahkamah atas suatu permohonan oleh seseorang yang terkilan atas apa-apa alasan yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_46__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_46__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dalam tempoh tiga tahun berikutan tarikh pengeluaran pemberitahuan pendaftaran, cap dagangan itu tidak digunakan dengan suci hati di Malaysia, oleh tuan punya berdaftar atau dengan persetujuannya, berhubung dengan barang-barang atau perkhidmatan yang baginya cap dagangan itu didaftarkan, dan tiada sebab yang wajar untuk tidak menggunakannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_46__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_46__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika penggunaan barang-barang atau perkhidmatan yang baginya cap dagangan itu didaftarkan telah digantung bagi tempoh tiga tahun berturut-turut, dan tiada sebab yang wajar untuk tidak menggunakannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_46__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_46__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika berbangkit daripada perbuatan tidak aktif tuan punya berdaftar, ia telah menjadi nama lazim dalam perdagangan bagi produk atau perkhidmatan yang baginya ia didaftarkan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_46__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_46__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika berbangkit daripada penggunaan cap dagangan itu oleh tuan punya berdaftar atau dengan persetujuannya berhubung dengan barang-barang atau perkhidmatan yang baginya cap dagangan itu didaftarkan, ia boleh mengelirukan orang awam, termasuk berkenaan dengan sifat, kualiti atau tempat asal geografi barang-barang atau perkhidmatan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_46__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_46__subsec_2__para_b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada subseksyen (3), pendaftaran cap dagangan tidak boleh dibatalkan atas alasan di bawah perenggan (1)(a) atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_46__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_46__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "jika penggunaan itu sebagaimana yang disebut dalam perenggan itu dimulakan atau disambung semula selepas habis tempoh tiga tahun dan sebelum permohonan pembatalan itu dibuat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_46__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa penggunaan yang disebut dalam perenggan (1)(a) atau (b) yang telah dimulakan atau disambung semula selepas habis tempoh tiga tahun tetapi dalam tempoh tiga bulan sebelum permohonan dibuat bagi pembatalan tidak boleh diambil kira melainkan jika persediaan bagi penggunaan itu bermula sebelum tuan punya menyedari bahawa permohonan bagi pembatalan boleh dibuat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_46__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika alasan bagi pembatalan wujud berkenaan dengan hanya beberapa barang-barang atau perkhidmatan yang baginya cap dagangan itu didaftarkan, pembatalan hendaklah berkaitan dengan barang-barang atau perkhidmatan itu sahaja."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_46__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_46__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_46__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika pendaftaran cap dagangan itu dibatalkan sehingga apa-apa takat, hak tuan punya berdaftar itu hendaklah disifatkan telah terhenti pada takat itu dari—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_46__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_46__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "tarikh permohonan bagi pembatalan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_46__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_46__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "jika Mahkamah berpuas hati bahawa alasan bagi pembatalan wujud pada tarikh yang lebih awal, tarikh itu. Ketidaksahan pendaftaran oleh Mahkamah"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_47",
      "@type": "akn:clause",
      "eli:number": "47",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_47__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_47__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_47__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_47__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_47__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_47__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_47__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_47__subsec_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_47__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftaran cap dagangan boleh diisytiharkan tidak sah oleh Mahkamah atas permohonan oleh seseorang yang terkilan atas alasan bahawa cap dagangan itu didaftarkan dengan melanggar seksyen 23."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_47__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (1), jika cap dagangan itu didaftarkan dengan melanggar perenggan 23(1)(b), (c) atau (d), cap dagangan itu tidak boleh diisytiharkan tidak sah jika, pendaftaran suatu cap dagangan itu telah memperoleh ciri distingtif selepas pendaftarannya akibat daripada penggunaannya berhubung dengan barang-barang atau perkhidmatan yang baginya ia didaftarkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_47__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_47__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_47__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftaran cap dagangan boleh diisytiharkan tidak sah oleh Mahkamah atas permohonan oleh orang yang terkilan atas alasan bahawa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_47__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_47__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "terdapat cap dagangan terdahulu di bawah subseksyen 24(1), (2) atau (3); atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_47__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_47__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "terdapat hak terdahulu di bawah subseksyen 24(4)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_47__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftaran cap dagangan tidak boleh diisytiharkan tidak sah di bawah subseksyen (3) jika tuan punya cap dagangan terdahulu atau hak terdahulu telah bersetuju dengan pendaftaran."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_47__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu cap dagangan telah didaftarkan atas alasan bahawa terdapat penggunaan bersama yang jujur bagi cap dagangan itu dan cap dagangan terdahulu atau hak terdahulu yang lain, sebagaimana yang diperuntukkan oleh seksyen 25, pendaftaran cap dagangan tidak boleh diisytiharkan tidak sah di bawah subseksyen (3) melainkan jika Pendaftar atau Mahkamah berpuas hati bahawa pada hakikatnya tiada penggunaan bersama yang jujur bagi cap dagangan itu dan cap dagangan terdahulu atau hak terdahulu yang lain."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_47__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftaran cap dagangan boleh diisytiharkan tidak sah oleh Mahkamah atas permohonan oleh seseorang yang terkilan atau Pendaftar atas alasan fraud dalam pendaftaran atau pendaftaran itu diperoleh dengan salah nyataan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_47__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika alasan ketidaksahan wujud berkenaan dengan hanya beberapa barang-barang atau perkhidmatan yang baginya cap dagangan itu didaftarkan, cap dagangan itu hendaklah diisytiharkan tidak sah berkenaan dengan barang-barang atau perkhidmatan itu sahaja."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_47__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VII__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika pendaftaran cap dagangan diisytiharkan tidak sah sehingga apa-apa takat, pendaftaran itu hendaklah disifatkan tidak pernah dibuat, tetapi ini tidak menyentuh transaksi yang lalu dan yang telah ditutup."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_39__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_39__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_39__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_39__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_39__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_39__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_39__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_39__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_39__subsec_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_39__subsec_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_39__subsec_11"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_39__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftaran cap dagangan hendaklah bagi tempoh sepuluh tahun dari tarikh pendaftaran dan boleh dibaharui di bawah subseksyen (2) bagi suatu tempoh lanjutan sepuluh tahun."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_39__subsec_10",
      "@type": "akn:subsection",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika kemasukan semula di bawah subseksyen (9) tidak dimohon dalam tempoh enam bulan dari tarikh cap dagangan itu disifatkan dikeluarkan, pendaftaran itu hendaklah terhenti."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_39__subsec_11",
      "@type": "akn:subsection",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "Pembaharuan atau kemasukan semula pendaftaran suatu cap dagangan hendaklah disiarkan dalam Jurnal Rasmi Harta Intelek. Status cap dagangan yang tidak dibaharui"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_39__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftaran cap dagangan boleh dibaharui, bagi beberapa atau semua kelas atau kelas barang-barang atau perkhidmatan, atas permintaan tuan punya berdaftar mengikut bentuk yang ditentukan oleh Pendaftar bersama dengan pembayaran fi yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_39__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika beberapa kelas barang-barang atau perkhidmatan pendaftaran perlu dibaharui, seksyen 37 boleh terpakai."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_39__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika permintaan bagi pembaharuan dibuat pada atau sebelum tarikh habis tempoh pendaftaran, fi yang kena dibayar ialah fi pembaharuan sebagaimana yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_39__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika permintaan bagi pembaharuan dibuat dalam tempoh enam bulan selepas tarikh habis tempoh pendaftaran, fi yang kena dibayar ialah fi pembaharuan sebagaimana yang ditetapkan dan suatu surcaj boleh dikenakan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_39__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "Permintaan bagi pembaharuan hendaklah dibuat tidak lewat dari enam bulan selepas tarikh habis tempoh pendaftaran."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_39__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "Pembaharuan hendaklah berkuat kuasa dari habis tempoh pendaftaran terdahulu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_39__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika pendaftaran tidak dibaharui mengikut seksyen ini dan peraturan-peraturan yang disebut dalam subseksyen (4) atau (5), cap dagangan itu hendaklah disifatkan dikeluarkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_39__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika cap dagangan itu telah disifatkan dikeluarkan, tuan punya berdaftar boleh memohon bagi kemasukan semula pendaftaran yang dikeluarkan itu dalam masa enam bulan dari tarikh dikeluarkan mengikut bentuk yang ditentukan oleh Pendaftar bersama dengan pembayaran fi kemasukan semula sebagaimana yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_40__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_40__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_40__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI",
      "schema:name": {
        "@language": "ms",
        "@value": "Dalam hal keadaan cap dagangan tidak dibaharui yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_40__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_40",
      "schema:text": {
        "@language": "ms",
        "@value": "pendaftaran cap dagangan itu tidak dibaharui; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_40__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_40",
      "schema:text": {
        "@language": "ms",
        "@value": "pendaftaran cap dagangan disifatkan dikeluarkan dan tidak dimasukkan semula, seseorang selain orang yang berdaftar sebagai tuan punya cap dagangan yang tidak dibaharui itu boleh memohon bagi pendaftaran cap dagangan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_40__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_40",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu permohonan bagi pendaftaran suatu cap dagangan yang tidak dibaharui dibuat oleh seseorang selain orang yang telah didaftarkan sebagai tuan punya cap dagangan yang tidak dibaharui itu, cap dagangan yang tidak dibaharui itu dikira sebagai cap dagangan berdaftar bagi maksud suatu pemeriksaan di bawah subseksyen 29(2) bagi permohonan itu pada bila-bila masa yang pendaftaran cap dagangan yang tidak dibaharui itu sepatutnya boleh dibaharui dan dimasukkan semula di bawah seksyen 39. Pemberhentian pendaftaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_41",
      "@type": "akn:clause",
      "eli:number": "41",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_41__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_41__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI",
      "schema:name": {
        "@language": "ms",
        "@value": "Pendaftaran cap dagangan terhenti jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_41__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "cap dagangan itu telah terhenti di bawah subseksyen 39(10), telah dibatalkan di bawah seksyen 45 atau 46 atau telah menjadi tidak sah di bawah seksyen 47; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_41__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_VI__cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "pendaftaran cap dagangan itu dipotong di bawah seksyen 44."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_V__cl_37",
      "@type": "akn:clause",
      "eli:number": "37",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_V__cl_37__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_V__cl_37__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_V__cl_37__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_V__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu permohonan bagi pendaftaran cap dagangan atau pendaftaran cap dagangan boleh, atas permintaan pemohon atau tuan punya berdaftar, dibahagikan kepada dua atau lebih permohonan berasingan bagi pendaftaran atau pendaftaran cap dagangan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_V__cl_37__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_V__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "Permintaan di bawah subseksyen (1) hendaklah dibuat kepada Pendaftar sebelum atau selepas cap dagangan itu didaftarkan, mengikut bentuk sebagaimana yang ditentukan oleh Pendaftar bersama mengikut pembayaran fi yang ditetapkan. Permohonan bagi penggabungan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_V__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_V__cl_38__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_V__cl_38__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_V__cl_38__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_V__cl_38",
      "schema:text": {
        "@language": "ms",
        "@value": "Dua atau lebih permohonan berasingan bagi pendaftaran cap dagangan atau pendaftaran cap dagangan boleh, atas permintaan pemohon atau tuan punya berdaftar, digabungkan menjadi satu permohonan bagi pendaftaran cap dagangan atau satu pendaftaran cap dagangan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_V__cl_38__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/10/msa@/~part_V__cl_38",
      "schema:text": {
        "@language": "ms",
        "@value": "Permintaan di bawah subseksyen (1) hendaklah dibuat kepada Pendaftar sebelum atau selepas cap dagangan didaftarkan, mengikut bentuk yang ditentukan oleh Pendaftar bersama dengan pembayaran fi yang ditetapkan."
      }
    },
