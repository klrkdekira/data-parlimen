      ],
      "schema:name": {
        "@language": "ms",
        "@value": "RUU Pertubuhan Belia dan Pembangunan Belia (Pindaan) 2019"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/12/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/12/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/12/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/12/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/12/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/12/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Pertubuhan Belia dan Pembangunan Belia (Pindaan) 2019."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/12/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/12/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta dan Menteri boleh menetapkan tarikh yang berlainan bagi permulaan kuat kuasa peruntukan yang berlainan Akta ini. Pindaan seksyen 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/12/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/12/msa@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/12/msa@/~cl_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/12/msa@/~cl_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/12/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Pertubuhan Belia dan Pembangunan Belia 2007 [Akta 668], yang disebut “Akta ibu” dalam Akta ini, dipinda dalam seksyen 2—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/12/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/12/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam takrif “belia”, dengan menggantikan perkataan “empat puluh” dengan perkataan “tiga puluh”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/12/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/12/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam takrif “pemegang jawatan”, dengan menggantikan perkataan “ertinya mana-mana orang yang menjadi” dengan perkataan “ertinya mana-mana orang yang, pada tarikh pelantikannya, ialah seseorang yang berumur tidak kurang daripada lapan belas tahun dan tidak lebih daripada tiga puluh tahun, dan menjadi”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/12/msa@/~cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/12/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam takrif “pertubuhan belia”, dengan menggantikan perkataan “empat puluh” di mana-mana jua terdapat dengan perkataan “tiga puluh”. Pindaan seksyen 12"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/12/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/12/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 12 Akta ibu dipinda dengan menggantikan perkataan “di peringkat kebangsaan hendaklah memegang jawatan untuk suatu tempoh tidak melebihi enam tahun secara berterusan” dengan perkataan “, pada tarikh pelantikannya hendaklah berumur tidak kurang daripada lapan belas tahun dan tidak lebih daripada tiga puluh tahun, dan hendaklah memegang jawatan untuk suatu tempoh tidak melebihi empat tahun secara berterusan”. Pindaan seksyen 15"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/12/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/12/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 15 Akta ibu dipinda dengan menggantikan perkataan “empat puluh” dengan perkataan “tiga puluh”. Pindaan seksyen 20"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/12/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/12/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 20(6) Akta ibu dipinda dengan memotong perkataan “dan pembatalan itu hendaklah disiarkan dalam Warta”. Kecualian"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/12/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/12/msa@/~cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/12/msa@/~cl_6__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/12/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/12/msa@/~cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/12/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana anggota yang dilantik atau dipilih sebagai pemegang jawatan dalam suatu pertubuhan belia yang telah mencapai umur tiga puluh tahun atau telah melebihi umur tiga puluh tahun sebelum tarikh permulaan kuat kuasa Akta ini hendaklah, pada atau selepas tarikh permulaan kuat kuasa Akta ini, dibenarkan untuk memegang jawatan sehingga tamat penggalnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/12/msa@/~cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/12/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana prosedur yang berhubungan dengan pembatalan pendaftaran mana-mana pertubuhan belia berdaftar yang masih belum selesai atau dimulakan sebelum tarikh permulaan kuat kuasa Akta ini hendaklah, selepas tarikh permulaan kuat kuasa Akta ini, diteruskan dan diselesaikan seolah-olah Akta ibu tidak dipinda oleh Akta ini."
      }
    }
  ]
}
