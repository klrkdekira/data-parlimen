      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/15/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/15/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/15/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Consumer Protection (Amendment) Act 2019."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/15/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/15/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Amendment of section 98"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/15/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/15/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Consumer Protection Act 1999 [Act 599], which is referred to as the “principal Act” in this Act, is amended in subsection 98(1) by substituting for the words “twenty-five thousand ringgit” the words “fifty thousand ringgit”. Amendment of section 100"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/15/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/15/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 100(1) of the principal Act is amended by substituting for the words “twenty-five thousand ringgit” the words “fifty thousand ringgit”. Amendment of section 101"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/15/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/15/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 101(1) of the principal Act is amended by substituting for the words “twenty-five thousand ringgit” the words “fifty thousand ringgit”. Amendment of section 117"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/15/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/15/eng@/~cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/15/eng@/~cl_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/15/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 117 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/15/eng@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/15/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (1), by substituting for the words “five thousand ringgit” the words “ten thousand ringgit”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/15/eng@/~cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/15/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (2), by substituting for the words “be liable to a fine not exceeding one thousand ringgit” the words “be liable to a fine of not less than one hundred ringgit and not exceeding five thousand ringgit”."
      }
    }
  ]
