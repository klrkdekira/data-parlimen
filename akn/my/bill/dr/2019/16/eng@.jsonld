      "schema:text": {
        "@language": "en",
        "@value": "Subsection 3(1) of the principal Act is amended by inserting after the words “Malaysian fisheries water,” the words “and the monitoring, control and surveillance of local fishing vessels on the high seas,”. Amendment of section 8"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/16/eng@/~cl_6",
