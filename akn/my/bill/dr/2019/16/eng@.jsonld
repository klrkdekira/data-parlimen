      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/16/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Fisheries Act 1985 [Act 317], which is referred to as the “principal Act” in this Act, is amended in the long title—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/16/eng@/~cl_2__para_a",
