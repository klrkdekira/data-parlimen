      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/16/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the words “Malaysian fisheries waters,” the words “and the monitoring, control and surveillance of local fishing vessels on the high seas;”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/16/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/16/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the word “Malaysia” a semicolon. Amendment of preamble"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/16/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/16/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended in the preamble by inserting after the words “Malaysian fisheries waters” the words “and the monitoring, control and surveillance of local fishing vessels on the high seas;”. Amendment of section 1"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/16/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/16/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 1(1) of the principal Act is amended by inserting after the words “Malaysian fisheries waters” the words “, and on the high seas in respect of any local fishing vessel”. Amendment of section 3"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/16/eng@/~cl_5",
      "@type": "akn:clause",
