      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/16/msa@/~cl_9__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/16/msa@/~cl_9__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “sejuta ringgit” dengan perkataan “enam juta ringgit”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/16/msa@/~cl_9__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/16/msa@/~cl_9__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “seratus ribu ringgit” dengan perkataan “enam ratus ribu ringgit”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/16/msa@/~cl_9__para_b",
      "@type": "akn:paragraph",
