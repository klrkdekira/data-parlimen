    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraph 340(1)(c) of the principal Act is amended by substituting for the words “the fee of directors” the words “the remuneration of auditors”. Amendment of section 386"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_11__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_11__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_11__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_11__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Subsection 386(1) of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_11__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words “commencement of winding up of a company” the words “appointment of a receiver or receiver and manager under section 385”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_11__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting the word “and” at the end of paragraph (a); and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_11__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for paragraph (b) the following paragraph: “(b) a receiver and manager may continue to act as a receiver as referred to in paragraph (a); and”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_11__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after paragraph (b) the following paragraph: “(c) a receiver and manager may continue to exercise all the powers of a receiver and manager for the purpose of carrying on the business of the company provided that the receiver and manager obtains consent from the liquidator or if the liquidator withholds his consent, the consent of the Court.”. Amendment of section 409"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraph 409(a) of the principal Act is amended by substituting for the word “and” at the end of the paragraph the word “or”. Amendment of section 433"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_13__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_13__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 433 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_13__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_13__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_13__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (2)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_13__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_13__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words “and (c)” the words “, (c), (d) and (e)”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_13__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_13__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (b), by substituting for the words “and (c)” the words “, (c), (d) and (e)”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_13__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (4) the following subsections: “(4a) Any approval granted by the Minister under subsection (4) may be made subject to such limitations or conditions as he thinks fit and may be revoked at any time by the Minister by the service of a notice of revocation on the approved person. (4b) Every approval under this section including the renewal of approval of a liquidator shall be in force for a period of two years after the date of issue unless sooner revoked by the Minister charged with the responsibility for finance. (4c) The Minister charged with the responsibility for finance may delegate all or any of his powers under this section to any person or body of persons.”. New section 580a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting after section 580 the following section: “Security for costs 580a. (1) Where a company is the plaintiff in any action or other proceedings and if it appears by a credible testimony that there is reason to believe that the company will be unable to pay the costs of the defendant if the defendant is successful in his defence, the Court may order the plaintiff to give sufficient security for all the costs and to stay all action or proceedings until the security is given. (2) The Court may direct the costs of any action or proceedings to be borne by the party to the action or proceedings.”. Saving"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_15__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_15__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_15__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_15__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_15__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "Any pending application for—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_15__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_15__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "an order to authorize any subsidiary of the holding company to have a financial year that does not coincide with its holding company; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_15__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_15__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "an approval or permission to be appointed as a liquidator, made before the date of coming into operation of this Act and pending before the Registrar or the Minister charged with the responsibility for finance, as the case maybe, shall continue to be valid and shall be dealt with under the principal Act as if the principal Act had not been amended by this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "Any order, approval or permission made or given under the principal Act immediately before the date of coming into operation of this Act shall continue to remain in full force and effect in relation to the persons to whom the order, approval or permission applied until amended, repealed, rescinded, revoked or replaced under the provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Companies (Amendment) Act 2019."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Amendment of section 4"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Companies Act 2016 [Act 777], which is referred to as the “principal Act” in this Act, is amended in subparagraph 4(1)(a)(iii) by substituting for the words “issued share capital” the words “total number of issued shares”. Amendment of section 66"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 66 of the principal Act is amended by inserting after subsection (5) the following subsection: “(6) For the purposes of this section, “document” means a document which is required to be executed by any written law, resolution, agreement or constitution in accordance with subsection (1).”. Amendment of section 72"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 72 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (4), by substituting for the words “The shares shall” the words “Subject to subsections (5) and (6), the shares shall”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (5) the following subsection: “(5) Where any such shares are redeemed out of profits pursuant to paragraph 4(a) which would otherwise have been available for dividend, there shall be transferred into the share capital accounts of the company, a sum equal to the amount of the shares redeemed.”. Amendment of section 84"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 84(1) of the principal Act is amended by deleting the word “special”. Amendment of section 93"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraph 93(2)(b) of the principal Act is amended by inserting after the words “on behalf of the shareholders” the words “representing at least ten per centum of the total voting rights in the class”. Amendment of section 247"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 247(3) of the principal Act is amended by inserting after the words “in writing to the Registrar” the words “not less than thirty days before the circulation of the financial statement of the holding company”. Amendment of section 253"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_8__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_8__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Subsection 253(2) of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting the words “or (2)”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "in the English language text, by substituting for the word “were” the word “is”. Amendment of section 304"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
