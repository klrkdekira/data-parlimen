        "@value": "Section 304 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/17/eng@/~cl_9__para_a",
      "@type": "akn:paragraph",
