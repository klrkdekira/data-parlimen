    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi boleh pada bila-bila masa mengarahkan Setiausaha untuk memanggil mesyuarat Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana tiga orang anggota Lembaga boleh pada bila-bila masa secara bertulis meminta Setiausaha untuk memanggil mesyuarat Lembaga, dengan syarat bahawa tiga anggota memberi tahu setiausaha usul mereka untuk mengadakan mesyuarat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_1__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi, atau jika ketiadaannya, Timbalan Pengerusi, hendaklah mempengerusikan mesyuarat Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_1__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Pengerusi dan Timbalan Pengerusi tidak hadir, anggota Lembaga yang hadir hendaklah melantik di kalangan mereka seorang anggota untuk mempengerusikan mesyuarat dan orang yang dilantik itu hendaklah mempunyai semua kuasa pengerusi bagi maksud dan bagi tempoh mesyuarat itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_1__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga hendaklah berjumpa sekurang-kurangnya empat kali setahun. Setiausaha hendaklah memanggil mesyuarat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_2",
      "@type": "akn:paragraph",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_2__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_2__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Setiausaha hendaklah memanggil suatu mesyuarat dalam tempoh empat belas hari dari penerimaan arahan daripada Pengerusi atau permintaan daripada anggota Lembaga di bawah subperenggan 1(1) atau 1(2), masing-masing."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Notis bertulis itu hendaklah disampaikan sekurang-kurangnya tujuh hari sebelum mesyuarat, tetapi jika Pengerusi boleh, jika dia menganggap bahawa terdapat keperluan mendesak untuk memanggil mesyuarat suatu notis yang lebih singkat, mengarahkan bahawa kehendak notis tujuh hari itu diketepikan. Kuorum"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_3",
      "@type": "akn:paragraph",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Lima orang anggota Lembaga hendaklah membentuk kuorum bagi apa-apa mesyuarat Lembaga. Undi pemutus"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_4",
      "@type": "akn:paragraph",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua perkara yang dikehendaki untuk ditentukan dalam mesyuarat Lembaga hendaklah diputuskan oleh undi majoriti anggota yang hadir dan sekiranya terdapat persamaan undi, Pengerusi atau pemangku Pengerusi hendaklah mempunyai undi pemutus sebagai tambahan kepada undi biasa. Kehadiran bukan anggota"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_5",
      "@type": "akn:paragraph",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_5__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi boleh mengundang mana-mana orang yang bukan anggota Lembaga ke mana-mana mesyuarat Lembaga, jika urusan sebelum mesyuarat menghendaki kehadiran orang itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang diundang di bawah subseksyen (1) berhak untuk menyertai dalam pertimbangtelitian itu, tetapi tidak berhak untuk mengundi. Minit mesyuarat Lembaga"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_6",
      "@type": "akn:paragraph",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_6__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_6__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Setiausaha hendaklah menyebabkan semua minit mesyuarat disenggara dan disimpan dalam bentuk yang sepatutnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Pada tiap-tiap mesyuarat minit mesyuarat terdahulu hendaklah dibaca dan disahkan, tertakluk kepada apa-apa pindaan yang perlu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua minit hendaklah disahkan dan ditandatangani oleh Pengerusi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_6__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Minit mesyuarat Lembaga hendaklah diterima sebagai keterangan fakta yang dinyatakan dalam minit tanpa apa-apa bukti selanjutnya jika minit itu ditandatangani sewajarnya. Persekutuan) Tatacara"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_7",
      "@type": "akn:paragraph",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga boleh mengawal selia tatacaranya sendiri. Penzahiran kepentingan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_8",
      "@type": "akn:paragraph",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_8__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap anggota Lembaga yang mempunyai, secara langsung atau tidak langsung, apa-apa kepentingan dalam perkara yang akan dipertimbangkan oleh Lembaga hendaklah menzahirkan kepada Lembaga fakta dan jenis kepentingan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Penzahiran di bawah subseksyen (1) hendaklah direkodkan dalam minit mesyuarat Lembaga, dan melainkan jika dibenarkan oleh Pengerusi, anggota yang mempunyai kepentingan dalam apa-apa perkara tidak boleh menyertai atau hadir dalam apa-apa pertimbangtelitian atau proses keputusan Lembaga yang berhubungan dengan perkara itu. Kesahan perbuatan dan prosiding"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_9",
      "@type": "akn:paragraph",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_9__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_9__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_9__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_9__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada tindakan atau prosiding yang diambil di bawah Akta ini boleh disoal atas alasan bahawa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_9__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_9",
      "schema:text": {
        "@language": "ms",
        "@value": "terdapat apa-apa kekosongan dalam keanggotaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_9__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_9",
      "schema:text": {
        "@language": "ms",
        "@value": "terdapat apa-apa kecacatan dalam penubuhan Lembaga;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_9__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_9",
      "schema:text": {
        "@language": "ms",
        "@value": "terdapat pelanggaran perenggan 8 oleh mana-mana anggota Lembaga; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_9__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_1__para_9",
      "schema:text": {
        "@language": "ms",
        "@value": "terdapat apa-apa peninggalan, kecacatan atau ketidakteraturan yang menjejaskan merit kes."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2",
      "@type": "akn:schedule",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_II"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "[Subseksyen 45(2), 48(3) dan 56(8)] PERUNTUKAN TAMBAHAN YANG BERHUBUNGAN DENGAN BADAN PEGUAM SYARIE DAN MAJLIS PEGUAM SYARIE"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I",
      "@type": "akn:part",
      "eli:number": "I",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I__para_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I__para_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I__para_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I__para_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I__para_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2",
      "schema:text": {
        "@language": "ms",
        "@value": "BADAN PEGUAM SYARIE Mesyuarat Agung Tahunan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_II",
      "@type": "akn:part",
      "eli:number": "II",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_II__para_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_II__para_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_II__para_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_II__para_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_II__para_10"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2",
      "schema:text": {
        "@language": "ms",
        "@value": "MAJLIS PEGUAM SYARIE Mesyuarat Majlis Peguam Syarie"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_II__para_10",
      "@type": "akn:paragraph",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada fi boleh dibayar kepada mana-mana anggota Majlis Peguam Syarie tetapi seseorang anggota boleh dibayar ganti daripada kumpulan wang Badan Peguam Syarie bagi perbelanjaan perjalanan yang ditanggung olehnya berhubung dengan hal ehwal Badan Peguam Syarie."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_II__para_6",
      "@type": "akn:paragraph",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Mesyuarat Majlis Peguam Syarie hendaklah diadakan sekurang-kurangnya tiga kali setiap tahun pada bila-bila masa dan tempat yang ditetapkan oleh Pengerusi atau Majlis Peguam Syarie. Kuorum"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_II__para_7",
      "@type": "akn:paragraph",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Lima anggota yang hadir sendiri dalam mana-mana mesyuarat Majlis Peguam Syarie membentuk suatu kuorum bagi menjalankan apa-apa urusan. Mengundi"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_II__para_8",
      "@type": "akn:paragraph",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_II__para_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_II__para_8__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_II__para_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_II__para_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu keputusan majoriti anggota Majlis Peguam Syarie yang hadir dan mengundi dalam mana-mana mesyuarat Majlis Peguam Syarie hendaklah disifatkan sebagai keputusan Majlis Peguam Syarie."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_II__para_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_II__para_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi hendaklah mempunyai undi pemutus dalam mana-mana mesyuarat Majlis Peguam Syarie sebagai tambahan kepada undi biasanya. Tatacara"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_II__para_9",
      "@type": "akn:paragraph",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis Peguam Syarie boleh mengawal selia tatacaranya sendiri. Perbelanjaan anggota"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I__para_1",
      "@type": "akn:paragraph",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I__para_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I__para_1__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I__para_1__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I__para_1__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I__para_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis Peguam Syarie hendaklah mengadakan suatu mesyuarat agung tahunan Badan Peguam Syarie sebelum hari pertama November setiap tahun."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I__para_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu notis mengenai mesyuarat agung tahunan Badan Peguam Syarie hendaklah disampaikan kepada semua anggota, dengan apa-apa cara yang ditentukan oleh Majlis Peguam Syarie, tidak kurang daripada empat belas hari sebelum tarikh mesyuarat itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I__para_1__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Kehendak di bawah subperenggan (2) tidak terpakai jika mesyuarat agung tahunan ditangguhkan di bawah subperenggan 2(2)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I__para_1__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana anggota berhasrat untuk mencadangkan apa-apa usul untuk dipertimbangkan dalam mesyuarat agung tahunan yang diadakan di bawah perenggan ini, anggota itu hendaklah, tidak kurang daripada tujuh hari sebelum tarikh yang mula-mula ditetapkan untuk mengadakan mesyuarat itu, menyampaikan notis usul itu kepada Setiausaha Badan Peguam Syarie secara bertulis. Kuorum mesyuarat agung tahunan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I__para_2",
      "@type": "akn:paragraph",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I__para_2__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I__para_2__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I__para_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Kuorum bagi suatu mesyuarat agung tahunan hendaklah empat kali bilangan anggota Majlis Peguam Syarie dan tiada urusan boleh dijalankan dalam mana-mana mesyuarat agung tahunan melainkan jika ada cukup kuorum apabila mesyuarat itu bertindak menjalankan urusannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I__para_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika kuorum yang disebut dalam subperenggan (1) tidak hadir dalam masa satu jam dari masa yang ditetapkan untuk mengadakan mesyuarat itu, mesyuarat itu hendaklah ditangguhkan ke hari yang berikutnya pada masa dan di tempat yang sama melainkan jika anggota diberitahu selainnya oleh Majlis Peguam Syarie dalam notis yang memanggil mesyuarat yang asal, dan jika pada mesyuarat agung tahunan yang ditangguhkan itu kuorum tidak hadir dalam masa satu jam dari masa yang ditetapkan untuk mengadakan mesyuarat yang ditangguhkan itu, anggota yang hadir hendaklah membentuk suatu kuorum. Mesyuarat Agung Luar Biasa"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I__para_3",
      "@type": "akn:paragraph",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I__para_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I__para_3__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I__para_3__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I__para_3__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I__para_3__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I__para_3__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I__para_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I__para_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis Peguam Syarie boleh mengadakan suatu mesyuarat agung Badan Peguam Syarie selain mesyuarat agung tahunan pada bila-bila masa yang difikirkannya perlu atau suai manfaat dan mesyuarat itu hendaklah dikenali sebagai mesyuarat agung luar biasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I__para_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I__para_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Tidak kurang daripada satu per lima anggota Badan Peguam Syarie boleh pada bila-bila masa meminta diadakan suatu mesyuarat agung luar biasa dengan notis bertulis ditandatangani oleh mereka dan disampaikan kepada Presiden, Naib Presiden atau Setiausaha Badan Peguam Syarie."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I__para_3__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I__para_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Notis bertulis itu hendaklah menyatakan perkara yang akan dibincangkan dalam mesyuarat agung luar biasa yang dicadangkan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I__para_3__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I__para_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis Peguam Syarie hendaklah, apabila menerima notis bertulis di bawah subperenggan (2), mengadakan suatu mesyuarat agung luar biasa dalam masa tiga puluh hari. Persekutuan)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I__para_3__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I__para_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Majlis Peguam Syarie tidak mengadakan mesyuarat agung luar biasa sebagaimana yang dikehendaki di bawah subperenggan (4), anggota yang meminta diadakan mesyuarat agung luar biasa itu boleh mengadakan mesyuarat agung luar biasa itu dalam masa enam puluh hari selepas penerimaan notis bertulis di bawah subperenggan (2)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I__para_3__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I__para_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana anggota Badan Peguam Syarie berhasrat untuk mencadangkan apa-apa usul untuk dipertimbangkan dalam mesyuarat agung luar biasa yang akan diadakan di bawah perenggan ini, anggota itu hendaklah menyampaikan kepada Setiausaha Badan Peguam notis usul secara bertulis Syarie dalam tempoh tidak kurang daripada tujuh hari sebelum tarikh mesyuarat itu. Kuorum mesyuarat agung luar biasa"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I__para_4",
      "@type": "akn:paragraph",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I__para_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I__para_4__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I__para_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I__para_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Kuorum bagi suatu mesyuarat agung luar biasa yang diadakan di bawah perenggan 3 hendaklah satu per tiga anggota Badan Peguam Syarie, dan tiada urusan boleh dijalankan dalam mana-mana mesyuarat agung luar biasa melainkan jika cukup kuorum apabila mesyuarat itu meneruskan urusannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I__para_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I__para_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu mesyuarat agung luar biasa yang diadakan di bawah perenggan ini hendaklah dibubarkan jika tidak ada cukup kuorum dalam masa satu jam dari masa yang ditetapkan untuk mengadakan mesyuarat itu. Pengundian"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I__para_5",
      "@type": "akn:paragraph",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_2__part_I",
      "schema:text": {
        "@language": "ms",
        "@value": "Pada tiap-tiap mesyuarat agung tahunan dan mesyuarat agung luar biasa Badan Peguam Syarie, tiap-tiap anggota yang hadir hendaklah mempunyai satu undi dan jika terdapat undi yang sama banyak, pengerusi atau pemangku pengerusi mesyuarat itu hendaklah mempunyai suatu undi pemutus sebagai tambahan kepada undi biasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3",
      "@type": "akn:schedule",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_11",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_12",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_13",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_14",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_15",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_16",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_17",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_18"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "[Subseksyen 64(1), 71(2), seksyen 72, 73, 74 dan 75] KAWALAN HARTA, DOKUMEN, WANG, DSB., ANAK GUAM DALAM HAL TERTENTU"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_1",
      "@type": "akn:paragraph",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis Peguam Syarie boleh menghendaki pengemukaan atau penyerahan segala surat ikatan, wasiat, dokumen yang menjadi atau menerangkan hak milik apa-apa harta, kertas, buku akaun, rekod, baucer dan dokumen lain yang ada dalam milikan atau kawalan Peguam Syarie itu atau firmanya, rakan kongsi atau pekerjanya atau yang berhubungan dengan apa-apa amanah yang dia menjadi pemegang amanah tunggal atau pemegang amanah bersama dengan seorang atau lebih rakan kongsi atau pekerjanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_10",
      "@type": "akn:paragraph",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Mahkamah Tinggi Syariah atau hakim dalam kamar boleh, atas permohonan Majlis Peguam Syarie, memerintahkan supaya tiada pembayaran boleh dibuat, tanpa kebenaran Mahkamah Tinggi Syariah atau hakim dalam kamar, oleh mana-mana jurubank atas nama Peguam Syarie atau firmanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_11",
      "@type": "akn:paragraph",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam apa-apa hal jika Majlis Peguam Syarie telah mengambil milikan dokumen di bawah perenggan 2, dan belum dikehendaki untuk mengembalikan dokumen itu di bawah perenggan 7, perenggan yang berikut hendaklah terpakai."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_12",
      "@type": "akn:paragraph",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis Peguam Syarie boleh, atas ketetapan, mengambil alih semua jumlah wang yang kena dibayar oleh Peguam Syarie atau oleh firmanya, atau yang dipegang olehnya atau firmanya bagi pihak anak guamnya, atau anak guam firmanya atau yang tertakluk kepada apa-apa amanah yang Peguam Syarie itu merupakan pemegang amanah tunggal atau pemegang amanah bersama dengan seorang atau lebih rakan kongsi atau pekerjanya dan bagi maksud itu Majlis Peguam Syarie hendaklah menyampaikan kepada Peguam Syarie atau firmanya, dan kepada mana-mana jurubank dan kepada mana-mana orang lain yang ada memiliki atau mengawal apa-apa jumlah wang itu suatu notis, berserta dengan suatu salinan ketetapan yang diperakui sah, melarang pembayaran daripada jumlah wang itu selain menurut perenggan 14 atau 15."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_13",
      "@type": "akn:paragraph",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Peguam Syarie itu atau firmanya, atau jurubank atau orang lain yang kepadanya notis itu telah disampaikan boleh, dalam masa empat belas hari dari penyampaian notis di bawah perenggan 12, memohon kepada hakim dalam kamar bagi suatu perintah yang mengarahkan Majlis Peguam Syarie untuk menarik balik notis itu dan apabila mendengar permohonan itu hakim dalam kamar itu boleh membuat apa-apa perintah yang difikirkannya patut dan munasabah berkenaan dengan perkara itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_14",
      "@type": "akn:paragraph",
      "eli:number": "14",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis Peguam Syarie itu atau mana-mana orang yang dilantik oleh Majlis Peguam Syarie boleh, tertakluk kepada penyampaian apa-apa notis di bawah perenggan 12, dan kepada apa-apa permohonan yang boleh dibuat di bawah perenggan 13, mengeluarkan wang atau apa-apa bahagian daripada wang, dalam mana-mana akaun bank atas nama Peguam Syarie itu atau firmanya yang kena dipegang bagi pihak anak guamnya, dan mendepositkan wang itu ke dalam suatu akaun khas atas nama Majlis Peguam Syarie atau orang yang dilantik oleh Majlis Peguam Syarie itu dan selainnya menguruskan, akaun khas yang mungkin telah dikendalikan oleh Peguam Syarie itu atau firmanya atau selainnya menguruskan, akaun bank itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_15",
      "@type": "akn:paragraph",
      "eli:number": "15",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana jurubank yang dengannya apa-apa akaun khas itu disimpan tidak berkewajipan untuk menentukan bahawa akaun itu sedang dikendalikan atau selainnya sedang diuruskan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_16",
      "@type": "akn:paragraph",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_16__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_16__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_16__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_16__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis Peguam boleh, tertakluk kepada perenggan 13 dan 15, menyampaikan suatu notis kepada Peguam Syarie atau firmanya, jurubank atau orang lain yang kepadanya suatu notis telah disampaikan di bawah perenggan 11, mengarahkan supaya, sebaik selepas tamat lapan hari dari penyampaian notis yang disebut dalam perenggan 5, apa-apa wang yang disebut dalam notis itu dipindah milik mengikut arahan Majlis Peguam Syarie."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_16__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_16__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subperenggan (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_16__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_16__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "tiada apa-apa arahan boleh diberikan oleh Majlis Peguam Syarie kecuali dengan kelulusan orang yang mempunyai wang itu, dalam hal suatu amanah pemegang amanah, dan, jika Peguam Syarie itu pemegang amanah tunggal atau pemegang amanah bersama dengan seorang atau lebih rakan kongsi atau pekerjanya, orang yang berhak secara benefisial ke atas wang itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_16__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_16__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "orang yang kepadanya notis yang disebut dalam perenggan 3 telah disampaikan tidak berkewajipan untuk menentukan sama ada kelulusan itu telah diperoleh. Persekutuan)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_16__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam apa-apa hal jika Majlis Peguam Syarie tidak dapat menentukan orang yang mempunyai wang itu atau jika Majlis Peguam Syarie selainnya fikir suai manfaat untuk berbuat sedemikian, Majlis Peguam Syarie boleh memohon kepada Mahkamah Tinggi Syariah atau hakim dalam kamar untuk mendapatkan arahan tentang pemindahmilikan wang itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_17",
      "@type": "akn:paragraph",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_17__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_17__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana orang tidak mematuhi kehendak mana-mana notis yang diberikan di bawah perenggan 12 atau 13—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_17__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_17",
      "schema:text": {
        "@language": "ms",
        "@value": "dia melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima ratus ringgit; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_17__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Mahkamah Tinggi Syariah atau hakim dalam kamar boleh, atas permohonan Majlis Peguam Syarie, memerintahkan orang itu untuk mematuhi kehendak notis itu dalam masa yang dinyatakan dalam perintah itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_18",
      "@type": "akn:paragraph",
      "eli:number": "18",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada apa-apa perintah bagi pembayaran kos yang mungkin dibuat atas suatu permohonan di bawah Jadual ini, apa-apa kos yang ditanggung oleh Majlis Peguam Syarie bagi maksud Jadual ini hendaklah dibayar oleh Peguam Syarie itu dan boleh didapatkan daripadanya sebagai hutang yang kena dibayar kepada Majlis Peguam Syarie."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_2",
      "@type": "akn:paragraph",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengemukaan atau penyerahan dokumen yang disebut dalam perenggan 1 hendaklah dibuat kepada mana-mana orang yang dilantik oleh Majlis Peguam Syarie pada masa dan di tempat yang ditentukan oleh Majlis Peguam Syarie dan orang yang dilantik boleh mengambil milikan dokumen itu bagi pihak Majlis Peguam Syarie."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_3",
      "@type": "akn:paragraph",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana Peguam Syarie, rakan kongsi atau pekerjanya yang tidak mematuhi mana-mana kehendak di bawah perenggan 1 dan 2, melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima ratus ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_4",
      "@type": "akn:paragraph",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis Peguam Syarie boleh memohon kepada Mahkamah Tinggi Syariah atau hakim dalam kamar untuk membenarkan mana-mana orang yang dilantik oleh Majlis Peguam Syarie untuk memasuki mana-mana premis dengan menggunakan apa-apa kekerasan yang semunasabahnya perlu bagi maksud itu untuk mencari, dan mengambil milik, dokumen yang tersebut dalam perenggan 1. Persekutuan)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_5",
      "@type": "akn:paragraph",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis Peguam Syarie hendaklah, setelah mengambil milik dokumen itu, menyampaikan kepada Peguam Syarie, rakan kongsi atau pekerjanya atau mana-mana orang yang daripadanya dokumen itu diterima, atau yang daripada premisnya dokumen itu telah diambil menurut perintah yang dibuat di bawah perenggan 4, suatu notis memberikan butir-butir dan tarikh mengambil milikan dokumen itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_6",
      "@type": "akn:paragraph",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa kehendak atau notis di bawah Jadual ini hendaklah dibuat secara bertulis dengan ditandatangani oleh orang yang dilantik oleh Majlis Peguam Syarie bagi maksud itu dan boleh disampaikan kepada mana-mana orang sama ada kepadanya sendiri atau dengan menghantarnya melalui surat berdaftar yang dialamatkan ke tempat perniagaan atau kediamannya yang terakhir diketahui."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_7",
      "@type": "akn:paragraph",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Peguam Syarie atau orang lain yang kepadanya notis itu telah disampaikan boleh, dalam masa empat belas hari selepas penyampaian notis di bawah perenggan 5, memohon kepada hakim dalam kamar untuk mendapatkan suatu perintah mengarahkan Majlis Peguam Syarie untuk mengembalikan dokumen itu kepada orang yang daripadanya dokumen itu telah diterima, atau yang daripada premisnya dokumen itu telah diambil, mengikut mana-mana yang berkenaan, oleh Majlis Peguam Syarie atau kepada mana-mana orang lain sebagaimana yang dikehendaki oleh pemohon itu, dan apabila mendengar mana-mana permohonan itu hakim dalam kamar itu boleh membuat apa-apa perintah yang difikirkannya patut dan munasabah berkenaan dengan pekara itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_8",
      "@type": "akn:paragraph",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika tiada permohonan dibuat di bawah perenggan 7 atau jika hakim dalam kamar yang kepadanya permohonan itu dibuat mengarahkan supaya dokumen itu terus berada dalam jagaan atau kawalan Majlis Peguam Syarie, hakim dalam kamar boleh membuat siasatan untuk menentukan kepada siapakah dokumen itu dipunyai dan boleh menguruskan dokumen itu mengikut arahan orang itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3__para_9",
      "@type": "akn:paragraph",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~sched_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis Peguam Syarie boleh, sebelum menguruskan dokumen itu, membuat salinan, atau cabutan daripada, mana-mana dokumen itu."
      }
    }
  ]
}
