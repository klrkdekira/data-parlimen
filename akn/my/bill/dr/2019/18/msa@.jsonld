      "schema:text": {
        "@language": "ms",
        "@value": "[Subseksyen 6(5)] PERUNTUKAN TAMBAHAN YANG BERHUBUNGAN DENGAN LEMBAGA KELAYAKAN PROFESION GUAMAN SYARIE Mesyuarat Lembaga"
      }
    },
    {
