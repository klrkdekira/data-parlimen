        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_71",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_72",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_73",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_74",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_75",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_76"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "AMALAN, ETIKA, KELAKUAN DAN TATATERTIB PROFESIONAL PEGUAM SYARIE Kuasa untuk membuat kaedah-kaedah mengawal selia amalan, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_64",
      "@type": "akn:clause",
      "eli:number": "64",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_64__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_64__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_64__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_64",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan apa-apa kuasa lain untuk membuat kaedah-kaedah yang diperuntukkan di bawah Akta ini, Majlis Peguam Syarie boleh, dengan kelulusan Menteri, membuat kaedah-kaedah bagi mengawal selia amalan, etika, kelakuan dan Persekutuan) tatatertib profesional Peguam Syarie, kawalan harta kepunyaan anak guam Peguam Syarie itu dan apa-apa perkara yang bersampingan atau tambahan kepada Bahagian ini dan Jadual Ketiga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_64__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_64",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana Peguam Syarie yang tidak mematuhi mana- mana kaedah-kaedah yang dibuat di bawah seksyen ini hendaklah tertakluk kepada prosiding tatatertib. Kuasa untuk membuat kaedah-kaedah berhubung dengan pembukaan dan penyimpanan akaun, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_65",
      "@type": "akn:clause",
      "eli:number": "65",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_65__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_65__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_65__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_65__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_65__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_65__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_65__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_65__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_65__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_65__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_65__subsec_1__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_65",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis Peguam Syarie boleh, dengan kelulusan Menteri, membuat kaedah-kaedah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_65__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_65__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengadakan peruntukan bagi pembukaan dan penyimpanan akaun oleh seseorang Peguam Syarie di mana-mana institusi kewangan Islam bagi wang anak guam;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_65__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_65__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengadakan peruntukan bagi penyimpanan oleh seseorang Peguam Syarie akaun yang mengandungi butir-butir dan maklumat mengenai wang yang diterima, dipegang atau dibayar oleh seseorang Peguam Syarie untuk atau bagi pihak anak guamnya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_65__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_65__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengadakan peruntukan bagi pembukaan dan penyimpanan oleh seseorang Peguam Syarie yang merupakan pemegang amanah tunggal atau yang menjadi pemegang amanah bersama dengan satu atau lebih rakan kongsi atau pekerjanya, suatu akaun di mana-mana institusi kewangan Islam bagi apa-apa wang yang diamanahkan kepadanya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_65__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_65__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengadakan peruntukan bagi penyimpanan oleh seseorang Peguam Syarie suatu akaun yang mengandungi butir-butir dan maklumat mengenai wang yang diterima, dipegang atau dibayar olehnya untuk atau bagi akaun apa-apa amanah itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_65__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_65__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengadakan peruntukan bagi penyimpanan wang yang diterima untuk atau bagi pihak anak guam dalam suatu akaun bank berasingan untuk faedah anak guam; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_65__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_65__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memberi Majlis Peguam Syarie kuasa untuk mengambil tindakan yang perlu untuk membolehkannya untuk menentukan sama ada kaedah-kaedah itu dipatuhi atau sebaliknya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_65__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_65__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_65__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_65",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada apa-apa jua dalam subseksyen ini, atau dalam mana-mana kaedah yang dibuat di bawah seksyen ini, hendaklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_65__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_65__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menyentuh apa-apa perkiraan secara bertulis, bila-bila jua dibuat, antara seseorang Peguam Syarie dengan anak guamnya mengenai penggunaan wang anak guam itu atau kepentingannya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_65__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_65__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "terpakai bagi wang yang diterima oleh seseorang Peguam Syarie yang wang itu tertakluk kepada suatu amanah yang dia menjadi pemegang amanah tunggal atau pemegang amanah bersama dengan seorang atau lebih rakan kongsi atau pekerjanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_65__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_65",
      "schema:text": {
        "@language": "ms",
        "@value": "Prosiding tatatertib boleh diambil terhadap mana-mana Peguam Syarie yang tidak mematuhi mana-mana kaedah-kaedah yang dibuat di bawah seksyen ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_65__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_65",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam seksyen ini, perkataan “amanah” dan “pemegang amanah” meliputi amanah yang tersirat dan amanah konstruktif dan keadaan yang pemegang amanah mempunyai kepentingan benefisial atas harta amanah itu dan kepada kewajipan yang bersampingan dengan jawatan seseorang wakil diri, dan “pemegang amanah”, jika konteksnya membenarkan, termasuklah seorang wakil diri. Kuasa untuk membuat kaedah-kaedah berhubung dengan tanggung rugi profesional"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_66",
      "@type": "akn:clause",
      "eli:number": "66",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_66__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_66__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_66__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_66__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_66__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_66__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_66__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_66",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis Peguam Syarie boleh, dengan kelulusan Menteri, membuat kaedah-kaedah mengenai pengambilan tanggung rugi profesional bagi tiap-tiap Peguam Syarie terhadap apa-apa kelas liabiliti profesional dan kaedah-kaedah itu boleh, bagi maksud mengadakan tanggung rugi itu, melakukan semua atau mana-mana yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_66__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_66__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "memberi kuasa kepada Majlis Peguam Syarie untuk mengambil dan mengekalkan takaful atas nama Badan Peguam Syarie dengan mana-mana orang yang dibenarkan Persekutuan) oleh undang-undang untuk menjalankan perniagaan takaful liabiliti profesional atau perniagaan takaful kerugian kewangan dan meliputi semua Peguam Syarie yang menjalankan amalan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_66__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_66__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "memberi kuasa kepada Majlis Peguam Syarie untuk menubuhkan dan menyenggara suatu kumpulan wang bagi maksud tanggung rugi profesional; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_66__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_66__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menghendaki semua Peguam Syarie untuk mengambil dan mengekalkan takaful."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_66__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_66__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_66__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_66__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_66__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_66__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_66__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_66__subsec_2__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_66__subsec_2__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_66__subsec_2__para_i"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_66",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan keluasan subseksyen (1), kaedah-kaedah yang dibuat di bawah seksyen ini boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_66__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_66__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menyatakan terma dan syarat yang atasnya tanggung rugi profesional akan tersedia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_66__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_66__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mengadakan peruntukan bagi pengurusan, pentadbiran dan pelindungan apa-apa kumpulan wang yang ditubuhkan di bawah subseksyen (1) dan menghendaki semua Peguam Syarie untuk membuat pembayaran kepada kumpulan wang tersebut;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_66__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_66__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menghendaki semua Peguam Syarie untuk membuat pembayaran dengan cara premium apa-apa takaful yang diambil di bawah subseksyen (1) dan mengadakan peruntukan bagi prosiding oleh Majlis Peguam Syarie atau penanggung takafulnya terhadap mana-mana Peguam Syarie yang gagal melakukan sedemikian untuk mendapatkan semula bayaran premium yang berkenaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_66__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_66__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menetapkan syarat yang perlu dipenuhi oleh sesuatu takaful bagi maksud perenggan (1)(c);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_66__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_66__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "memberi kuasa kepada Majlis Peguam Syarie untuk menentukan amaun apa-apa pembayaran yang dikehendaki oleh kaedah-kaedah;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_66__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_66__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menyatakan hal keadaan yang baginya jika seseorang Peguam Syarie tidak mematuhi kaedah-kaedah, prosiding berkenaan dengan apa-apa jumlah wang yang dibayar melalui tanggung rugi boleh diambil terhadapnya oleh Badan Peguam Syarie atau penanggung takafulnya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_66__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_66__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menetapkan bahawa seseorang Peguam Syarie tidak layak untuk memperoleh Pengesahan Sokongan melainkan jika dia dilindungi sebagaimana yang dikehendaki oleh kaedah-kaedah bagi tempoh yang berkaitan dengan Pengesahan Sokongan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_66__subsec_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_66__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "memberi Majlis Peguam Syarie kuasa untuk mengambil apa-apa langkah yang difikirkan perlu atau suai manfaat untuk menentukan dan memastikan kaedah-kaedah dipatuhi; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_66__subsec_2__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_66__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mengandungi apa-apa tatacara, yang bersampingan atau peruntukan lain yang perlu atau suai manfaat bagi maksud kaedah-kaedah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_66__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_66",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada apa-apa jua dalam seksyen ini boleh menyentuh hak mana-mana Peguam Syarie, sebagai tambahan kepada tanggung rugi yang diperuntukkan dalam kaedah-kaedah yang dibuat di bawah seksyen ini, untuk melindungi dirinya selanjutnya terhadap apa-apa kerugian yang berbangkit daripada apa-apa tuntutan yang mungkin dimulakan terhadapnya. Peguam Syarie hendaklah mengemukakan laporan akauntan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_67",
      "@type": "akn:clause",
      "eli:number": "67",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_67__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_67__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_67__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_67__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_67__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_67",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua Peguam Syarie hendaklah mengemukakan kepada Ketua Pendaftar dalam apa-apa permohonan bagi Perakuan Amalan Tahunan, suatu laporan yang ditandatangani oleh seorang akauntan, disebut sebagai “laporan akauntan” dalam seksyen ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_67__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_67__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_67__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_67__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_67__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_67__subsec_2__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_67",
      "schema:text": {
        "@language": "ms",
        "@value": "Laporan akauntan yang disebut dalam subseksyen (1) hendaklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_67__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_67__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menyatakan bahawa akauntan itu pada mematuhi seksyen ini dan apa-apa kaedah-kaedah yang dibuat di bawah seksyen ini telah memeriksa buku, akaun dan dokumen firma Peguam Syarie itu bagi apa-apa tempoh perakaunan yang dinyatakan dalam laporan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_67__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_67__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menyatakan sama ada akauntan itu berpuas hati, daripada pemeriksaan ke atas buku, akaun dan dokumen yang dikemukakan kepadanya dan daripada maklumat dan penjelasan yang diberi kepadanya, bahawa semasa tempoh perakaunan tersebut Peguam Syarie itu atau firmanya telah mematuhi apa-apa kaedah yang dibuat di bawah seksyen 65; Persekutuan)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_67__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_67__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menyatakan, jika akauntan itu tidak berpuas hati, perkara yang berkenaan dengannya dia tidak berpuas hati itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_67__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_67__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mengandungi apa-apa maklumat yang ditetapkan oleh kaedah-kaedah yang dibuat oleh Majlis Peguam Syarie di bawah seksyen 65; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_67__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_67__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mengemukakan kepada Ketua Pendaftar dalam tempoh tidak lebih daripada dua belas bulan atau apa-apa tempoh sebagaimana yang ditetapkan melalui kaedah-kaedah yang dibuat di bawah seksyen ini, selepas berakhirnya tempoh perakaunan yang dinyatakan dalam laporan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_67__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_67__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_67__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_67__subsec_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_67__subsec_3__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_67",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada mana-mana kaedah-kaedah yang dibuat di bawah seksyen ini, tempoh perakaunan bagi maksud suatu laporan akauntan yang disebut dalam subseksyen (1) hendaklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_67__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_67__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "bermula pada habisnya tempoh perakaunan terakhir sebelumnya yang baginya suatu laporan akauntan telah diserahkan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_67__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_67__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "meliputi tidak kurang daripada dua belas bulan dalam satu tahun kalendar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_67__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_67__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "berakhir tidak lebih daripada dua belas bulan sebelum tarikh laporan itu dikemukakan kepada Ketua Pendaftar; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_67__subsec_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_67__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "selaras dengan perenggan (a), (b) dan (c) bersamaan dengan suatu tempoh atau tempoh berturut-turut yang baginya akaun Peguam Syarie itu atau firmanya biasanya disediakan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_67__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_67",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana Peguam Syarie yang tidak mematuhi seksyen ini hendaklah tertakluk kepada prosiding tatatertib. Kuasa untuk membuat kaedah-kaedah berhubung dengan pemeriksaan laporan akauntan, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_68",
      "@type": "akn:clause",
      "eli:number": "68",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_68__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_68__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_68__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_68__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_68",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis Peguam Syarie hendaklah, dengan kelulusan Menteri, membuat kaedah-kaedah untuk menguatkuasakan seksyen ini dan tanpa menyentuh keluasan seksyen 65 dan 67, kaedah-kaedah itu hendaklah menetapkan jenis dan takat pemeriksaan yang hendak dibuat oleh akauntan itu ke atas buku dan akaun firma mana-mana Peguam Syarie dan ke atas apa-apa dokumen lain yang berkaitan dengan tujuan bagi penyediaan laporan yang hendaklah dikemukakan oleh Peguam Syarie itu di bawah seksyen ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_68__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_68__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_68__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_68",
      "schema:text": {
        "@language": "ms",
        "@value": "Kaedah-kaedah yang disebut dalam subseksyen (1) boleh termasuk peruntukan bagi—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_68__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_68__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "membenarkan dalam apa-apa hal keadaan khas yang ditakrifkan dalam kaedah-kaedah itu suatu tempoh perakaunan yang berlainan daripada tempoh yang dinyatakan dalam subseksyen 67(3); dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_68__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_68__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mengawal selia apa-apa perkara mengenai tatacara atau perkara yang bersampingan atau yang menjadi tambahan kepada seksyen ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_68__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_68",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana Peguam Syarie yang tidak mematuhi seksyen ini atau mana-mana kaedah-kaedah yang dibuat di bawahnya hendaklah tertakluk kepada prosiding tatatertib. Peguam Syarie tidak boleh dengan sengaja dan dengan diketahuinya bertindak sebagai ejen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_69",
      "@type": "akn:clause",
      "eli:number": "69",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_69__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_69__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_69__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_69__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_69__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_69__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_69__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_69",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana Peguam Syarie tidak boleh dengan sengaja dan dengan diketahuinya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_69__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_69__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bertindak sebagai ejen dalam apa-apa jenis prosiding undang-undang atau dalam apa-apa perkara yang di bawah Akta ini hanya boleh dilakukan oleh seorang Peguam Syarie yang mempunyai Perakuan Amalan Tahunan yang sah;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_69__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_69__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "membenarkan namanya digunakan dalam mana-mana prosiding undang-undang atau perkara bagi pihak atau bagi keuntungan Peguam Syarie yang lain, atau menghantar apa-apa proses kepada Peguam Syarie yang lain; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_69__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_69__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "melakukan apa-apa perbuatan lain yang membolehkan Peguam Syarie itu hadir, bertindak, menjalankan amalan atau berupa sebagai menjalankan amalan sebagai Peguam Syarie dalam apa-apa prosiding atau perkara itu. Persekutuan)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_69__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_69",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang Peguam Syarie tidak boleh memberi kuasa kepada mana-mana orang yang tidak diberi kuasa untuk mengendalikan apa-apa akaun bank atas namanya atau atas nama firmanya dan yang disenggara olehnya atau oleh firmanya yang berkaitan dengan amalannya sebagai seorang Peguam Syarie."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_69__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_69",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana Peguam Syarie yang berlanggaran dengan subseksyen (1) atau (2) hendaklah tertakluk kepada prosiding tatatertib. Peguam Syarie tidak boleh mengguna khidmat seorang bankrap yang belum dilepaskan, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_70",
      "@type": "akn:clause",
      "eli:number": "70",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_70__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_70__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_70__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_70__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_70__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_70__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_70__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_70__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_70__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_70__subsec_1__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_70",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang Peguam Syarie tidak boleh, berkaitan dengan amalannya, mengguna khidmat atau menyara mana-mana orang yang diketahuinya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_70__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_70__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "merupakan seorang bankrap yang belum dilepaskan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_70__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_70__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "namanya telah dipotong daripada Daftar selain atas permintaannya sendiri di mana-mana Negeri dan namanya masih dipotong;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_70__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_70__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah digantung daripada menjalankan amalan sebagai Peguam Syarie di mana-mana Negeri dan masih digantung;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_70__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_70__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah disabitkan atas apa-apa kesalahan di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_70__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_70__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah disabitkan atas suatu kesalahan yang melibatkan kecurangan atau fraud atau telah didapati bersalah melakukan kesalahan di bawah Akta Suruhanjaya Pencegahan Rasuah Malaysia 2009 [Akta 694];"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_70__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_70__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah disabitkan atas suatu kesalahan di bawah seksyen 15a Akta Kesalahan Kecil 1955 [Akta 336]; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_70__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_70__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "diguna khidmat sebagai pegawai awam."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_70__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_70",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana Peguam Syarie yang bertindak bersalahan dengan seksyen ini hendaklah tertakluk kepada prosiding tatatertib. Harta, dokumen, wang, dsb., anak guam Mengambil alih harta, dsb., oleh Majlis Peguam Syarie"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_71",
      "@type": "akn:clause",
      "eli:number": "71",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_71__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_71__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_71__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_71",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis Peguam Syarie boleh, jika mempunyai sebab yang munasabah untuk mempercayai bahawa seseorang Peguam Syarie, rakan kongsi atau pekerjanya telah melakukan suatu kesalahan atas kecurangan berkaitan dengan amalan Peguam Syarie itu sebagai seorang Peguam Syarie atau berkaitan dengan apa-apa amanah yang Peguam Syarie itu menjadi pemegang amanah atau pemegang amanah bersama dengan rakan kongsi atau seorang atau lebih pekerjanya, mengeluarkan suatu perakuan bagi maksud itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_71__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_71",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila perakuan itu dikeluarkan, apa-apa harta, dokumen kepunyaan, atau wang yang kena dibayar kepada, anak guam Peguam Syarie atau apa-apa amanah yang dipegang oleh Peguam Syarie itu, rakan kongsi atau pekerjanya hendaklah diuruskan oleh Majlis Peguam Syarie mengikut peruntukan Jadual Ketiga. Membuat perkiraan apabila Peguam Syarie digantung daripada menjalankan amalan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_72",
      "@type": "akn:clause",
      "eli:number": "72",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_72__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_72__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_72__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_72__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_72__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_72__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_72__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_72",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika nama seseorang Peguam Syarie dikeluarkan daripada Daftar atau jika seseorang Peguam Syarie digantung daripada menjalankan amalan, Peguam Syarie itu hendaklah, dalam masa dua puluh satu hari daripada tarikh material, memuaskan hati Majlis Peguam Syarie bahawa dia telah membuat perkiraan yang sesuai untuk menyediakan bagi anak guamnya atau bagi Peguam Syarie lain yang diarahkan oleh anak guamnya atau olehnya sendiri—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_72__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_72__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "semua surat ikatan, wasiat, dokumen yang menjadi atau menerangkan hakmilik apa-apa harta, kertas, buku akaun, rekod, baucer dan dokumen lain yang ada dalam milikan atau kawalan Peguam Syarie atau firmanya, rakan kongsi atau pekerjanya atau yang berhubungan dengan apa-apa amanah yang dia menjadi pemegang amanah tunggal atau pemegang amanah bersama dengan seorang atau lebih rakan kongsi atau pekerjanya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_72__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_72__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "semua wang yang kena dibayar olehnya atau oleh firmanya kepada anak guamnya, atau yang dipegang olehnya atau oleh firmanya bagi pihak anak guamnya atau yang tertakluk kepada sesuatu amanah di bawah perenggan (a). Persekutuan)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_72__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_72",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Peguam Syarie itu tidak memberikan penjelasan yang memuaskan hati Majlis Peguam Syarie, peruntukan Jadual Ketiga hendaklah terpakai bagi Peguam Syarie itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_72__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_72__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_72__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_72__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_72",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam subseksyen (1), “tarikh material” ertinya tarikh yang terkemudian sekali antara tarikh-tarikh yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_72__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_72__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "tarikh apabila perintah Lembaga Tatatertib atau perintah Mahkamah Tinggi Syariah yang dengannya atau yang menurutnya nama Peguam Syarie itu dikeluarkan atau dipotong daripada Daftar, atau Peguam Syarie itu digantung daripada menjalankan amalan, akan mula berkuat kuasa;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_72__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_72__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "tarikh terakhir yang sesuatu rayuan terhadap perintah dalam perenggan (a) boleh dibuat; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_72__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_72__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "tarikh sesuatu rayuan di bawah perenggan (b) ditolak atau ditarik balik."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_72__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_72",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam seksyen ini dan Jadual Ketiga, perkataan “amanah” dan “pemegang amanah” mempunyai erti yang sama sebagaimana dalam subseksyen 65(4). Kuasa Majlis Peguam Syarie untuk mengambil milik dokumen, dsb., daripada Peguam Syarie"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_73",
      "@type": "akn:clause",
      "eli:number": "73",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_73__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_73__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_73__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_73__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_73__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_73__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_73__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_73__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_73",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_73__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_73__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu aduan dibuat kepada Majlis Peguam Syarie bahawa telah ada kelewatan yang tidak sepatutnya dipihak seseorang Peguam Syarie berkaitan dengan apa-apa perkara yang Peguam Syarie itu atau firmanya telah diarahkan bagi pihak seseorang anak guam atau apa-apa perkara berkenaan dengan pentadbiran sesuatu amanah yang Peguam Syarie itu menjadi pemegang amanah tunggal atau pemegang amanah bersama dengan seorang atau lebih rakan kongsi atau pekerjanya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_73__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_73__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis Peguam Syarie melalui notis bertulis menghendaki Peguam Syarie itu untuk memberikan penjelasan berkenaan dengan perkara itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_73__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_73__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Peguam Syarie itu telah, dalam tempoh tidak kurang daripada dua puluh satu hari yang dinyatakan dalam notis tersebut, tidak memberikan penjelasan berkenaan dengan perkara itu yang dianggap cukup dan memuaskan oleh Majlis Peguam Syarie; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_73__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_73__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Peguam Syarie itu telah diberitahu secara bertulis oleh Majlis Peguam Syarie bahawa dia telah gagal memberi penjelasan itu, peruntukan Jadual Ketiga kecuali perenggan 10 hendaklah terpakai bagi Peguam Syarie itu, tetapi berkenaan dengan dokumen yang dinyatakan dalam perenggan 1 Jadual Ketiga kepada Akta dan jumlah wang yang dinyatakan dalam perenggan 12 Jadual Ketiga kepada Akta, hanya setakat yang dokumen dan wang itu berkaitan dengan hal perkara aduan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_73__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_73",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis Peguam Syarie boleh, bagi maksud perenggan 9 dalam Jadual Ketiga, membuat salinan, atau cabutan daripada, dokumen yang berkaitan dengan perkara yang diadukan itu dan dengan perkara lain dalam amalan Peguam Syarie itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_73__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_73",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam seksyen ini, perkataan “amanah” dan “pemegang amanah” mempunyai erti yang sama sebagaimana dalam subseksyen 65(4). Kuasa Majlis Peguam Syarie untuk mengambil milik dokumen, dsb., daripada Peguam Syarie apabila dia merupakan seorang bankrap yang belum dilepaskan, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_74",
      "@type": "akn:clause",
      "eli:number": "74",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_74__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_74__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_74__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_74__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_74__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_74__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_74__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_74__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_74",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seseorang Peguam Syarie yang menjalankan amalan atas namanya sendiri atau sebagai Peguam Syarie di bawah suatu nama firma dan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_74__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_74__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "merupakan seorang bankrap yang belum dilepaskan atau perintah kebankrapan masih berkuat kuasa terhadapnya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_74__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_74__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah membuat suatu komposisi dengan pemiutangnya atau suatu surat ikatan perkiraan bagi faedah pemiutangnya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_74__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_74__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu perintah supaya dia dibicarakan atau suatu perintah supaya suatu writ tahan harta telah dibuat terhadapnya; atau Persekutuan)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_74__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_74__subsec_1__para_d__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_74__subsec_1__para_d__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_74__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "merupakan orang yang kecelaruan mental sebagaimana yang ditakrifkan di bawah Akta Kesihatan Mental 2001 [Akta 615], dan Majlis Peguam Syarie mempunyai sebab yang munasabah untuk mempercayai bahawa disebabkan perbuatan, kemungkiran atau ketidakupayaan Peguam Syarie itu atau pekerjanya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_74__subsec_1__para_d__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_74__subsec_1__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "terdapat kelengahan tidak wajar berkaitan dengan apa-apa perkara yang Peguam Syarie atau firmanya telah diarah bagi pihak anak guam atas apa-apa perkara berkaitan dengan pentadbiran suatu amanah yang Peguam Syarie itu menjadi pemegang amanah tunggal atau pemegang amanah bersama dengan seorang atau lebih rakan kongsi atau pekerjanya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_74__subsec_1__para_d__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_74__subsec_1__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa jumlah wang yang kena dibayar oleh Peguam Syarie atau firmanya itu kepada anak guamnya, atau yang dipegang olehnya atau firmanya bagi pihak anak guamnya, atau yang tertakluk kepada apa-apa amanah yang dia merupakan pemegang amanah tunggal atau pemegang amanah bersama dengan seorang atau lebih rakan kongsi atau pekerjanya, adalah dalam bahaya semasa berada dalam kawalan atau milikan Peguam Syarie itu atau firmanya, peruntukan Jadual Ketiga kecuali perenggan 10 hendaklah terpakai bagi Peguam Syarie itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_74__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_74",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis Peguam Syarie boleh, bagi maksud perenggan 9 Jadual Ketiga membuat salinan, atau cabutan daripada, dokumen yang berkaitan dengan apa-apa perkara yang disebut dalam subperenggan (1)(i) atau dengan apa-apa jumlah wang yang disebut dalam subperenggan (1)(ii) atau dengan perkara atau jumlah wang itu, mengikut mana-mana yang berkenaan, dan dengan perkara lain dalam amalan Peguam Syarie itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_74__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_74",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam seksyen ini perkataan “amanah” dan “pemegang amanah” mempunyai erti yang sama sebagaimana dalam subseksyen 65(4). Wakil diri bertanggungan bagi perbuatan Peguam Syarie yang meninggal dunia"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_75",
      "@type": "akn:clause",
      "eli:number": "75",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_75__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_75__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_75__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_75__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_75__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_75",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_75__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_75__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis Peguam Syarie mempunyai sebab yang munasabah untuk mempercayai bahawa wakil diri bagi seorang Peguam Syarie yang telah meninggal dunia yang sebaik sebelum kematiannya telah menjalankan amalan sebagai seorang Peguam Syarie atas namanya sendiri, bersalah atas kecurangan atau kelengahan tidak wajar dalam mentadbir hal ehwal amalan Peguam Syarie itu atau berkaitan dengan apa-apa amanah yang Peguam Syarie itu menjadi pemegang amanah tunggal atau pemegang amanah bersama dengan seorang atau lebih rakan kongsi atau pekerjanya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_75__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_75__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang Peguam Syarie meninggal dunia dan sebaik sebelum kematiannya peruntukan Jadual Ketiga terpakai baginya, peruntukan Jadual Ketiga kecuali perenggan 10 hendaklah terpakai bagi wakil diri Peguam Syarie itu dan hendaklah terus terpakai bagi wakil diri Peguam Syarie itu sebagaimana peruntukan itu terpakai atau telah terpakai, mengikut mana-mana yang berkenaan, berhubung dengan Peguam Syarie yang disebut dalam peruntukan itu dan seolah-olah perkataan “wakil diri” telah, dengan penyesuaian yang perlu, menggantikan perkataan “Peguam Syarie” di mana-mana jua perkataan tersebut terdapat dalam peruntukan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_75__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_75",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam seksyen ini, perkataan “amanah” dan “pemegang amanah” mempunyai erti yang sama sebagaimana dalam subseksyen 65(4). Majlis Peguam Syarie hendaklah mengendalikan akaun bank anak guam bagi Peguam Syarie yang meninggal dunia"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII__cl_76",
      "@type": "akn:clause",
      "eli:number": "76",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VIII",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila seseorang Peguam Syarie meninggal dunia yang sebaik sebelum kematiannya telah menjalankan amalan sebagai seorang Peguam Syarie atas namanya sendiri, hak untuk mengendalikan, atau menguruskan dengan cara lain, apa-apa akaun bank atas nama Peguam Syarie itu atau nama firmanya, merupakan suatu akaun yang ke dalamnya telah dibayar apa-apa wang anak guam, Persekutuan) hendaklah, walau apa pun apa-apa jua yang terkandung dalam Akta ini yang berlawanan, terletak hak pada Majlis Peguam Syarie dengan mengenepikan hak mana-mana wakil diri Peguam Syarie itu dan boleh dijalankan mulai dari tarikh Peguam Syarie itu meninggal dunia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_42",
      "@type": "akn:clause",
      "eli:number": "42",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_42__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_42__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_42__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_42__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_42__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_42",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu pertubuhan perbadanan yang dinamakan Badan Peguam Syarie Wilayah-Wilayah Persekutuan ditubuhkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_42__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_42",
      "schema:text": {
        "@language": "ms",
        "@value": "Badan Peguam Syarie hendaklah kekal turun-temurun dan mempunyai meterai perbadanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_42__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_42",
      "schema:text": {
        "@language": "ms",
        "@value": "Badan Peguam Syarie boleh membawa guaman dan dibawa guaman terhadapnya atas nama perbadanannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_42__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_42__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_42__subsec_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_42__subsec_4__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_42__subsec_4__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_42__subsec_4__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_42",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada dan bagi maksud Akta ini, Badan Peguam Syarie boleh, atas apa-apa terma yang difikirkannya patut—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_42__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_42__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat kontrak;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_42__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_42__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "memperoleh, membeli, mengambil, memegang atau menikmati, mengikut mana-mana yang berkenaan apa-apa harta, hak, faedah, kewajipan dan liabiliti, dalam apa-apa perihalan pun;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_42__subsec_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_42__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "memindahkan, menyerahhakkan, menyerahkan balik, memulangkan, menggadaikan, menggadaijanjikan, mendemiskan, menyewakan, menyerahhakkan semula, memindah milik atau selainnya melupuskan, atau membuat apa-apa urusan mengenai, apa-apa harta alih atau tak alih atau apa-apa kepentingan mengenai harta itu yang terletak hak pada Badan Peguam Syarie;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_42__subsec_4__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_42__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "melaburkan apa-apa wang Badan Peguam Syarie dalam apa-apa pelaburan patuh syariah yang dibenarkan bagi pelaburan wang amanah oleh mana-mana undang-undang bertulis; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_42__subsec_4__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_42__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "meminjam wang bagi maksud yang Badan Peguam Syarie fikirkan wajar dan bagi maksud itu boleh mencagarkan mana-mana harta tak alih yang terletak hak pada Badan Peguam Syarie itu. Persekutuan) Matlamat Badan Peguam Syarie"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_43",
      "@type": "akn:clause",
      "eli:number": "43",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_43__subsec_1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_43__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_43__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_43__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_43__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_43__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_43__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_43__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_43__subsec_1__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_43__subsec_1__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_43__subsec_1__para_i"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Matlamat Badan Peguam Syarie adalah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_43__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_43__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menggalakkan dan menjaga kepentingan profesion guaman syarie berhubung dengan amalan undang-undang syariah di Wilayah-Wilayah Persekutuan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_43__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_43__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mempertahankan keadilan tanpa mengira kepentingan sendiri atau kepentingan anggotanya, tidak dipengaruhi oleh perasaan takut atau kasihan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_43__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_43__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menjaga dan memajukan standard kelakuan dan pengajaran profesion guaman syarie di Wilayah-Wilayah Persekutuan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_43__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_43__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menjaga integriti dan status Peguam Syarie serta mengelak amalan yang tidak sah, curang dan tidak beretika dalam kalangan pengamal undang-undang syariah;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_43__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_43__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menggalakkan peluang bagi pemerolehan dan penyebaran pengetahuan dan kemahiran dalam amalan dan pemakaian undang-undang syariah;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_43__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_43__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika diminta berbuat demikian, untuk menyatakan pendapatnya dalam perkara yang melibatkan amalan dan pembaharuan undang-undang syariah di Wilayah-Wilayah Persekutuan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_43__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_43__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk melindungi dan membantu orang awam dalam semua perkara yang bersampingan dengan undang-undang syariah;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_43__subsec_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_43__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menggalakkan hubungan baik dan hubungan sosial dalam kalangan anggota dan antara anggota dengan orang lain yang kena-mengena dengan pentadbiran undang-undang, sivil atau syariah, di Wilayah-Wilayah Persekutuan atau di Negeri-Negeri lain; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_43__subsec_1__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_43__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menggalakkan, mengadakan dan menjaga hubungan baik dengan badan profesional bagi profesion undang-undang di negara lain dan untuk mengambil bahagian dalam aktiviti mana-mana persatuan tempatan atau antarabangsa dan menjadi anggota persatuan itu. Kuasa untuk membuat kaedah-kaedah berhubung dengan tatacara mesyuarat, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_44",
      "@type": "akn:clause",
      "eli:number": "44",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_44__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_44__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_44__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII",
      "schema:name": {
        "@language": "ms",
        "@value": "Badan Peguam Syarie boleh membuat kaedah-kaedah untuk—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_44__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_44",
      "schema:text": {
        "@language": "ms",
        "@value": "menetapkan tatacara apa-apa mesyuarat termasuklah tatacara mesyuarat agung tahunan dan mesyuarat agung luar biasa Badan Peguam Syarie;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_44__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_44",
      "schema:text": {
        "@language": "ms",
        "@value": "mengawal selia penjalanan pemilihan anggota Majlis Peguam Syarie; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_44__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_44",
      "schema:text": {
        "@language": "ms",
        "@value": "menetapkan apa-apa perkara lain yang bersampingan bagi penambahbaikan Badan Peguam Syarie. Anggota Badan Peguam Syarie"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_45",
      "@type": "akn:clause",
      "eli:number": "45",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_45__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_45__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_45__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_45",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang telah diterima masuk dan didaftarkan sebagai Peguam Syarie di bawah Akta ini hendaklah menjadi anggota Badan Peguam Syarie selagi mana dia mempunyai suatu Perakuan Amalan Tahunan yang sah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_45__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_45",
      "schema:text": {
        "@language": "ms",
        "@value": "Peruntukan Jadual Kedua kepada Akta hendaklah terpakai bagi anggota Badan Peguam Syarie. Kelayakan sebagai anggota"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_46",
      "@type": "akn:clause",
      "eli:number": "46",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_46__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_46__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_46__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_46__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang anggota Badan Peguam Syarie yang tidak terhutang yuran di bawah seksyen 47 layak—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_46__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menghadiri dan mengundi dalam mana-mana mesyuarat agung;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_46__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk dipilih sebagai anggota Majlis Peguam Syarie;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_46__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengundi dalam pemilihan anggota Majlis Peguam Syarie; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_46__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk berkhidmat dalam mana-mana Jawatankuasa Majlis Peguam Syarie. Persekutuan) Yuran tahunan dan levi"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_47",
      "@type": "akn:clause",
      "eli:number": "47",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_47__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_47__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_47__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_47__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_47__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_47__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis Peguam Syarie boleh menentukan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_47__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_47__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "amaun yuran tahunan yang kena dibayar oleh anggota Badan Peguam Syarie; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_47__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_47__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "levi yang kena dibayar oleh anggota Badan Peguam Syarie bagi apa-apa tujuan Badan Peguam Syarie."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_47__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Jumlah yuran dan levi yang kena dibayar di bawah subseksyen (1) tidak boleh dalam mana-mana tahun kalendar melebihi tiga ratus ringgit bagi setiap anggota Badan Peguam Syarie tanpa kelulusan dua per tiga daripada anggota yang hadir dan mengundi sendiri dalam sesuatu mesyuarat agung tahunan Badan Peguam Syarie."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_47__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanggungan untuk membayar apa-apa yuran tahunan oleh anggota Badan Peguam Syarie kepada Badan Peguam Syarie hendaklah bermula apabila yuran telah ditetapkan oleh Majlis Peguam Syarie dan semua yuran tahunan hendaklah dibayar pada atau sebelum 31 Mac setiap tahun. Majlis Peguam Syarie Wilayah-Wilayah Persekutuan Penubuhan Majlis Peguam Syarie Wilayah-Wilayah Persekutuan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_48",
      "@type": "akn:clause",
      "eli:number": "48",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_48__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_48__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_48__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_48__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_48",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu majlis yang dikenali sebagai Majlis Peguam Syarie Wilayah-Wilayah Persekutuan ditubuhkan bagi pengurusan sempurna Badan Peguam Syarie dan bagi pelaksanaan wajar fungsinya di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_48__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_48__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_48__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_48",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis Peguam Syarie hendaklah terdiri daripada yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_48__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_48__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mantan Presiden dan Naib Presiden Badan Peguam Syarie terdahulu yang terdekat kecuali bagi Majlis Peguam Syarie yang pertama; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_48__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_48__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "tiga belas orang Peguam Syarie yang dipilih menurut seksyen 49."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_48__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_48",
      "schema:text": {
        "@language": "ms",
        "@value": "Peruntukan Jadual Kedua kepada Akta hendaklah terpakai bagi Majlis Peguam Syarie. Pemilihan anggota Majlis Peguam Syarie yang pertama, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_49",
      "@type": "akn:clause",
      "eli:number": "49",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_49__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_49__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_49__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_49__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_49__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_49__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_49",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun seksyen 48, Ketua Pendaftar hendaklah, selepas habis tempoh tiga puluh hari dan tidak lewat daripada enam puluh hari daripada permulaan kuat kuasa Akta ini, memanggil semua anggota Badan Peguam Syarie bagi suatu mesyuarat pada bila-bila masa dan mana-mana tempat yang akan ditetapkan olehnya untuk memilih anggota Majlis Peguam Syarie yang disebut dalam perenggan 48(2)(b) dalam kalangan anggotanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_49__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_49",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pendaftar hendaklah, dalam mesyuarat, melantik seorang Peguam Syarie yang telah menjalankan amalan tidak kurang daripada lima belas tahun, dan jika tiada, mana-mana Peguam Syarie yang telah menjalankan amalan tidak kurang daripada lima tahun untuk mempengerusikan mesyuarat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_49__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_49",
      "schema:text": {
        "@language": "ms",
        "@value": "Kuorum mesyuarat yang disebut dalam subseksyen (1) hendaklah tidak kurang daripada lima puluh orang anggota Badan Peguam Syarie."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_49__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_49",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua perkara berbangkit dalam mesyuarat itu hendaklah diputuskan oleh majoriti anggota yang hadir dan apabila terdapat undi yang sama banyak, Peguam Syarie yang dilantik di bawah subseksyen (2) hendaklah mempunyai undi pemutus."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_49__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_49",
      "schema:text": {
        "@language": "ms",
        "@value": "Anggota yang dipilih itu hendaklah memegang jawatan sehingga anggota baharu yang dipilih di bawah seksyen 50 memulakan jawatannya. Pemilihan anggota Majlis Peguam Syarie berikutnya"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_50",
      "@type": "akn:clause",
      "eli:number": "50",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_50__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_50__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_50__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_50__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_50__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_50__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_50__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_50",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis Peguam Syarie hendaklah, dalam bulan September tiap-tiap dua tahun, menetapkan dan menyiarkan sebelum akhir bulan itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_50__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_50__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tarikh penamaan untuk memilih anggota Majlis Peguam Syarie yang disebut dalam perenggan 48(2)(b) yang hendaklah pada minggu pertama bulan Oktober tahun itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_50__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_50__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tarikh pemilihan yang hendaklah pada minggu terakhir bulan Oktober tahun itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_50__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_50__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "nama tiga orang juruaudit. Persekutuan)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_50__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_50",
      "schema:text": {
        "@language": "ms",
        "@value": "Pemilihan anggota Majlis Peguam Syarie hendaklah diadakan dalam masa empat belas hari sebelum mesyuarat agung tahunan dan hendaklah, tertakluk kepada seksyen 52, dijalankan dengan apa-apa cara sebagaimana yang ditetapkan oleh kaedah-kaedah yang dibuat di bawah Akta ini pada tarikh yang ditetapkan oleh Majlis Peguam Syarie menurut subseksyen (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_50__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_50",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (1) dan (2), apa-apa kegagalan yang tidak disengajakan di pihak Majlis Peguam Syarie untuk mematuhi seksyen ini atau mana-mana kaedah-kaedah yang dibuat berkenaan dengan pemilihan anggota Majlis Peguam Syarie tidaklah menidaksahkan pemilihan itu. Kelayakan untuk dinamakan dan dilantik sebagai anggota Majlis Peguam Syarie"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_51",
      "@type": "akn:clause",
      "eli:number": "51",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap anggota Badan Peguam Syarie layak untuk dinamakan atau dilantik sebagai anggota Majlis Peguam Syarie dengan syarat bahawa anggota itu tidak kehilangan kelayakan di bawah seksyen 58. Penamaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_52",
      "@type": "akn:clause",
      "eli:number": "52",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_52__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_52__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_52__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_52__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_52__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_52",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa penamaan mana-mana calon bagi pemilihan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_52__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_52__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah secara bertulis dan ditandatangani oleh tidak kurang daripada dua orang anggota yang menyokong; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_52__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_52__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah menamakan hanya seorang calon sahaja dan persetujuan calon itu hendaklah diendorskan oleh calon itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_52__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_52",
      "schema:text": {
        "@language": "ms",
        "@value": "Nama calon untuk pemilihan yang dinamakan di bawah subseksyen (1) hendaklah dihantar kepada atau didepositkan di pejabat Badan Peguam Syarie tidak lewat daripada dua puluh satu hari daripada tarikh yang ditentukan oleh Majlis Peguam Syarie bagi pemilihan anggota Majlis Peguam Syarie itu. Penamaan tidak mencukupi"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_53",
      "@type": "akn:clause",
      "eli:number": "53",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_53__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_53__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_53__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_53__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_53",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika bilangan calon yang dinamakan bagi suatu pemilihan bagi Majlis Peguam Syarie adalah bilangan anggota yang dikehendaki untuk dipilih, calon itu hendaklah disifatkan sebagai telah dipilih dan, jika kurang, calon yang dinamakan hendaklah disifatkan sebagai telah dipilih sebagai anggota Majlis Peguam Syarie yang berikutnya dan anggota yang disifatkan dipilih itu bersama-sama dengan anggota Majlis Peguam Syarie lain yang sedia ada itu hendaklah melantik beberapa lagi anggota Badan Peguam Syarie yang perlu untuk memenuhi kehendak perenggan 48(2)(b)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_53__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_53",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika tiada penamaan dibuat bagi pemilihan anggota Majlis Peguam Syarie yang berikutnya, anggota Majlis Peguam Syarie sedia ada hendaklah melantik tiga belas anggota Badan Peguam Syarie untuk menjadi anggota Majlis Peguam Syarie yang berikutnya untuk memenuhi kehendak perenggan 48(2)(b)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_53__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_53",
      "schema:text": {
        "@language": "ms",
        "@value": "Anggota yang dilantik di bawah subseksyen (1) dan (2) hendaklah, bagi maksud Akta ini, disifatkan sebagai anggota yang dipilih. Tempoh memegang jawatan anggota Majlis Peguam Syarie"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_54",
      "@type": "akn:clause",
      "eli:number": "54",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_54__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_54__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_54__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_54",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap anggota Majlis Peguam Syarie yang dipilih di bawah seksyen 50 atau disifatkan telah dipilih di bawah seksyen 53 hendaklah memulakan jawatannya pada 1 Januari selepas pemilihan itu hingga 31 Disember tahun berikutnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_54__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_54",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap anggota yang dipilih di bawah seksyen 50 layak untuk dipilih semula. Kekosongan luar jangka"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_55",
      "@type": "akn:clause",
      "eli:number": "55",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_55__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_55__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_55__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_55__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_55",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa kekosongan luar jangka yang berbangkit dalam kalangan anggota Majlis Peguam Syarie yang dipilih hendaklah diisi oleh Majlis Peguam Syarie itu dengan pelantikan orang yang berkelayakan di bawah Akta ini, dan anggota baharu itu hendaklah memegang jawatan selama baki tempoh jawatan anggota yang digantikannya itu. Persekutuan)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_55__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_55",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun apa-apa kekosongan dalam Majlis Peguam Syarie, anggota yang terus menjadi anggota Majlis Peguam Syarie itu boleh bertindak jika kuorum penuh."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_55__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_55",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada apa-apa perbuatan yang dilakukan oleh atau di bawah kuasa Majlis Peguam Syarie akan terbatal oleh sebab apa- apa kecacatan yang didapati kemudiannya dalam pemilihan atau kelayakan anggota atau mana-mana daripada mereka. Pemegang Jawatan Presiden, Naib Presiden, Setiausaha dan Bendahari Badan Peguam Syarie"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_56",
      "@type": "akn:clause",
      "eli:number": "56",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_56__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_56__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_56__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_56__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_56__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_56__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_56__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_56__subsec_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_56__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_56",
      "schema:text": {
        "@language": "ms",
        "@value": "Seorang Presiden, Naib Presiden, Setiausaha dan seorang Bendahari bagi Badan Peguam Syarie yang hendaklah dipilih oleh Majlis Peguam Syarie dalam kalangan anggota Majlis Peguam Syarie."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_56__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_56",
      "schema:text": {
        "@language": "ms",
        "@value": "Presiden Badan Peguam Syarie tidak boleh memegang jawatan lebih daripada dua penggal berturut-turut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_56__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_56",
      "schema:text": {
        "@language": "ms",
        "@value": "Presiden Badan Peguam Syarie hendaklah juga berkhidmat sebagai Pengerusi Majlis Peguam Syarie."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_56__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_56",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam keadaan apa-apa kekosongan luar jangka berbangkit berkenaan dengan jawatan Presiden, Naib Presiden, Setiausaha atau Bendahari, Majlis Peguam Syarie hendaklah, dalam mesyuarat yang berikutnya atau dengan seberapa segera yang boleh, memilih seorang daripada anggotanya untuk mengisi kekosongan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_56__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_56",
      "schema:text": {
        "@language": "ms",
        "@value": "Presiden Badan Peguam Syarie hendaklah mempengerusikan semua mesyuarat Majlis Peguam Syarie dan Badan Peguam Syarie."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_56__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_56",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam hal apabila Presiden tidak berupaya menjalankan fungsinya sebagai Presiden, Naib Presiden hendaklah mempengerusikan mesyuarat Majlis Peguam Syarie atau Badan Peguam Syarie, mengikut mana-mana yang berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_56__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_56",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam hal apabila Presiden dan Naib Presiden tidak berupaya menjalankan fungsinya sebagai Presiden dan Naib Presiden, mengikut mana-mana yang berkenaan, mesyuarat Majlis Peguam Syarie atau Badan Peguam Syarie hendaklah dipengerusikan oleh mana-mana anggota yang dipilih oleh Majlis Peguam Syarie."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_56__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_56",
      "schema:text": {
        "@language": "ms",
        "@value": "Peruntukan Jadual Kedua hendaklah terpakai bagi anggota Majlis Peguam Syarie. Pengosongan jawatan anggota Majlis Peguam Syarie"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_57",
      "@type": "akn:clause",
      "eli:number": "57",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_57__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_57__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_57__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_57__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_57__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII",
      "schema:name": {
        "@language": "ms",
        "@value": "Seseorang anggota Majlis Peguam Syarie hendaklah mengosongkan jawatannya jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_57__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_57",
      "schema:text": {
        "@language": "ms",
        "@value": "namanya telah dipotong daripada Daftar atau dia digantung daripada menjalankan amalan sebagai seorang Peguam Syarie;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_57__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_57",
      "schema:text": {
        "@language": "ms",
        "@value": "dia menjadi tidak sempurna akal;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_57__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_57",
      "schema:text": {
        "@language": "ms",
        "@value": "dia seorang bankrap yang tidak dilepaskan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_57__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_57",
      "schema:text": {
        "@language": "ms",
        "@value": "dia meletakkan jawatannya dalam Majlis Peguam Syarie; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_57__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_57",
      "schema:text": {
        "@language": "ms",
        "@value": "dia tidak menghadiri tiga mesyuarat Majlis Peguam Syarie berturut-turut tanpa sebab yang munasabah. Kehilangan kelayakan anggota Majlis Peguam Syarie atau mana-mana Jawatankuasanya Kehilangan kelayakan anggota Majlis Peguam Syarie atau mana-mana Jawatankuasanya"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_58",
      "@type": "akn:clause",
      "eli:number": "58",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_58__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_58__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_58__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_58__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_58__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_58",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang hendaklah hilang kelayakan untuk menjadi anggota Majlis Peguam Syarie atau anggota mana-mana Jawatankuasanya jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_58__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_58__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dia merupakan seorang anggota Dewan Negara atau Dewan Rakyat, atau seorang anggota sesuatu Dewan Undangan Negeri, atau seorang anggota mana-mana pihak berkuasa tempatan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_58__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_58__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_58__subsec_1__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_58__subsec_1__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_58__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dia memegang apa-apa jawatan dalam—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_58__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_58__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana kesatuan sekerja;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_58__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_58__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana parti politik; atau Persekutuan)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_58__subsec_1__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_58__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa pertubuhan lain, apa jua pun badan atau kumpulan orang, sama ada atau tidak ia ditubuhkan di bawah mana-mana undang-undang, sama ada ia di dalam Malaysia atau di luar Malaysia, yang mempunyai objektif atau menjalankan aktiviti yang boleh ditafsirkan sebagai berciri politik dari segi sifat, perilaku atau kesan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_58__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_58",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seseorang anggota Majlis Peguam Syarie atau mana-mana anggota jawatankuasanya menjadi hilang kelayakan di bawah subseksyen (1) dia hendaklah secara serta merta disifatkan telah mengosongkan keanggotaannya dan apa-apa jawatan yang dipegangnya. Kuasa Majlis Peguam Syarie Kuasa Majlis Peguam Syarie"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_59",
      "@type": "akn:clause",
      "eli:number": "59",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_59__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_59__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_59__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_59__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_59__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_59",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengurusan Badan Peguam Syarie dan pengurusan kumpulan wangnya hendaklah terletak hak pada Majlis Peguam Syarie."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_59__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_59",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa kuasa, tindakan atau perkara yang tidak secara nyata dibenarkan, diarahkan atau dikehendaki oleh Akta ini supaya dijalankan atau dilakukan oleh Badan Peguam Syarie dalam mesyuarat agungnya boleh, tertakluk kepada Akta ini atau apa-apa ketetapan yang diluluskan oleh Badan Peguam Syarie dalam mesyuarat agung, dijalankan atau dilakukan oleh Majlis Peguam Syarie."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_59__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_59",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa ketetapan yang diluluskan di bawah subseksyen (2) tidak boleh membatalkan apa-apa kuasa yang telah dijalankan atau apa-apa perbuatan atau benda yang telah dilakukan terdahulu oleh Majlis Peguam Syarie yang adalah sah sekiranya ketetapan itu tidak diluluskan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_59__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_59__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_59__subsec_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_59__subsec_4__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_59__subsec_4__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_59__subsec_4__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_59__subsec_4__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_59__subsec_4__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_59__subsec_4__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_59__subsec_4__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_59__subsec_4__para_j"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_59",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan kuasa yang diberikan di bawah subseksyen (1), (2) dan (3), Majlis Peguam Syarie hendaklah mempunyai kuasa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_59__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_59__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menjawab soalan yang menyentuh amalan dan etika profesion guaman syarie dan kelakuan anggota;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_59__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_59__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengambil endah apa-apa perkara yang menyentuh Badan Peguam Syarie atau kelakuan profesional anggotanya dan membawa ke dalam mesyuarat agung Badan Peguam Syarie apa-apa perkara yang difikirkan material kepada Badan Peguam Syarie atau kepada kepentingan profesion dan membuat apa-apa syor dan mengambil apa-apa tindakan sebagaimana yang difikirkannya patut;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_59__subsec_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_59__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk melantik pegawai, kerani, ejen dan pekerja sebagaimana yang difikirkannya adil dan munasabah dan untuk menentukan kewajipan dan terma perkhidmatan mereka;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_59__subsec_4__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_59__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memeriksa dan, jika difikirkan patut, membuat laporan mengenai undang-undang semasa mengenai syariah atau perundangan yang dicadangkan dan apa-apa perkara undang-undang yang lain;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_59__subsec_4__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_59__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mewakili anggota Majlis Peguam Syarie atau mana-mana anggotanya yang tertentu dalam apa-apa perkara yang perlu atau suai manfaat;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_59__subsec_4__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_59__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengambil bahagian sebagai peguam pemerhati, pencelah atau sahabat mahkamah dalam mana-mana prosiding yang menyentuh kepentingan profesion dan isu undang-undang yang berhubungan dengan orang Islam;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_59__subsec_4__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_59__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk membeli, memajak atau selainnya memperoleh apa-apa harta alih dan tak alih bagi kegunaan Badan Peguam Syarie, dan menjual, menyewakan, atau selainnya melupuskan apa-apa harta;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_59__subsec_4__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_59__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk melabur dan menguruskan apa-apa wang Badan Peguam Syarie dalam pelaburan patuh syariah yang dibenarkan untuk pelaburan kumpulan wang amanah oleh mana-mana undang-undang bertulis;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_59__subsec_4__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_59__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menubuhkan, menyenggara dan menguruskan kumpulan wang Badan Peguam Syarie; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_59__subsec_4__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_59__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menjalankan apa-apa kuasa, keistimewaan dan budi bicara sebagaimana yang tidak dikehendaki secara nyata dan eksklusif oleh Akta ini untuk dijalankan oleh anggota Badan Peguam Syarie dalam mesyuarat agung. Persekutuan) Penubuhan jawatankuasa"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_60",
      "@type": "akn:clause",
      "eli:number": "60",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_60__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_60__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_60__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_60__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_60__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_60__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_60__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_60",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis Peguam Syarie boleh menubuhkan apa-apa jawatankuasa sebagaimana yang difikirkan perlu dan suai manfaat oleh Majlis Peguam Syarie untuk membantu Majlis Peguam Syarie dalam menjalankan kuasanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_60__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_60",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis Peguam Syarie boleh mewakilkan kepada mana-mana jawatankuasa yang ditubuhkan di bawah subseksyen (1), dengan atau tanpa sekatan atau syarat, mana-mana kuasa Majlis Peguam Syarie."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_60__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_60",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa perwakilan di bawah seksyen ini boleh pada bila-bila masa dibatalkan atau dipinda oleh Majlis Peguam Syarie dan perwakilan sedemikian tidaklah menghalang Majlis Peguam Syarie daripada menjalankan apa-apa kuasanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_60__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_60",
      "schema:text": {
        "@language": "ms",
        "@value": "Bilangan dan tempoh jawatan anggota jawatankuasa yang ditubuhkan di bawah subseksyen (1), dan bilangan anggota yang perlu untuk membentuk suatu kuorum, hendaklah ditetapkan oleh Majlis Peguam Syarie."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_60__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_60",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana jawatankuasa yang ditubuhkan di bawah subseksyen (1) boleh termasuk orang yang bukan anggota Majlis Peguam Syarie."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_60__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_60",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila Majlis Peguam Syarie mewakilkan kepada jawatankuasa yang ditubuhkan di bawah subseksyen (1) apa-apa kuasanya di bawah Akta ini, sekurang-kurangnya separuh daripada anggota jawatankuasa termasuk pengerusinya merupakan anggota Majlis Peguam Syarie. Penyata, laporan, akaun dan maklumat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_61",
      "@type": "akn:clause",
      "eli:number": "61",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis Peguam Syarie hendaklah menyebabkan disediakan dan dibentangkan kepada anggota Badan Peguam Syarie apa-apa penyata, laporan, akaun dan maklumat berkenaan dengan pengurusan, aktiviti dan kewangannya dalam mesyuarat agung tahunan. Hak untuk memeriksa fail dan salinan prosiding kebankrapan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_62",
      "@type": "akn:clause",
      "eli:number": "62",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis Peguam Syarie boleh memeriksa fail prosiding kebankrapan yang berhubungan dengan mana-mana Peguam Syarie yang terhadapnya prosiding kebankrapan telah diambil, dan untuk dibekalkan dengan salinan asal atau salinan diperakui sah prosiding itu. Nama anggota Majlis Peguam Syarie, dsb., hendaklah disiarkan dan kerahsiaan pertimbangtelitian"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_63",
      "@type": "akn:clause",
      "eli:number": "63",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_63__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_63__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_63__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_63__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_63",
      "schema:text": {
        "@language": "ms",
        "@value": "Nama anggota dan nama Setiausaha Majlis Peguam Syarie hendaklah disiarkan dalam Warta."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_63__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_63",
      "schema:text": {
        "@language": "ms",
        "@value": "Kecuali setakat yang perlu bagi maksud menyiarkan suatu laporan atau menguatkuasakan apa-apa ketetapan yang diluluskan atau keputusan yang diambil, kerahsiaan pertimbangtelitian dalam semua mesyuarat, prosiding atau siasatan Lembaga, Majlis Peguam Syarie dan Lembaga Tatatertib dan berkenaan dengan semua dokumen berhubung dengan proses pertimbangtelitian hendaklah disimpan dan disenggara oleh anggota Lembaga, Majlis Peguam Syarie, Lembaga Tatatertib dan oleh kakitangan mereka."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_63__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VII__cl_63",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana anggota Lembaga, Majlis Peguam Syarie, Lembaga Tatatertib, dan kakitangan mereka yang terlibat dalam apa-apa pertimbangtelitian yang disebut dalam subseksyen (2) tidak boleh dipaksa untuk menzahirkan kepada mana-mana mahkamah apa-apa maklumat yang berhubungan dengan pertimbangtelitian itu melainkan jika mahkamah menganggap penzahiran itu adalah penting demi kepentingan keadilan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_39__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_39__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_39__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_39__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_39__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_39__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_39__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana Peguam Syarie yang berhasrat untuk menubuhkan firma hendaklah memohon kepada Majlis Peguam Syarie bagi pendaftaran dan kelulusan nama firma."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_39__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_39__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_39__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_39__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_39__subsec_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "Permohonan di bawah subseksyen (1) termasuklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_39__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_39__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "nama firma yang dicadangkan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_39__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_39__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "nama Peguam Syarie dan pekongsi, jika berkenaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_39__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_39__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "alamat utama atau mana-mana alamat lain firma yang dicadangkan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_39__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_39__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "butir-butir lain sebagaimana yang difikirkan perlu oleh Majlis Peguam Syarie."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_39__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_39__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_39__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis Peguam Syarie boleh, setelah menerima permohonan di bawah subseksyen (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_39__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_39__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "mengeluarkan perakuan pendaftaran; dan Persekutuan)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_39__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_39__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "meluluskan nama firma yang dicadangkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_39__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis Peguam Syarie boleh menolak suatu perakuan bagi pendaftaran atas alasan bahawa nama firma yang dicadangkan itu memperdayakan atau mungkin menjadi terkeliru dengan nama firma lain yang telah didaftarkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_39__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana Peguam Syarie yang tidak puas hati dengan keputusan Majlis Peguam Syarie boleh merayu kepada Mahkamah Tinggi Syariah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_39__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana Peguam Syarie yang tidak mematuhi subseksyen (1) hendaklah tertakluk kepada prosiding tatatertib. Daftar nama firma"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_40__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_40__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_40__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_40__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_40",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis Peguam Syarie hendaklah menyimpan dan menyenggara suatu daftar nama firma yang di bawahnya Peguam Syarie menjalankan amalan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_40__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_40",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis Peguam Syarie boleh, atas permintaan seseorang Peguam Syarie atau pekongsinya, mengeluarkan mana-mana nama firma daripada daftar nama firma, jika Majlis Peguam Syarie berpuas hati bahawa tiada seorang pun menjalankan amalan di bawah nama itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_40__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_40",
      "schema:text": {
        "@language": "ms",
        "@value": "Nama firma tidak boleh dipotong daripada daftar nama firma tanpa perakuan daripada Majlis Peguam Syarie. Pemasukan semula nama firma dalam daftar nama firma"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_41",
      "@type": "akn:clause",
      "eli:number": "41",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_41__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_41__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_41__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa permohonan bagi pemasukan semula nama firma dalam daftar nama firma hendaklah dibuat mengikut cara yang ditentukan oleh Majlis Peguam Syarie."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_41__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_VI__cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis Peguam Syarie boleh, jika difikirkan adil dan munasabah, memasukkan semula nama firma yang dipotong dalam daftar nama firma."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_33__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_33__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_33__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_33",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada Akta ini dan mana-mana undang-undang bertulis lain, seseorang Peguam Syarie hendaklah mempunyai hak eksklusif untuk hadir dan berhujah bagi pihak anak guamnya dalam semua mahkamah syariah di Wilayah-Wilayah Persekutuan mengikut undang-undang yang sedang berkuat kuasa di mahkamah syariah itu dan semua Peguam Syarie itu mempunyai hak dan keistimewaan yang sama tanpa perbezaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_33__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_33__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_33__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_33",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada apa-apa jua yang terkandung dalam Bahagian ini boleh menyentuh hak—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_33__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_33__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pegawai syariah, Pendakwa Syarie dan orang berkelayakan lain yang dilantik secara sementara untuk melaksanakan kewajipan pegawai undang-undang atau Pegawai Syariah untuk mewakili Kerajaan dalam mana-mana mahkamah syariah, dengan syarat bahawa seseorang itu beragama Islam; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_33__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_33__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah Bantuan Guaman atau mana-mana orang yang dilantik untuk membantu Ketua Pengarah Bantuan Guaman di bawah seksyen 3 Akta Bantuan Guaman 1971 [Akta 26] yang bertindak dalam melaksanakan kewajipannya. Nama Peguam Syarie dalam Daftar sebelum menjalankan amalan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_34",
      "@type": "akn:clause",
      "eli:number": "34",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang berkelayakan yang telah diterima masuk sebagai seorang Peguam Syarie tidak boleh menjalankan amalan sebagai seorang Peguam Syarie atau melakukan apa-apa tindakan sebagai seorang Peguam Syarie melainkan jika namanya telah didaftarkan dalam Daftar Peguam Syarie di bawah seksyen 24 dan dia mempunyai Perakuan Amalan Tahunan yang sah yang dikeluarkan di bawah seksyen 29. Persekutuan) Orang yang tidak diberi kuasa"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_35",
      "@type": "akn:clause",
      "eli:number": "35",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_35__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_35__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_35__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_35__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_35__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_35__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_35__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_35__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang tidak diberi kuasa yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_35__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_35__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bertindak sebagai seorang Peguam Syarie atau ejen bagi mana-mana pihak kepada prosiding atau atas apa-apa kapasiti, selain sebagai suatu pihak kepada suatu tindakan yang baginya dia sendiri adalah pihak, memulakan, menjalankan, memujuk rayu atau membela apa-apa tindakan, guaman, atau prosiding lain atas nama mana-mana orang lain dalam mana-mana mahkamah syariah atau membuat atau menyediakan apa-apa surat cara yang berhubungan dengan apa-apa prosiding dalam mana-mana mahkamah syariah; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_35__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_35__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan sengaja atau secara palsu menyamar menjadi, atau memakai atau menggunakan apa-apa nama, gelaran, tambahan atau perihalan yang membayangkan bahawa dia berkelayakan atau diberi kuasa dengan sewajarnya untuk bertindak sebagai seorang Peguam Syarie, atau bahawa dia diiktiraf oleh undang-undang sebagai berkelayakan atau diberi kuasa sedemikian, melakukan suatu kesalahan dan boleh, apabila disabitkan, dikenakan denda tidak melebihi lima ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tiga tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_35__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_35__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_35__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_35__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan keluasan subseksyen (1) dan (3), mana-mana orang yang tidak diberi kuasa sama ada secara langsung atau secara tidak langsung—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_35__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_35__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat atau menyediakan apa-apa dokumen atau surat cara yang berhubungan dengan apa-apa harta tak alih atau dengan apa-apa prosiding undang-undang atau apa-apa amanah bagi maksud dan berhubung dengan apa-apa tindakan dan guaman dalam mana-mana mahkamah syariah;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_35__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_35__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mengambil arahan untuk atau membuat atau menyediakan apa-apa dokumen untuk mengasaskan atau menentang suatu pemberian probet atau surat kuasa mentadbir dalam mana-mana Mahkamah Tinggi Syariah; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_35__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_35__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi pihak suatu pihak menuntut atau seorang yang mengatakan dirinya sebagai mempunyai tuntutan atas suatu hak di sisi undang-undang, menulis, menyiarkan atau menghantar suatu surat atau notis yang mengugut hendak mengambil prosiding undang-undang selain suatu surat atau notis menyatakan bahawa perkara itu akan diserahkan kepada seorang Peguam Syarie bagi prosiding undang-undang, melakukan suatu kesalahan di bawah subseksyen ini melainkan jika dia membuktikan bahawa tindakan itu telah dilakukan bukan untuk atau dengan harapan untuk mendapat apa-apa fi, keuntungan atau hadiah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_35__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang tidak diberi kuasa yang melakukan atau memujuk rayu hak untuk melakukan apa-apa tindakan yang lazimnya dalam fungsi atau tanggungjawab seorang Peguam Syarie, termasuk tetapi tidak terhad kepada memberikan nasihat tentang undang-undang Syariah, melainkan jika dia membuktikan bahawa tindakan itu telah dilakukan bukan untuk atau dengan harapan untuk mendapatkan apa-apa fi, keuntungan atau hadiah, melakukan suatu kesalahan di bawah subseksyen ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_35__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang tidak diberi kuasa yang menawarkan perkhidmatan sebagai seseorang Peguam Syarie melakukan suatu kesalahan di bawah subseksyen ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_35__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang disebut di bawah subseksyen (2), (3) dan (4) boleh, apabila disabitkan, dikenakan denda tidak melebihi satu ribu ringgit atau dipenjarakan selama tempoh tidak melebihi sembilan puluh hari atau kedua-duanya bagi kesalahan kali pertama, dan bagi kesalahan kali kedua atau berikutnya, dikenakan denda tidak melebihi tiga ribu ringgit atau dipenjarakan selama tempoh tidak melebihi enam bulan atau kedua-duanya. Orang tertentu boleh bertindak sebagai Peguam Syarie"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_36",
      "@type": "akn:clause",
      "eli:number": "36",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_36__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_36__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_36__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_36__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_36__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_36__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_36__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_36__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_36",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun seksyen 35, orang yang berikut boleh bertindak sebagai seorang Peguam Syarie:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_36__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_36__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Peguam Negara atau Peguam Cara Negara atau mana-mana orang lain yang bertindak di bawah kuasa salah seorang daripada mereka; Persekutuan)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_36__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_36__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah Bantuan Guaman atau mana-mana orang yang dilantik untuk membantu Ketua Pengarah Bantuan Guaman di bawah seksyen 3 Akta Bantuan Guaman 1971 yang bertindak semasa menjalankan kewajipannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_36__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_36__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Pegawai Syariah, Pendakwa Syarie dan Pegawai Undang-Undang Majlis Agama Islam Wilayah Persekutuan yang bertindak semasa menjalankan kewajipan mereka di bawah mana-mana undang-undang yang berhubungan dengan jawatan mereka;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_36__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_36__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang yang bertindak secara sendiri untuk dirinya sahaja dalam apa-apa perkara atau prosiding yang dia menjadi pihak; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_36__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_36__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang yang bertindak bagi pihak orang yang belum dewasa atau orang yang tidak berkeupayaan yang berada di bawah tanggungannya dalam apa-apa perkara atau prosiding yang orang yang belum dewasa atau orang yang tidak berkeupayaan menjadi pihak."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_36__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_36",
      "schema:text": {
        "@language": "ms",
        "@value": "Orang yang disebut dalam subseksyen (1) hendaklah merupakan seorang Islam. Surat cara dan dokumen hendaklah diendors"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_37",
      "@type": "akn:clause",
      "eli:number": "37",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_37__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_37__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_37__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana Peguam Syarie yang membuat atau menyediakan apa-apa surat cara atau dokumen hendaklah mengendors atau menyebabkan supaya diendors pada surat cara atau dokumen itu nama dan alamat firma yang di bawahnya Peguam Syarie itu menjalankan amalan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_37__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana Peguam Syarie yang tidak mengendors atau secara palsu mengendors atau menyebabkan supaya diendors apa-apa surat cara atau dokumen melakukan suatu kesalahan dan boleh, apabila disabitkan, dikenakan denda tidak melebihi lima ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tiga tahun atau kedua-duanya. Kos dan pembayaran kepada orang yang tidak diberi kuasa"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_38__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_38__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_38__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_38",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa kos berkenaan dengan apa-apa yang dilakukan oleh orang yang tidak diberi kuasa sebagai seorang Peguam Syarie atau berkenaan dengan apa-apa tindakan yang menjadi suatu kesalahan di bawah seksyen 35 atau 37 tidak boleh didapatkan semula oleh mana-mana orang dalam apa-apa tindakan, guaman atau perkara."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_38__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_V__cl_38",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa pembayaran kepada seseorang orang yang tidak diberi kuasa bagi apa-apa jua yang dilakukan yang menjadi suatu kesalahan di bawah seksyen 35 atau 37 boleh didapatkan semula di dalam mahkamah yang berbidang kuasa berwibawa oleh orang yang telah membayar wang itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_X",
      "@type": "akn:part",
      "eli:number": "X",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_X__cl_86",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_X__cl_87",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_X__cl_88"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "KUMPULAN WANG TATATERTIB Penubuhan Kumpulan Wang Tatatertib"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_XI",
      "@type": "akn:part",
      "eli:number": "XI",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_XI__cl_89",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_XI__cl_90",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_XI__cl_91",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_XI__cl_92",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_XI__cl_93"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "PELBAGAI Tiada tindakan terhadap Badan Peguam Syarie, Majlis Peguam Syarie, Lembaga Tatatertib, dsb., bagi tindakan yang dilakukan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_XI__cl_89",
      "@type": "akn:clause",
      "eli:number": "89",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_XI",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada apa-apa tindakan atau prosiding boleh dibawa terhadap, Badan Peguam Syarie, Majlis Peguam Syarie, Lembaga Tatatertib atau mana-mana anggotanya bagi apa-apa tindakan atau perkara yang dilakukan di bawah Akta ini atau mana-mana mahkamah melainkan jika dibuktikan bahawa tindakan atau perkara yang dilakukan dengan tidak suci hati atau dengan niat jahat. Kerahsiaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_XI__cl_90",
      "@type": "akn:clause",
      "eli:number": "90",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_XI",
      "schema:text": {
        "@language": "ms",
        "@value": "Perintah, keputusan, ketetapan dan arahan Lembaga Tatatertib, Badan Peguam Syarie dan Majlis Peguam Syarie adalah dianggap rahsia melainkan jika dan setakat yang perlu untuk menzahirkan bagi maksud menguatkuasakan Akta ini. Persekutuan) Peguam Syarie yang dikeluarkan daripada Daftarai Peguam Bela dan Peguam Cara"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_XI__cl_91",
      "@type": "akn:clause",
      "eli:number": "91",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_XI",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana Peguam Syarie yang menjalankan amalan peguam bela dan peguam cara di bawah Akta Profesion Undang-Undang 1976 yang namanya telah dikeluarkan daripada Daftarai Peguam Bela dan Peguam Cara Mahkamah Tinggi yang disimpan oleh Pendaftar Mahkamah Tinggi hendaklah dipotong dengan sewajarnya daripada semua daftar yang disimpan dan disenggara di bawah Akta ini. Kuasa untuk menetapkan fi"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_XI__cl_92",
      "@type": "akn:clause",
      "eli:number": "92",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_XI",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh membuat kaedah-kaedah yang berhubungan dengan fi yang kena dibayar di bawah seksyen 23, 24, 29 dan 31. Kuasa untuk meminda Jadual"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_XI__cl_93",
      "@type": "akn:clause",
      "eli:number": "93",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_XI",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh melalui perintah yang disiarkan dalam Warta meminda Jadual-Jadual kepada Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_X__cl_86",
      "@type": "akn:clause",
      "eli:number": "86",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_X__cl_86__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_X__cl_86__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_X__cl_86__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_X__cl_86",
      "schema:text": {
        "@language": "ms",
        "@value": "Badan Peguam Syarie hendaklah menubuhkan, menyenggara dan mentadbir suatu kumpulan wang yang hendaklah dikenali sebagai Kumpulan Wang Tatatertib."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_X__cl_86__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_X__cl_86",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap Peguam Syarie hendaklah, apabila dia memohon Perakuan Sokongan, membayar kepada Badan Peguam Syarie suatu sumbangan kepada Kumpulan Wang Tatatertib yang jumlahnya boleh ditentukan oleh Majlis Peguam Syarie. Pembayaran kos, dsb., daripada Kumpulan Wang Tatatertib"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_X__cl_87",
      "@type": "akn:clause",
      "eli:number": "87",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_X",
      "schema:text": {
        "@language": "ms",
        "@value": "Segala kos, caj dan perbelanjaan bagi maksud mana-mana prosiding tatatertib di bawah Akta ini hendaklah dibayar daripada Kumpulan Wang Tatatertib itu. Pembayaran denda, dsb., ke dalam Kumpulan Wang Tatatertib"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_X__cl_88",
      "@type": "akn:clause",
      "eli:number": "88",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_X",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa denda, penalti, atau apa-apa bayaran lain yang diperintahkan oleh Lembaga Tatatertib supaya dibayar hendaklah dibayar ke dalam Kumpulan Wang Tatatertib."
      }
    },
    {
