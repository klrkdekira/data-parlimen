      "schema:text": {
        "@language": "ms",
        "@value": "PENERIMAAN MASUK PEGUAM SYARIE Orang berkelayakan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_11__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_11__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III",
      "schema:name": {
        "@language": "ms",
        "@value": "Bagi maksud Bahagian ini, “orang berkelayakan” ertinya mana-mana orang yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_11__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "memiliki apa-apa kelayakan yang ditetapkan oleh Lembaga; atau Persekutuan)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_11__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "merupakan seorang peguam bela dan peguam cara dan mempunyai apa-apa kelayakan tambahan dalam bidang syariah atau kehakiman syarie sebagaimana yang ditetapkan di bawah seksyen 12. Syarat bagi penerimaan masuk"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_12__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_12__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_12__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_12__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_12__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_12__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_12__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_12__subsec_1__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_12__subsec_1__para_h"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang berkelayakan boleh memohon untuk diterima masuk sebagai seorang Peguam Syarie di bawah seksyen 15 jika dia memenuhi syarat yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_12__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_12__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah mencapai umur dua puluh satu tahun;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_12__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_12__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "beragama Islam;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_12__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_12__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "sama ada seorang warganegara atau pemastautin tetap di Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_12__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_12__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "berkelakuan baik;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_12__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_12__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak pernah disabitkan di Malaysia atau di mana-mana tempat lain atas apa-apa kesalahan jenayah;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_12__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_12__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak diisytiharkan sebagai seorang bankrap yang belum dilepaskan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_12__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_12__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah menghadiri dan lulus kursus pengajaran, latihan, pendidikan, temu duga atau peperiksaan yang ditetapkan oleh Lembaga, jika berkenaan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_12__subsec_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_12__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah menjalani tempoh pelatihan sebagaimana yang dikehendaki di bawah seksyen 13;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_12__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_12__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang Peguam Syarie Negeri boleh memohon bagi penerimaan masuk seorang Peguam Syarie di bawah seksyen 15 jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_12__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_12__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dia memenuhi syarat yang disebut dalam perenggan (1) (a) hingga (g); dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_12__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_12__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dia telah melibatkan diri dalam menjalankan amalan secara aktif sebagai seorang Peguam Syarie Negeri di mana-mana Negeri sebelum dia memohon bagi penerimaan masuk. Tempoh pelatihan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_13__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_13__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada subseksyen 14(3), seseorang orang berkelayakan hendaklah, sebelum dia diterima masuk sebagai seorang Peguam Syarie, menjalani suatu tempoh pelatihan selama enam bulan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud subsekyen (1), seseorang pelatih dalam kamar hendaklah menjalani tempoh pelatihannya dengan seorang pengajar yang sedang menjalankan dan telah menjalankan amalan secara aktif di Wilayah-Wilayah Persekutuan selama suatu jumlah tempoh tidak kurang daripada tujuh tahun sebaik sebelum tarikh permulaan pelatihan pelatih dalam kamar itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_13__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pelatih dalam kamar tidak boleh, tanpa kebenaran khas secara bertulis daripada Majlis Peguam Syarie, memegang apa-apa jawatan atau bertugas dalam apa-apa jenis pekerjaan, sama ada sepenuh masa atau selainnya, semasa tempoh pelatihannya, tetapi tiada apa-apa dalam subseksyen ini boleh menghalang seorang pelatih dalam kamar daripada menerima saraan daripada pengajarnya. Pengecualian daripada pelatihan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_14__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_14__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_14__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis Peguam Syarie boleh, atas alasan khas, membenarkan seseorang pelatih dalam kamar menjalani tempoh pelatihannya dengan seorang Peguam Syarie yang menjalankan amalan di Negeri lain atau yang menjalankan amalan kurang daripada tujuh tahun."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis Peguam Syarie boleh membenarkan mana-mana orang berkelayakan untuk menjalani bahagian yang berlainan tempoh pelatihannya dengan pengajar yang berlainan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_14__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis Peguam Syarie boleh mengecualikan mana-mana orang berkelayakan yang telah berkhidmat sebagai seorang pegawai syariah sekurang-kurangnya selama tempoh satu tahun daripada menjalani apa-apa tempoh pelatihan di bawah seksyen 13. Persekutuan)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_14__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud subseksyen (3), pegawai syariah itu hendaklah mengemukakan kepada Majlis Peguam Syarie suatu perakuan daripada Ketua Pengarah Jabatan Kehakiman Syariah Malaysia atau ketua perkhidmatan masing-masing, mengikut mana-mana yang berkenaan, yang menyatakan tempoh perkhidmatannya sebagai seorang pegawai syariah. Permohonan bagi penerimaan masuk"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_15__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_15__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_15__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_15__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu permohonan bagi penerimaan masuk sebagai seorang Peguam Syarie oleh seorang orang berkelayakan atau seorang Peguam Syarie Negeri hendaklah dibuat kepada Mahkamah Tinggi Syariah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_15__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_15__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Permohonan di bawah subseksyen (1) hendaklah disokong oleh afidavit yang melampirkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_15__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_15__subsec_2__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_15__subsec_2__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_15__subsec_2__para_a__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_15__subsec_2__para_a__subpara_iv",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_15__subsec_2__para_a__subpara_v"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_15__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perkara permohonan oleh seseorang orang berkelayakan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_15__subsec_2__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_15__subsec_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "salinan diperakui apa-apa keterangan dokumentar yang menunjukkan bahawa dia merupakan seorang orang berkelayakan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_15__subsec_2__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_15__subsec_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dua perakuan terkini mengenai kelakuan baiknya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_15__subsec_2__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_15__subsec_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu perakuan ketekunan daripada pengajar yang dengannya pemohon itu menjalani pelatihannya dalam hal jika dia dikehendaki untuk menjalani suatu tempoh pelatihan, atau jika perakuan itu tiada apa-apa keterangan lain yang dikehendaki oleh Mahkamah Tinggi Syariah yang menunjukkan bahawa dia telah menjalani pelatihan itu dengan tekun;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_15__subsec_2__para_a__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_15__subsec_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "jika terpakai, suatu perakuan yang ditandatangani oleh Setiausaha Lembaga bahawa pemohon telah menghadiri kursus pengajaran, latihan, pendidikan, temu duga atau peperiksaan yang ditetapkan oleh Lembaga; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_15__subsec_2__para_a__subpara_v",
      "@type": "akn:subparagraph",
      "eli:number": "v",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_15__subsec_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "salinan diperakui apa-apa keterangan dokumen yang menunjukkan bahawa pemohon telah mencapai umur dua puluh satu tahun, beragama Islam dan merupakan sama ada seorang warganegara atau seorang pemastautin tetap Malaysia; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_15__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_15__subsec_2__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_15__subsec_2__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_15__subsec_2__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_15__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perkara permohonan oleh seseorang Peguam Syarie Negeri—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_15__subsec_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_15__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu salinan diperakui perintah mahkamah syariah atau salinan perakuan amalan bagi Negeri yang menerimanya masuk sebagai seorang Peguam Syarie;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_15__subsec_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_15__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu salinan diperakui pengesahan yang diberikan oleh seorang Peguam Syarie yang telah menjalankan amalan di Negeri itu sekurang-kurangnya lima tahun, bahawa pada pengetahuannya, pemohon telah melibatkan diri dalam menjalankan amalan secara aktif sebagai seorang Peguam Syarie di mana-mana Negeri sebelum dia memohon bagi penerimaan masuk; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_15__subsec_2__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_15__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu salinan diperakui pengesahan yang diberikan oleh setiausaha atau pegawai lain bagi Jabatan yang dipertanggungkan dengan tanggungjawab mengenai kelakuan dan tatatertib seseorang Peguam Syarie di Negeri itu, bahawa pemohon itu tidak pernah disabitkan dengan apa-apa kesalahan tatatertib."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_15__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Permohonan, afidavit, pengesahan, apa-apa dokumen dan keterangan yang dinyatakan dalam seksyen ini hendaklah mengikut cara yang ditentukan oleh Mahkamah Tinggi Syariah. Memfailkan salinan permohonan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_16__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_16__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_16__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pemohon hendaklah memfailkan salinan permohonannya bagi penerimaan masuk sebagai seorang Peguam Syarie di bawah seksyen 15 di Pejabat Ketua Pendaftar yang disertakan dengan suatu notis yang menyatakan butir-butir permohonannya dalam tempoh tidak kurang daripada tiga puluh hari sebelum tarikh yang ditetapkan bagi pendengaran permohonan bagi penerimaan masuk atau apa-apa tempoh yang lebih singkat yang diarahkan oleh Mahkamah Tinggi Syariah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pendaftar hendaklah menyebabkan ditampal notis yang disebut dalam subseksyen (1) di Mahkamah Tinggi Syariah di Wilayah-Wilayah Persekutuan Kuala Lumpur, Labuan dan Putrajaya selama tiga puluh hari sebelum pendengaran pemohonan penerimaan masuk pemohon itu. Persekutuan) Penyampaian salinan permohonan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Pemohon hendaklah menyampaikan suatu salinan permohonannya bagi penerimaan masuk sebagai seorang Peguam Syarie di bawah seksyen 15 kepada Lembaga, Ketua Pendakwa Syarie dan Majlis Peguam Syarie dalam tempoh tidak kurang daripada tiga puluh hari sebelum tarikh yang ditetapkan untuk pendengaran permohonan bagi penerimaan masuk atau apa-apa tempoh yang lebih singkat yang diarahkan oleh Mahkamah Tinggi Syariah. Siasatan ke atas perilaku pemohon"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_18__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_18__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_18__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis Peguam Syarie hendaklah, apabila menerima sesalinan permohonan daripada pemohon, membuat atau menyebabkan dibuat suatu siasatan penuh ke atas perilaku pemohon dan, apabila permohonan itu ditetapkan untuk pendengaran, mengemukakan kepada Ketua Pendaftar suatu laporan sulit hasil siasatan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Sekiranya apa-apa laporan itu tidak memihak kepada pemohon, Ketua Pendaftar hendaklah mengemukakan laporan sulit itu kepada Ketua Hakim Syarie dan Ketua Hakim Syarie boleh, jika difikirkannya patut dan munasabah, mengarahkan supaya laporan itu difailkan di Mahkamah Tinggi Syariah dan sesalinan laporan itu disampaikan kepada pemohon dan, tertakluk kepada apa-apa arahan yang boleh diberikan oleh Mahkamah Tinggi Syariah, laporan itu hendaklah diambil kira semasa pendengaran permohonan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_18__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua laporan dan komunikasi di bawah seksyen ini hendaklah dianggap sebagai rahsia. Bantahan permohonan oleh Ketua Pendakwa Syarie atau Majlis Peguam Syarie"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_19__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_19__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_19__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_19__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_19__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pendakwa Syarie atau Majlis Peguam Syarie boleh, apabila menerima sesalinan permohonan bagi penerimaan masuk sebagai seorang Peguam Syarie daripada pemohon, membantah permohonan itu dengan menfailkan notis bantahan yang hendaklah menyatakan secara ringkas alasan bantahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_19__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Notis bantahan itu hendaklah difailkan di Pejabat Ketua Pendaftar dan disampaikan kepada pemohon dalam tempoh tidak kurang daripada tiga hari atau dalam tempoh yang lebih singkat sebagaimana diarahkan oleh Mahkamah Tinggi Syariah sebelum tarikh yang ditetapkan bagi pendengaran permohonan bagi penerimaan masuk itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_19__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_19__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_19__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendengaran bagi notis bantahan itu hendaklah didengar—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_19__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_19__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam prosiding yang sama dengan, dan di hadapan Hakim Mahkamah Tinggi Syariah yang sama bagi, pendengaran permohonan bagi penerimaan masuk sebagai Peguam Syarie; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_19__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_19__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan kehadiran wakil Ketua Pendakwa Syarie dan Majlis Peguam Syarie."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_19__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun perenggan (3)(b), pendengaran notis bantahan boleh diteruskan tanpa kehadiran wakil Ketua Pendakwa Syarie dan Majlis Peguam Syarie jika Mahkamah Tinggi Syariah berpuas hati bahawa pemohon telah menyampaikan kepada Ketua Pendakwa Syarie dan Majlis Peguam Syarie salinan permohonannya bagi penerimaan masuk sebagai seorang Peguam Syarie. Bantahan permohonan oleh orang lain"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_20__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_20__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_20__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_20__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_20__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_20__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_20__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang selain Ketua Pendakwa Syarie atau Majlis Peguam Syarie boleh memasukkan suatu bantahan untuk membantah permohonan bagi penerimaan masuk sebagai seorang Peguam Syarie yang difailkan di bawah seksyen 15."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_20__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Bantahan di bawah subseksyen (1) hendaklah difailkan di Pejabat Ketua Pendaftar dan hendaklah mengandungi nama penuh, pekerjaan dan alamat orang yang membantah permohonan penerimaan masuk, suatu pernyataan ringkas tentang alasan bantahannya serta alamat bagi penyampaian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_20__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila bantahan itu difailkan, permohonan bagi penerimaan masuk tidak boleh didengar melainkan jika suatu notis pendengaran tidak kurang daripada tiga hari telah disampaikan kepada orang yang membantah permohonan bagi penerimaan masuk itu. Persekutuan)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_20__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Orang yang membantah permohonan bagi penerimaan masuk itu boleh hadir dalam pendengaran permohonan bagi penerimaan masuk sebagai seorang Peguam Syarie itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_20__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendengaran permohonan bagi penerimaan masuk sebagai seorang Peguam Syarie boleh didengar tanpa kehadiran orang yang membantah permohonan bagi penerimaan masuk sebagai seorang Peguam Syarie itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_20__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendengaran bagi bantahan itu hendaklah didengar dalam prosiding yang sama dengan, dan di hadapan Hakim Mahkamah Tinggi Syariah yang sama bagi, pendengaran permohonan bagi penerimaan masuk sebagai seorang Peguam Syarie. Penerimaan masuk sebagai Peguam Syarie"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Mahkamah Tinggi Syariah boleh, setelah mempertimbangkan permohonan di bawah seksyen 15, laporan siasatan di bawah seksyen 18 dan bantahan di bawah seksyen 19 atau 20, menerima masuk pemohon sebagai seorang Peguam Syarie atau sebaliknya. Hak merayu"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang terkilan dengan keputusan Mahkamah Tinggi Syariah di bawah seksyen 21 boleh, dalam masa tiga puluh hari dari tarikh keputusan, merayu kepada Mahkamah Rayuan Syariah. Pengeluaran Perakuan Peguam Syarie"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pendaftar hendaklah, setelah dibayar fi yang ditetapkan, mengeluarkan kepada pemohon yang telah diterima masuk sebagai Peguam Syarie di bawah Akta ini, suatu Perakuan Peguam Syarie mengikut cara yang ditentukan oleh Ketua Pendaftar. Daftar Daftar Peguam Syarie"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_24__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_24__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_24__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_24__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_24__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pendaftar hendaklah menyimpan dan menyenggara suatu Daftar Peguam Syarie."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_24__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Nama dan tarikh penerimaan masuk sebagai seorang Peguam Syarie hendaklah dicatatkan dalam Daftar mengikut susunan tarikh penerimaan masuk."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_24__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Daftar hendaklah terbuka bagi pemeriksaan oleh mana- mana orang tanpa bayaran."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_24__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (3), apa-apa permohonan bagi suatu cabutan atau salinan daripada Daftar hendaklah tertakluk kepada fi yang ditetapkan. Pengeluaran nama Peguam Syarie daripada Daftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_25__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_25__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_25__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Sekiranya pada bila-bila masa selepas penerimaan masuk seorang Peguam Syarie, terdapat bukti yang memuaskan Mahkamah Tinggi Syariah bahawa afidavit, pengesahan atau dokumen lain yang telah difailkan oleh Peguam Syarie itu mengandungi pernyataan palsu atau mengelirukan dalam bahagian isinya atau menyembunyikan apa-apa fakta material, nama Peguam Syarie itu boleh dikeluarkan daripada Daftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_25__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Sekiranya nama seseorang Peguam Syarie telah dikeluarkan daripada Daftar di bawah subseksyen (1), Ketua Pendaftar hendaklah, apabila apa-apa permohonan untuk diterima semula sebagai Peguam Syarie dibuat, membawa fakta itu kepada pengetahuan Mahkamah Tinggi Syariah dan Mahkamah Tinggi Syariah itu hendaklah, jika tiada hal keadaan yang khas, menolak permohonan itu. Peguam Syarie boleh memohon supaya namanya dikeluarkan daripada Daftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_26__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_26__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_26__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_26__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_26__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_26__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana Peguam Syarie boleh memohon kepada Mahkamah Tinggi Syariah supaya namanya dikeluarkan daripada Daftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_26__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Permohonan di bawah subseksyen (1) hendaklah disokong dengan afidavit yang menyatakan sebab bagi pengeluaran namanya daripada Daftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_26__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Peguam Syarie itu hendaklah menyampaikan permohonannya untuk mengeluarkan namanya di bawah subseksyen (1) kepada Majlis Peguam Syarie dalam tempoh tidak kurang daripada empat belas hari sebelum permohonan itu didengar. Persekutuan)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_26__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Permohonan di bawah subseksyen (1) hendaklah didengar oleh seorang Hakim Mahkamah Tinggi Syariah yang bersidang di dalam kamar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_26__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_26__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_26__subsec_5__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_26__subsec_5__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_26__subsec_5__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Setelah mempertimbangkan permohonan di bawah subseksyen (1), Hakim Mahkamah Tinggi Syariah boleh membuat perintah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_26__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_26__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "mengarahkan Ketua Pendaftar untuk memotong nama Peguam Syarie itu daripada Daftar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_26__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_26__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "menangguhkan pendengaran itu kepada suatu tarikh yang difikirkan adil dan munasabah oleh Hakim Mahkamah Tinggi Syariah itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_26__subsec_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_26__subsec_5__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_26__subsec_5__para_c__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_26__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "menolak permohonan itu jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_26__subsec_5__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_26__subsec_5__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu tindakan tatatertib belum selesai terhadap Peguam Syarie itu di bawah Bahagian IX Akta ini; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_26__subsec_5__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_26__subsec_5__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "kelakuan Peguam Syarie itu merupakan perkara yang disiasat di bawah Bahagian IX Akta ini; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_26__subsec_5__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_26__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi pembayaran apa-apa kos. Pemasukan semula nama Peguam Syarie dalam Daftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_27__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_27__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_27__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_27__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_27__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_27__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_27__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_27__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang namanya telah dikeluarkan atau dipotong daripada Daftar boleh memohon kepada Mahkamah Tinggi Syariah bagi pemasukan semula namanya dalam Daftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_27__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "Permohonan di bawah subseksyen (1) hendaklah disokong dengan afidavit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_27__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "Pemohon hendaklah menyampaikan salinan permohonan di bawah subseksyen (1) itu kepada Majlis Peguam Syarie dalam masa empat belas hari sebelum pendengaran permohonan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_27__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis Peguam Syarie hendaklah, apabila menerima salinan permohonan itu, menyediakan suatu laporan yang termasuklah salinan rekod apa-apa prosiding yang kesan daripadanya nama pemohon itu dikeluarkan atau dipotong daripada Daftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_27__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis Peguam Syarie hendaklah diwakili semasa pendengaran permohonan bagi pemasukan semula itu dan mengemukakan laporan yang disediakan di bawah subseksyen (4) kepada Mahkamah Tinggi Syariah sebelum pendengaran permohonan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_27__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "Mahkamah Tinggi Syariah boleh, jika difikirkannya adil dan munasabah, memerintahkan Ketua Pendaftar untuk memasukkan semula nama pemohon dalam Daftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_27__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_III__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang terkilan dengan keputusan Mahkamah Tinggi Syariah boleh merayu kepada Mahkamah Rayuan Syariah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga boleh mengecualikan mana-mana orang atau kumpulan orang yang berhasrat untuk memohon bagi penerimaan masuk sebagai seorang Peguam Syarie daripada menjalani kursus pengajaran, latihan, pendidikan, temu duga dan peperiksaan tertakluk kepada apa-apa syarat yang difikirkan sesuai oleh Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu badan yang dinamakan sebagai Lembaga Kelayakan Profesion Guaman Syarie ditubuhkan. Fungsi Lembaga"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga hendaklah mempunyai fungsi yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menentukan kelayakan orang yang berhasrat untuk memohon bagi penerimaan masuk sebagai seorang Peguam Syarie; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_4__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_4__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengadakan peruntukan bagi—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_4__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_4__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "kursus pengajaran, latihan, pendidikan, temu duga dan peperiksaan oleh Lembaga bagi orang yang berhasrat untuk memohon supaya diterima masuk sebagai seorang Peguam Syarie; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_4__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_4__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "kursus pengajaran, latihan dan pembangunan profesional yang berterusan Peguam Syarie. Persekutuan) Kuasa Lembaga"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_5__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga boleh melakukan segala benda yang perlu atau suai manfaat bagi, atau berkaitan dengan, pelaksanaan fungsinya di bawah Bahagian ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_5__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_5__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_5__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_5__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_5__subsec_2__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan keluasan subseksyen (1), Lembaga boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_5__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "melantik apa-apa jawatankuasa yang difikirkan perlu dan suai manfaat untuk membantu Lembaga dalam pelaksanaan fungsinya dan dalam penjalanan kuasanya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_5__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "membayar elaun dan perbelanjaan lain anggota Lembaga atau jawatankuasanya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_5__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "melantik mana-mana pensyarah atau pemeriksa bagi maksud menyediakan kursus pengajaran, latihan, pendidikan temu duga dan peperiksaan di bawah perenggan 4(b);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_5__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "membayar elaun dan faedah lain kepada pensyarah dan pemeriksa yang dilantik di bawah perenggan (c); dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_5__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mengenakan apa-apa fi atau caj lain sebagaimana yang ditetapkan oleh Lembaga dalam pelaksanaan fungsinya dan penjalanan kuasanya. Keanggotaan Lembaga"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_6__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_6__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_6__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_6__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_6__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_6__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_6__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_6__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_6__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_6__subsec_1__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga hendaklah terdiri daripada anggota yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_6__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Hakim Syarie yang hendaklah menjadi Pengerusi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_6__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi Majlis Peguam Syarie yang hendaklah menjadi Timbalan Pengerusi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_6__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "wakil Jabatan Peguam Negara yang hendaklah beragama Islam;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_6__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pendakwa Syarie;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/18/msa@/~part_II__cl_6__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
