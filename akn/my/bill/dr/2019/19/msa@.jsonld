      "schema:name": {
        "@language": "ms",
        "@value": "RUU Pentadbiran Undang-Undang Islam (Wilayah-Wilayah Persekutuan) (Pindaan) (No.2) 2019"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/19/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/19/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/19/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/19/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/19/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/19/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Pentadbiran Undang-Undang Islam (Wilayah-Wilayah Persekutuan) (Pindaan) (No. 2) 2019."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/19/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/19/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Yang di-Pertuan Agong melalui pemberitahuan dalam Warta. Pindaan seksyen 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/19/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/19/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Pentadbiran Undang-Undang Islam (Wilayah-Wilayah Persekutuan) 1993 [Akta 505], yang disebut “Akta ibu” dalam Akta ini, dipinda dalam seksyen 2 dengan memotong takrif “Peguam Syarie”. Pemotongan seksyen 59"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/19/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/19/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memotong seksyen 59. Kecualian dan peralihan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/19/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/19/msa@/~cl_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/19/msa@/~cl_4__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/19/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/19/msa@/~cl_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/19/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa permohonan oleh mana-mana orang bagi penerimaan sebagai Peguam Syarie, atau bantahan mengenai permohonan itu atau penerimaan sebagai Peguam Syarie, atau rayuan terhadap keputusan yang berhubungan dengan permohonan bagi penerimaan itu, atau prosiding tatatertib yang berhubungan dengan Peguam Syarie, yang belum selesai sebelum mula berkuat kuasanya Akta ini hendaklah diuruskan di bawah Akta ibu seolah-olah Akta ibu tidak dipinda."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/19/msa@/~cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/19/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Pada tarikh permulaan kuat kuasa Akta ini, apa-apa Sijil Peguam Syarie yang dikeluarkan di bawah Akta ibu sebelum mula berkuat kuasanya Akta ini dan masih sah, dan apa-apa Sijil Peguam Syarie yang dikeluarkan bagi maksud subseksyen (1), adalah tertakluk kepada Akta Profesion Guaman Syarie (Wilayah-Wilayah Persekutuan) 2019 [Akta ]."
      }
    }
  ]
}
