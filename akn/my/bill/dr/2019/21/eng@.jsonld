    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/21/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/21/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Constitution (Amendment) Act 2019."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/21/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/21/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "Section 3 of this Act comes into operation on a date to be appointed by the Yang di-Pertuan Agong by notification in the Gazette. Amendment of Article 47"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/21/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/21/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The Federal Constitution is amended in Article 47, in paragraph (b),"
      },
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words “twenty-one years” the words “eighteen years”. Amendment of Article 119"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/21/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/21/eng@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/21/eng@/~cl_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/21/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Article 119 of the Federal Constitution is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/21/eng@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/21/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "in Clause (1), in paragraph (a), by substituting for the words “twenty-one years” the words “eighteen years”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/21/eng@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/21/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "in Clause (4), in paragraph (b), by substituting for the words “applies for registration” the words “is registered”. Amendment of Eighth Schedule"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/21/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/21/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Eighth Schedule to the Federal Constitution is amended in section 5 by substituting for the words “twenty-one years” the words “eighteen years”."
      }
    }
  ]
