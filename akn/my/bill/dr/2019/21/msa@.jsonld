      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/21/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Perlembagaan (Pindaan) 2019."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/21/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/21/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 3 Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Yang di-Pertuan Agong melalui pemberitahuan dalam Warta. Pindaan Perkara 47"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/21/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/21/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Perlembagaan Persekutuan dipinda dalam Perkara 47, dalam perenggan (b), dengan menggantikan perkataan “dua puluh satu tahun” dengan perkataan “lapan belas tahun”. Pindaan Perkara 119"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/21/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/21/msa@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/21/msa@/~cl_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/21/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Perkara 119 Perlembagaan Persekutuan dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/21/msa@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/21/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam Fasal (1), dalam perenggan (a), dengan menggantikan perkataan “dua puluh satu tahun” dengan perkataan “lapan belas tahun”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/21/msa@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/21/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam Fasal (4), dalam perenggan (b), dengan menggantikan perkataan “memohon supaya didaftarkan” dengan perkataan “didaftarkan”. Pindaan Jadual Kelapan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/21/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/21/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Jadual Kelapan kepada Perlembagaan Persekutuan dipinda dalam seksyen 5 dengan menggantikan perkataan “dua puluh satu tahun” dengan perkataan “lapan belas tahun”."
      }
    }
  ]
