      "schema:name": {
        "@language": "ms",
        "@value": "RUU Penyemakan Undang-Undang (Pindaan) 2019"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/22/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/22/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/22/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/22/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/22/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/22/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Penyemakan Undang-Undang (Pindaan) 2019."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/22/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/22/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada 1 Ogos 2019. Pindaan seksyen 6"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/22/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/22/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Penyemakan Undang-Undang 1968 [Akta 1], yang disebut “Akta ibu” dalam Akta ini, dipinda dalam seksyen 6, dengan memasukkan selepas perenggan (1)(xvii) perenggan yang berikut: “(xviia) untuk membuat apa-apa perubahan dalam mana-mana undang-undang bertulis untuk menunjukkan apa-apa pertukaran nama jawatan, atau pemindahan apa-apa fungsi atau tanggungjawab, mana-mana Menteri, atau pertukaran nama mana-mana Kementerian;”. Pindaan seksyen 14"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/22/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/22/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 14(2) Akta ibu dipinda dengan memasukkan selepas perkataan “(xvii),” perkataan “(xviia),”. Permulaan kuat kuasa pertukaran atau pemindahan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/22/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/22/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa pertukaran nama jawatan, atau pemindahan apa-apa fungsi atau tanggungjawab, mana-mana Menteri, atau pertukaran nama mana-mana Kementerian, hendaklah mula berkuat kuasa pada tarikh pertukaran nama jawatan, atau pemindahan apa-apa fungsi atau tanggungjawab, mana-mana Menteri, atau pertukaran nama mana-mana Kementerian itu, mengikut mana-mana yang berkenaan."
      }
    }
  ]
}
