      "schema:text": {
        "@language": "en",
        "@value": "NATIONAL ANTI-FINANCIAL CRIME CENTRE Establishment of the National Anti-Financial Crime Centre"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III",
