        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_9"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "ADVISORY BOARD Advisory Board"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_5__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_5__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_5__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_5__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_5__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_5__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "An Advisory Board is established for the purpose of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_5__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_5__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_5__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The Advisory Board shall consist of the following members:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_5__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "a Chairman;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_5__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Director General; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_5__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "not more than five other members as appointed by the Yang di-Pertuan Agong, on the advice of the Prime Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_5__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The Yang di-Pertuan Agong shall, on the advice of the Prime Minister, appoint the Chairman of the Advisory Board on such terms and conditions as may be specified in the instrument of appointment."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_5__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The Chairman of the Advisory Board shall hold office for a term not exceeding three years after which he shall be eligible to be reappointed upon the expiry of his term of office."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_5__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The other members of the Advisory Board appointed under paragraph (2)(c) shall hold office for a term not exceeding three years after which they shall be eligible to be reappointed upon the expiry of their term of office."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_5__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_5__subsec_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_5__subsec_6__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_5__subsec_6__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "In advising the Yang di-Pertuan Agong on the appointment of the Chairman of the Advisory Board and the other members under paragraph (2)(c), the Prime Minister shall have regard to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_5__subsec_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_5__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "the person’s probity and standing;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_5__subsec_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_5__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "the academic qualifications, knowledge, skill and experience of the person in banking, economic, finance, asset management, taxation, prosecution, investigation, law or other matters as the Prime Minister deems fit; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_5__subsec_6__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_5__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "the likelihood of any conflict between the interest of the National Anti-Financial Crime Centre and any interest which that person has or represents."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_5__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The Advisory Board shall determine its own meeting procedure. Revocation and resignation of members of the Advisory Board"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_6__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The appointment of the Chairman of the Advisory Board and the other members appointed under paragraph 5(2)(c) may, at any time, be revoked by the Yang di-Pertuan Agong on the advice of the Prime Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The Chairman of the Advisory Board and the other members appointed under paragraph 5(2)(c) may, at any time, resign their office by giving a written notice addressed to the Yang di-Pertuan Agong. Vacation of office"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_7__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_7__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_7__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III",
      "schema:name": {
        "@language": "en",
        "@value": "The office of a member of the Advisory Board shall be vacated if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "he has been convicted of a criminal offence involving dishonesty or of any criminal offence for which he has been sentenced to imprisonment;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "he becomes a bankrupt;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_7__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "he becomes involved in any activity which may interfere with his independence in discharging his duties; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_7__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "he is of unsound mind or is otherwise incapable of discharging his duties. Disclosure of interest"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_8__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_8__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_8__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "A member of the Advisory Board who has or acquires a direct or indirect interest by himself, through a member of his family or his associate in relation to any matter under discussion by the Advisory Board, shall disclose to the Advisory Board, the fact of his interest and the nature of that interest."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_8__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_8__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "A disclosure under subsection (1) shall be recorded in the minutes of the meeting of the Advisory Board, in which the matter is discussed and, after the disclosure, the member—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_8__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_8__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "shall not be present or take part in any discussion or decision of the Advisory Board, about the matter; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_8__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_8__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "shall be disregarded for the purpose of constituting a quorum of the Advisory Board, when the matter is discussed or decided upon."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_8__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "A member of the Advisory Board who fails to disclose his interest as provided under subsection (1) commits an offence and shall, on conviction, be liable to a fine not exceeding five hundred thousand ringgit or to imprisonment for a term not exceeding five years or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_8__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "No act or decision of the Advisory Board shall be rendered invalid on the ground of the contravention by a member under subsection (3). Functions of the Advisory Board"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_9__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_9__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_9__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_9__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "The Advisory Board shall have the following functions:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_9__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "to advise the Prime Minister on any aspect relating to financial crime;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_9__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "to advise the National Anti-Financial Crime Centre on its strategic direction and plan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_9__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "to deliberate and decide on the recommendation made by the Executive Committee on any matter relating to financial crime; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_9__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_III__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "to facilitate the cooperation between the National Anti-Financial Crime Centre, the Government Entities and enforcement agencies for the prevention of financial crime."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_II__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "A centre by the name of the “National Anti-Financial Crime Centre” is established. Functions of the National Anti-Financial Crime Centre"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_II__cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_II__cl_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_II__cl_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "The National Anti-Financial Crime Centre shall have the following functions:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_II__cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "to coordinate and collaborate in integrated operation with the enforcement agencies in matters relating to financial crime and to advise the enforcement agencies in related matters;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_II__cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "to establish, administer and maintain a centralized data system relating to financial crime, in order to provide support for the integrated operation and to transmit information in the centralized data system to other Government Agency or enforcement agencies; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_II__cl_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "to carry out activities relating to the prevention of financial crime."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV__cl_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV__cl_11"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "EXECUTIVE COMMITTEE Executive Committee"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV__cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV__cl_10__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV__cl_10__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV__cl_10__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV__cl_10__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "A committee to be known as the Executive Committee is established for the purpose of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV__cl_10__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV__cl_10__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV__cl_10__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV__cl_10__subsec_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The Executive Committee shall consist of the following members:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV__cl_10__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV__cl_10__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Director General as Chairman;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV__cl_10__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV__cl_10__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Deputy Director General as Deputy Chairman;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV__cl_10__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV__cl_10__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Public Prosecutor or his representative; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV__cl_10__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV__cl_10__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "any director of investigation or director of investigation of money laundering from an enforcement agency, or other officer of the similar position for any other Government Entity as appointed by the Director General."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV__cl_10__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The appointment made under paragraph (2)(d) by the Director General shall be on such terms and conditions as may be specified in the instrument of appointment."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV__cl_10__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The Executive Committee shall determine its own meeting procedure."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV__cl_10__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The Executive Committee may invite any person to attend its meetings to advise the Executive Committee on any matter. Functions of the Executive Committee"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV__cl_11__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV__cl_11__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV__cl_11__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV__cl_11__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV__cl_11__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV__cl_11__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV__cl_11__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "The Executive Committee shall have the following functions:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV__cl_11__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "to determine the direction of National Anti-Financial Crime Centre in preventing financial crimes;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV__cl_11__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "to approve and monitor any integrated operation;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV__cl_11__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "to make recommendations to the Advisory Board on matters relating to the prevention of financial crime;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV__cl_11__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "to determine the operational policies relating to integrated operation and the centralized data system and to provide consultation on the guidelines for the National Anti-Financial Crime Centre;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV__cl_11__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "to develop the strategic direction and plan of the National Anti-Financial Crime Centre;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV__cl_11__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "to ensure the implementation of the advice of the Advisory Board; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV__cl_11__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_IV__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "to execute any other function that is necessary or expedient to give full effect to or for carrying out the provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_I__cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the National Anti-Financial Crime Centre Act 2019."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette, and the Minister may appoint different dates for the coming into operation of different provisions of this Act. Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_I",
      "schema:name": {
        "@language": "en",
        "@value": "In this Act, unless the context otherwise requires—"
      },
      "schema:text": {
        "@language": "en",
        "@value": "“enforcement agency” includes any department of any ministry, body or agency that is for the time being conferred with enforcement powers under any written laws relating to financial crime; “document” has the same meaning assigned to it under the Evidence Act 1950 [Act 56]; “Government Entity” includes any ministry, department, office, agency, authority, commission, committee, board, council or other body, corporate or unincorporated, of the Federal Government, whether established under written law or otherwise; “Executive Committee” means the Executive Committee established under subsection 10(1); “financial crime” means the offences listed in the Schedule; “Director General” and “Deputy Director General” means the Director General and Deputy Director General of the National Anti-Financial Crime Centre appointed under subsections 12(1) and (2) respectively; “Advisory Board” means the Advisory Board established under subsection 5(1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_V",
      "@type": "akn:part",
      "eli:number": "V",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_V__cl_12",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_V__cl_13"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "APPOINTMENTS OF DIRECTOR GENERAL, DEPUTY DIRECTOR GENERAL AND OTHER OFFICERS OF THE NATIONAL ANTI-FINANCIAL CRIME CENTRE Appointment of Director General and Deputy Director General"
      }
    },
