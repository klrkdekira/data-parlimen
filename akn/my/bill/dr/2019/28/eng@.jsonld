      "schema:text": {
        "@language": "en",
        "@value": "INTEGRATED OPERATION AND CENTRALIZED DATA SYSTEM Integrated operation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII",
      "@type": "akn:part",
      "eli:number": "VII",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_17",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_18",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_19",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_20",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_21",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_22",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_23",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_24",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_25"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "GENERAL Prosecution"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "No prosecution for an offence under this Act shall be instituted except by, or with the written consent of, the Public Prosecutor. Obligation of secrecy"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_18__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_18__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_18__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_18__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "Except for the purposes of this Act or for the purposes of any civil or criminal proceedings under any written law or where otherwise authorized by the Director General—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_18__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_18__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "no officer of the National Anti-Financial Crime Centre or members of the Advisory Board or Executive Committee, whether during or after his tenure of office or employment, shall disclose any information obtained by him in the course of his duties; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_18__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_18__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "no other person who has, by any means, access to any information or document relating to the affairs of the National Anti-Financial Crime Centre shall disclose such information or document."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) commits an offence and shall, on conviction, be liable to imprisonment for a term not exceeding two years or to a fine not exceeding one hundred thousand ringgit or to both. Protection against suits and legal proceedings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "No action, suit, prosecution or any other proceedings shall lie or be brought, instituted or maintained in any court against the National Anti-Financial Crime Centre, the Advisory Board, the Executive Committee, any officer of the National Anti-Financial Crime Centre, or any person lawfully acting in compliance with any direction, instruction or order of the Director General or officer of the National Anti-Financial Crime Centre, in respect of any act, neglect or default done or omitted by it or him in good faith, in such capacity. Power to issue guidelines"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General may, upon consultation with the Executive Committee, issue guidelines on any matter relating to the functions of the National Anti-Financial Crime Centre. Power to amend Schedule"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, by order published in the Gazette, amend the Schedule to this Act. Service of notices"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_22__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_22__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_22__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_22__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_22__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_22__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "Every notice or other document required by this Act to be served on any person may be served—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_22__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_22__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "personally on that person;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_22__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_22__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "by sending such notice or other document to that person by registered post; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_22__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_22__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "by electronic means."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_22__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_22__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_22__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "A notice or other document sent by registered post to a person shall be deemed to have been served on that person at the time at which it would have been delivered to that person in the ordinary course of the post if such notice or other document was addressed—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_22__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_22__subsec_2__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_22__subsec_2__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_22__subsec_2__para_a__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_22__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of a company, limited liability partnership, firm, society, an association or other body of persons—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_22__subsec_2__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_22__subsec_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "to its registered office;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_22__subsec_2__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_22__subsec_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "to its last known address; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_22__subsec_2__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_22__subsec_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "to any person authorized by it to accept service of process; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_22__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_22__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of an individual, to his last known address. Public servant"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "Every officer of the National Anti-Financial Crime Centre, or member of the Advisory Board or Executive Committee, or officer of any Government Entity or enforcement agency, while discharging his duty or performing his functions under this Act in such capacity shall be deemed to be a public servant within the meaning of the Penal Code [Act 574]. Public Authorities Protection Act 1948"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "The Public Authorities Protection Act 1948 [Act 198] shall apply to any action, suit, prosecution or proceedings against the National Anti-Financial Crime Centre, the Advisory Board, the Executive Committee or any officer of the National Anti-Financial Crime Centre, in respect of any act, neglect or default done or committed by it or him in good faith or any omission by it or him in good faith, in such capacity. Things done in anticipation of the enactment of this Act"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "All things done by any person on behalf of the National Anti-Financial Crime Centre in the preparation of and towards the proper implementation of any of the provisions of this Act and any expenditure incurred in relation thereto, in anticipation of the enactment of this Act, shall be deemed to have been authorized by this Act, and all rights and obligations acquired or incurred on behalf of the National Anti-Financial Crime Centre from anything so done or any expenditure so incurred shall upon the coming into force of this Act be deemed to be the rights and obligations of the National Anti-Financial Crime Centre."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_14__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "The National Anti-Financial Crime Centre may, subject to an approval by the Executive Committee, organize an integrated operation relating to financial crime and when the investigation involves the enforcement of not less than two enforcement agencies."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "For the purpose of subsection (1), the National Anti-Financial Crime Centre shall have the power to coordinate and collaborate with enforcement agencies on matters relating to integrated operation. Centralized data system"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_15__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_15__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_15__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_15__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_15__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_15__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "The National Anti-Financial Crime Centre shall establish, administer, maintain and manage a centralized data system which contain information received or gathered by the National Anti-Financial Crime Centre relating to financial crime."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "The information and analysed data in the centralized data system may be used for the planning and coordinating of an integrated operation and to prevent financial crime."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_15__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_15__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_15__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_15__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "For the purpose of the centralized data system, the National Anti-Financial Crime Centre may—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_15__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_15__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "request on its own initiative or receive any relevant information and reports from any person, Government Entity or enforcement agency for the purpose of any integrated operation or prevention of financial crime;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_15__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_15__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "subject to subsections (4) and (5), transmit any information in the centralized data system, or transmit any analysed data in the centralized data system, to any Government Entity or enforcement agency; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_15__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_15__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "develop operational policies and guidelines relating to the centralized data system."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_15__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "Any Government Entity or enforcement agency may, to the extent permitted under the applicable written laws, provide to the National Anti-Financial Crime Centre information that the National Anti-Financial Crime Centre considers necessary for the purpose of any integrated operation or for the prevention of financial crime."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_15__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "Any information received by the National Anti-Financial Crime Centre under subsection (4) may be transmitted to any other Government Entity or enforcement agency subject to the extent permitted under the applicable written laws which governs the disclosure of such information. Power to gather information"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_16__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_16__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_16__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_16__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_16__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_16__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_16__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_16__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_16__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_16__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The National Anti-Financial Crime Centre may, by a written notice, order any person, who has any document that is relevant, or is capable of giving any information relating to financial crime which the National Anti-Financial Crime Centre has reasonable grounds to believe that the information is relevant, to the performance of its functions under this Act to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_16__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_16__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "give and produce to the National Anti-Financial Crime Centre, within the period and in the manner specified in the written notice, any such information or document;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_16__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_16__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "make copies of any such documents and to produce those copies to the National Anti-Financial Crime Centre within the period and in the manner specified in the written notice; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_16__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_16__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "appear before an officer of the National Anti-Financial Crime Centre at a time and place specified in the written notice to give any information."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_16__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_16__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_16__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who receives a written notice under subsection (1), shall—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_16__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_16__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "provide such information or documents as specified in the written notice;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_16__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_16__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "ensure that the information or documents provided are true, accurate and complete; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_16__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_16__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "provide a representation to that effect, including a representation that he is not aware of any other information or document which would make the information or document provided untrue or misleading."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_16__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "A person referred to in subsection (1) may, to the extent permitted under the applicable written laws, provide to the National Anti-Financial Crime Centre any information that the National Anti-Financial Crime Centre considers necessary to exercise its functions under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_16__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "Where any person discloses any information or produces any documents in response to a written notice under this section, such person, his agent or employee, or any other person acting on his behalf or under his direction, shall not, by reason only of such disclosure or production, be liable to prosecution for any offence under any law, or to any proceedings or claim by any person under any law or under any contract, agreement or arrangement, or otherwise."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_16__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection (4) shall not bar, prevent or prohibit the institution of any prosecution for any offence as provided by this section or the disclosure or production of false information or document in relation to a written notice under this section furnished to the National Anti-Financial Crime Centre pursuant to this section."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_16__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_VI__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (2) commits an offence and shall, on conviction, be liable to a fine not exceeding one million ringgit or to imprisonment for a term not exceeding five years or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_V__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_V__cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_V__cl_12__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_V__cl_12__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_V__cl_12__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_V__cl_12__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_V__cl_12__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_V__cl_12__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_V__cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_V__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The Yang di-Pertuan Agong shall, on the advice of the Prime Minister, appoint a Director General of the National Anti-Financial Crime Centre, who shall head the National Anti-Financial Crime Centre, on such terms and conditions as may be specified in the instrument of appointment."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_V__cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_V__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The Prime Minister shall appoint a Deputy Director General of the National Anti-Financial Crime Centre on such terms and conditions as may be specified in the instrument of appointment."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_V__cl_12__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_V__cl_12__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_V__cl_12__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_V__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General and Deputy Director General appointed under subsections (1) and (2), respectively, shall hold office for a period not exceeding three years and is eligible for reappointment for a period not exceeding three years—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_V__cl_12__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_V__cl_12__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of an appointment as the Director General, as the Yang di-Pertuan Agong, on the advice of the Prime Minister, considers necessary; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_V__cl_12__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_V__cl_12__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of an appointment as the Deputy Director General, as the Prime Minister considers necessary."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_V__cl_12__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_V__cl_12__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_V__cl_12__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_V__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (3), where the Director General or Deputy Director General is appointed from among members of the public services, the period of appointment of the Director General or Deputy Director General shall not extend beyond the date of his compulsory retirement from the public service, but where he attains the age of such compulsory retirement he may be reappointed—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_V__cl_12__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_V__cl_12__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of an appointment as the Director General, by the Yang di-Pertuan Agong, on the advice of the Prime Minister; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_V__cl_12__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_V__cl_12__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of an appointment as the Deputy Director General, by the Prime Minister, on contract for such period and on such terms and conditions as may be specified in the instrument of appointment."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_V__cl_12__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_V__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "For the purpose of subsection (4), the period for the reappointment of the Director General or Deputy Director General on contract shall not exceed the period in which he was appointed under subsection (3)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_V__cl_12__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_V__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General shall be responsible for the direction, command and control of all matters relating to the National Anti-Financial Crime Centre."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_V__cl_12__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_V__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General may, for giving full effect to any provision of this Act issue any direction, order or decision as the Director General thinks necessary or expedient subject to the provisions of this Act. Appointment of other officers of the National Anti-Financial Crime Centre"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_V__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_V__cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_V__cl_13__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_V__cl_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_V__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "There shall be appointed such number of officers of the National Anti-Financial Crime Centre as may be necessary for the purpose of carrying into effect the provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_V__cl_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~part_V__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "An officer appointed under subsection (1) shall be subject to the direction, control and supervision of the Director General, and shall exercise his powers, perform his functions and discharge his duties in compliance with such direction or control as may be specified orally or in writing by the Director General."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/28/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "[Section 2] OFFENCES LISTED AS FINANCIAL CRIME Offences under the Second Schedule to the Anti-Money Laundering, Anti-Terrorism Financing and Proceeds of Unlawful Activities Act 2001 [Act 613]."
      }
    }
  ]
}
