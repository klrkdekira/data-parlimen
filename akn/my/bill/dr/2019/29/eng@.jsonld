      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I__cl_2__subsec_1__list_5",
      "schema:text": {
        "@language": "en",
        "@value": "the business of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I__cl_2__subsec_1__list_5__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I__cl_2__subsec_1__list_5__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "collecting currency note or currency coin;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I__cl_2__subsec_1__list_5__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I__cl_2__subsec_1__list_5__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "sorting currency note or currency coin by authenticity and quality; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I__cl_2__subsec_1__list_5__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I__cl_2__subsec_1__list_5__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "packing currency note or currency coin by quality, quantity and denomination, by a person for or on behalf of another person; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I__cl_2__subsec_1__list_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I__cl_2__subsec_1__list_5",
      "schema:text": {
        "@language": "en",
        "@value": "any activity declared as currency processing business under section 23."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I__cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I__cl_2__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I__cl_2__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I__cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "A currency note shall be deemed defaced—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I__cl_2__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I__cl_2__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "if any word, sign, symbol, drawing, caricature, or other thing, has been written, inscribed, or in any other manner or by any other means has been shown on its surface; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I__cl_2__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I__cl_2__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "if the currency note is torn, marred, burnt, stained, spoilt or otherwise in any manner mutilated."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I__cl_2__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I__cl_2__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I__cl_2__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I__cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "A currency coin shall be deemed tampered with—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I__cl_2__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I__cl_2__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "if the currency coin is impaired, diminished or lightened otherwise than by fair wear and tear; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I__cl_2__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I__cl_2__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "if the currency coin is stamped, engraved or pierced, regardless whether the coin has been diminished or lightened. Person declared as a financial institution"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I",
      "schema:text": {
        "@language": "en",
        "@value": "Any person specified in the First Schedule is declared as a financial institution for the purposes of this Act. Powers and functions of Bank"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I__cl_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I__cl_4__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I__cl_4__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I__cl_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "The powers and functions of the Bank under this Act are in addition to, and not in derogation of, the powers and functions of the Bank under the Central Bank of Malaysia Act 2009."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I__cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "The Governor shall exercise such powers and perform such functions of the Bank under this Act on behalf of the Bank."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I__cl_4__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I__cl_4__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I__cl_4__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "The Bank may, either generally or in a particular case, appoint any person, including an officer of the Bank, whether in or outside Malaysia—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I__cl_4__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I__cl_4__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "to exercise any of the powers or perform any of the functions, of the Bank, under this Act on behalf of and in the name of the Bank; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I__cl_4__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I__cl_4__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "to render such assistance in the exercise of any of the powers or performance of any of the functions, of the Bank, under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V",
      "@type": "akn:part",
      "eli:number": "V",
