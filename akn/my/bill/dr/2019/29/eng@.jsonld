      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "POWERS RELATING TO CURRENCY Bank to be sole authority to issue currency"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III",
      "@type": "akn:part",
      "eli:number": "III",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_18",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_19",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_20",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_21",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_22"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "OFFENCES RELATING TO CURRENCY Prohibition from issuing, printing or minting currency"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_18__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_18__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_18__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall issue, print or mint or authorize the issuance, printing or minting of, any note, coin, token, document or instrument, whether tangible or intangible, which is likely to pass as legal tender unless the note, coin, token, document or instrument is denominated in and fully backed by ringgit or foreign currency."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_18__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_18__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_18__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "For the purpose of subsection (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_18__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_18__subsec_2__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_18__subsec_2__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_18__subsec_2__para_a__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "a note, coin, token, document or instrument is likely to pass as legal tender, if the note, coin, token, document or instrument fulfills all of the following characteristics:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_18__subsec_2__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_18__subsec_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "the note, coin, token, document or instrument is payable to a bearer or holder on demand or upon presentation;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_18__subsec_2__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_18__subsec_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "the note, coin, token, document or instrument is widely used in Malaysia for the purpose of payment to any person other than the issuer of such note, coin, token, document or instrument; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_18__subsec_2__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_18__subsec_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "the note, coin, token, document or instrument has a value other than its intrinsic value;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_18__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "“foreign currency” means any note, coin, token, document or instrument, whether tangible or intangible, which is legal tender in any country, territory or place outside Malaysia and includes any right to receive such note, coin, token, document or instrument; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_18__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "“issue” means the act of making available for usage by any member of the public."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_18__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) commits an offence and shall, on conviction, be liable to a fine not exceeding fifty million ringgit or imprisonment for a term not exceeding ten years or to both. Restriction on use of photograph, drawing or design of currency in publication, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_19__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_19__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_19__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_19__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_19__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall, unless approved by the Bank—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_19__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_19__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "use any photograph of or any drawing or design resembling a currency note or currency coin or any part thereof, in any publication in any size, scale or colour; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_19__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_19__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "import, manufacture, sell, circulate or otherwise distribute any merchandise or product containing a photograph, drawing or design resembling a currency note or currency coin or any part thereof in any size, scale or colour."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_19__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) commits an offence and shall, on conviction, be liable to a fine not exceeding fifty thousand ringgit. Prohibition from melting down of currency coin"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_20__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_20__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_20__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_20__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall, with intention to profit, melt down any currency coin unless authorized by the Bank."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_20__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "The Bank may, in granting any authorization under subsection (1), impose any condition or restriction as the Bank deems fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_20__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_20__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_20__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) or (2), commits an offence and shall, on conviction—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_20__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_20__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of a natural person, be liable to a fine not exceeding fifty thousand ringgit or imprisonment for a term not exceeding one year or to both; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_20__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_20__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of a body, incorporated or unincorporated, be liable to a fine not exceeding one hundred thousand ringgit. Limitation on cash transaction"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_21__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_21__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_21__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_21__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_21__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall, in a single transaction, make or receive any payment using currency note, currency coin or their combination which exceeds the maximum aggregate value as specified in the Second Schedule."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_21__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_21__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_21__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "For the purpose of subsection (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_21__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_21__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "different maximum aggregate value may be provided for different purposes, classes of persons, activities, businesses or professions; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_21__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_21__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "a series of transactions shall be considered as a single transaction if the transactions were made with the same person, for the same purpose and within the same day."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_21__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall undertake or structure, or assist or participate in the structuring of, any transaction with the intention to avoid the application of subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_21__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) or (3) commits an offence and shall, on conviction, be liable to a fine not exceeding three times the aggregate sum or value of the transaction at the time the offence was committed. Non-application of section 21"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_22__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_22__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III",
      "schema:name": {
        "@language": "en",
        "@value": "Section 21 shall not apply to any transaction—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_22__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "made by a person with or through the Bank or a financial institution; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_22__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_22__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_22__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "approved by the Minister, on the recommendation of the Bank, in any exigent circumstances including the following:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_22__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_22__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "humanitarian aid; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_22__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_III__cl_22__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "disaster relief."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_10__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "Only currency note and currency coin issued by the Bank shall be legal tender in Malaysia at its face value provided that the currency note is not defaced and the currency coin is not tampered with."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The currency note and currency coin referred to in subsection (1) shall be legal tender at its face value for a payment not exceeding the maximum aggregate quantity or value of currency note or currency coin as specified in the Second Schedule. Sale of currency"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_11__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "The Bank may, for the purpose of promoting numismatics, sell currency note or currency coin at a price other than its face value."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "Any proceeds from the sale of currency note or currency coin pursuant to subsection (1) shall be considered as an income to the Bank. Safe custody of unissued currency, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_12__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_12__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II",
      "schema:name": {
        "@language": "en",
        "@value": "The Bank shall, in such manner as the Bank deems fit—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_12__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "arrange for the safe custody of unissued currency note or currency coin; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_12__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "prepare and keep instruments and materials used for the issuance, printing or minting of currency note or currency coin. Power to call in currency"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_13__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_13__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The Bank may call in any currency note or currency coin upon giving not less than one month’s notice published in the Gazette of its intention to do so."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "Upon the expiration of the notice, the currency note or currency coin to which the notice applies shall cease to be legal tender."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_13__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (2), the Bank shall be liable for the face value of any currency note or currency coin upon presentation at the office of the Bank or at any agency as the Bank may establish or appoint for such purpose. Withdrawal of currency"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_14__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_14__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_14__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II",
      "schema:name": {
        "@language": "en",
        "@value": "The Bank may take all steps as the Bank deems fit to withdraw from circulation—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_14__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "any currency note including currency note which is defaced or unfit for circulation;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_14__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "any currency coin including currency coin which is worn or tampered with; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_14__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "any currency note and currency coin which have been called in pursuant to section 13. Disposal of currency or printing and minting instruments"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_15__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_15__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_15__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "The Bank may destroy, deal with or otherwise dispose of currency note or currency coin which has been withdrawn pursuant to section 14 in such manner as the Bank deems fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "The Bank shall arrange for the destruction of instruments and materials used for the issuance, printing or minting of currency note or currency coin in such manner as the Bank deems fit. Refund of lost, stolen or imperfect currency"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_16__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_16__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_16__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_16__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_16__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_16__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall be entitled to recover from the Bank the value—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_16__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_16__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "of any currency note or currency coin which is lost, stolen or imperfect;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_16__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_16__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "of any currency note which is defaced; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_16__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_16__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "of any currency coin which has been tampered with."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_16__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_16__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_16__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (1), the Bank may, at its discretion, refund the value—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_16__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_16__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "of any currency note and currency coin which is imperfect;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_16__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_16__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "of any currency note which is defaced; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_16__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_16__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "of any currency coin which has been tampered with. Preservation of quality and integrity of currency"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_17__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_17__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "For the purpose of preserving the quality and integrity, or promoting the reissuance or recirculation of currency note or currency coin, the Bank may—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_17__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "enter into a contract or other arrangement with a financial institution or a registered currency processor; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_17__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "take any measures or facilitate any actions as the Bank deems fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "The Bank shall be the sole authority to issue currency note and currency coin in Malaysia. Printing and minting of currency under authority of Bank"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_6__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The currency note and currency coin shall only be printed or minted by or under the authority of the Bank."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The Bank shall arrange for the printing of currency note and the minting of currency coin. Issuance, reissuance and exchange of currency at office, etc., established by Bank"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "The Bank shall issue and reissue and may exchange currency note and currency coin at the office of the Bank or at any agency as the Bank may establish or appoint for such purpose. Bank liable for face value of currency"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "The Bank shall be liable for the face value of currency note and currency coin issued by the Bank. Denomination and form of currency"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_9__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_9__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_9__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "Currency note and currency coin issued by the Bank—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_9__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_9__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "shall be in such denomination of ringgit or sen; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_9__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_9__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "shall be of such form, characteristics or design, or bear such feature or device, as approved by the Minister, on the recommendation of the Bank."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "The standard weight and composition of currency coin issued by the Bank and the amount of remedy and variation shall be as approved by the Minister, on the recommendation of the Bank. Legal tender"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_23",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_24",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_25",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_26",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_27",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_28",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_29",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_30",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_31",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_32",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_33",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_34",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_35",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_36",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_37",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_38",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_39",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_40",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_41",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_42",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_43",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_44",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_45"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "CURRENCY PROCESSING BUSINESS Declaration of currency processing business"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, on the recommendation of the Bank, by an order published in the Gazette, declare any activity relating to the handling of currency note or currency coin as a currency processing business. Division 1 Registration Prohibition from carrying on currency processing business"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_24__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_24__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_24__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_24__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_24__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "No person, other than the Bank or a financial institution, shall—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_24__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_24__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "carry on a currency processing business; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_24__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_24__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "hold itself out to be a registered currency processor, unless the person is registered under section 26."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_24__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) commits an offence and shall, on conviction, be liable to a fine not exceeding five million ringgit. Application for registration"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_25__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_25__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_25__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_25__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_25__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_25__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_25__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "An applicant for registration to carry on currency processing business shall—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_25__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_25__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "fulfill all requirements as prescribed by the Bank;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_25__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_25__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "submit an application in such form and manner, together with any information and document as may be specified by the Bank; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_25__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_25__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "pay the processing fees as may be prescribed by the Minister under section 60."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_25__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall apply for registration to carry on a currency processing business unless the person is a company."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_25__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "For the purpose of paragraph (1)(a), “prescribed” means to be prescribed by an order published in the Gazette, and the power to prescribe includes the power to prescribe differently for different persons or different classes, categories or descriptions of persons, and to amend any prescription. Registration"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_26__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_26__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_26__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_26__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "The Bank shall, upon receipt of an application for registration under section 25, register the applicant."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_26__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "An applicant shall not commence its currency processing business until the applicant is notified by the Bank of its registration under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_26__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (2) commits an offence and shall, on conviction, be liable to a fine not exceeding five million ringgit. Non-registration"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "The Bank shall not register an applicant if the applicant fails to comply with section 25 and the Bank shall notify the applicant on the refusal of the application for registration. Publication of list of registered currency processor"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "The Bank shall publish a list of registered currency processor in the form as the Bank deems fit. Voluntary deregistration"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_29__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_29__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_29__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_29__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "A registered currency processor proposing to cease from carrying on currency processing business shall give a notice to the Bank for voluntary deregistration and may propose an effective date for the voluntary deregistration."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_29__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "The Bank shall, upon receipt of a notice under subsection (1), deregister a registered currency processor in accordance with the proposed effective date stated in the notice, if any, or such later date as the Bank deems fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_29__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "The Bank shall notify a registered currency processor of the effective date of its voluntary deregistration under this section. Deregistration by Bank"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_30__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_30__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_30__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_30__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_30__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_30__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_30__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV",
      "schema:name": {
        "@language": "en",
        "@value": "The Bank may propose to deregister a registered currency processor—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_30__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "if the registered currency processor provided the Bank with false, misleading, inaccurate or incomplete information for the purpose of subsection 25(1);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_30__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "if the registered currency processor has ceased from carrying on currency processing business;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_30__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "if the registered currency processor commits a breach regardless no action has been taken in respect of the breach;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_30__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_30__para_d__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_30__para_d__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_30__para_d__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_30__para_d__subpara_iv",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_30__para_d__subpara_v"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "if the registered currency processor contravenes any provision of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_30__para_d__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_30__para_d",
      "schema:text": {
        "@language": "en",
        "@value": "the Central Bank of Malaysia Act 2009;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_30__para_d__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_30__para_d",
      "schema:text": {
        "@language": "en",
        "@value": "the Anti-Money Laundering, Anti-Terrorism Financing and Proceeds of Unlawful Activities Act 2001 [Act 613];"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_30__para_d__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_30__para_d",
      "schema:text": {
        "@language": "en",
        "@value": "the Money Services Business Act 2011 [Act 731];"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_30__para_d__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_30__para_d",
      "schema:text": {
        "@language": "en",
        "@value": "the Financial Services Act 2013; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_30__para_d__subpara_v",
      "@type": "akn:subparagraph",
      "eli:number": "v",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_30__para_d",
      "schema:text": {
        "@language": "en",
        "@value": "the Islamic Financial Services Act 2013, regardless no prosecution or other action has been taken in respect of such contravention;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_30__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "the director, chief executive officer or any person concerned with the operation or management of the registered currency processor is convicted of an offence under this Act or an offence involving fraud or dishonesty under any other written law;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_30__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "the registered currency processor has been wound-up or otherwise dissolved; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_30__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "a receiver or manager of the property of the registered currency processor has been appointed. Opportunity to make representation for action under section 30"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_31__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_31__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_31__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_31__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_31__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_31__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Bank proposes to deregister a registered currency processor under section 30, the Bank shall give the registered currency processor a notice setting out the proposed deregistration and the grounds for the proposed deregistration."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_31__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "A registered currency processor who has received a notice under subsection (1) shall be given an opportunity to make a representation to the Bank within fourteen days from the date of the notice."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_31__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_31__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_31__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "If at the end of the period set out in subsection (2)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_31__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_31__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the Bank did not receive any representation, the Bank shall deregister the registered currency processor and give the registered currency processor a notice of the deregistration; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_31__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_31__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the Bank receives a representation, the Bank shall, after considering the representation, give the registered currency processor a notice of its decision whether to proceed with the deregistration or otherwise."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_31__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "A deregistration under subsection (3) shall take effect on the date as may be specified by the Bank in its notice under subsection (3)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_31__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Bank decides under paragraph (3)(b) to not deregister the registered currency processor, the Bank may impose any requirements on the registered currency processor as the Bank deems fit. Effect of deregistration"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_32__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_32__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_32__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "Where a registered currency processor voluntarily deregisters under section 29 or the Bank deregisters a registered currency processor under subsection 31(3), the registered currency processor shall immediately cease from carrying on currency processing business on the effective date of the deregistration."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_32__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "A deregistration shall not affect any right, obligation or liability arising under, any agreement, arrangement or transaction entered into by the registered currency processor with any person prior to the deregistration. Division 2 Duties of registered currency processor Prudent and professional practice"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_33__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_33__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_33__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "A registered currency processor and a financial institution carrying on currency processing activities shall manage its business, affairs and activities prudently, professionally and with integrity, accountability and transparency."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_33__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "A registered currency processor and a financial institution carrying on currency processing activities shall comply and ensure that its internal policies and procedures are consistent with any standards specified by the Bank under section 61, including standards on prudential practice, integrity, professionalism and expertise in the conduct of its business, affairs and activities. Duties of director and chief executive officer"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_34",
      "@type": "akn:clause",
      "eli:number": "34",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "Every director, chief executive officer or any person concerned with the operation or management of a registered currency processor or a financial institution carrying on currency processing activities shall ensure that the registered currency processor or the financial institution carrying on currency processing activities complies with this Act and any regulations, standards, specifications, directions or requirements made under this Act. Fees"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_35",
      "@type": "akn:clause",
      "eli:number": "35",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_35__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_35__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_35__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_35__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "A registered currency processor shall pay any fees prescribed by the Minister under section 60."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_35__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "No registered currency processor shall be entitled to a refund of any fees paid under subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_35__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_35",
      "schema:text": {
        "@language": "en",
        "@value": "The Bank may sue any person to recover any unpaid fees under this Act as a civil debt due to the Government and the court may award the cost of recovering the unpaid fees to the Bank. Preservation of secrecy"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_36",
      "@type": "akn:clause",
      "eli:number": "36",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_36__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_36__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_36__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_36__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_36__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "No person who is or was a director, chief executive officer, officer or employee of a registered currency processor shall disclose to any person, any information or document relating to the business or affairs of a customer of a registered currency processor unless approved by the Bank."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_36__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "No person, who for any reason, has by any means access to any information or document relating to the business or affairs of a customer of a registered currency processor, shall disclose to any person, such information or document unless approved by the Bank."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_36__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_36__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_36__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "Subsections (1) and (2) shall not apply to any disclosure—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_36__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_36__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "made to the Bank relating to the performance of its duties or the carrying out of its functions under this Act; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_36__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_36__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "lawfully required by any court or any written law."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_36__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) or (2) commits an offence and shall, on conviction, be liable to a fine not exceeding three million ringgit or imprisonment for a term not exceeding three years or to both. Detention of currency suspected to be counterfeit"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_37",
      "@type": "akn:clause",
      "eli:number": "37",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "The Bank, registered currency processor and financial institution shall detain any currency note or currency coin presented in any manner to the Bank, registered currency processor and financial institution which the Bank, registered currency processor and financial institution have reason to believe to be counterfeit. Bank, registered currency processor and financial institution to record personal information of person from whom currency is detained"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_38__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_38__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_38__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_38__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_38__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_38__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "Upon detention of the currency note or currency coin under section 37, it shall be lawful for the Bank, registered currency processor and financial institution to record the personal information including the name, national registration identification number and address of the person from whom the currency note or currency coin is detained by the Bank, registered currency processor and financial institution, including—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_38__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_38__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the personal information of its legal or beneficial owner; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_38__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_38__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the personal information of its carrier or any person having in his possession the detained currency note or currency coin prior to the detention."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_38__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "The person from whom the currency note or currency coin is detained under section 37 shall provide the information required under subsection (1) to the Bank, registered currency processor and financial institution."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_38__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (2) commits an offence and shall, on conviction, be liable to a fine not exceeding twenty thousand ringgit. Currency to be surrendered and information to be furnished, to police"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "The Bank, registered currency processor and financial institution shall surrender any currency note or currency coin detained under section 37, and the Bank, registered currency processor and financial institution shall furnish the information recorded under subsection 38(1), to the police. Currency remains property of person from whom currency was detained if currency is genuine"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_40__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_40__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_40__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "Any currency note or currency coin detained and surrendered to the police under section 39 shall remain as the property of the person from whom the currency note or currency coin is detained if the currency note or currency coin is discovered to be genuine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_40__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall be entitled to recover any compensation for any loss suffered by him due to the detention of currency note or currency coin under section 37. Submission of document or information"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_41",
      "@type": "akn:clause",
      "eli:number": "41",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_41__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_41__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_41__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_41__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_41__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "A registered currency processor and a financial institution shall submit to the Bank, or to any person as the Bank may identify, any document or information in the manner and within the period as specified by the Bank."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_41__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_41__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_41__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "The Bank may require any person to submit any document or information as specified by the Bank relating to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_41__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_41__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "a registered currency processor or its currency processing business; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_41__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_41__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "a financial institution or its currency processing activities."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_41__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "Where any person is required to submit any document or information under subsection (1) or (2), the person shall submit document or information that is correct, accurate, complete and not misleading."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_41__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_41",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1), (2) or (3) commits an offence and shall, on conviction, be liable to a fine not exceeding fifty thousand ringgit. Division 3 Examination Power to examine"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_42",
      "@type": "akn:clause",
      "eli:number": "42",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_42__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_42__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_42__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_42__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_42__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_42__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "The Bank may without any prior notice, examine any—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_42__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_42__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "document, account or transaction;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_42__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_42__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "computer, machinery, equipment or infrastructure; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_42__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_42__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "premises or office, relating to the currency processing business or currency processing activities of a registered currency processor or its agent."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_42__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_42__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_42__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_42__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "For the purpose of subsection (1), the power to examine includes the power to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_42__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_42__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "test any computer, machinery, equipment and infrastructure;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_42__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_42__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "make copy of or extract any document, account, computer output, transaction and output of any machinery, equipment and infrastructure; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_42__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_42__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "take photograph of any document, account, transaction, computer, machinery, equipment, infrastructure, premises and office. Examination of specific person"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_43",
      "@type": "akn:clause",
      "eli:number": "43",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "In carrying out an examination under section 42, the Bank may examine a person who is, or was at any time, a director, chief executive officer, officer, employee, or any person concerned with the operation or management, of the currency processing business or currency processing activities of a registered currency processor or its agent under the examination. Right of access and production of property, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_44",
      "@type": "akn:clause",
      "eli:number": "44",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_44__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_44__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_44__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_44__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_44__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_44__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "Any person under an examination under section 42 or 43 shall—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_44__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_44__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "allow access to any document, account, transaction, property, apparatus, equipment, machinery, computer, computer output, system, infrastructure, premises and office; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_44__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_44__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "produce any document, account, transaction, property, apparatus, equipment, machinery, computer, computer output and system, to the Bank in the manner and within the time as specified by the Bank."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_44__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "For the purpose of subsection (1), the person under an examination shall provide the Bank with the necessary key, password, encryption code, decryption code, software or hardware or any other means to enable the comprehension of any computer output, machinery, equipment or infrastructure."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_44__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) or (2) commits an offence and shall, on conviction, be liable to a fine not exceeding one hundred thousand ringgit. Appearance before Bank"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_45",
      "@type": "akn:clause",
      "eli:number": "45",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_45__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_45__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_45__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_45",
      "schema:text": {
        "@language": "en",
        "@value": "A person to be examined under section 43 shall appear before the Bank at the time and place as may be specified by the Bank."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_45__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_IV__cl_45",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) commits an offence and shall, on conviction, be liable to a fine not exceeding one hundred thousand ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I__cl_1",
      "@type": "akn:clause",
