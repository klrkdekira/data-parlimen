      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "SAVING AND TRANSITIONAL Saving"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VII__cl_69",
      "@type": "akn:clause",
      "eli:number": "69",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VII__cl_69__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VII__cl_69__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VII",
      "schema:name": {
        "@language": "en",
        "@value": "Any—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VII__cl_69__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VII__cl_69",
      "schema:text": {
        "@language": "en",
        "@value": "approval or determination made by the Minister under section 23 of the Central Bank of Malaysia Act 1958 [Act 519] shall be deemed as approval of the Minister under section 9; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VII__cl_69__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VII__cl_69",
      "schema:text": {
        "@language": "en",
        "@value": "permission given by the Bank under section 27a of the Central Bank of Malaysia Act 1958 shall be deemed as approval granted by the Bank under subsection 19(1), and shall continue to remain in full force and effect in relation to the person to whom the approval or determination or permission applies until the approval or determination or permission is amended or revoked. Transitional"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VII__cl_70",
      "@type": "akn:clause",
      "eli:number": "70",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VII__cl_70__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VII__cl_70__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VII__cl_70__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VII__cl_70__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VII__cl_70__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VII__cl_70__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VII__cl_70",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who has been carrying on currency processing business prior to the appointed date under subsection 1(2) may continue to do so as if this Act had not been enacted for a period of six months from the appointed date or any other period as specified by the Bank, which shall be referred to as the “grace period”."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VII__cl_70__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VII__cl_70",
      "schema:text": {
        "@language": "en",
        "@value": "If the person referred to in subsection (1) intends to continue to carry on the currency processing business after the expiry of the grace period, the person shall make an application to be registered as a registered currency processor under section 25 within the grace period."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VII__cl_70__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VII__cl_70",
      "schema:text": {
        "@language": "en",
        "@value": "Where a person referred to in paragraph (1) has been registered as a registered currency processor by the Bank, the registered currency processor shall be given an additional grace period of six months from the expiry of the grace period to fully comply with the provisions in Division 2 of Part IV and any non-compliance after the expiry of the additional grace period shall be subject to actions provided in the relevant provisions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VII__cl_70__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VII__cl_70",
      "schema:text": {
        "@language": "en",
        "@value": "Where a person has not applied to be registered as a registered currency processor or has his application for registration rejected on the expiry of the grace period, the person shall immediately cease from carrying on currency processing business on the expiry date of the grace period."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VII__cl_70__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VII__cl_70__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VII__cl_70__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VII__cl_70",
      "schema:text": {
        "@language": "en",
        "@value": "The grace period under subsection (1) shall expire in the case where the person has applied to be registered as a registered currency processor—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VII__cl_70__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VII__cl_70__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "on the date the application for registration as a registered currency processor is accepted by the Bank and a notification under section 26 is issued; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VII__cl_70__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VII__cl_70__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "on the date of service of a notice under section 27 stating that the application for registration is refused by the Bank."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_59",
      "@type": "akn:clause",
      "eli:number": "59",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_59__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_59__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_59__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to subsections 11(2), 35(3) and 48(4), all monies received by the Bank or the Governor pursuant to this Act shall be paid into the Consolidated Fund including any—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_59__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_59",
      "schema:text": {
        "@language": "en",
        "@value": "fees paid by a person under section 25 or 35;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_59__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_59",
      "schema:text": {
        "@language": "en",
        "@value": "monetary penalty paid under section 48; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_59__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_59",
      "schema:text": {
        "@language": "en",
        "@value": "compound paid under section 57. Power to make regulations"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_60",
      "@type": "akn:clause",
      "eli:number": "60",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_60__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_60__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_60__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_60__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_60__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_60",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, on the recommendation of the Bank, make regulations as may be necessary or expedient for the purpose of carrying into effect the provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_60__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_60__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_60__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_60__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_60",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to the generality of subsection (1), regulations may be made to provide—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_60__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_60__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "for fees payable to the Bank in respect of any matter under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_60__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_60__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "for the registration of a registered currency processor; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_60__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_60__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "for any other matters relating to currency."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_60__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_60",
      "schema:text": {
        "@language": "en",
        "@value": "Any regulations made under this section may prescribe an act or omission in contravention of the regulations to be an offence and may prescribe penalties of a fine not exceeding fifty thousand ringgit or to imprisonment for a term not exceeding one year or to both for such offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_60__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_60",
      "schema:text": {
        "@language": "en",
        "@value": "Regulations made under this section may relate to all or any class, category or description of persons, and the Minister, on the recommendation of the Bank, may make different provisions for different classes, categories or descriptions of persons. Power to issue standards"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_61",
      "@type": "akn:clause",
      "eli:number": "61",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_61__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_61__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_61__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "The Bank may issue standards as the Bank deems fit, generally in respect of this Act, or in respect of any particular provision of this Act, or generally in respect of the conduct of a registered currency processor or a financial institution carrying on currency processing activities—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_61__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_61",
      "schema:text": {
        "@language": "en",
        "@value": "for the purpose of giving effect to its object and carrying out its function or conducting its business or affair;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_61__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_61",
      "schema:text": {
        "@language": "en",
        "@value": "for the purpose of giving full effect to any provision of this Act; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_61__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_61",
      "schema:text": {
        "@language": "en",
        "@value": "for the further, better or more convenient implementation of the provisions of this Act. Power to issue guidelines"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_62",
      "@type": "akn:clause",
      "eli:number": "62",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_62__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_62__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_62__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "The Bank may issue guidelines to any person or to any class, category or description of persons consisting of any information, advice or recommendation as the Bank deems fit—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_62__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_62",
      "schema:text": {
        "@language": "en",
        "@value": "relating to the provisions of this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_62__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_62",
      "schema:text": {
        "@language": "en",
        "@value": "for the purpose of carrying out or achieving the regulatory objective of this Act; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_62__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_62",
      "schema:text": {
        "@language": "en",
        "@value": "relating to any other matters which the Bank thinks is desirable to give information, advice or recommendation. Provision relating to approval, standards, specifications, notice, requirements, directions, order or guidelines"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_63",
      "@type": "akn:clause",
      "eli:number": "63",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_63__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_63__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_63__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_63__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_63__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_63__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_63",
      "schema:text": {
        "@language": "en",
        "@value": "Any approval granted, or standards, specifications, notice, requirements, directions, order or guidelines made under this Act—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_63__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_63__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "may be either general or specific; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_63__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_63__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "may be amended or revoked by the Bank."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_63__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_63",
      "schema:text": {
        "@language": "en",
        "@value": "Any standards, specifications, notice, requirements, directions, order or guidelines made under this Act may provide differently for different persons or different classes, categories or descriptions of persons."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_63__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_63",
      "schema:text": {
        "@language": "en",
        "@value": "Any approval granted, or standards, specifications, notice, requirements, directions, order or guidelines made under this Act shall be issued or communicated in such manner as the Bank deems fit. Publication of enforcement action"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_64",
      "@type": "akn:clause",
      "eli:number": "64",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "The Bank may, where appropriate, publish in such form and manner as the Banks deems fit, any information in relation to any action taken by the Bank or otherwise under Part V, and the outcome of the action. Amendment of Schedules"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_65",
      "@type": "akn:clause",
      "eli:number": "65",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, on the recommendation of the Bank, by an order published in the Gazette, amend the First Schedule and Second Schedule to this Act. Protection against suits and legal proceedings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_66",
      "@type": "akn:clause",
      "eli:number": "66",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_66__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_66__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_66__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_66__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_66__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_66__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "No action, suit, prosecution or other proceedings shall lie or be brought, instituted, or maintained in any court or before any other authority against—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_66__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_66",
      "schema:text": {
        "@language": "en",
        "@value": "the Minister;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_66__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_66",
      "schema:text": {
        "@language": "en",
        "@value": "the Bank;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_66__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_66",
      "schema:text": {
        "@language": "en",
        "@value": "the Governor;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_66__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_66",
      "schema:text": {
        "@language": "en",
        "@value": "any member of the Monetary Penalty Review Committee;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_66__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_66",
      "schema:text": {
        "@language": "en",
        "@value": "any director, officer or employee of the Bank; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_66__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_66",
      "schema:text": {
        "@language": "en",
        "@value": "any person acting on behalf of the Bank, for or on account of, or in respect of, any act, statement or omission made or omitted, or purporting to be made or omitted, in pursuance of or in execution of, or intended pursuance of or execution of, this Act, or any approval, directions, prescriptions, specifications, standards, requirements, order, guidelines and regulations made under this Act if the act, statement or omission made or omitted, or purporting to be made or omitted, in pursuance of or in execution of, or intended pursuance of or execution of, this Act, or the approval, directions, prescriptions, specifications, standards, requirements, order, guidelines and regulations made under this Act is made or omitted in good faith. Application of section 77 of Central Bank of Malaysia Act 2009, Division 2 of Part XIV of Financial Services Act 2013 and Division 2 of Part XV of Islamic Financial Services Act 2013"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_67",
      "@type": "akn:clause",
      "eli:number": "67",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_67__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_67__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_67__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_67__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_67",
      "schema:text": {
        "@language": "en",
        "@value": "Nothing contained in this Act shall in any manner affect or derogate from the provisions of section 77 of the Central Bank of Malaysia Act 2009, Division 2 of Part XIV of the Financial Services Act 2013 and Division 2 of Part XV of the Islamic Financial Services Act 2013."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_67__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_67",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall be read subject to the provisions of section 77 of the Central Bank of Malaysia Act 2009, Division 2 of Part XIV of the Financial Services Act 2013 and Division 2 of Part XV of the Islamic Financial Services Act 2013 and in the event of any conflict between this Act and the provisions, the provisions shall prevail."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_67__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_67",
      "schema:text": {
        "@language": "en",
        "@value": "Nothing in this Act shall be considered as an approval for the purpose of Division 2 of Part XIV of the Financial Services Act 2013 and Division 2 of Part XV of the Islamic Financial Services Act 2013. Exemption"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI__cl_68",
      "@type": "akn:clause",
      "eli:number": "68",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, on the recommendation of the Bank, by an order published in the Gazette, exempt any person or any class, category or description of persons, from all or any provisions of this Act for any period and subject to any conditions as the Minister may prescribe in the order."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_46",
      "@type": "akn:clause",
      "eli:number": "46",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_46__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_46__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "A registered currency processor or a financial institution, or its director or chief executive officer, or any person concerned with its operation or management, commits a breach under this Act if the registered currency processor or financial institution, or its director or chief executive officer, or any person concerned with its operation or management, fails to comply with or give effect to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_46__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "any provision of this Act; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_46__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "any regulations, standards, specifications, directions or requirements made under this Act. Power to issue direction"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_47",
      "@type": "akn:clause",
      "eli:number": "47",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_47__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_47__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_47__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_47__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_47__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_47",
      "schema:text": {
        "@language": "en",
        "@value": "The Bank may, subject to sections 49 and 50, issue a direction under subsection (2) to a registered currency processor or a financial institution if the Bank thinks that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_47__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_47__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "it is necessary to do so as a result of any examination under this Act; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_47__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_47__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_47__subsec_1__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_47__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the registered currency processor or the financial institution, or its director or chief executive officer, or any person concerned with its operation or management—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_47__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_47__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "is carrying or has carried on currency processing business or currency processing activities in a manner detrimental to the interests of its customers or members of the public; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_47__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_47__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "is committing or has committed or is likely to commit a breach."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_47__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_47__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_47__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_47__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_47__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_47__subsec_2__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_47",
      "schema:text": {
        "@language": "en",
        "@value": "For the purpose of subsection (1), the Bank may issue a direction to the registered currency processor or the financial institution relating to one or more of the following purposes:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_47__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_47__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prohibit the registered currency processor or the financial institution from carrying on all or any part of its currency processing business or currency processing activities;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_47__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_47__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prohibit the registered currency processor or the financial institution from doing or performing any act or function connected with all or any part of its currency processing business or currency processing activities;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_47__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_47__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to suspend its currency processing business or currency processing activities to any extent and for any period as the Bank deems fit;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_47__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_47__subsec_2__para_d__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_47__subsec_2__para_d__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_47__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to require the registered currency processor or financial institution to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_47__subsec_2__para_d__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_47__subsec_2__para_d",
      "schema:text": {
        "@language": "en",
        "@value": "comply with or give effect to; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_47__subsec_2__para_d__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_47__subsec_2__para_d",
      "schema:text": {
        "@language": "en",
        "@value": "do or omit any act in order to ensure compliance with, any provisions of, regulations, standards, specifications, directions or requirements made under, this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_47__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_47__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to require the registered currency processor or financial institution to take any measure as the Bank may direct to mitigate the effect of a breach. Power to take administrative action"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_48",
      "@type": "akn:clause",
      "eli:number": "48",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_48__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_48__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_48__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_48__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_48__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_48__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_48__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_48__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Bank thinks that a registered currency processor or a financial institution, or its director or chief executive officer, or any person concerned with its operation or management, has committed a breach and it is appropriate to take action against the person, the Bank may, subject to sections 49 and 50, take any one or more of the following actions:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_48__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_48__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "reprimand the person in breach;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_48__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_48__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "require the person in breach to issue a public statement in relation to such breach, if the Bank thinks that such breach is relevant for the information of members of the public;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_48__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_48__subsec_1__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_48__subsec_1__para_c__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_48__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "where the breach is not an offence under this Act or any regulations made under this Act, impose a monetary penalty, in any amount as the Bank deems fit, but shall not exceed, relating to every breach—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_48__subsec_1__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_48__subsec_1__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of a body, incorporated or unincorporated, one hundred thousand ringgit; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_48__subsec_1__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_48__subsec_1__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of a natural person, twenty thousand ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_48__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "Where a breach was committed by a body, incorporated or unincorporated, the Bank may take any action under subsection (1) against a person who is or was its director or chief executive officer, or any person concerned with its operation or management, at the time of the commission of the breach, unless that person demonstrates that the breach was committed without his consent or connivance and that he exercised due diligence to prevent the breach as he ought to have exercised, having regard to the nature of his function in that capacity and to the circumstances."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_48__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "Where a breach was committed by a person who is a director or chief executive officer, or any person concerned with the operation or management, of a registered currency processor or a financial institution during the course of his employment, the Bank may take any action under subsection (1) against the registered currency processor or financial institution."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_48__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "Where a person fails to pay a monetary penalty imposed by the Bank under paragraph (1)(c) within the period specified by the Bank, the Bank may sue and recover the monetary penalty as a civil debt due to the Government and the court may award the cost of recovering the unpaid monetary penalty to the Bank. Appropriateness of action"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_49",
      "@type": "akn:clause",
      "eli:number": "49",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_49__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_49__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_49__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_49__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "In determining the appropriate action to be taken by the Bank against a person under section 47 or 48, the Bank shall take into consideration the following matters:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_49__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_49",
      "schema:text": {
        "@language": "en",
        "@value": "the effectiveness of the action to be taken;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_49__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_49",
      "schema:text": {
        "@language": "en",
        "@value": "the proportionality of the action to be taken with the findings of an examination or breach committed;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_49__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_49",
      "schema:text": {
        "@language": "en",
        "@value": "deterrence of future breach of similar nature by a registered currency processor, a financial institution or other person; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_49__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_49",
      "schema:text": {
        "@language": "en",
        "@value": "any other matters as the Bank deems fit. Opportunity to make representation for action under section 47 or 48"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_50",
      "@type": "akn:clause",
      "eli:number": "50",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_50__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_50__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_50__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_50__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_50__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_50__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Bank proposes to take any action against a person under section 47 or 48, the Bank shall provide to the person a notice setting out the proposed action and the grounds for the proposed action."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_50__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who has received a notice under subsection (1) shall be given an opportunity to make a representation to the Bank within fourteen days from the date of the notice."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_50__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_50__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_50__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "If at the end of the period set out in subsection (2)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_50__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_50__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the Bank did not receive any representation, the Bank shall proceed with the proposed action; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_50__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_50__subsec_3__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_50__subsec_3__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_50__subsec_3__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_50__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the Bank receives a representation, the Bank shall, after considering the representation, decide whether to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_50__subsec_3__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_50__subsec_3__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "proceed with the proposed action;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_50__subsec_3__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_50__subsec_3__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "modify the proposed action; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_50__subsec_3__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_50__subsec_3__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "take no further action, and shall inform its decision to the person by a notice."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_50__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "If the Bank decides to modify the proposed action under subparagraph (3)(b)(ii), the Bank shall provide an additional notice and an opportunity to the person to make a representation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_50__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "The decision of the Bank under paragraph (3)(b) shall take effect at any date as specified by the Bank in its notice. Appeal against monetary penalty"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_51",
      "@type": "akn:clause",
      "eli:number": "51",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_51__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_51__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_51__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_51__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_51",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who is aggrieved by a decision of the Bank under subsection 50(3) in respect of an action under paragraph 48(1)(c) may, within twenty one days after the person has been notified of the decision of the Bank, make an appeal by filing a notice to the Monetary Penalty Review Committee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_51__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_51",
      "schema:text": {
        "@language": "en",
        "@value": "The decision of the Bank under subsection 50(3) in respect of an action under paragraph 48(1)(c) shall not take effect until the appeal is disposed of."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_51__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_51",
      "schema:text": {
        "@language": "en",
        "@value": "The Monetary Penalty Review Committee may decide to confirm the decision of the Bank or require the Bank to reconsider and reach a decision in accordance with the findings of the Committee. Division 2 Criminal action Offence by person acting in official capacity"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_52",
      "@type": "akn:clause",
      "eli:number": "52",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_52__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_52__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_52__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_52__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_52",
      "schema:text": {
        "@language": "en",
        "@value": "Where an offence is committed by a body, incorporated or unincorporated, a person who is its director or chief executive officer, or any person concerned with its operation or management, at the time of the commission of the offence is deemed to have committed that offence unless that person proves that the offence was committed without his consent or connivance and that he exercised diligence to prevent the commission of the offence as he ought to have exercised, having regard to the nature of his function in that capacity and to the circumstances."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_52__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_52__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_52__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_52",
      "schema:text": {
        "@language": "en",
        "@value": "A natural person may be prosecuted for an offence under subsection (1) notwithstanding—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_52__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_52__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "that no prosecution has been instituted against the body, incorporated or unincorporated; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_52__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_52__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "that the body, incorporated or unincorporated has not been convicted of the offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_52__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_52",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection (1) shall not affect the criminal liability of the body, incorporated or unincorporated for the offence referred to in that subsection. Offence by employee or officer or agent"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_53",
      "@type": "akn:clause",
      "eli:number": "53",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_53__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_53__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_53__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_53__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_53__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_53",
      "schema:text": {
        "@language": "en",
        "@value": "Where an offence is committed by—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_53__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_53__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "an employee or officer in the course of his employment; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_53__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_53__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "an agent while acting within its authority as an agent, the employer or the principal of the person, as the case may be, at the time of the commission of the offence, is deemed to have committed that offence and be liable to the same penalty for the offence committed by the employee or officer or agent."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_53__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_53",
      "schema:text": {
        "@language": "en",
        "@value": "Nothing under subsection (1) shall absolve an employee or officer or agent from any liability for an offence. Attempt, abetment and conspiracy"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_54",
      "@type": "akn:clause",
      "eli:number": "54",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_54__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_54__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_54__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_54__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_54__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_54__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_54",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_54__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_54__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "attempts to commit an offence under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_54__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_54__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "does an act preparatory to, or in furtherance of, the commission of an offence under this Act; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_54__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_54__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "abets or is engaged in a criminal conspiracy to commit an offence under this Act, whether or not the offence is committed in consequence of it, commits an offence and is liable to the same penalty for that offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_54__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_54__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_54__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_54__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_54",
      "schema:text": {
        "@language": "en",
        "@value": "For the purpose of subsection (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_54__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_54__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "“criminal conspiracy” has the same meaning assigned to it in section 120a of the Penal Code [Act 574];"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_54__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_54__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "“abet” has the same meaning assigned to it in section 107 of the Penal Code; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_54__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_54__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "where different punishment is provided for a natural person and for a body, incorporated or unincorporated, the person committing an offence shall be liable to the punishment provided for a natural person if he is a natural person or shall be liable to the punishment provided for a body, incorporated or unincorporated if it is a body, incorporated or unincorporated. Seizable offence"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_55",
      "@type": "akn:clause",
      "eli:number": "55",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "Every offence punishable under this Act shall be a seizable offence, and a police officer not below the rank of Inspector may arrest without warrant any person whom he reasonably suspects to have committed or is committing the offence. Joinder of offences"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_56",
      "@type": "akn:clause",
      "eli:number": "56",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding anything contained in any other written law, where a person is accused of more than one offence under this Act, he may be charged with and tried at one trial for any number of the offences committed within any length of time. Compounding of offences"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_57",
      "@type": "akn:clause",
      "eli:number": "57",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_57__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_57__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_57__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_57__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_57__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_57__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_57__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_57__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_57",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, on the recommendation of the Bank, with the approval of the Public Prosecutor, make regulations prescribing—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_57__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_57__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any offence under this Act or any regulations made under this Act as an offence which may be compounded;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_57__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_57__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the criteria for compounding such offence; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_57__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_57__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the method and procedure for compounding such offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_57__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_57",
      "schema:text": {
        "@language": "en",
        "@value": "The Governor may, with the consent of the Public Prosecutor, at any time before a prosecution is instituted, compound any offence which may be compounded by making an offer to the person reasonably suspected of having committed the offence upon payment to the Governor a sum of money not exceeding the amount of the maximum fine to which the person would have been liable to if he had been convicted of the offence, within such time as may be specified in the offer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_57__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_57",
      "schema:text": {
        "@language": "en",
        "@value": "An offer under subsection (2) may be made at any time after the offence has been committed but before any prosecution for it has been instituted, and where the amount specified in the offer is not paid within the time specified in the offer, or such extended time as the Governor may grant, prosecution for the offence may be instituted at any time after that against the person to whom the offer was made."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_57__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_57",
      "schema:text": {
        "@language": "en",
        "@value": "Where an offence has been compounded under subsection (1), no prosecution shall be instituted in respect of the offence against the person to whom the offer to compound was made, and any document or thing seized in connection with the offence may be released by the Bank, subject to such terms as the Bank thinks fit. Prosecution"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V__cl_58",
      "@type": "akn:clause",
      "eli:number": "58",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "No prosecution for an offence under this Act shall be instituted except by or with the written consent of the Public Prosecutor."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~sched_1__para_1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "[Section 3] PERSON DECLARED AS FINANCIAL INSTITUTION"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~sched_1__para_1",
      "@type": "akn:paragraph",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~sched_1",
      "schema:text": {
        "@language": "en",
        "@value": "Licensees under the Money Services Business Act 2011 are declared as financial institutions for the purpose of sections 22, 33, 34, 37, 38, 39, 41, 42, 43, 44 and 45 and Division 1 of Part V."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~sched_2",
      "@type": "akn:schedule",
      "eli:number": "2",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~sched_2__para_1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "[Subsections 10(2) and 21(1)] LEGAL TENDER LIMIT"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~sched_2__para_1",
      "@type": "akn:paragraph",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~sched_2",
      "schema:text": {
        "@language": "en",
        "@value": "Currency coin shall be legal tender for the payment of any amount up to the aggregate value of twenty-five pieces of currency coin in any single payment. LIMITATION ON CASH TRANSACTION Nil."
      }
    }
  ]
}
