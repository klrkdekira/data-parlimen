        "@language": "en",
        "@value": "GENERAL Monies received by Bank"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_VII",
      "@type": "akn:part",
      "eli:number": "VII",
