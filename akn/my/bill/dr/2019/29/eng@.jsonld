      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I__cl_2__subsec_1__list_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I__cl_2__subsec_1__list_5__para_a__subpara_i",
