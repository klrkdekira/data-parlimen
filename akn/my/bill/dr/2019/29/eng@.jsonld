      "schema:text": {
        "@language": "en",
        "@value": "produced by a computer;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I__cl_2__subsec_1__list_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I__cl_2__subsec_1__list_4",
      "schema:text": {
        "@language": "en",
        "@value": "displayed on the screen of a computer; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I__cl_2__subsec_1__list_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I__cl_2__subsec_1__list_4",
      "schema:text": {
        "@language": "en",
        "@value": "accurately translated from a statement or representation so produced; “registered currency processor” means a person registered under subsection 26(1) to carry on a currency processing business and for the purpose of Division 3 of Part IV includes any financial institution carrying on currency processing activities; “currency processing business” means—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I__cl_2__subsec_1__list_5",
      "@type": "akn:list",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I__cl_2__subsec_1__list_5__para_a",
