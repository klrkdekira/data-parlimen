      "schema:text": {
        "@language": "en",
        "@value": "In this Act, unless the context otherwise requires— “currency processing activities” means—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/29/eng@/~part_I__cl_2__subsec_1__list_1",
