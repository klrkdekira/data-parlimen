      "schema:name": {
        "@language": "ms",
        "@value": "RUU Perbekalan 2020"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/32/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/32/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Perbekalan 2020. Pengeluaran dan peruntukan untuk perkhidmatan bagi tahun 2020"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/32/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/32/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengeluaran sejumlah wang yang tidak melebihi satu ratus tujuh puluh tiga bilion satu ratus tiga puluh enam juta dua ratus empat belas ribu enam ratus ringgit (RM173,136,214,600) daripada Kumpulan Wang Disatukan untuk perkhidmatan bagi tahun 2020 adalah dengan ini dibenarkan dan jumlah wang itu diperuntukkan bagi maksud-maksud yang dinyatakan dalam Jadual."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/32/msa@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/32/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Tajuk Amaun (RM) Parlimen Malaysia 145,190,900 Pejabat Penyimpan Mohor Besar 2,500,000 Raja-Raja Jabatan Audit Negara 156,233,800 Suruhanjaya Pilihan Raya 71,302,900 Suruhanjaya Perkhidmatan Awam 39,575,800 Jabatan Perdana Menteri 4,048,073,200 Jabatan Perkhidmatan Awam 1,623,931,100 Jabatan Peguam Negara 176,935,000 Suruhanjaya Pencegahan Rasuah 299,053,300 Malaysia Perbendaharaan 5,320,637,000 Perkhidmatan Am Perbendaharaan 21,027,387,800 Peruntukan kepada Kumpulan Wang 1,782,200,300 Terkanun Kementerian Luar Negeri 724,338,100 Kementerian Hal Ehwal Ekonomi 513,313,900 Kementerian Industri Utama 259,528,700 Kementerian Pertanian dan Industri Asas 3,533,985,900 Tani Kementerian Pembangunan Luar Bandar 3,191,709,400 Kementerian Air, Tanah dan Sumber 1,276,283,000 Asli Kementerian Perdagangan Antarabangsa 877,835,800 dan Industri Kementerian Perdagangan Dalam Negeri 1,019,962,600 dan Hal Ehwal Pengguna Kementerian Pembangunan Usahawan 214,310,900 Kementerian Kerja Raya 1,792,114,200 Tajuk Maksud B. 28 Kementerian Pengangkutan B. 30 Kementerian Tenaga, Sains, Teknologi, Alam Sekitar dan Perubahan Iklim B. 31 Kementerian Pelancongan, Seni dan Budaya B. 32 Kementerian Wilayah Persekutuan B. 40 Suruhanjaya Perkhidmatan Pendidikan B. 42 Kementerian Kesihatan B. 43 Kementerian Perumahan dan Kerajaan Tempatan B. 45 Kementerian Belia dan Sukan B. 46 Kementerian Sumber Manusia B. 47 Kementerian Komunikasi dan Multimedia B. 48 Kementerian Pembangunan Wanita, Keluarga dan Masyarakat B. 60 Kementerian Pertahanan B. 62 Kementerian Dalam Negeri B. 63 Kementerian Pendidikan JUMLAH"
