      "schema:text": {
        "@language": "en",
        "@value": "in subsection (11), by substituting for the words “or (10)” the words “, (10) or (10A)”.”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/33/eng@/~chp_VII__cl_39__list_5",
