      "schema:text": {
        "@language": "en",
        "@value": "This Chapter comes into operation on 1 January 2020. Amendment of First Schedule"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/33/eng@/~chp_IV__cl_29",
      "@type": "akn:clause",
