        "@language": "en",
        "@value": "AMENDMENT TO THE STAMP ACT 1949 Commencement of amendment to the Stamp Act 1949"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/33/eng@/~chp_IV__cl_28",
