      "schema:text": {
        "@language": "en",
        "@value": "Sections 4, 7, 8, 9, 14, 21 and 22, and paragraph 20(a) have effect for the year of assessment 2020 and subsequent years of assessment."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/33/eng@/~chp_II__cl_3__subsec_4",
