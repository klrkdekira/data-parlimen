      "schema:text": {
        "@language": "en",
        "@value": "Section 12 and paragraph 16(b) come into operation on the coming into operation of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/33/eng@/~chp_II__cl_3__subsec_6",
