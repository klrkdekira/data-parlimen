      "schema:text": {
        "@language": "en",
        "@value": "Paragraph 5(a) has effect from the year of assessment 2020 until the year of assessment 2025."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/33/eng@/~chp_II__cl_3__subsec_2",
