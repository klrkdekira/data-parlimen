      "schema:text": {
        "@language": "en",
        "@value": "in the proviso to paragraph (k), by substituting for the words “seven hundred thousand ringgit” the words “one million ringgit”. Amendment of section 44"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/33/eng@/~chp_II__cl_8",
      "@type": "akn:clause",
