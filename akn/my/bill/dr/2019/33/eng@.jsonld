      "schema:text": {
        "@language": "en",
        "@value": "Paragraphs 5(b), 16(a) and 20(b), and sections 10, 11, 13, 15, 17 and 18 come into operation on 1 January 2020."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/33/eng@/~chp_II__cl_3__subsec_5",
