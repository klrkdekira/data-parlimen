      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/33/eng@/~chp_II__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "in Part I—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/33/eng@/~chp_II__cl_20__para_a__subpara_i",
