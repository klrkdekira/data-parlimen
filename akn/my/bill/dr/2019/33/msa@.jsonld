      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/33/msa@/~chp_VII__cl_39"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/33/msa@/~chp_VII__cl_39__list_2__para_a",
