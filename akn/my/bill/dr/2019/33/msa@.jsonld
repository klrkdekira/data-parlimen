      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1A)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/33/msa@/~chp_II__cl_15__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
