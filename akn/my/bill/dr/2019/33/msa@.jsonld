      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “subsection 103(1A), (3), (4), (5), (6), (7) or (8)” dengan perkataan “subsection 103(1A), (3), (5) or (7)”; dan"
