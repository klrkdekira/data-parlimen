      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan 5(b), 16(a) dan 20(b), dan seksyen 10, 11, 13, 15, 17 dan 18 mula berkuat kuasa pada 1 Januari 2020."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/33/msa@/~chp_II__cl_3__subsec_5",
