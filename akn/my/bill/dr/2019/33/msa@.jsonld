      "schema:text": {
        "@language": "ms",
        "@value": "dalam teks bahasa kebangsaan, dengan menggantikan seksyen 6 dengan seksyen yang berikut: “Pindaan seksyen 49 6. Akta ibu dipinda dalam seksyen 49 dengan menggantikan subseksyen (1A) dengan subseksyen yang berikut: “(1A) For the purposes of subsection (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/33/msa@/~chp_VII__cl_39__list_2",
      "@type": "akn:list",
