      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan noktah bertindih dengan noktah; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/33/msa@/~chp_II__cl_15__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
