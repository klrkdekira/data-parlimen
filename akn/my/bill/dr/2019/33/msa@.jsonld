      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (9), dengan menggantikan perkataan “subsection (1A), (3), (4), (5), (6), (7) or (8)” dengan perkataan “subsection (1A), (3), (5) or (7)”. Pindaan seksyen 104"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/33/msa@/~chp_II__cl_16",
      "@type": "akn:clause",
