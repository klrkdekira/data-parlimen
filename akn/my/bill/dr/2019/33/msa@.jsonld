      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan 5(a) berkuat kuasa mulai tahun taksiran 2020 sehingga tahun taksiran 2025."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/33/msa@/~chp_II__cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/33/msa@/~chp_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 6 berkuat kuasa bagi tahun taksiran 2019 dan tahun-tahun taksiran yang berikutnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/33/msa@/~chp_II__cl_3__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/33/msa@/~chp_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 4, 7, 8, 9, 14, 21 dan 22, dan perenggan 20(a) berkuat kuasa bagi tahun taksiran 2020 dan tahun-tahun taksiran yang berikutnya."
      }
    },
    {
