      "schema:name": {
        "@language": "ms",
        "@value": "Perenggan 104(1)(b) Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/33/msa@/~chp_II__cl_16__para_a",
