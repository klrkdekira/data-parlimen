        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/33/msa@/~chp_VIII__cl_41"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/33/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "PINDAAN KEPADA AKTA KEWANGAN 2018 Permulaan kuat kuasa pindaan kepada Akta Kewangan 2018"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/33/msa@/~chp_VIII__cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/33/msa@/~chp_VIII",
      "schema:text": {
        "@language": "ms",
        "@value": "Bab ini disifatkan telah mula berkuat kuasa pada 1 Januari 2019. Pindaan seksyen 71"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/33/msa@/~chp_VIII__cl_41",
      "@type": "akn:clause",
      "eli:number": "41",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/33/msa@/~chp_VIII",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Kewangan 2018 dipinda dengan menggantikan seksyen 71 dengan seksyen yang berikut: “Permulaan kuat kuasa pindaan kepada Akta Cukai Aktiviti Perniagaan Labuan 1990 71. (1) Seksyen 72, 73, 74 dan 75 mula berkuat kuasa pada 1 Januari 2019. (2) Seksyen 76, 77, 78, 79, 80, 81 dan 82 berkuat kuasa bagi tahun taksiran 2020 dan tahun-tahun taksiran yang berikutnya.”."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/33/msa@/~chp_VII__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/33/msa@/~chp_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Bab ini mula berkuat kuasa apabila berkuatkuasanya Akta ini. Pindaan kepada Akta Kewangan 2010"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/33/msa@/~chp_VII__cl_39",
