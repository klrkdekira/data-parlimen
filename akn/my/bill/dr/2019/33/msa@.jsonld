      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 12 dan perenggan 16(b) mula berkuat kuasa apabila berkuatkuasanya Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/33/msa@/~chp_II__cl_3__subsec_6",
