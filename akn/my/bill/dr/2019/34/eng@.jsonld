      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/34/eng@/~cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (3) the following subsection: “(3 a) Upon approving the application under subsection (1), the Registrar may require the applicant to pay such amount of fee as may be prescribed.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/34/eng@/~cl_11__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/34/eng@/~cl_11",
      "schema:text": {
        "@language": "en",
