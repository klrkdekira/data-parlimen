      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/34/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 37(1) Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/34/msa@/~cl_18__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/34/msa@/~cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “yang,” perkataan “berhubung dengan tawaran untuk menjual sesuatu francais atau semasa penjualan sesuatu francais,”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/34/msa@/~cl_18__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/34/msa@/~cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (c), dengan memotong perkataan “berhubungan dengan tawaran untuk menjual atau penjualan francais,”. Pindaan seksyen 42"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/34/msa@/~cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
