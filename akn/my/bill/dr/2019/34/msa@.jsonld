      "schema:text": {
        "@language": "ms",
        "@value": "dalam nota bahu, dengan menggantikan perkataan “dokumen penzahiran” dengan perkataan “dokumen sokongan bagi pendaftaran francais”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/34/msa@/~cl_10__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
