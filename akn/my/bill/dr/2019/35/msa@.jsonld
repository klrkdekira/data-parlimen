      ],
      "schema:name": {
        "@language": "ms",
        "@value": "RUU Hak Cipta (Pindaan) 2019"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/35/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/35/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/35/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/35/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/35/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/35/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Hak Cipta (Pindaan) 2019."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/35/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/35/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta. Pindaan seksyen 28"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/35/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/35/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Hak Cipta 1987 [Akta 332], yang disebut “Akta ibu” dalam Akta ini, dipinda dalam perenggan 28(2)(d) dengan menggantikan perkataan “seksyen 31” dengan perkataan “seksyen 31 dan 59c”. Pindaan seksyen 35"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/35/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/35/msa@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/35/msa@/~cl_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/35/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 35 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/35/msa@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/35/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (a), dengan memasukkan selepas perkataan “dirujuk kepada” perkataan “, atau apa-apa pertikaian boleh didengar oleh,”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/35/msa@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/35/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (b), dengan memasukkan selepas perkataan “dirujuk kepadanya” perkataan “, atau mendengar apa-apa pertikaian,”. Seksyen baharu 59c"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/35/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/35/msa@/~cl_4__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/35/msa@/~cl_4__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/35/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memasukkan selepas seksyen 59b seksyen yang berikut: “Pertikaian yang berhubungan dengan royalti 59c. (1) Tribunal boleh mendengar apa-apa pertikaian yang berhubungan dengan royalti yang berbangkit antara suatu badan pelesenan dengan mana-mana anggotanya tertakluk kepada persetujuan badan pelesenan dan anggota itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/35/msa@/~cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/35/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Tribunal hendaklah memutuskan pertikaian di bawah subseksyen (1) dan membuat suatu perintah dengan sewajarnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/35/msa@/~cl_4__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/35/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu perintah di bawah subseksyen (2) bolehlah dibuat supaya berkuat kuasa tanpa ditetapkan tempohnya atau bagi apa-apa tempoh yang ditentukan oleh Tribunal.”."
      }
    }
  ]
}
