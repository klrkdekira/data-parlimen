      ],
      "schema:name": {
        "@language": "ms",
        "@value": "RUU Lembaga Promosi Kesihatan Malaysia (Pembubaran) 2019"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Lembaga Promosi Kesihatan Malaysia (Pembubaran) 2019."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta. Tafsiran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Dalam Akta ini, melainkan jika konteksnya menghendaki makna yang lain—"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "“Lembaga” ertinya Lembaga Promosi Kesihatan Malaysia yang ditubuhkan di bawah Akta Lembaga Promosi Kesihatan Malaysia 2006; “Menteri” ertinya Menteri yang dipertanggungkan dengan tanggungjawab bagi kesihatan; “Pesuruhjaya Tanah Persekutuan” ertinya Pesuruhjaya Tanah Persekutuan yang dilantik di bawah Akta Pesuruhjaya Tanah Persekutuan 1957 [Akta 349]. Pemansuhan dan pembubaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Lembaga Promosi Kesihatan Malaysia 2006 dimansuhkan dan Lembaga yang ditubuhkan di bawah Akta itu dibubarkan. Pemindahan kuasa, hak, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Segala kuasa, hak, kewajipan, liabiliti dan obligasi yang sebaik sebelum tarikh permulaan kuat kuasa Akta ini adalah kuasa, hak, kewajipan, liabiliti dan obligasi Lembaga hendaklah, pada tarikh permulaan kuat kuasa Akta ini, diturunkan kepada Kerajaan. Pemindahan Kumpulan Wang Promosi Kesihatan Malaysia"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua wang yang ada pada, atau kena dibayar kepada, Kumpulan Wang Promosi Kesihatan Malaysia, pada tarikh permulaan kuat kuasa Akta ini, hendaklah dipindahkan kepada Kerajaan. Kontrak yang sedia ada, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Segala surat ikatan, perjanjian, dokumen dan surat cara lain yang wujud sebaik sebelum tarikh permulaan kuat kuasa Akta ini dan menyentuh mana-mana harta atau wang yang dipindahkan di bawah Akta ini hendaklah terus berkuat kuasa dan berkesan sepenuhnya, terhadap atau memihak kepada Kerajaan, dan boleh dikuatkuasakan sepenuhnya dan dengan berkesannya seolah-olah, bukannya Lembaga, tetapi Kerajaan yang telah dinamakan dalam surat ikatan, perjanjian, dokumen dan surat cara lain itu dan telah menjadi suatu pihak kepada surat ikatan, perjanjian, dokumen dan surat cara lain itu. Penerusan prosiding jenayah dan sivil"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@/~cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@/~cl_7__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@/~cl_7__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@/~cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Pemansuhan Akta Lembaga Promosi Kesihatan Malaysia 2006 tidaklah menyentuh liabiliti mana-mana orang untuk didakwa atau dihukum bagi apa-apa kesalahan yang dilakukan di bawah Akta itu sebelum tarikh permulaan kuat kuasa Akta ini, atau mana- mana prosiding jenayah yang telah dibawa atau hukuman yang telah dikenakan sebelum tarikh permulaan kuat kuasa Akta ini berkenaan dengan kesalahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@/~cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa prosiding sivil atau kausa tindakan yang belum selesai atau yang wujud sebaik sebelum tarikh permulaan kuat kuasa Akta ini oleh atau terhadap Lembaga atau mana-mana yang bertindak bagi pihak Lembaga bolehlah diteruskan atau dimulakan oleh atau terhadap Kerajaan sebagaimana prosiding atau kausa tindakan itu boleh diteruskan atau dimulakan oleh atau terhadap Lembaga seolah-olah Akta ini tidak diluluskan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@/~cl_7__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa rayuan yang dibawa, atau apa-apa kebenaran untuk merayu yang dipohon, pada atau selepas tarikh permulaan kuat kuasa Akta ini, terhadap sesuatu keputusan yang diberikan sebelum tarikh permulaan kuat kuasa Akta ini dalam mana-mana prosiding undang-undang yang Lembaga menjadi suatu pihak boleh dibawa oleh atau terhadap Kerajaan sebagaimana prosiding undang-undang itu boleh dibawa oleh atau terhadap Lembaga seolah-olah Akta ini tidak diluluskan. Penerusan undang-undang, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@/~cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@/~cl_8__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@/~cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada Akta ini, semua undang-undang bertulis termasuk perundangan subsidiari yang berkuat kuasa sebaik sebelum tarikh permulaan kuat kuasa Akta ini hendaklah, sehingga dipinda atau dibatalkan, terus berkuat kuasa dan ditafsirkan seolah-olah Akta ini tidak pernah diluluskan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@/~cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa sebutan dalam mana-mana undang-undang bertulis termasuk perundangan subsidiari atau dokumen mengenai Lembaga hendaklah ditafsirkan sebagai sebutan mengenai Kerajaan. Peletakhakan harta, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@/~cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@/~cl_9__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@/~cl_9__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@/~cl_9__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@/~cl_9__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@/~cl_9__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@/~cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada Akta ini, Menteri boleh, dari semasa ke semasa, melalui perintah yang disiarkan dalam Warta, menetapkan suatu tarikh peletakhakan dan pada tarikh itu semua harta, hak, kepentingan, obligasi dan liabiliti Lembaga yang dinyatakan oleh Menteri dalam perintah itu hendaklah, menurut kuasa Akta ini, dipindahkan kepada dan terletak hak pada Kerajaan tanpa apa-apa pemindahhakan, penyerahhakan atau pemindahan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@/~cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap harta, hak, kepentingan, obligasi dan liabiliti yang dipindahkan kepada dan terletak hak pada Lembaga hendaklah dipindahkan kepada dan terletak hak pada Kerajaan dengan hakmilik, estet atau kepentingan yang serupa dan dengan tempoh pemegangan yang serupa sebagaimana harta, hak, kepentingan, obligasi dan liabiliti itu terletak hak atau dipegang sebaik sebelum tarikh peletakhakan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@/~cl_9__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana tanah yang sebaik sebelum tarikh permulaan kuat kuasa Akta ini terletak hak pada Lembaga hendaklah, pada tarikh peletakhakan, terletak hak pada Pesuruhjaya Tanah Persekutuan bagi maksud Kerajaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@/~cl_9__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika menurut kuasa subseksyen (1), apa-apa harta dipindahkan kepada dan terletak hak pada Kerajaan, peruntukan Bahagian Tiga Puluh Kanun Tanah Negara 1965 [Akta 56 Tahun 1965] hendaklah, bagi maksud melaksanakan pendaftaran bagi peletakhakan itu, terpakai bagi Kerajaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@/~cl_9__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana harta dan aset, selain tanah, yang sebaik sebelum tarikh permulaan kuat kuasa Akta ini terletak hak pada Lembaga hendaklah, pada tarikh peletakhakan, terletak hak pada Kerajaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@/~cl_9__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/36/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam hal harta, hak, kepentingan, obligasi dan liabiliti yang berbangkit di bawah apa-apa pinjaman yang terletak hak pada Kerajaan pada tarikh peletakhakan, Kerajaan boleh membuat perjanjian atau perkiraan mengenai harta, hak, kepentingan, obligasi dan liabiliti itu dengan mana-mana orang lain."
      }
    }
  ]
}
