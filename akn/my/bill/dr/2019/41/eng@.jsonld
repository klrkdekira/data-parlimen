      "schema:text": {
        "@language": "en",
        "@value": "by deleting paragraphs 30, 31 and 32;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/41/eng@/~cl_4__para_g",
      "@type": "akn:paragraph",
