      "schema:text": {
        "@language": "en",
        "@value": "by substituting for paragraph 32a the following paragraph: “32a. The appellant shall pay to the Secretary the cost for the notes of proceedings or other documents at such rate as may be prescribed by the Minister.”;"
      }
    },
