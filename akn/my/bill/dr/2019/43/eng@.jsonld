      "schema:name": {
        "@language": "en",
        "@value": "Subsection 43(8) of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/43/eng@/~cl_7__para_a",
