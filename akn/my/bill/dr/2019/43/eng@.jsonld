        "@value": "Employees Provident Fund (Amendment) Bill 2019"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/43/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
