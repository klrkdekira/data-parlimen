      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (d), by substituting for the words “moneys due” the words “the outstanding and due contributions”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/43/eng@/~cl_6__para_c",
      "@type": "akn:paragraph",
