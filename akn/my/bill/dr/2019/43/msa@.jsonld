      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “tiga” dengan perkataan “tidak lebih daripada lima”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/43/msa@/~cl_2__para_e__subpara_ii",
      "@type": "akn:subparagraph",
