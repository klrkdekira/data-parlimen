      "schema:text": {
        "@language": "ms",
        "@value": "dengan menomborkan semula seksyen yang sedia ada sebagai subseksyen (1);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/43/msa@/~cl_3__para_b",
