      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/43/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subperenggan (i), dengan memasukkan sebelum perkataan “lima” perkataan “tidak lebih daripada”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/43/msa@/~cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
