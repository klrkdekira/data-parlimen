      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 55a(2) Akta ibu dipinda dengan menggantikan perkataan “Perenggan 54(1)(c), (e) dan subseksyen” dengan perkataan “Subseksyen”. Pindaan seksyen 55b"
      }
    }
  ]
