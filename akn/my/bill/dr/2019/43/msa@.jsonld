      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 39 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/43/msa@/~cl_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
