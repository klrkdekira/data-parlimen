      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “mempunyai” perkataan “pengetahuan atau”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/43/msa@/~cl_2__para_e__subpara_iii",
