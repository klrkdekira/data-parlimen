      "schema:name": {
        "@language": "en",
        "@value": "Section 21 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_16__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (1), by inserting after the word “shall” the words “, within one year from the date the taxable service was provided or such extended period as may be approved by the Director General,”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_16__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (1) the following subsection: “(1a) Notwithstanding subsection (1), the Director General may, upon request in writing by a registered person and subject to such conditions as he deems fit, approve an invoice to not be issued if the Director General is satisfied that it will not be appropriate for the registered person to issue an invoice.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_16__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (3) the following subsection: “(3a) Notwithstanding subsection (3), where the payment for taxable services are made to any machine or device operated by coins, tokens or the like, the amount of payment shall include the amount of service tax chargeable.”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_16__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (4) the following subsection: “(5) This section shall not apply to a foreign registered person.”. Amendment of section 22"
      }
    },
