      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the definition of “taxable person” the following definition: ‘ “Pangkor” means the Pangkor Island, Mentagor Island, Giam Island, Simpan Island, Tukun Terindak Island, Pelanduk Island, Anak Pelanduk Island, Landak Island, Batu Orang Tua and Batu Jambal;’;"
      }
