    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_47",
      "@type": "akn:clause",
      "eli:number": "47",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_47__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_47__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 84 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_47__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_47",
      "schema:text": {
        "@language": "en",
        "@value": "by renumbering the existing provision as subsection (1); and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_47__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_47",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (1) as renumbered the following subsection: “(2) This section shall not apply to a foreign registered person.”. Amendment of section 86"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_48",
      "@type": "akn:clause",
      "eli:number": "48",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 86 of the principal Act is amended by inserting after subsection (3) the following subsection: “(4) This section shall not apply to a foreign registered person.”. New section 86a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_49",
      "@type": "akn:clause",
      "eli:number": "49",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting after section 86 the following section: “Service of summons 86a. (1) Every summons issued by a court against any person in connection with any civil or criminal proceedings under this Act may be served on the person named therein— (a) by delivering the summons to the person or any adult member of his family or any of his servants residing with him at his usual or last-known place of residence; (b) by leaving the summons at his usual or last-known place of residence or business in an envelope addressed to the person; (c) by sending the summons by registered post addressed to the person at his usual or last-known place of residence or business; or (d) where the person is a company, a limited liability partnership, a firm, a society, an association or other body of persons— (i) by delivering the summons to the secretary or other like officer of the company, limited liability partnership, firm, society, association or other body of persons at its registered office or principal place of business; or (ii) by sending the summons by registered post addressed to the company, limited liability partnership, firm, society, association or other body of persons at its registered office or principal place of business. (2) Any summons sent by registered post to any person in accordance with subsection (1) or by delivering the summons to the person or to any adult member of his family or any of his servant residing with him shall be deemed to be duly served on the person. (3) When a summons issued by a court is served, an affidavit of the service purporting to be made before an officer duly authorized to administer an oath shall be admissible in evidence.”. Amendment of section 91"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 10(1) of the principal Act is amended by deleting the word “provided”. Amendment of section 11"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_50",
      "@type": "akn:clause",
      "eli:number": "50",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_50__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_50__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_50__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Subsection 91(2) of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_50__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (2)(d), by inserting after the word “returns” the words “, declarations”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_50__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (2)(k), by deleting the word “or” at the end of the paragraph;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_50__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_50__para_c__subpara_A",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_50__para_c__subpara_B"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (2)(l)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_50__para_c__subpara_A",
      "@type": "akn:subparagraph",
      "eli:number": "A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_50__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the full stop at the end of the paragraph the words “; or”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_50__para_c__subpara_B",
      "@type": "akn:subparagraph",
      "eli:number": "B",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_50__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after paragraph (l) the following paragraph: “(m) all matters relating to digital services.”. Registration before effective date"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_51",
      "@type": "akn:clause",
      "eli:number": "51",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_51__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_51__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_51__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_51__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_51__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_51",
      "schema:text": {
        "@language": "en",
        "@value": "A foreign service provider who provides digital services before the coming into operation of Part IXa as introduced in section 37 of this Act (“Part IXa”) shall be liable to be registered under this Act if there are reasonable grounds for believing that the total value of his digital services provided in the month of the coming into operation of Part IXa and eleven months immediately succeeding such month will exceed the total value of digital service as prescribed under section 56b as introduced in section 37 of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_51__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_51",
      "schema:text": {
        "@language": "en",
        "@value": "Any foreign service provider who is liable to be registered under subsection (1) shall apply to the Director General to be registered as a foreign registered person and the application shall be made three months before the date of coming into operation of Part IXa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_51__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_51",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General may register the foreign service provider under subsection (1) with effect from the effective date appointed under section 1 of this Act or from a later date as the Director General may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_51__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_51",
      "schema:text": {
        "@language": "en",
        "@value": "Any foreign service provider who contravenes subsection (2) commits an offence and shall, on conviction, be liable to a fine not exceeding thirty thousand ringgit or to imprisonment for a term not exceeding two years or to both. Digital services provided before commencement date"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_52",
      "@type": "akn:clause",
      "eli:number": "52",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_52__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_52__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_52__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_52",
      "schema:text": {
        "@language": "en",
        "@value": "Where any digital service is provided before the date of coming into operation of Part IXa as introduced in section 37 of this Act (“Part IXa”) and the provision of the digital services is spanning after the date of coming into operation of Part IXa, service tax shall be charged on the proportion of the digital service which is attributed to the part of the period after the date of coming into operation of Part IXa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_52__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_52",
      "schema:text": {
        "@language": "en",
        "@value": "Where any payment is received before the date of coming into operation of Part IXa in connection with the provision of digital services that will be provided on or after the date of coming into operation of Part IXa, no service tax shall be charged on the payment received."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_6__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_6__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_6__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 11 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (1) the following subsection: “(1a) The Director General may, upon application in writing by any registered person and subject to such conditions as he deems fit, approve the service tax in respect of the taxable service provided by the registered person to be due at the time the invoice is issued.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (2), by substituting for the words “of the invoice for the taxable service provided,” the words “the taxable service was provided, the”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_6__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after paragraph (3)(a) the following paragraph: “(aa) where any taxable service is provided by any registered person and payment for such taxable service is made to any machine or device operated by coins, tokens or the like, the service tax required to be accounted shall be due on the day when the coins, tokens or the like are collected from such machine or device;”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_6__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (4) the following subsection: “(5) Paragraph (3)(c) shall not apply to a service which is prescribed as a taxable service with effect from 1 September 2018.”. Amendment of section 12"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 12 of the principal Act is amended by inserting after subsection (4) the following subsection: “(5) This section shall not apply to a foreign service provider.”. Amendment of section 13"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 13 of the principal Act is amended by inserting after subsection (5) the following subsection: “(6) This section shall not apply to a foreign service provider.”. Amendment of section 14"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2019/6/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 14 of the principal Act is amended by inserting after subsection (2) the following subsection: “(3) This section shall not apply to a foreign service provider.”. Amendment of section 15"
      }
    }
  ]
}
