      "schema:name": {
        "@language": "en",
        "@value": "Supplementary Supply (2019) Bill 2020"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/1/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/1/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Supplementary Supply (2019) Act 2020. Additional expenditure for the year 2019"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/1/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/1/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The issue is hereby authorised of a sum not exceeding seven billion five million seven hundred and fifty-three thousand eight hundred and fifty ringgit (RM7,005,753,850) from the Consolidated Fund for additional expenditure on the services and purposes specified in the Schedule for the year 2019 not provided for or not fully provided for by the Supply Act 2019 [Act A1575]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/1/eng@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/1/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Purpose Title B. 4 Election Commission B. 10 Treasury B. 11 Treasury General Services B. 12 Contribution to Statutory Funds B. 13 Ministry of Foreign Affairs B. 15 Ministry of Economic Affairs B. 20 Ministry of Primary Industries B. 21 Ministry of Agriculture and Agro-Based Industry B. 23 Ministry of Water, Land and Natural Resources B. 24 Ministry of International Trade and Industry B. 27 Ministry of Works B. 28 Ministry of Transport B. 42 Ministry of Health B. 43 Ministry of Housing and Local Government B. 60 Ministry of Defence B. 63 Ministry of Education TOTAL 7,005,753,850"
      }
    }
