      "schema:name": {
        "@language": "ms",
        "@value": "RUU Kaedah-Kaedah Mahkamah Rendah (Pindaan) 2020"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/10/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/10/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/10/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/10/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/10/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/10/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Kaedah-Kaedah Mahkamah Rendah (Pindaan) 2020."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/10/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/10/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta. Pindaan seksyen 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/10/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/10/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Kaedah-Kaedah Mahkamah Rendah 1955 [Akta 55], yang disebut “Akta ibu” dalam Akta ini, dipinda dalam seksyen 2 dengan memasukkan selepas takrif “prosiding” takrif yang berikut: ‘ “teknologi komunikasi jarak jauh” ertinya suatu rangkaian video secara langsung, rangkaian televisyen secara langsung atau apa-apa cara komunikasi elektronik yang lain;’. Pindaan seksyen 3"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/10/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/10/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 3(2) Akta ibu dipinda dengan menggantikan perenggan (f) dengan perenggan yang berikut: “(f) Ketua Pendaftar Mahkamah Persekutuan;”. Pindaan seksyen 4"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/10/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/10/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 4 Akta ibu dipinda dengan memasukkan selepas perenggan (a) perenggan yang berikut: “(aa) bagi mengawal selia dan menetapkan tatacara dan amalan yang hendaklah diikuti di Mahkamah Rendah dalam segala kausa dan perkara apa jua pun dalam atau yang berkenaan dengan pendengaran apa-apa perkara atau prosiding melalui suatu teknologi komunikasi jarak jauh;”."
      }
    }
  ]
}
