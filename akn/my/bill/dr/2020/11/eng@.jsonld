      ],
      "schema:name": {
        "@language": "en",
        "@value": "Co-operative Societies (Amendment) Bill 2020"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/eng@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 72(1) of the principal Act is amended by substituting for the word “fifteen” the word “five”. Transitional"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/eng@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "All regulations, directives, guidelines, circulars and notices made, issued or given under the principal Act before the date of coming into operation of this Act, which are inconsistent with the provisions of the principal Act as amended by this Act, shall, on the date of coming into operation of this Act, cease to have effect."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Co-operative Societies (Amendment) Act 2020."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Amendment of section 5"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Co-operative Societies Act 1993 [Act 502], which is referred to as the “principal Act” in this Act, is amended in paragraph 5(1)(a) by substituting for the word “fifty” the word “twenty”. Amendment of section 6"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/eng@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/eng@/~cl_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 6 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/eng@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (1)(a), by substituting for the word “ten” the word “five”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/eng@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (2)(b), by substituting for the word “twenty-five” the word “ten”. Amendment of section 8"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 8(1) of the principal Act is amended by substituting for the word “twenty” the word “five”. Amendment of section 12"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraph 12(b) of the principal Act is amended by deleting the words “with the prior written approval of the Commission,”. Amendment of section 24"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/eng@/~cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/eng@/~cl_6__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/eng@/~cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraph 24(1)(a) of the principal Act is amended by inserting after the words “Muslim,” the words “to the person nominated in accordance with the regulations in his behalf or, if there is no person so nominated,”."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/eng@/~cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "Any nomination of a nominee by a Muslim member of a co-operative society made before the date of coming into operation of this Act shall continue to remain valid. Amendment of section 42"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 42 of the principal Act is amended by substituting for the word “six” the word “three”. Amendment of section 42a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/eng@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 42a(1) of the principal Act is amended by substituting for the word “three” the word “two”. Amendment of section 50"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/eng@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/eng@/~cl_9__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/eng@/~cl_9__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/eng@/~cl_9__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 50 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/eng@/~cl_9__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/eng@/~cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "by renumbering the existing section as subsection (1);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/eng@/~cl_9__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/eng@/~cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (1) as renumbered, by inserting after paragraph (e), the following paragraph: “(ea) loans from any licensed financial institution, or co-operative society as may be determined by the Commission;”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/eng@/~cl_9__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/eng@/~cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (1) as renumbered, the following subsection: “(2) For the purposes of paragraph (1)(ea), “licensed financial institution” means— (a) a licensed bank under the Financial Services Act 2013 [Act 758]; (b) a licensed Islamic bank under the Islamic Financial Services Act 2013 [Act 759]; and (c) a prescribed institution under the Development Financial Institutions Act 2002 [Act 618].”. Amendment of section 72"
      }
    }
  ]
}
