      ],
      "schema:name": {
        "@language": "ms",
        "@value": "RUU Koperasi (Pindaan) 2020"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/msa@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 72(1) Akta ibu dipinda dengan menggantikan perkataan “lima belas” dengan perkataan “lima”. Peralihan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/msa@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua peraturan-peraturan, arahan, garis panduan, surat pekeliling dan notis yang dibuat, dikeluarkan atau diberikan di bawah Akta ibu sebelum tarikh permulaan kuat kuasa Akta ini, yang tidak selaras dengan peruntukan Akta ibu sebagaimana yang dipinda oleh Akta ini, hendaklah, pada tarikh permulaan kuat kuasa Akta ini, terhenti berkuat kuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Koperasi (Pindaan) 2020."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta. Pindaan seksyen 5"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Koperasi 1993 [Akta 502], yang disebut “Akta ibu” dalam Akta ini, dipinda dalam perenggan 5(1)(a) dengan menggantikan perkataan “lima puluh” dengan perkataan “dua puluh”. Pindaan seksyen 6"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/msa@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/msa@/~cl_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 6 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/msa@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (1)(a), dengan menggantikan perkataan “sepuluh” dengan perkataan “lima”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/msa@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (2)(b), dengan menggantikan perkataan “dua puluh lima” dengan perkataan “sepuluh”. Pindaan seksyen 8"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 8(1) Akta ibu dipinda dengan menggantikan perkataan “dua puluh” dengan perkataan “lima”. Pindaan seksyen 12"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan 12(b) Akta ibu dipinda dengan memotong perkataan “dengan kelulusan bertulis terlebih dahulu Suruhanjaya,”. Pindaan seksyen 24"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/msa@/~cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/msa@/~cl_6__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/msa@/~cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan 24(1)(a) Akta ibu dipinda dengan memasukkan selepas perkataan “beragama Islam,” perkataan “kepada orang yang dinamakan mengikut peraturan-peraturan bagi pihak anggota yang mati atau, jika tiada orang yang dinamakan sedemikian,”."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/msa@/~cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa penamaan penama oleh seseorang anggota koperasi beragama Islam yang dibuat sebelum tarikh permulaan kuat kuasa Akta ini hendaklah terus kekal sah. Pindaan seksyen 42"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/msa@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 42 Akta ibu dipinda dengan menggantikan perkataan “enam” dengan perkataan “tiga”. Pindaan seksyen 42a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/msa@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 42a(1) Akta ibu dipinda dengan menggantikan perkataan “tiga” dengan perkataan “dua”. Pindaan seksyen 50"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/msa@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/msa@/~cl_9__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/msa@/~cl_9__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/msa@/~cl_9__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 50 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/msa@/~cl_9__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menomborkan semula seksyen yang sedia ada sebagai subseksyen (1);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/msa@/~cl_9__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1) yang dinomborkan semula, dengan memasukkan selepas perenggan (e), perenggan yang berikut: “(ea) pinjaman daripada mana-mana institusi kewangan yang berlesen, atau koperasi sebagaimana yang ditentukan oleh Suruhanjaya;”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/msa@/~cl_9__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/11/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (1) yang dinomborkan semula, subseksyen yang berikut: “(2) Bagi maksud perenggan (1) (ea), “institusi kewangan yang berlesen” ertinya— (a) suatu bank yang dilesenkan di bawah Akta Perkhidmatan Kewangan 2013 [Akta 758]; (b) suatu bank Islam yang dilesenkan di bawah Akta Perkhidmatan Kewangan Islam 2013 [Akta 759]; dan (c) suatu institusi yang ditetapkan di bawah Akta Institusi Kewangan Pembangunan 2002 [Akta 618].”. Pindaan seksyen 72"
      }
    }
  ]
}
