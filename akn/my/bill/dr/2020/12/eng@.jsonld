      "schema:text": {
        "@language": "en",
        "@value": "ADMINISTRATION Secretary"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_14__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_14__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "The Commission shall have a Secretary who shall be the chief executive officer of the Commission."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "The Secretary shall be appointed by the Minister who shall be an officer of the Commission."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_14__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "The Secretary shall be appointed on such terms and shall have such functions as the Commission may determine. Temporary exercise of functions of Secretary"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_15__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_15__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_15__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "The Commission may, with the consent of the Minister, appoint any officer of the Commission to act temporarily as the Secretary during any period when—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_15__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "the office of the Secretary is vacant;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_15__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "the Secretary is absent from duty or from Malaysia; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_15__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "the Secretary is, for any other reason, unable to perform the duties of his office. Officers and staff of Commission"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_16__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_16__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_16__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_16__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_16__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The Commission shall appoint such number of officers and staff of the Commission as may be necessary be to assist the Commission in discharging its functions and exercising its powers effectively and efficiently and for the purpose of carrying into effect the provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The Commission may appoint any officers from any government agency on secondment basis to be its investigators."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_16__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The Commission may appoint such number of legal officers as may be necessary who shall be seconded from amongst officers of the Judicial and Legal Service to assist the Commission."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_16__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "An officer of the Commission having, directly or indirectly, by himself, a member of his family or his associate, any interest or connection to a member of the police force under investigation by the Commission shall disclose his interest or connection forthwith to the Chairman and shall not be involved in any investigation conducted by the Commission as regards that member of the police force. Consultants"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_17__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "The Commission may engage any person from amongst public servants and public servants retirees, on such terms as the Commission may impose, as consultants or to perform such services as the Commission thinks appropriate."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "A person engaged under subsection (1) having directly or indirectly, by himself, a member of his family or his associate, any interest or connection to a member of the police force under investigation by the Commission shall disclose his interest or connection forthwith to the Chairman and shall not be involved in any investigation conducted by the Commission as regards that member of the police force. Committees"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_18__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_18__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_18__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_18__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_18__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_18__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "The Commission may establish such committees to assist the Commission in the performance of its functions under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "The Commission may appoint any of its members to be the chairman of a committee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_18__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "The Commission may appoint any member or officer of the Commission to be a member of any committee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_18__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "A committee shall be subject to and act in accordance with the direction given to the committee by the Commission."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_18__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "The Commission may at any time discontinue or alter the constitution of a committee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_18__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "A member of a committee shall be paid such allowances as the Minister may determine. Authority card"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_19__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_19__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_19__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_19__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this Act, an authority card shall be issued to a member and an officer of the Commission."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_19__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "The authority card shall be signed by the Chairman of the Commission and such card shall be prima facie evidence of the appointment under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_19__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "A member or an officer of the Commission acting under this Act shall, on demand, declare his office and produce the authority card issued to him to the person against whom he is acting or from whom he seeks any information. Use of officers, staff or facilities of government department, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_20__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_20__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_20__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_20__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_20__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "The Commission may request and arrange for the use of the services of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_20__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_20__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any staff or facilities of a government department or a local or statutory authority; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_20__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_20__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any government officer including a member of the police force, to cooperate with, or assist in the exercise of its duties, or to assist the Commission in the performance of its functions under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_20__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "It shall be the duty of the government departments or local or statutory authority or government officer referred to in subsection (1) to comply with a request under this section. Consultation with other agencies"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "The Commission may consult with and disseminate information to other enforcement agencies, any Federal or State government department or any person or body as the Commission thinks appropriate."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_10__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_10__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_10__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_10__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_10__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_10__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The Commission shall meet at least twice a month or as often as may be necessary for the performance of its functions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The Chairman shall preside at all meetings of the Commission."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_10__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The quorum of a meeting of the Commission shall be three."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_10__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "Every member of the Commission present shall be entitled to one vote and if on a question to be determined by the Commission there is an equality of votes, the Chairman shall have a casting vote."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_10__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The Commission shall cause minutes of all its meetings to be maintained and kept in a proper form."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_10__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The Commission may invite any person or any representative from the police force appointed by the Inspector General of Police to attend its meeting for the purpose of advising the Commission on any matter under discussion but that person shall not be entitled to vote at the meeting or be present during the making of a decision."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_10__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The Commission shall regulate its own proceedings. Temporary exercise of functions of Chairman"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection 10(2), where the Chairman is unable to perform his functions for any reason, or during any period of vacancy in the office of the Chairman, the Deputy Chairman or, if he is unavailable, any member of the Commission appointed by the other members of the Commission shall perform the functions of the Chairman. Disclosure of interest"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_12__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "A member of the Commission having, directly or indirectly, by himself, a member of his family or his associate, any interest in any matter under discussion by the Commission or in any discussion on a misconduct before the Commission shall disclose to the Commission the fact and nature of his interest."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The disclosure of interest of a member of the Commission referred to in subsection (1) shall be recorded in the minutes or notes of the discussion on the misconduct and the member of the Commission shall recuse himself from taking part in such discussion or in the making of any decision by the Commission relating to the misconduct. Delegation of functions and powers of Commission"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_13__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_13__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_13__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_13__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_13__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_13__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_13__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The Commission may delegate its functions and powers to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_13__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_13__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any member of the Commission;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_13__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_13__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any officer of the Commission;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_13__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_13__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any committee; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_13__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_13__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any member of the police force."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The member of the Commission, officer of the Commission, committee or member of the police force delegated with such functions and powers under subsection (1) shall be bound to observe and have regard to all conditions and restrictions imposed by the Commission and all requirements, procedures and matters specified by the Commission relating to such delegation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_13__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "Any function and power delegated under this section shall be performed and exercised in the name and on behalf of the Commission."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_13__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "A delegation under this section shall not preclude the Commission itself from performing or exercising at any time any of the delegated functions and powers."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_3__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_3__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_3__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "The Independent Police Conduct Commission is established."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "The Commission shall be a body corporate and shall have perpetual succession and a common seal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_3__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "The Commission may sue and be sued in its name."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_3__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_3__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_3__subsec_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_3__subsec_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "The Commission may, upon such terms as the Commission thinks fit and for the purposes of this Act—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_3__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_3__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "enter into contracts;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_3__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_3__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "acquire, purchase, take, hold and enjoy movable and immovable property of every description; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_3__subsec_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_3__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "convey, assign, surrender, yield up, charge, mortgage, demise, reassign, transfer or otherwise dispose of, or deal with, any movable or immovable property or any interest in the property vested in the Commission. Functions of Commission"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_4__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_4__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "The functions of the Commission shall be as follows:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "to promote integrity within the members of the police force;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "to advise the Government and make recommendations on appropriate measures to be taken in the promotion of integrity within the members of the police force;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "to protect the interest of the public by dealing with misconduct of any member of the police force; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_4__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "to formulate and put in place mechanism for receiving complaints and investigation of misconduct of any member of the police force. Powers of Commission"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_5__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The Commission shall have the power and may do all things necessary for or in connection with, or incidental to, the performance of its functions under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_5__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_5__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_5__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_5__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_5__subsec_2__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to the generality of subsection (1), the Commission may—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_5__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "advise the Government on the enhancement of the well-being and welfare of members of the police force;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_5__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "visit any place and premises such as police stations, police quarters, lock-ups and detention centres by giving early notice to the relevant Head of Department and to make any necessary recommendations;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_5__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "receive and assess any written complaint of misconduct from any person against any member of the police force and investigate the complaint;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_5__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "collect evidence relating to any written complaint and investigation of misconduct under this Act; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_5__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "make a recommendation for disciplinary action against any misconduct committed by any member of the police force to the Police Force Commission. Members of Commission"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_6__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The Yang di-Pertuan Agong shall, on the advice of the Prime Minister, appoint not more than seven members of the Commission, one of whom shall be appointed as the Chairman and another as the Deputy Chairman."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The members of the Commission shall be subject to such terms as may be specified in the instrument of appointment."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The members of the Commission shall have knowledge, skill and experience, or shown capacity and professionalism, in matters relating to law, administration, investigation, finance or any other matter relevant to the functions of the Commission. Term of office"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_7__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_7__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subsection (2), a member of the Commission shall hold office for a term not exceeding three years as may be specified in his instrument of appointment and he shall be eligible for reappointment."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "A member of the Commission may at any time resign his office by letter addressed to the Yang di-Pertuan Agong."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_7__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "The appointment of a member of the Commission may at any time be revoked by the Yang di-Pertuan Agong on the advice of the Prime Minister. Remuneration"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "A member of the Commission shall be paid such remuneration and allowances as the Prime Minister may determine. Vacation of office"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_9__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_9__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_9__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_9__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_9__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_9__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_9__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_9__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_9__para_i"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II",
      "schema:name": {
        "@language": "en",
        "@value": "The office of a member of the Commission shall be vacated if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_9__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "he dies;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_9__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_9__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_9__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_9__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "there has been proved against him, or he has been convicted on, a charge in respect of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_9__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_9__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "an offence involving fraud, dishonesty or moral turpitude;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_9__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_9__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "an offence under any law relating to corruption; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_9__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_9__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "any other offence punishable with imprisonment or fine of not more than two thousand ringgit;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_9__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "he becomes a bankrupt;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_9__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "he is of unsound mind or is otherwise incapable of discharging his duties;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_9__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "he absents himself from three consecutive meetings of the Commission without leave of the Chairman;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_9__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "he is elected or appointed as a member of a House of Parliament or the State Legislature of any State;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_9__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "his resignation has been accepted by the Yang di-Pertuan Agong;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_9__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "his appointment has been revoked by the Yang di-Pertuan Agong; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_9__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "his term of appointment has expired. Meetings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_IV__cl_22",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/12/eng@/~part_IV__cl_23",
