      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (e), dengan memotong perkataan “atau” di hujung perenggan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_39__para_c",
      "@type": "akn:paragraph",
