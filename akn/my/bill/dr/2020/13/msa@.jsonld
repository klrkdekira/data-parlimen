        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_14__para_c__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_14__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_14__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (d), dengan memotong perkataan “atau orang yang bekerja sendiri”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_14__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_14__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (e), dengan menggantikan noktah di hujung perenggan itu dengan koma bernoktah; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_14__para_c__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_14__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan (e) perenggan yang berikut: “(f) pembangunan dan pelaksanaan tatacara bagi berurusan dengan kecemasan yang boleh timbul semasa pekerjanya sedang bekerja.”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_14__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong subseksyen (3). Pindaan seksyen 16"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_15",
      "@type": "akn:clause",
