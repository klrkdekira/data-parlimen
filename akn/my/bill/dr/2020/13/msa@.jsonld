        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_10__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 11 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_10__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_10__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_10__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_10__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_10__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (i), dengan menggantikan noktah di hujung perenggan itu dengan koma bernoktah; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_10__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_10__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan (i) perenggan yang berikut: “(j) prosedur, perkiraan, latihan, pendidikan atau langkah-langkah wajar yang perlu diambil untuk meningkatkan kesedaran masyarakat terhadap keselamatan, kesihatan dan kebajikan pekerjaan; (k) bidang penyelidikan keselamatan dan kesihatan pekerjaan yang akan dibangunkan oleh institusi yang relevan dan penerbitan hasil penyelidikan tersebut; (l) pembangunan dan pewujudan suatu mekanisme untuk menjana, memproses, menyimpan dan menyebar maklumat tentang keselamatan, kesihatan dan kebajikan pekerjaan.”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_10__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (2) subseksyen yang berikut: “(3) Majlis hendaklah menyelaraskan semua perkara dan aktiviti yang berhubungan dengan keselamatan dan kesihatan pekerjaan yang dilaksanakan atau dijalankan oleh Kerajaan.”. Pindaan seksyen 12"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan menggantikan subseksyen (1) dengan subseksyen yang berikut: “(1) Ketua Pengarah, yang merupakan anggota Majlis di bawah perenggan 9(1)(d), hendaklah menjadi setiausaha kepada Majlis.”. Pindaan seksyen 14"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_12__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_12__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 14 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_12__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “dengan seberapa segera yang boleh dipraktikkan, selepas 30 Jun tetapi sebelum 31 Disember setiap tahun” dengan perkataan “selepas 31 Disember tetapi sebelum 31 Mac tahun yang berikut,”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_12__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “30 Jun” dengan perkataan “31 Disember”. Pindaan kepala Bahagian IV"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan menggantikan kepala Bahagian IV dengan kepala yang berikut: “KEWAJIPAN AM MAJIKAN, ORANG YANG BEKERJA SENDIRI DAN PRINSIPAL”. Pindaan seksyen 15"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_14__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_14__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_14__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_14__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 15 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_14__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam nota bahu, dengan memotong perkataan “dan orang yang bekerja sendiri kepada pekerja mereka”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_14__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1), dengan memotong perkataan “dan tiap-tiap orang yang bekerja sendiri”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_14__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_14__para_c__subpara_i",
