      "schema:text": {
        "@language": "ms",
        "@value": "dalam nota bahu, dengan memasukkan selepas perkataan “pemeriksaan” perkataan “, penelitian atau penyiasatan”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_39__para_b",
      "@type": "akn:paragraph",
