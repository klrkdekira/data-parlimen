        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_41__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 49(2) Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_41__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “lima puluh ribu” dengan perkataan “lima ratus ribu”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_41__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “lima tahun” dengan perkataan “dua tahun”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_41__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “lima ratus” dengan perkataan “dua ribu”. Pindaan seksyen 51"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_42",
      "@type": "akn:clause",
      "eli:number": "42",
      "hasPart": [
