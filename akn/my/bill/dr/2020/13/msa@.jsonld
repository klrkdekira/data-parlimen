      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan (e) perenggan yang berikut: “(ea) tidak mematuhi apa-apa arahan yang diberikan oleh seseorang pegawai yang semunasabahnya perlu bagi maksud apa-apa pemeriksaan, penelitian atau penyiasatan; atau”. Pindaan seksyen 48"
      }
    },
