      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 47 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_39__para_a",
      "@type": "akn:paragraph",
