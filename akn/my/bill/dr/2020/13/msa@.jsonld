      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong takrif “industri”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_3__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_3__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan sebelum takrif “kerajaan” takrif yang berikut: ‘ “kecederaan badan yang serius” ertinya apa-apa kecederaan sebagaimana yang dinyatakan dalam Jadual Keempat;’;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_3__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_3__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif “kesatuan sekerja” takrif yang berikut: ‘ “Ketua Pengarah” ertinya Ketua Pengarah Keselamatan dan Kesihatan Pekerjaan yang dilantik di bawah subseksyen 5(1); “kontraktor” ertinya mana-mana orang yang membuat kontrak dengan seorang prinsipal untuk menjalankan keseluruhan atau sebahagian apa-apa kerja yang diusahakan oleh prinsipal itu dalam penjalanan atau bagi maksud perdagangan, perniagaan, profesion atau pengusahaan prinsipal itu;’;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_3__para_a__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_3__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan takrif “majikan” dengan takrif yang berikut: ‘ “majikan” ertinya mana-mana orang yang membuat suatu kontrak perkhidmatan untuk mengambil kerja mana-mana orang lain sebagai pekerja;’;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_3__para_a__subpara_ix",
      "@type": "akn:subparagraph",
      "eli:number": "ix",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_3__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan takrif “pegawai” dengan takrif yang berikut: ‘ “pegawai” ertinya pegawai yang dilantik di bawah subseksyen 5(1) dan (3);’;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_3__para_a__subpara_v",
      "@type": "akn:subparagraph",
