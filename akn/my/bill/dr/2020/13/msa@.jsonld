        "@language": "ms",
        "@value": "RUU Keselamatan dan Kesihatan Pekerjaan (Pindaan) 2020"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_1",
