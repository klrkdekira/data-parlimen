      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 63(1) Akta ibu dipinda dengan memotong perkataan “36 atau”. Pindaan seksyen 64"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_48",
      "@type": "akn:clause",
      "eli:number": "48",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 64(1) Akta ibu dipinda dengan memotong perkataan “sesuatu perintah yang dibuat oleh Ketua Pengarah di bawah seksyen 35,”. Pindaan seksyen 66"
      }
    },
