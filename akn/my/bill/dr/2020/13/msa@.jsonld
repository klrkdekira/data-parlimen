    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memasukkan selepas seksyen 28 seksyen yang berikut: “Tiada tindakan terhadap orang yang menjalankan perkhidmatan kesihatan pekerjaan 28a. Tiada majikan boleh mengambil apa-apa tindakan terhadap mana-mana orang yang menjalankan perkhidmatan kesihatan pekerjaan kerana— (a) membuat suatu aduan mengenai apa-apa perkara yang dianggap sebagai suatu risiko kepada kesihatan; atau (b) membuat laporan kepada Ketua Pengarah mengenai mana-mana pesakit yang dipercayainya menghidapi apa-apa penyakit pekerjaan atau keracunan pekerjaan.”. Pindaan seksyen 29"
      }
    },
