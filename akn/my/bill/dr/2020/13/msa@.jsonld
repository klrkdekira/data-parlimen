      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan nota bahu dengan nota bahu yang berikut: “Kewajipan majikan untuk membentuk dasar keselamatan dan kesihatan pekerjaan”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/13/msa@/~cl_15__para_b",
      "@type": "akn:paragraph",
