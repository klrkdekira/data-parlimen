      ],
      "schema:name": {
        "@language": "en",
        "@value": "Factories and Machinery (Repeal) Bill 2020"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/14/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/14/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/14/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/14/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/14/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/14/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Factories and Machinery (Repeal) Act 2020."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/14/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/14/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/14/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/14/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "In this Act, “repealed Act” means the Factories and Machinery Act 1967 [Act 139]. Repeal of the Factories and Machinery Act 1967"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/14/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/14/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Factories and Machinery Act 1967 is repealed. Action, etc., made under repealed Act"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/14/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/14/eng@/~cl_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/14/eng@/~cl_4__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/14/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/14/eng@/~cl_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/14/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "Any registration made, or order, notice, direction, written authority, approval, certificate of fitness, special scheme of inspection or certificate of competency given or issued, under the repealed Act shall, on the coming into operation of this Act, be dealt with under the Occupational Safety and Health Act 1994 [Act 514]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/14/eng@/~cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/14/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (1), any notice issued under subsection 19(2), 39(3) or 40(4) of the repealed Act shall, on the coming into operation of this Act, be dealt with under the repealed Act as if the repealed Act had not been repealed. Pending application, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/14/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/14/eng@/~cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/14/eng@/~cl_5__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/14/eng@/~cl_5__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/14/eng@/~cl_5__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/14/eng@/~cl_5__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/14/eng@/~cl_5__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/14/eng@/~cl_5__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/14/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The following matters shall, on the coming into operation of this Act, be dealt with under the repealed Act as if the repealed Act had not been repealed:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/14/eng@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/14/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "any pending application made in relation to a certificate of competency or a written authority under subsection 29(2) of the repealed Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/14/eng@/~cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/14/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "any pending application for a written permission in relation to the use of any premises as a factory under subsection 34(2) of the repealed Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/14/eng@/~cl_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/14/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "any pending application for a written approval in relation to installation of machinery under subsection 36(1) of the repealed Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/14/eng@/~cl_5__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/14/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "any pending inspection under subsection 36(3) of the repealed Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/14/eng@/~cl_5__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/14/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "any pending appeal under subsection 36(6) of the repealed Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/14/eng@/~cl_5__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/14/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "any pending periodical inspection under section 40 of the repealed Act; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/14/eng@/~cl_5__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/14/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "any pending application for approval in relation to a special scheme of inspection under subsection 40(5) of the repealed Act. Continuance of legal proceeding, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/14/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/14/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Any pending legal proceeding, criminal prosecution or investigation, or any sentence imposed or action taken, before the coming into operation of this Act in respect of an offence or breach under the repealed Act, may be instituted, continued or enforced as if the repealed Act had not been repealed."
      }
    }
  ]
}
