        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_IV__cl_16__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_IV__cl_16__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_IV__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang berniat untuk—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_IV__cl_16__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_IV__cl_16__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "membina atau mengilang apa-apa objek angkasa;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_IV__cl_16__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_IV__cl_16__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "memiliki atau mengendalikan apa-apa kemudahan untuk penyepaduan atau pengujian apa-apa objek angkasa; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_IV__cl_16__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_IV__cl_16__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "memiliki atau mengendalikan apa-apa kemudahan pelancar, hendaklah memohon suatu lesen."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_IV__cl_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_IV__cl_16__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_IV__cl_16__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_IV__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang tidak mematuhi subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_IV__cl_16__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_IV__cl_16__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "jika orang itu ialah orang perseorangan, didenda tidak melebihi lima belas juta ringgit atau dipenjarakan selama tempoh tidak melebihi sepuluh tahun atau kedua-duanya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_IV__cl_16__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_IV__cl_16__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "jika orang itu ialah suatu pertubuhan perbadanan, didenda tidak melebihi tiga puluh juta ringgit. Kehendak permit pelancaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_IV__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_IV__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_IV__cl_17__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_IV__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_IV__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana penyedia perkhidmatan pelancaran yang berniat untuk melancarkan suatu objek angkasa ke angkasa dari mana-mana kemudahan pelancar di dalam Malaysia hendaklah memohon suatu permit pelancaran."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_IV__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_IV__cl_17__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_IV__cl_17__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_IV__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang tidak mematuhi subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_IV__cl_17__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
