    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_III__cl_15__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_III__cl_15__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_III__cl_15__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_III__cl_15__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_III__cl_15__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_III__cl_15__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_III__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Angkasa hendaklah digunakan bagi tujuan keamanan dan atas sebab ini tiada seorang pun boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_III__cl_15__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_III__cl_15__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "meletakkan, memasang, melancarkan atau mengendalikan apa-apa senjata pemusnah besar-besaran di angkasa;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_III__cl_15__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_III__cl_15__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menjalankan apa-apa pengujian senjata pemusnah besar-besaran di angkasa;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_III__cl_15__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_III__cl_15__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menubuhkan suatu pangkalan tentera, pepasangan dan kubu, melakukan pengujian apa-apa jenis senjata dan menjalankan apa-apa manuver tentera, di angkasa;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_III__cl_15__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_III__cl_15__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "melakukan apa-apa aktiviti yang menjejaskan keselamatan dan perihal selamat mana-mana aktiviti lain yang dilakukan secara sah di angkasa; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_III__cl_15__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_III__cl_15__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "melakukan apa-apa aktiviti yang boleh menyebabkan pencemaran yang memudaratkan kepada angkasa atau perubahan buruk kepada persekitaran Bumi yang diakibatkan oleh kemasukan sesuatu perkara luar angkasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_III__cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_III__cl_15__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_III__cl_15__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_III__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_III__cl_15__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_III__cl_15__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "jika orang itu ialah orang perseorangan, didenda tidak melebihi lima puluh juta ringgit atau dipenjarakan selama tempoh tidak melebihi tiga puluh tahun atau kedua-duanya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_III__cl_15__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_III__cl_15__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "jika orang itu ialah suatu pertubuhan perbadanan, didenda tidak melebihi satu ratus juta ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga boleh mengundang mana-mana orang lain untuk menghadiri apa-apa mesyuarat Lembaga bagi menasihati Lembaga mengenai apa-apa perkara yang sedang dibincangkan, tetapi orang yang hadir sedemikian tidak berhak untuk mengundi pada mesyuarat itu. Lembaga boleh menubuhkan jawatankuasa"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_11__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_11__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_11__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_11__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_11__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_11__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga boleh menubuhkan apa-apa jawatankuasa sebagaimana yang Lembaga fikirkan perlu atau suai manfaat untuk membantu Lembaga dalam pelaksanaan fungsinya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga boleh melantik mana-mana orang untuk menjadi anggota mana-mana jawatankuasa yang ditubuhkan di bawah subseksyen (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_11__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga boleh melantik mana-mana anggotanya atau mana-mana orang lain untuk menjadi pengerusi jawatankuasa yang ditubuhkan di bawah subseksyen (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_11__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatankuasa hendaklah tertakluk kepada dan bertindak mengikut apa-apa arahan yang diberikan oleh Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_11__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatankuasa hendaklah bermesyuarat seberapa kerap yang perlu pada masa dan di tempat yang ditentukan oleh pengerusi jawatankuasa itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_11__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatankuasa boleh menentukan tatacaranya sendiri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_11__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatankuasa boleh mengundang mana-mana orang untuk menghadiri mana-mana mesyuarat jawatankuasa untuk menasihati jawatankuasa itu mengenai apa-apa perkara yang sedang dibincangkan. Pewakilan fungsi Lembaga"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_12__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_12__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_12__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga boleh, tertakluk kepada syarat atau sekatan sebagaimana yang Lembaga fikirkan patut dikenakan, mewakilkan apa-apa fungsinya, kecuali kuasa pewakilan, kepada Penguasa Angkasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Penguasa Angkasa yang diwakilkan dengan fungsi sedemikian di bawah subseksyen (1) hendaklah terikat untuk mematuhi dan mengambil kira segala syarat dan sekatan yang dikenakan oleh Lembaga dan segala kehendak, tatacara dan perkara yang dinyatakan oleh Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_12__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa fungsi yang diwakilkan di bawah seksyen ini hendaklah dilaksanakan dan dijalankan atas nama dan bagi pihak Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_12__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Pewakilan di bawah seksyen ini tidaklah menghalang Lembaga sendiri daripada melaksanakan atau menjalankan pada bila-bila masa mana-mana fungsi yang diwakilkan. Arahan oleh Menteri"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh memberikan arahan kepada Lembaga selaras dengan peruntukan Akta ini dan Lembaga hendaklah melaksanakan arahan itu. Pelantikan Penguasa Angkasa"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_14__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri hendaklah, atas nasihat Pengerusi, melantik dalam kalangan pegawai awam, seorang Penguasa Angkasa bagi maksud Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Penguasa Angkasa hendaklah melaksanakan fungsi dan kewajipan yang dikenakan dan menjalankan kuasa yang diberikan kepadanya di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_5__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_5__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu lembaga yang dinamakan “Lembaga Angkasa Malaysia” ditubuhkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_5__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_5__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_5__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_5__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_5__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_5__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_5__subsec_2__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_5__subsec_2__para_h"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga hendaklah terdiri daripada—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_5__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Setiausaha Kementerian yang dipertanggungkan dengan tanggungjawab bagi sains dan teknologi yang hendaklah menjadi Pengerusi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_5__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Timbalan Ketua Setiausaha Kementerian yang dipertanggungkan dengan tanggungjawab bagi sains dan teknologi yang hendaklah menjadi Timbalan Pengerusi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_5__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang wakil daripada Kementerian yang dipertanggungkan dengan tanggungjawab bagi pertahanan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_5__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang wakil daripada Kementerian yang dipertanggungkan dengan tanggungjawab bagi komunikasi dan multimedia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_5__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang wakil daripada Kementerian yang dipertanggungkan dengan tanggungjawab bagi hal ehwal dalam negeri;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_5__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang wakil daripada Kementerian yang dipertanggungkan dengan tanggungjawab bagi pengangkutan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_5__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang wakil daripada Kementerian yang dipertanggungkan dengan tanggungjawab bagi perdagangan antarabangsa dan industri; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_5__subsec_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang wakil daripada Majlis Keselamatan Negara."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_5__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Anggota yang disebut dalam perenggan (2)(c) hingga (h) hendaklah dilantik secara bertulis oleh Menteri dan Menteri boleh, berkenaan dengan setiap anggota itu, melantik seorang anggota silih ganti untuk menghadiri mesyuarat Lembaga apabila anggota itu tidak dapat hadir atas apa-apa sebab. Fungsi Lembaga"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_6__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_6__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_6__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_6__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_6__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_6__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga hendaklah mempunyai fungsi yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_6__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menasihati Kerajaan tentang perkara yang berhubungan dengan pelaksanaan Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_6__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memastikan pelaksanaan yang berkesan Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_6__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk melaksanakan atau mengadakan peruntukan bagi pelaksanaan obligasi yang berbangkit daripada perjanjian, konvensyen atau triti yang kepadanya Malaysia menjadi suatu pihak jika perjanjian, konvensyen atau triti itu berkaitan dengan maksud Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_6__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengeluarkan garis panduan dan arahan bagi maksud Akta ini; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_6__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_6__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk melakukan apa-apa perkara lain yang timbul atau berbangkit daripada fungsi Lembaga di bawah Akta ini selaras dengan maksud Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga hendaklah mempunyai segala kuasa sebagaimana yang perlu bagi, atau berkaitan dengan, atau yang semunasabahnya bersampingan dengan, pelaksanaan fungsinya di bawah Akta ini. Penjalanan sementara fungsi Pengerusi"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_7__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_7__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_7__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Timbalan Pengerusi hendaklah bertindak sebagai Pengerusi selama tempoh apabila—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_7__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jawatan Pengerusi kosong; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_7__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi, atas apa-apa sebab, tidak dapat menjalankan fungsinya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Timbalan Pengerusi hendaklah, dalam tempoh dia menjalankan fungsi Pengerusi di bawah seksyen ini, disifatkan sebagai Pengerusi. Setiausaha Eksekutif kepada Lembaga"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_8__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_8__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Penguasa Angkasa hendaklah menjadi Setiausaha Eksekutif kepada Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_8__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_8__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_8__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Setiausaha Eksekutif hendaklah bertanggungjawab bagi—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_8__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_8__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pengurusan hal ehwal hari ke hari Lembaga;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_8__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_8__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pelaksanaan keputusan Lembaga; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_8__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_8__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "penjalanan apa-apa kewajipan lain sebagaimana yang diarahkan oleh Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_8__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Setiausaha Eksekutif hendaklah, dalam menjalankan kewajipannya, bertindak di bawah arahan Lembaga. Mesyuarat Lembaga"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_9__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_9__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_9__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_9__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_9__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_9__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga hendaklah mengadakan mesyuaratnya sekurang-kurangnya sekali dalam setahun dan mesyuarat itu hendaklah diadakan pada masa dan di tempat yang dinyatakan dalam notis bertulis oleh Pengerusi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi hendaklah mempengerusikan mesyuarat Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_9__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Pengerusi tidak hadir pada mana-mana mesyuarat Lembaga, Timbalan Pengerusi hendaklah menggantikannya sebagai pengerusi mesyuarat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_9__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Lima orang anggota, termasuk pengerusi mesyuarat, hendaklah membentuk kuorum Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_9__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi boleh membenarkan penggunaan suatu rangkaian video secara langsung, rangkaian televisyen secara langsung atau apa-apa cara komunikasi elektronik yang lain bagi maksud apa- apa mesyuarat Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_9__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika terdapat bilangan undi yang sama banyak, Pengerusi atau Timbalan Pengerusi yang menggantikan Pengerusi menurut subseksyen (3) hendaklah mempunyai undi pemutus."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_9__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga boleh menentukan tatacaranya sendiri. Lembaga boleh mengundang orang lain untuk menghadiri mesyuarat"
      }
    },
