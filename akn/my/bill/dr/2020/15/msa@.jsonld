      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pemunya yang objek angkasanya telah didaftarkan di bawah seksyen 36 hendaklah memberitahu Penguasa Angkasa sekiranya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_V__cl_37__subsec_1__para_a",
      "@type": "akn:paragraph",
