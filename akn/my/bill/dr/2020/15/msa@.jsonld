      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "TANGGUNGAN Tanggungan mutlak"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VII",
      "@type": "akn:part",
      "eli:number": "VII",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VII__cl_41",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VII__cl_42"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "KESALAHAN LAIN Penemuan objek angkasa, dsb., dan personel, dsb., kapal angkasa"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII",
      "@type": "akn:part",
      "eli:number": "VIII",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_43",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_44",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_45",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_46"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "INSIDEN DAN KEMALANGAN Pemberitahuan insiden dan kemalangan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_43",
      "@type": "akn:clause",
      "eli:number": "43",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_43__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_43__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_43__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pemegang lesen, pemegang permit pelancaran atau pemegang perakuan pelancaran hendaklah dengan segera memberitahu Penguasa Angkasa mengenai apa-apa insiden atau kemalangan berkenaan dengan objek angkasa atau kemudahan pelancar yang dengannya lesen, permit pelancaran atau perakuan pelancaran itu berkaitan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_43__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_43__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_43__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_43__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_43__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "jika orang itu ialah orang perseorangan, didenda tidak melebihi dua puluh lima ribu ringgit; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_43__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_43__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "jika orang itu ialah suatu pertubuhan perbadanan, didenda tidak melebihi lima puluh ribu ringgit. Pelantikan penyiasat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_44",
      "@type": "akn:clause",
      "eli:number": "44",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_44__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_44__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_44__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_44__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_44__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_44__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_44",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud Bahagian ini, Menteri hendaklah melantik secara bertulis apa-apa bilangan penyiasat untuk menjalankan penyiasatan tentang insiden atau kemalangan mengikut cara sebagaimana yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_44__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_44",
      "schema:text": {
        "@language": "ms",
        "@value": "Penyiasat hendaklah mempunyai segala kuasa yang perlu untuk menjalankan suatu penyiasatan di bawah Bahagian ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_44__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_44",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pegawai diberi kuasa boleh dilantik sebagai seorang penyiasat tertakluk kepada syarat yang dikenakan oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_44__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_44",
      "schema:text": {
        "@language": "ms",
        "@value": "Penyiasat yang dilantik di bawah subseksyen (1), selain seorang penyiasat yang dilantik dalam kalangan pegawai diberi kuasa di bawah subseksyen (3), hendaklah disifatkan sebagai pekhidmat awam mengikut pengertian Kanun Keseksaan [Akta 574]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_44__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_44",
      "schema:text": {
        "@language": "ms",
        "@value": "Penyiasatan yang dijalankan di bawah Bahagian ini hendaklah bagi maksud mencegah suatu insiden atau kemalangan pada masa hadapan dan bukannya bagi maksud menentukan kesalahan atau tanggungan. Jagaan selamat objek angkasa, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_45",
      "@type": "akn:clause",
      "eli:number": "45",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_45__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_45__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_45__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_45__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_45__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_45",
      "schema:text": {
        "@language": "ms",
        "@value": "Penguasa Angkasa hendaklah, dengan seberapa segera setelah maklumat berkenaan suatu insiden atau kemalangan diketahuinya, mengambil segala langkah yang munasabah untuk mengekalkan jagaan selamat objek angkasa atau kemudahan pelancar, yang menjadi hal perkara insiden atau kemalangan itu, atau apa-apa keterangan lain yang berhubungan dengan insiden atau kemalangan itu sehingga penyiasat dilantik untuk menjalankan penyiasatan tentang insiden atau kemalangan di bawah seksyen 44."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_45__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_45",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila penyiasat dilantik di bawah seksyen 44, adalah menjadi kewajipan penyiasat untuk mengekalkan jagaan selamat objek angkasa atau kemudahan pelancar, yang menjadi hal perkara insiden atau kemalangan itu, atau apa-apa keterangan lain yang berhubungan dengan insiden atau kemalangan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_45__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_45",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila penyiasat itu menentukan bahawa objek angkasa, kemudahan pelancar atau keterangan lain itu tidak lagi diperlukan bagi maksud penyiasatan, penyiasat itu hendaklah melepaskan objek angkasa, kemudahan pelancar atau keterangan lain itu kepada pemunya atau mana-mana orang yang diberi kuasa secara bertulis oleh pemunya untuk mengambil jagaan objek angkasa, kemudahan pelancar atau keterangan lain itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_45__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_45__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_45__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_45",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang mengusik, mengalih, merosakkan atau memusnahkan mana-mana objek angkasa, kemudahan pelancar atau keterangan lain dalam jagaan Penguasa Angkasa atau seseorang penyiasat melakukan suatu kesalahan dan boleh, apabila disabitkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_45__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_45__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "jika orang itu ialah orang perseorangan, didenda tidak lebih daripada sepuluh ribu ringgit; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_45__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_45__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "jika orang itu ialah suatu pertubuhan perbadanan, didenda tidak lebih daripada dua puluh ribu ringgit. Lesen, dsb., disifatkan digantung sekiranya berlaku kemalangan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_46",
      "@type": "akn:clause",
      "eli:number": "46",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_46__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_46__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_46__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_46__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_46__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_46__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila berlaku suatu kemalangan, lesen, permit pelancaran atau perakuan pelancaran yang diberikan berkenaan dengan suatu objek angkasa atau kemudahan pelancar, yang menjadi hal perkara kemalangan itu, hendaklah disifatkan digantung bagi suatu tempoh dari tarikh kemalangan sehingga tarikh Lembaga membatalkan penggantungan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_46__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika lesen, permit pelancaran atau perakuan pelancaran disifatkan digantung di bawah subseksyen (1), lesen, permit pelancaran atau perakuan pelancaran tidak akan berkuat kuasa semasa tempoh penggantungan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_46__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Penggantungan lesen, permit pelancaran atau perakuan pelancaran di bawah subseksyen (1) tidak menjejaskan tarikh tamat tempoh lesen, permit pelancaran atau perakuan pelancaran sebagaimana yang dinyatakan dalam lesen, permit pelancaran atau perakuan pelancaran itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_46__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga boleh membatalkan atau mengubah syarat lesen, permit pelancaran atau perakuan pelancaran yang digantung di bawah subseksyen (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_46__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VIII__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun seksyen 31, Lembaga boleh membatalkan lesen, permit pelancaran dan perakuan pelancaran yang digantung di bawah subseksyen (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VII__cl_41",
      "@type": "akn:clause",
      "eli:number": "41",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VII__cl_41__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VII__cl_41__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VII__cl_41__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VII__cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang menemukan apa-apa objek yang dia mempunyai sebab untuk mempercayai bahawa objek itu merupakan suatu objek angkasa atau objek yang berasal dari angkasa atau orang yang dia mempunyai sebab untuk mempercayai bahawa orang itu merupakan personel atau penumpang suatu kapal angkasa hendaklah memberitahu Penguasa Angkasa atau mana-mana pegawai diberi kuasa mengenai penemuannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VII__cl_41__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VII__cl_41__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VII__cl_41__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VII__cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VII__cl_41__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VII__cl_41__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "jika orang itu ialah orang perseorangan, didenda tidak melebihi lima ribu ringgit; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VII__cl_41__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VII__cl_41__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "jika orang itu ialah suatu pertubuhan perbadanan, didenda tidak melebihi sepuluh ribu ringgit. Mengusik, dsb., objek angkasa, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VII__cl_42",
      "@type": "akn:clause",
      "eli:number": "42",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VII__cl_42__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VII__cl_42__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VII__cl_42__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VII__cl_42",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang menemukan apa-apa objek yang dia mempunyai sebab untuk mempercayai bahawa objek itu merupakan suatu objek angkasa atau objek yang berasal dari angkasa tidak boleh mengusik, mengalihkan, merosakkan atau memusnahkan objek itu kecuali jika perlu berbuat demikian bagi mencegah bahaya terdekat kepada keselamatan nyawa atau harta."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_VII__cl_42__subsec_2",
      "@type": "akn:subsection",
