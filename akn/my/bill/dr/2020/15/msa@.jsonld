      "schema:text": {
        "@language": "ms",
        "@value": "objek angkasa itu telah terhenti daripada beroperasi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_V__cl_37__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_V__cl_37__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "objek angkasa itu telah musnah secara fizikal; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_V__cl_37__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_V__cl_37__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "terdapat apa-apa perubahan kepada butir-butir yang diberikan mengenai objek angkasa itu bagi maksud pendaftaran."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_V__cl_37__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_V__cl_37__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_V__cl_37__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_V__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_V__cl_37__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_V__cl_37__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "jika orang itu ialah orang perseorangan, didenda tidak melebihi dua puluh lima ribu ringgit; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_V__cl_37__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_V__cl_37__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "jika orang itu ialah suatu pertubuhan perbadanan, didenda tidak melebihi lima puluh ribu ringgit. Daftar objek angkasa"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_V__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_V__cl_38__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_V__cl_38__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_V__cl_38__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_V__cl_38__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_V__cl_38",
      "schema:text": {
        "@language": "ms",
        "@value": "Penguasa Angkasa hendaklah menyimpan dan menyenggara suatu daftar objek angkasa yang didaftarkan di bawah subseksyen 36(1) mengikut cara sebagaimana yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_V__cl_38__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_V__cl_38",
      "schema:text": {
        "@language": "ms",
        "@value": "Penguasa Angkasa boleh, apabila suatu pemberitahuan diberikan di bawah seksyen 37 atau atas kehendaknya sendiri, memotong nama dan butir-butir objek angkasa daripada daftar atau meminda butir-butir objek angkasa itu di dalam daftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_V__cl_38__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_V__cl_38",
      "schema:text": {
        "@language": "ms",
        "@value": "Daftar boleh dijadikan tersedia bagi orang awam untuk diperiksa mengikut cara sebagaimana yang ditentukan oleh Penguasa Angkasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X",
      "@type": "akn:part",
      "eli:number": "X",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_64",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_65",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_66",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_67",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_68",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_69",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_70",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_71",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_72",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_73"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "AM Perlindungan daripada tindakan guaman dan prosiding undang-undang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_64",
      "@type": "akn:clause",
      "eli:number": "64",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_64__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_64__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada tindakan, guaman, pendakwaan atau prosiding lain boleh dibawa, dimulakan atau dikekalkan dalam mana-mana mahkamah terhadap—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_64__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_64",
      "schema:text": {
        "@language": "ms",
        "@value": "anggota Lembaga, anggota jawatankuasa, Penguasa Angkasa, pegawai diberi kuasa, Pegawai Keselamatan Pelancaran dan penyiasat bagi atau atas sebab atau berkenaan dengan apa-apa pelakuan yang diarahkan atau dilakukan bagi tujuan menguatkuasakan Akta ini; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_64__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_64",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang lain bagi atau atas sebab atau berkenaan dengan apa-apa perbuatan yang dilakukan atau berupa dilakukan olehnya di bawah perintah, arahan atau suruhan mana-mana anggota Lembaga, anggota jawatankuasa, Penguasa Angkasa, pegawai diberi kuasa, Pegawai Keselamatan Pelancaran dan penyiasat atau mana-mana pegawai yang diberi kuasa sewajarnya di bawah Akta ini, jika perbuatan itu dilakukan dengan suci hati dan dengan mempercayai semunasabahnya bahawa perbuatan itu perlu bagi maksud yang diniatkan untuk dicapai olehnya. Pendakwaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_65",
      "@type": "akn:clause",
      "eli:number": "65",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada pendakwaan bagi atau berhubung dengan apa-apa kesalahan di bawah Akta ini boleh atau mana-mana peraturan-peraturan yang dibuat di bawah Akta ini dimulakan kecuali oleh atau dengan keizinan bertulis Pendakwa Raya. Penyampaian dokumen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_66",
      "@type": "akn:clause",
      "eli:number": "66",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_66__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_66__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_66__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_66__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_66__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_66__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_66",
      "schema:text": {
        "@language": "ms",
        "@value": "Penyampaian suatu dokumen kepada mana-mana orang hendaklah dilaksanakan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_66__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_66__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menghantar serah dokumen itu kepada orang itu atau dengan menghantar serah dokumen itu kepada seorang anggota keluarganya yang dewasa; di tempat kediaman orang itu yang terakhir diketahui;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_66__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_66__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan meninggalkan dokumen itu di tempat kediaman atau tempat perniagaan orang itu yang lazim atau yang terakhir diketahui dalam suatu sampul yang dialamatkan kepada orang itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_66__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_66__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menghantar dokumen itu melalui pos berdaftar yang dialamatkan kepada orang itu di tempat kediamannya atau tempat perniagaannya yang lazim atau yang terakhir diketahui."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_66__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_66__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_66__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_66",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu dokumen yang dikehendaki disampaikan kepada pemunya atau penghuni mana-mana premis—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_66__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_66__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah disifatkan telah dialamatkan dengan sepatutnya jika dialamatkan dengan perihalan “pemunya” atau “penghuni” premis itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_66__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_66__subsec_2__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_66__subsec_2__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_66__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "boleh disampaikan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_66__subsec_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_66__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menyerahkan dokumen itu kepada seorang dewasa yang berada di premis itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_66__subsec_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_66__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "jika tiada orang sedemikian di premis itu yang kepadanya dokumen itu boleh dengan usaha yang munasabah dihantarserahkan, dengan pengiklanan sekurang-kurangnya dalam satu akhbar tempatan. Percubaan dan persubahatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_67",
      "@type": "akn:clause",
      "eli:number": "67",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang cuba untuk melakukan apa-apa kesalahan yang boleh dihukum di bawah Akta ini atau mana-mana peraturan-peraturan yang dibuat di bawah Akta ini atau bersubahat dalam pelakuan kesalahan itu, boleh dihukum dengan hukuman yang diperuntukkan bagi kesalahan itu. Tanggungan pengarah, dsb. pertubuhan perbadanan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_68",
      "@type": "akn:clause",
      "eli:number": "68",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_68__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_68__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana orang yang melakukan kesalahan di bawah Akta ini atau mana-mana peraturan-peraturan yang dibuat di bawah Akta ini ialah suatu pertubuhan perbadanan, seseorang yang pada masa kelakuan kesalahan itu ialah seorang pengarah, pegawai pematuhan, pekongsi, pengurus, setiausaha atau pegawai lain yang seumpamanya bagi pertubuhan perbadanan itu atau yang berupa sebagai bertindak atas sifat itu atau yang dengan apa-apa cara atau sehingga apa-apa takat bertanggungjawab bagi pengurusan apa-apa hal ehwal pertubuhan perbadanan itu atau yang membantu dalam pengurusannya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_68__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_68",
      "schema:text": {
        "@language": "ms",
        "@value": "boleh dipertuduh secara berasingan atau bersesama dalam prosiding yang sama bersekali dengan pertubuhan perbadanan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_68__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_68__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_68__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_68",
      "schema:text": {
        "@language": "ms",
        "@value": "jika pertubuhan perbadanan itu didapati bersalah atas kesalahan itu, hendaklah disifatkan bersalah atas kesalahan itu dan boleh dikenakan hukuman atau penalti yang sama sebagaimana seorang individu melainkan jika, dengan mengambil kira jenis fungsinya atas sifat itu dan segala hal keadaan, dia membuktikan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_68__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_68__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa kesalahan itu telah dilakukan tanpa pengetahuannya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_68__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_68__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa kesalahan itu telah dilakukan tanpa persetujuan atau pembiarannya dan bahawa dia telah mengambil segala langkah yang munasabah dan menjalankan segala usaha yang wajar untuk menghalang pelakuan kesalahan itu. Tanggungan seseorang bagi perbuatan, dsb., pekerja, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_69",
      "@type": "akn:clause",
      "eli:number": "69",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_69__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_69__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_69__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana orang boleh dikenakan apa-apa hukuman atau penalti di bawah Akta ini atau mana-mana peraturan-peraturan yang dibuat di bawah Akta ini bagi apa-apa perbuatan, peninggalan, pengabaian atau keingkaran yang dilakukan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_69__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_69",
      "schema:text": {
        "@language": "ms",
        "@value": "oleh pekerja orang itu dalam penjalanan pekerjaannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_69__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_69",
      "schema:text": {
        "@language": "ms",
        "@value": "oleh ejen orang itu apabila bertindak bagi pihak orang itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_69__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_69",
      "schema:text": {
        "@language": "ms",
        "@value": "oleh pekerja ejen orang itu semasa bertindak dalam penjalanan pekerjaannya dengan ejen orang itu atau selainnya bagi pihak ejen orang itu yang bertindak bagi pihak orang itu, orang itu boleh dikenakan hukuman atau penalti yang sama bagi tiap-tiap perbuatan, peninggalan, pengabaian atau keingkaran oleh pekerja atau ejen orang itu, atau oleh pekerja ejen orang itu. Pengkompaunan kesalahan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_70",
      "@type": "akn:clause",
      "eli:number": "70",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_70__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_70__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_70__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_70__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_70__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_70__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_70__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_70__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_70__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_70",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, dengan kelulusan Pendakwa Raya, membuat peraturan-peraturan bagi menetapkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_70__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_70__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana kesalahan di bawah Akta ini dan mana-mana peraturan-peraturan yang dibuat di bawah Akta ini yang boleh dikompaun;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_70__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_70__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "kriteria bagi mengkompaun kesalahan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_70__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_70__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "kaedah dan tatacara mengkompaun kesalahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_70__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_70",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi boleh, dengan keizinan bertulis Pendakwa Raya, mengkompaun apa-apa kesalahan yang dilakukan oleh mana-mana orang di bawah Akta ini atau mana-mana peraturan-peraturan yang dibuat di bawah Akta ini yang ditetapkan sebagai suatu kesalahan yang boleh dikompaun dengan membuat suatu tawaran bertulis kepada orang yang disyaki telah melakukan kesalahan itu untuk mengkompaun kesalahan itu apabila dibayar kepada Pengerusi suatu amaun yang tidak melebihi lima puluh peratus amaun denda maksimum bagi kesalahan itu dalam masa yang dinyatakan dalam tawaran bertulisnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_70__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_70",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu tawaran di bawah subseksyen (2) boleh dibuat pada bila-bila masa selepas kesalahan itu dilakukan tetapi sebelum apa-apa pendakwaan baginya dimulakan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_70__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_70",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika amaun yang dinyatakan dalam tawaran itu tidak dibayar dalam masa yang dinyatakan dalam tawaran itu atau dalam apa-apa masa lanjutan yang diberikan oleh Pengerusi, pendakwaan bagi kesalahan itu boleh dimulakan pada bila-bila masa selepas itu terhadap orang yang kepadanya tawaran itu dibuat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_70__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_70",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu kesalahan telah dikompaun di bawah subseksyen (2), tiada pendakwaan boleh dimulakan berkenaan dengan kesalahan itu terhadap orang yang kepadanya tawaran untuk mengkompaun itu dibuat, dan apa-apa barang yang disita berkaitan dengan kesalahan itu boleh dilucuthakkan atau dilepaskan oleh Pengerusi, tertakluk kepada apa-apa terma dan syarat yang difikirkan patut oleh Pengerusi. Pengecualian"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_71",
      "@type": "akn:clause",
      "eli:number": "71",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, melalui perintah dalam Warta, tertakluk kepada apa-apa syarat atau sekatan yang difikirkannya perlu atau suai manfaat dikenakan, mengecualikan mana-mana orang atau mana-mana golongan orang daripada mana-mana atau semua peruntukan Akta ini. Peraturan-peraturan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_72",
      "@type": "akn:clause",
      "eli:number": "72",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_72__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_72__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_72__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_72__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_72",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh membuat apa-apa peraturan-peraturan yang suai manfaat atau perlu bagi melaksanakan peruntukan Akta ini dengan lebih baik."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_72__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_72__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_72__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_72__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_72__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_72__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_72__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_72__subsec_2__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_72",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan keluasan subseksyen (1), peraturan-peraturan boleh dibuat bagi maksud yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_72__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_72__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan cara bagi permohonan lesen, permit pelancaran dan perakuan pelancaran;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_72__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_72__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan kehendak bagi pengeluaran lesen, permit pelancaran dan perakuan pelancaran termasuk kehendak yang berhubungan dengan dengan sumber kewangan dan teknikal;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_72__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_72__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan fi yang perlu dibayar di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_72__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_72__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan cara permohonan pembaharuan lesen;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_72__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_72__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan cara pendaftaran objek angkasa;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_72__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_72__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan cara bagi tanggungan untuk apa-apa kerosakan yang berbangkit daripada pelancaran suatu objek angkasa diinsuranskan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_72__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_72__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan cara penyiasatan tentang insiden dan kemalangan dijalankan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_72__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_72__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_72__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_72",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana peraturan-peraturan yang dibuat di bawah Akta ini boleh menetapkan suatu perbuatan yang melanggar peraturan-peraturan itu menjadi suatu kesalahan dan boleh menetapkan penalti—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_72__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_72__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "jika orang itu ialah orang perseorangan, didenda tidak melebihi lima ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi lima tahun atau kedua-duanya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_72__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_72__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "jika orang itu ialah suatu pertubuhan perbadanan, didenda tidak melebihi satu juta ringgit. Peruntukan peralihan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_73",
      "@type": "akn:clause",
      "eli:number": "73",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_73__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_73__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_73__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_73__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_73",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang, pada tarikh permulaan kuat kuasa Akta ini, sedang menjalankan aktiviti yang baginya kehendak lesen di bawah Akta ini terpakai hendaklah, dalam tempoh enam bulan dari tarikh permulaan kuat kuasa Akta ini, memohon untuk mendapatkan suatu lesen di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_73__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_73",
      "schema:text": {
        "@language": "ms",
        "@value": "Sementara menunggu penentuan permohonan itu, orang itu boleh terus menjalankan aktiviti itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_73__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_X__cl_73",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana warganegara Malaysia, pemastautin tetap atau pertubuhan perbadanan yang diperbadankan, ditubuhkan atau didaftarkan di Malaysia, yang objek angkasa kepunyaannya telah dilancarkan ke dalam orbit bumi atau melepasinya daripada kemudahan pelancar di dalam atau di luar Malaysia sebelum tarikh permulaan kuat kuasa Akta ini hendaklah, dalam masa enam bulan dari tarikh permulaan kuat kuasa Akta ini, mendaftarkan objek angkasa itu dengan Penguasa Angkasa mengikut Akta ini."
      }
    }
  ]
}
