        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_IX__cl_53",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_IX__cl_54",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_IX__cl_55",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_IX__cl_56",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_IX__cl_57",
