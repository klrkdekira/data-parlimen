      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_V__cl_36",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_V__cl_36__subsec_2__para_a",
      "@type": "akn:paragraph",
