      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_IV__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_IV__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana warganegara Malaysia atau pemastautin tetap yang merupakan seorang, atau mana-mana pertubuhan perbadanan yang diperbadankan, ditubuhkan atau didaftarkan di Malaysia yang merupakan, pemunya suatu objek angkasa dan berniat untuk melancarkan objek angkasa itu ke angkasa dari mana-mana kemudahan pelancar di dalam atau di luar Malaysia hendaklah memohon suatu perakuan pelancaran."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_IV__cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/15/msa@/~part_IV__cl_18__subsec_2__para_a",
