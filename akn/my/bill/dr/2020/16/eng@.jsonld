        "@value": "Supply Bill 2021"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/16/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/16/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Supply Act 2021. Issue and appropriation for the service of the year 2021"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/16/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/16/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The issue of a sum not exceeding one hundred and sixty-four billion one hundred and fifty-one million six hundred and fifty-six thousand eight hundred ringgit (RM164,151,656,800) from the Consolidated Fund for the service of the year 2021 is hereby authorized and that sum is appropriated for the purposes specified in the Schedule."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/16/eng@/~sched_1",
