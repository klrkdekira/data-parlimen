      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (5), dengan menggantikan perkataan “subsection (2)” dengan perkataan “subsections (2) and (3A)”. Pindaan Jadual 1"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/17/msa@/~chp_II__cl_27",
      "@type": "akn:clause",
