    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/17/msa@/~chp_II__cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/17/msa@/~chp_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 4, 5, 6, 13, 15, 16, 17, 23 dan 27, dan subperenggan 14(a)(i), (ii), (iii), (iv) dan (v), subperenggan 14(a)(viii) dan perenggan 14(b) berhubung dengan perenggan 46(1)(u) Akta Cukai Pendapatan 1967, dan perenggan 28(a) berkuat kuasa bagi tahun taksiran 2021 dan tahun-tahun taksiran yang berikutnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/17/msa@/~chp_II__cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/17/msa@/~chp_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 7, 8 dan 9 mula berkuat kuasa apabila berkuatkuasanya Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/17/msa@/~chp_II__cl_3__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/17/msa@/~chp_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 10, 11, 18, 20, 21, 24, 25 dan 26, dan perenggan 28(b) mula berkuat kuasa pada 1 Januari 2021."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/17/msa@/~chp_II__cl_3__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/17/msa@/~chp_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 12 berkuat kuasa bagi tahun taksiran 2022 dan tahun-tahun taksiran yang berikutnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/17/msa@/~chp_II__cl_3__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/17/msa@/~chp_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Subperenggan 14(a)(vi) dan (vii), subperenggan 14(a)(viii) berhubung dengan perenggan 46(1)(s) Akta Cukai Pendapatan 1967, perenggan 14(b) berhubung dengan perenggan 46(1)(r) dan (s) Akta Cukai Pendapatan 1967, dan seksyen 29 berkuat kuasa bagi tahun taksiran 2020 dan 2021."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/17/msa@/~chp_II__cl_3__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/17/msa@/~chp_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Subperenggan 14(a)(viii) dan perenggan 14(b) berhubung dengan perenggan 46(1)(t) Akta Cukai Pendapatan 1967 berkuat kuasa bagi tahun taksiran 2020."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/17/msa@/~chp_II__cl_3__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/17/msa@/~chp_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 19 dan 22 disifatkan telah mula berkuat kuasa pada 1 Januari 2020."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/17/msa@/~chp_II__cl_3__subsec_8",
