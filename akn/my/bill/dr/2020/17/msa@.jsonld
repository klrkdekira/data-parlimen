        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/17/msa@/~chp_II__cl_11__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/17/msa@/~chp_II",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 44 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/17/msa@/~chp_II__cl_11__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/17/msa@/~chp_II__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subperenggan (5b)(a)(ii), dengan memotong perkataan “nominal”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/17/msa@/~chp_II__cl_11__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/17/msa@/~chp_II__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (5c)(a), dengan memotong perkataan “nominal”. Pindaan seksyen 44a"
      }
    },
    {
