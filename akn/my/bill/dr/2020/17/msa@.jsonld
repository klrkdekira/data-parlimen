      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/17/msa@/~chp_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 30 berkuat kuasa bagi tahun taksiran 2020, 2021 dan 2022. Pindaan seksyen 5"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/17/msa@/~chp_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/17/msa@/~chp_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Cukai Pendapatan 1967, yang disebut “Akta ibu” dalam Bab ini, dipinda dalam subseksyen 5(1A) dengan memasukkan selepas perkataan “section 109c,” perkataan “109d,”. Pindaan seksyen 6"
      }
