      "schema:text": {
        "@language": "ms",
        "@value": "PINDAAN KEPADA AKTA KEWANGAN 2018 Permulaan kuat kuasa pindaan kepada Akta Kewangan 2018"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/17/msa@/~chp_VIII__cl_65",
