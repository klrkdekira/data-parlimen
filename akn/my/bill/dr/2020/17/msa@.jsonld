      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “a person” perkataan “resident in Malaysia”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/17/msa@/~chp_II__cl_8__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
