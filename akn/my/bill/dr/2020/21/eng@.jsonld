      "schema:name": {
        "@language": "en",
        "@value": "Free Zones (Amendment) Bill 2020"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/21/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/21/eng@/~cl_1__subsec_1",
