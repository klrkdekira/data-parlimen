      "schema:name": {
        "@language": "en",
        "@value": "Windfall Profit Levy (Amendment) Bill 2020"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/24/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/24/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/24/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/24/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/24/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/24/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Windfall Profit Levy (Amendment) Act 2020."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/24/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/24/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Substitution of section 13"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/24/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/24/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Windfall Profit Levy Act 1998 [Act 592], which is referred to as the “principal Act” in this Act, is amended by substituting for section 13 the following section: “Remission of levy and penalty 13. (1) The Minister may, if he deems fit, remit the whole or any part of the levy due and payable under this Act. (2) The Director General may, if he deems fit, remit the whole or any part of the penalty under section 9. (3) Where a person who has been granted remission under subsection (1) or (2) has paid any levy or penalty to which the remission relates, subject to subsection 14(3), he shall be entitled to a refund of the amount of the levy or penalty paid which had been remitted.”. Substitution of section 14"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/24/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/24/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by substituting for section 14 the following section: “Claim for refund of levy and penalty overpaid or erroneously paid, etc. 14. (1) Any person who has overpaid or erroneously paid any levy or penalty, or is entitled to a refund of the levy or penalty under section 13 may make a claim for refund in the prescribed form. (2) A claim for refund under subsection (1) shall be made to the Director General within one year from the date such overpayment or erroneous payment occurred or such entitlement of the refund occurred. (3) The Director General may reduce or disallow any refund in respect of the claim under subsection (1) to the extent that the refund would unjustly enrich the person referred to in subsection (1).”. New section 14a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/24/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/24/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting after section 14 the following section: “Refund upon satisfaction of Director General and with supporting evidence 14a. (1) A claim for refund of levy or penalty under subsection 14(1) shall be supported by such evidence as required by the Director General. (2) The Director General may make such refund in respect of the claim made by any person under subsection 14(1) after being satisfied that the person has properly established the claim.”."
      }
    }
  ]
}
