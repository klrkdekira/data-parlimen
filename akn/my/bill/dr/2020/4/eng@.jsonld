      ],
      "schema:name": {
        "@language": "en",
        "@value": "Temporary Measures for Government Financing (Coronavirus Disease 2019 (COVID-19)) Bill 2020"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Temporary Measures for Government Financing (Coronavirus Disease 2019 (COVID-19)) Act 2020."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "Except for section 3, this Act is deemed to have come into operation on 27 February 2020 and shall continue to remain in operation until 31 December 2022. Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "In this Act, “Minister” means the Minister charged with the responsibility for finance. Increase of ceiling amount of sums raised and moneys received"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_3__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_3__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "The ceiling amount for the total amount of the sums that may be raised under subsection 3(1) of the Loan (Local) Act 1959 and the total amount of moneys that may be received under subsection 3(1) of the Government Funding Act 1983 specified in the Loan (Local) (Statutory Ceiling for Borrowing) and Government Funding (Statutory Ceiling of Moneys Received) Order 2009 [P.U. (A) 241/2009] at the rate of fifty-five per centum of the Gross Domestic Product of Malaysia, is increased up to sixty per centum of the Gross Domestic Product of Malaysia, when calculated together."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection (1) shall have effect for the period from the date this Act is published in the Gazette until 31 December 2022 and during such period the Loan (Local) (Statutory Ceiling for Borrowing) and Government Funding (Statutory Ceiling of Moneys Received) Order 2009 is suspended."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_3__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this section, “Gross Domestic Product of Malaysia” means the latest Gross Domestic Product of Malaysia confirmed by the Minister. Establishment of COVID-19 Fund"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_4__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "A fund to be known as the COVID-19 Fund is established and shall be specified in and incorporated into the Second Schedule to the Financial Procedure Act 1957 [Act 61]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection 5(1) of the Loan (Local) Act 1959 and section 4 of the Government Funding Act 1983, any sum raised under subsection 3(1) of the Loan (Local) Act 1959 and any money received under subsection 3(1) of the Government Funding Act 1983 may be paid into the COVID-19 Fund for the purposes of its application under section 5. Application of COVID-19 Fund"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_5__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_5__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The moneys in the COVID-19 Fund shall be applied and appropriated for the purposes of the programmes under the economic stimulus packages and economic recovery plans specified in column (1) of the Schedule in the amount specified in column (2)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_5__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_5__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (1), the Minister may, if he thinks necessary—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_5__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "limit or suspend the amount to be applied and appropriated for the purposes of any programme; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_5__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "direct any sum appropriated for a programme to be appropriated in aid of any other programme for which the sum appropriated may be deficient a further amount out of any surplus from the first mentioned programme."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_5__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister shall ensure that the application and appropriation of the moneys in the COVID-19 Fund are utilised only for the programmes specified in column (1) of the Schedule, taking into account anything done under subsection (2), and does not exceed the total amount allocated for such programmes. Sums paid, applied and appropriated from 27 February 2020 until date of publication of Act deemed valid"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Any sum raised under subsection 3(1) of the Loan (Local) Act 1959 and money received under subsection 3(1) of the Government Funding Act 1983 which is paid into, applied and appropriated for the purposes of, the COVID-19 Fund, for the period from 27 February 2020 until the date this Act is published in the Gazette, shall be deemed to have been validly paid, applied and appropriated as such. Yearly statements of COVID-19 Fund"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister shall, as soon as practicable after the end of every financial year, prepare in respect of that financial year a statement of receipts and expenditure of moneys accounted in the COVID-19 Fund as required under paragraph 16(1)(c) of the Financial Procedure Act 1957. Dealings with COVID-19 Fund upon the expiry of Act"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_8__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_8__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "Upon the expiry of this Act, where there is any money payable from the COVID-19 Fund, it shall be paid within six months from the date of expiry of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "Where there is any balance of moneys in the COVID-19 Fund after all the payments are made under subsection (1), notwithstanding subsection 10(3) of the Financial Procedure Act 1957, such balance of moneys shall be paid by the Minister into the Development Fund specified in the Second Schedule to the Financial Procedure Act 1957."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_8__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/4/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "After the balance of moneys in the COVID-19 Fund has been paid in accordance with subsection (2), the COVID-19 Fund shall be deemed dissolved and the Dewan Rakyat may, by a resolution, delete the COVID-19 Fund from the Second Schedule to the Financial Procedure Act 1957."
      }
    },
