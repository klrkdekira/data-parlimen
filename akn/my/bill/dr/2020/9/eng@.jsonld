      ],
      "schema:name": {
        "@language": "en",
        "@value": "Subordinate Courts (Amendment) Bill 2020"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/9/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/9/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/9/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/9/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/9/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/9/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Subordinate Courts (Amendment) Act 2020."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/9/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/9/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Amendment of section 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/9/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/9/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Subordinate Courts Act 1948 [Act 92], which is referred to as the “principal Act” in this Act, is amended in section 2 by inserting after the definition of “Registrar” the following definition: ‘ “remote communication technology” means a live video link, a live television link or any other electronic means of communication;’. New section 101b"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/9/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/9/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting after section 101a the following section: “Court may conduct proceedings through remote communication technology 101b. (1) Without limiting section 101, the court may, in the interest of justice, conduct the proceedings of any cause or matter, civil or criminal, or hold any inquiry, through a remote communication technology. (2) The place in which the court is held to conduct the proceedings of any cause or matter, civil or criminal, or hold any inquiry, through a remote communication technology shall be deemed to be conducted within the local limits of jurisdiction assigned to it under section 59 or 76, or, if no such local limits have been assigned, arising in any part of Peninsular Malaysia. (3) Nothing in this section shall affect the operation of section 5 of the Evidence of Child Witness Act 2007 [Act 676], sections 265a and 272b of the Criminal Procedure Code and section 32a of the Evidence Act 1950 [Act 56]. (4) In this section, “place” includes cyberspace, virtual place or virtual space.”. New section 107a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/9/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2020/9/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting after section 107 the following section: “Practice directions 107a. The Chief Justice may issue such practice directions as may be necessary for the purpose of carrying into effect the provisions of this Act after consulting the President of the Court of Appeal or the Chief Judge.”."
      }
    }
  ]
}
