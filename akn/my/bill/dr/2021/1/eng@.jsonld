      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/eng@/~cl_46",
      "@type": "akn:clause",
      "eli:number": "46",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/eng@/~cl_46__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/eng@/~cl_46__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/eng@/~cl_46__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/eng@/~cl_46__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/eng@/~cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "Any complaint, investigation, inquiry, trial, prosecution, proceedings or appeal done, taken or commenced under the principal Act immediately before the date of coming into operation of this Act, shall be dealt with, continued and concluded under and in accordance with the provisions of the principal Act as if the principal Act had not been amended by this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/eng@/~cl_46__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/eng@/~cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "Any application for approval made under subsection 25a(2) of the principal Act which is pending before the date of coming into operation of this Act shall, on the date of coming into operation of this Act, be dealt with in accordance with the provision of the principal Act as amended by this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/eng@/~cl_46__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/eng@/~cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "Any employer who, before the date of coming into operation of this Act, has employed any foreign employee but who has not fulfilled any of the requirements under section 60k of the principal Act shall, on the date of coming into operation of this Act, be dealt with in accordance with the provision of the principal Act as if the principal Act had not been amended by this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 22(2) of the principal Act is amended by inserting after the words “parents,” the words “spouse,”. Amendment of section 25"
      }
    },
