        "@value": "by deleting the word “or” at the end of paragraph (a);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/eng@/~cl_9__para_b__subpara_ii",
      "@type": "akn:subparagraph",
