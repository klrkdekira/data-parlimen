      "schema:text": {
        "@language": "en",
        "@value": "by inserting after paragraph (a) the following paragraph:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/eng@/~cl_9__para_b__subpara_iii",
