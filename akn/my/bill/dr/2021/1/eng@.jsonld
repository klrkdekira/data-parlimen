        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/eng@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by deleting Part VIII. Amendment of Part IX"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/eng@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Part IX of the principal Act is amended in the heading by substituting for the words “MATERNITY PROTECTION” the words “PREGNANCY AND MATERNITY”. Amendment of section 37"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/eng@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/eng@/~cl_12__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/eng@/~cl_12__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 37 of the principal Act is amended in subsection (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/eng@/~cl_12__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/eng@/~cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for paragraph (aa) the following paragraph: “(aa) Where a female employee is entitled to maternity leave under subparagraph (a)(i), whether or not she is entitled to receive maternity allowance from her employer for the eligible period under paragraph (c), or whether or not she has fulfilled the conditions set out in paragraph (2)(a), she may, with the consent of her employer, commence work at any time during the eligible period if she has been certified fit to resume work by a registered medical practitioner.”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/eng@/~cl_12__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/eng@/~cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "in subparagraph (d)(ii), by substituting for the word “sixty” the word “ninety”. New section 41a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/eng@/~cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting after section 41 the following section: “Restriction on termination of pregnant female employee 41a. (1) Where a female employee is pregnant or is suffering from an illness arising out of her pregnancy, it shall be an offence for her employer to terminate her services or give her notice of termination of service, except on the grounds of— (a) wilful breach of a condition of the contract of service under subsection 13(2); (b) misconduct under subsection 14(1); or (c) closure of the employer’s business. (2) Where the service of a female employee under subsection (1) is terminated, the burden of proving that such termination is not on the ground of her pregnancy or on the ground of illness arising out of her pregnancy, shall rest on the employer.”. Amendment of section 42"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/eng@/~cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 42 of the principal Act is amended in the shoulder note by substituting for the word “dismissal” the word “termination”. Deletion of section 44a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/eng@/~cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by deleting section 44a. Amendment of Part XI"
      }
    },
