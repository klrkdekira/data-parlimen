      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 25a Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam nota bahu, dengan menggantikan perkataan “bank” dengan perkataan “financial institution”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1), dengan menggantikan perkataan “, other than a domestic servant” dengan perkataan “and subject to subsection (2)”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_7__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (2) dengan subseksyen yang berikut: “(2) The employer shall, upon the written request of his employee under subsection (1), obtain approval from the Director General for the payment of wages to be paid in legal tender or by cheque.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_7__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (2) subseksyen yang berikut: “( 2a) The Director General may impose any condition as he may deem fit on the approval granted under subsection (2).”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_7__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (3), (5) dan (6), dengan menggantikan perkataan “subsections (1) and (2)” di mana-mana jua terdapat dengan perkataan “subsection (1)”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_7__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (5), dengan memasukkan selepas perkataan “employer” perkataan “upon obtaining the approval under subsection (2)”. Pindaan Bahagian VII"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Bahagian VII Akta ibu dipinda dalam kepala dengan menggantikan perkataan “CONTRACTORS, PRINCIPALS AND CONTRACTORS FOR LABOUR” dengan perkataan “PRINCIPALS, CONTRACTORS, SUB-CONTRACTORS AND CONTRACTORS FOR LABOUR”. Pindaan seksyen 33a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_9__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_9__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 33a Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_9__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (1) subseksyen yang berikut: “(1a) A contractor for labour referred to in subsection (1) who supplies any employee to a principal, contractor or sub-contractor shall enter into a contract in writing and shall make such contract or any other document relating to such contract available for inspection.”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_9__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_9__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_9__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_9__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (3)— “(aa) fails to make such contract or any other document relating to such contract available for inspection as required under subsection (1a); or”; dan Pemotongan Bahagian VIII"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_9__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_9__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan “or” di hujung perenggan (a);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_9__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_9__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan (a) perenggan yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_9__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_9__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “ten” dengan perkataan “fifty”."
      }
    }
  ]
