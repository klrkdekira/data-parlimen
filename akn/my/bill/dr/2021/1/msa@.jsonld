    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memotong Bahagian VIII. Pindaan Bahagian IX"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Bahagian IX Akta ibu dipinda dalam kepala dengan menggantikan perkataan “MATERNITY PROTECTION” dengan perkataan “PREGNANCY AND MATERNITY”. Pindaan seksyen 37"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_12__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_12__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 37 Akta ibu dipinda dalam subseksyen (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_12__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perenggan (aa) dengan perenggan yang berikut: “(aa) Where a female employee is entitled to maternity leave under subparagraph (a)(i), whether or not she is entitled to receive maternity allowance from her employer for the eligible period under paragraph (c), or whether or not she has fulfilled the conditions set out in paragraph (2)(a), she may, with the consent of her employer, commence work at any time during the eligible period if she has been certified fit to resume work by a registered medical practitioner.”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_12__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subperenggan (d)(ii), dengan menggantikan perkataan “sixty” dengan perkataan “ninety”. Seksyen baharu 41a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memasukkan selepas seksyen 41 seksyen yang berikut: “Restriction on termination of pregnant female employee 41a. (1) Where a female employee is pregnant or is suffering from an illness arising out of her pregnancy, it shall be an offence for her employer to terminate her services or give her notice of termination of service, except on the grounds of— (a) wilful breach of a condition of the contract of service under subsection 13(2); (b) misconduct under subsection 14(1); or (c) closure of the employer’s business. (2) Where the service of a female employee under subsection (1) is terminated, the burden of proving that such termination is not on the ground of her pregnancy or on the ground of illness arising out of her pregnancy, shall rest on the employer.”. Pindaan seksyen 42"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 42 Akta ibu dipinda dalam nota bahu dengan menggantikan perkataan “dismissal” dengan perkataan “termination”. Pemotongan seksyen 44a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memotong seksyen 44a. Pindaan Bahagian XI"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Bahagian XI Akta ibu dipinda dalam kepala dengan menggantikan perkataan “SERVANTS” dengan perkataan “EMPLOYEES”. Pindaan seksyen 57"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 57 Akta ibu dipinda dengan menggantikan perkataan “servant” di mana-mana jua terdapat dengan perkataan “employee”. Pindaan seksyen 57a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_18__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_18__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 57a Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_18__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam nota bahu dan subseksyen (1), dengan menggantikan perkataan “servant” dengan perkataan “employee”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_18__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2), dengan menggantikan perkataan “ten thousand ringgit” dengan perkataan “fifty thousand ringgit”. Pindaan seksyen 57b"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_19__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_19__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 57b Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_19__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam nota bahu dan subseksyen (1) dan (2), dengan menggantikan perkataan “servant” di mana-mana jua terdapat dengan perkataan “employee”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_19__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (3), dengan menggantikan perkataan “ten thousand ringgit” dengan perkataan “fifty thousand ringgit”. Pindaan seksyen 60a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Kerja (Pindaan) 2021."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta dan Menteri boleh menetapkan tarikh yang berlainan bagi permulaan kuat kuasa peruntukan yang berlainan Akta ini. Pindaan seksyen 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Kerja 1955 [Akta 265], yang disebut “Akta ibu” dalam Akta ini, dipinda dalam subseksyen 2(1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/1/msa@/~cl_20",
      "@type": "akn:clause",
