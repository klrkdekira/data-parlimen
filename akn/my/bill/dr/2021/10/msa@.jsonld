      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 19 Akta ibu dipinda dengan menggantikan perkataan “sepuluh tahun” dengan perkataan “lima belas tahun”. Pindaan seksyen 26a"
      }
    },
    {
