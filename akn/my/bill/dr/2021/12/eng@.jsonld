      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/eng@/~chp_IV",
      "@type": "akn:chapter",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/eng@/~chp_IV__cl_36",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/eng@/~chp_IV__cl_37",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/eng@/~chp_IV__cl_38",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/eng@/~chp_IV__cl_39",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/eng@/~chp_IV__cl_40",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/eng@/~chp_IV__cl_41",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/eng@/~chp_IV__cl_42",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/eng@/~chp_IV__cl_43",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/eng@/~chp_IV__cl_44"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "AMENDMENTS TO THE STAMP ACT 1949 Commencement of amendments to the Stamp Act 1949"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/eng@/~chp_IV__cl_36",
      "@type": "akn:clause",
      "eli:number": "36",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/eng@/~chp_IV",
      "schema:text": {
        "@language": "en",
        "@value": "This Chapter comes into operation on 1 January 2022. New section 36d"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/eng@/~chp_IV__cl_37",
      "@type": "akn:clause",
      "eli:number": "37",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/eng@/~chp_IV",
      "schema:text": {
        "@language": "en",
        "@value": "The Stamp Act 1949, which is referred to as the “principal Act” in this Chapter, is amended by inserting after section 36c the following section: “Finality of assessment 36d. (1) For the purposes of this Act, an assessment shall be final and conclusive where— (a) no valid notice of appeal against the assessment has been given under section 39 within the time specified by that section; (b) the assessment has been determined on appeal and there is no right of further appeal; or (c) a valid notice of appeal against the assessment has been given but the appellant dies before the hearing of the appeal by the High Court is commenced or completed and no personal representative of the estate of the deceased appellant applies to the High Court within two years after his death to proceed with or complete the hearing. (2) Nothing in subsection (1) shall prejudice the application of section 36b or 50a.”. Amendment of section 37"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/eng@/~chp_IV__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/eng@/~chp_IV",
      "schema:text": {
        "@language": "en",
        "@value": "Section 37 of the principal Act is amended by inserting after subsection (2) the following subsection: “(2a) Where an instrument is chargeable with duty which exceeds ten ringgit and the duty is exempted, the person bringing the instrument to the Collector shall pay a fee of ten ringgit for the Collector to certify by indorsement on such instrument that the duty is exempted.”. Amendment of section 39"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/eng@/~chp_IV__cl_39",
