      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the words “in connection with the” the words “family fund,”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/eng@/~chp_II__cl_12__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/eng@/~chp_II__cl_12__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting the words “, or any other fee receivable in respect of an investment fund from the family fund”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/eng@/~chp_II__cl_12__para_b",
      "@type": "akn:paragraph",
