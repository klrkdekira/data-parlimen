      "schema:text": {
        "@language": "en",
        "@value": "Sections 4, 6, 13, 14, 16, 17, 18, 20, 21, 22, 23, 24, 25 and 27, paragraph 5(a), paragraph 5(b) in relation to paragraph 6(1)(o) of the Income Tax Act 1967 and paragraph 26(b) in relation to Part XIX of Schedule 1 to the Income Tax Act 1967 come into operation on 1 January 2022."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/eng@/~chp_II__cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/eng@/~chp_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "Sections 7, 10, 11, 12, 15, 19 and 28, paragraph 9(b) in relation to subparagraph 46(1)(h)(iii) of the Income Tax Act 1967 and paragraph 9(c) have effect for the year of assessment 2022 and subsequent years of assessment."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/eng@/~chp_II__cl_3__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/eng@/~chp_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraph 5(b) in relation to paragraph 6(1)(p) of the Income Tax Act 1967 and paragraph 26(b) in relation to Part XX of Schedule 1 to the Income Tax Act 1967 come into operation from 1 January 2022 until 30 June 2022."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/eng@/~chp_II__cl_3__subsec_4",
      "@type": "akn:subsection",
