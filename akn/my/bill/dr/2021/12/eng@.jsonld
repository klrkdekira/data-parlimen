      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/eng@/~chp_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "Section 8 is deemed to have effect for the year of assessment 2019 and subsequent years of assessment."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/eng@/~chp_II__cl_3__subsec_5",
