      "schema:text": {
        "@language": "en",
        "@value": "by inserting after paragraph (d) the following paragraphs: “(e) to obtain a review of an assessment in a case where section 38a applies; or (f) to obtain a refund of duty paid in a case where section 57, 58 or 80b, or subsection 21(7), 39(4) or 80(3) applies.”. New section 77c"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/eng@/~chp_IV__cl_43",
