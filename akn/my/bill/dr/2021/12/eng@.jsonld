      "schema:text": {
        "@language": "en",
        "@value": "Paragraphs 9(a), (d), (g) and (h) have effect for the years of assessment 2022 and 2023."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/eng@/~chp_II__cl_3__subsec_6",
