        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/eng@/~chp_II__cl_10__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/eng@/~chp_II",
      "schema:name": {
        "@language": "en",
        "@value": "Section 49 of the principal Act is amended—"
      }
    },
    {
