      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “years of assessment 2021 and 2022” dengan perkataan “years of assessment 2022 and 2023”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/msa@/~chp_II__cl_9__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
