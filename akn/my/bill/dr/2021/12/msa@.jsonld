      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/msa@/~chp_II__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/msa@/~chp_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Proviso kepada subseksyen 127(5) Akta ibu dipinda dengan menggantikan perkataan “or 109d” di mana-mana jua terdapat dengan perkataan “, 109d or 109dA”. Pindaan seksyen 131"
      }
    },
    {
