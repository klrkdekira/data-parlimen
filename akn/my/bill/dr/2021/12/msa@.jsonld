        "@value": "dengan memasukkan selepas perkataan “Employees Social Security Act 1969” perkataan “or Employment Insurance System Act 2017 [Act 800]”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/msa@/~chp_II__cl_9__para_d",
