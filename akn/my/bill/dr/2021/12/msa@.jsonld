      "schema:text": {
        "@language": "ms",
        "@value": "dalam subperenggan (a), dengan menggantikan perkataan “and 2022” dengan perkataan “, 2022, 2023 and 2024”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/msa@/~chp_II__cl_28__para_a__subpara_ii",
