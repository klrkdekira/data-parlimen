        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/msa@/~chp_II__cl_7__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/msa@/~chp_II",
      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 39(1) Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/msa@/~chp_II__cl_7__para_a",
