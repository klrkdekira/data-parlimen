      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/msa@/~chp_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan (u) perenggan yang berikut: “(v) an amount limited to a maximum of two thousand and five hundred ringgit expended for each basis year for the years of assessment 2022 and 2023 by that individual for the payment of installation, rental, purchase including hire-purchase of equipment or subscription for use of electric vehicle charging facility for his own vehicle and not being used for the purposes of his own business as evidenced by receipts issued in respect of the payment on the amount expended.”. Pindaan seksyen 49"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/msa@/~chp_IV",
      "@type": "akn:chapter",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/msa@/~chp_IV__cl_36",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/msa@/~chp_IV__cl_37",
