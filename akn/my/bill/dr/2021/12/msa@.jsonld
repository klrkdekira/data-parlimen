      "schema:text": {
        "@language": "ms",
        "@value": "Bab ini mula berkuat kuasa pada 1 Januari 2022. Pindaan seksyen 3"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/msa@/~chp_VIII__cl_65",
      "@type": "akn:clause",
      "eli:number": "65",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/msa@/~chp_VIII",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Kewangan 2012 dipinda dengan menggantikan subseksyen 3(4) dengan subseksyen yang berikut: “(4) Seksyen 10 mula berkuat kuasa dari tahun taksiran 2012 hingga tahun taksiran 2021 dan berkenaan dengan perenggan 10(c) hingga tahun taksiran 2025.”."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/msa@/~chp_VII__cl_59",
