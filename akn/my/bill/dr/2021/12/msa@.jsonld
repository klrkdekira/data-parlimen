      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan “or” di hujung subperenggan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/msa@/~chp_II__cl_28__para_a__subpara_iii",
