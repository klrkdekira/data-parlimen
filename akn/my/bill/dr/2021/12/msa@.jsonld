      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "PINDAAN KEPADA AKTA KEWANGAN 2018 Permulaan kuat kuasa pindaan kepada Akta Kewangan 2018"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/msa@/~chp_IX__cl_66",
      "@type": "akn:clause",
      "eli:number": "66",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/msa@/~chp_IX",
      "schema:text": {
        "@language": "ms",
        "@value": "Bab ini disifatkan telah mula berkuat kuasa bagi tahun taksiran 2019 dan tahun-tahun taksiran yang berikutnya. Pindaan seksyen 11"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/msa@/~chp_IX__cl_67",
      "@type": "akn:clause",
      "eli:number": "67",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/msa@/~chp_IX",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Kewangan 2018 dipinda dalam seksyen 11 dengan menggantikan perkataan “tahun taksiran 2025” di mana-mana jua terdapat dengan perkataan “tahun taksiran 2028”."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/msa@/~chp_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/msa@/~chp_I",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Kewangan 2021. Pindaan Akta"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/msa@/~chp_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/msa@/~chp_I",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Cukai Pendapatan 1967 [Akta 53], Akta Cukai Keuntungan Harta Tanah 1976 [Akta 169], Akta Setem 1949 [Akta 378], Akta Petroleum (Cukai Pendapatan) 1967 [Akta 543], Akta Cukai Aktiviti Perniagaan Labuan 1990 [Akta 445], Akta Penggalakan Pelaburan 1986 [Akta 327], Akta Kewangan 2012 [Akta 742] dan Akta Kewangan 2018 [Akta 812] dipinda mengikut cara yang dinyatakan masing-masing dalam Bab II, III, IV, V, VI, VII, VIII dan IX."
      }
    },
