      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (c) proviso kepada perenggan (r), dengan menggantikan perkataan “years of assessment 2020 and 2021” dengan perkataan “years of assessment 2020 until 2023”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/msa@/~chp_II__cl_9__para_e",
      "@type": "akn:paragraph",
