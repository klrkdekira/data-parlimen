      "schema:text": {
        "@language": "ms",
        "@value": "dalam subperenggan (c)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/12/msa@/~chp_II__cl_28__para_a__subpara_iii__subpara_A",
      "@type": "akn:subparagraph",
