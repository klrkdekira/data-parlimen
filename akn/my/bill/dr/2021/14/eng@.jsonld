      "schema:text": {
        "@language": "en",
        "@value": "in subsection (3) by deleting paragraph (b). Amendment of section 27a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/14/eng@/~cl_8",
      "@type": "akn:clause",
