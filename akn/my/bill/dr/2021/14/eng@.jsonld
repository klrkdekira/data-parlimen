      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/14/eng@/~cl_7__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting the words “the author of the work,”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/14/eng@/~cl_7__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/14/eng@/~cl_7__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words “, an assignee of the copyright, or a person to whom an interest in the copyright has been granted by licence” the words “or an assignee of the copyright”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/14/eng@/~cl_7__para_b",
