      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/14/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (8) the following subsection: “(9) For the purpose of this section, “body corporate” means a company limited by guarantee incorporated under the Companies Act 2016 [Act 777].”. New section 27m"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/14/eng@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/14/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting after section 27l the following section: “Guidelines 27m. (1) The Controller may issue guidelines on any matter relating to the declaration and operation of a collective management organization provided under this Part. (2) The person to whom the guidelines referred to in subsection (1) applies shall comply and give effect to such guidelines. (3) The Controller may revoke, vary, revise or amend the whole or any part of any guidelines issued under this section.”. Amendment of section 36a"
      }
    }
  ]
