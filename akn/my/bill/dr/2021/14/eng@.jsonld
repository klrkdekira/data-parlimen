      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/14/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (4), by substituting for the words “licensing body” the words “collective management organization, or if the applicant’s constituent document is identical with or similar to any other collective management organizations”;"
      }
    },
