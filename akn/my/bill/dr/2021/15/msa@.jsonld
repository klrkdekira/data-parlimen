      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 27 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_15__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_15__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_15__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_15__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_15__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “prioriti” dengan perkataan “hak prioriti”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_15__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_15__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “difailkan” perkataan “berkenaan dengan reka cipta yang sama bagi permohonan yang dibuat”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_15__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (1a) subseksyen yang berikut: “(1b) Jika pemohon gagal untuk menuntut hak prioriti dalam tempoh dua belas bulan yang disebut dalam subseksyen (1), hak prioriti itu boleh dipulihkan jika— (a) suatu permintaan untuk pemulihan hak prioriti dibuat oleh pemohon kepada Pendaftar dalam bentuk sebagaimana yang ditentukan oleh Pendaftar bersama dengan pembayaran fi yang ditetapkan; dan (b) permintaan di bawah perenggan (a) memenuhi syarat-syarat sebagaimana yang ditetapkan.”. Pindaan seksyen 28"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_16__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_16__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_16__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_16__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_16__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_16__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_16__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 28 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_16__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (1)(c), dengan memasukkan selepas perkataan “suatu perihalan” perkataan “termasuk suatu senarai jujukan, jika ada”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_16__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (1) subseksyen yang berikut: “(1a) Bagi maksud perenggan (1)(d), jika permohonan itu mengandungi lebih daripada sepuluh tuntutan, setiap tuntutan yang berikutnya hendaklah tertakluk kepada pembayaran fi yang ditetapkan.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_16__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (2) dengan subseksyen yang berikut: “(2) Jika Pendaftar mendapati bahawa permohonan yang dibuat oleh pemohon tidak memenuhi kehendak di bawah perenggan (1)(a), (b), (c) atau (d), Pendaftar hendaklah meminta pemohon untuk memfailkan pembetulan yang dikehendaki dalam tempoh yang ditetapkan.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_16__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (2) subseksyen yang berikut: “(2a) Jika Pendaftar mendapati bahawa permohonan yang dibuat oleh pemohon tidak memenuhi kehendak di bawah subseksyen (1a), Pendaftar hendaklah meminta pemohon untuk membuat pembayaran fi yang ditetapkan bagi setiap tuntutan yang berikutnya dalam tempoh yang ditetapkan.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_16__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (3) dengan subseksyen yang berikut: “(3) Jika— (a) pemohon mematuhi permintaan Pendaftar untuk memfailkan pembetulan yang dikehendaki di bawah subseksyen (2), Pendaftar hendaklah merekodkan tarikh penerimaan pembetulan yang dikehendaki sebagai tarikh pemfailan; (b) pemohon tidak mematuhi permintaan Pendaftar untuk memfailkan pembetulan yang dikehendaki di bawah subseksyen (2), permohonan itu hendaklah dikira sebagai ditinggalkan; (c) pemohon mematuhi permintaan Pendaftar untuk membuat pembayaran fi yang ditetapkan bagi setiap tuntutan berikutnya di bawah subseksyen (2 a), Pendaftar hendaklah merekodkan tarikh penerimaan permohonan di bawah subseksyen (1) sebagai tarikh pemfailan; atau (d) pemohon tidak mematuhi permintaan Pendaftar untuk membuat pembayaran fi yang ditetapkan bagi setiap tuntutan berikutnya di bawah subseksyen (2 a), Pendaftar hendaklah merekodkan tarikh penerimaan permohonan di bawah subseksyen (1) bagi sepuluh tuntutan pertama sahaja sebagai tarikh pemfailan.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_16__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (4), dengan memasukkan selepas perkataan “lukisan yang hilang itu” perkataan “dalam tempoh yang ditetapkan”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_16__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (5) subseksyen yang berikut: “(6) Tempoh yang ditetapkan yang disebut dalam subseksyen (2), (2a) dan (4) tidak boleh dilanjutkan oleh Pendaftar di bawah seksyen 82.”. Pindaan seksyen 29a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_17__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_17__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_17__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_17__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_17__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_17__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 29a Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_17__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2), dengan menggantikan perkataan “maka pemohon boleh meminta pemeriksaan substantif yang diubahsuaikan sebagai ganti pemeriksaan substantif” dengan perkataan “pemohon boleh, sebagai ganti pemfailan suatu permintaan bagi pemeriksaan substantif, memfailkan suatu permintaan bagi pemeriksaan substantif yang diubahsuaikan dalam tempoh yang ditetapkan”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_17__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (3), dengan menggantikan perkataan “borang yang ditetapkan” dengan perkataan “bentuk sebagaimana yang ditentukan oleh Pendaftar”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_17__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong subseksyen (4);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_17__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (5) dengan subseksyen yang berikut: “(5) Jika pemohon gagal untuk— (a) memfailkan permintaan bagi pemeriksaan substantif di bawah subseksyen (1); atau (b) memfailkan permintaan bagi pemeriksaan substantif yang diubahsuaikan di bawah subseksyen (2), dalam tempoh yang ditetapkan, permohonan untuk mendapatkan paten itu hendaklah disifatkan telah ditarik balik pada akhir tempoh itu.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_17__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (6) dengan subseksyen yang berikut: “(6) Walau apa pun perenggan (5)(b), Pendaftar boleh, atas permintaan pemohon dalam bentuk sebagaimana yang ditentukan oleh Pendaftar bersama dengan pembayaran fi yang ditetapkan, membenarkan penangguhan bagi pemfailan permintaan bagi pemeriksaan substantif yang diubahsuaikan yang disebut dalam subseksyen (2). (6a) Penangguhan di bawah subseksyen (6) boleh dibenarkan hanya atas alasan bahawa paten atau hak milik lain bagi perlindungan harta perindustrian belum diberikan atau tidak boleh didapati sebelum habis tempoh yang ditetapkan bagi pemfailan permintaan bagi pemeriksaan substantif yang diubahsuaikan.”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_17__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (7), dengan memotong perkataan “(1) atau”. Pindaan seksyen 30"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 30 Akta ibu dipinda dengan memasukkan selepas subseksyen (3) subseksyen yang berikut: “(3a) Pindaan permohonan yang dibuat di bawah subseksyen (3) tidak boleh menzahirkan lebih daripada apa yang dizahirkan dalam pemohonan asal.”. Seksyen baharu 31a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memasukkan selepas seksyen 31 seksyen yang berikut: “Salinan permohonan paten atau paten yang diperakui atau tidak diperakui 31a. Pemunya paten atau pemohon paten boleh membuat permintaan kepada Pendaftar bagi suatu salinan yang diperakui atau tidak diperakui bagi apa-apa borang atau dokumen berkenaan dengan permohonan paten atau patennya yang difailkan di Pejabat Pendaftaran Paten dalam bentuk sebagaimana yang ditentukan oleh Pendaftar bersama dengan pembayaran fi yang ditetapkan.”. Penggantian seksyen 32a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Paten (Pindaan) 2021."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta dan Menteri boleh menetapkan tarikh yang berlainan bagi permulaan kuat kuasa peruntukan yang berlainan Akta ini. Pindaan am"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta Paten 1983 [Akta 291], yang disebut “Akta ibu” dalam Akta ini, dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan menggantikan seksyen 32a dengan seksyen yang berikut: “Notis amanah dalam Daftar 32a. (1) Notis mengenai mana-mana amanah tersirat atau konstruktif tidak boleh disetuju terima oleh Pendaftar dan dimasukkan ke dalam Daftar. (2) Notis mengenai suatu amanah nyata atau benefisiari suatu amanah nyata, atau kedua-duanya, boleh disetuju terima oleh Pendaftar dan dimasukkan ke dalam Daftar. (3) Walau apa pun subseksyen (2), Pendaftar tidak boleh terjejas dengan notis amanah nyata atau benefisiari suatu amanah nyata, dan kegagalan untuk memasukkan notis itu ke dalam Daftar tidak menjejaskan apa-apa hak atau kewajipan di bawah amanah itu.”. Penggantian seksyen 33"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan menggantikan seksyen 33 dengan seksyen yang berikut: “Pemeriksaan Daftar dan salinan atau cabutan dari Daftar 33. (1) Mana-mana orang boleh membuat permintaan kepada Pendaftar untuk memeriksa Daftar atau mendapatkan salinan atau cabutan yang diperakui atau tidak diperakui daripada Daftar, dalam bentuk sebagaimana yang ditentukan oleh Pendaftar bersama dengan pembayaran fi yang ditetapkan. (2) Dalam seksyen ini, “orang” termasuklah Kerajaan Persekutuan dan Kerajaan Negeri.”. Pindaan seksyen 33a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 33a Akta ibu dipinda dengan memasukkan selepas subseksyen (2) subseksyen yang berikut: “(3) Tiada seorang pun dalam penggajian Perbadanan dikehendaki hadir ke mana-mana mahkamah bagi maksud untuk mengemukakan— (a) apa-apa dokumen yang berhubungan dengan permohonan paten atau paten yang boleh diperoleh menurut peruntukan Akta ini; atau (b) apa-apa dokumen yang tidak boleh dijadikan tersedia kepada pihak ketiga mengikut Akta ini.”. Pindaan seksyen 33b"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_23__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_23__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 33b Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_23__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1), dengan memasukkan selepas perkataan “cara yang ditetapkan” perkataan “bersama dengan pembayaran fi yang ditetapkan”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_23__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (1)(a) dan (b), dengan memasukkan selepas perkataan “pemunya paten” perkataan “atau pereka cipta”. Pindaan seksyen 33c"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_24__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_24__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 33c Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_24__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (2) dengan subseksyen yang berikut: “(2) Bagi maksud permohonan di bawah subseksyen (1), Pendaftar hendaklah mempunyai hak untuk hadir dan didengar, dan hendaklah hadir jika diarahkan sedemikan oleh Mahkamah.”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_24__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong subseksyen (4). Seksyen baharu 33d"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memasukkan selepas seksyen 33c seksyen yang berikut: “Penyiaran permohonan 33d. (1) Tertakluk kepada seksyen 30a, Pendaftar hendaklah menyiarkan dalam Jurnal Rasmi maklumat yang ditetapkan yang berhubungan dengan suatu permohonan paten setakat mana maklumat itu berada dalam milikan Pendaftar— (a) selepas lapan belas bulan dari tarikh pemfailan, atau jika hak prioriti dituntut, tarikh prioriti permohonan paten itu; atau (b) atas permintaan pemohon untuk penyiaran awal sebelum tempoh yang dinyatakan dalam perenggan (a) dalam bentuk sebagaimana yang ditentukan oleh Pendaftar bersama dengan pembayaran fi yang ditetapkan. (2) Permohonan paten tidak boleh disiarkan di bawah subseksyen (1) jika— (a) permohonan paten itu ditinggalkan, ditarik balik atau disifatkan telah ditarik balik, atau ditolak pada atau sebelum habis tempoh yang dinyatakan dalam perenggan (1)(a); atau (b) Pendaftar mendapati bahawa permohonan itu mengandungi apa-apa maklumat yang melanggar ketenteraman awam atau kemoralan. (3) Suatu permintaan bagi penyiaran awal di bawah perenggan (1)(b) tidak boleh dibatalkan. (4) Seksyen ini tidak terpakai bagi suatu permohonan antarabangsa yang dibuat di bawah Triti Kerjasama Paten.”. Pindaan seksyen 34"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_26__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_26__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_26__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 34 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_26__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (1) dengan subseksyen yang berikut: “(1) Jika permohonan paten telah disiarkan di bawah seksyen 33d, apabila pembayaran fi yang ditetapkan diterima, Pendaftar hendaklah menjadikan tersedia bagi pemeriksaan awam mengikut cara yang ditetapkan maklumat atau dokumen yang berikut yang berhubungan dengan permohonan paten setakat mana maklumat atau dokumen itu berada dalam milikan Pendaftar— (a) nama, alamat dan perihalan pemohon, dan nama dan alamat ejennya, jika ada; (b) nombor permohonan itu; (c) tarikh pemfailan permohonan itu, dan jika hak prioriti dituntut, tarikh prioriti, nombor permohonan yang terdahulu, nama negara yang permohonan yang terdahulu itu telah difailkan, atau jika permohonan yang terdahulu itu ialah permohonan serantau atau permohonan antarabangsa, nama negara yang baginya dan pejabat yang permohonan itu telah difailkan; (d) butir-butir permohonan termasuk perihalan, tuntutan atau tuntutan-tuntutan, lukisan, jika ada, dan abstrak dan apa-apa pindaan kepada permohonan itu, jika ada; (e) apa-apa perubahan pemunyaan permohonan itu dan apa-apa rujukan kepada kontrak lesen yang berhubungan dengan permohonan itu; (f) laporan carian dan pemeriksaan; (g) komunikasi berkenaan dengan permohonan paten daripada pemohon kepada Pejabat Pendaftaran Paten sebagaimana yang ditentukan oleh Pendaftar; dan (h) petikan bahan bertulis berkaitan paten dan bukan paten yang dikemukakan oleh pemohon atau mana-mana orang lain kepada Pejabat Pendaftaran Paten.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_26__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong subseksyen (2);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_26__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (3) dengan subseksyen yang berikut: “(3) Jika tiada permintaan dibuat oleh pemohon di bawah perenggan 33d(1)(b), mana-mana orang yang berhasrat untuk memeriksa maklumat atau dokumen yang berhubungan dengan permohonan paten yang disebut dalam subseksyen (1) sebelum habis tempoh lapan belas bulan dari tarikh pemfailan, atau jika hak prioriti dituntut, tarikh prioriti permohonan paten itu, hendaklah membuat permintaan kepada Pendaftar dalam bentuk sebagaimana yang ditentukan oleh Pendaftar disertakan dengan— (a) kebenaran bertulis pemohon itu; dan (b) pembayaran fi yang ditetapkan. (d) dalam subseksyen (5), perenggan (6)(b) dan subseksyen (9), dengan menggantikan perkataan “dijadikan tersedia bagi pemeriksaan awam” dengan perkataan “disiarkan di bawah seksyen 33d”. Seksyen baharu 34a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memasukkan selepas seksyen 34 seksyen yang berikut: “Pemerhatian pihak ketiga 34a. (1) Mana-mana orang boleh, dalam tempoh yang ditetapkan, membuat pemerhatian dalam bentuk sebagaimana yang ditentukan oleh Pendaftar bersama dengan pembayaran fi yang ditetapkan bagi apa-apa perkara yang berhubungan dengan kebolehpatenan suatu permohonan paten sebagaimana yang ditetapkan dan hendaklah mengandungi sebab bagi pemerhatian itu. (2) Dalam seksyen ini, “orang” termasuklah Kerajaan Persekutuan dan Kerajaan Negeri.”. Pindaan seksyen 35"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 35(2) Akta ibu dipinda dalam teks bahasa Inggeris dengan menggantikan perkataan “a patentee” dengan perkataan “an owner of a patent”. Pindaan seksyen 35a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_29__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_29__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 35a(1) Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_29__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “dua tahun” dengan perkataan “dua belas bulan”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_29__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “borang yang ditetapkan” dengan perkataan “bentuk sebagaimana yang ditentukan oleh Pendaftar bersama dengan pembayaran fi yang ditetapkan”. Pindaan seksyen 36"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “Warta” di mana-mana jua terdapat dengan perkataan “Jurnal Rasmi” kecuali dalam seksyen 1; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “masa yang ditetapkan” di mana-mana jua terdapat dengan perkataan “tempoh yang ditetapkan”. Pindaan seksyen 3"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
