      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “Tertakluk kepada” perkataan “subseksyen 17b(4a), subseksyen 26b(1b),”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_60__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
