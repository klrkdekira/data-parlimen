      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 17b Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_60",
