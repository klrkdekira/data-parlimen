        "@value": "Seksyen 3 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/15/msa@/~cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
