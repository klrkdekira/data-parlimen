      "schema:text": {
        "@language": "ms",
        "@value": "TRIBUNAL BAGI ANTIGANGGUAN SEKSUAL"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_III",
      "@type": "akn:part",
      "eli:number": "III",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_III__cl_24",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_III__cl_25"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "PENTADBIR ANTIGANGGUAN SEKSUAL Pentadbir"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_III__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Setiausaha Kementerian yang bertanggungjawab bagi pembangunan wanita, keluarga dan masyarakat hendaklah menjadi Pentadbir Antigangguan Seksual. Fungsi dan kuasa Pentadbir"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_III__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_III__cl_25__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_III__cl_25__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_III__cl_25__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_III__cl_25__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_III__cl_25__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_III__cl_25__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_III__cl_25__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_III__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Pentadbir hendaklah mempunyai fungsi yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_III__cl_25__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_III__cl_25__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk merumuskan dasar atau mengeluarkan garis panduan yang berhubungan dengan pencegahan atau kesedaran tentang gangguan seksual;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_III__cl_25__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_III__cl_25__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menggalakkan aktiviti yang berhubungan dengan pencegahan atau kesedaran tentang gangguan seksual;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_III__cl_25__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_III__cl_25__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mentadbir apa-apa perkara yang berhubungan dengan pencegahan atau kesedaran tentang gangguan seksual; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_III__cl_25__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_III__cl_25__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk melaksanakan apa-apa fungsi lain bagi pembaikan dan pelaksanaan yang sepatutnya Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_III__cl_25__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_III__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Pentadbir hendaklah mempunyai segala kuasa sebagaimana yang perlu bagi, atau berkaitan dengan, atau yang bersampingan dengan, pelaksanaan fungsinya di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1",
      "@type": "akn:chapter",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Penubuhan dan organisasi Penubuhan Tribunal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Maka hendaklah ditubuhkan suatu tribunal yang dikenali sebagai “Tribunal bagi Antigangguan Seksual”. Anggota, tempoh jawatan dan elaun"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_4__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_4__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_4__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_4__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_4__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_4__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_4__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_4__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_4__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Tribunal hendaklah terdiri daripada anggota yang berikut yang hendaklah dilantik oleh Menteri:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_4__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_4__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang Presiden dan seorang Timbalan Presiden yang hendaklah dilantik dalam kalangan anggota Perkhidmatan Kehakiman dan Perundangan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_4__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_4__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_4__subsec_1__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_4__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak kurang daripada lima orang anggota lain yang hendaklah terdiri daripada—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_4__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_4__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "orang yang merupakan anggota atau yang pernah memegang jawatan dalam Perkhidmatan Kehakiman dan Perundangan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_4__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_4__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "orang yang diterima masuk sebagai peguam bela dan peguam cara di bawah Akta Profesion Undang-Undang 1976 [Akta 166], Ordinan Peguam Bela Sabah [Sabah Bab 2] atau Ordinan Peguam Bela Sarawak [Sarawak Bab 110], dan yang menjalankan amalan selama tidak kurang daripada tujuh tahun; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_4__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_4__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak kurang daripada lima orang anggota lain, sebagaimana yang ditentukan oleh Menteri, yang mempunyai pengetahuan atau pengalaman praktikal dalam perkara yang berhubungan dengan gangguan seksual."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Presiden atas apa-apa sebab tidak boleh melaksanakan fungsinya atau semasa apa-apa tempoh kekosongan jawatan Presiden, Timbalan Presiden hendaklah melaksanakan fungsi Presiden."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_4__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Presiden, Timbalan Presiden dan anggota Tribunal hendaklah memegang jawatan bagi tempoh selama tiga tahun dan boleh dilantik semula hanya bagi satu tempoh lagi secara berturut-turut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_4__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Presiden, Timbalan Presiden atau anggota Tribunal boleh pada bila-bila masa meletakkan jawatannya dengan memberikan notis bertulis tiga bulan kepada Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_4__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh pada bila-bila masa membatalkan pelantikan anggota Tribunal yang dilantik di bawah perenggan 4(1)(b) dan (c), dan mengisi apa-apa kekosongan dalam keanggotaannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_4__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Presiden dan Timbalan Presiden hendaklah dibayar apa-apa elaun tetap dan elaun lain sebagaimana yang ditentukan oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_4__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Anggota Tribunal yang dilantik di bawah perenggan 4(1)(b) dan (c) hendaklah dibayar suatu elaun bersidang harian semasa persidangan Tribunal dan apa-apa elaun penginapan, perjalanan dan sara hidup sebagaimana yang ditentukan oleh Menteri. Kehilangan kelayakan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_5__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_5__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_5__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_5__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_5__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Presiden, Timbalan Presiden dan anggota Tribunal yang dilantik di bawah subseksyen 4(1) hendaklah hilang kelayakan daripada menjadi anggota Tribunal jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "orang itu dihukum bankrap oleh sesuatu mahkamah yang mempunyai bidang kuasa berwibawa;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "orang itu diperakui oleh seorang pegawai perubatan yang berkelayakan sebagai tidak berupaya dari segi fizikal atau mental untuk meneruskan jawatan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri berpendapat bahawa orang itu terlibat dalam apa-apa jawatan berbayar, komisen atau penggajian yang bercanggah dengan kewajipan orang itu di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_5__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "kelakuan orang itu, sama ada berkaitan dengan kewajipannya sebagai seorang anggota Tribunal atau selainnya, adalah sedemikian rupa sehingga mencemarkan nama Tribunal;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_5__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_5__para_e__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_5__para_e__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_5__para_e__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "orang itu telah disabitkan atas, suatu pertuduhan berkenaan dengan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_5__para_e__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_5__para_e",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu kesalahan yang melibatkan fraud, kecurangan atau keburukan akhlak;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_5__para_e__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_5__para_e",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu kesalahan di bawah mana-mana undang-undang yang berhubungan dengan rasuah; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_5__para_e__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_5__para_e",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa kesalahan lain yang boleh dihukum dengan pemenjaraan, sama ada pemenjaraan sahaja atau sebagai tambahan kepada atau sebagai ganti denda, selama lebih daripada dua tahun; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_5__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "orang itu tidak menghadiri persidangan Tribunal tiga kali berturut-turut tanpa mendapat kebenaran Presiden. Setiausaha, pegawai dan kakitangan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_6__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1",
      "schema:name": {
        "@language": "ms",
        "@value": "Menteri hendaklah melantik—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang Setiausaha kepada Tribunal; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_1__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa bilangan pegawai dan kakitangan Tribunal lain sebagaimana yang perlu untuk menjalankan fungsi Tribunal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2",
      "@type": "akn:chapter",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_9"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Bidang kuasa Tribunal Bidang kuasa Tribunal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Tribunal hendaklah mempunyai bidang kuasa untuk mendengar dan menentukan apa-apa aduan gangguan seksual yang dibuat oleh mana-mana orang. Pengecualian bidang kuasa mahkamah"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_8__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_8__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_8__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_8__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu aduan gangguan seksual dibuat oleh mana-mana orang kepada Tribunal, isu yang dipertikaikan dalam aduan gangguan seksual itu, sama ada sebagaimana yang ditunjukkan dalam aduan yang mula-mula atau yang timbul dalam penjalanan pendengaran, tidak boleh menjadi perkara prosiding antara pihak yang sama dalam mana-mana mahkamah melainkan jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_8__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_8__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "prosiding di hadapan mahkamah telah dimulakan sebelum aduan gangguan seksual itu dibuat kepada Tribunal;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_8__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_8__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "aduan gangguan seksual itu melibatkan apa-apa kelakuan yang menjadi suatu jenayah di bawah peruntukan mana-mana undang-undang bertulis; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_8__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_8__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "aduan gangguan seksual di hadapan Tribunal itu ditarik balik atau dibatalkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika perenggan (1)(a) terpakai, isu yang dipertikaikan dalam tuntutan gangguan seksual yang kepadanya prosiding itu berkaitan, sama ada sebagaimana yang ditunjukkan dalam tuntutan yang mula-mula atau yang timbul dalam penjalanan pendengaran, tidak boleh menjadi perkara prosiding antara pihak yang sama di hadapan Tribunal melainkan jika tuntutan gangguan seksual di hadapan mahkamah itu ditarik balik atau dibatalkan. Penentuan kaedah-kaedah dan tatacara"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_9__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_9__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_9__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_9__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Prosiding Tribunal hendaklah dijalankan dengan mengikut apa-apa tatacara sebagaimana yang ditentukan oleh Tribunal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Presiden hendaklah menyebabkan tatacara yang ditentukan di bawah subseksyen (1) ditulis dan disiarkan dalam apa-apa cara sebagaimana yang difikirkan patut oleh Presiden."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_9__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_9__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_9__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_9__subsec_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_9__subsec_3__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_9__subsec_3__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_9__subsec_3__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam menjalankan prosiding di bawah subseksyen (1), Tribunal hendaklah mempunyai kuasa untuk—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_9__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_9__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat perintah interlokutori;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_9__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_9__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "menentukan keberkaitan, kebolehterimaan dan berat apa-apa keterangan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_9__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_9__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "mengambil keterangan bersumpah atau dengan ikrar dan bagi maksud itu seseorang anggota Tribunal boleh mengendalikan suatu sumpah atau ikrar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_9__subsec_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_9__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "memerintahkan pemberian butir-butir lanjut dalam suatu pernyataan aduan gangguan seksual atau pernyataan balas;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_9__subsec_3__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_9__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "memerintahkan pemuliharaan dan jagaan interim apa-apa keterangan bagi maksud pendengaran; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_9__subsec_3__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_9__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "memanggil pihak-pihak kepada prosiding atau mana-mana orang lain supaya hadir di hadapan Tribunal untuk memberikan keterangan atau mengemukakan apa-apa dokumen, rekod atau benda lain dalam milikannya atau selainnya untuk membantu Tribunal dalam pertimbangtelitiannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_9__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu saman yang dikeluarkan oleh Tribunal di bawah seksyen ini hendaklah disampaikan dan dikuatkuasakan seolah-olah saman itu merupakan suatu saman yang dikeluarkan oleh mahkamah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_9__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_2__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Tribunal hendaklah menentukan aduan gangguan seksual berdasarkan imbangan kebarangkalian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3",
      "@type": "akn:chapter",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_11",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_12",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_13",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_14",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_15",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_16",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_17",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_18"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Penjalanan prosiding Permulaan prosiding"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang boleh membuat suatu aduan gangguan seksual di bawah Akta ini dengan Tribunal dalam borang yang ditetapkan bersama dengan fi yang ditetapkan. Notis aduan gangguan seksual"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila suatu aduan gangguan seksual dibuat di bawah seksyen 10, Setiausaha kepada Tribunal hendaklah memberikan suatu notis bertulis dalam borang yang ditetapkan kepada pengadu dan responden tentang butir-butir tentang hari, masa dan tempat pendengaran. Persidangan Tribunal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_12__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_12__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_12__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_12__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_12__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_12__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_12__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Setiap persidangan Tribunal hendaklah ditentukan oleh Presiden dan hendaklah terdiri daripada suatu panel yang mempunyai tiga orang anggota Tribunal seperti yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_12__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_12__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Presiden atau Timbalan Presiden yang dilantik di bawah perenggan 4(1)(a), atau mana-mana anggota Tribunal lain yang dilantik di bawah perenggan 4(1)(b), sebagai seorang Pengerusi; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_12__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_12__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana dua orang anggota Tribunal lain yang dilantik di bawah perenggan 4(1)(c)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Panel bagi setiap persidangan Tribunal dalam subseksyen (1) hendaklah terdiri daripada sekurang-kurangnya seorang wanita."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_12__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Tribunal boleh bersidang dalam satu atau lebih persidangan pada mana-mana hari dan pada bila-bila masa dan di mana-mana tempat sebagaimana yang ditentukan oleh Presiden."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_12__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Pengerusi yang disebut dalam perenggan (1)(a) yang mempengerusikan mana-mana prosiding berkenaan dengan suatu aduan gangguan seksual meninggal dunia atau menjadi tidak berupaya, atau atas apa-apa sebab lain tidak boleh menyelesaikan atau melupuskan prosiding itu, aduan gangguan seksual itu hendaklah didengar dan diteruskan dan dipengerusikan oleh mana-mana Pengerusi lain sebagaimana yang ditentukan oleh Presiden."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_12__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana anggota Tribunal yang disebut dalam perenggan (1)(b) berkenaan dengan suatu aduan gangguan seksual meninggal dunia atau menjadi tidak berupaya, atau atas apa-apa sebab lain tidak boleh menyelesaikan atau melupuskan prosiding itu, Presiden hendaklah melantik mana-mana anggota Tribunal lain kepada panel itu untuk meneruskan prosiding itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_12__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika tempoh pelantikan mana-mana Pengerusi atau anggota Tribunal yang disebut dalam perenggan (1)(b) habis semasa apa-apa prosiding belum selesai berkenaan dengan suatu aduan gangguan seksual, tempoh pelantikannya hendaklah disifatkan telah dilanjutkan sehingga pelupusan muktamad aduan gangguan seksual itu. Hak untuk hadir pada pendengaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_13__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_13__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_13__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Pada pendengaran sesuatu aduan gangguan seksual, tiap-tiap pihak kepada prosiding berhak hadir dan didengar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada pihak boleh diwakili oleh seorang peguam bela dan peguam cara pada sesuatu pendengaran."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_13__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada subseksyen (1) dan (2), suatu pihak yang merupakan seorang yang belum dewasa atau mana-mana orang yang tidak berupaya boleh diwakili oleh sahabat wakil atau penjaga ad litemnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_13__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu pihak yang merupakan seorang yang belum dewasa atau mana-mana orang yang tidak berupaya diwakili oleh sahabat wakil atau penjaga ad litemnya, Tribunal boleh mengenakan apa-apa syarat sebagaimana yang difikirkan perlu oleh Tribunal untuk memastikan bahawa pihak yang satu lagi kepada prosiding itu tidak diletakkan dalam keadaan yang merugikan secara substansial. Pendengaran hendaklah tertutup"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua pendengaran di hadapan Tribunal hendaklah tertutup kepada orang awam. Tribunal boleh bertindak semasa pihak tidak hadir"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Tribunal boleh mendengar dan menentukan suatu aduan gangguan seksual di hadapannya walaupun mana-mana pihak kepada prosiding itu tidak hadir jika dibuktikan sehingga Tribunal berpuas hati bahawa suatu notis pendengaran telah disampaikan kepada pihak yang tidak hadir itu dengan sewajarnya. Rundingan penyelesaian"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_16__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_16__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_16__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_16__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_16__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Tribunal boleh, berkenaan dengan tiap-tiap aduan gangguan seksual dalam bidang kuasanya dan dengan persetujuan pihak-pihak, menilai sama ada, dalam semua hal keadaan, sesuai bagi Tribunal untuk membantu pihak-pihak itu untuk merundingkan suatu penyelesaian yang dipersetujui berhubung dengan aduan gangguan seksual itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa mengehadkan keluasan subseksyen (1), dalam membuat sesuatu penilaian Tribunal hendaklah mengambil kira apa-apa faktor yang, pada pendapat Tribunal, berkemungkinan akan menjejaskan kemampuan salah satu atau kedua-dua pihak untuk merundingkan suatu penyelesaian yang dipersetujui."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_16__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika pihak-pihak itu mencapai suatu penyelesaian yang dipersetujui, Tribunal hendaklah meluluskan dan merekodkan penyelesaian yang dipersetujui itu dan penyelesaian yang dipersetujui itu hendaklah kemudiannya berkuat kuasa seolah-olah penyelesaian yang dipersetujui itu ialah suatu award Tribunal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_16__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_16__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_16__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Tribunal hendaklah meneruskan untuk menentukan aduan gangguan seksual itu jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_16__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_16__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "ternyata kepada Tribunal bahawa adalah tidak sesuai untuknya membantu pihak-pihak untuk merundingkan suatu penyelesaian yang dipersetujui berhubung dengan aduan gangguan seksual itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_16__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_16__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "pihak-pihak itu tidak dapat mencapai suatu penyelesaian yang dipersetujui berhubung dengan aduan gangguan seksual itu. Rujukan kepada Hakim Mahkamah Tinggi mengenai persoalan undang-undang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_17__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_17__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_17__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_17__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_17__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Sebelum Tribunal membuat sesuatu award di bawah seksyen 19, Tribunal boleh, mengikut budi bicaranya, merujuk kepada Hakim Mahkamah Tinggi sesuatu persoalan undang-undang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_17__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_17__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "yang timbul dalam penjalanan prosiding;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_17__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_17__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "yang, pada pendapat Tribunal, adalah cukup penting untuk mewajarkan rujukan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_17__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_17__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "yang penentuannya oleh Tribunal menimbulkan, pada pendapat Tribunal, keraguan yang mencukupi untuk mewajarkan rujukan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Tribunal merujuk apa-apa persoalan undang-undang di bawah subseksyen (1) bagi keputusan Hakim Mahkamah Tinggi, Tribunal hendaklah membuat awardnya bertepatan dengan keputusan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_17__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud rujukan kepada Mahkamah Tinggi mengenai apa-apa persoalan undang-undang, seorang Peguam Persekutuan yang diberi kuasa oleh Peguam Negara boleh hadir bagi pihak Tribunal dalam apa-apa prosiding di hadapan Hakim Mahkamah Tinggi. Tatacara jika tiada peruntukan dibuat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika tiada peruntukan dibuat yang berhubungan dengan tatacara Tribunal, tertakluk kepada Akta ini dan mana-mana peraturan- peraturan yang dibuat di bawah Akta ini, Tribunal hendaklah menerima pakai apa-apa tatacara yang difikirkan patut oleh Tribunal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4",
      "@type": "akn:chapter",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_19",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_20",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_21",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_22",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_23"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Award dan perintah Tribunal Award Tribunal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_19__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_19__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_19__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Tribunal hendaklah membuat awardnya tanpa kelengahan dan, jika dapat dilaksanakan, dalam masa enam puluh hari dari hari pertama pendengaran di hadapan Tribunal bermula."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_19__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Tribunal hendaklah menyatakan secara bertulis sebab bagi award atau penolakan aduan gangguan seksual itu bersama dengan apa-apa dapatan fakta yang diambil maklum oleh Tribunal atau syor yang telah dibuat oleh Tribunal dalam prosiding itu. Perintah"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_20__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_20__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_20__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_20__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_20__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_20__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_20__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_20__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam membuat suatu award di bawah seksyen 19, Tribunal boleh membuat mana-mana satu atau lebih perintah yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_20__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_20__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu perintah bagi responden untuk mengeluarkan suatu pernyataan permohonan maaf kepada pengadu sebagaimana yang dinyatakan dalam perintah itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_20__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_20__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika aduan itu berhubung dengan apa-apa perbuatan gangguan seksual yang dilakukan di khalayak ramai, suatu perintah bagi responden untuk menyiarkan suatu pernyataan permohonan maaf kepada pengadu dalam apa-apa cara sebagaimana yang dinyatakan dalam perintah itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_20__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_20__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu perintah bagi responden untuk membayar apa-apa pampasan atau ganti rugi yang tidak melebihi dua ratus lima puluh ribu ringgit bagi apa-apa kehilangan atau kerosakan yang ditanggung oleh pengadu berkenaan dengan perbuatan gangguan seksual itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_20__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_20__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu perintah bagi pihak-pihak untuk menghadiri apa-apa program sebagaimana yang difikirkan perlu oleh Tribunal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_20__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Tribunal boleh membuat apa-apa perintah sampingan atau berbangkit atau relief sebagaimana yang perlu untuk menguatkuasakan apa-apa perintah yang dibuat oleh Tribunal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_20__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Tribunal boleh menolak sesuatu aduan gangguan seksual yang dianggap remeh atau menyusahkan oleh Tribunal. Penalti jenayah bagi kegagalan untuk mematuhi award"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_21__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_21__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_21__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_21__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_21__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang gagal untuk mematuhi suatu award yang dibuat oleh Tribunal di bawah seksyen 19 dalam masa tiga puluh hari dari tarikh yang award itu dibuat, melakukan suatu kesalahan dan boleh, apabila disabitkan, dikenakan dengan mana-mana yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_21__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_21__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal pampasan atau ganti rugi diperintahkan oleh Tribunal, didenda dengan suatu denda yang dua kali ganda jumlah amaun pampasan atau ganti rugi itu, atau dipenjarakan selama tempoh yang tidak melebihi dua tahun, atau kedua-duanya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_21__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_21__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal tiada pampasan atau ganti rugi diperintahkan oleh Tribunal, didenda dengan suatu denda yang tidak melebihi sepuluh ribu ringgit, atau dipenjarakan selama tempoh yang tidak melebihi dua tahun, atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_21__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam hal suatu kesalahan yang berterusan, orang itu boleh, sebagai tambahan kepada penalti yang dinyatakan di bawah subseksyen (1), dikenakan denda yang tidak melebihi satu ribu ringgit bagi setiap hari atau sebahagian hari selama kesalahan itu berterusan selepas sabitan. Award Tribunal adalah muktamad"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_22__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_22__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_22__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_22__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_22__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu award yang dibuat di bawah subseksyen 16(3) atau seksyen 19 hendaklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_22__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_22__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tertakluk kepada seksyen 23, muktamad dan mengikat semua pihak kepada prosiding itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_22__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_22__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "disifatkan sebagai suatu perintah mahkamah dan dikuatkuasakan dengan sewajarnya oleh mana-mana pihak kepada prosiding itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_22__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud perenggan (1)(b), Setiausaha kepada Tribunal hendaklah menghantar suatu salinan award yang dibuat oleh Tribunal kepada mahkamah yang mempunyai bidang kuasa di tempat yang baginya award itu berkaitan atau di tempat yang award itu dibuat dan mahkamah hendaklah menyebabkan salinan award itu direkodkan. Mencabar award atas alasan ketidakteraturan yang serius"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_23__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_23__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_23__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_23__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pihak kepada prosiding Tribunal boleh, apabila notis diberikan kepada pihak yang satu lagi dan kepada Tribunal, memohon kepada Mahkamah Tinggi untuk mencabar suatu award dalam prosiding itu hanya atas alasan ketidakteraturan yang serius yang menjejaskan award itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_23__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_23__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_23__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika terdapat ketidakteraturan yang serius yang menjejaskan award, Mahkamah Tinggi boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_23__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_23__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mengembalikan award itu kepada Tribunal, secara keseluruhan atau sebahagian, untuk pertimbangan semula; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_23__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_23__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mengetepikan award itu secara keseluruhan atau sebahagian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_23__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_23__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_23__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini, “ketidakteraturan yang serius” ertinya suatu ketidakteraturan mengenai satu atau lebih jenis yang berikut yang Mahkamah Tinggi berpendapat telah menyebabkan ketidakadilan yang substansial kepada pemohon:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_23__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_23__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "kegagalan Tribunal untuk menangani semua isu yang berkaitan yang dikemukakan kepadanya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_23__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_II__chp_4__cl_23__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "ketidaktentuan atau ketaksaan mengenai kesan award itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_IV__cl_26",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_IV__cl_27"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "AM Kuasa untuk membuat peraturan-peraturan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_IV__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_IV__cl_26__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_IV__cl_26__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_IV__cl_26__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_IV__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh membuat apa-apa peraturan-peraturan sebagaimana yang perlu atau suai manfaat berkenaan dengan Tribunal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_IV__cl_26__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_IV__cl_26__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_IV__cl_26__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_IV__cl_26__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_IV__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan keluasan subseksyen (1), peraturan-peraturan boleh dibuat bagi—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_IV__cl_26__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_IV__cl_26__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menetapkan borang yang akan digunakan dalam prosiding di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_IV__cl_26__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_IV__cl_26__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menetapkan dan mengenakan fi dan memperuntukkan cara untuk memungut dan membayar fi itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_IV__cl_26__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_IV__cl_26__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menetapkan apa-apa perkara lain bagi melaksanakan peruntukan Akta ini dengan lebih baik. Peruntukan khas bagi laporan polis di bawah mana-mana undang-undang bertulis"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_IV__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun suatu aduan gangguan seksual yang dibuat di bawah Akta ini, seorang pengadu, atau mana-mana orang lain tidak terhalang daripada membuat suatu laporan polis bagi apa-apa kesalahan yang berhubungan dengan gangguan seksual di bawah mana-mana undang-undang bertulis."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_I__cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_I__cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Antigangguan Seksual 2021."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_I__cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta, dan Menteri boleh menetapkan tarikh yang berlainan bagi permulaan kuat kuasa bahagian atau peruntukan yang berlainan Akta ini. Tafsiran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_I__cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_I__cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_I",
      "schema:name": {
        "@language": "ms",
        "@value": "Dalam Akta ini, melainkan jika konteksnya menghendaki makna yang lain—"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "“award” ertinya suatu award yang dibuat oleh Tribunal berkenaan dengan apa-apa aduan atau perkara yang dirujuk kepadanya atau apa-apa keputusan atau perintah yang dibuat olehnya di bawah Akta ini; “ditetapkan” ertinya ditetapkan oleh Menteri dalam peraturan-peraturan yang dibuat di bawah seksyen 26; “gangguan seksual” ertinya apa-apa kelakuan tidak diingini yang bersifat seksual, dalam apa-apa bentuk, sama ada secara lisan, bukan lisan, visual, isyarat atau fizikal, yang ditujukan kepada seseorang yang secara munasabahnya menyinggung atau menghina atau merupakan suatu ancaman kepada kesejahteraannya; “Menteri” ertinya Menteri yang dipertanggungkan dengan tanggungjawab bagi pembangunan wanita, keluarga dan masyarakat; “pengadu” ertinya seseorang yang memulakan suatu prosiding di hadapan Tribunal supaya suatu perkara diuruskan oleh Tribunal; “Pentadbir” ertinya Pentadbir Antigangguan Seksual di bawah seksyen 24; “perintah interlokutori” ertinya suatu perintah yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_I__cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_I__cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dibuat menurut suatu aduan gangguan seksual kepada Tribunal dalam penjalanan apa-apa prosiding Tribunal; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_I__cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/18/msa@/~part_I__cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "bersampingan dengan tujuan utama prosiding itu; dan termasuklah apa-apa arahan tentang penjalanan prosiding itu, tetapi tidak termasuk apa-apa perintah separa atau interim yang membuat suatu penentuan muktamad berkenaan dengan prosiding itu; “pihak” ertinya seseorang pengadu atau responden; “responden” ertinya seseorang yang terhadapnya suatu prosiding dimulakan oleh pengadu; “Tribunal” ertinya Tribunal bagi Antigangguan Seksual yang ditubuhkan di bawah seksyen 3."
      }
    }
  ]
}
