      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/2/eng@/~cl_11__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/2/eng@/~cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "in subsubparagraph (1)(a)(E), by deleting the word “and” at the end of the subsubparagraph;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/2/eng@/~cl_11__para_c",
      "@type": "akn:paragraph",
