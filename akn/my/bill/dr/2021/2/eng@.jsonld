    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/2/eng@/~cl_56__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/2/eng@/~cl_56",
      "schema:text": {
        "@language": "en",
        "@value": "All references to “index-linked deposit” in the principal Act shall, on the coming into operation of this Act, be construed as references to “investments linked to derivatives”."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/2/eng@/~cl_56__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/2/eng@/~cl_56",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsubparagraph 41(1)(a)(EA), all investments linked to derivatives previously specified as insured by the Corporation shall continue to be insured by the Corporation until they reach maturity, are fully withdrawn or are otherwise terminated, whichever is earlier."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/2/eng@/~cl_56__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/2/eng@/~cl_56",
      "schema:text": {
        "@language": "en",
        "@value": "For the avoidance of doubt, Islamic deposits accepted by a deposit-taking member under the repealed Islamic Banking Act 1983 [Act 276] which are deemed to be Islamic deposits under section 288 of the Islamic Financial Services Act 2013 and which have been specified as insured by the Corporation shall continue to be insured by the Corporation until they cease to be deemed as Islamic deposits under the Islamic Financial Services Act 2013."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/2/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/2/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 13 of the principal Act is amended by inserting after subsection (2) the following subsection: “(3) An alternate director assigned in subsection 11(2b) by a director referred to in paragraph 11(2)(b) or (c) (referred to in this subsection as “principal director”) shall, unless the assignment is sooner revoked in writing or the position is no longer in existence, cease to be an alternate director when the principal director ceases to be a member of the Board.”. Amendment of section 16"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/2/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/2/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 16 of the principal Act is amended by inserting after the word “director” the words “including alternate director”. Amendment of section 18"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/2/eng@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/2/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 18 of the principal Act is amended by deleting subsection (3). Amendment of section 28"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/2/eng@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/2/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 28 of the principal Act is amended by inserting after subsection (2) the following subsection: “(3) The Corporation is empowered to transfer monies or assets from any of the funds to another fund, as may be necessary for or in connection with, or reasonably incidental to, the furtherance of its objects, the performance of its functions or the discharge of its duties, and subject to such conditions as the Corporation may specify.”. Amendment of section 34"
      }
    }
  ]
}
