        "@value": "by substituting for the definition of “Islamic deposit” the following definition: ‘ “Islamic deposit” has the same meaning as defined under subsection 2(1) of the Islamic Financial Services Act 2013;’;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/2/eng@/~cl_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/2/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the definition of “conventional deposit” the following definition: ‘ “conventional deposit” has the same meaning assigned to the definition of “deposit” under subsection 2(1) of the Financial Services Act 2013 and does not include an Islamic deposit;’;"
      }
    },
