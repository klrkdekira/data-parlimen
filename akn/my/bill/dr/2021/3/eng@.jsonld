      "schema:text": {
        "@language": "en",
        "@value": "The Temporary Measures for Government Financing (Coronavirus Disease 2019 (COVID-19)) Act 2020 [Act 830], which is referred to as the “principal Act” in this Act, is amended in subsection 3(1) by substituting for the words “sixty per centum” the words “sixty-five per centum”. Amendment of Schedule"
      }
