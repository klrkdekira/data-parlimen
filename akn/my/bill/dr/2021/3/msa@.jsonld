      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Langkah-Langkah Sementara bagi Pembiayaan Kerajaan (Penyakit Koronavirus 2019 (COVID-19)) (Pindaan) 2021. Pindaan seksyen 3"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/3/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/3/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Langkah-Langkah Sementara bagi Pembiayaan Kerajaan (Penyakit Koronavirus 2019 (COVID-19)) 2020 [Akta 830], yang disebut “Akta ibu” dalam Akta ini, dipinda dalam subseksyen 3(1) dengan menggantikan perkataan “enam puluh peratus” dengan perkataan “enam puluh lima peratus”. Pindaan Jadual"
      }
    },
