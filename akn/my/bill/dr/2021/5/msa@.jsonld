      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “pemburu berlesen” perkataan “atau pemegang permit khas untuk memburu”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/5/msa@/~cl_14__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/5/msa@/~cl_14__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “sepuluh ribu ringgit” dengan perkataan “lima puluh ribu ringgit; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/5/msa@/~cl_14__para_c__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/5/msa@/~cl_14__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “enam bulan” dengan perkataan “tiga tahun”. Pindaan seksyen 37"
      }
    },
