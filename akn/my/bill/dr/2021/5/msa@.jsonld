      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “lima tahun” dengan perkataan “tujuh tahun”. Pindaan seksyen 62"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/5/msa@/~cl_34",
