      "schema:text": {
        "@language": "ms",
        "@value": "Akta Pemuliharaan Hidupan Liar 2010 [Akta 716], yang disebut “Akta ibu” dalam Akta ini, dipinda dalam seksyen 3—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/5/msa@/~cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
