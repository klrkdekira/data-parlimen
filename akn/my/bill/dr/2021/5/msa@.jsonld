      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “lima ribu ringgit” dengan perkataan “lima puluh ribu ringgit”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/5/msa@/~cl_58__para_b",
      "@type": "akn:paragraph",
