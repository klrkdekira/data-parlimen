      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “dua tahun” dengan perkataan “tiga tahun”. Pindaan seksyen 65"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/5/msa@/~cl_37",
