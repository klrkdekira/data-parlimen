      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 17 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/5/msa@/~cl_60",
