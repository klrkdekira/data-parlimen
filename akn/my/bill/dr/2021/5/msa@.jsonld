      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “sepuluh ribu ringgit” dengan perkataan “lima puluh ribu ringgit”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/5/msa@/~cl_6__para_b__subpara_ii",
