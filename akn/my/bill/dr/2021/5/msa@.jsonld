      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan (e) perenggan yang berikut: “(f) rekod kelahiran, kematian dan kehilangan hidupan liar yang dibiakbaka dalam kurungan komersial.”; dan"
      }
    },
    {
