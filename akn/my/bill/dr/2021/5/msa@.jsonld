      "schema:text": {
        "@language": "ms",
        "@value": "dalam nota bahu, dengan memasukkan selepas perkataan “hidupan liar yang dilindungi” perkataan “atau hidupan liar yang dikawal”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/5/msa@/~cl_37__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
