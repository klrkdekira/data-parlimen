      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “didenda tidak kurang daripada dua puluh ribu ringgit dan tidak lebih daripada lima puluh ribu ringgit” dengan perkataan “didenda tidak melebihi lima puluh ribu ringgit”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/5/msa@/~cl_36__para_b",
      "@type": "akn:paragraph",
