      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “mengeksport,” perkataan “mengeksport semula, menjalankan penyelidikan ke atas,”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/5/msa@/~cl_26__para_b",
      "@type": "akn:paragraph",
