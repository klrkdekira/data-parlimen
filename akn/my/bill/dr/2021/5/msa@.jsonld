      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “mana-mana bahagian atau terbitan hidupan liar yang dilindungi” perkataan “atau hidupan liar yang dikawal”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/5/msa@/~cl_37__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
