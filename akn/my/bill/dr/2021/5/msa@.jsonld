      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “hidupan liar” perkataan “atau mana-mana bahagian atau terbitan mana-mana hidupan liar”. Pindaan seksyen 51"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/5/msa@/~cl_27",
