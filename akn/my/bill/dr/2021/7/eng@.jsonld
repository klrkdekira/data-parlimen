      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the National Trust Fund (Amendment) Act 2021."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/7/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/7/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Amendment of section 6"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/7/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/7/eng@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/7/eng@/~cl_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/7/eng@/~cl_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/7/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The National Trust Fund Act 1988 [Act 339] is amended in section 6—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/7/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/7/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (a), by deleting the word “and” after the semicolon at the end of the paragraph;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/7/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/7/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (b), by substituting for the full stop at the end of the paragraph the words “; and”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/7/eng@/~cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2021/7/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after paragraph (b) the following paragraph: “(c) the procurement of vaccines and any expenditure incurred in relation to the vaccines for an epidemic of any infectious disease as specified under the Prevention and Control of Infectious Diseases Act 1988 [Act 342].”."
      }
    }
  ]
