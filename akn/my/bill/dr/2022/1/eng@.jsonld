      "schema:text": {
        "@language": "en",
        "@value": "Section 67 of the principal Act is amended by substituting for subsection (2) the following subsection: “(2) Any person who contravenes subsection (1) commits an offence and shall, on conviction, be liable to a fine not exceeding one hundred thousand ringgit or to imprisonment for a term not exceeding seven years or to both.”. Amendment of section 68"
      }
