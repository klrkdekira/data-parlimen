        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/1/msa@/~cl_22__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/1/msa@/~cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (d)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/1/msa@/~cl_22__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/1/msa@/~cl_22__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan mengantikan perkataan “hutan lipur” dengan perkataan “hutan simpanan kekal”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/1/msa@/~cl_22__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/1/msa@/~cl_22__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan “dan” di hujung perenggan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/1/msa@/~cl_22__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/1/msa@/~cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (e), dengan menggantikan noktah dengan perkataan “; dan”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/1/msa@/~cl_22__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/1/msa@/~cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan (e) perenggan yang berikut: “(f) apa-apa perbelanjaan yang ditanggung oleh Pihak Berkuasa Negeri dalam menguruskan dan menjalankan pembangunan mampan hutan simpanan kekal.”. Seksyen baharu 60a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/1/msa@/~cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/1/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memasukkan selepas seksyen 60 seksyen yang berikut: “Kuasa untuk mengurangkan, melepaskan atau mengecualikan ses pembangunan hutan 60a. (1) Walau apa pun seksyen 60, Pihak Berkuasa Negeri boleh mengurangkan, meringankan atau melepaskan suatu ses pembangunan hutan, atau mengecualikan pembayaran suatu ses pembangunan hutan, berkenaan dengan mana-mana hasil hutan yang dinyatakan dalam Jadual Ketiga, yang dikeluarkan dari mana-mana hutan simpanan kekal, tanah Kerajaan, tanah rizab, tanah lombong atau tanah beri milik. (2) Tertakluk kepada apa-apa arahan yang berlawanan oleh Pihak Berkuasa Negeri, Pengarah boleh mengurangkan, meringankan atau melepaskan suatu ses pembangunan hutan, atau mengecualikan pembayaran suatu ses pembangunan hutan— (a) berkenaan dengan apa-apa hasil hutan atau kelas hasil hutan bagi maksud yang berikut: (i) bagi maksud saintifik, atau maksud bukan komersial yang lain; (ii) untuk menggalakkan penggunaan pelbagai ukuran dan jenis hasil hutan yang kurang atau tiada permintaan pasaran dan yang selainnya tidak menguntungkan jika diambil; (iii) untuk menggalakkan pengambilan hasil hutan yang dirosakkan oleh kebakaran, perosak, penyakit atau sebab lain; atau (iv) bagi pembinaan jalan hutan atau apa-apa kerja kemudahan awam; (b) berkenaan dengan apa-apa hasil hutan atau kelas hasil hutan yang dikeluarkan dari mana-mana tanah Kerajaan atau tanah beri milik oleh mana-mana orang asli— (i) bagi pembinaan dan pembaikan pondok sementara atas mana-mana tanah yang diduduki secara sah oleh orang asli itu; (ii) bagi penyenggaraan kelong menangkap ikan dan tempat mendarat; (iii) bagi kayu api atau maksud domestik lain; atau (iv) bagi pembinaan atau penyenggaraan apa-apa kerja bagi faedah bersama orang asli.”. Pindaan seksyen 66"
      }
    },
