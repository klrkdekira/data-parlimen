      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/1/msa@/~cl_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (b)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/1/msa@/~cl_2__para_b__subpara_ii__subpara_A",
      "@type": "akn:subparagraph",
      "eli:number": "A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/1/msa@/~cl_2__para_b__subpara_ii",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan subperenggan (ii) subperenggan yang berikut: “(iii) tumbuhan daratan yang dinyatakan dalam Jadual Ketiga kepada Akta Perdagangan Antarabangsa mengenai Spesies Terancam 2008 [Akta 686];”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/1/msa@/~cl_2__para_b__subpara_ii__subpara_B",
      "@type": "akn:subparagraph",
      "eli:number": "B",
