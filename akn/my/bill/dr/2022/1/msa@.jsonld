      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan nota bahu dengan nota bahu yang berikut: “Larangan membuang sampah-sarap”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/1/msa@/~cl_34__para_b",
