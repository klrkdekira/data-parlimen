      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/1/msa@/~cl_30__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (c), dengan menggantikan perkataan “(a) dan (b)” dengan perkataan “wang tunai, draf bank, cek jurubank atau wang melalui pemindahan dana elektronik”;"
      }
    },
    {
