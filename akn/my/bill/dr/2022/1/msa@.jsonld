      "schema:text": {
        "@language": "ms",
        "@value": "dalam teks bahasa Inggeris, dalam takrif “take”, dengan menggantikan perkataan “cattle” dengan perkataan “livestock”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/1/msa@/~cl_2__para_e",
