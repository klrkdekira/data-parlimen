      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/1/msa@/~cl_30__para_b__subpara_i",
      "@type": "akn:subparagraph",
