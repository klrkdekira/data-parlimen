      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif “pegawai polis” takrif yang berikut: ‘ “pegawai yang diberi kuasa” ertinya seseorang pegawai yang diberi kuasa di bawah seksyen 3a;’;"
      }
    },
    {
