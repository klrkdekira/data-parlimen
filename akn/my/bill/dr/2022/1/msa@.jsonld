      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perenggan (b) dengan perenggan yang berikut: “(b) draf bank; (ba) cek jurubank; (bb) wang melalui pemindahan dana elektronik; atau”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/1/msa@/~cl_30__para_b__subpara_ii",
      "@type": "akn:subparagraph",
