      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan “yang didapati berada di dalam kawasan hutan simpanan kekal atau tanah Kerajaan”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/1/msa@/~cl_56__para_a__subpara_ii",
