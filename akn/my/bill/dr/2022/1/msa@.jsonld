      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1), dengan memotong perkataan “secara mengganggu”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/1/msa@/~cl_34__para_c",
