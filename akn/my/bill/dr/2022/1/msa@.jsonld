      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (e), dengan menggantikan noktah dengan koma bernoktah; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/1/msa@/~cl_56__para_c",
