      "schema:text": {
        "@language": "ms",
        "@value": "dengan menomborkan semula subperenggan (iii) sedia ada sebagai subperenggan (iv);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/1/msa@/~cl_2__para_c",
