      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “pegawai polis atau anggota angkatan tentera” di mana-mana jua terdapat dengan perkataan “pegawai yang diberi kuasa atau pegawai polis”. Pemotongan seksyen 107"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/1/msa@/~cl_58",
