      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/10/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph 2—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/10/eng@/~cl_3__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/10/eng@/~cl_3__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for item 44 the following item: Monthly Employer’s Wages Contribution Contribution “44. When RM69.15 wages exceed RM3,900 but not RM4,000"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/10/eng@/~cl_3__para_a__subpara_ii",
