      "schema:text": {
        "@language": "en",
        "@value": "by inserting after item 45 the following items: Monthly Wages Employer’s Contribution “46. When wages exceed RM4,100 RM51.90 but not RM4,200 47. When wages exceed RM4,200 RM53.10 but not RM4,300 48. When wages exceed RM4,300 RM54.40 but not RM4,400 49. When wages exceed RM4,400 RM55.60 but not RM4,500 50. When wages exceed RM4,500 RM56.90 but not RM4,600 51. When wages exceed RM4,600 RM58.10 but not RM4,700 52. When wages exceed RM4,700 RM59.40 but not RM4,800 53. When wages exceed RM4,800 RM60.60 but not RM4,900 54. When wages exceed RM4,900 RM61.90 but not RM5,000 55. When wages exceed RM5,000 RM61.90”. Amendment of Fourth Schedule"
      }
