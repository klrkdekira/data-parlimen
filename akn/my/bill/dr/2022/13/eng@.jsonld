      ],
      "schema:name": {
        "@language": "en",
        "@value": "Courts of Judicature (Amendment) Bill 2022"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/13/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/13/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/13/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/13/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/13/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/13/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Courts of Judicature (Amendment) Act 2022."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/13/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/13/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Amendment of section 28"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/13/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/13/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Courts of Judicature Act 1964 [Act 91], which is referred to as the “principal Act” in this Act, is amended in section 28 by substituting for subsection (1) the following subsection: “(1) No appeal shall lie to the High Court in any of the following cases: (a) subject to any other written law, from a decision of a subordinate court in any civil cause or matter where the amount in dispute or the value of the subject matter is ten thousand ringgit or less except on a question of law; (b) where a subordinate court dismissed any application for a summary judgment; (c) where a subordinate court dismissed any application to strike out any writ or pleading; and (d) where a subordinate court allowed any application to set aside a judgment in default.”. Amendment of section 51"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/13/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/13/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 51(2) of the principal Act is amended by substituting for the words “an address” the words “a postal address or an electronic address”. Amendment of section 52"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/13/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/13/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 52(2) of the principal Act is amended by substituting for the words “address for service” the words “postal address or electronic address”. New section 52a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/13/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/13/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting after section 52 the following section: “Notice or document etc., sent by electronic means 52a. Any notices or documents which are sent by electronic means referred to in sections 51 and 52 shall be deemed to have been served and delivered upon sending the notices or documents to the appellant’s or his advocate’s electronic address.”. Amendment of section 53"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/13/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/13/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 53(1) of the principal Act is amended by substituting for the words “five copies” the words “a copy”. Amendment of section 55"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/13/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/13/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 55(1) of the principal Act is amended by substituting for the words “four copies” wherever appearing the words “a copy”. Amendment of section 68"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/13/eng@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/13/eng@/~cl_8__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/13/eng@/~cl_8__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/13/eng@/~cl_8__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/13/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Subsection 68(1) of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/13/eng@/~cl_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/13/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (c), by deleting the word “and” at the end of the paragraph;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/13/eng@/~cl_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/13/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (d), by substituting for the full stop at the end of the paragraph a semicolon; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/13/eng@/~cl_8__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/13/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after paragraph (d) the following paragraphs: “(e) where a High Court dismissed any application for a summary judgment; (f) where a High Court dismissed any application to strike out any writ or pleading; and (g) where a High Court allowed any application to set aside a judgment in default.”."
      }
    }
  ]
}
