      "schema:name": {
        "@language": "en",
        "@value": "Criminal Procedure Code (Amendment) Bill 2022"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Criminal Procedure Code (Amendment) Act 2022."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Amendment of section 307"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/eng@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/eng@/~cl_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/eng@/~cl_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/eng@/~cl_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The Criminal Procedure Code [Act 593] is amended in section 307—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (2), by substituting for the words “an address” the words “a postal address or an electronic address”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (3) the following subsection: “(3) When a notice of appeal has been lodged, the Court appealed from shall make a signed copy of the grounds of decision in the case and cause the said copy to be served upon the appellant or his advocate— (a) by leaving it at the postal address of the appellant or his advocate; (b) by posting it by registered post addressed at the postal address of the appellant or his advocate; or (c) by sending it to the electronic address of the appellant or his advocate, mentioned in the notice of appeal.”."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/eng@/~cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (3) the following subsection: “(3a) The signed copy of the grounds of decision which is sent by electronic means referred to in paragraph (3)(c) shall be deemed to have been served and delivered upon sending the said copy to the appellant’s or his advocate’s electronic address.”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/eng@/~cl_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/eng@/~cl_2__para_d__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/eng@/~cl_2__para_d__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (5)(b)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/eng@/~cl_2__para_d__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/eng@/~cl_2__para_d",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the word “left” the word “served”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/eng@/~cl_2__para_d__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/eng@/~cl_2__para_d",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words “address for service” the words “postal address or electronic address”."
      }
    }
  ]
}
