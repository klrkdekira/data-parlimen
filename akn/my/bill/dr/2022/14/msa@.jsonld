      "schema:name": {
        "@language": "ms",
        "@value": "RUU Kanun Tatacara Jenayah (Pindaan) 2022"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Kanun Tatacara Jenayah (Pindaan) 2022."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta. Pindaan seksyen 307"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/msa@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/msa@/~cl_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/msa@/~cl_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/msa@/~cl_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Kanun Tatacara Jenayah [ Akta 593] dipinda dalam seksyen 307—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2), dengan menggantikan perkataan “an address” dengan perkataan “a postal address or an electronic address”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (3) dengan subseksyen yang berikut: “(3) When a notice of appeal has been lodged, the Court appealed from shall make a signed copy of the grounds of decision in the case and cause the said copy to be served upon the appellant or his advocate— (a) by leaving it at the postal address of the appellant or his advocate; (b) by posting it by registered post addressed at the postal address of the appellant or his advocate; or (c) by sending it to the electronic address of the appellant or his advocate, mentioned in the notice of appeal.”."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/msa@/~cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (3) subseksyen yang berikut: “(3a) The signed copy of the grounds of decision which is sent by electronic means referred to in paragraph (3)(c) shall be deemed to have been served and delivered upon sending the said copy to the appellant’s or his advocate’s electronic address.”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/msa@/~cl_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/msa@/~cl_2__para_d__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/msa@/~cl_2__para_d__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (5)(b)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/msa@/~cl_2__para_d__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/msa@/~cl_2__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “left” dengan perkataan “served”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/msa@/~cl_2__para_d__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/14/msa@/~cl_2__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “address for service” dengan perkataan “postal address or electronic address”."
      }
    }
  ]
}
