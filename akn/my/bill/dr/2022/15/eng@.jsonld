    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/15/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/15/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Constitution (Amendment) (No. 3) Act 2022."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/15/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/15/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Yang di-Pertuan Agong by notification in the Gazette. Amendment of Article 10"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/15/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/15/eng@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/15/eng@/~cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/15/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The Federal Constitution is amended in Article 10—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/15/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/15/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "in Clause (1), by inserting after the words “(3)” the words “, (3a)”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/15/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/15/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after Clause (3) the following Clause: “(3a) Notwithstanding paragraph (c) of Clause (2) and Clause (3), restrictions on the right to form associations conferred by paragraph (c) of Clause (1) relating to membership in a political party of members of the House of Representatives and members of the State Legislative Assembly may also be imposed by federal law.”."
      }
    }
  ]
