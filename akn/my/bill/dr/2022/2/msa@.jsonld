      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (f), dengan menggantikan perkataan “veterinary surgeon” dengan perkataan “registered veterinary surgeon”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/2/msa@/~cl_6__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/2/msa@/~cl_6__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan tanda noktah di hujung perenggan (j) dengan tanda koma bernoktah; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/2/msa@/~cl_6__para_a__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/2/msa@/~cl_6__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan (j) perenggan yang berikut: “(k) a person who requires the poison for the purpose of enabling him to comply with any requirement made by, or in pursuance of, any written law with respect to the medical treatment of persons employed by that person in any business or trade carried out by that person.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/2/msa@/~cl_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/2/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (2) subseksyen yang berikut: “(2a) Any person referred to in paragraph 15(2)(a), (c), (d), (e), (f), (g) or (k) who purchases any poison from a wholesaler other than a licensed wholesaler shall be guilty of an offence against this Act.”."
      }
    },
