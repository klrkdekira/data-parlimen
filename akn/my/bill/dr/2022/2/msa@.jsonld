    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/2/msa@/~cl_20__para_b__subpara_iii__subpara_B",
      "@type": "akn:subparagraph",
      "eli:number": "B",
