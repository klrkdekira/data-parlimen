      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (3), dengan memasukkan selepas perkataan “of” perkataan “the registered pharmacist or”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/2/msa@/~cl_7__para_d",
