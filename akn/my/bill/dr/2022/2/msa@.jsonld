      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (b), dengan menggantikan perkataan “book” dengan perkataan “register”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/2/msa@/~cl_6__para_d",
      "@type": "akn:paragraph",
