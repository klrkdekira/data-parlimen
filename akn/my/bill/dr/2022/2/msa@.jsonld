      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/2/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam takrif ‘ “a Group A Poison” “a Group B Poison” “a Group C Poison” “a Group D Poison” “a Group E Poison” and “a Group F Poison” ’—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/2/msa@/~cl_2__para_f__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/2/msa@/~cl_2__para_f",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan ‘ “a Group D Poison” “a Group E Poison” and “a Group F Poison” ’ dengan perkataan ‘ and “a Group D Poison” ’; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/2/msa@/~cl_2__para_f__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/2/msa@/~cl_2__para_f",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “, Group D, Group E or Group F” dengan perkataan “or Group D”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/2/msa@/~cl_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/2/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong takrif “licensed retailer”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/2/msa@/~cl_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/2/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong takrif “listed seller”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/2/msa@/~cl_2__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/2/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan takrif “medical treatment” dengan takrif yang berikut: ‘ “medical treatment” includes the investigation, examination or treatment of human ailments;’;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/2/msa@/~cl_2__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/2/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam takrif “Part I Poison”, dengan menggantikan perkataan “, Group D, Group E or Group F” dengan perkataan “or Group D”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/2/msa@/~cl_2__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/2/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif “premises” takrif yang berikut: ‘ “Principal Director” means the head of the pharmaceutical services in the Ministry of Health; “psychotropic substance” means any of the substances specified in the Third Schedule;’;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/2/msa@/~cl_2__para_l",
      "@type": "akn:paragraph",
      "eli:number": "l",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/2/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif “registered pharmacist” takrif yang berikut: ‘ “registered veterinary surgeon” means a veterinary surgeon registered under the Veterinary Surgeons Act 1974 [Act 147];’;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/2/msa@/~cl_2__para_m",
      "@type": "akn:paragraph",
      "eli:number": "m",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/2/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong takrif “veterinary officer”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/2/msa@/~cl_2__para_n",
      "@type": "akn:paragraph",
      "eli:number": "n",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/2/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam takrif “wholesale”, dengan menggantikan perkataan “(j)” dengan perkataan “(k)”. Pindaan seksyen 3"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/2/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
