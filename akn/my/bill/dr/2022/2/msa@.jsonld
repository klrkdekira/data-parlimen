      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (d), dengan memotong perkataan “or” di hujung perenggan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/2/msa@/~cl_6__para_a__subpara_ii",
