      ],
      "schema:name": {
        "@language": "en",
        "@value": "Customs (Amendment) Bill 2022"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 82 of the principal Act is amended by substituting for the words “substantially in the prescribed form giving particulars of the goods imported” the words “in the form and manner as determined by the Director General”. Amendment of section 85"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 85 of the principal Act is amended by substituting for the words “substantially in the prescribed form giving particulars of the goods to be exported” the words “in the form and manner as determined by the Director General”. Amendment of section 99"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_12__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_12__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Paragraph 99(1)(d) of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_12__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting after the words “given on the” the word “prescribed”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_12__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words “in the prescribed form” the words “in the form and manner as determined by the Director General”. Amendment of section 142"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 142 of the principal Act is amended by deleting subsections (12) and (35e). Deletion of section 145"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by deleting section 145. New sections 145c and 145d"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_15__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_15__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_15__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_15__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting after section 145b the following sections: “Power to extend period 145c. Where, by this Act, a period is specified within which an act or thing is to be done by a person, and the Minister is satisfied that the act or thing could not be completed in that period due to the occurrence of public emergency or public health crisis, the Minister may, upon such terms and conditions as the Minister thinks fit, extend the period for the completion of the act or thing before the expiration of the period. Power to modify terms and conditions 145d. (1) Where terms and conditions are imposed pursuant to this Act, the Minister may, on the advice of the Director General, from time to time modify the terms and conditions for the purpose of carrying out the objects of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_15__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_15__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "Before modifying the terms and conditions, notice must be given to the person bound by the terms and conditions stating—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_15__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_15__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the terms and conditions as modified; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_15__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_15__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the date the terms and conditions as modified take effect."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_15__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "The modified terms and conditions shall not take effect in less than fourteen days from the date the notice is issued under subsection (2)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_15__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "Where the terms and conditions were initially imposed by the Director General pursuant to this Act, the terms and conditions as modified by the Minister shall be deemed to have been imposed by the Director General."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_15__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this section, “modify” means add to, delete or vary.”. Amendment of section 157"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_16__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_16__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 157 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_16__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the word “any” the word “vehicle,”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_16__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words “substantially in the prescribed form giving particulars of the goods transported in such vessel or aircraft” the words “in the form and manner as determined by the Director General”."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Customs (Amendment) Act 2022."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. General amendment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Customs Act 1967 [Act 235], which is referred to as the “principal Act” in this Act, is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words “in the prescribed form”, wherever appearing in sections 57, 59 and 94, and subsections 16(1), 37(1), 38(2), 52(1), 54(1), 56(1), 58(1) and 143(2), and paragraphs 93(1)(e), 128(3a)(b) and 133(1)(g), the words “in the form and manner as determined by the Director General”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words “substantially in the prescribed form, giving particulars of the goods imported”, wherever appearing in section 83 and subsection 81(1), the words “in the form and manner as determined by the Director General”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words “substantially in the prescribed form, giving particulars of the goods to be exported”, wherever appearing in section 86 and subsection 84(1), the words “in the form and manner as determined by the Director General”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words “substantially in the prescribed form giving particulars of the goods transported in such vehicle, vessel or aircraft”, wherever appearing in sections 163d, 163m and 163t, the words “in the form and manner as determined by the Director General”. Amendment of section 3"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 3(3) of the principal Act is amended by substituting for the words “sections 10f, 13b, 22 and 145” the words “sections 10f, 13b and 22”. Amendment of section 10a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 10a(1) of the principal Act is amended by substituting for the words “Any person may apply, in the prescribed form together with the prescribed fee, to the Director General” the words “Any person may apply to the Director General, in the form and manner as determined by the Director General together with the prescribed fee,”. Amendment of section 19"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 19 of the principal Act is amended by deleting subsection (2). Amendment of section 65a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraph 65 a(3)(b) of the principal Act is amended by substituting for the words “Subject to subsection (4), if” the word “If”. Amendment of section 78"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 78(1) of the principal Act is amended by substituting for the words “in such form as may be prescribed to the proper officer of customs” the words “in the form and manner as determined by the Director General”. Amendment of section 78b"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 78b(2) of the principal Act is amended by substituting for the words “the date of the declaration being approved by the proper officer of customs” the words “the date of arrival of such goods”. Amendment of section 80"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/21/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraph 80(1)(a) of the principal Act is amended by substituting for the words “in the prescribed form and to the officer of customs specified in subsection (2)” the words “in the form and manner as determined by the Director General”. Amendment of section 82"
      }
    }
  ]
}
