      ],
      "schema:name": {
        "@language": "en",
        "@value": "Excise (Amendment) Bill 2022"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 90c of the principal Act is amended by substituting for the words “substantially in the prescribed form giving particulars of the goods transported in such vehicles, vessels or aircraft” the words “in the form and manner as determined by the Director General”. Amendment of section 91w"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 91w of the principal Act is amended by substituting for the words “substantially in the prescribed form giving particulars of the goods transported in such vehicle, vessel or aircraft” the words “in the form and manner as determined by the Director General”."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Excise (Amendment) Act 2022."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. General amendment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@/~cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Excise Act 1976 [Act 176], which is referred to as the “principal Act” in this Act, is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words “in the prescribed form”, wherever appearing in subsection 47(2) and paragraphs 13(1)(b), 19(1)(d), 19a(1)(e) and 67(3a)(b), the words “in the form and manner as determined by the Director General”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words “substantially in the prescribed form giving particulars of the goods transported in such vehicle, vessel or aircraft”, wherever appearing in sections 91dc and 91k, the words “in the form and manner as determined by the Director General”. Amendment of section 5a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 5a(1) of the principal Act is amended by substituting for the words “Any person may apply, in the prescribed form together with the prescribed fee, to the Director General” the words “Any person may apply to the Director General, in the form and manner as determined by the Director General together with the prescribed fee,”. Amendment of section 16"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 16 of the principal Act is amended by deleting subsection (2). Amendment of section 19b"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 19b of the principal Act is amended by substituting for the words “in the prescribed form” the words “in the form and manner as determined by the Director General”. Amendment of section 20"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 20(1) of the principal Act is amended by substituting for the words “in the prescribed form issued by the Director General” the words “issued by the Director General in the form and manner as determined by the Director General”. Amendment of section 23"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 23(1) of the principal Act is amended by substituting for the words “in the prescribed form approved by the proper officer” the words “, in the form and manner as determined by the Director General, approved by the proper officer”. New sections 44aa and 44ab"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@/~cl_8__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@/~cl_8__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@/~cl_8__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@/~cl_8__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting after section 44a the following sections: “Power to extend period 44aa. Where, by this Act, a period is specified within which an act or thing is to be done by a person, and the Minister is satisfied that the act or thing could not be completed in that period due to the occurrence of public emergency or public health crisis, the Minister may, upon such terms and conditions as the Minister thinks fit, extend the period for the completion of the act or thing before the expiration of the period. Power to modify terms and conditions 44ab. (1) Where terms and conditions are imposed pursuant to this Act, the Minister may, on the advice of the Director General, from time to time modify the terms and conditions for the purpose of carrying out the objects of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@/~cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@/~cl_8__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@/~cl_8__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "Before modifying the terms and conditions, notice must be given to the person bound by the terms and conditions stating—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@/~cl_8__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@/~cl_8__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the terms and conditions as modified; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@/~cl_8__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@/~cl_8__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the date the terms and conditions as modified take effect."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@/~cl_8__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "The modified terms and conditions shall not take effect in less than fourteen days from the date the notice is issued under subsection (2)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@/~cl_8__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "Where the terms and conditions were initially imposed by the Director General pursuant to this Act, the terms and conditions as modified by the Minister shall be deemed to have been imposed by the Director General."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@/~cl_8__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this section, “modify” means add to, delete or vary.”. Amendment of section 85"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@/~cl_9__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@/~cl_9__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Subsection 85(2) of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@/~cl_9__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@/~cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting paragraph (bc); and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@/~cl_9__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/22/eng@/~cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (e) by substituting for the words “this Act” the words “section 35”. Amendment of section 90c"
      }
    }
  ]
}
