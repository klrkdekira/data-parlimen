      ],
      "schema:name": {
        "@language": "en",
        "@value": "Goods Vehicle Levy (Amendment) Bill 2022"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/23/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/23/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/23/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/23/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/23/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/23/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Goods Vehicle Levy (Amendment) Act 2022."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/23/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/23/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. New sections 7a and 7b"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/23/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/23/eng@/~cl_2__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/23/eng@/~cl_2__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/23/eng@/~cl_2__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/23/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Goods Vehicle Levy Act 1983 [Act 294] is amended by inserting after section 7 the following sections: “Power to extend period 7a. Where, by this Act, a period is specified within which an act or thing is to be done by a person, and the Minister is satisfied that the act or thing could not be completed in that period due to the occurrence of public emergency or public health crisis, the Minister may, upon such terms and conditions as the Minister thinks fit, extend the period for the completion of the act or thing before the expiration of the period. Power to modify terms and conditions 7b. (1) Where terms and conditions are imposed pursuant to this Act, the Minister may, on the advice of the Director General, from time to time modify the terms and conditions for the purpose of carrying out the objects of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/23/eng@/~cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/23/eng@/~cl_2__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/23/eng@/~cl_2__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/23/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "Before modifying the terms and conditions, notice must be given to the person bound by the terms and conditions stating—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/23/eng@/~cl_2__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/23/eng@/~cl_2__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the terms and conditions as modified; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/23/eng@/~cl_2__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/23/eng@/~cl_2__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the date the terms and conditions as modified take effect."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/23/eng@/~cl_2__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/23/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "The modified terms and conditions shall not take effect in less than fourteen days from the date the notice is issued under subsection (2)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/23/eng@/~cl_2__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/23/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this section, “modify” means add to, delete or vary.”."
      }
    }
  ]
}
