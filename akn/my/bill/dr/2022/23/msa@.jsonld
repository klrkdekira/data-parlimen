      "schema:name": {
        "@language": "ms",
        "@value": "RUU Levi Kenderaan Barang-Barang (Pindaan) 2022"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/23/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
