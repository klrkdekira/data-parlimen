      ],
      "schema:name": {
        "@language": "ms",
        "@value": "RUU Zon Bebas (Pindaan) 2022"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/24/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/24/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/24/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/24/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/24/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/24/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Zon Bebas (Pindaan) 2022."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/24/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/24/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta. Seksyen baharu 48a dan 48b"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/24/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/24/msa@/~cl_2__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/24/msa@/~cl_2__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/24/msa@/~cl_2__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/24/msa@/~cl_2__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/24/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Zon Bebas 1990 [Akta 438] dipinda dengan memasukkan selepas seksyen 48 seksyen yang berikut: “Kuasa untuk melanjutkan tempoh 48a. Jika, melalui Akta ini, suatu tempoh dinyatakan yang dalamnya sesuatu perbuatan atau benda hendaklah dilakukan oleh seseorang, dan Menteri berpuas hati bahawa perbuatan atau benda itu tidak dapat disempurnakan dalam tempoh itu disebabkan oleh berlakunya kecemasan awam atau krisis kesihatan awam, Menteri boleh, mengikut terma dan syarat yang difikirkannya patut, melanjutkan tempoh untuk menyempurnakan perbuatan atau benda itu sebelum habis tempoh itu. Kuasa untuk mengubah suai terma dan syarat 48b. (1) Jika terma dan syarat dikenakan menurut Akta ini, Menteri boleh, atas nasihat Ketua Pengarah, dari semasa ke semasa mengubah suai terma dan syarat bagi maksud melaksanakan tujuan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/24/msa@/~cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/24/msa@/~cl_2__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/24/msa@/~cl_2__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/24/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Sebelum mengubah suai terma dan syarat, notis hendaklah diberikan kepada orang yang terikat dengan terma dan syarat itu menyatakan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/24/msa@/~cl_2__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/24/msa@/~cl_2__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "terma dan syarat sebagaimana diubah suai; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/24/msa@/~cl_2__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/24/msa@/~cl_2__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "tarikh terma dan syarat sebagaimana diubah suai itu berkuat kuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/24/msa@/~cl_2__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/24/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Terma dan syarat yang diubah suai tidak boleh berkuat kuasa kurang daripada empat belas hari dari tarikh notis di bawah subseksyen (2) dikeluarkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/24/msa@/~cl_2__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/24/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika terma dan syarat itu pada mulanya dikenakan oleh Ketua Pengarah atau Pihak Berkuasa menurut Akta ini, terma dan syarat sebagaimana diubah suai oleh Menteri hendaklah disifatkan telah dikenakan oleh Ketua Pengarah atau Pihak Berkuasa, mengikut mana yang berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/24/msa@/~cl_2__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/24/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini, “ubah suai” ertinya tambah, potong atau ubah.”."
      }
    }
  ]
}
