      ],
      "schema:name": {
        "@language": "ms",
        "@value": "RUU Cukai Pelancongan (Pindaan) 2022"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/26/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/26/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/26/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/26/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/26/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/26/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Cukai Pelancongan (Pindaan) 2022."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/26/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/26/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta. Pindaan seksyen 66"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/26/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/26/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Cukai Pelancongan 2017 [Akta 791], yang disebut “Akta ibu” dalam Akta ini, dipinda dalam seksyen 66 dengan memotong subseksyen (3). Seksyen baharu 69a dan 69b"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/26/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/26/msa@/~cl_3__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/26/msa@/~cl_3__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/26/msa@/~cl_3__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/26/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memasukkan selepas seksyen 69 seksyen yang berikut: “Kuasa untuk melanjutkan tempoh 69a. Jika, melalui Akta ini, suatu tempoh dinyatakan yang dalamnya sesuatu perbuatan atau benda hendaklah dilakukan oleh seseorang, dan Menteri berpuas hati bahawa perbuatan atau benda itu tidak dapat disempurnakan dalam tempoh itu disebabkan oleh berlakunya kecemasan awam atau krisis kesihatan awam, Menteri boleh, mengikut terma dan syarat yang difikirkannya patut, melanjutkan tempoh untuk menyempurnakan perbuatan atau benda itu sebelum habis tempoh itu. Kuasa untuk mengubah suai terma dan syarat 69b. (1) Jika terma dan syarat dikenakan menurut Akta ini, Menteri boleh, atas nasihat Ketua Pengarah, dari semasa ke semasa mengubah suai terma dan syarat bagi maksud melaksanakan tujuan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/26/msa@/~cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/26/msa@/~cl_3__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/26/msa@/~cl_3__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/26/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Sebelum mengubah suai terma dan syarat, notis hendaklah diberikan kepada orang yang terikat dengan terma dan syarat itu menyatakan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/26/msa@/~cl_3__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/26/msa@/~cl_3__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "terma dan syarat sebagaimana diubah suai; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/26/msa@/~cl_3__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/26/msa@/~cl_3__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "tarikh terma dan syarat sebagaimana diubah suai itu berkuat kuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/26/msa@/~cl_3__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/26/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Terma dan syarat yang diubah suai tidak boleh berkuat kuasa kurang daripada empat belas hari dari tarikh notis di bawah subseksyen (2) dikeluarkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/26/msa@/~cl_3__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/26/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini, “ubah suai” ertinya tambah, potong atau ubah.”. Pindaan seksyen 70"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/26/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/26/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 70 Akta ibu dipinda dengan memasukkan selepas perenggan (2)(c) perenggan yang berikut: “(ca) untuk menetapkan butir-butir dalam invois atau resit yang hendak digunakan di bawah dan bagi maksud yang berkaitan dengan Akta ini;”."
      }
    }
  ]
}
