        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/28/msa@/~cl_7__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/28/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 9a Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/28/msa@/~cl_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/28/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan nota bahu dengan nota bahu yang berikut: “Caruman pegawai”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/28/msa@/~cl_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/28/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (1) subseksyen yang berikut: “(1a) Seorang pegawai boleh juga memohon suatu pemotongan lanjut melebihi sepuluh peratus daripada gaji bulanannya sebagaimana yang ditentukan oleh pegawai itu sebagai carumannya kepada Tabung dan amaun caruman itu hendaklah dikreditkan kepada akaun pegawai itu.”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/28/msa@/~cl_7__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/28/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “subseksyen (1)” di mana-mana jua terdapat dengan perkataan “subseksyen (1) dan (1a)”. Pindaan seksyen 11"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/28/msa@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/28/msa@/~cl_8__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/28/msa@/~cl_8__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/28/msa@/~cl_8__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/28/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 11 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/28/msa@/~cl_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/28/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (1) dengan subseksyen yang berikut: “(1) Tertakluk kepada peruntukan seksyen ini, Lembaga boleh, dengan kelulusan Menteri, pada atau selepas berakhirnya tahun kewangan pada setiap tahun, mengisytiharkan suatu kadar keuntungan atas caruman kepada Tabung berdasarkan prestasi kewangan sebenar Lembaga bagi tahun itu.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/28/msa@/~cl_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/28/msa@/~cl_8__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/28/msa@/~cl_8__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/28/msa@/~cl_8__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/28/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2)— “(c) Lembaga berpuas hati dengan kemampuan Tabung untuk membuat semua pembayaran yang dikehendaki untuk dibayar di bawah Akta ini tidak terancam dengan perisytiharan kadar itu.”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/28/msa@/~cl_8__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/28/msa@/~cl_8__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perenggan (a);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/28/msa@/~cl_8__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/28/msa@/~cl_8__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (ba), dengan menggantikan perkataan “yang difikirkan cukup oleh aktuari” dengan perkataan “yang mencukupi”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/28/msa@/~cl_8__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/28/msa@/~cl_8__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perenggan (c) dengan perenggan yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/28/msa@/~cl_8__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/28/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (2) subseksyen yang berikut: “( 2a) Bagi maksud perisytiharan keuntungan di bawah subseksyen (1), Lembaga hendaklah dianggap sebagai solven sekiranya Lembaga berupaya untuk membayar hutangnya jika dan apabila hutang itu menjadi kena dibayar dalam masa dua belas bulan sebaik selepas perisytiharan itu dibuat. (2b) Lem baga boleh, dari semasa ke semasa sebagaimana yang difikirkannya perlu, melantik aktuari yang berkelayakan dan bebas untuk membantu Lembaga dalam membuat penilaian prestasi kewangannya menurut seksyen ini dan penilaian sedemikian boleh dijadikan sebagai panduan kepada Lembaga.”. Pindaan seksyen 12"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/28/msa@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/28/msa@/~cl_9__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/28/msa@/~cl_9__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/28/msa@/~cl_9__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/28/msa@/~cl_9__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/28/msa@/~cl_9__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/28/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 12 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/28/msa@/~cl_9__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/28/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (1) dengan subseksyen yang berikut: “(1) Tertakluk kepada Akta ini, apa-apa amaun yang ada dalam kredit akaun seseorang pencarum di bawah Akta ini hanya boleh dikeluarkan— (a) apabila pencarum itu mati; (b) apabila pencarum itu telah diperakui sebagai tidak berupaya untuk berkhidmat dari segi fizikal atau mental; (c) apabila pencarum itu mencapai umur lima puluh tahun dan, jika pencarum itu ialah seorang pegawai, apabila pegawai itu mencapai umur persaraan wajib; (d) tiga puluh hari selepas pencarum itu bersara daripada perkhidmatan; atau (e) tiga puluh hari selepas pencarum itu diberhentikan daripada perkhidmatan.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/28/msa@/~cl_9__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/28/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1a), dengan menggantikan perkataan “perenggan (1)(b) atau (c)” dengan perkataan “perenggan (1)(c), (d) atau (e)”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/28/msa@/~cl_9__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/28/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (1a) subseksyen yang berikut: “(1b) Bagi maksud pengeluaran di bawah perenggan 12(1)(a) atau (b), Lembaga hendaklah membenarkan pengeluaran semua jumlah wang yang ada dalam kredit akaun pencarum di bawah Akta ini, sekiranya— (a) dimohon oleh waris pencarum apabila pencarum itu mati; atau (b) dimohon oleh waris kadim kepada pencarum yang telah diperakui sebagai tidak berupaya untuk berkhidmat dari segi fizikal atau mental.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/28/msa@/~cl_9__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/28/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (2) subseksyen yang berikut: “(2a) Pencarum yang telah diberhentikan atau bersara daripada perkhidmatan boleh memilih untuk mengeluarkan atau menyimpan apa-apa amaun yang ada dalam kredit akaunnya dalam Tabung dan amaun yang ada itu berhak menerima kadar keuntungan bagi caruman yang disimpan dalam Tabung di bawah Akta ini.”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/28/msa@/~cl_9__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/28/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (3), dengan menggantikan perkataan “perenggan (1)(b)” dengan perkataan “perenggan (1)(d) dan (e)”. Penggantian seksyen 15"
      }
    }
  ]
}
