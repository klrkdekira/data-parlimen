      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/3/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/3/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/3/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Majlis Pembangunan Wilayah Ekonomi Pantai Timur (Pindaan) 2022."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/3/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/3/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Perdana Menteri, selepas berunding dengan Pihak-Pihak Berkuasa Negeri Kelantan, Terengganu, Pahang dan Johor, melalui pemberitahuan dalam Warta. Pindaan seksyen 4"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/3/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/3/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Majlis Pembangunan Wilayah Ekonomi Pantai Timur 2008 [Akta 688] dipinda dalam seksyen 4 dengan menggantikan perkataan “Daerah Mersing” dengan perkataan “Daerah-Daerah Mersing dan Segamat”."
      }
    }
  ]
