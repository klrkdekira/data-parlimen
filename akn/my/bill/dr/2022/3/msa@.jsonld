      "schema:name": {
        "@language": "ms",
        "@value": "RUU Majlis Pembangunan Wilayah Ekonomi Pantai Timur (Pindaan) 2022"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/3/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
