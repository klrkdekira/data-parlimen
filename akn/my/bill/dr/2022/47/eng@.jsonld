      "schema:name": {
        "@language": "en",
        "@value": "Consolidated Fund (Expenditure on Account) Bill 2022"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/47/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/47/eng@/~cl_1__subsec_1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/47/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/47/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/47/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Consolidated Fund (Expenditure on Account) Act 2022. (2) This Act comes into operation on 1 January 2023. Authorization of expenditure of RM107,718,676,650"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/47/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/47/eng@/~cl_2__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/47/eng@/~cl_2__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/47/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/47/eng@/~cl_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/47/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "In conformity with paragraph (a) of Article 102 of the Federal Constitution, expenditure of an amount not exceeding the sum of one hundred and seven billion seven hundred and eighteen million six hundred and seventy-six thousand six hundred and fifty ringgit (RM107,718,676,650) to be issued from the Consolidated Fund for the service of that part of the year 2023 preceding the date of coming into operation of the Supply Act in respect of that year is hereby authorized."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/47/eng@/~cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/47/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "The amount authorized for each service specified in Column (1) of the Schedule is as specified in Column (2)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/47/eng@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/47/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Column (1) Purpose Title B. 1 Parliament of Malaysia B. 2 Keeper of Rulers’ Seal Office B. 3 National Audit Department B. 4 Election Commission B. 5 Public Services Commission B. 6 Prime Minister’s Department B. 7 Public Service Department B. 8 Attorney General’s Chambers B. 9 Malaysian Anti-Corruption Commission B. 10 Treasury B. 11 Treasury General Services B. 12 Contribution to Statutory Funds B. 13 Ministry of Foreign Affairs B. 14 Ministry of National Unity B. 15 Ministry of Economy B. 20 Ministry of Plantation and Commodities B. 21 Ministry of Agriculture and Food Security B. 22 Ministry of Rural and Regional Development B. 23 Ministry of Natural Resources, Environment and Climate Change B. 24 Ministry of International Trade and Industry B. 25 Ministry of Domestic Trade and Cost of Living B. 26 Ministry of Entrepreneur and Cooperatives Development Column (1) Purpose Title B. 27 Ministry of Works B. 28 Ministry of Transport B. 30 Ministry of Science, Technology and Innovation B. 31 Ministry of Tourism, Arts and Culture B. 40 Education Service Commission B. 42 Ministry of Health B. 43 Ministry of Local Government Development B. 45 Ministry of Youth and Sports B. 46 Ministry of Human Resources B. 47 Ministry of Communications and Digital B. 48 Ministry of Women, Family and Community Development B. 60 Ministry of Defence B. 62 Ministry of Home Affairs B. 63 Ministry of Education B. 64 Ministry of Higher Education TOTAL"
      }
    }
