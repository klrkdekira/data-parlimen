        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_34__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_34__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 92 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_34__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (11) the following subsection: “(11) An officer of a Labuan company who contravenes this section shall be liable to the company for any profits made by him and for any damage suffered by the company as a result of such contravention.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_34__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (12) the following penalty provision: “Penalty: Five hundred thousand ringgit or imprisonment for a term not exceeding five years or both.”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_34__para_c",
