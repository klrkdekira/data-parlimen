      "eli:number": "ii",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_56__para_b__subpara_ii__subpara_A",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_56__para_b__subpara_ii__subpara_B"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_56__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (c)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_56__para_b__subpara_ii__subpara_A",
      "@type": "akn:subparagraph",
      "eli:number": "A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_56__para_b__subpara_ii",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words “Part VIII and Part X” the words “Subdivision 3 of Division 7 of Part III and Division 1 and Division 2 of Part IV”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_56__para_b__subpara_ii__subpara_B",
      "@type": "akn:subparagraph",
      "eli:number": "B",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_56__para_b__subpara_ii",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for “Companies Act 1965” the words “Companies Act 2016”. Amendment of section 151d"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_57",
      "@type": "akn:clause",
      "eli:number": "57",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_57__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_57__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_57__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 151d of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_57__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_57",
      "schema:text": {
        "@language": "en",
        "@value": "by renumbering the existing section as subsection (1);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_57__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_57__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_57__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_57",
      "schema:text": {
        "@language": "en",
        "@value": "in the renumbered subsection (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_57__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_57__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the words “under section 151” the words “or section 151ba”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_57__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_57__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words “three years” wherever appearing the words “one year and six months”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_57__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_57",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (1) as renumbered the following subsection: “(2) Where a Labuan company has been dissolved pursuant to subsection (1), the Court may, at any time within six years after the date of dissolution, on an application of any person who appears to the Court to have locus standi and legitimate interest in the Labuan company, if the Court is satisfied that at the time of the dissolution of the Labuan company, the company has not discharged all of its debts and liabilities or that it is for the name of the Labuan company to be restored, make an order upon such terms declaring the dissolution to be void, and such proceedings may be taken as if the company has not been dissolved and the Court may by order give such directions and make such provision.”. Amendment of section 151e"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_58",
      "@type": "akn:clause",
      "eli:number": "58",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 151e of the principal Act is amended by substituting for subsection (1) the following subsection: “(1) The Authority may issue a letter of confirmation under its seal, upon a request by any Labuan trust company, approved liquidator, receiver and manager, other person having written permission of the officer of the company, member, debenture holder, director or liquidator of the Labuan trust company or any person who can demonstrate to the Authority that he has a good reason for doing so, provided that— (a) the name of the Labuan company is in the register; (b) the Labuan company has paid all fees and penalties due and payable; and (c) the prescribed fee has been paid.”. Amendment of section 152"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_59",
      "@type": "akn:clause",
      "eli:number": "59",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 152(1a) of the principal Act is amended by substituting for the words “Companies Act 1965” the words “Companies Act 2016”. Amendment of section 153"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 9 a(2) of the principal Act is amended by inserting after the words “A Labuan trust company” the words “or any other person approved by the Authority”. Amendment of section 10"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_60",
      "@type": "akn:clause",
      "eli:number": "60",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_60__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_60__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_60__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 153 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_60__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_60",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (1), by substituting for the words “Exchange Control Act 1953 [Act 17] and” the words “Financial Services Act 2013, Islamic Financial Services Act 2013 and”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_60__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_60",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (2), by substituting for the words “Exchange Control Act 1953 and” the words “Financial Services Act 2013, Islamic Financial Services Act 2013 and”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_60__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_60",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (3), by substituting for the words “Exchange Control Act 1953” wherever appearing the words “Financial Services Act 2013, Islamic Financial Services Act 2013”. Savings and transitional provisions"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_61",
      "@type": "akn:clause",
      "eli:number": "61",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_61__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_61__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_61__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_61__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_61",
      "schema:text": {
        "@language": "en",
        "@value": "If a Labuan company has appointed a resident director pursuant to paragraphs 87(2)(a), (b) and (c) of the principal Act, the Labuan company shall comply with subsection 87(2) of the principal Act, as amended by subsection 31(b) of this Act, within the period of six months from the date of coming into operation of this Act or any extended period approved by the Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_61__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_61",
      "schema:text": {
        "@language": "en",
        "@value": "All Labuan trust companies must comply with the requirements of subsection 93(2) of the principal Act within the period of six months from the date of coming into operation of this Act or any extended period approved by the Authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_61__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_61",
      "schema:text": {
        "@language": "en",
        "@value": "Any inquiry, trial or proceedings done, taken or commenced under the principal Act before the commencement of this Act shall be continued and concluded under and in accordance with the principal Act as if the principal Act had not been amended by this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 10 of the principal Act is amended by inserting after subsection (2) the following subsection: “(2a) If default is made in complying with this section, the person who is in default commits an offence under this Act. Penalty: One hundred thousand ringgit.”. Amendment of section 11"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 11 of the principal Act is amended by inserting after subsection (5) the following subsection: “(6) If default is made in complying with this section, the person who is in default commits an offence under this Act. Penalty: One hundred thousand ringgit.”. Amendment of section 12"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_9__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_9__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 12 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_9__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (1), by inserting after the words “Subject to such conditions” the words “and payment of the prescribed fee”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_9__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (4) the following subsection: “(4a) If default is made in complying with this section, the person who is in default commits an offence under this Act. Penalty: Fifty thousand ringgit or imprisonment for a term not exceeding three years or both.”. Amendment of section 13"
      }
    }
  ]
}
