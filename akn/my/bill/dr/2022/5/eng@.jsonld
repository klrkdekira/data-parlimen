      "schema:text": {
        "@language": "en",
        "@value": "Section 114 of the principal Act is amended by inserting after subsection (3) the following subsection: “(4) A Labuan company shall, within thirty days of any change in the auditor of the company, lodge with the Authority a notice and the notice shall be accompanied with the consent of the new auditor.”. Amendment of section 120"
      }
    },
