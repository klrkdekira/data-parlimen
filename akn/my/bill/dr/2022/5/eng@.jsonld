        "@value": "Section 86 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_30__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (1), by deleting the words “Penalty: Ten thousand ringgit. Default penalty.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_30__para_b",
      "@type": "akn:paragraph",
