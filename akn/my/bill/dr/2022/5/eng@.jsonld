      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words “shall be guilty of an offence against this Act” wherever appearing the words “commits an offence under this Act”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
