      "schema:text": {
        "@language": "en",
        "@value": "Section 113 of the principal Act is amended by inserting after subsection (2) the following subsection: “(3) Any director of a Labuan company who fails to take all reasonable steps to secure compliance by the company with the requirements of this section or a resident director who has by his own wilful act been the cause of any default by the company under this section, commits an offence under this Act.”. Amendment of section 114"
      }
    },
