        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_10__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Subsection 13(9) of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_10__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "in subparagraph (a)(i), by substituting for the word “six” the word “seven”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_10__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "in subparagraph (a)(iii), by substituting for the word “fifteen” the word “seven”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_10__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (b), by substituting for the words “fifteen years” the words “seven years and six months”. Amendment of section 22"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 22(3) of the principal Act is amended by substituting for the word “Ten” the word “Fifty”. Amendment of section 25"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 25(3) of the principal Act is amended by inserting after the words “Ten thousand ringgit” the words “and default penalty of five hundred ringgit”. Amendment of section 26"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 26 of the principal Act is amended by inserting after subsection (4) the following subsection: “(4a) If default is made in complying with this section, the Labuan company or every officer of the company which is in default commits an offence under this Act. Penalty: One hundred thousand ringgit.”. New section 46a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting after section 46 the following section: “Prohibition to issue bearer share or bearer share warrants 46a. (1) A Labuan company shall not— (a) issue a bearer share or bearer share warrants; (b) convert a share into a bearer share or bearer share warrants into share warrants; or (c) exchange a share for a bearer share. (2) Any purported issuance, conversion or exchange of such bearer share, bearer share warrants, share or share warrants under subsection (1) is void. (3) A provision in a Labuan company’s memorandum or articles which purports to enable the company to issue, convert or exchange any of the bearer share, bearer share warrants, share or share warrants is void. (4) This section shall apply to a foreign Labuan company. (5) If default is made in complying with this section, the Labuan company, foreign Labuan company and every officer of the company who is in default commits an offence under this Act.”. Amendment of section 53"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_15__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_15__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 53 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_15__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (9b) the following subsection: “(9 ba) If default is made in complying with subsection (9b), the director of the Labuan company who is in default commits an offence under this Act. Penalty: Fifty thousand ringgit or imprisonment for a term not exceeding three years or both.”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_15__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (10), by substituting for the words “Imprisonment for three years or ten thousand ringgit or both” the words “Three million ringgit or imprisonment for a term not exceeding five years or both.”. Amendment of section 54"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 54 of the principal Act is amended by inserting after subsection (3) the following penalty provision: “Penalty: Five hundred thousand ringgit.”. Amendment of section 55"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
