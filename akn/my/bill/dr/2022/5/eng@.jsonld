      "schema:text": {
        "@language": "en",
        "@value": "in the English language text, by substituting for the words “shall be guilty of an offence under this Act” wherever appearing the words “commits an offence under this Act”. Amendment of section 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/eng@/~cl_3",
      "@type": "akn:clause",
