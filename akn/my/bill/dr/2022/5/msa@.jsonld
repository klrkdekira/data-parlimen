      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (c)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/msa@/~part_IV__cl_56__para_b__subpara_ii__subpara_A",
