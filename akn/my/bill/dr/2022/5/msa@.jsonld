      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (4), dengan menggantikan perkataan “melakukan suatu kesalahan lanjut terhadap Akta ini” dengan perkataan “melakukan suatu kesalahan lanjut di bawah Akta ini”. Pindaan seksyen 142a"
      }
    },
    {
