      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “Akta Syarikat 1965” dengan perkataan “Akta Syarikat 2016”. Pindaan seksyen 151d"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/msa@/~part_IV__cl_57",
