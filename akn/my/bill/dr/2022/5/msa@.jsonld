      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 53 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/msa@/~part_IV__cl_15__para_a",
