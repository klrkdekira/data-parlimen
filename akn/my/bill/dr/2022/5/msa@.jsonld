        "@value": "RUU Syarikat Labuan (Pindaan) 2022"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
