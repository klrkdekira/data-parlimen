      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (10), dengan menggantikan perkataan “Penjara selama tiga tahun atau sepuluh ribu ringgit atau kedua-duanya” dengan perkataan “Tiga juta ringgit atau pemenjaraan selama tempoh tidak melebihi lima tahun atau kedua-duanya.”. Pindaan seksyen 54"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/msa@/~part_IV__cl_16",
      "@type": "akn:clause",
