      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “Bahagian VIII dan Bahagian X” dengan perkataan “Subpenggal 3 Penggal 7 Bahagian III dan Penggal 1 dan Penggal 2 Bahagian IV”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/5/msa@/~part_IV__cl_56__para_b__subpara_ii__subpara_B",
