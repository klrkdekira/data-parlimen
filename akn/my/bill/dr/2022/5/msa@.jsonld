      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 54 Akta ibu dipinda dengan memasukkan selepas subseksyen (3) peruntukan penalti seperti yang berikut: “Penalti: Lima ratus ribu ringgit.”. Pindaan seksyen 55"
      }
    },
