      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan 78(2)(c) Akta ibu dipinda dengan memasukkan sebelum perkataan “nilai nominal” perkataan “bagi suatu syarikat Labuan asing,”. Pindaan seksyen 80"
      }
