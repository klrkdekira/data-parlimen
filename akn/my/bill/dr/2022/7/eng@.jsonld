      "schema:name": {
        "@language": "en",
        "@value": "Labuan Islamic Financial Services and Securities (Amendment) Bill 2022"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/7/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/7/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/7/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/7/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/7/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/7/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Labuan Islamic Financial Services and Securities (Amendment) Act 2022."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/7/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/7/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act is deemed to have come into operation on 1 January 2019. Amendment of section 13"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/7/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/7/eng@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/7/eng@/~cl_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/7/eng@/~cl_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/7/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Labuan Islamic Financial Services and Securities Act 2010 [Act 705], which is referred to as the “principal Act” in this Act, is amended in section 13—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/7/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/7/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (1), by substituting for the words “(2)” the words “(3)”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/7/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/7/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting subsection (2); and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/7/eng@/~cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/7/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (10), by deleting the words “or (2)”. Amendment of section 76"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/7/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/7/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 76 of the principal Act is amended by substituting for the definition of “Labuan takaful business” the following definition: ‘ “Labuan takaful business” means takaful business which includes Labuan captive takaful business, Labuan retakaful business and such other takaful business approved by the Authority but does not include any takaful business that is regulated or prohibited under other written law in Malaysia;’. Amendment of section 90"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/7/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/7/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 90 of the principal Act is amended by substituting for subsection (3) the following subsection: “(3) A licensed Labuan takaful broker may handle the takaful or retakaful of domestic takaful business, transacted in the Malaysian currency provided that such activity does not include any activity that is regulated or prohibited under other written law in Malaysia.”."
      }
    }
  ]
}
