    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/7/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/7/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Perkhidmatan Kewangan dan Sekuriti Islam Labuan (Pindaan) 2022."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/7/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/7/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini disifatkan mula berkuat kuasa pada 1 Januari 2019. Pindaan seksyen 13"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/7/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/7/msa@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/7/msa@/~cl_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/7/msa@/~cl_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/7/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Perkhidmatan Kewangan dan Sekuriti Islam Labuan 2010 [Akta 705], yang disebut “Akta ibu” dalam Akta ini, dipinda dalam seksyen 13—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/7/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/7/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1), dengan menggantikan perkataan “(2)” dengan perkataan “(3)”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/7/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/7/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong subseksyen (2); dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/7/msa@/~cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/7/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (10), dengan memotong perkataan “atau (2)”. Pindaan seksyen 76"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/7/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/7/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 76 Akta ibu dipinda dengan menggantikan takrif “perniagaan takaful Labuan” dengan takrif yang berikut: ‘ “perniagaan takaful Labuan” ertinya perniagaan takaful termasuklah perniagaan takaful kaptif Labuan, perniagaan takaful semula Labuan dan perniagaan takaful lain yang diluluskan oleh Lembaga tetapi tidak termasuk apa-apa perniagaan takaful yang dikawal atau dilarang di bawah undang-undang bertulis lain di Malaysia;’. Pindaan seksyen 90"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/7/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/7/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 90 Akta ibu dipinda dengan menggantikan subseksyen (3) dengan subseksyen yang berikut: “(3) Seseorang broker takaful Labuan berlesen boleh mengendalikan takaful atau takaful semula perniagaan takaful domestik, yang diurusniagakan dalam mata wang Malaysia dengan syarat bahawa aktiviti itu tidak termasuk apa-apa aktiviti yang dikawal atau dilarang di bawah undang-undang bertulis lain di Malaysia.”."
      }
    }
  ]
}
