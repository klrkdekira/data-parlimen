      ],
      "schema:name": {
        "@language": "en",
        "@value": "Control of Padi and Rice (Amendment) Bill 2022"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Control of Padi and Rice (Amendment) Act 2022."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Amendment of heading of Part II"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Control of Padi and Rice Act 1994 [Act 522], which is referred to as the “principal Act” in this Act, is amended in the heading of Part II by inserting after the words “DIRECTOR GENERAL” the words “AND DEPUTY DIRECTOR GENERAL”. Amendment of section 3"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@/~cl_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@/~cl_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 3 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "in the shoulder note, by inserting after the words “Director General” the words “and Deputy Director General”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@/~cl_3__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@/~cl_3__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@/~cl_3__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@/~cl_3__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting the words “, by notification in the Gazette,”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@/~cl_3__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@/~cl_3__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the words “Director General” the words “and one or such numbers of public officers to be the Deputy Directors General”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@/~cl_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (2), by inserting after the words “Director General” the words “and the Deputy Director General”. New section 28a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@/~cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@/~cl_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@/~cl_4__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@/~cl_4__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@/~cl_4__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@/~cl_4__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@/~cl_4__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting after section 28 the following section: “Compounding of offences 28a. (1) The Minister may, with the approval of the Public Prosecutor, make regulations prescribing—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "any offence under this Act or any regulations made under this Act as an offence which may be compounded; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "the method and procedure for compounding such offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@/~cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General may, with the consent in writing of the Public Prosecutor, at any time before a charge is being instituted, compound any offence prescribed as an offence which may be compounded by making a written offer to the person reasonably suspected of having committed the offence to compound the offence upon payment to the Director General of a sum of money not exceeding fifty per centum of the amount of the maximum fine to which the person would have been liable to if he had been convicted of the offence, within such time as may be specified in the written offer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@/~cl_4__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "An offer under subsection (2) may be made at any time after the offence has been committed, but before any prosecution for it has been instituted."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@/~cl_4__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "If the amount specified in the offer is not paid within the time specified in the offer or such extended time as the Director General may grant, prosecution for the offence may be instituted at any time after that against the person to whom the offer was made."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@/~cl_4__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@/~cl_4__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@/~cl_4__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "Where an offence has been compounded under this section—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@/~cl_4__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@/~cl_4__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "no prosecution shall be instituted in respect of the offence against the person to whom the offer to compound was made; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@/~cl_4__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@/~cl_4__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "any document or thing seized in connection with the offence may be released by the Director General, subject to such terms as the Director General thinks fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@/~cl_4__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/8/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "All sums of moneys received by the Director General under this section shall be paid into and form part of the Federal Consolidated Fund.”."
      }
    }
  ]
}
