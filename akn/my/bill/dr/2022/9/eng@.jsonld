    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/9/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/9/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Constitution (Amendment) Act 2022."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/9/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/9/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act is deemed to have come into operation on 15 December 2021. New Article 119a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/9/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/9/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Federal Constitution is amended by inserting after Article 119 the following Article: “Non-application of Article 119 to Rulers, etc., by order 119a. Notwithstanding Article 119, the Yang di-Pertuan Agong may, with the consent of the Conference of Rulers, by order published in the Gazette, prescribe for an exemption to any Ruler and his Consort, any Yang di-Pertua Negeri and his Consort, and any heir apparent, heir presumptive and other heirs of a Ruler and their consorts, and any other persons, from the application of Article 119 and any laws relating to registration of electors.”."
      }
    }
  ]
