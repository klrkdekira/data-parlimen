    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/9/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/9/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Perlembagaan (Pindaan) 2022."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/9/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/9/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini disifatkan telah mula berkuat kuasa pada 15 Disember 2021. Perkara baharu 119a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/9/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2022/9/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Perlembagaan Persekutuan dipinda dengan memasukkan selepas Perkara 119 Perkara yang berikut: “Ketidakpakaian Perkara 119 kepada Raja-Raja, dsb., melalui perintah 119a. Walau apa pun Perkara 119, Yang di-Pertuan Agong boleh, dengan persetujuan Majlis Raja-Raja, melalui perintah yang disiarkan dalam Warta, menetapkan suatu pengecualian kepada mana-mana Raja dan Isterinya, mana-mana Yang di-Pertua Negeri dan Isterinya, dan mana-mana bakal raja, waris ganti dan waris lain Raja dan isteri mereka, dan mana-mana orang lain, daripada pemakaian Perkara 119 dan mana-mana undang-undang yang berhubungan dengan pendaftaran pemilih.”."
      }
    }
  ]
