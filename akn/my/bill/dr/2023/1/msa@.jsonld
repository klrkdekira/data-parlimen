      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (7), dengan menggantikan perkataan “lima ribu ringgit atau dipenjarakan selama tempoh tidak melebihi satu tahun” dengan perkataan “lima puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi lima tahun”. Pindaan seksyen 6"
      }
    },
