      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/1/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 17 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/1/msa@/~cl_17__para_a",
      "@type": "akn:paragraph",
