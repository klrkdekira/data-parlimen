      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/1/msa@/~cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/1/msa@/~cl_17__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/1/msa@/~cl_17__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “dan menahan” dengan perkataan “, menahan dan memeriksa”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/1/msa@/~cl_17__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/1/msa@/~cl_17__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “diterbitkan,” perkataan “diimport,” di mana-mana jua terdapat; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/1/msa@/~cl_17__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/1/msa@/~cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2), (3) dan (4), dengan memasukkan selepas perkataan “penerbitan,” perkataan “pengimportan,”. Pindaan seksyen 18"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/1/msa@/~cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
