        "@language": "ms",
        "@value": "Seksyen 5 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/1/msa@/~cl_5__para_a",
