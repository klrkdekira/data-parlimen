      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 18 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/1/msa@/~cl_18__para_a",
      "@type": "akn:paragraph",
