      ],
      "schema:name": {
        "@language": "ms",
        "@value": "RUU Pengangkutan Awam Darat (Pindaan) 2023"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/10/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/10/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/10/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/10/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/10/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/10/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Pengangkutan Awam Darat (Pindaan) 2023."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/10/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/10/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta dan Menteri boleh menetapkan tarikh yang berlainan bagi permulaan kuat kuasa peruntukan yang berlainan Akta ini. Pindaan seksyen 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/10/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/10/msa@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/10/msa@/~cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/10/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Pengangkutan Awam Darat 2010 [Akta 715], yang disebut “Akta ibu” dalam Akta ini, dipinda dalam seksyen 2—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/10/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/10/msa@/~cl_2__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/10/msa@/~cl_2__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/10/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam takrif “kenderaan barangan”—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/10/msa@/~cl_2__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/10/msa@/~cl_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (b), dengan menggantikan koma bernoktah di hujung perenggan itu dengan koma; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/10/msa@/~cl_2__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/10/msa@/~cl_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan (b) perkataan “dan termasuklah kenderaan p-hailing;”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/10/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/10/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif “kenderaan motor” takrif yang berikut: ‘ “kenderaan p-hailing” ertinya suatu kenderaan motor yang digunakan untuk membawa barangan dalam mana-mana perjalanan sebagai balasan bagi tambang muatan bagi setiap barangan itu, yang perkiraan, penempahan atau transaksi, dan tambang muatan bagi perjalanan itu dipermudah melalui suatu aplikasi elektronik mudah alih yang disediakan oleh suatu perniagaan pengantaraan;’. Pindaan seksyen 6"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/10/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/10/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan 6(5)(d) Akta ibu dipinda dengan menggantikan perkataan “pemegang lesen dan pengendali berlesen” dengan perkataan “pemegang lesen, pengendali berlesen dan orang awam”. Bahagian baharu Va"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/10/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/10/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memasukkan selepas Bahagian V Bahagian yang berikut: “BAHAGIAN VA PEREDARAN ANTARABANGSA PENGANGKUTAN AWAM DARAT Permit, lesen, dsb., di bawah perjanjian antarabangsa 144a. (1) Bagi maksud melaksanakan mana-mana perjanjian antarabangsa berhubung dengan memudahkan peredaran antarabangsa bagi mana-mana pengangkutan awam darat, Menteri boleh membuat apa-apa peraturan-peraturan yang suai manfaat atau perlu bagi melaksanakan peruntukan Bahagian ini. (2) Tanpa menjejaskan keluasan subseksyen (1), peraturan-peraturan boleh dibuat bagi maksud yang berikut: (a) mengiktiraf permit, lesen, pas, perakuan atau dokumen rasmi lain untuk mana-mana pengangkutan awam darat yang dibawa sementara ke Malaysia oleh orang yang bermastautin di luar negara dan bercadang untuk tinggal sementara sahaja di Malaysia, termasuklah memuatkan dan memunggahkan barangan atau penumpang dan transit; (b) mengawal selia permit, lesen, pas, perakuan atau dokumen rasmi lain untuk mana-mana pengangkutan awam darat yang dibawa sementara ke luar negara oleh orang yang bermastautin di Malaysia dan bercadang untuk tinggal sementara sahaja di luar negara, termasuklah memuatkan dan memunggahkan barangan atau penumpang dan transit; (c) mengawal selia penggunaan, operasi dan kehendak teknikal bagi pengangkutan awam darat yang disebut dalam subperenggan (a) dan (b), termasuklah— (i) takat, jam, kekerapan dan jalan atau kawasan yang akan digunakan atau yang hendak diberikan perkhidmatan; (ii) jenis dan bentuk dokumen yang perlu dibawa dan maklumat yang akan dipamerkan di setiap pengangkutan awam darat; dan (iii) akaun, dokumen dan rekod berkaitan dengan seksyen ini untuk disimpan dan dikemukakan apabila diminta bagi pemeriksaan dan penentusahan; dan (d) menetapkan fi atau caj yang kena dibayar berkaitan dengan seksyen ini dan cara pembayarannya.”. Pindaan seksyen 252"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/10/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/10/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 252(1) Akta ibu dipinda dengan memotong perenggan (k) dan (l). Peralihan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/10/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/10/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang mengendalikan atau mengadakan apa-apa perkhidmatan yang berhubungan dengan perniagaan pengantaraan berkenaan dengan perkhidmatan kenderaan barangan, sebelum tarikh permulaan kuat kuasa Akta ini, hendaklah membuat permohonan bagi suatu lesen mengikut seksyen 12a Akta ibu dalam masa satu tahun dari tarikh permulaan kuat kuasa Akta ini."
      }
    }
  ]
}
