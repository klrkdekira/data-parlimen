      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/13/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 4 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/13/msa@/~cl_3__para_a",
