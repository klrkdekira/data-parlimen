      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “14 atau 15” di mana-mana jua terdapat dengan perkataan “14, 15, 15a atau 15b”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/13/msa@/~cl_10__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/13/msa@/~cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (a) misalan, dengan menggantikan perkataan “pornografi kanak-kanak” dengan perkataan “bahan penganiayaan seksual kanak-kanak”. Pindaan seksyen 13"
      }
    },
    {
