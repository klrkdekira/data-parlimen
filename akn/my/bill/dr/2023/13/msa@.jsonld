      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 13 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/13/msa@/~cl_11__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
