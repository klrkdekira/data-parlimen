      "schema:name": {
        "@language": "ms",
        "@value": "Kanun Tatacara Jenayah [Akta 593] dipinda dalam Jadual"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Pertama—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/16/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/16/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan butiran yang berhubungan dengan seksyen 305 Kanun Keseksaan dengan butiran yang berikut: Penal Offence Whether Whether a Whether Code the police warrant or bailable compoundable may a summons or not ordinarily shall arrest ordinarily without issue in warrant the first or not instance “305 Abetment do. do. Not of bailable suicide or attempted suicide of child or person who lacks mental capacity"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/16/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/16/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam butiran yang berhubungan dengan seksyen 306 Kanun Keseksaan, dalam ruang 2, dengan memasukkan selepas perkataan “of suicide” perkataan “or attempted suicide”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/16/msa@/~cl_2__para_c",
      "@type": "akn:paragraph",
