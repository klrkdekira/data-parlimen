      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/16/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong butiran yang berhubungan dengan seksyen 309 Kanun Keseksaan dan butir-butir yang berhubungan dengannya."
      }
