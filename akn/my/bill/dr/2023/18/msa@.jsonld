    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/18/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/18/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Tenaga Boleh Baharu (Pindaan) 2023."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/18/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/18/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta. Pindaan seksyen 1"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/18/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/18/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Tenaga Boleh Baharu 2011 [Akta 725] dipinda dalam seksyen 1 dengan memasukkan selepas subseksyen (2) subseksyen yang berikut: “(3) Menteri boleh, melalui perintah yang disiarkan dalam Warta, menggantung kuat kuasa keseluruhan atau mana-mana peruntukan Akta ini di bahagian-bahagian yang berlainan di Malaysia.”."
      }
    }
  ]
