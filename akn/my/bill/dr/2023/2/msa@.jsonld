      "schema:name": {
        "@language": "ms",
        "@value": "RUU Perbekalan 2023"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/2/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/2/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Perbekalan 2023. Pengeluaran dan peruntukan untuk perkhidmatan bagi tahun 2023"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/2/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/2/msa@/~cl_2__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/2/msa@/~cl_2__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/2/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/2/msa@/~cl_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/2/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengeluaran sejumlah wang yang tidak melebihi sembilan puluh lapan bilion dua puluh lapan juta enam ratus tujuh puluh enam ribu enam ratus lima puluh ringgit (RM98,028,676,650) daripada Kumpulan Wang Disatukan untuk perkhidmatan bagi tahun 2023 adalah dengan ini dibenarkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/2/msa@/~cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/2/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Jumlah wang yang dibenarkan untuk dikeluarkan melalui Akta ini dan jumlah wang sebanyak satu ratus tujuh bilion tujuh ratus lapan belas juta enam ratus tujuh puluh enam ribu enam ratus lima puluh ringgit (RM107,718,676,650), iaitu amaun perbelanjaan yang dibenarkan oleh seksyen 2 Akta Kumpulan Wang Disatukan (Perbelanjaan Masuk Akaun) 2022 [Akta A1678], yang amaun agregatnya berjumlah dua ratus lima bilion tujuh ratus empat puluh tujuh juta tiga ratus lima puluh tiga ribu tiga ratus ringgit (RM205,747,353,300) adalah dengan ini diperuntukkan dan hendaklah disifatkan telah diperuntukkan dari tarikh Akta Kumpulan Wang Disatukan (Perbelanjaan Masuk Akaun) 2022 mula berkuat kuasa bagi maksud-maksud yang dinyatakan dalam Jadual."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/2/msa@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/2/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Maksud Tajuk B. 1 Parlimen Malaysia B. 2 Pejabat Penyimpan Mohor Besar Raja-Raja B. 3 Jabatan Audit Negara B. 4 Suruhanjaya Pilihan Raya B. 5 Suruhanjaya Perkhidmatan Awam B. 6 Jabatan Perdana Menteri B. 7 Jabatan Perkhidmatan Awam B. 8 Jabatan Peguam Negara B. 9 Suruhanjaya Pencegahan Rasuah Malaysia B. 10 Perbendaharaan B. 11 Perkhidmatan Am Perbendaharaan B. 12 Peruntukan kepada Kumpulan Wang Terkanun B. 13 Kementerian Luar Negeri B. 14 Kementerian Perpaduan Negara B. 15 Kementerian Ekonomi B. 20 Kementerian Perladangan dan Komoditi Maksud Tajuk B. 21 Kementerian Pertanian dan Keterjaminan Makanan B. 22 Kementerian Kemajuan Desa dan Wilayah B. 23 Kementerian Sumber Asli, Alam Sekitar dan Perubahan Iklim B. 24 Kementerian Perdagangan Antarabangsa dan Industri B. 25 Kementerian Perdagangan Dalam Negeri dan Kos Sara Hidup B. 26 Kementerian Pembangunan Usahawan dan Koperasi B. 27 Kementerian Kerja Raya B. 28 Kementerian Pengangkutan B. 30 Kementerian Sains, Teknologi dan Inovasi B. 31 Kementerian Pelancongan, Seni dan Budaya B. 40 Suruhanjaya Perkhidmatan Pendidikan B. 42 Kementerian Kesihatan B. 43 Kementerian Pembangunan Kerajaan Tempatan B. 45 Kementerian Belia dan Sukan B. 46 Kementerian Sumber Manusia B. 47 Kementerian Komunikasi dan Digital B. 48 Kementerian Pembangunan Wanita, Keluarga dan Masyarakat B. 60 Kementerian Pertahanan B. 62 Kementerian Dalam Negeri B. 63 Kementerian Pendidikan B. 64 Kementerian Pendidikan Tinggi JUMLAH"
      }
    }
  ]
}
