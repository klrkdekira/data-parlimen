      ],
      "schema:name": {
        "@language": "en",
        "@value": "Fees (Department of Broadcasting Malaysia) (Validation) Bill 2023"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/20/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/20/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Fees (Department of Broadcasting Malaysia) (Validation) Act 2023. Validation and indemnity"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/20/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/20/eng@/~cl_2__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/20/eng@/~cl_2__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/20/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/20/eng@/~cl_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/20/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding the provisions of the Fees Act 1951 [Act 209], the fees which were charged and collected by the Department of Broadcasting Malaysia in respect of any supply of television programme during the period from 15 March 2001 to 28 February 2022 shall be deemed to have been validly charged and collected."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/20/eng@/~cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/20/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "No action or legal proceedings shall be brought or instituted against the Government of Malaysia, any officer of the Government of Malaysia or any person acting under the directions of any officer of the Government of Malaysia in respect of any fees which were charged and collected during the period referred to in subsection (1), and if any such action or legal proceedings has been brought or instituted, it shall be discharged and made void, and no refund in respect of the fees charged and collected as specified in this Act shall be made."
      }
    }
  ]
}
