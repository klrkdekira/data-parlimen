      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (7)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_4__para_e__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_4__para_e",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words “Executive Chairman and the Deputy Executive Chairman” the word “Chairman”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_4__para_e__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
