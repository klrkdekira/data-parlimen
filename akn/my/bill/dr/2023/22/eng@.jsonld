      "schema:text": {
        "@language": "en",
        "@value": "in subsection (1), by substituting for the words “The Executive Chairman, or in his absence the Deputy Executive Chairman,” the words “The Chairman, or in the absence of the Chairman any director nominated by the Chairman to act on his behalf,”;"
      }
    },
