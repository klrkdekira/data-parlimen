    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_10__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_10__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_10__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 24 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_10__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (1) the following subsection: “(1) The Commission may, in writing, delegate any of its powers or functions under this Act, the Co-operative Societies Act 1993 or any other written law other than its power to make subsidiary legislation to— (a) the Chief Executive Officer; or (b) any committee established under section 10.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_10__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph 2(b), by substituting for the words “Executive Chairman, the Deputy Executive Chairman” the words “Chief Executive Officer”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_10__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (4), by substituting for the words “Executive Chairman” wherever appearing the words “Chief Executive Officer”. Amendment of section 45"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_11__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_11__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_11__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 45 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_11__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (1), by substituting for the words “Commission may” the words “Chief Executive Officer may”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_11__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (3), by substituting for the words “Executive Chairman” wherever appearing the words “Chief Executive Officer”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_11__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (4), by substituting for the words “Executive Chairman” wherever appearing the words “Chief Executive Officer”. Amendment of section 46"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraph 46(5)(b) of the principal Act is amended by substituting for the words “Executive Chairman” the words “Chief Executive Officer”. Amendment of section 56"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 56(1) of the principal Act is amended by substituting for the words “Executive Chairman” the words “Chief Executive Officer”. Amendment of section 60"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraph 60(2)(b) of the principal Act is amended by substituting for the words “Executive Chairman, the Deputy Executive Chairman” the words “Chairman, the Chief Executive Officer, the Deputy Chief Executive Officer”. Amendment of section 62a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 62a of the principal Act is amended by substituting for the words “Executive Chairman” the words “Chief Executive Officer”. Saving and transitional"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_16__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_16__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_16__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_16__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_16__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "Every reference to “Executive Chairman of the Malaysia Co-operative Societies Commission” in any other written law shall be construed as a reference to “Chief Executive Officer of the Malaysia Co-operative Societies Commission”."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The person holding the office of the Executive Chairman immediately before to the commencement of this Act shall continue to hold such office and shall be deemed to be appointed as the Chief Executive Officer under the principal Act as amended by this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_16__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The person holding the office of the Deputy Executive Chairman immediately before to the commencement of this Act shall continue to hold such office and shall be deemed to be appointed as the Deputy Chief Executive Officer under the principal Act as amended by this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_16__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "Any order, directive, guideline, circular, notice, decision, approval or determination issued or made by the Executive Chairman or Deputy Executive Chairman immediately before the commencement of this Act shall be deemed to be issued or made by the Chief Executive Officer under the principal Act as amended by this Act and shall remain valid."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Malaysia Co-operative Societies Commission (Amendment) Act 2023."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Amendment of section 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Malaysia Co-operative Societies Commission Act 2007 [Act 665], which is referred to as the “principal Act” in this Act, is amended in section 2—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the definition of “credit facility” the following definition: ‘ “Chief Executive Officer” means the Chief Executive Officer of the Commission appointed under section 11a;’;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the definition of “director” the following definition: ‘ “Chairman” means the Chairman of the Board appointed under paragraph 11(3)(a);’;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "in the definition of “appointed date”, by substituting for the full stop at the end of that definition a semicolon; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the definition of “appointed date” the following definition: ‘ “Deputy Chief Executive Officer” means the Deputy Chief Executive Officer appointed under section 11a;’. Amendment of section 6"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 6(3) of the principal Act is amended by deleting the word “Executive”. Amendment of section 11"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_4__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_4__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_4__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_4__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 11 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (1) the following subsection: “(1) The Commission shall have a board of directors which shall be responsible for the conduct of the business and affairs of the Commission and shall exercise all powers and do all acts which may be exercised or done by the Commission.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting subsection (2);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (3) the following subsection: “(3) The Board shall consist of the following directors: (a) a Chairman appointed by Yang di-Pertuan Agong, on the advice of Minister; (b) the Secretary General or a Deputy Secretary General of the Ministry charged with the responsibility for co-operative development as nominated by the Minister; (c) the Secretary General of Treasury or a Deputy Secretary General of Treasury or any representative of the Ministry of Finance; (d) a Secretary General or a Deputy Secretary General of a ministry as appointed by the Minister; (e) the Governor, or a Deputy Governor or an Assistant Governor of Bank Negara Malaysia as nominated by the Governor; (f) a Chief Executive Officer appointed by the Minister under section 11a; and (g) six persons appointed by the Minister, at least two of whom shall be persons of standing and experience in the co-operative movement.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_4__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting subsections (4), (5) and (6);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/22/eng@/~cl_4__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "hasPart": [
