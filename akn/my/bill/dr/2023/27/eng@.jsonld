      "schema:name": {
        "@language": "en",
        "@value": "Suruhanjaya Perkhidmatan Air Negara (Amendment) Bill 2023"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/27/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/27/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/27/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/27/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/27/eng@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/27/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by substituting for section 34 the following section: “Limitations on contracts 34. The Commission may enter into any contract under which the Commission is to pay or receive an amount— (a) not exceeding ten million ringgit; (b) exceeding ten million ringgit but not exceeding fifty million ringgit, with the approval of the Minister; or (c) exceeding fifty million ringgit, with the approval of the Minister and the concurrence of the Minister of Finance.”. Amendment of section 35"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/27/eng@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/27/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 35 of the principal Act is amended by deleting the words “and the approval of the Minister”. Amendment of section 41"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/27/eng@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/27/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 41(2) of the principal Act is amended in the English language text, by substituting for the words “shall be guilty of” the words “commits”."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/27/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/27/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Suruhanjaya Perkhidmatan Air Negara (Amendment) Act 2023."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/27/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/27/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette and the Minister may appoint different dates for the coming into operation of different provisions of this Act. Amendment of section 9"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/27/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/27/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Suruhanjaya Perkhidmatan Air Negara Act 2006 [Act 654], which is referred to as the “principal Act” in this Act, is amended in subsection 9(2) by substituting for the word “five” the word “three”. Amendment of section 14"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/27/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/27/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 14(3) of the principal Act is amended in the English language text, by substituting for the words “shall be guilty of” the word “commits”. Amendment of section 16"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/27/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/27/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 16(2) of the principal Act is amended by deleting paragraph (d). Amendment of section 17"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/27/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/27/eng@/~cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/27/eng@/~cl_5__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/27/eng@/~cl_5__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/27/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Subsection 17(1) of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/27/eng@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/27/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (b), by deleting the word “or” at the end of the paragraph;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/27/eng@/~cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/27/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (c), by substituting for the full stop at the end of the paragraph the words “; or”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/27/eng@/~cl_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/27/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after paragraph (c) the following paragraph: “(d) any employee of the Commission.”. New section 19a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/27/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/27/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting after section 19 the following section: “Restriction on the use of the symbol or representation of the Commission 19a. (1) The Commission shall have the exclusive right to the use of any symbol or representation as the Commission may select or create and thereafter display or exhibit such symbol or representation in connection with its activities or affairs. (2) The symbol or representation selected or created by the Commission shall be published in the Gazette. (3) Any person who uses a symbol or representation of the Commission without obtaining the written approval of the Commission, or uses any symbol or representation resembling the symbol or representation of the Commission, or creates any symbol or representation which refers to the Commission so as to deceive or cause confusion, or to be likely to deceive or to cause confusion, commits an offence and shall, on conviction, be liable to a fine not exceeding one hundred thousand ringgit or to imprisonment for a term not exceeding three years or to both.”. Amendment of section 23"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/27/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/27/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 23 of the principal Act is amended by deleting the words “, with the approval of the Minister,”. New section 23a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/27/eng@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/27/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting after section 23 the following section: “Discipline 23a. (1) The Commission shall have disciplinary authority over all its employees and shall exercise disciplinary control in respect of all such persons. (2) The Commission may make regulations with respect to the discipline of its employees.”. Amendment of section 31"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/27/eng@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/27/eng@/~cl_9__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/27/eng@/~cl_9__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/27/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 31 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/27/eng@/~cl_9__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/27/eng@/~cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting the words “after consulting the Minister;”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/27/eng@/~cl_9__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/27/eng@/~cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words “upon as far as practicable by cheques signed by any person as may be authorized” the words “in such manner as may be authorized”. Amendment of section 34"
      }
    }
  ]
}
