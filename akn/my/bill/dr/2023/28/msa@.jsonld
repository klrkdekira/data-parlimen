        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_II__cl_4__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_II__cl_4__subsec_1__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_II__cl_4__subsec_1__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_II__cl_4__subsec_1__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_II__cl_4__subsec_1__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_II__cl_4__subsec_1__para_k",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_II__cl_4__subsec_1__para_l"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya hendaklah mempunyai fungsi yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_II__cl_4__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menasihati Menteri tentang segala perkara yang berhubungan dengan kecekapan dan konservasi tenaga;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_II__cl_4__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengesyorkan kepada Kerajaan apa-apa dasar, undang-undang, tindakan dan langkah-langkah yang berhubungan dengan kecekapan dan konservasi tenaga;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_II__cl_4__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menggalakkan, membangunkan atau melaksanakan dasar dan inisiatif yang berhubungan dengan kecekapan dan konservasi tenaga;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_II__cl_4__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menjalankan fungsi pengawalseliaan di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_II__cl_4__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mencipta jenis ujian yang akan digunakan dan untuk mengesyorkan kepada Menteri kelayakan minimum dan pengalaman praktikal bagi apa-apa maksud menurut Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_II__cl_4__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menggalakkan pelaburan sektor swasta dalam kecekapan dan konservasi tenaga;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_II__cl_4__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menjalankan atau menyebabkan supaya dijalankan penyelidikan, kajian atau penilaian dalam kecekapan dan konservasi tenaga;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_II__cl_4__subsec_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengumpul, menganalisis dan menyiarkan maklumat, statistik dan faktor yang mempengaruhi atau relevan dengan pembangunan kecekapan dan konservasi tenaga;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_II__cl_4__subsec_1__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengiktiraf sebagaimana yang difikirkan patut oleh Suruhanjaya, latihan atau program lain yang berhubungan dengan pembangunan sumber manusia dan pembinaan keupayaan dalam sektor kecekapan dan konservasi tenaga;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_II__cl_4__subsec_1__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mendorong dan menggalakkan penyertaan awam dan untuk menambah baik kesedaran awam mengenai perkara-perkara yang berhubungan dengan kecekapan dan konservasi tenaga;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_II__cl_4__subsec_1__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan sasaran dan memastikan pematuhan sasaran itu bagi penambahbaikan dalam kecekapan dan konservasi tenaga; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_II__cl_4__subsec_1__para_l",
      "@type": "akn:paragraph",
      "eli:number": "l",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk melakukan apa-apa perkara lain sebagaimana yang difikirkan patut oleh Suruhanjaya untuk membolehkan Suruhanjaya melaksanakan fungsinya secara berkesan atau yang bersampingan dengan pelaksanaan fungsinya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_II__cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya hendaklah mempunyai kuasa untuk melakukan semua perkara yang suai manfaat atau secara munasabahnya perlu bagi atau bersampingan dengan pelaksanaan fungsinya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_II__cl_4__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_II__cl_4__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_II__cl_4__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan keluasan subseksyen (2), kuasa Suruhanjaya termasuklah kuasa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_II__cl_4__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_II__cl_4__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menjalankan segala aktiviti yang ternyata pada Suruhanjaya adalah perlu, berfaedah atau sesuai bagi atau yang berkaitan dengan pelaksanaan fungsinya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_II__cl_4__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_II__cl_4__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengenakan fi, kos atau caj bagi apa-apa perkhidmatan yang diberikan dalam menjalankan kuasanya dan pelaksanaan fungsinya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_II__cl_4__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Fungsi dan kuasa Suruhanjaya di bawah Akta ini adalah sebagai tambahan kepada, dan tidak mengurangkan, fungsi dan kuasa Suruhanjaya di bawah Akta Suruhanjaya Tenaga 2001."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_11",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_12",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_13",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_14",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_15",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_16"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "KEWAJIPAN ORANG YANG BERTANGGUNGJAWAB BAGI BANGUNAN Label intensiti tenaga"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_10__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_10__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_10__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_10__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang bertanggungjawab bagi bangunan yang bagi bangunan itu Akta ini terpakai hendaklah, dalam tempoh dan mengikut apa-apa cara sebagaimana yang ditetapkan, memohon kepada Suruhanjaya supaya dikeluarkan suatu label intensiti tenaga berkenaan dengan bangunan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang bertanggungjawab bagi bangunan yang tidak memohon label intensiti tenaga dalam tempoh sebagaimana yang ditetapkan di bawah subseksyen (1) hendaklah membayar fi lewat yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_10__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Permohonan bagi suatu label intensiti tenaga di bawah subseksyen (1) hendaklah disertakan dengan bayaran fi yang ditetapkan dan apa-apa maklumat, butir-butir atau dokumen sebagaimana yang ditentukan oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_10__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_10__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_10__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Selepas menimbangkan permohonan itu, Suruhanjaya boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_10__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_10__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "meluluskan permohonan itu dan mengeluarkan berkenaan dengan bangunan itu suatu label intensiti tenaga dalam apa-apa bentuk sebagaimana yang ditentukan oleh Suruhanjaya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_10__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_10__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "menolak permohonan itu, dengan menyatakan alasan bagi penolakan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_10__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Label intensiti tenaga yang dikeluarkan di bawah seksyen ini hendaklah sah selama suatu tempoh sebagaimana yang ditetapkan. Mempamerkan label intensiti tenaga"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_11__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang bertanggungjawab bagi bangunan yang bagi bangunan itu Akta ini terpakai hendaklah pada setiap masa mempamerkan di suatu bahagian yang mudah dilihat di bangunan itu label intensiti tenaga yang dikeluarkan di bawah seksyen 10 berkenaan dengan bangunan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang bertanggungjawab bagi bangunan yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima puluh ribu ringgit. Pengubahan, pemalsuan, dsb., label intensiti tenaga"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_12__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_12__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_12__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_12__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_12__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_12__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mengubah, memalsukan, mencacatkan, merosakkan atau memusnahkan apa-apa label intensiti tenaga;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_12__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_12__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menggunakan apa-apa label intensiti tenaga yang dalam pengetahuannya telah diubah, dipalsukan, dicacatkan, dirosakkan, dimusnahkan atau habis tempoh bagi apa-apa jua maksud; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_12__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_12__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mempamerkan apa-apa label intensiti tenaga yang dalam pengetahuannya telah diubah, dipalsukan, dicacatkan, dirosakkan atau habis tempoh."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi dua tahun atau kedua-duanya. Prestasi intensiti tenaga"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_13__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_13__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_13__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_13__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_13__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_13__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_13__subsec_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang bertanggungjawab bagi bangunan yang bagi bangunan itu Akta ini terpakai hendaklah memastikan bahawa prestasi intensiti tenaga bangunan itu mematuhi penarafan kecekapan tenaga sebagaimana yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam memastikan bahawa prestasi intensiti tenaga bangunan itu mematuhi penarafan kecekapan tenaga sebagaimana yang dikehendaki di bawah subseksyen (1), orang yang bertanggungjawab bagi bangunan itu hendaklah mematuhi apa-apa cara bagi maksud itu sebagaimana yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_13__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam menentukan sama ada prestasi intensiti tenaga bangunan itu mematuhi penarafan kecekapan tenaga, Suruhanjaya hendaklah menggunakan apa-apa maklumat atau keterangan yang tersedia pada Suruhanjaya dan mematuhi garis panduan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_13__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Suruhanjaya mendapati bahawa prestasi intensiti tenaga bangunan itu tidak mematuhi penarafan kecekapan tenaga, Suruhanjaya hendaklah mengeluarkan suatu notis bertulis ketidakpatuhan kepada orang yang bertanggungjawab bagi bangunan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_13__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila menerima notis bertulis ketidakpatuhan di bawah subseksyen (4), orang yang bertanggungjawab bagi bangunan itu hendaklah menyebabkan dijalankan suatu audit tenaga untuk menambah baik prestasi intensiti tenaga bangunan itu bagi mematuhi penarafan kecekapan tenaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_13__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Orang yang bertanggungjawab bagi bangunan itu hendaklah melantik seorang juruaudit tenaga berdaftar untuk menjalankan audit tenaga di bawah subseksyen (5)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_13__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Audit tenaga itu hendaklah dijalankan mengikut apa-apa cara sebagaimana yang ditentukan oleh juruaudit tenaga berdaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_13__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang bertanggungjawab bagi bangunan yang melanggar subseksyen (5) atau (6) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima puluh ribu ringgit. Laporan audit tenaga berkenaan dengan bangunan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_14__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_14__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_14__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_14__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_14__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_14__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Juruaudit tenaga berdaftar yang dilantik oleh orang yang bertanggungjawab bagi bangunan yang bagi bangunan itu Akta ini terpakai di bawah subseksyen 13(6) hendaklah menyediakan suatu laporan audit tenaga berdasarkan audit tenaga yang dijalankan di bawah subseksyen 13(7) mengikut garis panduan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Orang yang bertanggungjawab bagi bangunan yang berkenaan dengan bangunan itu laporan audit tenaga telah disediakan di bawah subseksyen (1) hendaklah mengemukakan laporan audit tenaga itu bersama-sama dengan pelan penambahbaikan kecekapan tenaga yang disediakan di bawah seksyen 15 kepada Suruhanjaya dalam masa satu tahun dari tarikh notis bertulis ketidakpatuhan dikeluarkan kepadanya di bawah subseksyen 13(4)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_14__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila menerima laporan audit tenaga daripada orang yang bertanggungjawab bagi bangunan di bawah subseksyen (2), Suruhanjaya boleh meminta orang yang bertanggungjawab bagi bangunan itu untuk memberikan apa-apa maklumat, butir-butir atau dokumen tambahan yang berhubungan dengan laporan audit tenaga sebagaimana yang difikirkan perlu oleh Suruhanjaya dan jika orang yang bertanggungjawab bagi bangunan itu tidak memberikan maklumat, butir-butir atau dokumen tambahan itu, laporan audit tenaga itu boleh ditolak oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_14__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_14__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_14__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila meneliti laporan audit tenaga dan jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_14__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_14__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya mendapati bahawa laporan audit tenaga itu tidak disediakan mengikut garis panduan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_14__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_14__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "pada pendapat Suruhanjaya, kandungan laporan audit tenaga itu tidak memadai, Suruhanjaya boleh mengarahkan orang yang bertanggungjawab bagi bangunan itu untuk membetulkan laporan audit tenaga itu dalam tempoh dan mengikut apa-apa cara sebagaimana yang ditentukan oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_14__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Suruhanjaya mengarahkan orang yang bertanggungjawab bagi bangunan itu untuk membetulkan laporan audit tenaga di bawah subseksyen (4) dan orang yang bertanggungjawab bagi bangunan itu tidak membetulkan laporan audit tenaga itu sebagaimana yang diarahkan oleh Suruhanjaya, Suruhanjaya hendaklah selanjutnya mengarahkan orang yang bertanggungjawab bagi bangunan itu untuk mengemukakan laporan audit tenaga yang baharu dalam tempoh sebagaimana yang ditentukan oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_14__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen (1) hendaklah terpakai berkenaan dengan penyediaan laporan audit tenaga yang baharu di bawah subseksyen (5)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_14__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang bertanggungjawab bagi bangunan yang tidak mengemukakan laporan audit tenaga di bawah subseksyen (2) atau (5) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima puluh ribu ringgit. Pelan penambahbaikan kecekapan tenaga"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_15__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_15__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_15__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_15__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_15__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_15__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_15__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_15__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_15__subsec_9"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_15__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang bertanggungjawab bagi bangunan yang berkenaan dengan bangunan itu suatu laporan audit tenaga dikehendaki untuk disediakan dan dikemukakan di bawah seksyen 14 hendaklah menyediakan suatu pelan penambahbaikan kecekapan tenaga berdasarkan laporan audit tenaga itu mengikut apa-apa cara sebagaimana yang ditentukan oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Orang yang bertanggungjawab bagi bangunan itu hendaklah mengemukakan pelan penambahbaikan kecekapan tenaga yang disediakan di bawah subseksyen (1) kepada Suruhanjaya bagi kelulusan Suruhanjaya bersama-sama dengan laporan audit tenaga di bawah subseksyen 14(2)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_15__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Selepas menimbangkan pelan penambahbaikan kecekapan tenaga itu, Suruhanjaya boleh meluluskan atau menolak pelan penambahbaikan kecekapan tenaga itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_15__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Suruhanjaya meluluskan pelan penambahbaikan kecekapan tenaga itu, orang yang bertanggungjawab bagi bangunan itu hendaklah melaksanakan pelan penambahbaikan kecekapan tenaga yang diluluskan itu berkenaan dengan bangunan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_15__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Suruhanjaya menolak pelan penambahbaikan kecekapan tenaga itu, Suruhanjaya hendaklah mengarahkan orang yang bertanggungjawab bagi bangunan itu menyemak pelan penambahbaikan kecekapan tenaga itu dalam tempoh dan mengikut apa-apa cara sebagaimana yang ditentukan oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_15__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika orang yang bertanggungjawab bagi bangunan itu tidak menyemak pelan penambahbaikan kecekapan tenaga itu sebagaimana yang diarahkan oleh Suruhanjaya di bawah subseksyen (5), Suruhanjaya hendaklah selanjutnya mengarahkan orang yang bertanggungjawab bagi bangunan itu untuk mengemukakan pelan penambahbaikan kecekapan tenaga yang baharu dalam tempoh sebagaimana yang ditentukan oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_15__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen (1) hendaklah terpakai berkenaan dengan penyediaan pelan penambahbaikan kecekapan tenaga yang baharu di bawah subseksyen (6)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_15__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang bertanggungjawab bagi bangunan yang tidak melaksanakan pelan penambahbaikan kecekapan tenaga yang diluluskan di bawah subseksyen (4) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima puluh ribu ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_15__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang bertanggungjawab bagi bangunan yang tidak mengemukakan pelan penambahbaikan kecekapan tenaga di bawah subseksyen (2) atau (6) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima puluh ribu ringgit. Ketidakpakaian seksyen 13, 14 dan 15"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 13, 14 dan 15 tidak terpakai berkenaan dengan bangunan yang orang yang bertanggungjawab bagi bangunan itu juga merupakan seorang pengguna tenaga yang baginya Akta ini terpakai."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX",
      "@type": "akn:part",
      "eli:number": "IX",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_41",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_42",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_43",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_44",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_45",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_46",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_47",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_48",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_49",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_50",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_51",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_52",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_53",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_54",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_55",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_56",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_57",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_58",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_59"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "PENGUATKUASAAN Pegawai diberi kuasa"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_41",
      "@type": "akn:clause",
      "eli:number": "41",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_41__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_41__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_41__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, secara bertulis, memberi kuasa kepada mana-mana pegawai Suruhanjaya untuk menjalankan kuasa penguatkuasaan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_41__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pegawai Suruhanjaya yang diberi kuasa di bawah subseksyen (1) hendaklah disifatkan sebagai pekhidmat awam mengikut pengertian Kanun Keseksaan [Akta 574]. Kad kuasa"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_42",
      "@type": "akn:clause",
      "eli:number": "42",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_42__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_42__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_42__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_42",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya hendaklah mengeluarkan kepada setiap pegawai diberi kuasa suatu kad kuasa yang hendaklah ditandatangani oleh Ketua Pegawai Eksekutif Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_42__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_42",
      "schema:text": {
        "@language": "ms",
        "@value": "Bilamana pegawai diberi kuasa menjalankan mana-mana kuasa penguatkuasaan di bawah Akta ini, dia hendaklah, apabila diminta, menunjukkan kepada orang yang terhadapnya kuasa itu sedang dijalankan kad kuasa yang dikeluarkan kepadanya di bawah subseksyen (1). Kuasa penyiasatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_43",
      "@type": "akn:clause",
      "eli:number": "43",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_43__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_43__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_43__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pegawai diberi kuasa hendaklah mempunyai segala kuasa yang perlu untuk menjalankan penyiasatan berhubung dengan pelakuan sesuatu kesalahan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_43__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam apa-apa hal yang berhubungan dengan pelakuan suatu kesalahan di bawah Akta ini, mana-mana pegawai diberi kuasa yang menjalankan sesuatu penyiasatan boleh menjalankan semua atau mana-mana kuasa yang berhubungan dengan penyiasatan polis, kecuali kuasa untuk menangkap tanpa waran, yang diberikan oleh Kanun Tatacara Jenayah [Akta 593]. Kuasa untuk memasuki premis dan memeriksa, dsb., dokumen, rekod, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_44",
      "@type": "akn:clause",
      "eli:number": "44",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_44__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_44__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_44__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_44__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_44__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pegawai diberi kuasa boleh, pada bila-bila masa yang munasabah, menjalankan kuasa yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_44__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_44",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memasuki mana-mana premis selain premis yang hanya digunakan untuk kediaman;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_44__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_44",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memeriksa atau menentusahkan apa-apa dokumen, rekod, data berkomputer, data berdigital, pelan, lukisan, bahan, loji, kelengkapan, jentera, barang, produk menggunakan tenaga, produk, label, item atau benda yang dijumpai di dalam premis itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_44__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_44",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengambil sampel apa-apa dokumen, rekod, data berkomputer, data berdigital, pelan, lukisan, bahan, loji, kelengkapan, jentera, barang, produk menggunakan tenaga, produk, label, item atau benda yang dijumpai di dalam premis itu bagi maksud menentukan, melalui pengujian atau selainnya, sama ada suatu kesalahan telah dilakukan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_44__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_44",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk membuat salinan atau mengambil cabutan apa-apa dokumen, rekod, data berkomputer, data berdigital, pelan, lukisan atau benda yang dijumpai di dalam premis itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_44__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_44",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menghendaki, tetapi hanya jika dan setakat yang semunasabahnya perlu untuk memastikan bahawa peruntukan Akta ini dan peruntukan mana-mana perintah atau arahan yang dibuat di bawah Akta ini dituruti dengan sewajarnya, mana-mana orang yang mempunyai kuasa untuk berbuat demikian supaya memecah buka apa-apa bekas atau membuka apa-apa mesin penjualan, dan jika orang itu tidak mematuhi kehendak itu, pegawai diberi kuasa itu sendiri boleh berbuat demikian. Penggeledahan dan penyitaan dengan waran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_45",
      "@type": "akn:clause",
      "eli:number": "45",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_45__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_45__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_45__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_45__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_45__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_45__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_45__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_45__subsec_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_45__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_45",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika ternyata pada seseorang Majistret, berdasarkan maklumat bertulis dengan bersumpah daripada pegawai diberi kuasa dan selepas apa-apa siasatan sebagaimana yang difikirkannya perlu, bahawa terdapat sebab yang munasabah untuk mempercayai bahawa suatu kesalahan di bawah Akta ini sedang atau telah dilakukan di dalam mana-mana premis, supaya apa-apa keterangan atau benda yang perlu untuk menjalankan suatu penyiasatan mengenai suatu kesalahan boleh didapati di dalam mana-mana premis, Majistret boleh mengeluarkan suatu waran yang memberi kuasa kepada mana-mana pegawai diberi kuasa yang dinamakan dalam waran itu untuk memasuki premis itu pada bila-bila masa, dengan atau tanpa bantuan, dan jika perlu dengan menggunakan kekerasan untuk menggeledah dan menyita apa-apa keterangan atau benda itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_45__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_45",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pegawai diberi kuasa yang memasuki mana-mana premis di bawah seksyen ini boleh membawa bersama-samanya mana-mana orang lain dan apa-apa kelengkapan yang ternyata pada pegawai diberi kuasa itu perlu dan apabila meninggalkan mana-mana premis yang telah dimasukinya menurut waran di bawah subseksyen yang terdahulu dia hendaklah, jika premis itu tidak dihuni atau penghuni tidak ada buat sementara waktu, meninggalkan premis itu dalam keadaan yang betul-betul selamat daripada penceroboh sebagaimana keadaan premis itu didapati olehnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_45__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_45",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan keluasan subseksyen (1), waran yang dikeluarkan oleh Majistret boleh memberikan kuasa penggeledahan dan penyitaan apa-apa dokumen, rekod, data berkomputer, data berdigital, pelan, lukisan, bahan, loji, kelengkapan, jentera, barang, produk menggunakan tenaga, produk, label, item atau benda yang mengandungi atau dengan semunasabahnya disyaki mengandungi maklumat tentang apa-apa kesalahan yang disyaki telah dilakukan atau selainnya perlu untuk menjalankan suatu penyiasatan bagi apa-apa kesalahan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_45__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_45",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pegawai diberi kuasa yang menjalankan penggeledahan di bawah subseksyen (1) boleh, bagi maksud menyiasat kesalahan itu, memeriksa mana-mana orang yang berada di dalam atau di premis itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_45__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_45",
      "schema:text": {
        "@language": "ms",
        "@value": "Pegawai diberi kuasa yang membuat pemeriksaan seseorang di bawah subseksyen (4) atau seksyen 46 boleh menyita, atau mengambil milikan, dan menyimpan dalam jagaan selamat semua benda selain pakaian yang perlu, yang dijumpai pada orang itu, dan apa-apa benda lain, yang baginya ada sebab untuk mempercayai merupakan peralatan atau keterangan lain bagi kesalahan itu, dan benda itu boleh ditahan sehingga suatu perintah dikeluarkan oleh mahkamah bagi pelupusannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_45__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_45",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh diperiksa kecuali oleh seseorang lain yang sama jantina, dan pemeriksaan sedemikian hendaklah dijalankan dengan penuh kesopanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_45__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_45",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika, oleh sebab jenis, saiz atau amaunnya, adalah tidak praktik untuk memindahkan apa-apa dokumen, rekod, data berkomputer, data berdigital, pelan, lukisan, bahan, loji, kelengkapan, jentera, barang, produk menggunakan tenaga, produk, label, item atau benda yang disita di bawah seksyen ini, pegawai diberi kuasa yang menyita itu hendaklah dengan apa-apa cara mengelak dokumen, rekod, data berkomputer, data berdigital, pelan, lukisan, bahan, loji, kelengkapan, jentera, barang, produk menggunakan tenaga, produk, label, item atau benda di dalam premis atau bekas yang di dalamnya ia dijumpai."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_45__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_45",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang, tanpa kuasa yang sah, memecahkan, mengganggu atau merosakkan lak yang disebut dalam subseksyen (7) atau memindahkan apa-apa dokumen, rekod, data berkomputer, data berdigital, pelan, lukisan, bahan, loji, kelengkapan, jentera, barang, produk menggunakan tenaga, produk, label, item atau benda yang dilak atau cuba untuk berbuat demikian melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi satu ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi dua tahun atau kedua-duanya. Penggeledahan dan penyitaan tanpa waran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_46",
      "@type": "akn:clause",
      "eli:number": "46",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seseorang pegawai diberi kuasa berpuas hati atas maklumat yang diterima bahawa dia mempunyai sebab yang munasabah untuk mempercayai bahawa oleh sebab kelengahan dalam memperoleh waran geledah di bawah seksyen 45 penyiasatan akan terjejas atau keterangan mengenai pelakuan sesuatu kesalahan mungkin diganggu, dipindahkan, dirosakkan atau dimusnahkan, pegawai diberi kuasa itu boleh memasuki premis itu dan menjalankan di dalam, pada dan berkenaan dengan premis itu semua kuasa yang disebut dalam seksyen 45 dengan cara yang sepenuhnya dan secukupnya seolah-olah dia diberi kuasa untuk berbuat demikian oleh suatu waran yang dikeluarkan di bawah seksyen itu. Akses kepada maklumat berekod atau data berkomputer, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_47",
      "@type": "akn:clause",
      "eli:number": "47",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_47__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_47__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_47__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_47__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_47__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_47__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pegawai diberi kuasa yang menjalankan kuasanya di bawah seksyen 44, 45 dan 46 hendaklah diberi akses kepada apa-apa maklumat berekod atau data berkomputer atau data berdigital, sama ada yang disimpan dalam suatu komputer atau selainnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_47__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_47__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_47__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Pada menjalankan kuasanya, pegawai diberi kuasa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_47__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_47__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "boleh memeriksa dan meneliti pengendalian apa-apa komputer dan apa-apa radas atau bahan yang berkaitan yang dia mempunyai sebab yang munasabah untuk mengesyaki sedang atau telah digunakan berkaitan dengan maklumat atau data itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_47__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_47__subsec_2__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_47__subsec_2__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_47__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "boleh menghendaki—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_47__subsec_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_47__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "orang yang, olehnya atau bagi pihaknya, pegawai diberi kuasa itu mempunyai sebab yang munasabah untuk mengesyaki komputer itu sedang atau telah digunakan berkaitan dengan maklumat atau data itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_47__subsec_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_47__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "orang yang bertanggungjawab bagi, atau yang selainnya terlibat dengan, pengendalian komputer, radas atau bahan itu berkaitan dengan maklumat atau data, untuk memberinya apa-apa bantuan yang munasabah sebagaimana yang dikehendaki olehnya bagi maksud seksyen ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_47__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Pegawai diberi kuasa boleh membuat salinan atau mengambil cabutan maklumat berekod atau data berkomputer atau data berdigital itu, jika difikirkannya perlu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_47__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini, “akses” termasuklah diberi kata laluan, kod penyulitan, kod penyahsulitan, perisian atau perkakasan yang perlu dan apa-apa cara lain yang dikehendaki untuk membolehkan pemahaman maklumat berekod atau data berkomputer atau data berdigital."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_47__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang tidak memberi akses kepada mana-mana pegawai diberi kuasa kepada apa-apa maklumat berekod atau data berkomputer atau data berdigital di bawah subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi satu ratus ribu ringgit. Pemberian maklumat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_48",
      "@type": "akn:clause",
      "eli:number": "48",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_48__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_48__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_48__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_48__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_48__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_48__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_48__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_48__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_48",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_48__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_48__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mengetahui atau mempunyai alasan yang munasabah untuk mengesyaki bahawa seseorang pegawai diberi kuasa sedang bertindak, atau bercadang untuk bertindak, berkaitan dengan suatu penyiasatan yang sedang, atau akan, dijalankan di bawah atau bagi maksud Akta ini dan menzahirkan kepada mana-mana orang lain maklumat atau apa-apa perkara lain yang mungkin akan menjejaskan penyiasatan itu atau penyiasatan yang dicadangkan itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_48__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_48__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mengetahui atau mempunyai alasan yang munasabah untuk mengesyaki bahawa suatu penzahiran telah dibuat kepada seseorang pegawai diberi kuasa dan menzahirkan kepada mana-mana orang lain maklumat atau apa-apa perkara lain yang mungkin akan menjejaskan apa-apa penyiasatan yang mungkin dijalankan berikutan dengan penzahiran itu, melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi satu ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi dua tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_48__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_48__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_48__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_48",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada apa-apa jua dalam subseksyen (1) menjadikannya suatu kesalahan bagi seseorang peguam bela dan peguam cara atau pekerjanya menzahirkan apa-apa maklumat atau perkara lain—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_48__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_48__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "kepada kliennya atau wakil kliennya berkaitan dengan pemberian nasihat kepada klien itu dalam penjalanan dan bagi maksud khidmat profesional peguam bela dan peguam cara itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_48__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_48__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "kepada mana-mana orang pada menjangkakan, atau berkaitan dengan dan bagi maksud, apa-apa prosiding undang-undang."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_48__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_48",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen (2) tidak terpakai berhubung dengan apa-apa maklumat atau perkara lain yang dizahirkan dengan tujuan untuk melaksanakan apa-apa maksud yang menyalahi undang-undang."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_48__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_48__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_48__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_48",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam mana-mana prosiding terhadap seseorang bagi suatu kesalahan di bawah seksyen ini, menjadi suatu pembelaan untuk membuktikan bahawa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_48__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_48__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dia tidak mengetahui atau mengesyaki bahawa penzahiran yang dibuat di bawah perenggan (1)(b) mungkin menjejaskan penyiasatan itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_48__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_48__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dia mempunyai kuasa yang sah atau alasan yang munasabah untuk membuat penzahiran itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_48__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_48",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pegawai diberi kuasa atau mana-mana orang lain tidak melakukan suatu kesalahan di bawah seksyen ini berkenaan dengan apa-apa jua perkara yang dilakukan olehnya dalam penjalanan tindakan yang berkaitan dengan penguatkuasaan, atau penguatkuasaan yang diniatkan, bagi Akta ini. Waran geledah boleh diterima walaupun cacat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_49",
      "@type": "akn:clause",
      "eli:number": "49",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu waran geledah yang dikeluarkan di bawah Akta ini adalah sah dan boleh dikuatkuasakan walau apa pun kecacatan, kesilapan atau peninggalan dalam waran geledah itu atau dalam permohonan bagi waran geledah itu dan apa-apa dokumen, rekod, data berkomputer, data berdigital, pelan, lukisan, bahan, loji, kelengkapan, jentera, barang, produk menggunakan tenaga, produk, label, item atau benda yang disita di bawah waran geledah itu boleh diterima sebagai keterangan dalam mana-mana prosiding di bawah Akta ini. Senarai dokumen, dsb., yang disita"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_50",
      "@type": "akn:clause",
      "eli:number": "50",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_50__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_50__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_50__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_50",
      "schema:text": {
        "@language": "ms",
        "@value": "Kecuali sebagaimana yang diperuntukkan dalam subseksyen (2), jika apa-apa dokumen, rekod, data berkomputer, data berdigital, pelan, lukisan, bahan, loji, kelengkapan, jentera, barang, produk menggunakan tenaga, produk, label, item atau benda disita di bawah Bahagian ini, pegawai diberi kuasa yang melakukan penyitaan itu hendaklah dengan secepat yang dapat dilaksanakan menyediakan senarai dokumen, rekod, data berkomputer, data berdigital, pelan, lukisan, bahan, loji, kelengkapan, jentera, barang, produk menggunakan tenaga, produk, label, item atau benda yang disita itu dan dengan segera menyerahkan salinan senarai itu yang ditandatangani olehnya kepada penghuni premis yang telah digeledah itu, atau kepada ejen atau pekhidmatnya, di premis itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_50__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_IX__cl_50",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika premis itu tidak berpenghuni, pegawai diberi kuasa yang melakukan penyitaan itu hendaklah di mana-mana mungkin menampalkan senarai benda yang disita itu di tempat yang mudah dilihat di premis itu. Pelucuthakan dokumen, dsb., yang disita"
      }
    },
