      "schema:text": {
        "@language": "ms",
        "@value": "mengamang, menghalang, menggalang atau melengahkan mana-mana pegawai diberi kuasa dalam membuat apa-apa kemasukan yang pegawai diberi kuasa itu berhak membuatnya di bawah Akta ini atau dalam melaksanakan apa-apa kewajipan yang dikenakan atau kuasa yang diberikan oleh Akta ini;"
      }
    },
    {
