      "schema:text": {
        "@language": "ms",
        "@value": "KEWAJIPAN PENGGUNA TENAGA Pelantikan pengurus tenaga berdaftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_5__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_5__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_5__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pengguna tenaga yang baginya Akta ini terpakai hendaklah melantik seorang pengurus tenaga berdaftar dalam tempoh dan mengikut apa-apa cara sebagaimana yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_5__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_5__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_5__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_5__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_5__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_5__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_5__subsec_2__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pengurus tenaga berdaftar yang dilantik oleh pengguna tenaga di bawah seksyen ini hendaklah menjalankan fungsi dan kewajipan seperti yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_5__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengumpul dan menganalisis data mengenai tenaga bagi dan penggunaan tenaga oleh, pengguna tenaga;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_5__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memastikan bahawa pengguna tenaga melaksanakan sistem pengurusan tenaga;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_5__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengawasi pelaksanaan sistem pengurusan tenaga oleh pengguna tenaga;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_5__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menyediakan laporan kecekapan dan konservasi tenaga bagi pengguna tenaga;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_5__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memastikan ketepatan maklumat yang diberikan dalam laporan kecekapan dan konservasi tenaga;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_5__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menasihati pengguna tenaga mengenai apa-apa langkah-langkah penjimatan tenaga lain yang boleh dilaksanakan oleh pengguna tenaga dan untuk mengawasi pelaksanaan apa-apa langkah-langkah itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_5__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menjalankan apa-apa kewajipan lain sebagaimana yang ditentukan oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_5__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pengguna tenaga yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima puluh ribu ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_5__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pengurus tenaga berdaftar yang melanggar subseksyen (2) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi dua puluh ribu ringgit. Sistem pengurusan tenaga"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_6__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_6__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam memastikan kecekapan tenaga dalam menjalankan aktiviti, perniagaan atau perdagangannya, seseorang pengguna tenaga yang baginya Akta ini terpakai hendaklah membangunkan suatu sistem pengurusan tenaga dalam tempoh sebagaimana yang ditetapkan dan melaksanakan sistem pengurusan tenaga itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengguna tenaga hendaklah membangunkan dan melaksanakan sistem pengurusan tenaga mengikut garis panduan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pengguna tenaga yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima puluh ribu ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_6__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pengguna tenaga yang melanggar subseksyen (2) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi dua puluh ribu ringgit. Laporan kecekapan dan konservasi tenaga"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_7__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_7__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_7__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_7__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_7__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_7__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_7__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_7__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengurus tenaga berdaftar yang dilantik oleh seseorang pengguna tenaga yang baginya Akta ini terpakai di bawah subseksyen 5(1) hendaklah menyediakan suatu laporan kecekapan dan konservasi tenaga bagi pengguna tenaga itu yang hendaklah mengandungi maklumat seperti yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_7__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_7__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "perihal sistem pengurusan tenaga yang dilaksanakan oleh pengguna tenaga itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_7__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_7__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "butir-butir mengenai jumlah keseluruhan dan tujuan penggunaan tenaga dan sumber tenaga oleh pengguna tenaga itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_7__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_7__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "langkah-langkah yang dicadangkan untuk menambah baik kecekapan dan konservasi tenaga oleh pengguna tenaga itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_7__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_7__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "butir-butir mengenai apa-apa langkah-langkah kecekapan dan konservasi tenaga lain yang telah dilaksanakan dan langkah-langkah yang masih belum dilaksanakan pada tarikh laporan kecekapan dan konservasi tenaga itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_7__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_7__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa maklumat lain yang dikehendaki oleh Suruhanjaya sebagaimana yang dinyatakan dalam garis panduan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengguna tenaga yang berkenaan dengannya laporan kecekapan dan konservasi tenaga telah disediakan di bawah subseksyen (1) hendaklah mengemukakan laporan kecekapan dan konservasi tenaga itu kepada Suruhanjaya dalam tempoh dan mengikut apa-apa cara sebagaimana yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_7__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pengurus tenaga berdaftar yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi dua puluh ribu ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_7__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pengguna tenaga yang melanggar subseksyen (2) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima puluh ribu ringgit. Audit tenaga"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_8__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_8__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_8__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pengguna tenaga yang baginya Akta ini terpakai hendaklah dari semasa ke semasa menyebabkan dijalankan suatu audit tenaga berkenaan dengan aktiviti, perniagaan atau perdagangannya untuk mematuhi kehendak yang berhubungan dengan pengemukaan laporan audit tenaga di bawah subseksyen 9(2)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengguna tenaga hendaklah melantik seorang juruaudit tenaga berdaftar untuk menjalankan audit tenaga di bawah subseksyen (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_8__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Audit tenaga itu hendaklah dijalankan mengikut apa-apa cara sebagaimana yang ditentukan oleh juruaudit tenaga berdaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_8__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pengguna tenaga yang melanggar subseksyen (2) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima puluh ribu ringgit. Laporan audit tenaga"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_9__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_9__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_9__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_9__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_9__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_9__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_9__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_9__subsec_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_9__subsec_10"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Juruaudit tenaga berdaftar yang dilantik oleh seseorang pengguna tenaga yang baginya Akta ini terpakai di bawah subseksyen 8(2) hendaklah menyediakan suatu laporan audit tenaga berdasarkan audit tenaga yang dijalankan di bawah subseksyen 8(1) mengikut garis panduan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_9__subsec_10",
      "@type": "akn:subsection",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pengguna tenaga yang tidak mengemukakan laporan audit tenaga di bawah subseksyen (2) atau (8) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima puluh ribu ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengguna tenaga yang berkenaan dengannya laporan audit tenaga telah disediakan di bawah subseksyen (1) hendaklah mengemukakan laporan audit tenaga itu kepada Suruhanjaya dalam tempoh dan mengikut apa-apa cara sebagaimana yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_9__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengguna tenaga boleh, selepas mengemukakan laporan audit tenaganya yang pertama dan dalam tempoh sebagaimana yang ditetapkan, memohon kepada Suruhanjaya supaya dikecualikan daripada mengemukakan laporan audit tenaga selanjutnya dalam tempoh sebagaimana yang ditetapkan di bawah subseksyen (2) jika pengguna tenaga berupaya untuk menunjukkan sehingga memuaskan hati Suruhanjaya bahawa selepas sebahagian besar tempoh masa dia telah melaksanakan langkah-langkah kecekapan dan konservasi tenaga yang penting dan pelaksanaan langkah-langkah itu telah menyebabkan penambahbaikan dalam kecekapan tenaga dalam menjalankan aktiviti, perniagaan atau perdagangannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_9__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila menerima permohonan di bawah subseksyen (3) dan apabila berpuas hati dengan permohonan bagi pengecualian itu, Suruhanjaya boleh meluluskan permohonan itu dan mengeluarkan suatu notis pengecualian bertulis kepada pengguna tenaga itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_9__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengecualian yang diberikan di bawah subseksyen (4) hendaklah berkuat kuasa mulai tarikh yang dinyatakan dalam notis pengecualian bertulis itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_9__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila menerima suatu laporan audit tenaga daripada pengguna tenaga di bawah subseksyen (2), Suruhanjaya boleh meminta pengguna tenaga itu untuk memberikan apa-apa maklumat, butir-butir atau dokumen tambahan yang berhubungan dengan laporan audit tenaga sebagaimana yang difikirkan perlu oleh Suruhanjaya dan jika pengguna tenaga tidak memberikan maklumat, butir-butir atau dokumen tambahan itu, laporan audit tenaga itu boleh ditolak oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_9__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_9__subsec_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_9__subsec_7__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila meneliti laporan audit tenaga dan jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_9__subsec_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_9__subsec_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya mendapati bahawa laporan audit tenaga itu tidak disediakan mengikut garis panduan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_9__subsec_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_9__subsec_7",
      "schema:text": {
        "@language": "ms",
        "@value": "pada pendapat Suruhanjaya, kandungan laporan audit tenaga itu tidak memadai, Suruhanjaya boleh mengarahkan pengguna tenaga itu untuk membetulkan laporan audit tenaga itu dalam tempoh dan mengikut apa-apa cara sebagaimana yang ditentukan oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_9__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Suruhanjaya mengarahkan pengguna tenaga untuk membetulkan laporan audit tenaga di bawah subseksyen (7) dan pengguna tenaga tidak membetulkan laporan audit tenaga itu sebagaimana yang diarahkan oleh Suruhanjaya, Suruhanjaya hendaklah selanjutnya mengarahkan pengguna tenaga itu untuk mengemukakan laporan audit tenaga yang baharu dalam tempoh sebagaimana yang ditentukan oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_9__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_III__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen (1) hendaklah terpakai berkenaan dengan penyediaan laporan audit tenaga yang baharu di bawah subseksyen (8)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_II__cl_4__subsec_1",
