    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_I__cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_I__cl_3__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_I__cl_3__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_I__cl_3__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_I__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini hendaklah terpakai bagi—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_I__cl_3__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_I__cl_3__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana pengguna tenaga yang penggunaan tenaganya bagi suatu tempoh dua belas bulan berturut-turut bersamaan dengan atau melebihi ambang penggunaan tenaga sebagaimana yang ditetapkan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_I__cl_3__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_I__cl_3__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa bangunan sebagaimana yang diperihalkan dalam Jadual Ketiga; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_I__cl_3__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_I__cl_3__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa produk menggunakan tenaga sebagaimana yang dinyatakan dalam garis panduan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_I__cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_I__cl_3__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_I__cl_3__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_I__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya hendaklah, berdasarkan apa-apa maklumat atau keterangan yang tersedia kepada Suruhanjaya dan mengikut garis panduan, menentukan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_I__cl_3__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_I__cl_3__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "sama ada seseorang itu merupakan pengguna tenaga yang baginya Akta ini terpakai di bawah perenggan (1)(a); dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_I__cl_3__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_I__cl_3__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "sama ada sesuatu bangunan itu merupakan bangunan yang bagi bangunan itu Akta ini terpakai di bawah perenggan (1)(b)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_I__cl_3__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_I__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya hendaklah, setelah menentukan bahawa seseorang itu merupakan pengguna tenaga yang baginya Akta ini terpakai, mengeluarkan suatu notis bertulis kepada orang itu yang memberitahu bahawa orang itu merupakan pengguna tenaga yang baginya Akta ini terpakai."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_I__cl_3__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_I__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya hendaklah, setelah menentukan bahawa sesuatu bangunan itu merupakan bangunan yang bagi bangunan itu Akta ini terpakai, mengeluarkan suatu notis bertulis kepada orang yang bertanggungjawab bagi bangunan itu yang memberitahu bahawa bangunan itu merupakan bangunan yang baginya Akta ini terpakai."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_I__cl_3__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_I__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud perenggan (1)(a), penggunaan tenaga hendaklah berkenaan dengan suatu aktiviti, perniagaan atau perdagangan pengguna tenaga yang dijalankan di satu tempat."
      }
    },
