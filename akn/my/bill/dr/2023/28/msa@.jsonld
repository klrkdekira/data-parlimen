    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_38__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_38__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_38__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_38",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun mana-mana undang-undang bertulis lain, jika Suruhanjaya mempunyai alasan yang munasabah untuk mempercayai bahawa mana-mana orang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_38__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_38__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mempunyai apa-apa maklumat, butir-butir atau dokumen yang berkaitan dengan pelaksanaan fungsi dan kuasa Suruhanjaya di bawah Akta ini; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_38__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_38__subsec_1__para_b__subpara_A",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_38__subsec_1__para_b__subpara_B",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_38__subsec_1__para_b__subpara_C",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_38__subsec_1__para_b__subpara_D",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_38__subsec_1__para_b__subpara_E",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_38__subsec_1__para_b__subpara_F"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_38__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "berupaya untuk memberikan apa-apa keterangan yang Suruhanjaya mempunyai alasan yang munasabah untuk mempercayai adalah berkaitan dengan pelaksanaan fungsi dan kuasa Suruhanjaya di bawah Akta ini, Suruhanjaya boleh, melalui notis bertulis, mengarahkan orang itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_38__subsec_1__para_b__subpara_A",
      "@type": "akn:subparagraph",
      "eli:number": "A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_38__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "supaya memberikan apa-apa maklumat atau butir-butir sedemikian kepada pegawai diberi kuasa mengikut cara dan bentuk dan dalam tempoh sebagaimana yang dinyatakan dalam notis itu atau apa-apa tempoh lanjutan sebagaimana yang diberikan oleh Suruhanjaya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_38__subsec_1__para_b__subpara_B",
      "@type": "akn:subparagraph",
      "eli:number": "B",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_38__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "supaya mengemukakan apa-apa dokumen sedemikian, sama ada dalam bentuk fizikal atau dalam perantara elektronik, kepada pegawai diberi kuasa mengikut cara dan dalam tempoh sebagaimana yang dinyatakan dalam notis itu atau apa-apa tempoh lanjutan sebagaimana yang diberikan oleh Suruhanjaya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_38__subsec_1__para_b__subpara_C",
      "@type": "akn:subparagraph",
      "eli:number": "C",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_38__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "supaya membuat salinan apa-apa dokumen sedemikian dan supaya mengemukakan salinan itu kepada pegawai diberi kuasa mengikut cara dan dalam tempoh sebagaimana yang dinyatakan dalam notis itu atau apa-apa tempoh lanjutan sebagaimana yang diberikan oleh Suruhanjaya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_38__subsec_1__para_b__subpara_D",
      "@type": "akn:subparagraph",
      "eli:number": "D",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_38__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "jika orang itu ialah seorang individu, supaya hadir di hadapan pegawai diberi kuasa pada masa dan di tempat yang dinyatakan dalam notis itu untuk memberikan apa-apa keterangan, sama ada secara lisan atau bertulis, dan mengemukakan apa-apa dokumen, sama ada dalam bentuk fizikal atau dalam perantara elektronik, mengikut cara dan dalam tempoh sebagaimana yang dinyatakan dalam notis itu atau apa-apa tempoh lanjutan sebagaimana yang diberikan oleh Suruhanjaya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_38__subsec_1__para_b__subpara_E",
      "@type": "akn:subparagraph",
      "eli:number": "E",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_38__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "jika orang itu ialah suatu pertubuhan perbadanan atau badan awam, supaya menyebabkan pegawai berwibawa pertubuhan perbadanan atau badan itu untuk hadir di hadapan pegawai diberi kuasa pada masa dan di tempat yang dinyatakan dalam notis itu untuk memberikan apa-apa keterangan, sama ada secara lisan atau bertulis, dan mengemukakan apa-apa dokumen, sama ada dalam bentuk fizikal atau dalam perantara elektronik, mengikut cara dan dalam tempoh sebagaimana yang dinyatakan dalam notis itu atau apa-apa tempoh lanjutan sebagaimana yang diberikan oleh Suruhanjaya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_38__subsec_1__para_b__subpara_F",
      "@type": "akn:subparagraph",
      "eli:number": "F",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_38__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "jika orang itu ialah suatu perkongsian, supaya menyebabkan seorang individu yang merupakan seorang rakan kongsi dalam perkongsian itu atau seorang pekerja dalam perkongsian itu untuk hadir di hadapan pegawai diberi kuasa pada masa dan di tempat yang dinyatakan dalam notis itu untuk memberikan apa-apa keterangan, sama ada secara lisan atau bertulis, dan mengemukakan apa-apa dokumen, sama ada dalam bentuk fizikal atau dalam perantara elektronik, mengikut cara dan dalam tempoh sebagaimana yang dinyatakan dalam notis itu atau apa-apa tempoh lanjutan sebagaimana yang diberikan oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_38__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_38__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_38__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_38",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Suruhanjaya mengarahkan mana-mana orang untuk mengemukakan apa-apa dokumen di bawah subseksyen (1) dan dokumen itu tiada dalam jagaan orang itu, orang itu hendaklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_38__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_38__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menyatakan, sepanjang pengetahuan dan kepercayaannya, di mana dokumen itu boleh dijumpai; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_38__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_38__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mengenal pasti, sepanjang pengetahuan dan kepercayaannya, orang yang terakhir mempunyai jagaan ke atas dokumen itu dan menyatakan, sepanjang pengetahuan dan kepercayaannya, di mana orang terakhir yang disebut itu boleh dijumpai."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_38__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_38",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang diarahkan untuk memberikan atau mengemukakan apa-apa maklumat, butir-butir atau dokumen atau salinan apa-apa dokumen di bawah subseksyen (1) hendaklah memastikan bahawa maklumat, butir-butir atau dokumen atau salinan dokumen yang diberikan atau dikemukakan itu adalah benar, tepat dan lengkap dan orang itu hendaklah memberikan representasi yang nyata yang bermaksud sedemikian, termasuk suatu perisytiharan bahawa dia tidak menyedari mengenai apa-apa maklumat, butir-butir atau dokumen lain yang akan menjadikan maklumat, butir-butir atau dokumen yang diberikan atau dikemukakan itu tidak benar atau mengelirukan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_38__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_38",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang tidak mematuhi arahan Suruhanjaya di bawah subseksyen (1) boleh, apabila disabitkan, didenda tidak melebihi satu ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi dua tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_38__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_38",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (2) atau (3) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi satu ratus ribu ringgit. Suruhanjaya boleh memegang simpan dokumen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_39__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_39__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_39__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_39__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_39__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_39__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya boleh mengambil dan memegang simpan selama apa-apa tempoh masa sebagaimana yang difikirkan perlu oleh Suruhanjaya, mana-mana dokumen yang diperoleh di bawah Bahagian ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_39__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "Orang yang memberikan dokumen itu berhak untuk dibekalkan, secepat yang dapat dilaksanakan, suatu salinan yang diperaku sah oleh Suruhanjaya sebagai suatu salinan benar dokumen itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_39__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun mana-mana undang-undang bertulis lain, salinan yang diperaku sah dokumen itu hendaklah diterima sebagai keterangan seolah-olah salinan itu ialah dokumen asal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_39__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "Sehingga suatu salinan yang diperaku sah dokumen itu dibekalkan, Suruhanjaya hendaklah, pada bila-bila masa dan di mana-mana tempat sebagaimana yang difikirkan sesuai oleh Suruhanjaya, membenarkan orang yang memberikan dokumen itu atau seseorang yang diberi kuasa oleh orang itu untuk memeriksa dan membuat salinan atau mengambil cabutan daripada dokumen asal itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_39__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Suruhanjaya berpuas hati bahawa dokumen itu tidak lagi perlu dipegang simpan, Suruhanjaya boleh mengembalikan dokumen itu kepada orang yang memberikan dokumen itu secepat yang dapat dilaksanakan. Akses kepada rekod"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_40__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_40__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_40__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_40",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang hendaklah, jika pada bila-bila masa diminta oleh Suruhanjaya melalui notis bertulis, membenarkan Suruhanjaya atau pegawai diberi kuasa atau mana-mana orang lain yang dinyatakan oleh Suruhanjaya dalam notis bertulis itu, untuk mendapat akses kepada rekodnya bagi maksud menjalankan fungsi dan kuasa Suruhanjaya di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_40__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VIII__cl_40",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang tidak mematuhi notis bertulis di bawah subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi dua puluh ribu ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_31__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_31__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_31__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_31__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_31__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_31",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada institusi latihan boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_31__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_31__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mengendalikan kursus latihan kepada mana-mana orang yang berhasrat untuk menjadi pengurus tenaga berdaftar; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_31__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_31__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menjalankan program pembangunan berterusan bagi pengurus tenaga berdaftar di bawah Akta ini, melainkan jika institusi latihan itu telah berdaftar di bawah Akta ini dan memegang suatu perakuan amalan yang sah yang dikeluarkan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_31__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_31",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana institusi latihan yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima puluh ribu ringgit. Kelayakan bagi pendaftaran institusi latihan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_32__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_32__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_32__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana institusi latihan boleh memohon untuk didaftarkan di bawah Akta ini jika institusi latihan itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_32__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_32",
      "schema:text": {
        "@language": "ms",
        "@value": "merupakan suatu syarikat, perkongsian liabiliti terhad, firma, pertubuhan atau kumpulan orang lain yang diperbadankan atau ditubuhkan di bawah mana-mana undang-undang bertulis;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_32__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_32",
      "schema:text": {
        "@language": "ms",
        "@value": "memenuhi kehendak prasyarat lain sebagaimana yang ditentukan oleh Suruhanjaya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_32__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_32",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak pernah disabitkan dengan suatu kesalahan yang melibatkan fraud, kecurangan atau rasuah. Permohonan bagi pendaftaran institusi latihan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_33__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_33__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_33__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_33__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_33",
      "schema:text": {
        "@language": "ms",
        "@value": "Permohonan bagi pendaftaran institusi latihan hendaklah dibuat kepada Suruhanjaya mengikut apa-apa cara sebagaimana yang ditentukan oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_33__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_33",
      "schema:text": {
        "@language": "ms",
        "@value": "Permohonan di bawah subseksyen (1) hendaklah disertakan dengan fi yang ditetapkan dan apa-apa maklumat, butir-butir atau dokumen sebagaimana yang ditentukan oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_33__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_33__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_33__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_33",
      "schema:text": {
        "@language": "ms",
        "@value": "Selepas menimbangkan permohonan itu, Suruhanjaya boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_33__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_33__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "meluluskan permohonan itu dan mengeluarkan kepada pemohon selepas dibayar fi yang ditetapkan suatu perakuan pendaftaran dalam apa-apa bentuk sebagaimana yang ditentukan oleh Suruhanjaya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_33__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_33__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "menolak permohonan itu, dengan menyatakan alasan bagi penolakan itu. Permohonan bagi perakuan amalan institusi latihan berdaftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_34",
      "@type": "akn:clause",
      "eli:number": "34",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_34__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_34__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_34__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_34__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_34__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_34",
      "schema:text": {
        "@language": "ms",
        "@value": "Permohonan bagi perakuan amalan oleh institusi latihan yang telah berdaftar di bawah seksyen 33 hendaklah dibuat kepada Suruhanjaya mengikut apa-apa cara sebagaimana yang ditentukan oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_34__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_34",
      "schema:text": {
        "@language": "ms",
        "@value": "Permohonan di bawah subseksyen (1) hendaklah disertakan dengan fi yang ditetapkan dan apa-apa maklumat, butir-butir atau dokumen sebagaimana yang ditentukan oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_34__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_34__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_34__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_34",
      "schema:text": {
        "@language": "ms",
        "@value": "Selepas menimbangkan permohonan itu, Suruhanjaya boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_34__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_34__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "meluluskan permohonan itu dan mengeluarkan kepada pemohon selepas dibayar fi yang ditetapkan suatu perakuan amalan dalam apa-apa bentuk sebagaimana yang ditentukan oleh Suruhanjaya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_34__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_34__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "menolak permohonan itu, dengan menyatakan alasan bagi penolakan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_34__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_34",
      "schema:text": {
        "@language": "ms",
        "@value": "Perakuan amalan yang dikeluarkan di bawah subseksyen (3) hendaklah sah bagi suatu tempoh sebagaimana yang dinyatakan dalam perakuan amalan itu. Pembaharuan perakuan amalan institusi latihan berdaftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_35",
      "@type": "akn:clause",
      "eli:number": "35",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_35__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_35__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_35__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_35__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_35__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "Institusi latihan berdaftar boleh memohon untuk membaharui perakuan amalannya yang dikeluarkan di bawah subseksyen 34(3) sebelum tarikh habis tempoh perakuan amalan itu dalam apa-apa tempoh dan mengikut apa-apa cara sebagaimana yang ditentukan oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_35__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "Institusi latihan berdaftar yang memohon bagi pembaharuan perakuan amalan selepas tarikh habis tempoh perakuan amalan itu hendaklah membayar fi lewat yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_35__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "Permohonan di bawah subseksyen (1) hendaklah disertakan dengan fi yang ditetapkan dan apa-apa maklumat, butir-butir atau dokumen sebagaimana yang ditentukan oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_35__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_35__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_35__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "Selepas menimbangkan permohonan itu, Suruhanjaya boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_35__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_35__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "meluluskan permohonan itu dan membaharui perakuan amalan selepas dibayar fi yang ditetapkan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_35__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_35__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "menolak permohonan itu, dengan menyatakan alasan bagi penolakan itu. Pembatalan perakuan pendaftaran institusi latihan berdaftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_36",
      "@type": "akn:clause",
      "eli:number": "36",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_36__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_36__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_36__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_36__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_36__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_36__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_36__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_36__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_36__subsec_1__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_36",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya boleh, melalui notis bertulis kepada institusi latihan berdaftar, membatalkan perakuan pendaftaran institusi latihan berdaftar itu yang dikeluarkan di bawah subseksyen 33(3) jika institusi latihan berdaftar itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_36__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_36__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah melanggar mana-mana peruntukan Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_36__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_36__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah terhenti untuk menjalankan perniagaan yang berkenaan dengannya ia didaftarkan di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_36__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_36__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah menyalahgunakan atau menyebabkan disalah guna perakuan pendaftaran itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_36__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_36__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah mengubah perakuan pendaftaran itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_36__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_36__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah memperoleh perakuan pendaftaran itu dengan membuat atau menyebabkan dibuat, atau dengan mengemukakan atau menyebabkan dikemukakan, suatu pengakuan, perakuan, permohonan, representasi atau maklumat palsu atau fraud, sama ada secara bertulis atau selainnya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_36__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_36__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah disabitkan dengan kesalahan yang melibatkan fraud, kecurangan atau rasuah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_36__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VII__cl_36",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila perakuan pendaftaran dibatalkan, kedua-dua perakuan pendaftaran dan perakuan amalan yang dikeluarkan di bawah subseksyen 33(3) dan 34(3) masing-masing, hendaklah menjadi tidak sah dari tarikh notis bertulis yang dikeluarkan oleh Suruhanjaya di bawah subseksyen (1) dan institusi latihan itu tidak dibenarkan untuk memfailkan apa-apa permohonan baharu untuk didaftarkan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_25__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_25__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_25__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_25__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun pengurus tenaga boleh menjalankan apa-apa fungsi atau kewajipan di bawah Akta ini melainkan jika dia telah berdaftar di bawah Akta ini dan memegang suatu perakuan amalan yang sah yang dikeluarkan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_25__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun juruaudit tenaga boleh menjalankan apa-apa audit tenaga di bawah Akta ini melainkan jika dia telah berdaftar di bawah Akta ini dan memegang suatu perakuan amalan yang sah yang dikeluarkan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_25__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1) atau (2) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi dua puluh ribu ringgit. Kelayakan bagi pendaftaran pengurus tenaga dan juruaudit tenaga"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_26__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_26__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_26__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_26__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pengurus tenaga atau juruaudit tenaga boleh memohon untuk didaftarkan di bawah Akta ini jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_26__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "dia warganegara Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_26__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "dia memegang apa-apa kelayakan sebagaimana yang ditetapkan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_26__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "dia memenuhi kehendak prasyarat lain sebagaimana yang ditentukan oleh Suruhanjaya, termasuk kehendak bagi latihan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_26__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "dia tidak pernah disabitkan atas suatu kesalahan yang melibatkan fraud, kecurangan atau rasuah. Permohonan bagi pendaftaran pengurus tenaga dan juruaudit tenaga"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_27__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_27__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_27__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_27__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "Permohonan bagi pendaftaran pengurus tenaga dan juruaudit tenaga hendaklah dibuat kepada Suruhanjaya mengikut apa-apa cara sebagaimana yang ditentukan oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_27__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "Permohonan di bawah subseksyen (1) hendaklah disertakan dengan fi yang ditetapkan dan apa-apa maklumat, butir-butir atau dokumen sebagaimana yang ditentukan oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_27__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_27__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_27__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "Selepas menimbangkan permohonan itu, Suruhanjaya boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_27__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_27__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "meluluskan permohonan itu dan mengeluarkan kepada pemohon selepas dibayar fi yang ditetapkan suatu perakuan pendaftaran dalam apa-apa bentuk sebagaimana yang ditentukan oleh Suruhanjaya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_27__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_27__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "menolak permohonan itu, dengan menyatakan alasan bagi penolakan itu. Permohonan bagi perakuan amalan pengurus tenaga berdaftar dan juruaudit tenaga berdaftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_28__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_28__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_28__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_28__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_28__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "Permohonan bagi suatu perakuan amalan oleh pengurus tenaga atau juruaudit tenaga yang telah berdaftar di bawah seksyen 27 hendaklah dibuat kepada Suruhanjaya mengikut apa-apa cara sebagaimana yang ditentukan oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_28__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "Permohonan di bawah subseksyen (1) hendaklah disertakan dengan fi yang ditetapkan dan apa-apa maklumat, butir-butir atau dokumen sebagaimana yang ditentukan oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_28__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_28__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_28__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "Selepas menimbangkan permohonan itu, Suruhanjaya boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_28__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_28__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "meluluskan permohonan itu dan mengeluarkan kepada pemohon selepas dibayar fi yang ditetapkan suatu perakuan amalan dalam apa-apa bentuk sebagaimana yang ditentukan oleh Suruhanjaya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_28__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_28__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "menolak permohonan itu, dengan menyatakan alasan bagi penolakan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_28__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "Perakuan amalan yang dikeluarkan di bawah subseksyen (3) hendaklah sah bagi suatu tempoh sebagaimana yang dinyatakan dalam perakuan amalan itu. Pembaharuan perakuan amalan pengurus tenaga berdaftar dan juruaudit tenaga berdaftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_29__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_29__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_29__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_29__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_29__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_29__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengurus tenaga berdaftar atau juruaudit tenaga berdaftar boleh memohon untuk membaharui perakuan amalannya yang dikeluarkan di bawah subseksyen 28(3) sebelum tarikh habis tempoh perakuan amalan itu dalam tempoh dan mengikut apa-apa cara sebagaimana yang ditentukan oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_29__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengurus tenaga berdaftar atau juruaudit tenaga berdaftar yang memohon bagi pembaharuan perakuan amalan selepas tarikh habis tempoh perakuan amalan itu hendaklah membayar fi lewat yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_29__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "Permohonan di bawah subseksyen (1) hendaklah disertakan dengan fi yang ditetapkan dan apa-apa maklumat, butir-butir atau dokumen sebagaimana yang ditentukan oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_29__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika permohonan bagi pembaharuan perakuan amalan dibuat oleh pengurus tenaga berdaftar, sebagai tambahan kepada fi yang ditetapkan dan maklumat, butir-butir atau dokumen sebagaimana yang ditentukan oleh Suruhanjaya di bawah subseksyen (3), permohonan itu hendaklah disertakan dengan apa-apa bukti bahawa pengurus tenaga berdaftar itu telah menghadiri program pembangunan berterusan yang mencukupi yang dijalankan oleh suatu institusi latihan berdaftar sebagaimana yang dikehendaki oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_29__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_29__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_29__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "Selepas menimbangkan permohonan itu, Suruhanjaya boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_29__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_29__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "meluluskan permohonan itu dan membaharui perakuan amalan itu selepas dibayar fi yang ditetapkan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_29__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_29__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "menolak permohonan itu, dengan menyatakan alasan bagi penolakan itu. Pembatalan perakuan pendaftaran pengurus tenaga berdaftar dan juruaudit tenaga berdaftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_30__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_30__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_30__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_30__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_30__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_30__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_30__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_30__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya boleh, melalui notis bertulis kepada pengurus tenaga berdaftar atau juruaudit tenaga berdaftar, mengikut mana-mana yang berkenaan, membatalkan perakuan pendaftaran pengurus tenaga berdaftar atau juruaudit tenaga berdaftar itu yang dikeluarkan di bawah subseksyen 27(3) jika pengurus tenaga berdaftar atau juruaudit tenaga berdaftar itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_30__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_30__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah melanggar mana-mana peruntukan Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_30__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_30__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah menyalahgunakan atau menyebabkan disalah guna perakuan pendaftaran itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_30__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_30__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah mengubah perakuan pendaftaran itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_30__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_30__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah memperoleh perakuan pendaftaran itu dengan membuat atau menyebabkan dibuat, atau dengan mengemukakan atau menyebabkan dikemukakan, suatu pengakuan, perakuan, permohonan, representasi atau maklumat palsu atau fraud, sama ada secara bertulis atau selainnya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_30__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_30__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah disabitkan dengan kesalahan yang melibatkan fraud, kecurangan atau rasuah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_30__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_VI__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila perakuan pendaftaran dibatalkan, kedua-dua perakuan pendaftaran dan perakuan amalan yang dikeluarkan di bawah subseksyen 27(3) dan 28(3) masing-masing, hendaklah menjadi tidak sah dari tarikh notis bertulis yang dikeluarkan oleh Suruhanjaya di bawah subseksyen (1) dan pengurus tenaga atau juruaudit tenaga itu tidak dibenarkan untuk memfailkan apa-apa permohonan baharu untuk didaftarkan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_17__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh menjual, menawarkan untuk menjual, mempamer, mengiklan atau memajak apa-apa produk menggunakan tenaga yang baginya Akta ini terpakai melainkan jika produk menggunakan tenaga itu ditampal dengan label penarafan kecekapan tenaga yang dikeluarkan di bawah subseksyen 21(5)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima puluh ribu ringgit. Mengedarkan produk menggunakan tenaga"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_18__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_18__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada pengilang atau pengimport boleh mengedarkan apa-apa produk menggunakan tenaga yang baginya Akta ini terpakai melainkan jika pengilang atau pengimport itu berdaftar dengan Suruhanjaya di bawah seksyen 19 dan suatu perakuan kecekapan tenaga telah dikeluarkan oleh Suruhanjaya berkenaan dengan produk menggunakan tenaga itu di bawah seksyen 21."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pengilang atau pengimport yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi dua tahun atau kedua-duanya. Pendaftaran pengilang atau pengimport"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_19__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_19__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_19__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_19__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_19__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Permohonan bagi pendaftaran oleh pengilang atau pengimport yang berhasrat untuk mengedarkan produk menggunakan tenaga yang baginya Akta ini terpakai hendaklah dibuat kepada Suruhanjaya mengikut apa-apa cara sebagaimana yang ditentukan oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_19__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Permohonan di bawah subseksyen (1) hendaklah disertakan dengan fi yang ditetapkan dan apa-apa maklumat, butir-butir atau dokumen sebagaimana yang ditentukan oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_19__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_19__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_19__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Selepas menimbangkan permohonan itu, Suruhanjaya boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_19__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_19__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "meluluskan permohonan itu dan mengeluarkan kepada pemohon suatu perakuan pendaftaran dalam apa-apa bentuk sebagaimana yang ditentukan oleh Suruhanjaya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_19__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_19__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "menolak permohonan itu, dengan menyatakan alasan bagi penolakan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_19__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Perakuan pendaftaran yang dikeluarkan di bawah subseksyen (3) hendaklah sah bagi suatu tempoh sebagaimana yang dinyatakan dalam perakuan pendaftaran. Pembatalan perakuan pendaftaran pengilang berdaftar dan pengimport berdaftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_20__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_20__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_20__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_20__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_20__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_20__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_20__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_20__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya boleh, melalui notis bertulis kepada pengilang berdaftar atau pengimport berdaftar, mengikut mana-mana yang berkenaan, membatalkan perakuan pendaftaran yang dikeluarkan di bawah subseksyen 19(3) jika pengilang berdaftar atau pengimport berdaftar itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_20__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_20__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah melanggar mana-mana peruntukan Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_20__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_20__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah terhenti daripada menjalankan perniagaan yang berkenaan dengannya ia didaftarkan di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_20__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_20__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah menyalahgunakan atau menyebabkan disalah guna perakuan pendaftaran itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_20__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_20__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah mengubah perakuan pendaftaran itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_20__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_20__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah memperoleh perakuan pendaftaran itu dengan membuat atau menyebabkan dibuat, atau dengan mengemukakan atau menyebabkan dikemukakan, suatu pengakuan, perakuan, permohonan, representasi atau maklumat palsu atau fraud, sama ada secara bertulis atau selainnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_20__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila perakuan pendaftaran dibatalkan, perakuan pendaftaran itu hendaklah menjadi tidak sah dari tarikh notis bertulis yang dikeluarkan oleh Suruhanjaya di bawah subseksyen (1) dan pengilang atau pengimport itu tidak dibenarkan untuk memfailkan apa-apa permohonan baharu untuk didaftarkan di bawah Akta ini. Permohonan bagi perakuan kecekapan tenaga"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_21__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_21__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_21__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_21__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_21__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_21__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_21__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Permohonan oleh pengilang atau pengimport yang berhasrat untuk mengedarkan produk menggunakan tenaga yang baginya Akta ini terpakai bagi suatu perakuan kecekapan tenaga berkenaan dengan produk menggunakan tenaga itu hendaklah dibuat kepada Suruhanjaya mengikut apa-apa cara sebagaimana yang ditentukan oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_21__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Permohonan di bawah subseksyen (1) hendaklah disertakan dengan fi yang ditetapkan dan apa-apa maklumat, butir-butir atau dokumen sebagaimana yang ditentukan oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_21__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_21__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_21__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Selepas menimbangkan permohonan itu, Suruhanjaya boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_21__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_21__subsec_3__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_21__subsec_3__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_21__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "meluluskan permohonan itu jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_21__subsec_3__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_21__subsec_3__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "produk menggunakan tenaga itu mematuhi metodologi pengujian produk menggunakan tenaga, pengiraan kecekapan tenaga dan penarafan kecekapan tenaga sebagaimana yang dinyatakan dalam garis panduan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_21__subsec_3__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_21__subsec_3__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "produk menggunakan tenaga itu memenuhi standard prestasi tenaga minimum sebagaimana yang ditetapkan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_21__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_21__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "menolak permohonan itu, dengan menyatakan alasan bagi penolakan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_21__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Suruhanjaya meluluskan permohonan itu, Suruhanjaya hendaklah, selepas dibayar fi yang ditetapkan, mengeluarkan suatu perakuan kecekapan tenaga berkenaan dengan produk menggunakan tenaga itu dalam apa-apa bentuk sebagaimana yang ditentukan oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_21__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila dikeluarkan perakuan kecekapan tenaga di bawah subseksyen (4), Suruhanjaya hendaklah juga mengeluarkan label penarafan kecekapan tenaga berkenaan dengan produk menggunakan tenaga itu dalam apa-apa bentuk sebagaimana yang ditentukan oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_21__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Perakuan kecekapan tenaga yang dikeluarkan di bawah subseksyen (4) hendaklah sah bagi tempoh satu tahun dari tarikh pengeluarannya. Pembaharuan perakuan kecekapan tenaga"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_22__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_22__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_22__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_22__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_22__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_22__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengilang berdaftar atau pengimport berdaftar boleh memohon untuk membaharui perakuan kecekapan tenaga yang dikeluarkan berkenaan dengan produk menggunakan tenaga di bawah seksyen 21 sebelum tarikh habis tempoh perakuan kecekapan tenaga itu dalam apa-apa tempoh dan mengikut apa-apa cara sebagaimana yang ditentukan oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_22__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "Permohonan di bawah subseksyen (1) hendaklah disertakan dengan fi yang ditetapkan dan apa-apa maklumat, butir-butir atau dokumen sebagaimana yang ditentukan oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_22__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_22__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_22__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "Selepas menimbangkan permohonan itu, Suruhanjaya boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_22__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_22__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "meluluskan permohonan itu dan membaharui perakuan kecekapan tenaga itu selepas dibayar fi yang ditetapkan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_22__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_22__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "menolak permohonan itu, dengan menyatakan alasan penolakan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_22__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pengilang berdaftar atau pengimport berdaftar yang berhasrat untuk memohon bagi pembaharuan perakuan kecekapan tenaga tetapi tidak memohon bagi pembaharuan itu sebelum tarikh habis tempoh perakuan kecekapan tenaga itu hendaklah mengemukakan suatu permohonan baharu bagi perakuan kecekapan tenaga itu di bawah seksyen 21."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_22__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada peruntukan Akta ini, tiadanya pembaharuan perakuan kecekapan tenaga atau penolakan oleh Suruhanjaya untuk membaharui perakuan kecekapan tenaga berkenaan dengan suatu produk menggunakan tenaga di bawah seksyen ini tidak menjejaskan kesahan label penarafan kecekapan tenaga yang telahpun dikeluarkan berkenaan dengan produk itu di bawah subseksyen 21(5). Pembatalan perakuan kecekapan tenaga"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_23__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_23__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_23__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_23__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_23__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_23__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_23__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_23__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya boleh, melalui notis bertulis kepada pengilang berdaftar atau pengimport berdaftar, mengikut mana-mana yang berkenaan, membatalkan perakuan kecekapan tenaga yang dikeluarkan berkenaan dengan produk menggunakan tenaga di bawah seksyen 21 dalam mana-mana hal keadaan yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_23__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_23__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "komponen produk menggunakan tenaga itu telah diubah, diganti atau ditukar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_23__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_23__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "selepas pemeriksaan oleh Suruhanjaya semasa pengawasan pasaran, Suruhanjaya mendapati bahawa produk menggunakan tenaga sebagaimana yang diletakkan dalam pasaran tidak lagi memenuhi standard prestasi tenaga minimum sebagaimana yang ditetapkan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_23__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_23__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pengilang berdaftar atau pengimport berdaftar telah menyalahgunakan atau menyebabkan disalah guna perakuan kecekapan tenaga itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_23__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_23__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pengilang berdaftar atau pengimport berdaftar telah memperoleh perakuan kecekapan tenaga itu berkenaan dengan produk menggunakan tenaga dengan membuat atau menyebabkan dibuat, atau dengan mengemukakan atau menyebabkan dikemukakan, suatu pengakuan, perakuan, permohonan, representasi atau maklumat palsu atau fraud, sama ada secara bertulis atau selainnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_23__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila perakuan kecekapan tenaga dibatalkan, perakuan kecekapan tenaga itu hendaklah menjadi tidak sah dari tarikh notis bertulis yang dikeluarkan oleh Suruhanjaya di bawah subseksyen (1) dan pengilang berdaftar atau pengimport berdaftar hendaklah memanggil balik dan menyebabkan dialihkan daripada pasaran produk menggunakan tenaga yang berkenaan dengannya perakuan kecekapan tenaga yang dibatalkan itu telah dikeluarkan dalam tempoh sebagaimana yang dinyatakan dalam notis bertulis."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_23__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pengilang berdaftar atau pengimport berdaftar yang melanggar subseksyen (2) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima puluh ribu ringgit. Kewajipan untuk menyimpan rekod dan dokumen oleh pengilang berdaftar dan pengimport berdaftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_24__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_24__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_24__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengilang berdaftar atau pengimport berdaftar hendaklah menyimpan dan memegang simpan dalam jagaan selamat selama tempoh tujuh tahun dari tarikh perakuan pendaftaran yang dikeluarkan kepadanya di bawah subseksyen 19(3) suatu salinan laporan pengujian prestasi tenaga atau surat penilaian yang dikeluarkan oleh badan penilaian pematuhan atau makmal yang diiktiraf oleh Suruhanjaya berhubung dengan produk menggunakan tenaga yang berkenaan dengannya perakuan kecekapan tenaga itu telah dikeluarkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_24__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_V__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pengilang berdaftar atau pengimport berdaftar yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima puluh ribu ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X",
      "@type": "akn:part",
      "eli:number": "X",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_60",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_61",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_62",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_63",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_64",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_65",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_66",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_67",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_68",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_69",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_70",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_71"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "AM Pemulaan pendakwaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_60",
      "@type": "akn:clause",
      "eli:number": "60",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada pendakwaan bagi suatu kesalahan di bawah Akta ini boleh dimulakan kecuali oleh atau dengan keizinan bertulis Pendakwa Raya. Pengkompaunan kesalahan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_61",
      "@type": "akn:clause",
      "eli:number": "61",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_61__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_61__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_61__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_61__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_61__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_61__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_61__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_61__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_61",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, dengan kelulusan Pendakwa Raya, membuat peraturan-peraturan yang menetapkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_61__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_61__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa kesalahan di bawah Akta ini sebagai suatu kesalahan yang boleh dikompaun; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_61__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_61__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "kaedah dan tatacara untuk mengkompaun kesalahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_61__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_61",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya boleh, dengan keizinan secara bertulis Pendakwa Raya, pada bila-bila masa sebelum suatu pendakwaan dimulakan, mengkompaun mana-mana kesalahan yang ditetapkan sebagai suatu kesalahan yang boleh dikompaun dengan membuat suatu tawaran bertulis kepada orang yang disyaki dengan munasabah telah melakukan kesalahan itu untuk mengkompaun kesalahan itu apabila dibayar kepada Suruhanjaya suatu jumlah wang yang tidak melebihi lima puluh peratus daripada amaun denda maksimum yang orang itu boleh dikenakan jika dia disabitkan atas kesalahan itu, dalam apa-apa masa sebagaimana yang dinyatakan dalam tawaran bertulis itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_61__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_61",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu tawaran bertulis di bawah subseksyen (2) boleh dibuat pada bila-bila masa selepas kesalahan itu dilakukan tetapi sebelum apa-apa pendakwaan baginya dimulakan, dan jika amaun yang dinyatakan dalam tawaran itu tidak dibayar dalam masa yang dinyatakan dalam tawaran itu, atau apa-apa tempoh lanjutan sebagaimana yang boleh diberikan oleh Suruhanjaya, pendakwaan bagi kesalahan itu boleh dimulakan pada bila-bila masa selepas itu terhadap orang yang kepadanya tawaran itu dibuat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_61__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_61",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu kesalahan telah dikompaun di bawah subseksyen (2), tiada pendakwaan boleh dimulakan berkenaan dengan kesalahan itu terhadap orang yang kepadanya tawaran untuk mengkompaun itu dibuat, dan Suruhanjaya boleh melucuthakkan atau memulangkan apa-apa dokumen, rekod, data berkomputer, data berdigital, pelan, lukisan, bahan, loji, kelengkapan, jentera, barang, produk menggunakan tenaga, produk, label, item atau benda yang disita berkaitan dengan kesalahan itu, tertakluk kepada apa-apa terma sebagaimana yang difikirkan patut oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_61__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_61",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua jumlah wang yang diterima oleh Suruhanjaya di bawah seksyen ini hendaklah dibayar ke dalam Kumpulan Wang Disatukan Persekutuan. Tanggungan pengarah, dsb., bagi syarikat, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_62",
      "@type": "akn:clause",
      "eli:number": "62",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_62__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_62__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana orang yang melakukan kesalahan di bawah Akta ini ialah suatu syarikat, perkongsian liabiliti terhad, firma, pertubuhan atau kumpulan orang yang lain, seseorang yang pada masa pelakuan kesalahan itu ialah seorang pengarah, pegawai pematuhan, pekongsi, pengurus, setiausaha atau pegawai lain yang seumpamanya bagi syarikat, perkongsian liabiliti terhad, firma, pertubuhan atau kumpulan orang yang lain itu atau yang berupa sebagai bertindak atas sifat itu atau yang dengan apa-apa cara atau sehingga apa-apa takat bertanggungjawab bagi pengurusan apa-apa hal ehwal syarikat, perkongsian liabiliti terhad, firma, pertubuhan atau kumpulan orang yang lain itu atau yang membantu dalam pengurusannya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_62__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_62",
      "schema:text": {
        "@language": "ms",
        "@value": "boleh dipertuduh secara berasingan atau bersesama dalam prosiding yang sama bersekali dengan syarikat, perkongsian liabiliti terhad, firma, pertubuhan atau kumpulan orang yang lain itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_62__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_62__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_62__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_62",
      "schema:text": {
        "@language": "ms",
        "@value": "jika syarikat, perkongsian liabiliti terhad, firma, pertubuhan atau kumpulan orang yang lain itu didapati bersalah atas kesalahan itu, hendaklah disifatkan bersalah atas kesalahan itu dan boleh dikenakan hukuman atau penalti yang sama sebagaimana seorang individu melainkan jika, dengan mengambil kira jenis fungsinya atas sifat itu dan segala hal keadaan, dia membuktikan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_62__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_62__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa kesalahan itu telah dilakukan tanpa pengetahuannya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_62__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_62__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa kesalahan itu telah dilakukan tanpa persetujuan atau pembiarannya dan bahawa dia telah mengambil segala langkah yang munasabah dan menjalankan usaha yang wajar untuk menghalang pelakuan kesalahan itu. Tanggungan seseorang bagi perbuatan, dsb., pekerja, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_63",
      "@type": "akn:clause",
      "eli:number": "63",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_63__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_63__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_63__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana orang boleh dikenakan apa-apa hukuman atau penalti di bawah Akta ini bagi apa-apa perbuatan, peninggalan, pengabaian atau keingkaran yang dilakukan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_63__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_63",
      "schema:text": {
        "@language": "ms",
        "@value": "oleh pekerja orang itu dalam penjalanan pekerjaannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_63__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_63",
      "schema:text": {
        "@language": "ms",
        "@value": "oleh ejen orang itu semasa bertindak bagi pihak orang itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_63__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_63",
      "schema:text": {
        "@language": "ms",
        "@value": "oleh pekerja ejen orang itu semasa bertindak dalam penjalanan pekerjaannya dengan ejen orang itu atau selainnya bagi pihak ejen orang itu yang bertindak bagi pihak orang itu, orang itu boleh dikenakan hukuman atau penalti yang sama bagi tiap-tiap perbuatan, peninggalan, pengabaian atau keingkaran oleh pekerja atau ejen orang itu, atau oleh pekerja ejen orang itu. Perlindungan terhadap tindakan guaman dan prosiding undang-undang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_64",
      "@type": "akn:clause",
      "eli:number": "64",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_64__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_64__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada tindakan, guaman, pendakwaan atau prosiding lain boleh dibawa, dimulakan atau dikekalkan dalam mana-mana mahkamah terhadap—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_64__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_64",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya, pegawai diberi kuasa atau mana-mana orang lain bagi atau atas sebab atau yang berkenaan dengan apa-apa perbuatan yang diperintahkan atau yang dilakukan bagi maksud melaksanakan Akta ini; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_64__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_64",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang lain bagi atau atas sebab atau yang berkenaan dengan apa-apa perbuatan yang dilakukan atau berupa sebagai dilakukan olehnya di bawah perintah, arahan atau suruhan Suruhanjaya atau pegawai diberi kuasa, jika perbuatan itu dilakukan dengan suci hati dan atas kepercayaan yang munasabah bahawa ia adalah perlu bagi maksud yang dihasratkan untuk dicapai dengannya. Daftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_65",
      "@type": "akn:clause",
      "eli:number": "65",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_65__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_65__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_65__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_65__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_65__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_65__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_65__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_65",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya hendaklah menyimpan dan menyenggara daftar-daftar yang berikut dalam apa-apa bentuk sebagaimana yang boleh ditentukan oleh Suruhanjaya:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_65__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_65__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "daftar pengurus tenaga berdaftar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_65__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_65__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "daftar juruaudit tenaga berdaftar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_65__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_65__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "daftar pengilang berdaftar dan pengimport berdaftar; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_65__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_65__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "daftar institusi latihan berdaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_65__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_65__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_65__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_65",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya hendaklah memotong daripada daftar nama dan butir-butir lain—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_65__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_65__subsec_2__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_65__subsec_2__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_65__subsec_2__para_a__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_65__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana pengurus tenaga berdaftar atau juruaudit tenaga berdaftar—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_65__subsec_2__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_65__subsec_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "yang telah meninggal dunia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_65__subsec_2__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_65__subsec_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "yang tidak sempurna akal atau selainnya tidak berupaya menunaikan kewajipannya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_65__subsec_2__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_65__subsec_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "yang perakuan pendaftarannya telah dibatalkan di bawah seksyen 30; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_65__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_65__subsec_2__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_65__subsec_2__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_65__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana pengilang berdaftar, pengimport berdaftar atau institusi latihan berdaftar—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_65__subsec_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_65__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "yang berada dalam penyelesaian atau telah digulung atau selainnya dibubarkan: atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_65__subsec_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_65__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "yang perakuan pendaftarannya telah dibatalkan di bawah seksyen 20 dan 36 masing-masing. Penyampaian notis"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_66",
      "@type": "akn:clause",
      "eli:number": "66",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_66__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_66__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_66__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_66__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_66__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_66__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_66__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_66",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap notis atau apa-apa dokumen lain yang dikehendaki untuk disampaikan kepada mana-mana orang di bawah Akta ini boleh disampaikan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_66__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_66__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "secara ke diri kepada orang itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_66__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_66__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menghantarnya kepada orang itu melalui pos berdaftar; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_66__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_66__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "melalui cara elektronik."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_66__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_66__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_66__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_66",
      "schema:text": {
        "@language": "ms",
        "@value": "Notis atau dokumen lain yang dihantar melalui pos berdaftar kepada seseorang hendaklah disifatkan telah disampaikan kepada orang itu pada masa ia sepatutnya telah dihantar serah kepada orang itu dalam penjalanan biasa pos itu jika notis atau dokumen lain itu telah dialamatkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_66__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_66__subsec_2__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_66__subsec_2__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_66__subsec_2__para_a__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_66__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal syarikat, perkongsian liabiliti terhad, firma, pertubuhan atau kumpulan orang lain—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_66__subsec_2__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_66__subsec_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "ke pejabat berdaftarnya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_66__subsec_2__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_66__subsec_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "ke alamat terakhirnya yang diketahui; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_66__subsec_2__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_66__subsec_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "kepada mana-mana orang yang diberi kuasa olehnya untuk menerima proses penyampaian; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_66__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_66__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal seorang individu, ke alamat terakhirnya yang diketahui."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_66__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_66",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seseorang telah memberikan persetujuannya untuk suatu notis atau dokumen disampaikan kepadanya melalui cara elektronik, notis itu hendaklah disifatkan telah disampaikan pada masa notis atau dokumen elektronik itu dihantar ke akaunnya melalui cara elektronik. Kuasa untuk mengeluarkan garis panduan dan arahan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_67",
      "@type": "akn:clause",
      "eli:number": "67",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_67__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_67__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_67__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_67__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_67",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya boleh mengeluarkan apa-apa garis panduan sebagaimana yang suai manfaat atau perlu bagi penjalanan yang lebih baik peruntukan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_67__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_67",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya boleh mengeluarkan apa-apa arahan sebagaimana yang didapati perlu oleh Suruhanjaya bagi maksud memastikan pematuhan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_67__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_67",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya boleh membatalkan, mengubah, menyemak semula atau meminda keseluruhan atau mana-mana bahagian mana-mana garis panduan atau arahan yang dikeluarkan di bawah seksyen ini. Kuasa untuk mengecualikan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_68",
      "@type": "akn:clause",
      "eli:number": "68",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, melalui perintah yang disiarkan dalam Warta, tertakluk kepada apa-apa syarat atau sekatan yang difikirkannya perlu atau suai manfaat dikenakan, mengecualikan apa-apa bangunan atau kelas bangunan, mana-mana pengilang atau pengimport atau kelas pengilang atau pengimport atau apa-apa produk menggunakan tenaga atau kelas produk menggunakan tenaga daripada mana-mana atau semua peruntukan Akta ini. Kuasa untuk membuat peraturan-peraturan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_69",
      "@type": "akn:clause",
      "eli:number": "69",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_69__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_69__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_69__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_69__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_69",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh membuat peraturan-peraturan yang suai manfaat atau perlu bagi memberikan kuat kuasa sepenuhnya atau melaksanakan peruntukan Akta ini dengan lebih baik."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_69__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_69__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_69__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_69__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_69__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_69__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_69__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_69__subsec_2__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_69__subsec_2__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_69__subsec_2__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_69__subsec_2__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_69__subsec_2__para_k",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_69__subsec_2__para_l",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_69__subsec_2__para_m"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_69",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan keluasan subseksyen (1), peraturan-peraturan boleh dibuat bagi maksud yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_69__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_69__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan ambang penggunaan tenaga bagi maksud menentukan pemakaian Akta ini bagi seseorang pengguna tenaga yang baginya Akta ini terpakai;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_69__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_69__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan tempoh dan cara bagi pelantikan pengurus tenaga berdaftar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_69__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_69__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan tempoh bagi pembangunan suatu sistem pengurusan tenaga oleh seseorang pengguna tenaga yang baginya Akta ini terpakai;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_69__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_69__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan tempoh dan cara bagi pengemukaan suatu laporan kecekapan dan konservasi tenaga oleh seseorang pengguna tenaga yang baginya Akta ini terpakai;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_69__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_69__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan tempoh dan cara bagi pengemukaan suatu laporan audit tenaga oleh seseorang pengguna tenaga yang baginya Akta ini terpakai;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_69__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_69__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan tempoh bagi suatu permohonan pengecualian daripada mengemukakan laporan audit tenaga selanjutnya oleh seseorang pengguna tenaga yang baginya Akta ini terpakai;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_69__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_69__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan tempoh dan cara permohonan bagi suatu label intensiti tenaga berkenaan dengan bangunan yang bagi bangunan itu Akta ini terpakai, termasuk tempoh sah label intensiti tenaga itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_69__subsec_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_69__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan penarafan kecekapan tenaga berhubung dengan prestasi intensiti tenaga yang hendaklah dipatuhi oleh bangunan yang bagi bangunan itu Akta ini terpakai, termasuk cara untuk mematuhi penarafan kecekapan tenaga itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_69__subsec_2__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_69__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan standard prestasi tenaga minimum yang hendaklah dipenuhi oleh produk menggunakan tenaga yang baginya Akta ini terpakai;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_69__subsec_2__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_69__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan kelayakan bagi pendaftaran pengurus tenaga dan juruaudit tenaga di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_69__subsec_2__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_69__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan kesalahan-kesalahan yang boleh dikompaun dan borang yang digunakan dan kaedah dan tatacara bagi mengkompaun kesalahan-kesalahan bagi maksud seksyen 61;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_69__subsec_2__para_l",
      "@type": "akn:paragraph",
      "eli:number": "l",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_69__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan fi yang kena dibayar di bawah Akta ini, termasuk fi lewat; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_69__subsec_2__para_m",
      "@type": "akn:paragraph",
      "eli:number": "m",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_69__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan apa-apa perkara lain yang dikehendaki untuk ditetapkan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_69__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_69",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa peraturan-peraturan yang dibuat di bawah Akta ini boleh menetapkan suatu perbuatan atau peninggalan yang melanggar peraturan-peraturan itu untuk menjadi suatu kesalahan dan boleh menetapkan penalti denda tidak melebihi dua puluh ribu ringgit bagi kesalahan itu. Kuasa untuk meminda Jadual"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_70",
      "@type": "akn:clause",
      "eli:number": "70",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, atas syor Suruhanjaya, melalui perintah yang disiarkan dalam Warta, meminda Jadual dalam Akta ini. Kecualian"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_71",
      "@type": "akn:clause",
      "eli:number": "71",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_71__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_71__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_71__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_71",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang memegang suatu perakuan pendaftaran yang sah sebagai pengurus tenaga elektrik yang dikeluarkan di bawah Akta Bekalan Elektrik 1990 [Akta 447] sebelum tarikh permulaan kuat kuasa Akta ini hendaklah, pada tarikh permulaan kuat kuasa Akta ini, disifatkan sebagai pengurus tenaga berdaftar di bawah Akta ini dan boleh menjalankan fungsi dan kewajipan pengurus tenaga berdaftar di bawah Akta ini sehingga tarikh habis tempoh perakuan pendaftaran itu, dengan syarat bahawa orang itu telah membuat permohonan untuk didaftarkan sebagai seseorang pengurus tenaga di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_71__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/28/msa@/~part_X__cl_71",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa produk menggunakan tenaga yang berkenaan dengannya suatu perakuan kelulusan yang sah telah dikeluarkan di bawah Akta Bekalan Elektrik 1990 sebelum tarikh permulaan kuat kuasa Akta ini hendaklah, pada tarikh permulaan kuat kuasa Akta ini, disifatkan telah dikeluarkan berkenaan dengannya suatu perakuan kecekapan tenaga di bawah Akta ini sehingga tarikh habis tempoh perakuan kelulusan itu, dengan syarat bahawa permohonan bagi suatu perakuan kecekapan tenaga berkenaan dengan produk menggunakan tenaga telah dibuat di bawah Akta ini."
      }
    },
