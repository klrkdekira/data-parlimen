      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (d), by deleting the words “or of any offence which in the opinion of the Director General renders him unfit to be an officer of a trade union”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/30/eng@/~cl_12__para_d",
      "@type": "akn:paragraph",
