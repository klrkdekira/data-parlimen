      "schema:text": {
        "@language": "en",
        "@value": "Subsection 56(5) of the principal Act is amended by substituting for the words “one thousand ringgit, or to imprisonment for a term not exceeding six months, or to both” the words “five thousand ringgit”. Amendment of section 57"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/30/eng@/~cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
