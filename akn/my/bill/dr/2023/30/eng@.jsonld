      "schema:text": {
        "@language": "en",
        "@value": "Subsection 57(4) of the principal Act is amended by substituting for the words “one thousand ringgit, or to imprisonment for a term not exceeding six months, or to both” the words “five thousand ringgit”. Amendment of section 61"
      }
    },
