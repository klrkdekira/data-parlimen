      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words “has acted or is acting in contravention of any provision of this Act or any other written law or any condition imposed by him, he may” the words “has been convicted of any of the offences specified in the Fourth Schedule, the Director General may”. New Fourth Schedule"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/30/eng@/~cl_35",
      "@type": "akn:clause",
      "eli:number": "35",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/30/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting after the Third Schedule the following schedule: “FOURTH SCHEDULE [Paragraph 15(1)(d), subsection 15(1a) and section 76c] Offences under Chapters VI, VIa and VIb of the Penal Code [Act 574]”. Saving"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/30/eng@/~cl_36",
      "@type": "akn:clause",
      "eli:number": "36",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/30/eng@/~cl_36__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/30/eng@/~cl_36__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/30/eng@/~cl_36__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/30/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/30/eng@/~cl_36__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/30/eng@/~cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "Any application made under the principal Act immediately before the date of coming into operation of this Act and pending under the principal Act shall, on the date of coming into operation of this Act, continue to be dealt with under the principal Act as if the principal Act had not been amended by this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/30/eng@/~cl_36__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/30/eng@/~cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "Any opinion, order, declaration, refusal, cancellation, withdrawal, direction or decision, made, issued, given or effected under the principal Act immediately before the date of coming into operation of this Act shall, on the date of coming into operation of this Act, continue to remain in force and effect until amended, repealed, rescinded, revoked or replaced."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/30/eng@/~cl_36__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/30/eng@/~cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "Any action, appeal or proceedings commenced under the principal Act immediately before the date of coming into operation of this Act and pending under the principal Act shall, on the date of coming into operation of this Act, be continued as if the principal Act had not been amended by this Act."
      }
    },
    {
