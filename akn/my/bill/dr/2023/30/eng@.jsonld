      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (2)(a), by inserting after the words “if the consent of the members” the words “or delegates”. Amendment of section 76c"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/30/eng@/~cl_34",
