      "schema:text": {
        "@language": "en",
        "@value": "by deleting the words “the Director General is satisfied that”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/30/eng@/~cl_34__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
