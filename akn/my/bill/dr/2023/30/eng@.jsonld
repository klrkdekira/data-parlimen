      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (1) the following subsection: “(1) A registered trade union or registered federation of trade unions may, subject to subsection (2) and the rules of such trade union or federation of trade unions, employ any person as an employee of the registered trade union or of the registered federation of trade unions.”; and"
      }
    },
