      ],
      "schema:name": {
        "@language": "ms",
        "@value": "RUU Lembaga Hasil Dalam Negeri Malaysia (Pindaan) 2023"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/32/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/32/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/32/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/32/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/32/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/32/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Lembaga Hasil Dalam Negeri Malaysia (Pindaan) 2023."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/32/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/32/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta. Pindaan seksyen 6"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/32/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/32/msa@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/32/msa@/~cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/32/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Lembaga Hasil Dalam Negeri Malaysia 1995 [Akta 533], yang disebut “Akta ibu” dalam Akta ini, dipinda dalam seksyen 6—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/32/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/32/msa@/~cl_2__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/32/msa@/~cl_2__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/32/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/32/msa@/~cl_2__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/32/msa@/~cl_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (d), dengan memotong perkataan “dan” di hujung perenggan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/32/msa@/~cl_2__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/32/msa@/~cl_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan (d) perenggan yang berikut: “(da) seseorang yang mewakili Negeri Sabah yang hendaklah dilantik oleh Menteri selepas berunding dengan Ketua Menteri Sabah; (db) seseorang yang mewakili Negeri Sarawak yang hendaklah dilantik oleh Menteri selepas berunding dengan Premier Sarawak; dan”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/32/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/32/msa@/~cl_2__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/32/msa@/~cl_2__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/32/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/32/msa@/~cl_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/32/msa@/~cl_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “perenggan (1)(e)” dengan perkataan “perenggan (1)(da), (db) dan (e)”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/32/msa@/~cl_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/32/msa@/~cl_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam teks bahasa kebangsaan, dengan menggantikan perkataan “berkedudukan atau berpengalaman” dengan perkataan “berkedudukan dan berpengalaman”. Pindaan seksyen 7"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/32/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/32/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 7 Akta ibu dipinda dengan menggantikan perkataan “perenggan 6(1)(d)” dengan perkataan “perenggan 6(1)(d), (da), (db)”. Pindaan seksyen 9"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/32/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/32/msa@/~cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/32/msa@/~cl_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/32/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 9 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/32/msa@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/32/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (1) dengan subseksyen yang berikut: “(1) Menteri boleh, pada bila-bila masa, tanpa memberikan apa-apa sebab baginya, membatalkan pelantikan— (a) mana-mana anggota yang dilantik di bawah perenggan 6(1)(d) atau (e); (b) seseorang anggota yang dilantik di bawah perenggan 6(1)(da) selepas berunding dengan Ketua Menteri Sabah; atau (c) seseorang anggota yang dilantik di bawah perenggan 6(1)(db) selepas berunding dengan Premier Sarawak.”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/32/msa@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/32/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2), dengan menggantikan perkataan “perenggan 6(1)(d)” dengan perkataan “perenggan 6(1)(d), (da), (db)”. Pindaan seksyen 28"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/32/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/32/msa@/~cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/32/msa@/~cl_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/32/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Perenggan 28(a) Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/32/msa@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/32/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subperenggan (ii), dengan memotong perkataan “atau” di hujung subperenggan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/32/msa@/~cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/32/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subperenggan (iii) subperenggan yang berikut: “(iv) bank Islam yang dilesenkan dengan sewajarnya di bawah Akta Perkhidmatan Kewangan Islam 2013 [Akta 759]; (v) mana-mana institusi kewangan lain yang dilesenkan dengan sewajarnya di bawah Akta Perkhidmatan Kewangan Islam 2013; (vi) institusi kewangan pembangunan yang dikawal selia dengan sewajarnya di bawah Akta Institusi Kewangan Pembangunan 2002 [Akta 618]; atau (vii) koperasi yang didaftarkan dengan sewajarnya di bawah Akta Koperasi 1993 [Akta 502];”."
      }
    }
  ]
}
