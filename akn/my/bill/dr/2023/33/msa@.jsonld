      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/33/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 576(2) Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/33/msa@/~cl_26__para_a",
