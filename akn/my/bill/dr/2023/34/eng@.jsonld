      "schema:text": {
        "@language": "en",
        "@value": "inflation;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_VI__cl_32__subsec_2__para_c",
