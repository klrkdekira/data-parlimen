      "@type": "akn:clause",
      "eli:number": "28",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "There shall be a committee called the “Fiscal Policy Committee” which may make recommendations to the Cabinet in respect of matters relating to the fiscal policy of the Government. Members of Committee"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_29__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_29__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_29__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_29__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V"
    },
    {
