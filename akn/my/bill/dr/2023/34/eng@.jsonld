        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_VI__cl_32__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_VI__cl_32__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_VI__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister shall, in respect of every financial year, lay before the House of Representatives the economic outlook report together with the statement of the estimated receipts and expenditure for that year."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_VI__cl_32__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_VI__cl_32__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_VI__cl_32__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_VI__cl_32__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_VI__cl_32__subsec_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_VI__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "The economic outlook report shall contain information on the current economic performance and economic forecast consistent with the fiscal objectives and shall include the macroeconomic forecasts for that financial year, setting out actual, estimated and projected values of the economic indicators, consisting of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_VI__cl_32__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_VI__cl_32__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "gross domestic product and its components;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_VI__cl_32__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
