      "schema:text": {
        "@language": "en",
        "@value": "The fiscal outlook report shall contain the following information:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_VI__cl_33__subsec_2__para_a",
