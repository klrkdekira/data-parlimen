      "schema:text": {
        "@language": "en",
        "@value": "any fiscal adjustment plan referred to under Part IV where applicable; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_VI__cl_33__subsec_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
