        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_29__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_29__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_29__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_29__subsec_1__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_29__subsec_1__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_29__subsec_1__para_i"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "The Committee shall consist of the following members:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_29__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Prime Minister as Chairman;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_29__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Deputy Prime Minister;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_29__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Minister charged with the responsibility for finance;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_29__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Minister charged with the responsibility for economy;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_29__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Chief Secretary to the Government;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_29__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Secretary General of Treasury;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_29__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Secretary General of the Ministry of Economy;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_29__subsec_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Governor of Central Bank of Malaysia; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_29__subsec_1__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "not more than two other persons who shall be appointed by the Committee who shall be from among persons of standing and experience in fiscal or public finance."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_29__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "The head of division in charge of fiscal policy affairs in the Treasury shall be the secretary to the Committee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_29__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "The Chairman may invite any person to attend the meeting of the Committee for the purpose of obtaining views on any matter under discussion."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_29__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "The Committee may determine its own procedure. Duties and responsibilities of Committee"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_30__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_30__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_30__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V",
      "schema:name": {
        "@language": "en",
        "@value": "The Committee shall have duties and responsibilities to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_30__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "oversee the fiscal matters, debt and liabilities, and fiscal risks;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_30__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "deliberate and propose policies to the Government towards achieving the fiscal objectives as specified in section 8 of this Act; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_30__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "fulfil its fiduciary duty to ensure the conduct of fiscal policy is consistent with the principles of responsible fiscal management as specified in subsection 6(2) of this Act. Subcommittee"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_31__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_31__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_31__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_31__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_31__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_31__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "The Committee may establish a subcommittee to assess the fiscal risk, debt and other liabilities exposure to the Government."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_31__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "This subcommittee shall report and make recommendations to the Committee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_31__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "The Committee shall determine the membership of this subcommittee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_31__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "The subcommittee may determine its own procedure."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_31__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~part_V__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "The subcommittee shall be subject to, and act in accordance with any directions given to the subcommittee by the Committee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/eng@/~sched_1",
      "@type": "akn:schedule",
