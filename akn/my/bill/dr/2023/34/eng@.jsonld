      "schema:text": {
        "@language": "en",
        "@value": "[Subsection 8(2)] Fiscal Objectives and Quantified Values Fiscal Objectives Annual development expenditure incurred as a percentage of gross domestic product Fiscal balance as a percentage of gross domestic product Debt level as a percentage of gross domestic product Financial guarantee as a percentage of gross domestic product"
      }
    },
