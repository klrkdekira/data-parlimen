        "@language": "ms",
        "@value": "pasaran buruh; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_VI__cl_32__subsec_2__para_d",
