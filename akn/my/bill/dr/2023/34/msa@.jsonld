    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_VI__art_103__cl_37__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_VI__art_103__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "Penyata risiko fiskal hendaklah digunakan bagi maksud menilai pendedahan risiko fiskal kepada Kerajaan. Penyata perbelanjaan cukai"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_VI__art_103__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "hasPart": [
