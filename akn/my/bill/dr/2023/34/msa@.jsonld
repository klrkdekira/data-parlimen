      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_VI__cl_32__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "keluaran dalam negeri kasar dan komponennya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_VI__cl_32__subsec_2__para_b",
