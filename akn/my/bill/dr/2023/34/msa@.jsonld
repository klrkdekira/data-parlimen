      "schema:text": {
        "@language": "ms",
        "@value": "Menteri yang dipertanggungkan dengan tanggungjawab bagi kewangan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_V__cl_29__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri yang dipertanggungkan dengan tanggungjawab bagi ekonomi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_V__cl_29__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Setiausaha Negara;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_V__cl_29__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Setiausaha Perbendaharaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_V__cl_29__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Setiausaha Kementerian Ekonomi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_V__cl_29__subsec_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Gabenor Bank Negara Malaysia; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_V__cl_29__subsec_1__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_V__cl_29__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak lebih daripada dua orang lain yang hendaklah dilantik oleh Jawatankuasa yang hendaklah daripada kalangan orang yang mempunyai kedudukan dan pengalaman dalam fiskal atau kewangan awam."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_V__cl_29__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_V__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua bahagian yang bertanggungjawab bagi hal ehwal dasar fiskal di Perbendaharaan hendaklah menjadi setiausaha kepada Jawatankuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_V__cl_29__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_V__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi boleh menjemput mana-mana orang untuk menghadiri mesyuarat Jawatankuasa bagi maksud mendapatkan pandangan mengenai apa-apa perkara yang dibincangkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_V__cl_29__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_V__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatankuasa boleh menentukan tatacaranya sendiri. Tugas dan tanggungjawab Jawatankuasa"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_V__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_V__cl_30__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_V__cl_30__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_V__cl_30__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_V",
      "schema:name": {
        "@language": "ms",
        "@value": "Jawatankuasa hendaklah mempunyai tugas dan tanggungjawab untuk—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_V__cl_30__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_V__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "menyelia perkara fiskal, hutang dan liabiliti, dan risiko fiskal;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_V__cl_30__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_V__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "menimbang teliti dan mencadangkan dasar kepada Kerajaan untuk mencapai objektif fiskal sebagaimana yang dinyatakan dalam seksyen 8 Akta ini; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_V__cl_30__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_V__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "memenuhi kewajipan fidusiarinya untuk memastikan pelaksanaan dasar fiskal adalah selaras dengan prinsip pengurusan fiskal yang bertanggungjawab sebagaimana yang dinyatakan dalam subseksyen 6(2) Akta ini. Jawatankuasa kecil"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_V__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_V__cl_31__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_V__cl_31__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_V__cl_31__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_V__cl_31__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_V__cl_31__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_V__cl_31__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_V__cl_31",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatankuasa boleh menubuhkan suatu jawatankuasa kecil untuk menilai risiko fiskal, hutang dan liabiliti lain kepada Kerajaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_V__cl_31__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_V__cl_31",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatankuasa kecil ini hendaklah melapor dan mengemukakan syor kepada Jawatankuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_V__cl_31__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_V__cl_31",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatankuasa hendaklah menentukan keanggotaan jawatankuasa kecil ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_V__cl_31__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_V__cl_31",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatankuasa kecil boleh menentukan tatacaranya sendiri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_V__cl_31__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_V__cl_31",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatankuasa kecil hendaklah tertakluk kepada, dan bertindak mengikut apa-apa arahan yang diberikan kepada jawatankuasa kecil oleh Jawatankuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "[Subseksyen 8(2)] Objektif Fiskal dan Nilai Kuantiti Objektif Fiskal Perbelanjaan pembangunan tahunan yang dilakukan sebagai peratusan kepada keluaran dalam negeri kasar Baki fiskal sebagai peratusan kepada keluaran dalam negeri kasar Paras hutang sebagai peratusan kepada keluaran dalam negeri kasar Jaminan kewangan sebagai peratusan kepada keluaran dalam negeri kasar"
      }
    },
