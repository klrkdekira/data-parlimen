      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_VI__art_103__cl_38__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa perubahan dalam dasar cukai dan perundangan cukai; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_VI__art_103__cl_38__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_VI__art_103__cl_38__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "maklumat lain yang berhubungan dengan perbelanjaan cukai."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_VI__art_103__cl_38__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_VI__art_103__cl_38",
      "schema:text": {
        "@language": "ms",
        "@value": "Penyata perbelanjaan cukai hendaklah digunakan bagi maksud menilai kehilangan hasil yang berbangkit daripada perubahan dasar cukai Kerajaan, termasuklah tetapi tidak terhad kepada pengecualian, peremitan, elaun, kadar cukai keutamaan, penangguhan atau timbal balas, yang mengurangkan obligasi cukai bagi mencapai objektif yang dihasratkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_VI__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_VI__cl_32__subsec_1",
