      "schema:text": {
        "@language": "ms",
        "@value": "Menteri hendaklah menyebabkan supaya diterbitkan penyata risiko fiskal tahunan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_VI__art_103__cl_37__subsec_2",
