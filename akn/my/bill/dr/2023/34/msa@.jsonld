      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_VI__cl_32__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_VI__cl_32",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri hendaklah, berkenaan dengan setiap tahun kewangan, membentangkan di hadapan Dewan Rakyat laporan tinjauan ekonomi berserta penyata anggaran hasil dan perbelanjaan bagi tahun itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_VI__cl_32__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_VI__cl_32__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_VI__cl_32__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_VI__cl_32__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_VI__cl_32__subsec_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_VI__cl_32",
      "schema:text": {
        "@language": "ms",
        "@value": "Laporan tinjauan ekonomi hendaklah mengandungi maklumat mengenai prestasi ekonomi semasa dan unjuran ekonomi selaras dengan objektif fiskal dan hendaklah termasuk unjuran makroekonomi bagi tahun kewangan itu, menetapkan nilai sebenar, anggaran dan unjuran nilai petunjuk ekonomi, yang terdiri daripada—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_VI__cl_32__subsec_2__para_a",
