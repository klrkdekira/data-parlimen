      "schema:text": {
        "@language": "ms",
        "@value": "risiko makroekonomi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_VI__art_103__cl_37__subsec_2__para_b",
