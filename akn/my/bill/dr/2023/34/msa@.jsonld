        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_VI__art_103__cl_37__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_VI__art_103__cl_37__subsec_2__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_VI__art_103__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "Penyata risiko fiskal hendaklah mengandungi maklumat yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/34/msa@/~part_VI__art_103__cl_37__subsec_2__para_a",
