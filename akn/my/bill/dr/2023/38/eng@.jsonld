      "schema:text": {
        "@language": "en",
        "@value": "Paragraph 3(c) of the principal Act is amended by inserting after the word “property” the words “or instrumentalities”. Amendment of section 7"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/eng@/~cl_4",
      "@type": "akn:clause",
