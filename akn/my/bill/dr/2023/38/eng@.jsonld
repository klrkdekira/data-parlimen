      "schema:text": {
        "@language": "en",
        "@value": "Subsection 7(2) of the principal Act is amended by inserting after the words “diplomatic channel” the words “, or where the circumstances require, may be made directly to the relevant authority as determined by the foreign State”. Amendment of section 13"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
