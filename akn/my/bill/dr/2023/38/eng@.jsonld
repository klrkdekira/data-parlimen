        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/eng@/~cl_2__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection 2(3)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/eng@/~cl_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/eng@/~cl_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words “that are criminal proceedings are” the words “in a prescribed foreign State are”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/eng@/~cl_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/eng@/~cl_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for paragraph (a) the following paragraph: “(a) instituted when any action is brought in court against a person in relation to a foreign serious offence;”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/eng@/~cl_2__para_b__subpara_iii",
