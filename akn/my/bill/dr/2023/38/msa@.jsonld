      "schema:text": {
        "@language": "ms",
        "@value": "Subperenggan 23(4)(b)(i) Akta ibu dipinda dengan menggantikan perkataan “berkemungkinan mempunyai nilai substansial, sama ada benda itu sendiri atau bersama dengan benda lain, kepada” dengan perkataan “adalah berkenaan dengan”. Pindaan seksyen 31"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_9",
