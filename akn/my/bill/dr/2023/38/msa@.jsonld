        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_1__subsec_2"
      ],
