      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan 3(c) Akta ibu dipinda dengan memasukkan selepas perkataan “harta” perkataan “atau peralatan”. Pindaan seksyen 7"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_4",
      "@type": "akn:clause",
