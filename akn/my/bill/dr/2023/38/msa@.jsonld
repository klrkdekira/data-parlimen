      "schema:name": {
        "@language": "ms",
        "@value": "RUU Bantuan Bersama dalam Perkara Jenayah (Pindaan) 2023"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
