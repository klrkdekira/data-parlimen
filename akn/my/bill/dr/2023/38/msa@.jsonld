    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_10__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_10__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 34(1) Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_10__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (c), dengan memasukkan selepas perkataan “harta” perkataan “atau peralatan”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_10__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (e), dengan memasukkan selepas subsubperenggan (i)(B) subsubperenggan yang berikut: “(C) peralatan atau nilai peralatan itu; atau”. Pindaan seksyen 36"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subperenggan 36(2)(b)(i) Akta ibu dipinda dengan menggantikan perkataan “berkemungkinan mempunyai nilai substansial, sama ada benda itu sendiri atau bersama dengan benda lain, kepada” dengan perkataan “adalah berkenaan dengan”. Pindaan seksyen 38"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 38 Akta ibu dipinda dalam nota bahu dengan"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "menggantikan perkataan “berkenaan dengan pegawai diberi kuasa yang melaksanakan” dengan perkataan “kerana mematuhi”. Seksyen baharu 41a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memasukkan selepas seksyen 41 seksyen yang berikut: “Pemakaian undang-undang bertulis lain 41a. (1) Dalam memberikan bantuan dalam perkara jenayah di bawah Bahagian ini, peruntukan undang-undang bertulis lain yang berhubungan dengan kuasa pegawai diberi kuasa hendaklah terpakai setakat peruntukan itu tidak bercanggah dengan Akta ini. (2) Bagi maksud subseksyen (1), perlindungan dan kekebalan yang diberikan kepada pegawai diberi kuasa itu dalam melaksanakan kuasa di bawah undang-undang bertulis lain itu hendaklah terpakai bagi pegawai diberi kuasa itu.”."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Bantuan Bersama dalam Perkara Jenayah (Pindaan) 2023."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta dan Menteri boleh menetapkan tarikh yang berlainan bagi permulaan kuat kuasa peruntukan yang berlainan Akta ini. Pindaan seksyen 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Bantuan Bersama dalam Perkara Jenayah 2002 [Akta 621], yang disebut “Akta ibu” dalam Akta ini, dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_2__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_2__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_2__para_a__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_2__para_a__subpara_iv",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_2__para_a__subpara_v",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_2__para_a__subpara_vi",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_2__para_a__subpara_vii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_2__para_a__subpara_viii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_2__para_a__subpara_ix"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen 2(1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_2__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan takrif “institusi kewangan” dengan takrif yang berikut: ‘ “institusi kewangan” ertinya— (a) suatu bank berlesen, penanggung insurans berlesen dan bank pelaburan berlesen di bawah Akta Perkhidmatan Kewangan 2013 [Akta 758]; (b) suatu bank Islam antarabangsa berlesen, pengendali takaful antarabangsa berlesen, bank Islam berlesen dan pengendali takaful berlesen di bawah Akta Perkhidmatan Kewangan Islam 2013 [Akta 759]; (c) suatu institusi yang ditetapkan di bawah Akta Institusi Kewangan Pembangunan 2002 [Akta 618]; (d) seorang pemegang lesen di bawah Akta Perniagaan Perkhidmatan Wang 2011 [Akta 731]; (e) seseorang yang dilesenkan atau didaftarkan di bawah Akta Pasaran Modal dan Perkhidmatan 2007 [Akta 671]; (f) suatu depositori pusat di bawah Akta Perindustrian Sekuriti (Depositori Pusat) 1991 [Akta 453]; (g) seorang pemegang lesen bank, pemegang lesen insurans, pemegang lesen sekuriti dan mana-mana entiti berlesen di bawah Akta Perkhidmatan Kewangan dan Sekuriti Labuan 2010 [Akta 704]; dan (h) seorang pemegang lesen bank Islam, pemegang lesen takaful, pemegang lesen sekuriti Islam dan mana-mana entiti berlesen di bawah Akta Perkhidmatan Kewangan dan Sekuriti Islam Labuan 2010 [Akta 705];’;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_2__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong takrif “institusi kewangan luar pesisir”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_2__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan takrif “kesalahan berat” dengan takrif yang berikut: ‘ “kesalahan berat” ertinya— (a) suatu kesalahan terhadap undang-undang Malaysia yang berkenaan dengannya hukuman yang diperuntukkan oleh undang-undang itu ialah pemenjaraan bagi tempoh sekurang-kurangnya satu tahun, atau suatu hukuman yang lebih berat; atau (b) apa-apa percubaan, persubahatan atau komplot untuk melakukan mana-mana kesalahan yang disebut dalam perenggan (a);’;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_2__para_a__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam takrif “kesalahan berat asing” dengan menggantikan perenggan (a) dengan perenggan yang berikut: “(a) terhadap undang-undang sesuatu Negara asing yang ditetapkan yang berkenaan dengannya hukuman yang diperuntukkan oleh undang-undang itu ialah pemenjaraan bagi tempoh sekurang-kurangnya satu tahun, atau suatu hukuman yang lebih berat; dan”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_2__para_a__subpara_ix",
      "@type": "akn:subparagraph",
      "eli:number": "ix",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam takrif “perkara jenayah sampingan”, dalam perenggan (a), dengan memasukkan selepas perkataan “harta” perkataan “atau peralatan”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_2__para_a__subpara_v",
      "@type": "akn:subparagraph",
      "eli:number": "v",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam takrif “pegawai diberi kuasa” dalam perenggan (d), dengan menggantikan perkataan “Badan Pencegah Rasuah” dengan perkataan “Suruhanjaya Pencegahan Rasuah Malaysia”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_2__para_a__subpara_vi",
      "@type": "akn:subparagraph",
      "eli:number": "vi",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif “perakuan kekebalan undang-undang asing” takrif yang berikut: ‘ “peralatan” ertinya— (a) apa-apa benda yang digunakan dalam, atau berkaitan dengan, pelakuan mana-mana kesalahan berat atau kesalahan berat asing; atau (b) apa-apa harta yang keseluruhannya atau sebahagiannya digunakan dalam, atau berkaitan dengan, pelakuan mana-mana kesalahan berat atau kesalahan berat asing, sama ada benda atau harta itu terletak di dalam atau di luar Malaysia;’;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_2__para_a__subpara_vii",
      "@type": "akn:subparagraph",
      "eli:number": "vii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam takrif “perintah pelucuthakan” dengan memasukkan selepas perkataan “harta” perkataan “atau peralatan”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_2__para_a__subpara_viii",
      "@type": "akn:subparagraph",
      "eli:number": "viii",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_2__para_a__subpara_viii__subpara_A",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_2__para_a__subpara_viii__subpara_B",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_2__para_a__subpara_viii__subpara_C",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_2__para_a__subpara_viii__subpara_D"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam takrif “perintah pelucuthakan asing”—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_2__para_a__subpara_viii__subpara_A",
      "@type": "akn:subparagraph",
      "eli:number": "A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_2__para_a__subpara_viii",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (a), dengan memotong perkataan “atau” di hujung perenggan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_2__para_a__subpara_viii__subpara_B",
      "@type": "akn:subparagraph",
      "eli:number": "B",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_2__para_a__subpara_viii",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (b), dengan menggantikan koma di hujung perenggan itu dengan perkataan “; atau”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_2__para_a__subpara_viii__subpara_C",
      "@type": "akn:subparagraph",
      "eli:number": "C",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_2__para_a__subpara_viii",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan (b) perenggan yang berikut: “(c) peralatan atau nilai peralatan itu;”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_2__para_a__subpara_viii__subpara_D",
      "@type": "akn:subparagraph",
      "eli:number": "D",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_2__para_a__subpara_viii",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan “yang dibuat pada atau selepas tarikh perintah di bawah subseksyen 17(1) yang mengisytiharkan sesuatu Negara asing sebagai Negara asing yang ditetapkan mula berkuat kuasa atau pada atau selepas tarikh arahan khas yang diberikan oleh Menteri berkenaan dengan suatu Negara asing di bawah seksyen 18;”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_2__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_2__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_2__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen 2(3)—"
