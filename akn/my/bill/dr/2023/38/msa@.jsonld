      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 31(1) Akta ibu dipinda dengan menggantikan perkataan “harta yang” di mana-mana jua terdapat dengan perkataan “harta atau peralatan yang”. Pindaan seksyen 34"
      }
    }
  ]
