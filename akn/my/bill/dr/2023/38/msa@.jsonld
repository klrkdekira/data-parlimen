      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perenggan (a) dengan perenggan yang berikut: “(a) dimulakan apabila apa-apa tindakan dibawa ke mahkamah terhadap seseorang berhubung dengan suatu kesalahan berat asing;”; dan"
      }
