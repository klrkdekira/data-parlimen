      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan 20(1)(h) Akta ibu dipinda dengan memotong perkataan “tidak begitu penting kepada penyiasatan atau”. Pindaan seksyen 23"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/38/msa@/~cl_8",
