      "schema:text": {
        "@language": "ms",
        "@value": "Bab ini mula berkuat kuasa apabila berkuatkuasanya Akta ini. Pindaan Jadual 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/4/msa@/~chp_III__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
