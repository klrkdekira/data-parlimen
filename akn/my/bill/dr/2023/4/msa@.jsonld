      "schema:name": {
        "@language": "ms",
        "@value": "Bahagian I Jadual 1 kepada Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/4/msa@/~chp_II__cl_16__para_a",
