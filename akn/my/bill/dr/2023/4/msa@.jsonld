      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/4/msa@/~chp_II__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “the payer shall upon paying or crediting such payments” perkataan “in a calendar month”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/4/msa@/~chp_II__cl_14__para_b",
      "@type": "akn:paragraph",
