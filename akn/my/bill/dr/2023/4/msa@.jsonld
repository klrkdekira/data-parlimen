      "schema:name": {
        "@language": "ms",
        "@value": "Akta Cukai Keuntungan Harta Tanah 1976 dipinda dalam"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/4/msa@/~chp_II__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/4/msa@/~chp_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 86 Akta ibu dipinda dengan memasukkan selepas subseksyen (1) subseksyen yang berikut: “(1a) For the purposes of this section, the person referred to in paragraphs (1)(a) and (b) shall furnish to the Director General a return in the prescribed form on an electronic medium or by way of electronic transmission in accordance with section 152a.”. Pindaan seksyen 97a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/4/msa@/~chp_II__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/4/msa@/~chp_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Subperenggan 97a(5)(b)(iii) Akta ibu dipinda dengan memasukkan selepas perkataan “subsection 107a(2)” perkataan “, 107d(3)”. Pindaan seksyen 103"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/4/msa@/~chp_II__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
