      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “two per cent of the payments on account of tax” perkataan “for that year of assessment”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/4/msa@/~chp_II__cl_14__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/4/msa@/~chp_II__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan “for any year of assessment”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/4/msa@/~chp_II__cl_14__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/4/msa@/~chp_II__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “within thirty days” dengan perkataan “not later than the end of the following calendar month”. Pindaan seksyen 131a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/4/msa@/~chp_II__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/4/msa@/~chp_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan 131a(1)(c) Akta ibu dipinda dengan memasukkan selepas perkataan “107a(2)” perkataan “, 107d(3)”. Pindaan Jadual 1"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/4/msa@/~chp_II__cl_16",
      "@type": "akn:clause",
