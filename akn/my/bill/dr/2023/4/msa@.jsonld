      "schema:text": {
        "@language": "ms",
        "@value": "dalam subperenggan (b), dengan memotong perkataan “or” di hujung subperenggan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/4/msa@/~chp_II__cl_16__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/4/msa@/~chp_II__cl_16__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subperenggan (c), dengan menggantikan noktah di hujung subperenggan itu dengan perkataan “; or”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/4/msa@/~chp_II__cl_16__para_c__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/4/msa@/~chp_II__cl_16__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subperenggan (c) subperenggan yang berikut: “(d) twenty per cent of the paid-up capital in respect of ordinary shares of the company at the beginning of the basis period for a year of assessment is directly or indirectly owned by one or more companies incorporated outside Malaysia or by one or more individuals who are not citizens of Malaysia.”;"
      }
    },
