      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/4/msa@/~chp_II",
      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 107d(1) Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/4/msa@/~chp_II__cl_14__para_a",
      "@type": "akn:paragraph",
