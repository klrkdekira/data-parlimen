      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "any death or personal injury; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_10__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "any damage to the property, which occurs in Malaysia. Restriction of immunity in proceedings relating to determination of right, etc., of property"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_11__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_11__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_11__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III",
      "schema:text": {
        "@language": "en",
        "@value": "A foreign State shall not be immune from the jurisdiction of the court in any proceedings to determine—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_11__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "any right, interest or obligation of the foreign State in immovable property situated in Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_11__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "any right, interest or obligation of the foreign State in movable or immovable property arising out of succession, gift or bona vacantia; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_11__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "any right, interest or obligation of the foreign State in the administration of property such as trust property, the estate of a bankrupt or the property of a company in the event of its winding up. Restriction of immunity in proceedings relating to intellectual property, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_12__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_12__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III",
      "schema:text": {
        "@language": "en",
        "@value": "A foreign State shall not be immune from the jurisdiction of the court in any proceedings relating to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_12__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "the determination of any right of a foreign State in a patent, industrial design, trade name or business name, trademark, copyright, geographical indication, layout-design of integrated circuits or any other form of intellectual or industrial property; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_12__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "an alleged infringement by the foreign State, of a right of the nature referred to in paragraph (a) which belongs to a third person and is protected, registered or granted in Malaysia. Restriction of immunity in proceedings relating to participation in companies, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_13__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_13__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_13__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "A foreign State shall not be immune from the jurisdiction of the court in any proceedings relating to its participation in a company or other collective body, whether incorporated or unincorporated, being a proceedings concerning the relationship between the foreign State and the company or other collective body or the other participants in the company or collective body, provided that the company or other collective body—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_13__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_13__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "has participants other than the foreign State or international organizations; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_13__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_13__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "is incorporated or constituted, as the case may be, under the law of Malaysia or has its registered address or principal place of business in Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (1), the immunity enjoyed by the foreign State shall not be affected if the foreign State and the parties to the dispute have agreed not to be subjected to the jurisdiction of the court or instrument establishing or regulating the company or collective body, as the case may be, contains provisions to that effect. Restriction of immunity in proceedings relating to ships owned or operated by foreign State"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_14__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_14__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_14__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_14__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_14__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "A foreign State shall not be immune from the jurisdiction of the court in any proceedings relating to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_14__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_14__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the operation of the ship owned or operated by the foreign State; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_14__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_14__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the carriage of cargo on board a ship owned or operated by the foreign State, if at the time the cause of action arose, the ship was used other than for government non-commercial purposes."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "A foreign State may plead all measures of defence, prescription and limitation of liability which are applicable to private ships and cargoes and their owners in the proceedings referred to in subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_14__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_14__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_14__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_14__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (1), the immunity of the foreign State shall not be affected if, for the time being, the disputed ship or cargo, as the case may be, is—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_14__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_14__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "a warship or naval auxiliaries used only for government non-commercial service;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_14__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_14__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "a ship owned or operated by a foreign State and used only for government non-commercial service; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_14__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_14__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "a cargo carried on board the ships referred to in paragraph (a), or a cargo owned by the foreign State and used or intended for use exclusively for government non-commercial purposes."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_14__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "If in a proceedings there arises a question relating to the government non-commercial character of a ship owned or operated by a foreign State or cargo owned by a foreign State, a certificate signed by a diplomatic representative or other competent authority of that foreign State and submitted to the court shall serve as evidence of the character of that ship or cargo. Restriction of immunity in proceedings relating to recovery of tax"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_15__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_15__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_15__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "A foreign State, the head of State and the head of Government shall not be immune from the jurisdiction of the court in any proceedings relating to recovery of tax enforced under any written law."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this section, “tax” includes any compulsory charge, duty, excise, cess, dues or other impost imposed under any written law. Restriction of immunity if there is an agreement on arbitration"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_16__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_16__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_16__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III",
      "schema:text": {
        "@language": "en",
        "@value": "If there exists an agreement between a foreign State, the head of State or the head of Government and any person to submit to arbitration in Malaysia any dispute relating to a commercial transaction, the foreign State, the head of State or the head of Government shall not be immune from the jurisdiction of the court in any proceedings relating to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_16__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "the validity, interpretation or application of the arbitration agreement;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_16__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "the arbitration procedure; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_16__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "the confirmation or the setting aside of the award."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_8__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_8__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_8__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "A foreign State shall not be immune from the jurisdiction of the court in any proceedings arising out of a commercial transaction carried out by the foreign State with any person in Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_8__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_8__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (1), the immunity enjoyed by the foreign State shall not be affected if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_8__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_8__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the parties to the commercial transaction have expressly agreed that the foreign State shall not be subjected to the jurisdiction of the court; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_8__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_8__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the commercial transaction is between foreign States."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_8__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_8__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_8__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "Where a foreign State enterprise or other entity established by a foreign State which has an independent legal personality and is capable of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_8__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_8__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "suing or being sued; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_8__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_8__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "acquiring, owning or possessing and disposing of property, including property which that foreign State has authorized it to operate or manage, is involved in a proceedings relating to a commercial transaction in which that entity is engaged, the immunity enjoyed by that foreign State shall not be affected."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_8__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "The head of State and the head of Government shall not be immune from the jurisdiction of the court in any proceedings arising out of a commercial transaction carried out by him with any person in Malaysia in his personal capacity. Restriction of immunity in proceedings relating to contract of employment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_9__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_9__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "A foreign State shall not be immune from the jurisdiction of the court in any proceedings relating to contract of employment between the foreign State and an individual for any work performed or to be performed, in whole or in part, in Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_9__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_9__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_9__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_9__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_9__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_9__subsec_2__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (1), the immunity enjoyed by the foreign State shall not be affected if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_9__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_9__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the employee has been recruited to perform particular functions in the exercise of governmental authority of the foreign State;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_9__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_9__subsec_2__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_9__subsec_2__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_9__subsec_2__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_9__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the employee is—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_9__subsec_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_9__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "a diplomatic agent or consular officer as it is defined in the Diplomatic Privileges (Vienna Convention) Act 1966 [Act 636] and the Consular Relations (Vienna Convention) Act 1999 [Act 595] respectively;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_9__subsec_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_9__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "a member of the diplomatic staff of a permanent mission to an international organization or of a special mission, or is recruited to represent a foreign State at an international conference; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_9__subsec_2__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_9__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "any other person enjoying diplomatic immunity;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_9__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_9__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the subject matter of the proceedings is the recruitment, renewal of employment or reinstatement of employment of an individual;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_9__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_9__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the subject matter of the proceedings is the dismissal or termination of employment of an individual and, as determined by the head of State, the head of Government or the Minister of Foreign Affairs of the employer foreign State, such a proceedings would interfere with the security interests of that foreign State;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_9__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_9__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "at the time when the proceedings is instituted, the employee is a national of the employer foreign State unless the employee is a permanent resident of Malaysia; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_9__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_9__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the employer foreign State and the employee have agreed in writing that the immunity enjoyed by the foreign State shall not be affected, subject to any public policy conferring jurisdiction of the court by reason of the subject matter of the proceedings."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_9__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "The head of State and the head of Government shall not be immune from the jurisdiction of the court in any proceedings relating to contract of employment with any person in Malaysia in his personal capacity. Restriction of immunity in proceedings relating to personal injuries, etc., claims"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_II__cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_II__cl_7__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_II__cl_7__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_II__cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_II__cl_7__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_II__cl_7__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_II__cl_7__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_II__cl_7__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "A foreign State, the head of State and the head of Government shall be deemed to have waived their immunity from the jurisdiction of the court if any of them—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_II__cl_7__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "has expressly consented to the exercise of the jurisdiction of the court;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_II__cl_7__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "has submitted to the jurisdiction of the court;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_II__cl_7__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "has instituted, intervened or taken any step in the proceedings of the court; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_II__cl_7__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "has filed any counterclaim arising out of the same legal relationship or facts as the principal claim in any court."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_II__cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_II__cl_7__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_II__cl_7__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (1), a foreign State, the head of State and the head of Government shall not be deemed to have waived their immunity from the jurisdiction of the court if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_II__cl_7__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_II__cl_7__subsec_2__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_II__cl_7__subsec_2__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_II__cl_7__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the foreign State, the head of State and the head of Government, enters an appearance, intervenes or takes any other step in a proceedings before a court only for the purposes of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_II__cl_7__subsec_2__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_II__cl_7__subsec_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "invoking immunity; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_II__cl_7__subsec_2__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_II__cl_7__subsec_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "asserting a right or interest in property at issue in the proceedings; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_II__cl_7__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_II__cl_7__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the foreign State or its representative, the head of State or the head of Government appears as a witness in any court."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_II__cl_7__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of paragraph 1(a), any provision in the agreement entered by a foreign State, the head of State or the head of Government which provides that the agreement shall be governed by and construed in accordance with the law of Malaysia shall not be interpreted as consent to the exercise of jurisdiction of the court."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_I__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_I__cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_I__cl_5__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_I__cl_5__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_I",
      "schema:name": {
        "@language": "en",
        "@value": "Subject to Chapters II and III of this Part and Part III,—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_I__cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_I__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "a foreign State in respect of itself on its official capacity and its property;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_I__cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_I__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "the head of State on his official capacity; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_I__cl_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_I__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "the head of Government on his official capacity, shall enjoy immunity from the jurisdiction of the court and no proceedings shall be instituted against them by any party. Proceedings against foreign State, head of State and head of Government"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_I__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_I__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_I__cl_6__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_I__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_I__cl_6__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_I__cl_6__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_I__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "A proceedings before any court shall be deemed to have been instituted against a foreign State and its property, if that foreign State and its property—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_I__cl_6__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_I__cl_6__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "is named as a party to that proceedings; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_I__cl_6__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_I__cl_6__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "is not named as a party to the proceedings but the proceedings in effect seeks to affect the property, rights, interests or activities of the foreign State."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_I__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_I__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "A proceedings before any court shall be deemed to have been instituted against the head of State or the head of Government if the head of State or the head of Government is named as a party to that proceedings."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
