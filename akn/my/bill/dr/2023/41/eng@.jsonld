        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_21",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_22",
