      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "FOREIGN STATE IMMUNITY COUNCIL Establishment of Foreign State Immunity Council"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "A council by the name of the Foreign State Immunity Council is established. Functions of Council"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_21__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_21__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_21__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_21__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "The Council shall have the following functions:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_21__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "to deliberate and decide on all matters concerning foreign State immunity arising out from the implementation of this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_21__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "to issue policies, guidelines and directives to the Government agencies for the purposes of this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_21__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "to monitor the implementation of policies, guidelines and directives by the Government agencies on matters relating to the implementation of this Act; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_21__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "to do such other things arising out of or consequential to the functions of the Council under this Act consistent with the purposes of this Act. Powers of Council"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_22__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_22__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_22__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_22__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "The Council shall have the power and may do all things necessary for or in connection with or incidental to, the performance of its functions under this Act including—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_22__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "to certify in writing any fact relating to the question whether a state or a person, as the case may be, is a foreign State, the head of State or the head of Government within the meaning of this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_22__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "to certify in writing any matter relating to foreign State immunity;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_22__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "to control and coordinate Government agencies relating to the service of any cause paper or other document arising out of any proceedings; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_22__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "to appoint any committee as the Council considers necessary and expedient to assist the Council in performing any of its functions and in the exercise of its powers. Membership of Council"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_23",
