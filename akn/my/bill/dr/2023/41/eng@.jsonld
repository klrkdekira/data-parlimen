      "schema:text": {
        "@language": "en",
        "@value": "IMMUNITY FROM ACTION OR JUDGMENT AGAINST PROPERTY OF FOREIGN STATE Pre-trial action against property of foreign State"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_III__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_III__cl_17__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_III__cl_17__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "No pre-trial action shall be brought, instituted or maintained against the property of a foreign State before any court unless—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_III__cl_17__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_III__cl_17__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_III__cl_17__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_III__cl_17__para_a__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_III__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "the foreign State has expressly consented to the taking of such action as provided—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_III__cl_17__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_III__cl_17__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "in an international agreement;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_III__cl_17__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_III__cl_17__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "in an arbitration agreement or in a written contract; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_III__cl_17__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_III__cl_17__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "in a declaration before the court or in a written communication after a dispute between the parties has arisen; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_III__cl_17__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_III__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "the foreign State has allocated the property for the satisfaction of the claim which is the object of that proceedings. Enforcement of judgment and order against property of foreign State"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_III__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
