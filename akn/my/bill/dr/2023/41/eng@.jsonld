        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_24",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_25",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_26",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_27",
