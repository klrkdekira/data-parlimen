      "schema:text": {
        "@language": "en",
        "@value": "General immunity from jurisdiction Foreign State immunity"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_II",
      "@type": "akn:chapter",
      "eli:number": "II",
