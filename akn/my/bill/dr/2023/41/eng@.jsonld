        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_24__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_24__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_24__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_24__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "The Council shall convene its meetings as often as may be necessary."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_24__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "The meetings shall be held at the time and place as determined by the Chairman."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_24__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "The Chairman may authorize the use of a live video link, live television link or any other electronic means of communication for the purposes of any meeting of the Council. Procedure at meetings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_25__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_25__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_25__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_25__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_25__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "The Chairman shall preside at all meetings of the Council."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_25__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "If the Chairman is absent from any meeting of the Council, he may appoint the Deputy Chairman to replace him as the chairman of the meeting or, in the absence of the Deputy Chairman, any other member of the Council, to replace him as the chairman of the meeting."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_25__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "The quorum of the Council shall be seven including the chairman of the meeting."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_25__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "Every member of the Council present shall be entitled to one vote and if on a question to be determined by the Council there is an equality of votes, the Chairman shall have a casting vote. Temporary exercise of functions of Chairman"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_26__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_26__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_26__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_26__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_26__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_26__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "The Deputy Chairman shall act as the Chairman for the period when—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_26__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_26__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the office of the Chairman is vacant;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_26__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_26__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Chairman is absent from duty or from Malaysia; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_26__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_26__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Chairman is, for any other reason, unable to carry out his functions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_26__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_26",
      "schema:text": {
        "@language": "en",
        "@value": "The Deputy Chairman shall, during the period in which he is carrying out the functions of the Chairman under this section, be deemed to be the Chairman. Council may invite others to meetings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "The Council may invite any person not being a member of the Council to attend its meetings to advise the Council on any matter under discussion. Procedure"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to this Act, the Council may determine its own procedure. Secretary to Council"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_29__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_29__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_29__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_29__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General of the Legal Affairs Division of the Prime Minister Department shall be the Secretary to the Council."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_29__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_29__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_29__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "The Secretary shall be responsible—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_29__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_29__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "for the overall administration and management of the functions and the day-to-day affairs of the Council; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_29__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_29__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "for the carrying out of any other duties as directed by the Council."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_29__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_IV__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "The Secretary shall, in carrying out his responsibilities, act under the direction of the Council."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_I__cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Jurisdictional Immunities of Foreign States Act 2023."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Prime Minister by notification in the Gazette. Non-application of the Act"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_I__cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_I__cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_I",
      "schema:name": {
        "@language": "en",
        "@value": "This Act shall not apply to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_I__cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_I__cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "proceedings governed by the Visiting Forces Act 1960 [Act 432]; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_I__cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_I__cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "criminal proceedings. Prevailing law"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_I__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_I",
      "schema:text": {
        "@language": "en",
        "@value": "The provision of this Act shall be in addition to, and not in derogation of, the provisions of any other written law relating to the diplomatic missions, consular posts, special missions, missions to international organizations, agent, or delegations of organs of international organization or to international conferences. Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_I__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_I__cl_4__list_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_I__cl_4__list_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_I",
      "schema:name": {
        "@language": "en",
        "@value": "In this Act, unless the context otherwise requires—"
      },
      "schema:text": {
        "@language": "en",
        "@value": "“head of Government” means a person who presides over the cabinet or any body of similar nature of a foreign State; “head of State” means a person who holds the highest official position in a foreign State; “court” means a court of competent jurisdiction in Malaysia; “Council” means the Foreign State Immunity Council established under section 20; “foreign State” means any country or territory outside Malaysia, and includes—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_I__cl_4__list_1",
      "@type": "akn:list",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_I__cl_4__list_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_I__cl_4__list_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_I__cl_4__list_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_I__cl_4"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_I__cl_4__list_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_I__cl_4__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "a department or various organs of government of a foreign State;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_I__cl_4__list_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_I__cl_4__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "a constituent unit of a federal foreign State or political subdivisions of the foreign State; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_I__cl_4__list_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_I__cl_4__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "the agency, body or other entity of a foreign State established under a written law of or otherwise by the foreign State; “commercial transaction” means—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_I__cl_4__list_2",
      "@type": "akn:list",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_I__cl_4__list_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_I__cl_4__list_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_I__cl_4__list_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_I__cl_4"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_I__cl_4__list_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_I__cl_4__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "any commercial contract or transaction for the sale of goods or supply of services;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_I__cl_4__list_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_I__cl_4__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "any contract for a loan or other transaction of a financial nature, including any obligation of guarantee or of indemnity in respect of any such loan or transaction; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_I__cl_4__list_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_I__cl_4__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "any other contract or transaction of a commercial, industrial, trading or professional nature, but not including a contract of employment."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_V",
      "@type": "akn:part",
      "eli:number": "V",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_V__cl_30",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "RECIPROCAL TREATMENT Withdrawal of immunities of foreign State where there is no reciprocal treatment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_VI",
      "@type": "akn:part",
      "eli:number": "VI",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_VI__cl_31",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_VI__cl_32",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_VI__cl_33"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "GENERAL Proceedings of court"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_VI__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "All proceedings involving any foreign State and its property, head of State and head of Government shall be carried out in accordance with the applicable rules of Court in Malaysia. Power to exempt"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_VI__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "The Prime Minister may, by order in the Gazette, exempt any foreign State from any of the provisions of this Act subject to any condition or restriction as he may consider necessary or expedient to impose. Power to make regulations"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_VI__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_VI__cl_33__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_VI__cl_33__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_VI__cl_33__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_VI__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "The Prime Minister may make such regulations as may be expedient or necessary for giving the full effect or the better carrying out of the provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_VI__cl_33__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_VI__cl_33__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_VI__cl_33__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_VI__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to the generality of subsection (1), the Prime Minister may make regulations for the following subject matter:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_VI__cl_33__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_VI__cl_33__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe the manner for the application of a certificate or document and the issuance of any official certificate or document relating to foreign State immunity; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_VI__cl_33__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_VI__cl_33__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe the method or procedure of communication with foreign State relating to a foreign State immunity."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_V__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Prime Minister is satisfied that Malaysia would not receive, in any foreign State, any immunity corresponding to those conferred by Malaysia under this Act, the Prime Minister may, by order published in the Gazette, withdraw all or any of immunity under this Act against that foreign State."
      }
    }
  ]
}
