      "schema:text": {
        "@language": "en",
        "@value": "Restriction of immunity from jurisdiction Restriction of immunity in proceedings arising out of commercial transaction"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_10__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_10__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III",
      "schema:text": {
        "@language": "en",
        "@value": "A foreign State, the head of State and the head of Government shall not be immune from the jurisdiction of the court in any proceedings relating to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/eng@/~part_II__chp_III__cl_10__para_a",
