        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_II__cl_7__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu Negara asing, seseorang ketua Negara dan seseorang ketua Kerajaan hendaklah disifatkan telah mengetepikan kekebalan mereka daripada bidang kuasa mahkamah jika mana-mana daripada mereka—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_II__cl_7__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah secara nyata bersetuju dengan penjalanan bidang kuasa mahkamah;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_II__cl_7__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah patuh kepada bidang kuasa mahkamah;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_II__cl_7__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah memulakan, mencelah atau mengambil apa-apa langkah dalam prosiding mahkamah; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_II__cl_7__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah memfailkan apa-apa tuntutan balas yang timbul daripada hubungan di sisi undang-undang atau fakta yang sama dengan tuntutan prinsipal dalam mana-mana mahkamah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_II__cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_II__cl_7__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_II__cl_7__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (1), sesuatu Negara asing, seseorang ketua Negara dan seseorang ketua Kerajaan tidak disifatkan telah mengetepikan kekebalan mereka daripada bidang kuasa mahkamah jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_II__cl_7__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_II__cl_7__subsec_2__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_II__cl_7__subsec_2__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_II__cl_7__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Negara asing, ketua Negara dan ketua Kerajaan itu, memasukkan kehadiran, mencelah atau mengambil apa-apa langkah lain dalam sesuatu prosiding di hadapan mahkamah hanya bagi maksud—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_II__cl_7__subsec_2__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_II__cl_7__subsec_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "memohon kekebalan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_II__cl_7__subsec_2__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_II__cl_7__subsec_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "menuntut hak atau kepentingan dalam harta yang menjadi isu dalam prosiding; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_II__cl_7__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_II__cl_7__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Negara asing itu atau wakilnya, ketua Negara atau ketua Kerajaan itu hadir sebagai saksi dalam mana-mana mahkamah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_II__cl_7__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud perenggan 1(a), mana-mana peruntukan dalam perjanjian yang dibuat oleh sesuatu Negara asing, seseorang ketua Negara atau seseorang ketua Kerajaan yang memperuntukkan bahawa perjanjian itu hendaklah tertakluk kepada dan ditafsirkan mengikut undang-undang Malaysia tidak boleh ditafsirkan sebagai persetujuan kepada penjalanan bidang kuasa mahkamah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_I__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_I__cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_I__cl_5__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_I__cl_5__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_I",
      "schema:name": {
        "@language": "ms",
        "@value": "Tertakluk kepada Bab II dan III Bahagian ini dan Bahagian III,—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_I__cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_I__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "sesuatu Negara asing berkenaan dengan dirinya sendiri atas kapasiti rasminya dan hartanya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_I__cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_I__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang ketua Negara atas kapasiti rasminya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_I__cl_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_I__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang ketua Kerajaan atas kapasiti rasminya, hendaklah menikmati kekebalan daripada bidang kuasa mahkamah dan tiada prosiding boleh dimulakan terhadap mereka oleh mana-mana pihak. Prosiding terhadap Negara asing, ketua Negara dan ketua Kerajaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_I__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_I__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_I__cl_6__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_I__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_I__cl_6__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_I__cl_6__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_I__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu prosiding di hadapan mana-mana mahkamah hendaklah disifatkan telah dimulakan terhadap sesuatu Negara asing dan hartanya, jika Negara asing itu dan hartanya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_I__cl_6__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_I__cl_6__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dinamakan sebagai pihak kepada prosiding itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_I__cl_6__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_I__cl_6__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak dinamakan sebagai pihak kepada prosiding tetapi prosiding itu memberikan kesan yang menyentuh harta, hak, kepentingan atau aktiviti Negara asing itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_I__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_I__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu prosiding di hadapan mana-mana mahkamah hendaklah disifatkan telah dimulakan terhadap seseorang ketua Negara atau seseorang ketua Kerajaan jika ketua Negara atau ketua Kerajaan itu dinamakan sebagai pihak kepada prosiding itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_20",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_21",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_22",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_23",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_24",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_25",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_26",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_27",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_28",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_29"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "MAJLIS KEKEBALAN NEGARA ASING Penubuhan Majlis Kekebalan Negara Asing"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu majlis dengan nama Majlis Kekebalan Negara Asing ditubuhkan. Fungsi Majlis"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_21__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_21__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_21__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_21__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis hendaklah mempunyai fungsi yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_21__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menimbang teliti dan memutuskan semua perkara berkenaan dengan kekebalan Negara asing yang timbul daripada pelaksanaan Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_21__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengeluarkan dasar, garis panduan dan surat arahan kepada agensi Kerajaan bagi maksud Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_21__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengawasi pelaksanaan dasar, garis panduan dan surat arahan oleh agensi Kerajaan mengenai perkara yang berhubungan dengan pelaksanaan Akta ini; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_21__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk melakukan apa-apa perkara lain yang timbul atau berbangkit daripada fungsi Majlis di bawah Akta ini yang konsisten dengan maksud Akta ini. Kuasa Majlis"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_22__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_22__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_22__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_22__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis hendaklah mempunyai kuasa dan boleh melakukan segala perkara yang perlu bagi atau berkaitan dengan atau bersampingan dengan, pelaksanaan fungsinya di bawah Akta ini termasuk—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_22__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memperakui secara bertulis apa-apa fakta yang berhubungan dengan persoalan sama ada sesuatu negara atau seseorang, mengikut mana-mana yang berkenaan, ialah sesuatu Negara asing, seseorang ketua Negara atau seseorang ketua Kerajaan mengikut pengertian Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_22__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memperakui secara bertulis apa-apa perkara yang berhubungan dengan kekebalan Negara asing;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_22__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengawal dan menyelaras agensi Kerajaan yang berhubungan dengan penyampaian apa-apa kertas kausa atau dokumen lain yang timbul daripada mana-mana prosiding; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_22__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk melantik apa-apa jawatankuasa yang difikirkan perlu dan suai manfaat oleh Majlis untuk membantu Majlis dalam melaksanakan mana-mana fungsinya dan dalam penjalanan kuasanya. Keanggotaan Majlis"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_23",
      "@type": "akn:clause",
