        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_13",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_14",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_15",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_16"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Had kekebalan daripada bidang kuasa Had kekebalan dalam prosiding yang timbul daripada transaksi komersial"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_10__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_10__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu Negara asing, seseorang ketua Negara dan seseorang ketua Kerajaan tidak kebal daripada bidang kuasa mahkamah dalam mana-mana prosiding yang berhubungan dengan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_10__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa kematian atau kecederaan diri; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_10__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa kerosakan kepada harta, yang berlaku di Malaysia. Had kekebalan dalam prosiding yang berhubungan dengan penentuan hak, dsb., terhadap harta"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_11__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_11__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_11__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu Negara asing tidak kebal daripada bidang kuasa mahkamah dalam mana-mana prosiding untuk menentukan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_11__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa hak, kepentingan atau obligasi Negara asing itu dalam harta tidak alih yang berada di Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_11__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa hak, kepentingan atau obligasi Negara asing dalam harta alih atau tidak alih yang timbul daripada pewarisan, hadiah atau bona vacantia; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_11__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa hak, kepentingan atau obligasi Negara asing dalam pentadbiran harta seperti harta amanah, estet seorang bankrap atau harta syarikat apabila syarikat itu digulung. Had kekebalan dalam prosiding yang berhubungan dengan harta intelek, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_12__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_12__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu Negara asing tidak kebal daripada bidang kuasa mahkamah dalam mana-mana prosiding yang berhubungan dengan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_12__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "penentuan apa-apa hak Negara asing dalam sesuatu paten, reka bentuk industri, nama dagang atau nama perniagaan, cap dagang, hak cipta, petunjuk geografi, reka bentuk susun atur litar bersepadu atau apa-apa bentuk lain harta intelek atau industri; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_12__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu dakwaan pelanggaran oleh Negara asing, terhadap hak daripada jenis yang disebut dalam perenggan (a) yang dimiliki oleh pihak ketiga dan dilindungi, didaftarkan atau diberikan di Malaysia. Had kekebalan dalam prosiding yang berhubungan dengan penyertaan dalam syarikat, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_13__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_13__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_13__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu Negara asing tidak kebal daripada bidang kuasa mahkamah dalam mana-mana prosiding yang berhubungan dengan penyertaannya dalam sesuatu syarikat atau badan kolektif yang lain, sama ada diperbadankan atau tidak diperbadankan, yang merupakan prosiding berkenaan dengan hubungan antara Negara asing itu dengan syarikat atau badan kolektif lain itu atau peserta lain dalam syarikat atau badan kolektif itu, dengan syarat syarikat atau badan kolektif lain itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_13__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_13__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mempunyai peserta selain Negara asing itu atau organisasi antarabangsa; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_13__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_13__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "diperbadankan atau ditubuhkan, mengikut mana-mana yang berkenaan, di bawah undang-undang Malaysia atau mempunyai alamat berdaftar atau tempat perniagaan utamanya di Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (1), kekebalan yang dinikmati oleh Negara asing itu tidak terjejas jika Negara asing itu dan pihak-pihak kepada pertikaian telah bersetuju untuk tidak tertakluk kepada bidang kuasa mahkamah atau surat cara yang menubuhkan atau mengawal selia syarikat atau badan kolektif itu, mengikut mana-mana yang berkenaan, mengandungi peruntukan yang memberikan kesan sedemikian. Had Kekebalan dalam prosiding yang berhubungan dengan kapal yang dimiliki atau dikendalikan oleh Negara asing"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_14__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_14__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_14__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_14__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_14__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu Negara asing tidak kebal daripada bidang kuasa mahkamah dalam apa-apa prosiding yang berhubungan dengan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_14__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_14__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pengendalian kapal yang dimiliki atau dikendalikan oleh Negara asing itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_14__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_14__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pengangkutan kargo di atas kapal yang dimiliki atau dikendalikan oleh Negara asing itu, jika pada masa kausa tindakan berbangkit, kapal itu digunakan selain bagi maksud bukan komersial kerajaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu Negara asing boleh membuat pli semua langkah pembelaan, preskripsi dan batas liabiliti yang terpakai bagi kapal dan kargo persendirian dan pemiliknya dalam prosiding yang disebut dalam subseksyen (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_14__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_14__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_14__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_14__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (1), kekebalan bidang kuasa Negara asing tidak akan terjejas jika, pada masa itu, kapal atau kargo yang dipertikaikan itu, mengikut mana-mana yang berkenaan, merupakan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_14__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_14__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu kapal perang atau tentera laut bantuan yang digunakan hanya bagi perkhidmatan bukan komersial kerajaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_14__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_14__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu kapal yang dimiliki atau dikendalikan oleh sesuatu Negara asing dan digunakan hanya bagi perkhidmatan bukan komersial kerajaan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_14__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_14__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu kargo yang dibawa di atas kapal yang disebut dalam perenggan (a), atau suatu kargo yang dimiliki oleh Negara asing itu dan digunakan atau dihasratkan digunakan semata-mata bagi maksud bukan komersial kerajaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_14__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika dalam sesuatu prosiding timbul persoalan yang berhubungan dengan sifat bukan komersial kerajaan bagi sesebuah kapal yang dimiliki atau dikendalikan oleh sesuatu Negara asing atau kargo yang dimiliki oleh Negara asing, suatu perakuan yang ditandatangani oleh wakil diplomatik atau pihak berkuasa yang berwibawa yang lain bagi Negara asing itu dan dikemukakan kepada mahkamah hendaklah menjadi keterangan mengenai sifat kapal atau kargo itu. Had kekebalan dalam prosiding yang berhubungan dengan mendapatkan balik cukai"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_15__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_15__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_15__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu Negara asing, seseorang ketua Negara dan seseorang ketua Kerajaan tidak kebal daripada bidang kuasa mahkamah dalam apa-apa prosiding yang berhubungan dengan mendapatkan balik cukai yang dikuatkuasakan di bawah mana-mana undang-undang bertulis."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini, “cukai” termasuklah apa-apa caj, duti, eksais, ses, dues atau impos wajib yang lain yang dikenakan di bawah mana-mana undang-undang bertulis. Had kekebalan jika ada perjanjian mengenai timbang tara"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_16__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_16__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_16__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika wujud suatu perjanjian antara sesuatu Negara asing, seseorang ketua Negara atau seseorang ketua Kerajaan dengan mana-mana orang untuk mengemukakan kepada timbang tara di Malaysia apa-apa pertikaian yang berhubungan dengan transaksi komersial, Negara asing, ketua Negara atau ketua Kerajaan itu tidak kebal daripada bidang kuasa mahkamah dalam mana-mana prosiding yang berhubungan dengan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_16__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "kesahan, tafsiran atau pemakaian perjanjian timbang tara;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_16__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "tatacara timbang tara; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_16__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "pengesahan atau mengetepikan award."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_8__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_8__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_8__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu Negara asing tidak kebal daripada bidang kuasa mahkamah dalam apa-apa prosiding yang timbul daripada transaksi komersial yang dijalankan oleh Negara asing itu dengan mana-mana orang di Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_8__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_8__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (1), kekebalan yang dinikmati oleh Negara asing tidak terjejas jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_8__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_8__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pihak-pihak kepada transaksi komersial itu telah secara nyata bersetuju bahawa Negara asing itu tidak tertakluk kepada bidang kuasa mahkamah; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_8__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_8__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "transaksi komersial itu adalah antara Negara asing."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_8__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_8__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_8__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika sesuatu perusahaan Negara asing atau entiti lain yang ditubuhkan oleh sesuatu Negara asing yang mempunyai keperibadian undang-undang yang bebas dan berupaya untuk—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_8__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_8__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "membawa guaman atau dibawa guaman; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_8__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_8__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "memperoleh, memiliki atau memegang dan melupuskan harta, termasuk harta yang Negara asing itu telah memberikan kebenaran kepadanya untuk mengendalikan atau menguruskan, terlibat dalam suatu prosiding yang berhubungan dengan transaksi komersial yang entiti itu terlibat, kekebalan yang dinikmati oleh Negara asing itu tidak terjejas."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_8__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang Ketua Negara dan ketua Kerajaan tidak kebal daripada bidang kuasa mahkamah dalam apa-apa prosiding yang timbul daripada transaksi komersial yang dijalankan olehnya dengan mana-mana orang di Malaysia dalam kapasiti peribadinya. Had kekebalan dalam prosiding yang berhubungan dengan kontrak kerja"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_9__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_9__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu Negara asing tidak kebal daripada bidang kuasa mahkamah dalam mana-mana prosiding yang berhubungan dengan kontrak kerja antara Negara asing dengan orang perseorangan bagi apa-apa kerja yang dilaksanakan atau akan dilaksanakan, secara keseluruhan atau sebahagiannya, di Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_9__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_9__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_9__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_9__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_9__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_9__subsec_2__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (1), kekebalan yang dinikmati oleh Negara asing itu tidak terjejas jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_9__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_9__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pekerja itu telah direkrut untuk melaksanakan fungsi tertentu dalam penjalanan kuasa kerajaan Negara asing itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_9__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_9__subsec_2__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_9__subsec_2__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_9__subsec_2__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_9__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pekerja itu merupakan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_9__subsec_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_9__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "agen diplomatik atau pegawai konsular masing-masing sebagaimana yang ditakrifkan dalam Akta Keistimewaan Diplomatik (Konvensyen Vienna) 1966 [Akta 636] dan Akta Hubungan Konsular (Konvensyen Vienna) 1999 [Akta 595];"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_9__subsec_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_9__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "anggota kakitangan diplomatik sesuatu misi tetap kepada organisasi antarabangsa atau misi khas, atau yang direkrut untuk mewakili Negara asing di persidangan antarabangsa; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_9__subsec_2__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_9__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang yang menikmati kekebalan diplomatik;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_9__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_9__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "hal perkara prosiding itu merupakan perekrutan, pembaharuan kerja atau pengembalian kerja seseorang individu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_9__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_9__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "hal perkara prosiding itu merupakan pemberhentian atau penamatan kerja seseorang individu dan, sebagaimana yang ditentukan oleh ketua Negara, ketua Kerajaan atau Menteri Hal Ehwal Luar Negeri bagi majikan Negara asing itu, prosiding itu akan mengganggu kepentingan keselamatan Negara asing itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_9__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_9__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pada masa prosiding itu dimulakan, pekerja itu merupakan warganegara majikan Negara asing itu melainkan jika pekerja itu merupakan pemastautin tetap Malaysia; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_9__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_9__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "majikan Negara asing itu dan pekerja itu telah bersetuju secara bertulis bahawa kekebalan yang dinikmati oleh Negara asing itu tidak terjejas, tertakluk kepada apa-apa dasar awam yang memberikan bidang kuasa mahkamah atas sebab hal perkara prosiding itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_9__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_III__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang Ketua Negara dan ketua Kerajaan tidak kebal daripada bidang kuasa mahkamah dalam apa-apa prosiding yang berhubungan dengan kontrak kerja dengan mana-mana orang di Malaysia dalam kapasiti peribadinya. Had kekebalan dalam prosiding yang berhubungan dengan tuntutan kecederaan diri, dsb."
      }
    },
