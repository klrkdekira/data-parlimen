        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_19"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "KEKEBALAN DARIPADA TINDAKAN ATAU PENGHAKIMAN TERHADAP HARTA NEGARA ASING Tindakan praperbicaraan terhadap harta Negara asing"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_17__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_17__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada tindakan praperbicaraan boleh dibawa, dimulakan atau dikekalkan terhadap harta sesuatu Negara asing di hadapan mana-mana mahkamah melainkan jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_17__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_17__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_17__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_17__para_a__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Negara asing itu telah secara nyata bersetuju dengan pengambilan tindakan itu sebagaimana yang diperuntukkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_17__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_17__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam suatu perjanjian antarabangsa;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_17__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_17__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam suatu perjanjian timbang tara atau dalam suatu kontrak bertulis; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_17__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_17__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam suatu perisytiharan di hadapan mahkamah atau dalam suatu komunikasi bertulis selepas pertikaian antara pihak-pihak timbul; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_17__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Negara asing itu telah memperuntukkan harta itu bagi menunaikan tuntutan yang menjadi matlamat prosiding itu. Penguatkuasaan penghakiman dan perintah terhadap harta Negara asing"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_18__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_18__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_18__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_18__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_18__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada penguatkuasaan penghakiman dan perintah boleh dibawa, dimulakan atau dikekalkan terhadap harta sesuatu Negara asing di hadapan mana-mana mahkamah melainkan jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_18__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_18__subsec_1__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_18__subsec_1__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_18__subsec_1__para_a__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_18__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Negara asing itu telah secara nyata bersetuju dengan pengambilan langkah itu sebagaimana yang diperuntukkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_18__subsec_1__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_18__subsec_1__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam suatu perjanjian antarabangsa;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_18__subsec_1__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_18__subsec_1__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam suatu perjanjian timbang tara atau dalam suatu kontrak bertulis; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_18__subsec_1__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_18__subsec_1__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam suatu perisytiharan di hadapan mahkamah atau dalam suatu komunikasi bertulis selepas pertikaian antara pihak-pihak timbul;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_18__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_18__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Negara asing itu telah memperuntukkan harta itu bagi menunaikan tuntutan yang menjadi matlamat prosiding itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_18__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_18__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah pun dipastikan bahawa harta itu secara khususnya telah digunakan atau dihasratkan untuk digunakan oleh Negara asing selain bagi maksud bukan komersial kerajaan dan terletak di Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_18__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_18__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_18__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_18__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_18__subsec_2__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud perenggan (1)(c), harta yang berikut tidak disifatkan sebagai harta yang secara khususnya telah digunakan atau dihasratkan untuk digunakan oleh Negara asing selain bagi maksud bukan komersial kerajaan:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_18__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_18__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "harta, termasuk apa-apa akaun bank, yang digunakan atau dihasratkan untuk digunakan dalam pelaksanaan fungsi misi diplomatik Negara asing itu atau jawatan konsularnya, misi khas, misi kepada organisasi antarabangsa atau delegasi organ organisasi antarabangsa atau kepada persidangan antarabangsa;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_18__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_18__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "harta bersifat ketenteraan atau digunakan atau dihasratkan untuk digunakan dalam pelaksanaan fungsi ketenteraan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_18__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_18__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "harta bank pusat atau pihak berkuasa kewangan lain Negara asing itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_18__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_18__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "harta yang merupakan sebahagian daripada warisan kebudayaan Negara asing itu atau sebahagian daripada arkibnya dan tidak diletakkan atau dihasratkan untuk diletakkan untuk jualan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_18__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_18__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "harta yang merupakan sebahagian daripada pameran objek saintifik, kebudayaan atau kepentingan sejarah dan tidak diletakkan atau dihasratkan untuk diletakkan untuk jualan. Kesan persetujuan kepada bidang kuasa bagi tindakan praperbicaraan atau penguatkuasaan penghakiman dan perintah terhadap harta Negara asing"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Persetujuan terhadap penjalanan bidang kuasa di bawah perenggan 7(1)(a) tidak boleh disifatkan sebagai persetujuan kepada pengambilan tindakan atau penguatkuasaan penghakiman dan perintah masing-masing di bawah seksyen 17 dan 18."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_I",
      "@type": "akn:chapter",
      "eli:number": "I",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_I__cl_5",
