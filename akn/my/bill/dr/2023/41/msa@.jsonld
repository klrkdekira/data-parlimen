      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis hendaklah terdiri daripada anggota yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_23__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Perdana Menteri sebagai Pengerusi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_23__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Timbalan Perdana Menteri sebagai Timbalan Pengerusi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_23__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri yang dipertanggungkan dengan tanggungjawab bagi undang-undang;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_23__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri yang dipertanggungkan dengan tanggungjawab bagi hal ehwal luar negeri;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_23__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri yang dipertanggungkan dengan tanggungjawab bagi pelaburan, perdagangan dan industri;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_23__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri yang dipertanggungkan dengan tanggungjawab bagi kewangan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_23__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri yang dipertanggungkan dengan tanggungjawab bagi hal ehwal dalam negeri;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_23__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri yang dipertanggungkan dengan tanggungjawab bagi sumber manusia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_23__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri yang dipertanggungkan dengan tanggungjawab bagi pengangkutan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_23__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri yang dipertanggungkan dengan tanggungjawab bagi pertahanan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_23__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri yang dipertanggungkan dengan tanggungjawab bagi perdagangan dalam negeri;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_23__para_l",
      "@type": "akn:paragraph",
      "eli:number": "l",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri yang dipertanggungkan dengan tanggungjawab bagi tanah; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_23__para_m",
      "@type": "akn:paragraph",
      "eli:number": "m",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Setiausaha Negara. Mesyuarat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_24__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_24__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_24__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_24__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis hendaklah mengadakan mesyuaratnya seberapa kerap yang perlu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_24__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Mesyuarat hendaklah diadakan pada masa dan di tempat sebagaimana yang ditentukan oleh Pengerusi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_24__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi boleh membenarkan penggunaan suatu rangkaian video secara langsung, rangkaian televisyen secara langsung atau apa-apa cara komunikasi elektronik yang lain bagi maksud apa-apa mesyuarat Majlis. Tatacara mesyuarat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_25__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_25__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_25__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_25__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_25__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi hendaklah mempengerusikan semua mesyuarat Majlis."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_25__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Pengerusi tidak hadir pada mana-mana mesyuarat Majlis, dia boleh melantik Timbalan Pengerusi untuk menggantikannya sebagai pengerusi mesyuarat itu atau, dalam ketidakhadiran Timbalan Pengerusi, mana-mana anggota Majlis yang lain, untuk menggantikannya sebagai pengerusi mesyuarat itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_25__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Kuorum Majlis ialah tujuh termasuk pengerusi mesyuarat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_25__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap anggota Majlis yang hadir berhak mendapat satu undi dan jika mengenai sesuatu persoalan untuk ditentukan oleh Majlis terdapat bilangan undi yang sama banyak, Pengerusi hendaklah mempunyai undi pemutus. Penjalanan sementara fungsi Pengerusi"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_26__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_26__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_26__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_26__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_26__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_26__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Timbalan Pengerusi hendaklah bertindak sebagai Pengerusi selama tempoh apabila—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_26__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_26__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jawatan Pengerusi kosong;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_26__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_26__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi tidak hadir bertugas atau tidak berada di Malaysia; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_26__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_26__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi, atas apa-apa sebab lain, tidak dapat menjalankan fungsinya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_26__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Timbalan Pengerusi hendaklah, dalam tempoh dia menjalankan fungsi Pengerusi di bawah seksyen ini, disifatkan sebagai Pengerusi. Majlis boleh mengundang orang lain untuk menghadiri mesyuarat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis boleh mengundang mana-mana orang yang bukan anggota Majlis untuk menghadiri mesyuaratnya bagi menasihati Majlis mengenai apa-apa perkara yang sedang dibincangkan. Tatacara"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk pada Akta ini, Majlis boleh menentukan tatacaranya sendiri. Setiausaha Majlis"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_29__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_29__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_29__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_29__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah Bahagian Hal Ehwal Undang-Undang Jabatan Perdana Menteri hendaklah menjadi Setiausaha Majlis."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_29__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_29__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_29__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "Setiausaha hendaklah bertanggungjawab—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_29__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_29__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi keseluruhan pentadbiran dan pengurusan fungsi dan hal ehwal harian Majlis; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_29__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_29__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi penjalanan apa-apa kewajipan lain sebagaimana yang diarahkan oleh Majlis."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_29__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_IV__cl_29",
      "schema:text": {
        "@language": "ms",
        "@value": "Setiausaha hendaklah, dalam menjalankan tanggungjawabnya, bertindak di bawah arahan Majlis."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_I__cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_I__cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Kekebalan Bidang Kuasa Negara Asing 2023."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_I__cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Perdana Menteri melalui pemberitahuan dalam Warta. Ketidakpakaian Akta"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_I__cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_I__cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_I",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ini tidak terpakai bagi—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_I__cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_I__cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "prosiding yang tertakluk kepada Akta Angkatan Pelawat 1960 [Akta 432]; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_I__cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_I__cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "prosiding jenayah. Undang-undang yang terpakai"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_I__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_I",
      "schema:text": {
        "@language": "ms",
        "@value": "Peruntukan Akta ini hendaklah menjadi tambahan kepada, dan tidak mengurangkan, peruntukan mana-mana undang-undang bertulis lain yang berhubungan dengan misi diplomatik, jawatan konsular, misi khas, misi organisasi antarabangsa, agen, atau delegasi organ organisasi antarabangsa atau kepada persidangan antarabangsa. Tafsiran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_I__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_I__cl_4__list_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_I__cl_4__list_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_I",
      "schema:name": {
        "@language": "ms",
        "@value": "Dalam Akta ini, melainkan jika konteksnya menghendaki makna yang lain—"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "“ketua Kerajaan” ertinya seseorang yang mengetuai kabinet atau apa-apa badan yang serupa sifatnya bagi sesuatu Negara asing; “ketua Negara” ertinya seseorang yang memegang jawatan rasmi tertinggi dalam sesuatu Negara asing; “mahkamah” ertinya mahkamah yang mempunyai bidang kuasa yang kompeten di Malaysia; “Majlis” ertinya Majlis Kekebalan Negara Asing yang ditubuhkan di bawah seksyen 20; “Negara asing” ertinya mana-mana negara atau wilayah di luar Malaysia, dan termasuklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_I__cl_4__list_1",
      "@type": "akn:list",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_I__cl_4__list_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_I__cl_4__list_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_I__cl_4__list_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_I__cl_4"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_I__cl_4__list_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_I__cl_4__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu jabatan atau pelbagai organ kerajaan sesuatu Negara asing;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_I__cl_4__list_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_I__cl_4__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu unit keanggotaan persekutuan Negara asing atau subbahagian politik Negara asing itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_I__cl_4__list_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_I__cl_4__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "agensi, badan atau entiti lain sesuatu Negara asing yang ditubuhkan di bawah suatu undang-undang bertulis atau sebaliknya oleh Negara asing itu; “transaksi komersial” ertinya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_I__cl_4__list_2",
      "@type": "akn:list",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_I__cl_4__list_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_I__cl_4__list_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_I__cl_4__list_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_I__cl_4"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_I__cl_4__list_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_I__cl_4__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa kontrak atau transaksi komersial bagi penjualan barang atau pembekalan perkhidmatan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_I__cl_4__list_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_I__cl_4__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa kontrak bagi suatu pinjaman atau transaksi lain yang bersifat kewangan, termasuk apa-apa obligasi jaminan atau tanggung rugi berkenaan dengan apa-apa pinjaman atau transaksi itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_I__cl_4__list_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_I__cl_4__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa kontrak atau transaksi yang bersifat komersial, perindustrian, perdagangan atau profesional yang lain, tetapi tidak termasuk suatu kontrak kerja."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_V",
      "@type": "akn:part",
      "eli:number": "V",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_V__cl_30",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "LAYANAN SALINGAN Penarikan balik kekebalan Negara asing apabila tiada layanan salingan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_VI",
      "@type": "akn:part",
      "eli:number": "VI",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_VI__cl_31",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_VI__cl_32",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_VI__cl_33"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "AM Prosiding mahkamah"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_VI__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua prosiding melibatkan mana-mana Negara asing dan hartanya, ketua Negara dan ketua Kerajaan hendaklah dijalankan mengikut kaedah-kaedah Mahkamah yang terpakai di Malaysia. Kuasa untuk mengecualikan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_VI__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Perdana Menteri boleh, melalui perintah dalam Warta, mengecualikan mana-mana Negara asing daripada mana-mana peruntukan Akta ini tertakluk kepada apa-apa syarat atau sekatan yang difikirkannya perlu atau suai manfaat untuk dikenakan. Kuasa untuk membuat peraturan-peraturan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_VI__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_VI__cl_33__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_VI__cl_33__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_VI__cl_33__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_VI__cl_33",
      "schema:text": {
        "@language": "ms",
        "@value": "Perdana Menteri boleh membuat peraturan-peraturan sebagaimana yang suai manfaat atau perlu bagi memberikan kuat kuasa sepenuhnya atau melaksanakan peruntukan Akta ini dengan lebih baik."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_VI__cl_33__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_VI__cl_33__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_VI__cl_33__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_VI__cl_33",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan keluasan kuasa yang diberikan oleh subseksyen (1), Perdana Menteri boleh membuat peraturan-peraturan bagi perkara yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_VI__cl_33__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_VI__cl_33__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan cara bagi permohonan perakuan atau dokumen dan pengeluaran apa-apa perakuan rasmi atau dokumen yang berhubungan dengan kekebalan sesuatu Negara asing; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_VI__cl_33__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_VI__cl_33__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan cara atau tatacara komunikasi dengan Negara asing yang berhubungan dengan kekebalan sesuatu Negara asing."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_V__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Perdana Menteri berpuas hati bahawa Malaysia tidak menerima, dalam mana-mana Negara asing, apa-apa kekebalan yang bersamaan dengan yang diberikan oleh Malaysia di bawah Akta ini, Perdana Menteri boleh, melalui perintah yang disiarkan dalam Warta, menarik balik semua atau mana-mana kekebalan di bawah Akta ini terhadap Negara asing itu."
      }
    }
  ]
}
