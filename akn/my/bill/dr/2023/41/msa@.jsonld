      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Kekebalan am daripada bidang kuasa Kekebalan Negara asing"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/41/msa@/~part_II__chp_II",
