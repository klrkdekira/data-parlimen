        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_53"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "GENERAL Compounding of offences"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XII",
      "@type": "akn:part",
      "eli:number": "XII",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XII__cl_54",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "TRANSITIONAL Transitional"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XII__cl_54",
      "@type": "akn:clause",
      "eli:number": "54",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XII__cl_54__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XII__cl_54__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XII__cl_54__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XII__cl_54",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who imports, manufactures or distributes the tobacco product, smoking substance or substitute tobacco product before the coming into operation of subsections 3(1) and 14(1) of this Act shall, within six months from the date of the coming into operation of this Act, apply to the Director General to be registered under subsection 3(1) of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XII__cl_54__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XII__cl_54",
      "schema:text": {
        "@language": "en",
        "@value": "If the Director General rejects the application for registration made under subsection 3(1), the importer, manufacturer or distributor of the tobacco product, smoking substance or substitute tobacco product shall, at its own expense, recall and stop the sale of the tobacco product, smoking substance or substitute tobacco product."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_48",
      "@type": "akn:clause",
      "eli:number": "48",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_48__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_48__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_48__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_48__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_48__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_48__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_48__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_48__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_48__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, with the approval of the Public Prosecutor, make regulations prescribing—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_48__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_48__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any offence under this Act or any regulations made under this Act as an offence which may be compounded; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_48__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_48__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the method and procedure for compounding such offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_48__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General or any authorized officer authorized by the Director General may, with the consent in writing of the Public Prosecutor, at any time before a charge is being instituted, compound any offence prescribed as an offence which may be compounded by making a written offer to the person reasonably suspected of having committed the offence to compound the offence upon payment to the Director General of a sum of money not exceeding fifty per centum of the amount of the maximum fine to which the person would have been liable to if he had been convicted of the offence, within such time as may be specified in the written offer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_48__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "An offer under subsection (2) may be made at any time after the offence has been committed but before any prosecution for it has been instituted."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_48__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "If the amount specified in the offer is not paid within the time specified in the offer, or such extended time as the Director General may grant, prosecution for the offence may be instituted at any time after that against the person to whom the offer was made."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_48__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_48__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_48__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "Where an offence has been compounded under this section—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_48__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_48__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "no prosecution shall be instituted in respect of the offence against the person to whom the offer to compound was made; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_48__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_48__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "any document or thing seized in connection with the offence may be released by the Director General, subject to such terms as the Director General thinks fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_48__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "All sums of money received by the Director General or authorized officer under this section shall be paid into and form part of the Federal Consolidated Fund. Offence by body corporate"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_49",
      "@type": "akn:clause",
      "eli:number": "49",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_49__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_49__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_49__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_49__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_49__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_49",
      "schema:text": {
        "@language": "en",
        "@value": "Where any body corporate commits an offence under this Act, a person who at the time of the commission of the offence was a director, compliance officer, partner, manager, secretary or other similar officer of the body corporate or was purporting to act in the capacity or was in any manner or to any extent responsible for the management of any of the affairs of the body corporate or other body of persons or was assisting in its management—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_49__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_49__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "may be charged severally or jointly in the same proceedings with the body corporate; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_49__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_49__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_49__subsec_1__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_49__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "if the body corporate is found guilty of the offence, shall be deemed to be guilty of that offence and shall be liable to the same punishment or penalty as an individual unless, having regard to the nature of his functions in that capacity and to all circumstances, he proves—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_49__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_49__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "that the offence was committed without his knowledge; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_49__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_49__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "that the offence was committed without his consent or connivance and that he had taken all reasonable precautions and exercised due diligence to prevent the commission of the offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_49__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_49__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_49__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_49__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_49",
      "schema:text": {
        "@language": "en",
        "@value": "Where any person would be liable under this Act to any punishment, penalty or forfeiture for any act, omission, neglect or default, he shall be liable to the same punishment, penalty or forfeiture for every such act, omission, neglect or default of the person’s employee or agent, or of the employee of the person’s agent, if the act, omission, neglect or default was committed—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_49__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_49__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "by that person’s employee in the course of his employment;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_49__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_49__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "by that person’s agent when acting on behalf of that person; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_49__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_49__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "by the employee of that person’s agent when acting in the course of his employment by the person’s agent or otherwise on behalf of the person’s agent acting on behalf of that person. Protection against suit and legal proceedings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_50",
      "@type": "akn:clause",
      "eli:number": "50",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI",
      "schema:text": {
        "@language": "en",
        "@value": "No action, suit, prosecution or other proceedings shall be brought, instituted or maintained in any court against any authorized officer on account of or in respect of any act done or omitted to be done for the purpose of carrying into effect this Act unless it can be proven that the act was done or omitted to be done in bad faith and not in a reasonable belief that it was necessary for the purpose intended to be served thereby. Indemnity"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_51",
      "@type": "akn:clause",
      "eli:number": "51",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_51__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_51__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_51__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_51",
      "schema:text": {
        "@language": "en",
        "@value": "The Government shall not be liable to make good any damage which an owner or occupier or person in charge of any premises may sustain as a result of an entry, search or seizure under this Act, unless the damage was caused by the wilful neglect or default of a public officer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_51__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_51",
      "schema:text": {
        "@language": "en",
        "@value": "In the event of any dispute as to the amount of compensation in respect of any damage so caused, the amount shall be summarily ascertained and determined by a Magistrate’s court. Delegation of powers"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_52",
      "@type": "akn:clause",
      "eli:number": "52",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_52__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_52__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_52__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_52",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General may, in writing, delegate any of the powers, duties or functions of the Director General, other than the power under section 48, to any officer under the control, direction and supervision of the Director General subject to any condition, limitation or restriction as the Director General thinks fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_52__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_52",
      "schema:text": {
        "@language": "en",
        "@value": "Any delegation under this section shall not preclude the Director General himself from performing or exercising, at any time any of the delegated powers, duties or functions. Power to make regulations"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_53",
      "@type": "akn:clause",
      "eli:number": "53",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_53__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_53__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_53__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_53__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_53",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may make regulations as may be necessary or expedient for the purpose of carrying into effect the provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_53__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_53__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_53__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_53__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_53__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_53__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_53__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_53__subsec_2__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_53__subsec_2__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_53__subsec_2__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_53__subsec_2__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_53__subsec_2__para_k"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_53",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to the generality of subsection (1), the Minister may prescribe—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_53__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_53__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "all matters relating to the manner of application, cancellation, suspension or withdrawal of the registration of a tobacco product, smoking substance or substitute tobacco product;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_53__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_53__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "all matters relating to particulars to be provided by an applicant, the manner of approval, the terms, conditions and restrictions of the registration to be imposed on the applicant;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_53__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_53__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "all fees required by this Act to be prescribed;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_53__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_53__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "all matters relating to prohibition on the advertisement of tobacco product, smoking substance or substitute tobacco product;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_53__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_53__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "all matters relating to prohibition on the promotion or sponsorship of tobacco product, smoking substance or substitute tobacco product;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_53__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_53__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "all matters relating to restriction and prohibition on the sale of tobacco product, smoking substance or substitute tobacco product;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_53__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_53__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "all matters relating to the retail price or minimum selling price of tobacco product, smoking substance or substitute tobacco product;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_53__subsec_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_53__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "all matters relating to packaging and labelling of tobacco product, smoking substance or substitute tobacco product;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_53__subsec_2__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_53__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "all matters relating to non-smoking area or place;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_53__subsec_2__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_53__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "all matters relating to the procedure of taking and dealing with the sample and analysis; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_53__subsec_2__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_53__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "any other matters required by this Act to be prescribed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_53__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_53",
      "schema:text": {
        "@language": "en",
        "@value": "Any regulations made under subsection (1) may prescribe any act or omission in contravention of the regulations to be an offence and may prescribe penalties of a fine not exceeding two hundred thousand ringgit or to imprisonment for a term not exceeding ten years or to both for the offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_X__cl_41",
      "@type": "akn:clause",
      "eli:number": "41",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_X",
      "schema:text": {
        "@language": "en",
        "@value": "No prosecution for or in relation to any offence under this Act or any regulations made under this Act shall be instituted except by or with the written consent of the Public Prosecutor. Advance notice of expert evidence in court"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_X__cl_42",
      "@type": "akn:clause",
      "eli:number": "42",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_X",
      "schema:text": {
        "@language": "en",
        "@value": "In any proceedings for an offence under this Act, no expert evidence shall be received in evidence unless, within a period ending ten clear days before the trial, the person charged with the offence has served on the prosecution notice in writing that he intends to adduce expert evidence, and shall disclose in the notice the name of the expert and the nature of the expert evidence, and shall also furnish a copy of any document that the expert proposes to adduce at the hearing. Jurisdiction to try offences"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_X__cl_43",
      "@type": "akn:clause",
      "eli:number": "43",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_X",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding any written law to the contrary, a court of a First Class Magistrate shall have jurisdiction to try any offence under this Act and to impose punishment under this Act for any such offence. Protection of informer"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_X__cl_44",
      "@type": "akn:clause",
      "eli:number": "44",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_X__cl_44__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_X__cl_44__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_X__cl_44__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_X__cl_44__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_X__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "Except as provided in subsections (2) and (3), no witness in any civil or criminal proceedings shall be obliged or permitted to disclose the name, address or any information of an informer, or the substance of the information received from him, or state any matter which might lead to the discovery of the informer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_X__cl_44__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_X__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "If any books, records, accounts, documents or computerized data which are produced in evidence or liable to inspection in any civil or criminal proceedings contain any entry in which any informer is named or described or which might lead to his discovery, the court shall cause all the passages to be concealed from view or to be obliterated so far only as may be necessary to protect the informer from discovery."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_X__cl_44__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_X__cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "If in the trial for any offence under this Act, the court, after full enquiry into the case believes that the informer wilfully made in his complaint a material statement which he knew to be false or did not believe to be true, or if in any other proceedings the court is of the opinion that justice cannot be fully done between the parties in those proceedings without the discovery of the informer, it shall be lawful for the court to require the production of the original complaint, if in writing, and permit enquiry and require full disclosure, concerning the informer. Evidence of agent provocateur admissible"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_X__cl_45",
      "@type": "akn:clause",
      "eli:number": "45",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_X__cl_45__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_X__cl_45__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_X__cl_45__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_X__cl_45",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding any rule of law or the provisions of this Act or any other written law to the contrary, no agent provocateur shall be presumed to be unworthy of credit by reason only of him having attempted to abet or abetted the commission of an offence by any person under this Act if the attempt to abet or abetment was for the sole purpose of securing evidence against such person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_X__cl_45__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_X__cl_45",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding any rule of law or this Act or any other written law to the contrary, and that the agent provocateur is an authorized officer, any statement, whether oral or in writing, made to an agent provocateur by any person who subsequently is charged with an offence under this Act shall be admissible as evidence at his trial. Non-disclosure of information"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_X__cl_46",
      "@type": "akn:clause",
      "eli:number": "46",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_X__cl_46__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_X__cl_46__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_X",
      "schema:text": {
        "@language": "en",
        "@value": "Nothing in this Act or in any regulations made under this Act shall require any authorized officer to disclose facts or to produce documents which he considers—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_X__cl_46__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_X__cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "to be against the public interest to disclose or produce; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_X__cl_46__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_X__cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "would compromise the protection of a witness. Power to order appearance in court"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_X__cl_47",
      "@type": "akn:clause",
      "eli:number": "47",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_X__cl_47__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_X__cl_47__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_X__cl_47__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_X__cl_47__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_X__cl_47",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Director General or any authorized officer has reasonable grounds for believing that any person committed an offence under this Act, he may, in lieu of applying to the court for a summons, forthwith serve upon that person a notice ordering that person to appear before the nearest court of a Magistrate having jurisdiction to try the offence, at a time and date to be stated in the notice."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_X__cl_47__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_X__cl_47",
      "schema:text": {
        "@language": "en",
        "@value": "If any person who was served with a notice as provided by subsection (1) fails to appear in person or by counsel, the court may, if satisfied that the notice was served, issue a warrant for the arrest of that person unless it appears that it was not reasonably possible for that person so to appear."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_X__cl_47__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_X__cl_47",
      "schema:text": {
        "@language": "en",
        "@value": "The notice under subsection (1) shall be as prescribed."
      }
    }
  ]
}
