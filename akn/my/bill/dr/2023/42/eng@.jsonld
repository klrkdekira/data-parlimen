      "schema:text": {
        "@language": "en",
        "@value": "where the person is a body corporate—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_III__cl_8__subsec_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_III__cl_8__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "for the first offence, be liable to a fine not less than ten thousand ringgit and not exceeding fifty thousand ringgit or to imprisonment for a term not exceeding one year or to both; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_III__cl_8__subsec_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
