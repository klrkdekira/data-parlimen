        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VII__cl_19",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VII__cl_20"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "LIABILITY OF MANUFACTURER, IMPORTER OR DISTRIBUTOR Presumption of matters related to labelling and packaging"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII",
      "@type": "akn:part",
      "eli:number": "VIII",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_21",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_22",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_23",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_24"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "ADMINISTRATION Acute or critical situation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_21__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_21__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_21__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_21__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, upon the advice of the Director General that there is acute or critical situation relating to the use or consumption of any tobacco product, smoking substance or substitute tobacco product that may seriously endangers lives, health or safety of any population in any part of the country, establish a committee, as soon as reasonably practicable, to coordinate and advise him on the matter."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_21__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "If the Minister is satisfied that there is an acute or critical situation that seriously endangers lives, health or safety of population, the Minister may, on the recommendation of the committee established under subsection (1), by order published in the Gazette, prohibit or restrict, subject to any conditions he deems fit, the importation, manufacturing, distribution or selling of the tobacco product, smoking substance or substitute tobacco product."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_21__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_21__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_21__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (2) commits an offence and shall, on conviction—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_21__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_21__subsec_3__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_21__subsec_3__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_21__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "where the person is not a body corporate—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_21__subsec_3__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_21__subsec_3__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "for the first offence, be liable to a fine not exceeding twenty thousand ringgit or to imprisonment for a term not exceeding one year or to both; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_21__subsec_3__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_21__subsec_3__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "for the second or subsequent offence, be liable to a fine not exceeding thirty thousand ringgit or to imprisonment for a term not exceeding two years or to both; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_21__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_21__subsec_3__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_21__subsec_3__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_21__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "where the person is a body corporate—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_21__subsec_3__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_21__subsec_3__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "for the first offence, be liable to a fine not less than twenty thousand ringgit and not exceeding one hundred thousand ringgit or to imprisonment for a term not exceeding two years or to both; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_21__subsec_3__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_21__subsec_3__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "for the second or subsequent offence, be liable to a fine not less than fifty thousand ringgit and not exceeding three hundred thousand ringgit or to imprisonment for a term not exceeding three years or to both. Appointment of analysts"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_22__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_22__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_22__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may appoint any person to be an analyst for the purposes of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_22__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "The appointment of an analyst made under subsection (1) shall be published in the Gazette. Approved laboratories"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_23__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_23__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_23__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_23__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, by order published in the Gazette, approve such number of laboratories for the purposes of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_23__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "Any laboratory approved under subsection (1) shall be issued with a certificate of approval which in any legal proceedings under this Act, shall be admissible in evidence as prima facie proof of the facts stated in the certificate."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_23__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister shall prepare or cause to be prepared a list of approved laboratories and the Minister may revise the list as circumstances require. Appointment of authorized officers"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_24__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_24__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_24__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_24__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may appoint such number of authorized officer as he considers necessary for the purposes of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_24__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "Any authorized officer appointed under subsection (1) shall be issued with a certificate of authorization which in any legal proceedings under this Act, shall be admissible in evidence as prima facie proof of the facts stated in the certificate."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_24__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VIII__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "An authorized officer shall, when acting within the scope of his powers and duties under this Act, be deemed to be a public servant within the meaning of the Penal Code [Act 574]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VII__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "In any proceedings under this Act, any evidence that a package containing any tobacco product, smoking substance or substitute tobacco product and bearing the name, address or registered mark of an importer, manufacturer or distributor, or of the owner of the rights of the manufacturer, packer, or of an agent of any of them, shall be prima facie evidence that the tobacco product, smoking substance or substitute tobacco product is imported, manufactured or packed, as the case may be, by each of the persons whose name, address or the registered mark is borne on the packaging. Responsibility of manufacturer, importer or distributor"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VII__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VII__cl_20__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VII__cl_20__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VII__cl_20__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VII__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "Every manufacturer, importer or distributor of a tobacco product, smoking substance or substitute tobacco product shall provide any information as determined by the Director General or any authorized officer in relation to the tobacco product, smoking substance or substitute tobacco product."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VII__cl_20__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VII__cl_20__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VII__cl_20__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VII__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) commits an offence and shall, on conviction—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VII__cl_20__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VII__cl_20__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "where the person is not a body corporate, be liable to a fine not exceeding ten thousand ringgit or to imprisonment for a term not exceeding one year or to both; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VII__cl_20__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VII__cl_20__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "where the person is a body corporate, be liable to a fine not less than ten thousand ringgit and not exceeding fifty thousand ringgit or to imprisonment for a term not exceeding one year or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VI__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VI__cl_16__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VI__cl_16__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VI__cl_16__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VI__cl_16__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VI__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, by order published in the Gazette and subject to any condition as he deems fit, declare any building or part of the building, a place or part of the place, or any area or vehicle, where public have access as a non-smoking area or place."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VI__cl_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VI__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall smoke at the non-smoking area or place as declared by the Minister under subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VI__cl_16__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VI__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (2) commits an offence and shall, on conviction, be liable to a fine not exceeding five thousand ringgit. Prohibition of smoking, etc., of tobacco product, etc., on minor"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VI__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VI__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VI__cl_17__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VI__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VI__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "No person who is a minor shall smoke, chew or use in any manner whatsoever any tobacco product, or smoke any substitute tobacco product."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VI__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VI__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) commits an offence and shall, on conviction, be liable to a fine not exceeding five hundred ringgit or be ordered to perform community service pursuant to the Criminal Procedure Code or the Child Act 2001. Duty of proprietor of the building, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VI__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VI__cl_18__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VI__cl_18__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VI__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VI__cl_18__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VI__cl_18__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VI__cl_18__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VI__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "The proprietor or occupier of any non-smoking area or place declared under section 16—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VI__cl_18__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VI__cl_18__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "shall display a warning sign of prohibition of smoking in the form as prescribed;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VI__cl_18__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VI__cl_18__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "shall not provide any smoking equipment or facilities or any method intended to encourage any person to smoke; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VI__cl_18__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VI__cl_18__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "shall take all reasonable measures as determined by the Director General to prevent any person from smoking in the building or vehicle, or at the place or area."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VI__cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VI__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) commits an offence and shall, on conviction, be liable to a fine not exceeding five thousand ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_14__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_14__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_14__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_14__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "The retail price or minimum selling price of any tobacco product, smoking substance or substitute tobacco product shall be in accordance with the price and conditions as prescribed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "Any application by any manufacturer or importer to determine the retail price or minimum selling price of any tobacco product, smoking substance or substitute tobacco product shall be made to the Director General in the manner as prescribed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_14__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "The price prescribed under subsection (1) shall include any excise duty or other related tax."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_14__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall sell any tobacco product, smoking substance or substitute tobacco product not in accordance with the price and conditions prescribed under subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_14__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_14__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_14__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes this section commits an offence and shall, on conviction—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_14__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_14__subsec_5__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_14__subsec_5__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_14__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "where the person is not a body corporate—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_14__subsec_5__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_14__subsec_5__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "for the first offence, be liable to a fine not exceeding twenty thousand ringgit or to imprisonment for a term not exceeding one year or to both; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_14__subsec_5__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_14__subsec_5__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "for the second or subsequent offence, be liable to a fine not exceeding thirty thousand ringgit or to imprisonment for a term not exceeding two years or to both; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_14__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_14__subsec_5__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_14__subsec_5__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_14__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "where the person is a body corporate—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_14__subsec_5__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_14__subsec_5__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "for the first offence, be liable to a fine not less than twenty thousand ringgit and not exceeding one hundred thousand ringgit or to imprisonment for a term not exceeding two years or to both; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_14__subsec_5__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_14__subsec_5__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "for the second or subsequent offence, be liable to a fine not less than fifty thousand ringgit and not exceeding three hundred thousand ringgit or to imprisonment for a term not exceeding three years or to both. Packaging and labelling"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_15__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_15__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_15__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall manufacture, import or distribute any tobacco product, smoking substance or substitute tobacco product unless the tobacco product, smoking substance or substitute tobacco product is packaged and labelled in accordance with the requirement as prescribed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_15__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_15__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) commits an offence and shall, on conviction—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_15__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_15__subsec_2__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_15__subsec_2__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_15__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "where the person is not a body corporate—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_15__subsec_2__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_15__subsec_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "for the first offence, be liable to a fine not exceeding twenty thousand ringgit or to imprisonment for a term not exceeding one year or to both; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_15__subsec_2__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_15__subsec_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "for the second or subsequent offence, be liable to a fine not exceeding thirty thousand ringgit or to imprisonment for a term not exceeding two years or to both; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_15__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_15__subsec_2__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_15__subsec_2__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_15__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "where the person is a body corporate—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_15__subsec_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_15__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "for the first offence, be liable to a fine not less than twenty thousand ringgit and not exceeding one hundred thousand ringgit or to imprisonment for a term not exceeding two years or to both; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_15__subsec_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_V__cl_15__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "for the second or subsequent offence, be liable to a fine not less than fifty thousand ringgit and not exceeding three hundred thousand ringgit or to imprisonment for a term not exceeding three years or to both."
      }
    },
    {
