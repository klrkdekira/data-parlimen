      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "CONTROL OF SALE Prohibition of sale of tobacco product, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_IV__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_IV__cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_IV__cl_10__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_IV__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_IV__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall sell or display for sale any tobacco product, smoking substance or substitute tobacco product unless the sale or display for sale complies with the requirement as prescribed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_IV__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_IV__cl_10__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_IV__cl_10__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_IV__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) commits an offence and shall, on conviction—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_IV__cl_10__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_IV__cl_10__subsec_2__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_IV__cl_10__subsec_2__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_IV__cl_10__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "where the person is not a body corporate—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_IV__cl_10__subsec_2__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_IV__cl_10__subsec_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "for the first offence, be liable to a fine not exceeding twenty thousand ringgit or to imprisonment for a term not exceeding one year or to both; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_IV__cl_10__subsec_2__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_IV__cl_10__subsec_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "for the second or subsequent offence, be liable to a fine not exceeding thirty thousand ringgit or to imprisonment for a term not exceeding two years or to both; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_IV__cl_10__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_IV__cl_10__subsec_2__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_IV__cl_10__subsec_2__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_IV__cl_10__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "where the person is a body corporate—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_IV__cl_10__subsec_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_IV__cl_10__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "for the first offence, be liable to a fine not less than twenty thousand ringgit and not exceeding one hundred thousand ringgit or to imprisonment for a term not exceeding two years or to both; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_IV__cl_10__subsec_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_IV__cl_10__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "for the second or subsequent offence, be liable to a fine not less than fifty thousand ringgit and not exceeding three hundred thousand ringgit or to imprisonment for a term not exceeding three years or to both. Prohibition of sale of imitation of tobacco product, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_IV__cl_11",
