      "schema:text": {
        "@language": "en",
        "@value": "CONTROL OF PRICE, PACKAGING, LABELLING, MANUFACTURING, ETC. Retail price or minimum selling price"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VI",
      "@type": "akn:part",
      "eli:number": "VI",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VI__cl_16",
