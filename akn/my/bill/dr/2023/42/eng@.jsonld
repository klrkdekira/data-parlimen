        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_III__cl_7__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_III__cl_7__subsec_1__para_f"
