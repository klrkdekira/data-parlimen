      "eli:number": "XI",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_48",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_49",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_XI__cl_50",
