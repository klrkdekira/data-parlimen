      "schema:text": {
        "@language": "en",
        "@value": "PROHIBITION OF SMOKING Non-smoking area or place"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_VII",
      "@type": "akn:part",
      "eli:number": "VII",
