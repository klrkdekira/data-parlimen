      "schema:text": {
        "@language": "en",
        "@value": "for the second or subsequent offence, be liable to a fine not less than thirty thousand ringgit and not exceeding two hundred thousand ringgit or to imprisonment for a term not exceeding two years or to both. Prohibition on promotion or sponsorship of tobacco product, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_III__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_III__cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_III__cl_9__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_III__cl_9__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_III__cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_III__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall promote or sponsor, or participate in any arrangement that promotes any tobacco product, smoking substance or substitute tobacco product, which is intended or likely to encourage any person to smoke or to be promoted as a quit smoking product."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_III__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_III__cl_9__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_III__cl_9__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_III__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this section, “arrangement” includes any agreement, undertaking or understanding that has or likely to have effects of promoting any tobacco product, smoking substance or substitute tobacco product—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_III__cl_9__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_III__cl_9__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "by giving or accepting any sponsorship, gift, prize, reward, scholarship or other like benefit; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_III__cl_9__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_III__cl_9__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "by organising any campaign, course, workshop, forum, road show, consultation or event."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_III__cl_9__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_III__cl_9__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_III__cl_9__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_III__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) commits an offence and shall, on conviction—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_III__cl_9__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_III__cl_9__subsec_3__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_III__cl_9__subsec_3__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_III__cl_9__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "where the person is not a body corporate—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_III__cl_9__subsec_3__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_III__cl_9__subsec_3__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "for the first offence, be liable to a fine not exceeding twenty thousand ringgit or to imprisonment for a term not exceeding one year or to both; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_III__cl_9__subsec_3__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_III__cl_9__subsec_3__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "for the second or subsequent offence, be liable to a fine not exceeding thirty thousand ringgit or to imprisonment for a term not exceeding two years or to both; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_III__cl_9__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_III__cl_9__subsec_3__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_III__cl_9__subsec_3__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_III__cl_9__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "where the person is a body corporate—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_III__cl_9__subsec_3__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_III__cl_9__subsec_3__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "for the first offence, be liable to a fine not less than twenty thousand ringgit and not exceeding one hundred thousand ringgit or to imprisonment for a term not exceeding two years or to both; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_III__cl_9__subsec_3__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_III__cl_9__subsec_3__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "for the second or subsequent offence, be liable to a fine not less than fifty thousand ringgit and not exceeding three hundred thousand ringgit or to imprisonment for a term not exceeding three years or to both."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_3__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "No tobacco product, smoking substance or substitute tobacco product shall be imported, manufactured or distributed by any person unless registered under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_3__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_3__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) commits an offence and shall, on conviction—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_3__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_3__subsec_2__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_3__subsec_2__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_3__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "where the person is not a body corporate—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_3__subsec_2__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_3__subsec_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "for the first offence, be liable to a fine not exceeding twenty thousand ringgit or to imprisonment for a term not exceeding one year or to both; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_3__subsec_2__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_3__subsec_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "for the second or subsequent offence, be liable to a fine not exceeding thirty thousand ringgit or to imprisonment for a term not exceeding two years or to both; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_3__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_3__subsec_2__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_3__subsec_2__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_3__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "where the person is a body corporate—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_3__subsec_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_3__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "for the first offence, be liable to a fine not less than twenty thousand ringgit and not exceeding one hundred thousand ringgit or to imprisonment for a term not exceeding two years or to both; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_3__subsec_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_3__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "for the second or subsequent offence, be liable to a fine not less than fifty thousand ringgit and not exceeding three hundred thousand ringgit or to imprisonment for a term not exceeding three years or to both. Application for registration"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_4__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_4__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_4__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_4__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_4__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "An application for the registration of a tobacco product, smoking substance or substitute tobacco product shall be made by the applicant to the Director General in the manner as prescribed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "The application made under subsection (1) may be withdrawn at any time by the applicant prior to any approval by the Director General."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_4__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "Every application under subsection (1) shall be accompanied by the fee as prescribed and any document or information as determined by the Director General."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_4__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "At any time after receiving an application under subsection (1), the Director General may, in writing, require the applicant to provide any additional information, particulars or document within any period specified by the Director General."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_4__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "If the applicant fails to comply with the request made under subsection (4) within the period specified in the request or any extension of time granted by the Director General, the application shall be deemed to be withdrawn without affecting the right of the applicant to make a fresh application."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_4__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "Upon approval of the application made under subsection (1), the Director General may impose any condition as he deems fit and the Director General may vary or revoke any of the condition imposed. Cancellation of registration"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_5__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_5__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_5__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_5__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_5__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subsection (2), the Director General may cancel any approval of the registration made under section 4 if the applicant—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_5__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "has contravened any provision of this Act or any regulations made under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_5__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "has breached any condition of the registration; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_5__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "has been convicted of any offence under this Act or any regulations made under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General shall, by notice in writing, before cancelling any approval of any tobacco product, smoking substance or substitute tobacco product under subsection (1), give an opportunity to the applicant to make any representation in writing against the cancellation, and pending the decision, all importation, manufacturing or distribution of the tobacco product, smoking substance or substitute tobacco product shall be suspended from the date of the receipt of the notice."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_5__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_5__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_5__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "Any applicant whose registration of tobacco product, smoking substance or substitute tobacco product has been cancelled under subsection (1) or be suspended under subsection (2) shall not be entitled to claim any—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_5__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_5__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "compensation for any loss caused by the cancellation; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_5__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_5__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "refund of the fee paid under subsection 4(3). Register of tobacco product, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_6__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The Director General shall keep and maintain any register of tobacco product, smoking substance and substitute tobacco product registered under section 4."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The register shall be kept in any manner and shall contain any particulars as determined by the Director General."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/eng@/~part_IV__cl_10",
