      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "LIABILITI PENGILANG, PENGIMPORT ATAU PENGEDAR Anggapan perkara berkaitan dengan pelabelan dan pembungkusan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII",
      "@type": "akn:part",
      "eli:number": "VIII",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_21",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_22",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_23",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_24"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "PENTADBIRAN Situasi akut atau kritikal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_21__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_21__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_21__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_21__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, atas nasihat Ketua Pengarah bahawa terdapat situasi akut atau kritikal yang berhubungan dengan kegunaan atau penggunaan apa-apa produk tembakau, bahan merokok atau produk pengganti tembakau yang boleh secara serius membahayakan nyawa, kesihatan atau keselamatan mana-mana penduduk dalam mana-mana bahagian negara, menubuhkan suatu jawatankuasa, dengan secepat yang semunasabahnya dapat dilaksanakan, untuk menyelaras dan menasihatinya mengenai perkara itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_21__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Menteri berpuas hati bahawa terdapat situasi akut atau kritikal yang secara serius membahayakan nyawa, kesihatan atau keselamatan penduduk, Menteri boleh, atas syor jawatankuasa yang ditubuhkan di bawah subseksyen (1), melalui perintah yang disiarkan dalam Warta, melarang atau menyekat, tertakluk kepada apa-apa syarat yang difikirkannya patut, pengimportan, pengilangan, pengedaran atau penjualan produk tembakau, bahan merokok atau produk pengganti tembakau itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_21__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_21__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_21__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (2) melakukan suatu kesalahan dan boleh, apabila disabitkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_21__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_21__subsec_3__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_21__subsec_3__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_21__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "sekiranya orang itu bukan suatu pertubuhan perbadanan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_21__subsec_3__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_21__subsec_3__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi kesalahan pertama, didenda tidak melebihi dua puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi satu tahun atau kedua-duanya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_21__subsec_3__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_21__subsec_3__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi kesalahan kedua atau berikutnya, didenda tidak melebihi tiga puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi dua tahun atau kedua-duanya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_21__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_21__subsec_3__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_21__subsec_3__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_21__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "sekiranya orang itu ialah suatu pertubuhan perbadanan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_21__subsec_3__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_21__subsec_3__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi kesalahan pertama, didenda tidak kurang daripada dua puluh ribu ringgit dan tidak melebihi satu ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi dua tahun atau kedua-duanya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_21__subsec_3__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_21__subsec_3__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi kesalahan kedua atau berikutnya, didenda tidak kurang daripada lima puluh ribu ringgit dan tidak melebihi tiga ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tiga tahun atau kedua-duanya. Pelantikan juruanalisis"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_22__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_22__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_22__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh melantik mana-mana orang untuk menjadi juruanalisis bagi maksud Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_22__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "Pelantikan juruanalisis yang dibuat di bawah subseksyen (1) hendaklah disiarkan dalam Warta. Makmal yang diluluskan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_23__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_23__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_23__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_23__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, melalui perintah yang disiarkan dalam Warta, meluluskan seberapa jumlah makmal bagi maksud Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_23__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana makmal yang diluluskan di bawah subseksyen (1) hendaklah dikeluarkan suatu perakuan kelulusan yang dalam apa-apa prosiding undang-undang di bawah Akta ini, hendaklah boleh diterima dalam keterangan sebagai bukti prima facie bagi fakta yang dinyatakan dalam perakuan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_23__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri hendaklah menyediakan atau menyebabkan disediakan suatu senarai makmal yang diluluskan dan Menteri boleh mengubah senarai itu sebagaimana hal keadaan memerlukan. Pelantikan pegawai diberi kuasa"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_24__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_24__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_24__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_24__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh melantik seberapa ramai pegawai diberi kuasa sebagaimana yang difikirkannya perlu bagi maksud Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_24__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pegawai diberi kuasa yang dilantik di bawah subseksyen (1) hendaklah dikeluarkan suatu perakuan pemberian kuasa yang dalam apa-apa prosiding undang-undang di bawah Akta ini, boleh diterima dalam keterangan sebagai bukti prima facie bagi fakta yang dinyatakan dalam perakuan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_24__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VIII__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pegawai diberi kuasa hendaklah, apabila bertindak dalam bidang kuasa dan kewajipannya di bawah Akta ini, disifatkan sebagai seorang pekhidmat awam mengikut pengertian Kanun Keseksaan [Akta 574]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VII__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam apa-apa prosiding di bawah Akta ini, apa-apa keterangan bahawa suatu bungkusan yang mengandungi apa-apa produk tembakau, bahan merokok atau produk pengganti tembakau dan mengandungi nama, alamat atau tanda berdaftar seorang pengimport, pengilang atau pengedar, atau pemunya hak pengilang, pembungkus, atau seorang ejen mana-mana daripada mereka, hendaklah menjadi keterangan prima facie bahawa produk tembakau, bahan merokok atau produk pengganti tembakau itu diimport, dikilangkan atau dibungkuskan, mengikut mana-mana yang berkenaan, oleh setiap seorang daripada orang yang namanya, alamatnya atau tanda berdaftarnya ditunjukkan pada bungkusan itu. Tanggungjawab pengilang, pengimport atau pengedar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VII__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VII__cl_20__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VII__cl_20__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VII__cl_20__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VII__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap pengilang, pengimport atau pengedar suatu produk tembakau, bahan merokok atau produk pengganti tembakau hendaklah mengadakan apa-apa maklumat sebagaimana yang ditentukan oleh Ketua Pengarah atau mana-mana pegawai diberi kuasa berhubung dengan produk tembakau, bahan merokok atau produk pengganti tembakau itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VII__cl_20__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VII__cl_20__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VII__cl_20__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VII__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VII__cl_20__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VII__cl_20__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "sekiranya orang itu bukan suatu pertubuhan perbadanan, didenda tidak melebihi sepuluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi satu tahun atau kedua-duanya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VII__cl_20__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VII__cl_20__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "sekiranya orang itu ialah suatu pertubuhan perbadanan, didenda tidak kurang daripada sepuluh ribu ringgit dan tidak melebihi lima puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi satu tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VI__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VI__cl_16__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VI__cl_16__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VI__cl_16__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VI__cl_16__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VI__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, melalui perintah yang disiarkan dalam Warta dan tertakluk kepada apa-apa syarat yang difikirkannya patut, mengisytiharkan mana-mana bangunan atau bahagian bangunan itu, suatu tempat atau bahagian tempat itu, atau mana-mana kawasan atau kenderaan, yang orang awam mempunyai akses sebagai suatu kawasan atau tempat larangan merokok."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VI__cl_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VI__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh merokok di kawasan atau tempat larangan merokok sebagaimana yang diisytiharkan oleh Menteri di bawah subseksyen (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VI__cl_16__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VI__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (2) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima ribu ringgit. Larangan merokok, dsb., produk tembakau, dsb., bagi orang belum dewasa"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VI__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VI__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VI__cl_17__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VI__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VI__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun yang merupakan orang belum dewasa boleh merokok, mengunyah atau menggunakan mengikut apa jua cara apa-apa produk tembakau, atau merokok apa-apa produk pengganti tembakau."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VI__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VI__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima ratus ringgit atau diperintahkan untuk melaksanakan khidmat masyarakat menurut Kanun Tatacara Jenayah atau Akta Kanak-Kanak 2001. Tanggungjawab tuan punya bangunan, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VI__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VI__cl_18__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VI__cl_18__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VI__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VI__cl_18__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VI__cl_18__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VI__cl_18__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VI__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Tuan punya atau penghuni apa-apa kawasan atau tempat larangan merokok yang diisytiharkan di bawah seksyen 16—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VI__cl_18__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VI__cl_18__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah mempamerkan suatu tanda amaran larangan merokok dalam bentuk sebagaimana yang ditetapkan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VI__cl_18__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VI__cl_18__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak boleh mengadakan apa-apa kelengkapan atau kemudahan merokok atau apa-apa cara yang dihasratkan untuk menggalakkan mana-mana orang untuk merokok; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VI__cl_18__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VI__cl_18__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah mengambil semua langkah yang munasabah sebagaimana yang ditentukan oleh Ketua Pengarah untuk menghalang mana-mana orang daripada merokok di dalam bangunan atau kenderaan itu, atau di tempat atau kawasan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VI__cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VI__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima ribu ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_V__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_V__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_V__cl_14__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_V__cl_14__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_V__cl_14__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_V__cl_14__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_V__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_V__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Harga runcit atau harga jualan minimum bagi apa-apa produk tembakau, bahan merokok atau produk pengganti tembakau hendaklah mengikut harga dan syarat sebagaimana yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_V__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_V__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa permohonan oleh mana-mana pengilang atau pengimport untuk menentukan harga runcit atau harga jualan minimum apa-apa produk tembakau, bahan merokok atau produk pengganti tembakau hendaklah dibuat kepada Ketua Pengarah mengikut cara sebagaimana yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_V__cl_14__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_V__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Harga yang ditetapkan di bawah subseksyen (1) hendaklah termasuk apa-apa duti eksais atau lain-lain cukai yang berkaitan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_V__cl_14__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_V__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh menjual apa-apa produk tembakau, bahan merokok atau produk pengganti tembakau yang tidak mengikut harga dan syarat yang ditetapkan di bawah subseksyen (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_V__cl_14__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_V__cl_14__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_V__cl_14__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_V__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar seksyen ini melakukan suatu kesalahan dan boleh, apabila disabitkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_V__cl_14__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_V__cl_14__subsec_5__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_V__cl_14__subsec_5__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_V__cl_14__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "sekiranya orang itu bukan suatu pertubuhan perbadanan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_V__cl_14__subsec_5__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_V__cl_14__subsec_5__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi kesalahan pertama, didenda tidak melebihi dua puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi satu tahun atau kedua-duanya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_V__cl_14__subsec_5__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_V__cl_14__subsec_5__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi kesalahan kedua atau yang berikutnya, didenda tidak melebihi tiga puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi dua tahun atau kedua-duanya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_V__cl_14__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_V__cl_14__subsec_5__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_V__cl_14__subsec_5__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_V__cl_14__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "sekiranya orang itu ialah suatu pertubuhan perbadanan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_V__cl_14__subsec_5__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_V__cl_14__subsec_5__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi kesalahan pertama, didenda tidak kurang daripada dua puluh ribu ringgit dan tidak melebihi satu ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi dua tahun atau kedua-duanya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_V__cl_14__subsec_5__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_V__cl_14__subsec_5__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi kesalahan kedua atau yang berikutnya, didenda tidak kurang daripada lima puluh ribu ringgit dan tidak melebihi tiga ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tiga tahun atau kedua-duanya. Pembungkusan dan pelabelan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_V__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_V__cl_15__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_V__cl_15__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_V__cl_15__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_V__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh mengilang, mengimport atau mengedar apa-apa produk tembakau, bahan merokok atau produk pengganti tembakau melainkan jika produk tembakau, bahan merokok atau produk pengganti tembakau itu dibungkus dan dilabel mengikut kehendak sebagaimana yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_V__cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
