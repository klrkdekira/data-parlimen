      "schema:text": {
        "@language": "ms",
        "@value": "sekiranya orang itu ialah suatu pertubuhan perbadanan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV__cl_11__subsec_2__para_b__subpara_i",
