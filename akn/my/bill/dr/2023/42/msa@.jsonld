      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh menjual—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV__cl_12__subsec_1__para_a",
