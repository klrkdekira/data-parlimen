        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_I__cl_2__subsec_1__list_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_I__cl_2__subsec_1__list_1__para_g",
