      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa barang atau perkhidmatan bersama dengan apa-apa produk tembakau, bahan merokok atau produk pengganti tembakau sebagai suatu pemberian atau hadiah;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV__cl_12__subsec_1__para_c",
