        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VI__cl_18"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "LARANGAN MEROKOK Kawasan atau tempat larangan merokok"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VII",
      "@type": "akn:part",
      "eli:number": "VII",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VII__cl_19",
