      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_3__subsec_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_3__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi kesalahan kedua atau yang berikutnya, didenda tidak kurang daripada lima puluh ribu ringgit dan tidak melebihi tiga ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tiga tahun atau kedua-duanya. Permohonan bagi pendaftaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_4__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_4__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_4__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_4__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_4__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu permohonan bagi pendaftaran produk tembakau, bahan merokok atau produk pengganti tembakau hendaklah dibuat oleh pemohon kepada Ketua Pengarah mengikut cara sebagaimana yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Permohonan yang dibuat di bawah subseksyen (1) boleh ditarik balik pada bila-bila masa oleh pemohon sebelum apa-apa kelulusan oleh Ketua Pengarah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_4__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap permohonan di bawah subseksyen (1) hendaklah disertakan dengan fi sebagaimana yang ditetapkan dan apa-apa dokumen atau maklumat sebagaimana yang ditentukan oleh Ketua Pengarah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_4__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Pada bila-bila masa selepas menerima permohonan di bawah subseksyen (1), Ketua Pengarah boleh, secara bertulis, menghendaki pemohon untuk memberikan apa-apa maklumat, butiran atau dokumen tambahan dalam apa-apa tempoh yang dinyatakan oleh Ketua Pengarah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_4__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika pemohon gagal untuk mematuhi permintaan yang dibuat di bawah subseksyen (4) dalam tempoh yang dinyatakan dalam permintaan itu atau apa-apa pelanjutan masa yang diberikan oleh Ketua Pengarah, permohonan itu hendaklah disifatkan telah ditarik balik tanpa menjejaskan hak pemohon itu untuk membuat suatu permohonan baharu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_4__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Setelah permohonan yang dibuat di bawah subseksyen (1) diluluskan, Ketua Pengarah boleh mengenakan apa-apa syarat sebagaimana yang difikirkannya patut dan Ketua Pengarah boleh mengubah atau membatalkan apa-apa syarat yang dikenakan. Pembatalan pendaftaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_5__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_5__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_5__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_5__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_5__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada subseksyen (2), Ketua Pengarah boleh membatalkan apa-apa kelulusan pendaftaran yang dibuat di bawah seksyen 4 jika pemohon—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_5__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah melanggar mana-mana peruntukan Akta ini atau mana-mana peraturan-peraturan yang dibuat di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_5__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah memungkiri mana-mana syarat pendaftaran; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_5__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "telah disabitkan bagi apa-apa kesalahan di bawah Akta ini atau mana-mana peraturan-peraturan yang dibuat di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah hendaklah, melalui notis bertulis, sebelum membatalkan apa-apa kelulusan bagi apa-apa produk tembakau, bahan merokok atau produk pengganti tembakau di bawah subseksyen (1), memberikan peluang kepada pemohon untuk membuat apa-apa representasi secara bertulis terhadap pembatalan itu, dan sementara menunggu keputusan, semua pengimportan, pengilangan atau pengedaran produk tembakau, bahan merokok atau produk pengganti tembakau itu hendaklah digantung bermula dari tarikh penerimaan notis itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_5__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_5__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_5__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pemohon yang pendaftaran produk tembakau, bahan merokok atau produk pengganti tembakau telah dibatalkan di bawah subseksyen (1) atau digantung di bawah subseksyen (2) tidak layak untuk menuntut apa-apa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_5__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_5__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "pampasan bagi apa-apa kerugian yang disebabkan oleh pembatalan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_5__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_5__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "pembayaran balik fi yang dibayar di bawah subseksyen 4(3). Daftar produk tembakau, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_6__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah hendaklah menyimpan dan menyenggara apa-apa daftar produk tembakau, bahan merokok dan produk pengganti tembakau yang didaftarkan di bawah seksyen 4."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Daftar itu hendaklah disimpan dalam apa-apa cara dan hendaklah mengandungi apa-apa butir sebagaimana yang ditentukan oleh Ketua Pengarah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV__cl_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV__cl_11",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV__cl_12",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV__cl_13"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "KAWALAN PENJUALAN Larangan penjualan produk tembakau, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV__cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV__cl_10__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh menjual atau mempamerkan bagi penjualan apa-apa produk tembakau, bahan merokok atau produk pengganti tembakau melainkan jika jualan atau pameran bagi penjualan itu mematuhi kehendak sebagaimana yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV__cl_10__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV__cl_10__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV__cl_10__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV__cl_10__subsec_2__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV__cl_10__subsec_2__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV__cl_10__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "sekiranya orang itu bukan suatu pertubuhan perbadanan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV__cl_10__subsec_2__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV__cl_10__subsec_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi kesalahan pertama, didenda tidak melebihi dua puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi satu tahun atau kedua-duanya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV__cl_10__subsec_2__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV__cl_10__subsec_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi kesalahan kedua atau yang berikutnya, didenda tidak melebihi tiga puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi dua tahun atau kedua-duanya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV__cl_10__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV__cl_10__subsec_2__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV__cl_10__subsec_2__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV__cl_10__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "sekiranya orang itu ialah suatu pertubuhan perbadanan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV__cl_10__subsec_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV__cl_10__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi kesalahan pertama, didenda tidak kurang daripada dua puluh ribu ringgit dan tidak melebihi satu ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi dua tahun atau kedua-duanya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV__cl_10__subsec_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV__cl_10__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi kesalahan kedua atau yang berikutnya, didenda tidak kurang daripada lima puluh ribu ringgit dan tidak melebihi tiga ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tiga tahun atau kedua-duanya. Larangan penjualan produk tembakau, dsb., tiruan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV__cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV__cl_11__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV__cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh menjual apa-apa produk tembakau, bahan merokok atau produk pengganti tembakau tiruan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV__cl_11__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV__cl_11__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV__cl_11__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV__cl_11__subsec_2__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV__cl_11__subsec_2__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV__cl_11__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "sekiranya orang itu bukan suatu pertubuhan perbadanan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV__cl_11__subsec_2__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV__cl_11__subsec_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi kesalahan pertama, didenda tidak melebihi sepuluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi satu tahun atau kedua-duanya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV__cl_11__subsec_2__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV__cl_11__subsec_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi kesalahan kedua atau yang berikutnya, didenda tidak melebihi dua puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi satu tahun atau kedua-duanya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV__cl_11__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV__cl_11__subsec_2__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_IV__cl_11__subsec_2__para_b__subpara_ii"
      ],
