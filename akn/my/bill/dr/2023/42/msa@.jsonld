      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_I__cl_2__subsec_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_I__cl_2__subsec_1__list_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_I__cl_2__subsec_1__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "barter atau pertukaran barang;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_I__cl_2__subsec_1__list_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_I__cl_2__subsec_1__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menawarkan atau mencuba untuk menjual;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_I__cl_2__subsec_1__list_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_I__cl_2__subsec_1__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menyebabkan atau membenarkan untuk dijual;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_I__cl_2__subsec_1__list_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_I__cl_2__subsec_1__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mendedahkan bagi penjualan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_I__cl_2__subsec_1__list_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_I__cl_2__subsec_1__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menerima, menghantar, mengirim, mengedar, menyampaikan atau menghantar serah bagi penjualan atau pertukaran atau melalui penjualan atau pertukaran atau menurut penjualan atau pertukaran itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_I__cl_2__subsec_1__list_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_I__cl_2__subsec_1__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "membekalkan apa-apa produk tembakau, bahan merokok atau produk pengganti tembakau yang suatu upah akan diterima oleh pembekal untuk bekalan itu sama ada secara khusus atau sebagai sebahagian daripada perkhidmatan yang dikontrakkan bagi penjualan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_I__cl_2__subsec_1__list_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_I__cl_2__subsec_1__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "memiliki apa-apa produk tembakau, bahan merokok atau produk pengganti tembakau bagi penjualan atau pertukaran; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_I__cl_2__subsec_1__list_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_I__cl_2__subsec_1__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "memiliki apa-apa produk tembakau, bahan merokok atau produk pengganti tembakau dengan mengetahui bahawa produk tembakau, bahan merokok atau produk pengganti tembakau itu boleh dijual, ditawarkan, ditayangkan atau didedahkan bagi penjualan, atau dilupuskan, bagi apa-apa balasan, dan ini termasuklah penjualan elektronik; “Menteri” ertinya Menteri yang dipertanggungkan dengan tanggungjawab bagi kesihatan; “merokok” ertinya menyedut dan menghembus asap atau wap, apa-apa produk tembakau atau produk pengganti tembakau, dan termasuklah memegang atau mempunyai kawalan ke atas apa-apa produk tembakau atau produk pengganti tembakau yang dinyalakan, dipanaskan atau diwapkan atau digunakan dengan apa-apa cara lain; “orang belum dewasa” ertinya mana-mana orang yang di bawah umur lapan belas tahun; “pegawai diberi kuasa” ertinya mana-mana pegawai perubatan kesihatan, atau mana-mana pegawai kesihatan persekitaran atau penolong pegawai kesihatan persekitaran daripada Kementerian Kesihatan atau mana-mana pihak berkuasa tempatan, atau mana-mana orang berkelayakan yang sesuai, yang dilantik oleh Menteri menjadi pegawai diberi kuasa di bawah seksyen 24; “pengilang” termasuklah mana-mana orang yang membungkus atau melabel produk tembakau, bahan merokok atau produk pengganti tembakau; “pengimport” termasuklah mana-mana orang yang, sama ada sebagai pemunya, pemberi konsain, penerima konsain, ejen atau broker, memiliki, atau sebaliknya berhak kepada jagaan atau kawalan, produk tembakau, bahan merokok atau produk pengganti tembakau yang diimport; “pertubuhan perbadanan” ertinya suatu syarikat, perkongsian liabiliti terhad, firma atau kumpulan orang yang lain; “premis” termasuklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_I__cl_2__subsec_1__list_2",
      "@type": "akn:list",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_I__cl_2__subsec_1__list_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_I__cl_2__subsec_1__list_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_I__cl_2__subsec_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_I__cl_2__subsec_1__list_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_I__cl_2__subsec_1__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa bangunan atau khemah atau apa-apa struktur lain, kekal atau sebaliknya bersama dengan tanah yang bangunan, khemah atau struktur lain itu terletak dan apa-apa tanah bersempadanan yang digunakan yang berkaitan dengannya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_I__cl_2__subsec_1__list_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_I__cl_2__subsec_1__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa kenderaan, pengangkut, vesel atau pesawat udara yang digunakan atau yang berkaitan dengan persediaan, pengawetan, pembungkusan, penyimpanan, pengiriman, pengedaran atau penjualan apa-apa produk tembakau, bahan merokok atau produk pengganti tembakau; “produk pengganti tembakau” ertinya apa-apa produk atau produk yang diproses, selain produk tembakau, yang boleh digunakan bagi merokok, sama ada dengan atau tanpa bahan merokok; “produk tembakau” ertinya tembakau yang diproses atau apa-apa produk yang mengandungi tembakau yang dimaksudkan bagi kegunaan manusia; “tembakau” ertinya apa-apa produk yang diperoleh daripada daun Nicotiana tabacum atau spesies Nicotiana yang lain, sama ada dalam keadaan belum diawet atau sudah diawet dan termasuklah kacukan spesies ini, kacukan akibat daripada silangan spesies ini atau kacukan dengan mana-mana spesies pokok lain atau kacukan yang lain, atau versi spesies yang dihasilkan secara genetik atau kacukan spesies itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_I__cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_I__cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud Akta ini, suatu sebutan mengenai “produk merokok” hendaklah ditafsirkan sebagai suatu sebutan mengenai produk tembakau, bahan merokok atau produk pengganti tembakau."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_V",
      "@type": "akn:part",
      "eli:number": "V",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_V__cl_14",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_V__cl_15"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "KAWALAN HARGA, PEMBUNGKUSAN, PELABELAN, PENGILANGAN, DSB. Harga runcit atau harga jualan minimum"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_VI",
