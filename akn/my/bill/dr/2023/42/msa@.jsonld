      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa produk tembakau, bahan merokok atau produk pengganti tembakau bersama dengan apa-apa produk tembakau, bahan merokok atau produk pengganti tembakau sebagai suatu pemberian atau hadiah; atau"
      }
