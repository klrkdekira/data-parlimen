    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_7__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_7__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_7__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_7__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_7__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_7__subsec_1__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh menerbitkan atau memudahkan mana-mana orang untuk menerbitkan apa-apa iklan yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_7__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_7__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mengandungi apa-apa produk tembakau, bahan merokok atau produk pengganti tembakau;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_7__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_7__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mengandungi apa-apa jenama atau cap dagang yang berhubungan dengan apa-apa produk tembakau, bahan merokok atau produk pengganti tembakau;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_7__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_7__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mengandungi apa-apa tawaran atau pelawaan untuk membeli apa-apa produk tembakau, bahan merokok atau produk pengganti tembakau;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_7__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_7__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dimaksudkan atau berkemungkinan untuk menggalakkan mana-mana orang untuk merokok;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_7__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_7__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mempromosikan apa-apa produk tembakau, bahan merokok atau produk pengganti tembakau itu sebagai suatu produk berhenti merokok; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_7__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_7__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mempromosikan apa-apa barang yang digunakan bersama dengan apa-apa produk tembakau, bahan merokok atau produk pengganti tembakau."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_7__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_7__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar seksyen ini melakukan suatu kesalahan dan boleh, apabila disabitkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_7__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_7__subsec_2__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_7__subsec_2__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_7__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "sekiranya orang itu bukan suatu pertubuhan perbadanan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_7__subsec_2__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_7__subsec_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi kesalahan pertama, didenda tidak melebihi dua puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi satu tahun atau kedua-duanya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_7__subsec_2__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_7__subsec_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi kesalahan kedua atau yang berikutnya, didenda tidak melebihi tiga puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi dua tahun atau kedua-duanya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_7__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_7__subsec_2__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_7__subsec_2__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_7__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "sekiranya orang itu ialah suatu pertubuhan perbadanan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_7__subsec_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_7__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi kesalahan pertama, didenda tidak kurang daripada dua puluh ribu ringgit dan tidak melebihi satu ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi dua tahun atau kedua-duanya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_7__subsec_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_7__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi kesalahan kedua atau yang berikutnya, didenda tidak kurang daripada lima puluh ribu ringgit dan tidak melebihi tiga ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tiga tahun atau kedua-duanya. Larangan pengiklanan produk tembakau, dsb., tiruan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_8__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_8__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_8__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh menerbitkan atau memudahkan mana-mana orang untuk menerbitkan, menyebabkan untuk diterbitkan, atau mengambil bahagian dalam penerbitan, bagi apa-apa iklan yang berhubungan dengan apa-apa produk tembakau, bahan merokok atau produk pengganti tembakau tiruan yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_8__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_8__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mengandungi apa-apa dorongan tersurat atau tersirat, cadangan atau galakan untuk membeli apa-apa produk tembakau, bahan merokok atau produk pengganti tembakau tiruan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_8__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_8__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "penggunaannya dikira, secara tersurat atau tersirat, yang dimaksudkan atau berkemungkinan untuk menggalakkan mana-mana orang untuk merokok."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_8__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_8__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_8__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_8__subsec_2__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_8__subsec_2__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_8__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "sekiranya orang itu bukan suatu pertubuhan perbadanan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_8__subsec_2__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_8__subsec_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi kesalahan pertama, didenda tidak melebihi sepuluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi satu tahun atau kedua-duanya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_8__subsec_2__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_8__subsec_2__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi kesalahan kedua atau yang berikutnya, didenda tidak melebihi dua puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi satu tahun atau kedua-duanya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_8__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_8__subsec_2__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_8__subsec_2__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_8__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "sekiranya orang itu ialah suatu pertubuhan perbadanan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_8__subsec_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_8__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi kesalahan pertama, didenda tidak kurang daripada sepuluh ribu ringgit dan tidak melebihi lima puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi satu tahun atau kedua-duanya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_8__subsec_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_8__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi kesalahan kedua atau yang berikutnya, didenda tidak kurang daripada tiga puluh ribu ringgit dan tidak melebihi dua ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi dua tahun atau kedua-duanya. Larangan promosi atau tajaan produk tembakau, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_9__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_9__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh mempromosi atau menaja, atau mengambil bahagian dalam apa-apa perkiraan yang mempromosikan apa-apa produk tembakau, bahan merokok atau produk pengganti tembakau, yang dimaksudkan atau berkemungkinan untuk menggalakkan mana-mana orang untuk merokok atau dipromosikan sebagai suatu produk berhenti merokok."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_9__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_9__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini, “perkiraan” termasuklah apa-apa perjanjian, aku janji atau persefahaman yang telah atau berkemungkinan memberi kesan mempromosikan apa-apa produk tembakau, bahan merokok atau produk pengganti tembakau—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_9__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_9__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memberi atau menerima apa-apa tajaan, pemberian, hadiah, ganjaran, biasiswa atau lain-lain faedah yang seumpamanya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_9__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_9__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menganjurkan apa-apa kempen, kursus, bengkel, forum, jerayawara, perundingan atau acara."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_9__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_9__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_9__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_III__cl_9__subsec_3__para_a",
