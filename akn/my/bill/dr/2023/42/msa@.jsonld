      "schema:text": {
        "@language": "ms",
        "@value": "bagi kesalahan kedua atau yang berikutnya, didenda tidak kurang daripada tiga puluh ribu ringgit dan tidak melebihi dua ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi dua tahun atau kedua-duanya. Larangan produk tembakau, dsb., sebagai pemberian atau hadiah"
      }
    },
