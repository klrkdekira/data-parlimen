        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_3__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada produk tembakau, bahan merokok atau produk pengganti tembakau boleh diimport, dikilang atau diedar oleh mana-mana orang melainkan jika didaftarkan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/42/msa@/~part_II__cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
