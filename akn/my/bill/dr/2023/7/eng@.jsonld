      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "Section 119 of the Code is amended by inserting after the words “which may extend to twenty years” the words “or upwards”. Amendment of section 121"
