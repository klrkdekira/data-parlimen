      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Abolition of Mandatory Death Penalty Act 2023."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_I__cl_1__subsec_2",
