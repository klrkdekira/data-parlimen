      "eli:number": "49",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraph 32(1)(a) of the principal Act is amended by substituting for the words “imprisonment for life or for a term not exceeding fourteen years” the words “imprisonment for a term not exceeding forty years”. Deletion of section 46"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_IV__cl_50",
      "@type": "akn:clause",
      "eli:number": "50",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "Section 46 of the principal Act is deleted. Transitional"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_IV__cl_51",
      "@type": "akn:clause",
      "eli:number": "51",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "Upon the coming into operation of this Act, if a person is convicted by any court for the commission of an offence under paragraph 14(1)(a) of the principal Act, the person, whether at a trial or on an appeal, shall be sentenced in accordance with the provisions of the principal Act as amended by this Act even though the offence was committed before the date of coming into operation of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
