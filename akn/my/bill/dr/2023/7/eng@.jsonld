    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_VII__cl_56",
      "@type": "akn:clause",
      "eli:number": "56",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_VII__cl_56__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_VII__cl_56__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_VII__cl_56__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "The Strategic Trade Act 2010, which is referred to as the “principal Act” in this Part, is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_VII__cl_56__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_VII__cl_56",
      "schema:text": {
        "@language": "en",
        "@value": "in subsubparagraph 9(4)(a)(i)(A) by substituting for the words “imprisonment for natural life” the words “imprisonment for a term of not less than thirty years but not exceeding forty years”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_VII__cl_56__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_VII__cl_56",
      "schema:text": {
        "@language": "en",
        "@value": "in subsubparagraph 9(5)(a)(i)(A) by substituting for the words “imprisonment for natural life” the words “imprisonment for a term of not less than thirty years but not exceeding forty years”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_VII__cl_56__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_VII__cl_56",
      "schema:text": {
        "@language": "en",
        "@value": "in subsubparagraph 9(6)(a)(i)(A) by substituting for the words “imprisonment for natural life” the words “imprisonment for a term of not less than thirty years but not exceeding forty years”. Amendment of section 10"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_VII__cl_57",
      "@type": "akn:clause",
      "eli:number": "57",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraph 10(2)(a) of the principal Act is amended by substituting for the words “imprisonment for natural life” the words “imprisonment for a term of not less than thirty years but not exceeding forty years”. Amendment of section 11"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_VII__cl_58",
      "@type": "akn:clause",
      "eli:number": "58",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "Subparagraph 11(2)(a)(i) of the principal Act is amended by substituting for the words “imprisonment for natural life” the words “imprisonment for a term of not less than thirty years but not exceeding forty years”. Amendment of section 12"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_VII__cl_59",
      "@type": "akn:clause",
      "eli:number": "59",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "Subsubparagraph 12(4)(a)(i)(A) of the principal Act is amended by substituting for the words “imprisonment for natural life” the words “imprisonment for a term of not less than thirty years but not exceeding forty years”. Transitional"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_VII__cl_60",
      "@type": "akn:clause",
      "eli:number": "60",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "Upon the coming into operation of this Act, if a person is convicted by any court for the commission of an offence under subsubparagraph 9(4)(a)(i)(A), subsubparagraph 9(5)(a)(i)(A), subsubparagraph 9(6)(a)(i)(A), paragraph 10(2)(a), subparagraph 11(2)(a)(i) or subsubparagraph 12(4)(a)(i)(A) of the principal Act, the person, whether at a trial or on an appeal, shall be sentenced in accordance with the provisions of the principal Act as amended by this Act even though the offence was committed before the date of coming into operation of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_VI__cl_54",
      "@type": "akn:clause",
      "eli:number": "54",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_VI__cl_54__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_VI__cl_54__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "The Dangerous Drugs Act 1952, which is referred to as the “principal Act” in this Part, is amended in section 39b—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_VI__cl_54__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_VI__cl_54",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (2), by substituting for the words “be punished with whipping of not less than fifteen strokes” the words “be punished with whipping of not less than twelve strokes”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_VI__cl_54__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_VI__cl_54",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting subsections (2a) and (2b). Transitional"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_VI__cl_55",
      "@type": "akn:clause",
      "eli:number": "55",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "Upon the coming into operation of this Act, if a person is convicted by any court for the commission of an offence under section 39b of the principal Act, the person, whether at a trial or on an appeal, shall be sentenced in accordance with the provisions of the principal Act as amended by this Act even though the offence was committed before the date of coming into operation of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_V__cl_52",
      "@type": "akn:clause",
      "eli:number": "52",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "The Kidnapping Act 1961, which is referred to as the “principal Act” in this Part, is amended in subsection 3(1) by substituting for the words “with death or imprisonment for life and shall, if he is not sentenced to death, also be liable to whipping” the words “with imprisonment for a term of not less than thirty years but not exceeding forty years and with whipping”. Transitional"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_V__cl_53",
      "@type": "akn:clause",
      "eli:number": "53",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "Upon the coming into operation of this Act, if a person is convicted by any court for the commission of an offence under section 3 of the principal Act, the person, whether at a trial or on an appeal, shall be sentenced in accordance with the provisions of the principal Act as amended by this Act even though the offence was committed before the date of coming into operation of this Act."
      }
    }
  ]
}
