      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Amendment of Acts"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_I",
      "schema:text": {
        "@language": "en",
        "@value": "The Penal Code [Act 574], the Firearms (Increased Penalties) Act 1971 [Act 37], the Arms Act 1960 [Act 206], the Kidnapping Act 1961 [Act 365], the Dangerous Drugs Act 1952 [Act 234], the Strategic Trade Act 2010 [Act 708] and the Criminal Procedure Code [Act 593] are amended in the manner specified in Parts II, III, IV, V, VI, VII and VIII respectively."
      }
    },
