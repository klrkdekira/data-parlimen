      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_VIII",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 388(1) of the Code is amended by inserting after the words “imprisonment for life” the words “or imprisonment for a term which may extend to forty years”. Amendment of section 425a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_VIII__cl_64",
      "@type": "akn:clause",
      "eli:number": "64",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_VIII",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 425a(2) of the Code is amended by substituting for paragraph (c) the following paragraph: “(c) imprisonment for a term of not less than thirty years but not exceeding forty years.”. Amendment of First Schedule"
      }
    },
