      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "AMENDMENTS TO THE FIREARMS (INCREASED PENALTIES) ACT 1971 Amendment of section 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_III__cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "The Firearms (Increased Penalties) Act 1971, which is referred to as the “principal Act” in this Part, is amended in subsection 2(1) by deleting the definition of “imprisonment for life”. Amendment of section 3"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_III__cl_41",
      "@type": "akn:clause",
      "eli:number": "41",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "Section 3 of the principal Act is amended by substituting for the words “be punished with death” the words “be punished with imprisonment for a term of not less than thirty years but not exceeding forty years and with whipping with not less than twelve strokes”. Amendment of section 3a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_III__cl_42",
      "@type": "akn:clause",
      "eli:number": "42",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "Section 3a of the principal Act is amended by substituting for the words “be punished with death” the words “be punished with imprisonment for a term of not less than thirty years but not exceeding forty years and with whipping with not less than twelve strokes”. Amendment of section 4"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_III__cl_43",
      "@type": "akn:clause",
      "eli:number": "43",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "Section 4 of the principal Act is amended by substituting for the words “imprisonment for life” the words “imprisonment for a term of not less than thirty years but not exceeding forty years”. Amendment of section 5"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_III__cl_44",
      "@type": "akn:clause",
      "eli:number": "44",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "Section 5 of the principal Act is amended by substituting for the words “imprisonment for life” the words “imprisonment for a term of not less than thirty years but not exceeding forty years”. Amendment of section 7"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_III__cl_45",
      "@type": "akn:clause",
      "eli:number": "45",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "Section 7 of the principal Act is amended by substituting for subsection (1) the following subsection: “(1) Any person trafficking in firearms shall be punished with imprisonment for a term of not less than thirty years but not exceeding forty years and with whipping with not less than six strokes.”. Transitional"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_III__cl_46",
      "@type": "akn:clause",
      "eli:number": "46",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "Upon the coming into operation of this Act, if a person is convicted by any court for the commission of an offence under section 3, 3a or 7 of the principal Act, the person, whether at a trial or on an appeal, shall be sentenced in accordance with the provisions of the principal Act as amended by this Act even though the offence was committed before the date of coming into operation of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_II__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "Section 124k of the Code is amended by substituting for the words “imprisonment for life” the words “imprisonment for a term of not less than thirty years but not exceeding forty years”. Amendment of section 124m"
      }
    },
