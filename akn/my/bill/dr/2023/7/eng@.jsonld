      "schema:text": {
        "@language": "en",
        "@value": "Section 364 of the Code is amended by substituting for the words “death or imprisonment for a term which may extend to thirty years and shall, if he is not sentenced to death, also be liable to whipping” the words “imprisonment for a term of not more than thirty years and shall also be punished with whipping”. Amendment of section 374a"
      }
