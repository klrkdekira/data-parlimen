      "schema:name": {
        "@language": "en",
        "@value": "Section 14 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_IV__cl_48__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_IV__cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (1) the following subsection: “(1) Any person who manufactures an arm or ammunition without a valid licence granted under section 12 or in contravention of any condition imposed under paragraph 12(2)(a) shall, on conviction— (a) be punished with imprisonment for a term of not less than thirty years but not exceeding forty years and with whipping of not less than six strokes; and (b) in the case of a company, firm, society or body of persons, be punished with a fine not exceeding five million ringgit.”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_IV__cl_48__para_b",
