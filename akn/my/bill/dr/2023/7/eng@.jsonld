      "schema:text": {
        "@language": "en",
        "@value": "Section 125 of the Code is amended by substituting for the words “imprisonment for life, to which fine may be added; or with imprisonment for a term which may extend to twenty years” the words “imprisonment for a term not exceeding forty years”. Amendment of section 125a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_II__cl_13",
      "@type": "akn:clause",
