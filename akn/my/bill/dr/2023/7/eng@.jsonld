      "schema:text": {
        "@language": "en",
        "@value": "The Arms Act 1960, which is referred to as the “principal Act” in this Part, is amended in subsection 2(1) by deleting the definition of “imprisonment for life”. Amendment of section 14"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_IV__cl_48",
