      "schema:text": {
        "@language": "en",
        "@value": "Section 124m of the Code is amended by substituting for the words “imprisonment for life” the words “imprisonment for a term of not less than thirty years but not exceeding forty years”. Amendment of section 125"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_II__cl_12",
