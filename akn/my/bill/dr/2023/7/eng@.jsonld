      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "Section 118 of the Code is amended by inserting after the words “which may extend to twenty years” the words “or upwards”. Amendment of section 119"
      }
    },
