      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_III",
      "@type": "akn:part",
      "eli:number": "III",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_III__cl_40",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_III__cl_41",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_III__cl_42",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_III__cl_43",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_III__cl_44",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_III__cl_45",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_III__cl_46"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "PINDAAN KEPADA AKTA SENJATA API (PENALTI LEBIH BERAT) 1971 Pindaan seksyen 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_III__cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Senjata Api (Penalti Lebih Berat) 1971, yang disebut “Akta ibu” dalam Bahagian ini, dipinda dalam subseksyen 2(1) dengan memotong takrif “pemenjaraan seumur hidup”. Pindaan seksyen 3"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_III__cl_41",
      "@type": "akn:clause",
      "eli:number": "41",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 3 Akta ibu dipinda dengan menggantikan perkataan “dihukum mati” dengan perkataan “dihukum dengan pemenjaraan bagi tempoh tidak kurang daripada tiga puluh tahun tetapi tidak melebihi empat puluh tahun dan juga disebat tidak kurang daripada dua belas kali”. Pindaan seksyen 3a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_III__cl_42",
      "@type": "akn:clause",
      "eli:number": "42",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 3a Akta ibu dipinda dengan menggantikan perkataan “dihukum mati” dengan perkataan “dihukum dengan pemenjaraan bagi tempoh tidak kurang daripada tiga puluh tahun tetapi tidak melebihi empat puluh tahun dan juga disebat tidak kurang daripada dua belas kali”. Pindaan seksyen 4"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_III__cl_43",
      "@type": "akn:clause",
      "eli:number": "43",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 4 Akta ibu dipinda dengan menggantikan perkataan “dipenjarakan seumur hidup” dengan perkataan “dipenjarakan bagi tempoh tidak kurang daripada tiga puluh tahun tetapi tidak melebihi empat puluh tahun”. Pindaan seksyen 5"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_III__cl_44",
      "@type": "akn:clause",
      "eli:number": "44",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 5 Akta ibu dipinda dengan menggantikan perkataan “dipenjarakan seumur hidup” dengan perkataan “dipenjarakan bagi tempoh tidak kurang daripada tiga puluh tahun tetapi tidak melebihi empat puluh tahun”. Pindaan seksyen 7"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_III__cl_45",
      "@type": "akn:clause",
      "eli:number": "45",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 7 Akta ibu dipinda dengan menggantikan subskesyen (1) dengan subseksyen yang berikut: “(1) Seseorang yang berdagang senjata api hendaklah dihukum dengan pemenjaraan bagi tempoh tidak kurang daripada tiga puluh tahun tetapi tidak melebihi empat puluh tahun dan disebat tidak kurang daripada enam kali.”. Peralihan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_III__cl_46",
      "@type": "akn:clause",
      "eli:number": "46",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila Akta ini mula berkuat kuasa, jika seseorang disabitkan oleh mana-mana mahkamah kerana melakukan suatu kesalahan di bawah seksyen 3, 3a atau 7 Akta ibu, orang itu, sama ada dalam suatu perbicaraan atau rayuan, hendaklah dihukum mengikut peruntukan Akta ibu sebagaimana yang dipinda oleh Akta ini walaupun kesalahan itu dilakukan sebelum tarikh permulaan kuat kuasa Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_II__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 124k Kanun dipinda dengan menggantikan perkataan “imprisonment for life” dengan perkataan “imprisonment for a term of not less than thirty years but not exceeding forty years”. Pindaan seksyen 124m"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_II__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 124m Kanun dipinda dengan menggantikan perkataan “imprisonment for life” dengan perkataan “imprisonment for a term of not less than thirty years but not exceeding forty years”. Pindaan seksyen 125"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_II__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 125 Kanun dipinda dengan menggantikan perkataan “imprisonment for life, to which fine may be added; or with imprisonment for a term which may extend to twenty years” dengan perkataan “imprisonment for a term not exceeding forty years”. Pindaan seksyen 125a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_II__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 125a Kanun dipinda dengan menggantikan perkataan “imprisonment for life, to which fine may be added; or with imprisonment for a term which may extend to twenty years” dengan perkataan “imprisonment for a term not exceeding forty years”. Pindaan seksyen 128"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_II__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 128 Kanun dipinda dengan menggantikan perkataan “imprisonment for life, or imprisonment for a term which may extend to twenty years” dengan perkataan “imprisonment for a term not exceeding forty years”. Pindaan seksyen 130"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_II__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 130 Kanun dipinda dengan menggantikan perkataan “imprisonment for life, or imprisonment for a term which may extend to twenty years” dengan perkataan “imprisonment for a term not exceeding forty years”. Pindaan seksyen 130a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_II__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 130a Kanun dipinda dengan memotong perenggan (f). Pindaan seksyen 130b"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_II__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 130B(1) Kanun dipinda dengan memotong takrif “imprisonment for life”. Pindaan seksyen 130c"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_II__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan 130c(1)(a) Kanun dipinda dengan memasukkan selepas perkataan “with death” perkataan “or imprisonment for a term of not less than thirty years but not exceeding forty years and if not sentenced to death, shall also be punished with whipping of not less than twelve strokes”. Pindaan seksyen 130d"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_II__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 130d Kanun dipinda dengan menggantikan perkataan “imprisonment for life or imprisonment for a term not exceeding thirty years” dengan perkataan “imprisonment for a term not exceeding forty years”. Pindaan seksyen 130i"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_II__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan 130i(a) Kanun dipinda dengan memasukkan selepas perkataan “with death” perkataan “or imprisonment for a term of not less than thirty years but not exceeding forty years, and if not sentenced to death, shall also be punished with whipping of not less than twelve strokes”. Pindaan seksyen 130j"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_II__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 130j(1) Kanun dipinda dengan menggantikan perkataan “imprisonment for life or imprisonment for a term not exceeding thirty years” dengan perkataan “imprisonment for a term not exceeding forty years”. Pindaan seksyen 130k"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_II__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 130k Kanun dipinda dengan menggantikan perkataan “imprisonment for life, and shall also be liable to fine; or with imprisonment for a term which may extend to twenty years” dengan perkataan “imprisonment for a term not exceeding forty years, and shall also be liable to fine”. Pindaan seksyen 130ka"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_II__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 130ka Kanun dipinda dengan menggantikan perkataan “imprisonment for life” dengan perkataan “forty years”. Pindaan seksyen 130n"
      }
    },
