      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 364 Kanun dipinda dengan menggantikan perkataan “death or imprisonment for a term which may extend to thirty years and shall, if he is not sentenced to death, also be liable to whipping” dengan perkataan “imprisonment for a term of not more than thirty years and shall also be punished with whipping”. Pindaan seksyen 374a"
      }
    },
    {
