      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Pemansuhan Hukuman Mati Mandatori 2023."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_I__cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta. Pindaan Akta"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_I",
      "schema:text": {
        "@language": "ms",
        "@value": "Kanun Keseksaan [Akta 574], Akta Senjata Api (Penalti Lebih Berat) 1971 [Akta 37], Akta Senjata 1960 [Akta 206], Akta Penculikan 1961 [Akta 365], Akta Dadah Berbahaya 1952 [Akta 234], Akta Perdagangan Strategik 2010 [Akta 708] dan Kanun Tatacara Jenayah [Akta 593] dipinda mengikut cara yang dinyatakan masing-masing dalam Bahagian II, III, IV, V, VI, VII dan VIII."
      }
    },
