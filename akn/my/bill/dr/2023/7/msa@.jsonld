      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 122 Kanun dipinda dengan menggantikan perkataan “imprisonment for life or imprisonment for a term not exceeding twenty years” dengan perkataan “imprisonment for a term not exceeding forty years”. Pindaan seksyen 124k"
      }
    },
    {
