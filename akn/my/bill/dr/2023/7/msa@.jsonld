      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 119 Kanun dipinda dengan memasukkan selepas perkataan “which may extend to twenty years” perkataan “or upwards”. Pindaan seksyen 121"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_II__cl_6",
      "@type": "akn:clause",
