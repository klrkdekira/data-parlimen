      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 307 Kanun dipinda dengan memotong subseksyen (2). Pindaan seksyen 364"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_II__cl_36",
