      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 121 Kanun dipinda dengan menggantikan perkataan “imprisonment for life” dengan perkataan “imprisonment for a term of not less than thirty years but not exceeding forty years”. Pindaan seksyen 121a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 121a Kanun dipinda dengan menggantikan perkataan “with death and shall also be liable to fine” dengan perkataan “with death or imprisonment for a term of not less than thirty years but not exceeding forty years and if not sentenced to death, shall also be punished with whipping of not less than twelve strokes”. Pindaan seksyen 121b"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_II__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 121B Kanun dipinda dengan menggantikan perkataan “imprisonment for life” dengan perkataan “imprisonment for a term of not less than thirty years but not exceeding forty years”. Pindaan seksyen 122"
      }
    },
    {
