      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan 374a(a) Kanun dipinda dengan memasukkan selepas perkataan “with death” perkataan “or imprisonment for a term of not less than thirty years but not exceeding forty years and if not sentenced to death, shall also be punished with whipping of not less than twelve strokes”. Pindaan seksyen 450"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_II__cl_38",
      "@type": "akn:clause",
