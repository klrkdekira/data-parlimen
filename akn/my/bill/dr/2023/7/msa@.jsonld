      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2), dengan menggantikan perkataan “be punished with whipping of not less than fifteen strokes” dengan perkataan “be punished with whipping of not less than twelve strokes”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2023/7/msa@/~part_VI__cl_54__para_b",
