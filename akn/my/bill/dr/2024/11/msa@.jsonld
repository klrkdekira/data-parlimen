      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Keselamatan Sosial Pekerja (Pindaan) 2024."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/11/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
