      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Employment Insurance System (Amendment) Act 2024."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/12/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/12/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Amendment of section 16"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/12/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/12/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Employment Insurance System Act 2017 [Act 800], which is referred to as the “principal Act” in this Act, is amended in subsection 16(2) by substituting for the words “five thousand ringgit” wherever appearing the words “six thousand ringgit”. Amendment of Second Schedule"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/12/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
