      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Constitution (Amendment) Act 2024."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/13/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/13/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Yang di-Pertuan Agong by notification in the Gazette and the Yang di-Pertuan Agong may appoint different dates for the coming into operation of different provisions of this Act. Amendment of Article 15"
      }
    },
