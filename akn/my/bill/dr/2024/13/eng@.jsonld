        "@value": "in section 19b, by substituting for the words “a mother permanently resident there” the words “a mother who is a citizen.” Saving"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/13/eng@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/13/eng@/~cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/13/eng@/~cl_12__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/13/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/13/eng@/~cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/13/eng@/~cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The status of citizenship of any person born within or outside the Federation before the date of coming into operation of this Act shall, on the date of coming into operation of this Act, be dealt with in accordance with Part III of the Federal Constitution as if the Federal Constitution had not been amended by this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/13/eng@/~cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/13/eng@/~cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "Any application made by any person to the Federal Government under Part III of the Federal Constitution which is pending before the date of coming into operation of this Act shall, on the date of coming into operation of this Act, be dealt with in accordance with Part III of the Federal Constitution as if the Federal Constitution had not been amended by this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/13/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
