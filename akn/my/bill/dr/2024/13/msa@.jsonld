      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan tajuk “Sumpah Pemohon bagi Pendaftaran atau Penaturalisasian” dengan tajuk “Sumpah Pelepasan, Kesetiaan dan Taat Setia”. Pindaan Jadual Kedua"
      }
    },
