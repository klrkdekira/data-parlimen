      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “bapa” di mana-mana jua terdapat dengan perkataan “ibu atau bapa”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/13/msa@/~cl_11__para_b__subpara_ii__subpara_B",
