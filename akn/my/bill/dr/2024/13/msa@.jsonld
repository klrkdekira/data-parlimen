      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “sesuatu Negeri” perkataan “dan dalam masa satu tahun selepas kelahiran itu berlaku atau dalam masa apa-apa tempoh yang lebih lanjut sebagaimana yang dibenarkan oleh Kerajaan Persekutuan dalam mana-mana hal tertentu, kelahiran itu didaftarkan di suatu konsulat Persekutuan atau dengan Kerajaan Persekutuan”;"
      }
    },
