      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (b), dengan menggantikan noktah di hujung perenggan itu dengan perkataan “; dan”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/13/msa@/~cl_2__para_a__subpara_iii",
      "@type": "akn:subparagraph",
