        "@language": "ms",
        "@value": "dalam subseksyen (1), dengan memotong perkataan “, (d)”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/13/msa@/~cl_11__para_a__subpara_ii__subpara_B",
      "@type": "akn:subparagraph",
      "eli:number": "B",
