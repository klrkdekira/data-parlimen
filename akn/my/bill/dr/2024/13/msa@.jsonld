      "schema:text": {
        "@language": "ms",
        "@value": "Perkara 15a Perlembagaan Persekutuan dipinda dengan menggantikan perkataan “dua puluh satu tahun” dengan perkataan “lapan belas tahun”. Pemotongan Perkara 16a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/13/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
