      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “kematian bapa itu” dengan perkataan “kematian ibu atau bapanya itu”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/13/msa@/~cl_11__para_b__subpara_ii__subpara_D",
      "@type": "akn:subparagraph",
      "eli:number": "D",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/13/msa@/~cl_11__para_b__subpara_ii",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “sekiranya dia mati selepas Hari Merdeka hendaklah disifatkan sebagai taraf atau perihalan yang terpakai baginya pada masa kematiannya” dengan perkataan “sekiranya ibu atau bapanya mati selepas Hari Merdeka hendaklah disifatkan sebagai taraf atau perihalan yang terpakai bagi ibu atau bapanya pada masa kematian ibu atau bapanya; dan"
      }
    },
