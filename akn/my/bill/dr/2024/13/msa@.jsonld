      "schema:text": {
        "@language": "ms",
        "@value": "Perkara 26 Perlembagaan Persekutuan dipinda dalam Fasal (2) dengan menggantikan perkataan “tarikh perkahwinan itu” dengan perkataan “tarikh pemerolehan kewarganegaraan melalui pendaftaran”. Pindaan Perkara 26a"
      }
    },
