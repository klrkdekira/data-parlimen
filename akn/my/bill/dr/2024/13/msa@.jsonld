      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “yang bapanya” dengan perkataan “dan sekurang-kurangnya seorang daripada ibu bapanya”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/13/msa@/~cl_11__para_a__subpara_i__subpara_B__subpara_BB",
