      "schema:name": {
        "@language": "ms",
        "@value": "Jadual Pertama kepada Perlembagaan Persekutuan dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/13/msa@/~cl_10__para_a",
