      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “[Perkara 18(1), 19(9)]” dengan perkataan “[Perkara 18(1), 18(1a), 19(9) dan seksyen 3 Bahagian II Jadual Kedua]”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/13/msa@/~cl_10__para_b",
