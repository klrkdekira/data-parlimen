      "schema:name": {
        "@language": "ms",
        "@value": "Perlembagaan Persekutuan dipinda dengan memotong"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "Perkara 16a. Pindaan Perkara 18"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/13/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/13/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Perkara 18 Perlembagaan Persekutuan dipinda dengan memasukkan selepas Fasal (1) Fasal yang berikut: “(1a) Seseorang di bawah umur lapan belas tahun yang menjadi warganegara melalui pendaftaran hendaklah, apabila mencapai umur lapan belas tahun, mengangkat sumpah yang dinyatakan dalam Jadual Pertama, dan jika orang itu tidak mengangkat sumpah dalam masa empat puluh lapan bulan selepas dia mencapai umur lapan belas tahun, dia hendaklah terhenti menjadi warganegara.”. Pindaan Perkara 19"
      }
    },
