      "schema:text": {
        "@language": "ms",
        "@value": "dalam Fasal (2), dengan menggantikan perkataan “dua puluh satu tahun” dengan perkataan “lapan belas tahun”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/13/msa@/~cl_2__para_c",
      "@type": "akn:paragraph",
