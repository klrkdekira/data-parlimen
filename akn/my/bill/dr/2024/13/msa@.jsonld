      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan (b) perenggan yang berikut: “(c) bahawa dia mempunyai pengetahuan yang mencukupi dalam bahasa Melayu.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/13/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
