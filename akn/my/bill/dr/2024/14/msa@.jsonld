      ],
      "schema:name": {
        "@language": "ms",
        "@value": "RUU Suruhanjaya Penerbangan Malaysia (Pembubaran) 2024"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa perintah, pengecualian, notis, arahan atau keputusan yang dibuat atau diberikan oleh Suruhanjaya di bawah Akta Suruhanjaya Penerbangan Malaysia 2015 sebelum tarikh permulaan kuat kuasa Akta ini hendaklah, pada tarikh permulaan kuat kuasa Akta ini, disifatkan telah dibuat atau diberikan oleh Pihak Berkuasa di bawah Akta Pihak Berkuasa Penerbangan Awam Malaysia 2017 sehingga tarikh habis tempoh perintah, pengecualian, notis, arahan atau keputusan itu dan tertakluk kepada terma dan syarat yang dikaitkan dengan perintah, pengecualian, notis, arahan atau keputusan itu. Keanggotaan Suruhanjaya, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_11__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_11__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Anggota Suruhanjaya yang memegang jawatan dan anggota mana-mana jawatankuasa yang dilantik di bawah Akta Suruhanjaya Penerbangan Malaysia 2015 sebelum tarikh permulaan kuat kuasa Akta ini hendaklah, pada tarikh permulaan kuat kuasa Akta ini, terhenti daripada memegang jawatan atau terhenti daripada menjadi anggota jawatankuasa, mengikut mana-mana yang berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana anggota Suruhanjaya, kecuali Ketua Setiausaha Kementerian Pengangkutan tidak boleh, dalam masa dua tahun dari tarikh permulaan kuat kuasa Akta ini, membuat apa-apa kontrak perkhidmatan atau menjalankan atau terlibat dalam apa-apa perniagaan atau aktiviti lain yang dijalankan bagi maksud keuntungan, dalam atau yang berhubungan dengan, penerbangan, melainkan jika dengan kelulusan bertulis Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_11__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana anggota Suruhanjaya yang, sebelum tarikh permulaan kuat kuasa Akta ini, telah terhenti menjadi anggota Suruhanjaya, hendaklah terus tidak membuat apa-apa kontrak perkhidmatan atau menjalankan atau terlibat dalam apa-apa perniagaan atau aktiviti lain yang dijalankan bagi maksud keuntungan, dalam atau yang berhubungan dengan, penerbangan sehingga tarikh habis tempoh dua tahun dari tarikh pemberhentiannya, melainkan jika dengan kelulusan bertulis Menteri. Penerusan prosiding"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_12__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa prosiding atau kausa tindakan oleh atau terhadap Suruhanjaya yang belum selesai atau yang wujud sebelum tarikh permulaan kuat kuasa Akta ini boleh diteruskan atau dimulakan oleh atau terhadap Pihak Berkuasa sebagaimana prosiding atau kausa tindakan itu boleh diteruskan atau dimulakan oleh atau terhadap Suruhanjaya jika Akta ini tidak diluluskan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa rayuan yang dibawa, atau apa-apa kebenaran untuk merayu yang dipohon, pada atau selepas tarikh permulaan kuat kuasa Akta ini, terhadap sesuatu keputusan yang diberikan sebelum tarikh permulaan kuat kuasa Akta ini dalam mana-mana prosiding undang-undang yang Suruhanjaya menjadi suatu pihak boleh dibawa oleh atau terhadap Pihak Berkuasa sebagaimana rayuan atau kebenaran untuk merayu itu boleh dibawa atau dimohon oleh atau terhadap Suruhanjaya jika Akta ini tidak diluluskan. Penerusan undang-undang, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_13__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada Akta ini, semua undang-undang bertulis termasuk perundangan subsidiari yang berkuat kuasa sebelum tarikh permulaan kuat kuasa Akta ini hendaklah, sehingga dipinda atau dibatalkan, terus berkuat kuasa dan ditafsirkan seolah-olah Akta ini tidak pernah diluluskan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa sebutan mengenai Suruhanjaya dalam mana-mana undang-undang bertulis termasuk perundangan subsidiari atau dokumen hendaklah ditafsirkan sebagai sebutan mengenai Pihak Berkuasa. Peletakhakan harta, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_14__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_14__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_14__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_14__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_14__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada Akta ini, Menteri boleh, dari semasa ke semasa, melalui perintah yang disiarkan dalam Warta, menetapkan suatu tarikh peletakhakan dan pada tarikh itu semua harta, hak, kepentingan, obligasi dan liabiliti Suruhanjaya yang dinyatakan oleh Menteri dalam perintah itu hendaklah, menurut kuasa Akta ini, dipindahkan kepada dan terletak hak pada Pihak Berkuasa tanpa apa-apa pemindahhakan, penyerahhakan atau pemindahan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap harta, hak, kepentingan, obligasi dan liabiliti yang dipindahkan kepada dan terletak hak pada Suruhanjaya hendaklah dipindahkan kepada dan terletak hak pada Pihak Berkuasa dengan hakmilik, estet atau kepentingan yang serupa dan dengan tempoh pemegangan yang serupa sebagaimana harta, hak, kepentingan, obligasi dan liabiliti itu terletak hak atau dipegang sebelum tarikh peletakhakan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_14__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana tanah yang sebelum tarikh permulaan kuat kuasa Akta ini terletak hak pada Suruhanjaya hendaklah, pada tarikh peletakhakan, terletak hak pada Pihak Berkuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_14__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika menurut kuasa subseksyen (1), apa-apa harta yang dipindahkan kepada dan terletak hak pada Pihak Berkuasa, peruntukan Bahagian Tiga Puluh Kanun Tanah Negara [Akta 828] hendaklah, bagi maksud melaksanakan pendaftaran bagi peletakhakan itu, terpakai bagi Pihak Berkuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_14__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana harta dan aset selain tanah yang sebelum tarikh permulaan kuat kuasa Akta ini terletak hak pada Suruhanjaya hendaklah, pada tarikh peletakhakan, terletak hak pada Pihak Berkuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_14__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam hal harta, hak, kepentingan, obligasi dan liabiliti yang berbangkit di bawah apa-apa pinjaman yang terletak hak pada Pihak Berkuasa pada tarikh peletakhakan, Pihak Berkuasa boleh membuat perjanjian atau perkiraan mengenai hak, kepentingan, obligasi dan liabiliti itu dengan mana-mana orang lain."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Suruhanjaya Penerbangan Malaysia (Pembubaran) 2024."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta. Tafsiran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Dalam Akta ini, melainkan jika konteksnya menghendaki makna yang lain—"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "“Kumpulan Wang Perkhidmatan Awam” ertinya Kumpulan Wang Perkhidmatan Awam yang ditubuhkan di bawah seksyen 27 Akta Suruhanjaya Penerbangan Malaysia 2015; “Kumpulan Wang Pihak Berkuasa Penerbangan Awam Malaysia” ertinya Kumpulan Wang Pihak Berkuasa Penerbangan Awam Malaysia yang ditubuhkan di bawah seksyen 26 Akta Pihak Berkuasa Penerbangan Awam Malaysia 2017; “Kumpulan Wang Suruhanjaya Penerbangan” ertinya Kumpulan Wang Suruhanjaya Penerbangan yang ditubuhkan di bawah seksyen 25 Akta Suruhanjaya Penerbangan Malaysia 2015; “Menteri” ertinya Menteri yang dipertanggungkan dengan tanggungjawab bagi pengangkutan; “Pihak Berkuasa” ertinya Pihak Berkuasa Penerbangan Awam Malaysia yang ditubuhkan di bawah seksyen 3 Akta Pihak Berkuasa Penerbangan Awam Malaysia 2017; “Suruhanjaya” ertinya Suruhanjaya Penerbangan Malaysia yang ditubuhkan di bawah seksyen 3 Akta Suruhanjaya Penerbangan Malaysia 2015. Pemansuhan dan pembubaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Suruhanjaya Penerbangan Malaysia 2015 dimansuhkan dan Suruhanjaya yang ditubuhkan di bawah Akta itu dibubarkan. Pemindahan kuasa, hak, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua kuasa, hak, kewajipan, liabiliti dan obligasi yang sebelum tarikh permulaan kuat kuasa Akta ini adalah kuasa, hak, kewajipan, liabiliti dan obligasi Suruhanjaya hendaklah, pada tarikh permulaan kuat kuasa Akta ini, diturunkan kepada Pihak Berkuasa. Pemindahan Kumpulan Wang Suruhanjaya Penerbangan dan Kumpulan Wang Perkhidmatan Awam"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua wang yang ada pada, atau kena dibayar kepada, Kumpulan Wang Suruhanjaya Penerbangan dan Kumpulan Wang Perkhidmatan Awam hendaklah, pada tarikh permulaan kuat kuasa Akta ini, dipindahkan kepada Kumpulan Wang Pihak Berkuasa Penerbangan Awam Malaysia. Kontrak sedia ada, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua perjanjian, surat ikatan, dokumen dan surat cara lain yang wujud sebelum tarikh permulaan kuat kuasa Akta ini dan menyentuh mana-mana harta atau wang yang dipindahkan di bawah Akta ini hendaklah terus berkuat kuasa dan berkesan sepenuhnya, terhadap atau memihak kepada Pihak Berkuasa, dan boleh dikuatkuasakan sepenuhnya dan dengan berkesannya seolah-olah, bukannya Suruhanjaya, tetapi Pihak Berkuasa yang telah dinamakan dalam perjanjian, surat ikatan, dokumen dan surat cara lain itu dan telah menjadi suatu pihak kepada perjanjian, surat ikatan, dokumen dan surat cara lain itu. Perjanjian pengendalian dan konsesi sedia ada"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_7__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang diberi kuasa untuk menjalankan perkhidmatan dan aktiviti yang dinyatakan dalam sesuatu perjanjian berkenaan dengan apa-apa perjanjian pengendalian atau konsesi yang wujud sebelum tarikh permulaan kuat kuasa Akta ini hendaklah menjalankan perkhidmatan dan aktiviti itu sehingga tarikh habis tempoh perjanjian itu dan tertakluk kepada terma dan syarat yang dikaitkan dengan perjanjian itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada apa pun dalam seksyen ini boleh ditafsirkan sebagai melanjutkan tempoh atau jangka masa sesuatu perjanjian yang dinyatakan dalam subseksyen (1) melampaui tarikh habis tempohnya. Kecualian bagi permohonan dan aduan yang belum selesai"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa permohonan yang dibuat atau aduan yang diterima di bawah Akta Suruhanjaya Penerbangan Malaysia 2015 yang masih belum selesai sebelum tarikh permulaan kuat kuasa Akta ini hendaklah, pada tarikh permulaan kuat kuasa Akta ini, diuruskan di bawah Akta Pihak Berkuasa Penerbangan Awam Malaysia 2017. Kecualian bagi lesen, permit dan hak trafik udara"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_9__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_9__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_9__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap orang yang, sebelum tarikh permulaan kuat kuasa Akta ini, memegang suatu lesen atau permit yang sah yang dikeluarkan kepadanya di bawah Akta Penerbangan Awam 1969 [Akta 3] atau Peraturan-Peraturan Penerbangan Awam 2016 [P.U. (A) 97/2016], atau Akta Suruhanjaya Penerbangan Malaysia 2015, atau diuntukkan kepadanya apa-apa hak trafik udara bagi laluan domestik atau antarabangsa oleh Kerajaan, atau Suruhanjaya di bawah Akta Suruhanjaya Penerbangan Malaysia 2015 hendaklah, pada tarikh permulaan kuat kuasa Akta ini, disifatkan sebagai pemegang lesen atau permit yang sah, atau telah diuntukkan kepadanya apa-apa hak trafik udara bagi laluan domestik atau antarabangsa di bawah Akta Pihak Berkuasa Penerbangan Awam Malaysia 2017 sehingga tarikh habis tempoh lesen, permit atau hak itu dan tertakluk kepada terma dan syarat yang dikaitkan dengan lesen, permit atau hak itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada apa pun dalam seksyen ini boleh ditafsirkan sebagai melanjutkan tempoh atau jangka masa lesen, permit atau hak yang dinyatakan dalam subseksyen (1) melampaui tarikh habis tempohnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_9__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Pihak Berkuasa boleh mengubah terma dan syarat yang dikaitkan dengan lesen, permit atau hak yang diberi kuasa di bawah subseksyen (1) bagi maksud menyelaraskan lesen, permit atau hak itu dengan Akta Pihak Berkuasa Penerbangan Awam Malaysia 2017."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_9__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/14/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Peruntukan yang berhubungan dengan pembatalan lesen, permit atau hak di bawah Akta Pihak Berkuasa Penerbangan Awam Malaysia 2017 hendaklah terpakai bagi orang yang disebut dalam subseksyen (1). Kecualian bagi perintah, dsb."
      }
    }
  ]
}
