      "schema:text": {
        "@language": "en",
        "@value": "in the shoulder note, by substituting for the words “Delegation of powers” the words “Delegation of functions and powers”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/15/eng@/~cl_12__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/15/eng@/~cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (1), by substituting for the words “delegate its powers which relate to administrative matters” the words “delegate its functions and powers relating to administrative and operational matters”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/15/eng@/~cl_12__para_c",
      "@type": "akn:paragraph",
