      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/17/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/17/eng@/~cl_29__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/17/eng@/~cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "All references to “drug dependants” in any written law shall, on the coming into operation of this Act, be construed as references to “drug or substance dependant”. (Amendment)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/17/eng@/~cl_29__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/17/eng@/~cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "Any action, application, approval or proceedings commenced or pending immediately before the coming into operation of this Act shall, after the date of coming into operation of this Act, be continued as if the principal Act had not been amended by this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/17/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/17/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended in the heading of Part 1 by substituting for the words “Part 1” the words “Part I”. Amendment of section 1"
      }
    },
