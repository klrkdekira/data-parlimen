    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/17/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/17/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by substituting for the heading of Part 2 the following heading: “Part II TREATMENT AND REHABILITATION OF DRUG OR SUBSTANCE DEPENDANTS AND DRUG OR SUBSTANCE MISUSERS UNDER COURT ORDER”. Amendment of section 3"
      }
    },
