      "schema:text": {
        "@language": "en",
        "@value": "in the national language text, by substituting for the words “ibu bapa” wherever appearing the words “ibu atau bapa”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/17/eng@/~cl_13__para_b__subpara_ii",
