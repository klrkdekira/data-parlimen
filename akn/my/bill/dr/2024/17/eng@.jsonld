      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the definition of “drug dependant” the following definition: ‘ “drug or substance dependant” means a person who through the use of any dangerous drug or substance indicates the characteristics of dependency on the dangerous drug or substance that affects self-control which is verified by tests;’;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/17/eng@/~cl_5__para_a__subpara_vii",
      "@type": "akn:subparagraph",
