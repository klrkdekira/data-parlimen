      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/17/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting after section 31 the following schedule: “SCHEDULE [Section 2] SUBSTANCES 1. Psychotropic substances as specified in the Third Schedule of the Poisons Act 1952 [Act 366] 2. Toluene”. Saving"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/17/eng@/~cl_29",
