      "schema:text": {
        "@language": "ms",
        "@value": "dalam takrif “pegawai”, dengan memasukkan selepas perkataan “Pegawai Pemulihan” perkataan “, mana-mana pegawai Agensi yang dilantik di bawah seksyen 5 Akta Agensi Antidadah Kebangsaan 2004”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/17/msa@/~cl_5__para_a__subpara_ix",
      "@type": "akn:subparagraph",
      "eli:number": "ix",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/17/msa@/~cl_5__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan takrif “ujian-ujian” dengan takrif yang berikut: ‘ “ujian” ertinya semua perbuatan atau tatacara yang dijalankan bagi maksud menentukan sama ada seseorang itu penagih dadah atau bahan atau penyalah guna dadah atau bahan.’; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/17/msa@/~cl_5__para_a__subpara_v",
      "@type": "akn:subparagraph",
