      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan sebelum takrif “dadah berbahaya” takrif yang berikut: ‘ “bahan” ertinya mana-mana bahan yang dinyatakan dalam Jadual;’;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/17/msa@/~cl_5__para_a__subpara_ii",
