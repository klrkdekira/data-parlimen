      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 1 Akta ibu dipinda dengan menggantikan perkataan “Penagih Dadah” dengan perkataan “Penagih dan Penyalah Guna Dadah dan Bahan”. Pindaan seksyen 2"
      }
    },
