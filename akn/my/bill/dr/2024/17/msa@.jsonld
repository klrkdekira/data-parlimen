      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/17/msa@/~cl_26__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (c)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/17/msa@/~cl_26__para_a__subpara_i__subpara_A",
      "@type": "akn:subparagraph",
      "eli:number": "A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/17/msa@/~cl_26__para_a__subpara_i",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “Pusat-Pusat Pemulihan,” perkataan “Pusat Khidmat”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/17/msa@/~cl_26__para_a__subpara_i__subpara_B",
      "@type": "akn:subparagraph",
      "eli:number": "B",
