      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan menggantikan tajuk Bahagian 4 dengan tajuk yang berikut: “BAHAGIAN IV PUSAT BAGI RAWATAN DAN PEMULIHAN”. Pindaan seksyen 10"
      }
    },
