      "schema:text": {
        "@language": "ms",
        "@value": "dalam takrif “Ketua Pengarah”, dengan menggantikan perkataan “subseksyen (2)” dengan perkataan “seksyen 4 Akta Agensi Antidadah Kebangsaan 2004 [Akta 638]”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/17/msa@/~cl_5__para_a__subpara_iii",
