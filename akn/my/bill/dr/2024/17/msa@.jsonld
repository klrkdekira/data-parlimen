      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “Pusat-Pusat Pemulihan itu” perkataan “, Pusat Khidmat”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/17/msa@/~cl_26__para_a__subpara_ii",
      "@type": "akn:subparagraph",
