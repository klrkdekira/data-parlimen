    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_III__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Bahagian III Akta yang dicadangkan memperkatakan tentang penubuhan dan fungsi Jawatankuasa Fatwa Wilayah-Wilayah Persekutuan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_III__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 7 bertujuan untuk mengadakan peruntukan bagi penubuhan Jawatankuasa Fatwa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_III__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 8 bertujuan untuk mengadakan peruntukan bagi fungsi Jawatankuasa Fatwa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_III__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 9 bertujuan untuk mengadakan peruntukan bagi pembatalan pelantikan dan peletakan jawatan anggota Jawatankuasa Fatwa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Bahagian II Akta yang dicadangkan memperkatakan peruntukan yang berhubungan dengan Mufti dan Timbalan Mufti."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 3 bertujuan untuk mengadakan peruntukan bagi pelantikan Mufti, Timbalan Mufti dan kelayakan untuk menjadi Mufti dan Timbalan Mufti."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 4 bertujuan untuk mengadakan peruntukan bagi fungsi Mufti."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_II__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 5 bertujuan untuk mengadakan peruntukan bagi pembatalan pelantikan dan peletakan jawatan Mufti dan Timbalan Mufti."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_II__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 6 bertujuan untuk mengadakan peruntukan bagi pengosongan jawatan Mufti dan Timbalan Mufti."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_IV__cl_14",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_IV__cl_15",
