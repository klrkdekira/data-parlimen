    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_VIII__cl_34",
      "@type": "akn:clause",
      "eli:number": "34",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_VIII",
      "schema:text": {
        "@language": "ms",
        "@value": "Bahagian VIII Akta yang dicadangkan memperkatakan penubuhan dan fungsi Jawatankuasa Pengawasan Pengajaran Agama Islam Wilayah-Wilayah Persekutuan dan perunding akidah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_VIII__cl_35",
      "@type": "akn:clause",
      "eli:number": "35",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_VIII",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 26 bertujuan untuk mengadakan peruntukan bagi penubuhan dan keanggotaan Jawatankuasa Pengawasan Pengajaran Agama Islam."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_VIII__cl_36",
      "@type": "akn:clause",
      "eli:number": "36",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_VIII",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 27 bertujuan untuk mengadakan peruntukan bagi fungsi dan kuasa Jawatankuasa Pengawasan Pengajaran Agama Islam."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_VIII__cl_37",
      "@type": "akn:clause",
      "eli:number": "37",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_VIII",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 28 bertujuan untuk mengadakan peruntukan bagi pembatalan pelantikan dan peletakan jawatan anggota Jawatankuasa Pengawasan Pengajaran Agama Islam."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_VIII__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_VIII",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 29 bertujuan untuk memberi Mufti kuasa untuk melantik mana-mana orang yang layak dan sesuai dalam kalangan orang yang beragama Islam sebagai seorang perunding akidah. Fasal ini juga memperkatakan fungsi perunding akidah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_VII__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Bahagian VII Akta yang dicadangkan memperkatakan penubuhan dan fungsi Jawatankuasa Rukyah Hilal Wilayah-Wilayah Persekutuan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_VII__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 22 bertujuan untuk mengadakan peruntukan bagi penubuhan Jawatankuasa Rukyah Hilal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_VII__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 23 bertujuan untuk mengadakan peruntukan bagi fungsi Jawatankuasa Rukyah Hilal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_VII__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 24 bertujuan untuk mengadakan peruntukan bagi pembatalan pelantikan dan peletakan jawatan anggota Jawatankuasa Rukyah Hilal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_VII__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 25 bertujuan untuk mengadakan peruntukan bagi kaedah penetapan bagi awal bulan Ramadan, Syawal dan Zulhijah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_VI__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Bahagian VI Akta yang dicadangkan memperkatakan penubuhan dan fungsi Jawatankuasa Falak Syarie Wilayah-Wilayah Persekutuan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_VI__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 19 bertujuan untuk mengadakan peruntukan bagi penubuhan Jawatankuasa Falak Syarie."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_VI__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 20 bertujuan untuk mengadakan peruntukan bagi fungsi Jawatankuasa Jawatankuasa Falak Syarie."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_VI__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 21 bertujuan untuk mengadakan peruntukan bagi pembatalan pelantikan dan peletakan jawatan anggota Jawatankuasa Falak Syarie."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_V__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Bahagian V Akta yang dicadangkan memperkatakan penentuan arah kiblat, kesalahan dan penalti."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_V__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 17 bertujuan untuk memberi Mufti kuasa untuk menentukan, menyemak dan mengesahkan arah kiblat. Fasal ini juga menghendaki bahawa apa-apa permohonan untuk menentukan, menyemak dan mengesahkan arah kiblat hendaklah dibuat kepada Mufti."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_V__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 18 bertujuan untuk menjadikannya suatu kesalahan bagi mana-mana orang yang mengeluarkan sijil pengesahan arah kiblat tanpa kebenaran Mufti, menentukan, menyemak atau mengesahkan arah kiblat tanpa kebenaran Mufti dan dengan sengaja mengubah arah kiblat yang telah disahkan oleh Mufti."
      }
    }
  ]
}
