        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_IV__cl_18",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_IV__cl_19",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_IV__cl_20",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_IV__cl_21"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_IV__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Bahagian IV Akta yang dicadangkan mengandungi peruntukan yang berhubungan dengan pengeluaran fatwa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_IV__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 10 bertujuan untuk mengadakan peruntukan bagi tatacara mengeluarkan fatwa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_IV__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 11 bertujuan untuk memperuntukkan bahawa fatwa adalah mengikat tiap-tiap orang yang beragama Islam di Wilayah-Wilayah Persekutuan dan diiktiraf oleh mana-mana mahkamah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_IV__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 12 bertujuan untuk mengadakan peruntukan bagi pindaan, ubah suaian dan pembatalan fatwa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_IV__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 13 bertujuan untuk mengadakan peruntukan bagi tatacara mengeluarkan fatwa bagi isu dan persoalan yang menyentuh kepentingan negara."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_IV__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 14 bertujuan untuk memperuntukkan bahawa Jawatankuasa Fatwa boleh menerima pakai nasihat dan syor Jawatankuasa Muzakarah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_IV__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 15 bertujuan untuk memperuntukkan bahawa mahkamah boleh meminta pendapat Mufti dan pendapat itu boleh dijadikan panduan kepada mahkamah tetapi tidak mengikat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_IV__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 16 bertujuan untuk menyatakan panduan yang perlu diikuti oleh Jawatankuasa Fatwa dalam mengeluarkan fatwa yang berhubungan dengan syariah, akidah dan tasawuf."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_IX",
      "@type": "akn:part",
      "eli:number": "IX",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_IX__cl_39",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_IX__cl_40",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_IX__cl_41",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_IX__cl_42",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_IX__cl_43",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_IX__cl_44",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_IX__cl_45",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_IX__cl_46"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_IX__cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_IX",
      "schema:text": {
        "@language": "ms",
        "@value": "Bahagian IX Akta yang dicadangkan memperkatakan peruntukan pelbagai."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_IX__cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_IX",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 30 bertujuan untuk memberikan kuasa kepada Mufti untuk mengenakan dan mengecualikan mana-mana orang daripada membayar apa-apa fi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_IX__cl_41",
      "@type": "akn:clause",
      "eli:number": "41",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_IX",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 31 bertujuan untuk memperuntukkan bahawa mana-mana orang yang dilantik di bawah Akta yang dicadangkan boleh dibayar apa-apa elaun sebagaimana yang ditentukan oleh Majlis."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_IX__cl_42",
      "@type": "akn:clause",
      "eli:number": "42",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_IX",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 32 bertujuan untuk mengadakan peruntukan bagi perlindungan Mufti, Timbalan Mufti, perunding akidah dan anggota jawatankuasa yang dilantik di bawah Akta yang dicadangkan daripada apa-apa tindakan guaman atau prosiding lain."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_IX__cl_43",
      "@type": "akn:clause",
      "eli:number": "43",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_IX",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 33 bertujuan untuk mengadakan peruntukan bagi perlindungan Mufti, Timbalan Mufti, perunding akidah dan anggota jawatankuasa yang dilantik di bawah Akta yang dicadangkan di bawah Akta Perlindungan Pihak Berkuasa Awam 1948."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_IX__cl_44",
      "@type": "akn:clause",
      "eli:number": "44",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_IX",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 34 memperuntukkan bahawa perunding akidah dan tiap-tiap anggota jawatankuasa yang dilantik di bawah Akta yang dicadangkan hendaklah disifatkan sebagai pekhidmat awam mengikut pengertian Kanun Keseksaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_IX__cl_45",
      "@type": "akn:clause",
      "eli:number": "45",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_IX",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 35 bertujuan untuk mengadakan peruntukan bahawa Yang di-Pertuan Agong boleh, atas nasihat Menteri selepas berunding dengan Mufti, membuat kaedah-kaedah bagi maksud melaksanakan peruntukan Akta yang dicadangkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_IX__cl_46",
      "@type": "akn:clause",
      "eli:number": "46",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_IX",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 36 bertujuan untuk mengadakan peruntukan bahawa Menteri selepas berunding dengan Mufti boleh, dengan kelulusan Yang di-Pertuan Agong, meminda Jadual Pertama, Kedua dan Ketiga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_I",
      "schema:text": {
        "@language": "ms",
        "@value": "Bahagian I Akta yang dicadangkan memperkatakan perkara permulaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_I__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_I",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 1 mengandungi tajuk ringkas, pemakaian dan permulaan kuat kuasa Akta yang dicadangkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_I__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/19/msa@/~part_I",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 2 mengandungi takrif bagi perkataan dan ungkapan tertentu yang digunakan dalam Akta yang dicadangkan."
      }
    },
