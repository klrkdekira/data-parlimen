      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (f), by inserting the word “or” at the end of the paragraph;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/21/eng@/~cl_12__para_c__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
