      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (g), by substituting for the words “; or” at the end of the paragraph a full stop; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/21/eng@/~cl_12__para_c__subpara_iv",
