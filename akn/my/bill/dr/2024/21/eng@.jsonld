      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words “upon as far as practicable by cheques signed by such persons as may be authorized by the Minister.” the words “in such manner as may be authorized by the Commissioner.”. Amendment of section 129"
      }
    },
    {
