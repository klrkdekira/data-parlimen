      "schema:text": {
        "@language": "en",
        "@value": "by deleting the words “, after consulting the Minister,”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/21/eng@/~cl_11__para_b",
      "@type": "akn:paragraph",
