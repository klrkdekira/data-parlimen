      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/25/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 6 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/25/eng@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/25/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (2) the following subsection: “(2 a) Notwithstanding subsection (2), a video recording may be admitted without being accompanied by the transcript of the original language used in the video recording and translation of the transcript if the Court is satisfied that the transcript of the original language is not feasible to be prepared.”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/25/eng@/~cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/25/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting subsections (7) and (8)."
      }
    }
  ]
