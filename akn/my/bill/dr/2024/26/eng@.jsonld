      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Evidence (Amendment) Act 2024."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/26/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/26/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Amendment of section 118"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/26/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/26/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Evidence Act 1950 [Act 56], which is referred to as the “principal Act” in this Act, is amended in section 118 by deleting the words “tender years,”. Deletion of section 133a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/26/eng@/~cl_3",
