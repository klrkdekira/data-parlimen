      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/28/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Sexual Offences against Children (Amendment) Act 2024."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/28/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/28/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Deletion of Part VI"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/28/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/28/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Sexual Offences against Children Act 2017 [Act 792], which is referred to as the “principal Act” in this Act, is amended by deleting Part VI. Amendment of Schedule"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/28/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/28/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Schedule to the principal Act is amended in the heading by deleting the words “17, 18,”."
      }
