      "schema:text": {
        "@language": "en",
        "@value": "a training in a specialty provided by the Ministry of Health;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_11__subsec_6__para_a__subpara_ii",
