      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_11__subsec_8",
      "schema:text": {
        "@language": "en",
        "@value": "any other institution within or outside Malaysia, for the purpose of being entitled to be registered as a Specialist, shall be deemed to undergo a specialized training under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_11__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_11__subsec_9__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_11__subsec_9__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_11__subsec_9__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "Any training in a specialty, before the date of coming into operation of this Act, provided by—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_11__subsec_9__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_11__subsec_9",
      "schema:text": {
        "@language": "en",
        "@value": "the Ministry of Health;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_11__subsec_9__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_11__subsec_9",
      "schema:text": {
        "@language": "en",
        "@value": "local higher educational institution; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_11__subsec_9__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_11__subsec_9",
      "schema:text": {
        "@language": "en",
        "@value": "any other institution within Malaysia, for the purpose of registration of a Specialist, shall be deemed to be a specialized training under this Act. Validation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Any remuneration and allowance paid to a person who is deemed to be registered as a Specialist under subsection 11(6) of this Act is hereby validated and declared to have been lawfully paid."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Medical (Amendment) Act 2024."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette and the Minister may appoint different dates for the coming into operation of different provisions of this Act. Amendment of section 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_2__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Medical Act 1971 [Act 50], which is referred to as the “principal Act” in this Act, is amended in section 2—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting the definition of “recognized training institution”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the definition of “houseman training” the following definition: ‘ “local higher educational institution” means— (a) any university or university college established in accordance with the Universities and University Colleges Act 1971 [Act 30]; (b) University Teknologi MARA established in accordance with the Universiti Teknologi MARA Act 1976 [Act 173]; (c) any private higher educational institution governed under the Private Higher Educational Institutions Act 1996 [Act 555]; or (d) any other local university or other local higher educational institutions established under other written laws;’;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting the definition of “recognized specialist qualification”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the definition of “Specialist” the following definition: ‘ “specialized training” means a specialized training referred to in subsection 14b(3);’; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "in the definition of “registered medical practitioner”, by inserting after the words “section 14” the words “, or registered as a specialist under section 14c”. Amendment of section 3a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Subsection 3a(1) of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (b), by substituting for the word “nine” the word “five”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (d), by substituting for the word “three” the word “seven”. Amendment of section 4a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Subsection 4a(2) of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (g), by deleting the word “and” at the end of the paragraph;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for paragraph (h) the following paragraph: “(h) recognize qualifications for registration of medical practitioners under this Act;”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after paragraph (h) the following paragraphs: “(i) recognize specialized training for registration of specialists under this Act; and (j) appoint any registered medical practitioner to represent the Council in any committee, panel or institution where that person would subsequently make recommendations to the Council on all matters relating to the qualification of medical practitioner or the regulation of the practice of medicine.”. Amendment of section 14"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraph 14(2 a)(a) of the principal Act is amended by substituting for the words “recognized training programme in any recognized training institution” the words “training programme in any institution as determined by the Council”. Substitution of section 14b"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by substituting for section 14b the following section: “Person entitled to be registered as Specialist 14b. (1) A person is entitled to be registered as a Specialist under this Act if— (a) he has been fully registered under section 14; (b) he holds any of the specialist qualifications as specified in the fourth column of the Fourth Schedule for a duration of recognition that may be determined by the Council; (c) he has completed a specialized training; (d) he has— (i) successfully undergone supervised work experience that shall be determined by the Council; or (ii) proven his work experience to the satisfaction of the Council; and (e) he has proven to the satisfaction of the Council that he is competent and is of good character. (2) Notwithstanding paragraph (1)(b) or (c), any person may be entitled to be registered as a Specialist under section 14c where the Minister, upon the recommendation of the Council, is satisfied that he has any other comparable qualification or comparable specialized training, as the case may be, which is of special value to this country, subject to such restrictions and conditions as the Minister thinks fit. (3) The specialized training referred to in this Act shall be construed as a reference to— (a) a training approved by the Council in relation to a specialty as specified in the first column of the Fourth Schedule as provided by— (i) the Ministry of Health; (ii) a local higher educational institution; or (iii) any other institutions within Malaysia as approved by the Council; or (b) any other training acceptable to the Council which is provided outside Malaysia in relation to a specialty as specified in the first column of the Fourth Schedule or subspecialty as specified in the Fifth Schedule. (4) The Minister may from time to time, after consulting the Council, add to, delete from or amend the Fourth Schedule and Fifth Schedule by order published in the Gazette.’’. Substitution of section 14c"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by substituting for section 14c the following section: “Registration as Specialist 14c. (1) Where the requirements under section 14b have been fulfilled, the Council shall consider the application made under subsection 18(1) and may require the applicant to produce further information or documents in support of the application. (2) Where the Council decides to approve the application, the Council shall direct the Registrar to enter the applicant’s name in the Register. (3) The Council may refuse to register any person who is not entitled to be registered as a Specialist under section 14b and shall immediately serve a notice of refusal by stating the reasons of such refusal to the applicant.”. New section 14d"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting after section 14c the following section: “Registration in subspecialty 14d. Any Specialist who has been registered under this Act may make an application to be registered in a subspecialty as specified in the Fifth Schedule in the form and manner as may be determined by the Council and subject to such restrictions and conditions as the Council thinks fit.”. Amendment of section 36"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_9__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_9__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_9__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Subsection 36(2) of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_9__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for paragraph (u) the following paragraph: “(u) the form and manner in recognizing a qualification;”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_9__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting the word “and” at the end of paragraph (dd); and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_9__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after paragraph (dd) the following paragraph: “(dda) all matters relating to specialized training; and”. New Fourth and Fifth Schedules"
      }
    }
  ]
}
