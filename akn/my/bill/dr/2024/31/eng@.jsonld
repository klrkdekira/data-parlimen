      "schema:text": {
        "@language": "en",
        "@value": "a training in a specialty provided by a local higher educational institution in which such training conducted at Ministry of Health facilities; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_11__subsec_6__para_a__subpara_iii",
