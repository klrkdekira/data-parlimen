    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_11__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_11__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_11__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_11__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_11__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_11__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_11__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_11__subsec_9"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "The members of the Council and the members of any committee appointed before the date of coming into operation of this Act shall continue to hold office until their appointments are revoked or until the expiry of their terms of appointment."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "All applications, approvals or decisions pending before the Council under the principal Act shall, on the date of coming into operation of this Act, be dealt with by the Council in accordance with the provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_11__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "All instruments, certificates or documents submitted to the Council under the principal Act before the date of coming into operation of this Act shall, on the date of coming into operation of this Act, be deemed to have been submitted to the Council."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_11__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "Any proceedings pending on the date of coming into operation of this Act before the Preliminary Investigation Committee, Disciplinary Panel, Disciplinary Board or the Council established under the principal Act shall, after the date of coming into operation of this Act, be continued as if the principal Act had not been amended by this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_11__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "Any disciplinary offence committed or alleged to have been committed by a medical practitioner before the date of coming into operation of this Act shall, after the date of coming into operation of this Act, be dealt with in accordance with the principal Act as if the principal Act had not been amended by this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/31/eng@/~cl_11__subsec_6",
      "@type": "akn:subsection",
