      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 87 Akta ibu dipinda dalam takrif “kawasan utama kastam” dengan menggantikan perkataan “dan Pangkor” dengan perkataan “, Pangkor dan Pulau 1”. Pindaan seksyen 90a"
      }
    },
