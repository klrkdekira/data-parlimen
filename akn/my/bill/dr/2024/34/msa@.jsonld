        "@value": "RUU Eksais (Pindaan) 2024"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/34/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
