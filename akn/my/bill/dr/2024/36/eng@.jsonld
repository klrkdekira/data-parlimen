      ],
      "schema:name": {
        "@language": "en",
        "@value": "Sales Tax (Amendment) Bill 2024"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Sales Tax (Amendment) Act 2024."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Amendment of section 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/eng@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/eng@/~cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Sales Tax Act 2018 [Act 806], which is referred to as the “principal Act” in this Act, is amended in subsection 2(1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "in the definition of “designated areas”, by substituting for the words “and Pangkor” the words “, Pangkor and Pulau 1”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting the after definition of “petroleum” the following definition: ‘ “Pulau 1” has the meaning assigned to it under subsection 2(1) of the Customs Act 1967;’. Amendment of section 49"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/eng@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/eng@/~cl_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 49 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/eng@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by renumbering the existing section as subsection (1); and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/eng@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the renumbered subsection (1) the following subsection: “(2) In the case of Pulau 1, this Act shall apply to any taxable goods manufactured in Pulau 1, other than any goods which the Minister may declare by order published in the Gazette.”. New section 49a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting after section 49 the following section: “Retail trade in Pulau 1 49a. (1) No person shall sell by retail any goods declared by the Minister under paragraph 50(2)(a) in Pulau 1 without approval of the Minister. (2) An application for the approval under subsection (1) shall be made in the manner as precribed by the Minister in the regulations. (3) Any person who contravenes this section commits an offence and shall, on conviction, be liable to a fine not exceeding fifty thousand ringgit or to imprisonment for a term not exceeding three years or to both.”. Amendment of section 50"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/eng@/~cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/eng@/~cl_5__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/eng@/~cl_5__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 50 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/eng@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "by renumbering the existing section as subsection (1);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/eng@/~cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "in the renumbered paragraph (1)(a), by inserting after the words “designated areas” wherever appearing the words “other than Pulau 1”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/eng@/~cl_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the renumbered subsection (1) the following subsection: “(2) Where the designated area is Pulau 1— (a) sales tax shall be levied and payable on all goods— (i) imported into Pulau 1; or (ii) transported from Malaysia, designated areas or special areas to Pulau 1, other than goods which the Minister may from time to time declare by order published in the Gazette; (b) sales tax shall be levied and payable on all goods declared by the Minister under paragraph (a) transported from Pulau 1 to Malaysia as if such transportation to Malaysia were importation into Malaysia; (c) no sales tax shall be levied and payable on any goods declared by the Minister under paragraph (a) transported from Pulau 1 to other designated areas or special areas; and (d) the sale value of taxable goods liable to sales tax in accordance with paragraph (a) or (b) shall be determined in accordance with subsection 9(2).”. Amendment of section 54"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 54 of the principal Act is amended by substituting for the words “paragraph 50(a)” the words “paragraph 50(1)(a) or 50(2)(a)”. Amendment of section 57"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/eng@/~cl_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/eng@/~cl_7__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 57 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/eng@/~cl_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/eng@/~cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "by renumbering the existing section as subsection (1); and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/eng@/~cl_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/eng@/~cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the renumbered subsection (1) the following subsection: “(2) Notwithstanding subsection (1), where the designated area under subparagraph (1)(a)(iii) is Pulau 1, no sales tax shall be levied and payable on any taxable goods declared by the Minister under paragraph 50(2)(a) transported from special areas to Pulau 1.”."
      }
    }
  ]
}
