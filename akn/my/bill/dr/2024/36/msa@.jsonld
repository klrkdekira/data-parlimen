      ],
      "schema:name": {
        "@language": "ms",
        "@value": "RUU Cukai Jualan (Pindaan) 2024"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Cukai Jualan (Pindaan) 2024."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta. Pindaan seksyen 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/msa@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/msa@/~cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Cukai Jualan 2018 [Akta 806], yang disebut “Akta ibu” dalam Akta ini, dipinda dalam subseksyen 2(1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam takrif “kawasan ditetapkan”, dengan menggantikan perkataan “dan Pangkor” dengan perkataan “, Pangkor dan Pulau 1”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif “petroleum” takrif yang berikut: ‘ “Pulau 1” mempunyai erti yang diberikan kepadanya di bawah subseksyen 2(1) Akta Kastam 1967;’. Pindaan seksyen 49"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/msa@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/msa@/~cl_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 49 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/msa@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menomborkan semula seksyen sedia ada sebagai subseksyen (1); dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/msa@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (1) yang dinomborkan semula subseksyen yang berikut: “(2) Dalam hal Pulau 1, Akta ini hendaklah terpakai bagi apa-apa barang bercukai yang dikilangkan di Pulau 1, selain apa-apa barang yang diisytiharkan oleh Menteri melalui suatu perintah yang disiarkan dalam Warta.”. Seksyen baharu 49a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memasukkan selepas seksyen 49 seksyen yang berikut: “Perniagaan runcit di Pulau 1 49a. (1) Tiada seorang pun boleh menjual secara runcit apa-apa barang yang diisytiharkan oleh Menteri di bawah perenggan 50(2)(a) di Pulau 1 tanpa kelulusan Menteri. (2) Permohonan bagi kelulusan di bawah subseksyen (1) hendaklah dibuat mengikut cara yang ditetapkan oleh Menteri dalam peraturan-peraturan. (3) Mana-mana orang yang melanggar seksyen ini melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tiga tahun atau kedua-duanya sekali.”. Pindaan seksyen 50"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/msa@/~cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/msa@/~cl_5__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/msa@/~cl_5__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 50 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/msa@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menomborkan semula seksyen sedia ada sebagai subseksyen (1);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/msa@/~cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (1)(a) yang dinomborkan semula, dengan memasukkan selepas perkataan “kawasan ditetapkan” di mana-mana jua terdapat perkataan “selain Pulau 1”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/msa@/~cl_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (1) yang dinomborkan semula subseksyen yang berikut: “(2) Jika kawasan ditetapkan ialah Pulau 1— (a) cukai jualan hendaklah dilevikan dan kena dibayar ke atas semua barang— (i) diimport ke dalam Pulau 1; atau (ii) diangkut dari Malaysia, kawasan ditetapkan atau kawasan khas ke Pulau 1, selain barang yang diisytiharkan dari semasa ke semasa oleh Menteri melalui perintah yang disiarkan dalam Warta; (b) cukai jualan hendaklah dilevikan dan kena dibayar ke atas semua barang yang diisytiharkan oleh Menteri di bawah perenggan (a) diangkut dari Pulau 1 ke Malaysia seolah-olah pengangkutan ke Malaysia itu ialah pengimportan ke dalam Malaysia; (c) tiada cukai jualan boleh dilevikan dan kena dibayar ke atas apa-apa barang yang diisytiharkan oleh Menteri di bawah perenggan (a) diangkut dari Pulau 1 ke kawasan ditetapkan yang lain atau kawasan khas; dan (d) nilai jualan barang bercukai yang boleh dikenakan cukai jualan mengikut perenggan (a) atau (b) hendaklah ditentukan mengikut subseksyen 9(2).”. Pindaan seksyen 54"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 54 Akta ibu dipinda dengan menggantikan perkataan “perenggan 50(a)” dengan perkataan “perenggan 50(1)(a) atau 50(2)(a)”. Pindaan seksyen 57"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/msa@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/msa@/~cl_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/msa@/~cl_7__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 57 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/msa@/~cl_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menomborkan semula seksyen sedia ada sebagai subseksyen (1); dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/msa@/~cl_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/36/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (1) yang dinomborkan semula subseksyen yang berikut: “(2) Walau apa pun subseksyen (1), jika kawasan ditetapkan di bawah subperenggan (1)(a)(iii) ialah Pulau 1, tiada cukai jualan boleh dilevikan dan kena dibayar ke atas apa-apa barang bercukai yang diisytiharkan oleh Menteri di bawah perenggan 50(2)(a) yang diangkut dari kawasan khas ke Pulau 1.”."
      }
    }
  ]
}
