      "schema:name": {
        "@language": "en",
        "@value": "Section 34 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/39/eng@/~cl_10__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/39/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "in the shoulder note, by substituting for the word “KLRCA” the words “Asian International Arbitration Centre”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/39/eng@/~cl_10__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/39/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (1), by substituting for the word “KLRCA” the words “Asian International Arbitration Centre”. Amendment of section 39"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/39/eng@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/39/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 39 of the principal Act is amended by substituting for the word “KLRCA” the words “Asian International Arbitration Centre”. Amendment of section 40"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/39/eng@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/39/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 40 of the principal Act is amended by substituting for the word “KLRCA” the words “Asian International Arbitration Centre”. Saving"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/39/eng@/~cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/39/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "All appointments made by the Director of the KLRCA before the coming into operation of this Act shall, on the coming into operation of this Act, be deemed to have been made by the President of the Asian International Arbitration Centre Court of Arbitration and shall continue to remain in force and have effect until revoked by the President of the Asian International Arbitration Centre Court of Arbitration."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/39/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/39/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Construction Industry Payment and Adjudication (Amendment) Act 2024."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/39/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/39/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Amendment of section 4"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/39/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/39/eng@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/39/eng@/~cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/39/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Construction Industry Payment and Adjudication Act 2012 [Act 746], which is referred to as the “principal Act” in this Act, is amended in section 4—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/39/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/39/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the definition of “payment” the following definition: ‘ “President” means the President of the Asian International Arbitration Centre Court of Arbitration;’; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/39/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/39/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting the definition of “KLRCA”. Amendment of section 12"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/39/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/39/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 12(6) of the principal Act is amended by substituting for the words “Director of the KLRCA” the words “Asian International Arbitration Centre”. Amendment of section 16"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/39/eng@/~cl_4",
