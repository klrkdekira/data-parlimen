    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/40/eng@/~cl_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/40/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "The Declaration of an Area in the Bintulu District to be a Federal Port Act 1979 [Act 217] is repealed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/40/eng@/~cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/40/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "Any orders made under the repealed Act shall, on the date of coming into operation of this Act, cease to have effect."
      }
    }
