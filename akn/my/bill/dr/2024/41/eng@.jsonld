        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_12"
      ],
      "schema:name": {
        "@language": "en",
        "@value": "Bintulu Port Authority (Dissolution) Bill 2024"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_10__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to this Act, all written laws including subsidiary legislation in force before the date of coming into operation of this Act shall, until amended or revoked, continue in force and be construed as if this Act had not been passed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "Any reference to the Authority in any written law including subsidiary legislation or document shall be construed as a reference to the Bintulu Port Authority (Sarawak). Vesting of property, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_11__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_11__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_11__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_11__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to this Act, the Minister may, from time to time, by order published in the Gazette, appoint a vesting date and on such date all properties, rights, interests, obligations and liabilities of the Authority specified by the Minister in the order shall, by virtue of this Act, be transferred to and vested in the Government or the Government of the State of Sarawak or any entity empowered or appointed by the Government of the State of Sarawak under the relevant written laws, in accordance with the written consent of the Government and the Government of the State of Sarawak without any conveyance, assignment or transfer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "Every property, rights, interest, obligation and liability transferred to and vested in the Authority shall be transferred to and vested in the Government or the Government of the State of Sarawak or any entity empowered or appointed by the Government of the State of Sarawak under the relevant written laws, in accordance with the written consent of the Government and the Government of the State of Sarawak, for the like title, estate or interest and on the like tenure as the property, rights, interest, obligation and liability were vested or held before the vesting date."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_11__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "Any land which before the date of coming into operation of this Act was vested in the Authority shall, on the vesting date, be vested in the Government of the State of Sarawak."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_11__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to section 5, any property and asset other than land which before the date of coming into operation of this Act were vested in the Authority shall, on the vesting date, be vested in the Government of the State of Sarawak or any entity empowered or appointed by the Government of the State of Sarawak under the relevant written laws."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_11__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "In the case of properties, rights, interests, obligations and liabilities arising under any loan which are vested in the Government or the Government of the State of Sarawak or any entity empowered or appointed by the Government of the State of Sarawak under the relevant written laws on the vesting date, the Government or the Government of the State of Sarawak or any entity empowered or appointed by the Government of the State of Sarawak under the relevant written laws may enter into agreements or arrangements over the rights, interests, obligations and liabilities with any other person. Written consent"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "In this Act, “written consent” means a consent of both the Government and the Government of the State of Sarawak as specified in any document or instruments certified and verified by the Government and the Government of the State of Sarawak."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Bintulu Port Authority (Dissolution) Act 2024."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "In this Act, unless the context otherwise requires—"
      },
      "schema:text": {
        "@language": "en",
        "@value": "“Bintulu Port Authority (Sarawak)” means the Bintulu Port Authority (Sarawak) established under section 3 of the Port Authorities Ordinance 1961 [Ord. No. 1/61]; “Authority” means the Bintulu Port Authority established under section 3 of the Bintulu Port Authority Act 1981; “Minister” means the Minister charged with the responsibility for transport. Repeal and dissolution"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Bintulu Port Authority Act 1981 [Act 243] is repealed and the Authority established under the Act is dissolved. Transfer of powers, rights, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "All powers, rights, duties, liabilities and obligations which before the date of coming into operation of this Act were the powers, rights, duties, liabilities and obligations of the Authority shall, on the date of coming into operation of this Act, be devolved on the Government or the Government of the State of Sarawak or any entity empowered or appointed by the Government of the State of Sarawak under the relevant written laws, in accordance with the written consent of the Government and the Government of the State of Sarawak. Transfer of financial assets"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_5__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "All financial assets standing in, or due to be paid to, the Authority shall, on the date of coming into operation of this Act, be transferred to the Government."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "In this section, “financial asset” means any asset owned by the Authority including loans given, receivables from exchange dealings and investments, which can be liquidated to cash value. Deposit, advanced receipt and lease rent"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_6__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_6__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "On the date of coming into operation of this Act—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "all rental deposits and lease deposits standing in to the Authority;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "all advanced receipts of lease standing in to the Authority; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_6__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "lease rent due to be paid to the Authority, shall be transferred to the Government of the State of Sarawak or any entity empowered or appointed by the Government of the State of Sarawak under the relevant written laws. Existing contracts, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "All agreements, deeds, documents and other instruments subsisting before the date of coming into operation of this Act and affecting any property or money transferred under this Act shall continue to remain in full force and effect, against or in favour of the Government or the Government of the State of Sarawak or any entity empowered or appointed by the Government of the State of Sarawak under the relevant written laws, in accordance with the written consent of the Government and the Government of the State of Sarawak, and enforceable as fully and effectually as if, instead of the Authority, the Government or the Government of the State of Sarawak or any entity empowered or appointed by the Government of the State of Sarawak under the relevant written laws had been named in the agreements, deeds, documents and other instruments and had been a party to the agreements, deeds, documents and other instruments. Saving for licence"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_8__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_8__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_8__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "Every person who, before the date of coming into operation of this Act, held a valid licence issued to him under the Bintulu Port Authority Act 1981 shall, on the date of coming into operation of this Act, be deemed to be the licence holder under the Port Authorities Ordinance 1961 until the date of expiry of the licence and subject to the terms and conditions attached to the licence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "Nothing in this section shall be construed to extend the term or duration of the licence specified in subsection (1) beyond the date of its expiry."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_8__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "The Bintulu Port Authority (Sarawak) may alter the terms and conditions attached to the licence under subsection (1) for the purpose of bringing the licence into conformity with the Port Authorities Ordinance 1961."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_8__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "The provisions relating to the revocation of a licence under the Port Authorities Ordinance 1961 shall apply to the persons referred to in subsection (1). Continuance of proceedings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_9__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_9__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "Any proceedings or cause of action by or against the Authority pending or exists before the date of coming into operation of this Act may be continued or instituted by or against the Bintulu Port Authority (Sarawak) as the proceedings or cause of action might have been continued or instituted by or against the Authority if this Act had not been passed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/41/eng@/~cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "Any appeal brought, or any leave to appeal applied for, on or after the date of coming into operation of this Act, against a decision given before the date of coming into operation of this Act in any legal proceedings in which the Authority was a party may be brought by or against the Bintulu Port Authority (Sarawak) as the appeal or leave of appeal might have been brought or applied by or against the Authority if this Act had not been passed."
      }
    },
    {
