      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Water Services Industry Act 2006 [Act 655], which is referred to as the “principal Act” in this Act, is amended in section 2 in the national language text, in the definition of “lengkapan air”, by inserting after the words “(selain sesalur utama awam)” a comma. Amendment of section 61"
      }
    },
