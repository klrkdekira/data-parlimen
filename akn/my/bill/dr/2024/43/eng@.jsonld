      "schema:text": {
        "@language": "en",
        "@value": "Subparagraph 180(a)(iv) of the principal Act is amended in the national language text, by substituting for the word “sistem” the word “perkhidmatan” wherever appearing."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
