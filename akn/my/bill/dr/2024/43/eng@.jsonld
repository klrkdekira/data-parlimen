      "schema:text": {
        "@language": "en",
        "@value": "Subsection 165(1) of the principal Act is amended in the national language text, by inserting after the word “ialah” the words “pengarah,”. Amendment of section 173"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/eng@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 173(1) of the principal Act is amended in the national language text, by substituting for the word “and” the word “dan”. Amendment of section 174"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/eng@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraph 174(1)(a) of the principal Act is amended in the English language text, by inserting after the words “septic tank” a comma. Amendment of section 180"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/eng@/~cl_13",
