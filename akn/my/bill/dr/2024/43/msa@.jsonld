      "schema:text": {
        "@language": "ms",
        "@value": "perkataan “lima puluh ribu” dengan perkataan “satu juta”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@/~cl_7__para_c__subpara_ii",
