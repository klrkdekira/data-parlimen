      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 110 Akta ibu dipinda dalam teks bahasa kebangsaan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (7)(b), dengan memasukkan selepas perkataan “sebagaimana yang diperuntukkan di bawah” perkataan “Ordinan Tanah Sabah sebagaimana yang diubah suai oleh”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@/~cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (8), dengan menggantikan perkataan “subseksyen (1)” dengan perkataan “subseksyen (3)”. Pindaan seksyen 121"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@/~cl_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@/~cl_6__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@/~cl_6__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 121 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@/~cl_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (1) subseksyen yang berikut: “(1a) Seseorang yang mencemarkan atau menyebabkan supaya dicemarkan mana-mana alur air atau sistem bekalan air atau mana-mana bahagian alur air itu atau sistem bekalan air itu dengan apa-apa bahan yang menyebabkan atau berkemungkinan menyebabkan pemberhentian sementara atau penutupan sistem bekalan air atau gangguan bekalan air, melakukan suatu kesalahan.”."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@/~cl_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@/~cl_6__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@/~cl_6__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@/~cl_6__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@/~cl_6__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@/~cl_6__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “subseksyen (1)” perkataan “atau (1a)”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@/~cl_6__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@/~cl_6__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (b), dengan menggantikan perkataan “sepuluh tahun atau didenda tidak melebihi lima ratus ribu ringgit” dengan perkataan “lima belas tahun atau didenda tidak kurang daripada lima ratus ribu ringgit dan tidak melebihi lima belas juta ringgit”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@/~cl_6__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@/~cl_6__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (c), dengan menggantikan perkataan “tidak melebihi satu ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi satu tahun atau kedua-duanya” dengan perkataan “tidak kurang daripada dua ratus ribu ringgit dan tidak melebihi sepuluh juta ringgit atau dipenjarakan selama tempoh tidak melebihi sepuluh tahun atau kedua-duanya”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@/~cl_6__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (2) subseksyen yang berikut: “(2a) Seseorang yang disabitkan atas suatu kesalahan di bawah subseksyen (1) atau (1a), boleh dikehendaki membayar kos yang ditanggung oleh pemegang lesen untuk memulihkan sistem bekalan air yang telah terjejas disebabkan oleh pencemaran itu. (2b) Mahkamah hendaklah, dalam membuat suatu perintah di bawah subseksyen (2a), mengambil kira faktor yang berikut: (a) kesan pencemaran itu; (b) kos yang ditanggung oleh pemegang lesen itu; (c) kerosakan pada, atau kerugian, harta yang dialami oleh pemegang lesen itu; dan (d) apa-apa faktor lain yang difikirkan relevan oleh mahkamah. (2c) Bagi maksud membuat suatu perintah di bawah subseksyen (2a), mahkamah boleh mengadakan suatu siasatan sebagaimana yang difikirkan patut oleh mahkamah. (2d) Seksyen 432 Kanun Tatacara Jenayah [Akta 593] hendaklah terpakai bagi apa-apa perintah yang dibuat di bawah seksyen ini.”. Pindaan seksyen 122"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@/~cl_7",
