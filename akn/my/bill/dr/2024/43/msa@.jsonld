        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@/~cl_3__para_d__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@/~cl_3__para_d__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@/~cl_3__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “subseksyen (1)” perkataan “atau (1a)”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@/~cl_3__para_d__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@/~cl_3__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “satu ratus ribu” dengan perkataan “satu juta”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@/~cl_3__para_d__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@/~cl_3__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “satu tahun” dengan perkataan “sepuluh tahun”. Pindaan seksyen 86"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 86(1) Akta ibu dipinda dalam teks bahasa kebangsaan dengan memasukkan selepas perkataan “pemegang lesen” perkataan “perkhidmatan”. Pindaan seksyen 110"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@/~cl_5",
      "@type": "akn:clause",
