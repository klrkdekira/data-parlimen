      "schema:name": {
        "@language": "ms",
        "@value": "RUU Industri Perkhidmatan Air (Pindaan) 2024"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 165(1) Akta ibu dipinda dalam teks bahasa kebangsaan, dengan memasukkan selepas perkataan “ialah” perkataan “pengarah,”. Pindaan seksyen 173"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 173(1) Akta ibu dipinda dalam teks bahasa kebangsaan, dengan menggantikan perkataan “and” dengan perkataan “dan”. Pindaan seksyen 174"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan 174(1)(a) Akta ibu dipinda dalam teks bahasa Inggeris, dengan memasukkan selepas perkataan “septic tank” koma. Pindaan seksyen 180"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@/~cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subperenggan 180(a)(iv) Akta ibu dipinda dalam teks bahasa kebangsaan, dengan menggantikan perkataan “sistem” dengan perkataan “perkhidmatan” di mana-mana jua terdapat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Industri Perkhidmatan Air (Pindaan) 2024."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta. Pindaan seksyen 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Industri Perkhidmatan Air 2006 [Akta 655], yang disebut “Akta ibu” dalam Akta ini, dipinda dalam seksyen 2 dalam teks bahasa kebangsaan, dalam takrif “lengkapan air”, dengan memasukkan selepas perkataan “(selain sesalur utama awam)” koma. Pindaan seksyen 61"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@/~cl_3__para_b",
