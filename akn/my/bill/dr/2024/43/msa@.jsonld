      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 123(3) Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@/~cl_8__para_a",
