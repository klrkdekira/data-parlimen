      "schema:text": {
        "@language": "ms",
        "@value": "perkataan “enam bulan” dengan perkataan “sepuluh tahun”. Pindaan seksyen 123"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/43/msa@/~cl_8",
