      "schema:name": {
        "@language": "ms",
        "@value": "RUU Perbekalan 2025"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/45/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/45/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Perbekalan 2025. Pengeluaran dan peruntukan untuk perkhidmatan bagi tahun 2025"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/45/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/45/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengeluaran sejumlah wang yang tidak melebihi dua ratus tiga puluh dua bilion sembilan ratus lima puluh empat juta empat belas ribu tiga ratus ringgit (RM232,954,014,300) daripada Kumpulan Wang Disatukan untuk perkhidmatan bagi tahun 2025 adalah dengan ini dibenarkan dan jumlah wang itu diperuntukkan bagi maksud-maksud yang dinyatakan dalam Jadual."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/45/msa@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/45/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Maksud Tajuk B. 1 Parlimen Malaysia B. 2 Pejabat Penyimpan Mohor Besar Raja-Raja B. 3 Jabatan Audit Negara B. 4 Suruhanjaya Pilihan Raya B. 5 Suruhanjaya Perkhidmatan Awam B. 6 Jabatan Perdana Menteri B. 7 Jabatan Perkhidmatan Awam B. 8 Jabatan Peguam Negara B. 9 Suruhanjaya Pencegahan Rasuah Malaysia B. 10 Perbendaharaan B. 11 Perkhidmatan Am Perbendaharaan B. 12 Peruntukan kepada Kumpulan Wang Terkanun B. 13 Kementerian Luar Negeri B. 14 Kementerian Perpaduan Negara B. 15 Kementerian Ekonomi B. 20 Kementerian Perladangan dan Komoditi B. 21 Kementerian Pertanian dan Keterjaminan Makanan B. 22 Kementerian Kemajuan Desa dan Wilayah B. 23 Kementerian Sumber Asli dan Kelestarian Alam B. 24 Kementerian Pelaburan, Perdagangan dan Industri B. 25 Kementerian Perdagangan Dalam Negeri dan Kos Sara Hidup B. 26 Kementerian Pembangunan Usahawan dan Koperasi B. 27 Kementerian Kerja Raya B. 28 Kementerian Pengangkutan Maksud Tajuk B. 30 Kementerian Sains, Teknologi dan Inovasi B. 31 Kementerian Pelancongan, Seni dan Budaya B. 33 Kementerian Peralihan Tenaga dan Transformasi Air B. 40 Suruhanjaya Perkhidmatan Pendidikan B. 42 Kementerian Kesihatan B. 43 Kementerian Perumahan dan Kerajaan Tempatan B. 45 Kementerian Belia dan Sukan B. 46 Kementerian Sumber Manusia B. 47 Kementerian Komunikasi B. 48 Kementerian Pembangunan Wanita, Keluarga dan Masyarakat B. 50 Kementerian Digital B. 60 Kementerian Pertahanan B. 62 Kementerian Dalam Negeri B. 63 Kementerian Pendidikan B. 64 Kementerian Pendidikan Tinggi Jumlah"
      }
