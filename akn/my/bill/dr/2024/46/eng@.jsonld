      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/46/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the National Wages Consultative Council (Amendment) Act 2024."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/46/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/46/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Amendment of section 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/46/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/46/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The National Wages Consultative Council Act 2011 [Act 732] is amended in section 2 by substituting for the definition of “contract of service” the following definition: ‘ “contract of service” has the same meaning assigned to it in section 2 of the Employment Act 1955 [Act 265], section 2 of the Sabah Labour Ordinance [Cap. 67] and section 2 of the Sarawak Labour Ordinance [Cap. 76];’."
      }
    }
