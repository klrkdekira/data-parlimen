        "@value": "dalam butiran 29, dalam ruang “Proper Stamp Duty”, dengan menggantikan perkataan “15 cent” dengan perkataan “RM1.00”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/48/msa@/~chp_IV__cl_27__para_d",
