      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/48/msa@/~chp_VII__cl_33__para_i",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam formula, dalam huraian D, dengan memotong perkataan “the Domestic Top-up Tax, being”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/48/msa@/~chp_VII__cl_33__para_i__subpara_ii__subpara_i",
