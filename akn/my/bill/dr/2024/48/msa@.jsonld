      "schema:text": {
        "@language": "ms",
        "@value": "Bab ini mula berkuat kuasa pada tarikh dan dalam cara yang sama dengan tarikh dan cara seksyen 30 Akta Kewangan (No. 2) 2023 mula berkuat kuasa. Pindaan seksyen 30"
      }
    },
