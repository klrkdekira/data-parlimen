      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perenggan 239(b) dengan perenggan yang berikut: “(b) section 138 shall apply to this Part and the reference to “the income of any person or partnership” in the definition of “classified material” in subsection 138(5) shall be construed as a reference to “the tax of any Constituent Entity”; and”."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/48/msa@/~chp_VI__cl_30",
