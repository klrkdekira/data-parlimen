      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/48/msa@/~chp_IV__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan butiran 12 dengan butiran yang berikut: Item Description of Instrument “12 ASSIGNMENT: (a) By way of security or of any security Item Description of Instrument (b) Upon a sale or otherwise (c) Of policy of life insurance— (i) by way of gift or trust, where the sum insured— (A) does not exceed RM100,000.00 (B) exceeds RM100,000.00 but does not exceed RM500,000.00 (C) exceeds RM500,000.00 but does not exceed RM1,000,000.00 (D) exceeds RM1,000,000.00 (ii) in any other case"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/48/msa@/~chp_IV__cl_27__para_b",
      "@type": "akn:paragraph",
