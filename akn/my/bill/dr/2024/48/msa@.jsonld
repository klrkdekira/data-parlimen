      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan 47(1)(b) Akta ibu dipinda dengan menggantikan perkataan “five thousand ringgit” dengan perkataan “six thousand ringgit”. Pindaan seksyen 48"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/48/msa@/~chp_II__cl_12",
      "@type": "akn:clause",
