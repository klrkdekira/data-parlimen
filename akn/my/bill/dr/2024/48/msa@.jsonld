      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (4), dengan menggantikan perkataan “Where” dengan perkataan “Subject to subsection (6), where”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/48/msa@/~chp_VII__cl_33__para_n__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
