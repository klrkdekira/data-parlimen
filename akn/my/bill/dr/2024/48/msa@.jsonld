      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen 180(9), dengan memasukkan selepas perkataan “amortisation,” perkataan “impairment loss”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/48/msa@/~chp_VII__cl_33__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
