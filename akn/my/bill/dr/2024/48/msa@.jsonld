      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 34(6) Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/48/msa@/~chp_II__cl_6__para_a",
