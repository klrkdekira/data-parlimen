      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen 173(6), dengan memasukkan selepas perkataan “adjustment” perkataan “under subsections (1) to (5)”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/48/msa@/~chp_VII__cl_33__para_g",
