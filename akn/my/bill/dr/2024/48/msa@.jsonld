      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 4, 8, 11, 12, 13, 14, 15, 16 dan 17, dan perenggan 9(a), (b), (c), (d) dan (g) berkuat kuasa bagi tahun taksiran 2025 dan tahun-tahun taksiran yang berikutnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/48/msa@/~chp_II__cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/48/msa@/~chp_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 5 dan 10 mula berkuat kuasa pada 1 Januari 2025."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/48/msa@/~chp_II__cl_3__subsec_3",
      "@type": "akn:subsection",
