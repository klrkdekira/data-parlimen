      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perenggan (c) dengan perenggan yang berikut: “(c) any amount of credit or refund for Covered Taxes, except for a Qualified Refundable Tax Credit or Marketable Transferable Tax Credit, to a Constituent Entity that is not treated as an adjustment to current tax expense in the financial accounts;”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/48/msa@/~chp_VII__cl_33__para_f",
