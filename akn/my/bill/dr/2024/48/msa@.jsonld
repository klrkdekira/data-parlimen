      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (q), dengan menggantikan noktah di hujung perenggan itu koma bernoktah; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/48/msa@/~chp_II__cl_4__para_b",
