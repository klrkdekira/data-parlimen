      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/48/msa@/~chp_IV__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subbutiran 22(6), dengan menggantikan perkataan “the conventional hire purchase and Syariah principles” dengan perkataan “any Syariah principles or conventional hire purchase”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/48/msa@/~chp_IV__cl_27__para_c",
