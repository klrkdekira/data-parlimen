      "schema:text": {
        "@language": "ms",
        "@value": "dalam formula, dalam huraian A, dengan menggantikan perkataan “referred to in subsection (1)” dengan perkataan “disposed by a company, limited liability partnership, trust body or co-operative society”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/48/msa@/~chp_II__cl_5__para_e__subpara_i__subpara_D",
