      "schema:text": {
        "@language": "ms",
        "@value": "dalam formula, dalam huraian C, dengan menggantikan perkataan “subsection 169(3) or 181(1)” dengan perkataan “subsections 169(3) and (4) or subsection 181(1)”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/48/msa@/~chp_VII__cl_33__para_i__subpara_ii",
      "@type": "akn:subparagraph",
