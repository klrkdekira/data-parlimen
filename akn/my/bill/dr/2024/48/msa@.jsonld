        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/48/msa@/~chp_II__cl_17__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/48/msa@/~chp_II",
      "schema:name": {
        "@language": "ms",
        "@value": "Perenggan 12B Jadual 6 kepada Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/48/msa@/~chp_II__cl_17__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/48/msa@/~chp_II__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menomborkan semula perenggan sedia ada sebagai subperenggan (1);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/48/msa@/~chp_II__cl_17__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/48/msa@/~chp_II__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subperenggan (1) yang dinomborkan semula itu, dengan memasukkan selepas perkataan “to any person” perkataan “other than an individual”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/48/msa@/~chp_II__cl_17__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/48/msa@/~chp_II__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subperenggan (1) yang dinomborkan semula itu subperenggan yang berikut: “(2) Any dividend paid, credited or distributed to an individual, whether in monetary form or otherwise, amounting to one hundred thousand ringgit or less where the company paying such dividend is not entitled to deduct tax under this Act and any deduction in relation to such dividend shall be disregarded for the purpose of ascertaining the chargeable income of the individual.”."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/48/msa@/~chp_II__cl_3",
      "@type": "akn:clause",
