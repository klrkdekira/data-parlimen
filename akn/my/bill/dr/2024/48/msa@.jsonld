        "@value": "dalam subseksyen (1), dengan menggantikan perkataan “subsection (2)” dengan perkataan “subsection (3)”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/48/msa@/~chp_VII__cl_33__para_n__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
