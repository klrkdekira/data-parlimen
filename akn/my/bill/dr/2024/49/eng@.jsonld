        "@value": "AMENDMENTS TO THE STAMP ACT 1949 Commencement of amendments to the Stamp Act 1949"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/49/eng@/~part_IV__cl_20",
      "@type": "akn:clause",
