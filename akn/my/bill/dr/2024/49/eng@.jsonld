      "schema:text": {
        "@language": "en",
        "@value": "AMENDMENTS TO THE SALES TAX ACT 2018 Commencement of amendments to the Sales Tax Act 2018"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/49/eng@/~part_VIII",
      "@type": "akn:part",
      "eli:number": "VIII",
