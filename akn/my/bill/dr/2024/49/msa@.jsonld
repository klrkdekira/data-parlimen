        "@language": "ms",
        "@value": "PINDAAN KEPADA AKTA SETEM 1949 Permulaan kuat kuasa pindaan kepada Akta Setem 1949"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/49/msa@/~part_IV__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
