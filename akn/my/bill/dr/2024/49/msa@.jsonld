      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/49/msa@/~part_IV__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 22, 25, 26, 27, 34, 36, 37, 38, 40 dan 41 mula berkuat kuasa pada 1 Januari 2025."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/49/msa@/~part_IV__cl_20__subsec_2",
      "@type": "akn:subsection",
