        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/49/msa@/~part_IV__cl_20__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/49/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/49/msa@/~part_IV__cl_20__subsec_1",
