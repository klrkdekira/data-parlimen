      "schema:text": {
        "@language": "ms",
        "@value": "PINDAAN KEPADA AKTA CUKAI JUALAN 2018 Permulaan kuat kuasa pindaan kepada Akta Cukai Jualan 2018"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/49/msa@/~part_VIII",
      "@type": "akn:part",
      "eli:number": "VIII",
