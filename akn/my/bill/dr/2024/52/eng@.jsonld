        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/eng@/~cl_7__para_a__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/eng@/~cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (2)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/eng@/~cl_7__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/eng@/~cl_7__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words “at the commencement of the pupillage” the words “within thirty days from the commencement of the pupillage”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/eng@/~cl_7__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/eng@/~cl_7__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words “or of the firm” the words “or on behalf of the firm or the limited liability law partnership”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/eng@/~cl_7__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/eng@/~cl_7__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for paragraph (b) the following paragraph: “(b) at the expiration of the period of three months from the date of the order, the pupil may appear— (i) in chambers in the High Court and in the subordinate courts, to conduct any cause or matter; and (ii) before any Magistrate to conduct any cause, matter or trial.”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/eng@/~cl_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/eng@/~cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (2) the following subsection: “(2a) Any application under subsection (2) after the expiry of thirty days from the commencement of the pupillage of the Master’s pupil shall not be permitted unless with the leave of court.”. Amendment of section 40a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/eng@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 40a of the principal Act is amended by inserting after the definition of “international partnership” the following definition: ‘ “Malaysian law firm” means a sole proprietorship, a partnership or a limited liability law partnership which carries on the practice of advocates and solicitors under this Act;’. Amendment of section 40f"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/eng@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 40f(1) of the principal Act is amended by inserting after the words “a Malaysian law firm may apply jointly” the words “or by means of a limited liability law partnership formed pursuant to an arrangement between such foreign law firm and Malaysian law firm”. Amendment of section 40o"
      }
    }
  ]
}
