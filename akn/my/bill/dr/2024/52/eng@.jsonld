      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (b), by substituting for the words “or a firm of advocates and solicitors” the words “, a firm of advocates and solicitors or a limited liability law partnership”. Amendment of section 36"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/eng@/~cl_7__para_a",
