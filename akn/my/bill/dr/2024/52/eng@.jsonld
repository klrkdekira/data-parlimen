      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after paragraph (g) the following paragraph: “(h) a true copy of an order obtained under subsection 36(2).”. Amendment of section 30"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/eng@/~cl_6",
