      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/eng@/~cl_14__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for paragraph (d) the following paragraph: “(d) prescribe the conditions which a professional indemnity or an insurance policy must satisfy for the purpose of paragraph (1)(b) or (c)”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/eng@/~cl_14__para_b__subpara_iv",
      "@type": "akn:subparagraph",
