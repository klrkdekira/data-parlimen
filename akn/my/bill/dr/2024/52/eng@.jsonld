      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 36 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/eng@/~cl_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/eng@/~cl_7__para_a__subpara_i",
