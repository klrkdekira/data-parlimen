      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (6) the following subsection: “(6) Any advocate and solicitor, or any partner of or other person involved in the management or control of a limited liability law partnership, who contravenes this section may be liable to disciplinary proceedings.”. Amendment of section 84"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/eng@/~cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/eng@/~cl_18__para_a",
