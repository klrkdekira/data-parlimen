    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/eng@/~cl_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (a), by substituting for the words “or in partnership” the words “, in partnership or in limited liability law partnership”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/eng@/~cl_6__para_b",
      "@type": "akn:paragraph",
