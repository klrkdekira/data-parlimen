        "@language": "en",
        "@value": "by inserting after the words “advocate and solicitor” the words “or a limited liability law partnership”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/eng@/~cl_14__para_b__subpara_iv__subpara_B",
      "@type": "akn:subparagraph",
