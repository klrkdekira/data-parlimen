      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the words “moneys due from an advocate and solicitor” the words “or a limited liability law partnership”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/eng@/~cl_20__para_b__subpara_iii",
      "@type": "akn:subparagraph",
