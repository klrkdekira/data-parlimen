      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/eng@/~cl_51",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after paragraph 9 the following paragraph: “9a. For the purposes of paragraph 9, the Bar Council shall serve on the advocate and solicitor or his firm or the limited liability law partnership, and, except where section 98 applies, on any banker and on any other person having possession or control of any such sums of money a notice, together with a certified copy of the resolution, prohibiting the payment out of such sums of money otherwise than pursuant to paragraph 11 or 12.”."
      }
