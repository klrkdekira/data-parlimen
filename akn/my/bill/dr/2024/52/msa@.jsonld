      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/msa@/~cl_7__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/msa@/~cl_7__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “pada masa bermulanya latihan” dengan perkataan “dalam masa tiga puluh hari dari masa bermulanya latihan”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/msa@/~cl_7__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
