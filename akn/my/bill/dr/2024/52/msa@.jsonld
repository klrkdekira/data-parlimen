      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan nota bahu dengan nota bahu yang berikut: “Mahkamah boleh memerintahkan penyerahan salinan bil kos kepada pemohon”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/msa@/~cl_46__para_b",
