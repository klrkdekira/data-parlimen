      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “seseorang peguam bela dan peguam cara boleh membuat suatu perjanjian secara bertulis dengan kliennya” dengan perkataan “seseorang peguam bela dan peguam cara atau suatu perkongsian guaman liabiliti terhad boleh membuat suatu perjanjian secara bertulis dengan kliennya”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/msa@/~cl_31__para_b__subpara_ii",
