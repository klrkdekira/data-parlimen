      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 129 Akta ibu dipinda dengan memasukkan selepas perkataan “peguam bela dan peguam cara” perkataan “atau perkongsian guaman liabiliti terhad”. Pindaan seksyen 130"
      }
    },
