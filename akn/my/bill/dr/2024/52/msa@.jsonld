      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “bil kos peguam cara” dengan perkataan “bil kos”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/msa@/~cl_45__para_b__subpara_ii",
