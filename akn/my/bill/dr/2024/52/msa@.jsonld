      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “kelakuan lain yang tidak patut pada pihaknya” dengan perkataan “kelakuan lain yang tidak patut pada pihak peguam bela dan peguam cara atau perkongsian guaman liabiliti terhad itu”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/msa@/~cl_35__para_c__subpara_iv",
