      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Jadual kepada Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/msa@/~cl_51__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/msa@/~cl_51",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menamakan semula Jadual yang sedia ada sebagai “JADUAL PERTAMA”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/msa@/~cl_51__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/msa@/~cl_51",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam kepala, dengan memotong perkataan “PEGUAM BELA DAN PEGUAM CARA DALAM HAL TERTENTU”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/msa@/~cl_51__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/msa@/~cl_51",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perenggan 1 dengan perenggan yang berikut: “1. Majlis Peguam boleh menghendaki supaya dikemukakan atau diserahkan kepada mana-mana orang yang dilantik oleh Majlis Peguam pada masa dan di tempat yang akan ditetapkan oleh Majlis Peguam, dan boleh mengambil milikan, semua surat ikatan, wasiat, dokumen yang menjadi bukti atau membuktikan hakmilik terhadap apa-apa harta, kertas, buku akaun, rekod, baucar dan dokumen lain yang ada dalam milikan atau kawalan peguam bela dan peguam cara itu, atau yang ada dalam milikan atau kawalan firma peguam bela dan peguam cara itu atau perkongsian guaman liabiliti terhad yang dia menjalankan amalan, atau yang berhubungan dengan apa-apa amanah yang— (a) peguam bela dan peguam cara itu ialah pemegang amanah tunggal atau pemegang amanah bersama dengan seorang atau lebih pekongsinya, keraninya atau pekhidmatnya; atau (b) perkongsian guaman liabiliti terhad itu ialah pemegang amanah tunggal atau pemegang amanah bersama dengan seorang atau lebih keraninya atau pekhidmatnya.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/msa@/~cl_51__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/msa@/~cl_51",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan 3, dengan memasukkan selepas perkataan “peguam bela dan peguam cara” perkataan “atau perkongsian guaman liabiliti terhad”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/msa@/~cl_51__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/msa@/~cl_51",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan 5, dengan memasukkan selepas perkataan “peguam bela dan peguam cara” perkataan “, perkongsian guaman liabiliti terhad”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/msa@/~cl_51__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/msa@/~cl_51",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan 7, dengan memasukkan selepas perkataan “peguam bela dan peguam cara itu atau firmanya” perkataan “, atau atas nama perkongsian guaman liabiliti terhad itu”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/msa@/~cl_51__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/msa@/~cl_51",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perenggan 9 dengan perenggan yang berikut: “9. Majlis Peguam boleh, atas ketetapan bagi maksud itu yang dibuat oleh Majlis, mengawal semua jumlah wang— (a) yang kena dibayar oleh peguam bela dan peguam cara itu atau kepada firmanya, atau yang dipegang olehnya atau firmanya bagi pihak, kliennya atau klien firmanya atau yang tertakluk kepada apa-apa amanah yang baginya dia ialah pemegang amanah tunggal atau pemegang amanah bersama dengan seorang atau lebih pekongsinya, keraninya atau pekhidmatnya; atau (b) yang kena dibayar oleh atau kepada perkongsian guaman liabiliti terhad itu, atau yang dipegang oleh perkongsian guaman liabiliti terhad itu bagi pihak kliennya atau yang tertakluk kepada apa-apa amanah yang baginya perkongsian guaman liabiliti terhad ialah pemegang amanah tunggal atau pemegang amanah bersama dengan seorang atau lebih keraninya atau pekhidmatnya.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/msa@/~cl_51__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/msa@/~cl_51",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan 9 perenggan yang berikut: “9a. Bagi maksud perenggan 9, Majlis Peguam hendaklah menyampaikan kepada peguam bela dan peguam cara itu atau firmanya atau perkongsian guaman liabiliti terhad itu, dan, kecuali jika seksyen 98 terpakai, kepada mana-mana jurubank dan kepada mana-mana orang lain yang ada dalam milikan atau kawalan ke atas apa-apa jumlah wang itu suatu notis, berserta dengan suatu salinan ketetapan yang diperakui, melarang pembayaran daripada jumlah wang itu selain menurut perenggan 11 atau 12.”;"
      }
    },
