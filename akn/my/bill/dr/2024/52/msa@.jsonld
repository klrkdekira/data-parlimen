      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “peguam bela dan peguam caranya sendiri” perkataan “atau kepada perkongsian guaman liabiliti terhad yang bertindak baginya”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/msa@/~cl_32__para_b",
