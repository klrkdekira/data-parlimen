      "schema:text": {
        "@language": "ms",
        "@value": "dalam nota bahu, dengan memotong perkataan “oleh peguam bela dan peguam cara”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/msa@/~cl_20__para_b",
