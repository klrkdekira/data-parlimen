      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “apa-apa perjanjian itu” dengan perkataan “perjanjian itu”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/msa@/~cl_32__para_a__subpara_ii",
