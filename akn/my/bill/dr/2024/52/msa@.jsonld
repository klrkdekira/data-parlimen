        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/msa@/~cl_41__para_a__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/msa@/~cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/msa@/~cl_41__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/msa@/~cl_41__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “mana-mana peguam bela dan peguam cara” perkataan “atau perkongsian guaman liabiliti terhad”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/msa@/~cl_41__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/msa@/~cl_41__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “atau kepada peguam bela dan peguam cara” dengan perkataan “, atau kepada peguam bela dan peguam cara atau perkongsian guaman liabiliti terhad”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/msa@/~cl_41__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/msa@/~cl_41__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “oleh peguam bela dan peguam cara” perkataan “atau perkongsian guaman liabiliti terhad”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/msa@/~cl_41__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/msa@/~cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (3) dengan subseksyen yang berikut: “(3) Walau apa pun subseksyen (1), jika seseorang klien peguam bela dan peguam cara atau perkongsian guaman liabiliti terhad bersetuju untuk penetapan bil kos, Pendaftar boleh bertindak menetapkan bil itu.”. Pindaan seksyen 127"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/msa@/~cl_42",
      "@type": "akn:clause",
      "eli:number": "42",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 127 Akta ibu dipinda dengan menggantikan perkataan “peguam bela dan peguam cara salah satu pihak” dengan perkataan “peguam bela dan peguam cara atau perkongsian guaman liabiliti terhad yang bertindak bagi salah satu pihak”. Pindaan seksyen 128"
      }
    },
