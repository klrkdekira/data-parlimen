      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “mana-mana bahagian daripada kosnya” dengan perkataan “mana-mana bahagian daripada kos peguam bela dan peguam cara atau perkongsian guaman liabiliti terhad itu”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/msa@/~cl_31__para_b__subpara_iii",
