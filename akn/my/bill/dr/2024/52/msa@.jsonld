      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/msa@/~cl_7__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/msa@/~cl_7__para_a__subpara_ii",
