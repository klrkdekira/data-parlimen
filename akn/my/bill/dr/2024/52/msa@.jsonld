      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (a), dengan menggantikan perkataan “atau secara perkongsian” dengan perkataan “, secara perkongsian atau secara perkongsian guaman liabiliti terhad”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/msa@/~cl_6__para_b",
      "@type": "akn:paragraph",
