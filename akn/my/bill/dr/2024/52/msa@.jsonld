      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan nota bahu dengan nota bahu yang berikut: “Had masa bagi penetapan bil kos”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/msa@/~cl_43__para_b",
