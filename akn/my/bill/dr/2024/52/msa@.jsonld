        "@language": "ms",
        "@value": "Seksyen 36 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/52/msa@/~cl_7__para_a",
      "@type": "akn:paragraph",
