      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 44 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/55/msa@/~cl_10__para_a",
