      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (3), dengan memasukkan selepas perkataan “di Labuan” perkataan “atau disampaikan melalui cara elektronik kepada alamat atau nombor yang diberikan oleh yayasan Labuan itu”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/55/msa@/~cl_10__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/55/msa@/~cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (4), dengan memasukkan selepas perkataan “di Labuan” perkataan “atau disampaikan melalui cara elektronik kepada alamat atau nombor yang diberikan oleh yayasan Labuan itu”. Pindaan seksyen 56"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/55/msa@/~cl_11",
      "@type": "akn:clause",
