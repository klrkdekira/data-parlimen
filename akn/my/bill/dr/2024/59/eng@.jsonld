      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_52",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_53",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_54",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_55",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_56",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_57",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_58",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_59",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_60",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_61",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_62",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_63",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_64",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_65",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_66",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_67",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_68"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "ENFORCEMENT Authorization of public officer or officer of Commission"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_52",
      "@type": "akn:clause",
      "eli:number": "52",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_52__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_52__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_52__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_52__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_52__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_52",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may in writing authorize any public officer or officer of the Commission to exercise the powers of enforcement under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_52__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_52",
      "schema:text": {
        "@language": "en",
        "@value": "Any such officer authorized under subsection (1) shall be deemed to be a public servant within the meaning of the Penal Code [Act 574]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_52__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_52",
      "schema:text": {
        "@language": "en",
        "@value": "There shall be issued to each authorized officer and authority card to be signed by the Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_52__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_52",
      "schema:text": {
        "@language": "en",
        "@value": "Whenever such authorized officer exercises any of the powers under this Act, be shall on demand produce to the person against whom the power is being exercise the authority card issued to him under subsection (3). Power to investigate"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_53",
      "@type": "akn:clause",
      "eli:number": "53",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_53__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_53__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_53__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_53",
      "schema:text": {
        "@language": "en",
        "@value": "An authorized officer shall have all the powers necessary to carry out an investigation into any non-compliance or commission of an offence under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_53__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_53",
      "schema:text": {
        "@language": "en",
        "@value": "In any case relating to the commission of an offence under this Act, an authorized officer carrying out an investigation may exercise all or any of the special powers in relation to police investigation in seizable cases given by the Criminal Procedure Code [Act 593]. Search and seizure with warrant"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_54",
      "@type": "akn:clause",
      "eli:number": "54",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_54__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_54__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_54__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_54__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_54__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_54__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_54__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_54__subsec_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_54__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_54",
      "schema:text": {
        "@language": "en",
        "@value": "If it appears to a Magistrate, upon written information on oath and after such inquiry as he considers necessary, that there is reasonable cause to believe that an offence under this Act is being or has been committed on any premises, or that any evidence or thing which is necessary to the conduct of an investigation into an offence may be found in any premises, the Magistrate may issue a warrant authorizing any authorized officer named in it, to enter the premises at any reasonable time by day or by night, with or without assistance and if need be by force, and there to search for and seize any such evidence or thing."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_54__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_54__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_54__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_54",
      "schema:text": {
        "@language": "en",
        "@value": "Without affecting the generality of subsection (1), the warrant issued by the Magistrate may authorize the search and seizure of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_54__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_54__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "any book, account, document, computerized data, signboard, card, letter, pamphlet, leaflet or notice, which contains or are reasonably suspected to contain information as to any offence so suspected to have been committed; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_54__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_54__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "any other document, facility, apparatus, equipment, device, thing or matter that is reasonably believed to furnish evidence of the commission of the offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_54__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_54",
      "schema:text": {
        "@language": "en",
        "@value": "An authorized officer conducting a search under subsection (1) may, for the purpose of investigating into the offence, search any person who is in or on the premises."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_54__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_54",
      "schema:text": {
        "@language": "en",
        "@value": "An authorized officer making a search on a person under subsection (3) may seize, or take possession of, and place in safe custody all things, other than the necessary clothing, found upon the person, and any other things, for which there is reason to believe that they are the instruments or evidence of the crime, and in so far as the search is for the investigation of an offence all such things may be detained until the discharge or acquittal of the person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_54__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_54",
      "schema:text": {
        "@language": "en",
        "@value": "Whenever it is necessary to cause a woman to be searched, the search shall be made by another woman with strict regard to decency."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_54__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_54",
      "schema:text": {
        "@language": "en",
        "@value": "If, by reason of its nature, size or amount, it is not practicable to remove any book, account, document, computerized data, signboard, card, letter, pamphlet, leaflet, notice, facility, apparatus, equipment, device, thing or matter seized under this section, the seizing officer shall, by any means, seal such book, account, document, computerized data, signboard, card, letter, pamphlet, leaflet, notice, facility, apparatus, equipment, device or matter in the premises or container in which it is found."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_54__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_54",
      "schema:text": {
        "@language": "en",
        "@value": "A person who, without lawful authority, breaks, tampers with or damages the seal referred to in subsection (6) or removes any book, account, document, computerized data, signboard, card, letter, pamphlet, leaflet, notice, facility, apparatus, equipment, device or matter under seal or attempts to do so commits an offence and shall on conviction be liable to a fine not exceeding one million ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_54__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_54",
      "schema:text": {
        "@language": "en",
        "@value": "If a search under this section indicates that there is any interference-causing equipment, radio apparatus or radio-sensitive equipment, the authorized officer may direct that necessary steps be taken to ensure an interference-free environment. Search and seizure without warrant"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_55",
      "@type": "akn:clause",
      "eli:number": "55",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII",
      "schema:text": {
        "@language": "en",
        "@value": "If an authorized officer in any of the circumstances referred to in section 54 has reasonable cause to believe that by reason of delay in obtaining a search warrant under that section the investigation would be adversely affected or evidence of the commission of an offence is likely to be tampered with, removed, damaged or destroyed, the officer may enter the premises and exercise in, upon and in respect of the premises all the powers referred to in section 54 in as full and ample a manner as if he were authorized to do so by a warrant issued under that section. Warrant admissible notwithstanding defect"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_56",
      "@type": "akn:clause",
      "eli:number": "56",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII",
      "schema:text": {
        "@language": "en",
        "@value": "A search warrant issued under this Act shall be valid and enforceable notwithstanding any defect, mistake or omission in the search warrant or in the application for such warrant and any book, account, document, computerized data, signboard, card, letter, pamphlet, leaflet, notice, facility, apparatus, equipment, device, thing or matter seized under such warrant shall be admissible in evidence in any proceedings under this Act. Access to computerized data"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_57",
      "@type": "akn:clause",
      "eli:number": "57",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_57__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_57__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_57__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_57",
      "schema:text": {
        "@language": "en",
        "@value": "Any authorized officer conducting a search under this Act shall be given access to computerized data whether stored in a computer or otherwise."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_57__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_57",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this section, an authorized officer shall be provided with the necessary password, encryption code, decryption code, software or hardware and any other means required to enable comprehension of the computerized data. List of thing seized"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_58",
      "@type": "akn:clause",
      "eli:number": "58",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_58__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_58__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_58__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_58__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_58__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_58__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_58",
      "schema:text": {
        "@language": "en",
        "@value": "Except as provided in subsection (2), where any book, account, document, computerized data, signboard, card, letter, pamphlet, leaflet, notice, facility, apparatus, equipment, device, thing or matter is seized pursuant to this Act, the authorized officer making the seizure—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_58__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_58__subsec_1__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_58__subsec_1__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_58__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "shall prepare—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_58__subsec_1__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_58__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "a list of the book, account, document, computerized data, signboard, card, letter, pamphlet, leaflet, notice, facility, apparatus, equipment, device, thing or matter seized and shall sign the list; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_58__subsec_1__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_58__subsec_1__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "a notice in writing of the seizure containing the grounds for the seizure and shall sign the notice; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_58__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_58__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "shall, as soon as practicable, serve a copy of the list of the book, account, document, computerized data, signboard, card, letter, pamphlet, leaflet, notice, facility, apparatus, equipment, device, thing or matter seized and the notice in writing of the seizure to the occupier of the premises which have been searched, or to his agent or servant at those premises."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_58__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_58",
      "schema:text": {
        "@language": "en",
        "@value": "The notice in writing of the seizure shall not be required to be served pursuant to paragraph (1)(b) where the seizure is made in the presence of the person against whom proceedings under this Act are intended to be taken, or in the presence of the owner of such property or his agent, as the case may be."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_58__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_58",
      "schema:text": {
        "@language": "en",
        "@value": "If the premises are unoccupied, the authorized officer shall post a copy of the list of the book, account, document, computerized data, signboard, card, letter, pamphlet, leaflet, notice, facility, apparatus, equipment, device, thing or matter seized conspicuously on the premises. Release of thing seized"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_59",
      "@type": "akn:clause",
      "eli:number": "59",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_59__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_59__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_59__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_59",
      "schema:text": {
        "@language": "en",
        "@value": "If any book, account, document, computerized data, signboard, card, letter, pamphlet, leaflet, notice, facility, apparatus, equipment, device, thing or matter has been seized under this Act, the authorized officer who effected the seizure may, after referring to the Public Prosecutor, release the book, account, document, computerized data, signboard, card, letter, pamphlet, leaflet, notice, facility, apparatus, equipment, device, thing or matter to the person as he determines to be lawfully entitled to the book, account, document, computerized data, signboard, card, letter, pamphlet, leaflet, notice, facility, apparatus, equipment, device, thing or matter if he is satisfied that the book, account, document, computerized data, signboard, card, letter, pamphlet, leaflet, notice, facility, apparatus, equipment, device, thing or matter is not liable to forfeiture under this Act and is not otherwise required for the purposes of any proceedings under this Act, or for the purpose of any prosecution under any other law, and in such event neither the officer effecting the seizure, nor the Government or any person acting on behalf of the Government, shall be liable to any proceedings by any person if the seizure and the release of the book, account, document, computerized data, signboard, card, letter, pamphlet, leaflet, notice, facility, apparatus, equipment, device, thing or matter had been effected in good faith."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_59__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_59",
      "schema:text": {
        "@language": "en",
        "@value": "A record in writing shall be made by the officer effecting the release of any book, account, document, computerized data, signboard, card, letter, pamphlet, leaflet, notice, facility, apparatus, equipment, device, thing or matter under subsection (1) specifying in detail the circumstances of, and the reason for, the release, and he shall send a copy of the record to the Public Prosecutor within seven days of the release. Preservation of communications data"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_60",
      "@type": "akn:clause",
      "eli:number": "60",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_60__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_60__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_60__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_60__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_60__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_60__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_60",
      "schema:text": {
        "@language": "en",
        "@value": "If an authorized officer is satisfied that—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_60__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_60__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "communications data is reasonably required for the purposes of an investigation; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_60__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_60__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "there is a risk that the communications data may be destroyed or rendered inaccessible, the authorized officer may, by notice in writing given to a person in control of the communications system, require the person to ensure that the communications data specified in the notice be preserved for the period and in the manner as may be specified in the notice in writing."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_60__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_60__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_60__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_60",
      "schema:text": {
        "@language": "en",
        "@value": "The person to whom the notice in writing was given under subsection (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_60__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_60__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "shall preserve the communications data specified in the notice for the period and in the manner as may be specified in the notice; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_60__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_60__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "shall not disclose the existence and content of the notice, the procedure, method, manner or any matter related to the preservation of communications data under subsection (1) without lawful authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_60__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_60",
      "schema:text": {
        "@language": "en",
        "@value": "A person who contravenes subsection (2) commits an offence and shall, on conviction, be liable to a fine not exceeding one million ringgit and shall be liable to a further fine not exceeding one hundred thousand ringgit for every day or part of a day during which the offence continues after conviction. Disclosure of stored communications data"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_61",
      "@type": "akn:clause",
      "eli:number": "61",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_61__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_61__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_61__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_61__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_61",
      "schema:text": {
        "@language": "en",
        "@value": "If an authorized officer is satisfied that any communications data is reasonably required for the purposes of an investigation into an offence under this Act, the authorized officer may, by notice in writing given to a person in control of the communications system, require the person to disclose such communications data in the manner as specified in the notice."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_61__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_61__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_61__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_61",
      "schema:text": {
        "@language": "en",
        "@value": "The person to whom the notice in writing was given under subsection (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_61__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_61__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "shall disclose such communications data in the manner as specified in the notice; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_61__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_61__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "shall not disclose the existence and content of the notice, the procedure, method, manner or any matter related to the disclosure of communications data under subsection (1) without lawful authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_61__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_61",
      "schema:text": {
        "@language": "en",
        "@value": "A person who contravenes subsection (2) commits an offence and shall, on conviction, be liable to a fine not exceeding one million ringgit and shall be liable to a further fine not exceeding one hundred thousand ringgit for every day or part of a day during which the offence continues after conviction. Obstruction"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_62",
      "@type": "akn:clause",
      "eli:number": "62",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_62__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_62__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_62__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_62__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_62__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII",
      "schema:name": {
        "@language": "en",
        "@value": "Any person who—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_62__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_62",
      "schema:text": {
        "@language": "en",
        "@value": "refuses any authorized officer access to any premises which such authorized officer is entitled to have under this Act or in the execution of any duty imposed or power conferred by this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_62__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_62",
      "schema:text": {
        "@language": "en",
        "@value": "assaults, obstructs, hinders or delays any authorized officer in effecting any entry which the authorized officer is entitled to effect under this Act, or in the execution of any duty imposed or power conferred by this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_62__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_62",
      "schema:text": {
        "@language": "en",
        "@value": "refuses to give any authorized officer any information relating to an offence or suspected offence under this Act or any other information which the person has in his knowledge or power to give;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_62__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_62",
      "schema:text": {
        "@language": "en",
        "@value": "rescues or endeavours to rescue or causes to be rescued anything which has been duly seized; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_62__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_62",
      "schema:text": {
        "@language": "en",
        "@value": "destroys anything to prevent the seizure or the securing of the things, commits an offence and shall, on conviction, be liable to a fine not exceeding one million ringgit. Additional power"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_63",
      "@type": "akn:clause",
      "eli:number": "63",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_63__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_63__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_63__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII",
      "schema:text": {
        "@language": "en",
        "@value": "An authorized officer shall, for the purposes of the execution of this Act, have the powers to do all or any of the following:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_63__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_63",
      "schema:text": {
        "@language": "en",
        "@value": "to require the production of book, account, document, computerized data, signboard, card, letter, pamphlet, leaflet, notice, facility, apparatus, equipment, device, thing or matter kept by a licensed applications service provider, licensed content applications service provider or licensed network service provider or any other person and to inspect, examine and to download, make copies or take extracts from them;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_63__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_63",
      "schema:text": {
        "@language": "en",
        "@value": "to require the production of any identification document from any person in relation to any case or offence under this Act; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_63__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_63",
      "schema:text": {
        "@language": "en",
        "@value": "to make such inquiry as may be necessary to ascertain whether the provisions of this Act have been complied with. Power to require attendance of person acquainted with case"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_64",
      "@type": "akn:clause",
      "eli:number": "64",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_64__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_64__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_64__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_64",
      "schema:text": {
        "@language": "en",
        "@value": "An authorized officer making an investigation under this Act may, by order in writing, require the attendance before himself of a person who appears to the authorized officer to be acquainted with the circumstances of the case, and the person shall attend as so required."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_64__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_64",
      "schema:text": {
        "@language": "en",
        "@value": "If the person fails to attend as required, the authorized officer may report the failure to a Magistrate who shall issue a warrant to secure the attendance of the person. Examination of person acquainted with case"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_65",
      "@type": "akn:clause",
      "eli:number": "65",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_65__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_65__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_65__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_65__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_65__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_65__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_65",
      "schema:text": {
        "@language": "en",
        "@value": "An authorized officer making an investigation under this Act may examine orally a person supposed to be acquainted with the facts and circumstances of the case."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_65__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_65",
      "schema:text": {
        "@language": "en",
        "@value": "The person shall be legally bound to answer all questions relating to the case put to him by the authorized officer, but the person may refuse to answer any question the answer to which would have a tendency to expose him to a criminal charge or penalty or forfeiture."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_65__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_65",
      "schema:text": {
        "@language": "en",
        "@value": "A person making a statement under this section shall be legally bound to state the truth, whether or not the statement is made wholly or partly in answer to questions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_65__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_65",
      "schema:text": {
        "@language": "en",
        "@value": "The authorized officer examining a person under subsection (1) shall first inform that person of the provisions of subsections (2) and (3)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_65__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_65",
      "schema:text": {
        "@language": "en",
        "@value": "A statement made by a person under this section shall, whenever possible, be reduced into writing and signed by the person making it or affixed with his thumbprint, as the case may be, after it has been read to him in the language in which he made it and after he has been given an opportunity to make any corrections he may wish. Admissibility of statement in evidence"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_66",
      "@type": "akn:clause",
      "eli:number": "66",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_66__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_66__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_66__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_66__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_66",
      "schema:text": {
        "@language": "en",
        "@value": "If any person is charged with an offence under this Act, any statement, whether the statement amounts to a confession or not or whether it is oral or in writing, made at any time, whether before or after the person is charged and whether in the course of an investigation under this Act or not and whether or not wholly or partly in answer to questions, by that person to or in the hearing of an authorized officer and whether or not interpreted to him by another officer or other person, shall be admissible in evidence at his trial and, if the person charged tenders himself as a witness, any such statement may be used in cross-examination and for the purpose of impeaching his credit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_66__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_66__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_66__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_66",
      "schema:text": {
        "@language": "en",
        "@value": "No statement under subsection (1) shall be admissible or used—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_66__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_66__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "if the making of the statement appears to the court to have been caused by any inducement, threat or promise having reference to the charge against such person proceeding from a person in authority and sufficient in the opinion of the court to give the person charged grounds which would appear to him reasonable for supposing that by making it he would gain any advantage or avoid any evil of a temporal nature in reference to the proceedings against him; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_66__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_66__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of a statement made by the person after his arrest, unless the court is satisfied that he was cautioned in the following words or words to the like effect: “It is my duty to warn you that you are not obliged to say anything or to answer any question, but anything you say, whether in answer to a question or not, may be given in evidence”."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_66__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_66",
      "schema:text": {
        "@language": "en",
        "@value": "A statement made by a person before there is time to caution him shall not be rendered inadmissible in evidence merely by reason of his not having been cautioned if he is cautioned as soon as possible after that. Forfeiture"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_67",
      "@type": "akn:clause",
      "eli:number": "67",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_67__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_67__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_67__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_67__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_67__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_67__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_67__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_67__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_67",
      "schema:text": {
        "@language": "en",
        "@value": "Any book, account, document, computerized data, signboard, card, letter, pamphlet, leaflet, notice, facility, apparatus, equipment, device, thing or matter seized under this Act may be liable to forfeiture."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_67__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_67",
      "schema:text": {
        "@language": "en",
        "@value": "An order for the forfeiture or for the release of any book, account, document, computerized data, signboard, card, letter, pamphlet, leaflet, notice, facility, apparatus, equipment, device, thing or matter liable to forfeiture under this section shall be made by the court before which the prosecution with regard to it has been held and an order for the forfeiture of the book, account, document, computerized data, signboard, card, letter, pamphlet, leaflet, notice, facility, apparatus, equipment, device or matter shall be made if it is proved to the satisfaction of the court that an offence under this Act, has been committed and that the book, account, document, computerized data, signboard, card, letter, pamphlet, leaflet, notice, facility, apparatus, equipment, device, thing or matter was used in the commission of the offence despite the fact that no person may have been convicted of the offence or breach."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_67__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_67",
      "schema:text": {
        "@language": "en",
        "@value": "If there is no prosecution with regard to any book, account, document, computerized data, signboard, card, letter, pamphlet, leaflet, notice, facility, apparatus, equipment, device, thing or matter seized in the exercise of any power conferred under this Act, the book, account, document, computerized data, signboard, card, letter, pamphlet, leaflet, notice, facility, apparatus, equipment, device, thing or matter shall be taken or deemed to be forfeited at the expiration of twelve months from the date it was seized unless a claim to it is made before that date in the manner provided in this section."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_67__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_67",
      "schema:text": {
        "@language": "en",
        "@value": "A person asserting that he is the owner of any book, account, document, computerized data, signboard, card, letter, pamphlet, leaflet, notice, facility, apparatus, equipment, device, thing or matter seized under this Act and that the book, account, document, computerized data, signboard, card, letter, pamphlet, leaflet, notice, facility, apparatus, equipment, device, thing or matter is not liable to forfeiture may personally or by his agent authorized in writing by him give written notice to the Commission or any authorized officer of his claim."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_67__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_67",
      "schema:text": {
        "@language": "en",
        "@value": "Upon receipt of a notice under subsection (4), the Commission or any authorized officer shall, after such enquiry as may be necessary, direct that the book, account, document, computerized data, signboard, card, letter, pamphlet, leaflet, notice, facility, apparatus, equipment, device, thing or matter be released or forfeited or refer the case to a Sessions Court Judge for decision."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_67__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_67",
      "schema:text": {
        "@language": "en",
        "@value": "The Sessions Court Judge to whom the case is referred shall issue a summons requiring the person asserting that he is the owner of the book, account, document, computerized data, signboard, card, letter, pamphlet, leaflet, notice, facility, apparatus, equipment, device, thing or matter and the person from whom the book, account, document, computerized data, signboard, card, letter, pamphlet, leaflet, notice, facility, apparatus, equipment, device, thing or matter were seized to appear before him and upon his appearance or default to appear, due service of the summons being proved, the Sessions Court Judge shall proceed to the examination of the case and on proof that an offence under this Act has been committed and that the book, account, document, computerized data, signboard, card, letter, pamphlet, leaflet, notice, facility, apparatus, equipment, device, thing or matter was the subject matter or was used in the commission of the offence, shall order the book, account, document, computerized data, signboard, card, letter, pamphlet, leaflet, notice, facility, apparatus, equipment, device, thing or matter to be forfeited or may, in the absence of such proof, order the release of the book, account, document, computerized data, signboard, card, letter, pamphlet, leaflet, notice, facility, apparatus, equipment, device, thing or matter to the person entitled to it."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_67__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_67",
      "schema:text": {
        "@language": "en",
        "@value": "Any book, account, document, computerized data, signboard, card, letter, pamphlet, leaflet, notice, facility, apparatus, equipment, device, thing or matter forfeited or deemed to be forfeited shall be delivered to the Commission or an authorized officer who shall dispose of it in the manner as the Commission deems fit. Jurisdiction to try offence"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII__cl_68",
      "@type": "akn:clause",
      "eli:number": "68",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VIII",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding any written law to the contrary, a Sessions Court shall have jurisdiction to try any offence under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_40__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_40__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_40__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_40__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_40__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_40__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_40__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_40__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "There shall be established an Online Safety Appeal Tribunal for the purpose of reviewing—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_40__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_40__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any written instruction issued by the Commission referred to in subsection 23(8) or 25(1) or section 27;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_40__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_40__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any determination made by the Commission referred to in subsection 25(5);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_40__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_40__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any directions issued by the Commission under section 30; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_40__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_40__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any decision of a review of a notice of non-compliance made by the Commission under section 38."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_40__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_40__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_40__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister shall, by order published in the Gazette, appoint the members of the Online Safety Appeal Tribunal as follows:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_40__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_40__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "a Chairman who shall be appointed from amongst the Judges of the High Court; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_40__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_40__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "at least two other members, or such greater even number of members from amongst persons who have knowledge or experience in the field of communications and multimedia, engineering, law, economics or commerce or public administration or in any other fields as the Minister deems fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_40__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_40",
      "schema:text": {
        "@language": "en",
        "@value": "A member of the Online Safety Appeal Tribunal shall hold office for a term not exceeding three years and shall be eligible for reappointment upon expiry of his term of office. Appeal to Online Safety Appeal Tribunal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_41",
      "@type": "akn:clause",
      "eli:number": "41",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_41__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_41__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII"
    },
    {
