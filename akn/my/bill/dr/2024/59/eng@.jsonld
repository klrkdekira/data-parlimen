      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_42__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
