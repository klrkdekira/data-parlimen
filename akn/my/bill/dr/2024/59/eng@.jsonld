        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_42__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_42__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_42__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_42__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_42__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_42__subsec_1__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_42__subsec_1__para_h"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may at any time revoke the appointment of any member of the Online Safety Appeal Tribunal if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_42__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_42__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "he resigns his office;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_42__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_42__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "he becomes of unsound mind or otherwise incapable of performing his duties or managing his affairs;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_42__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_42__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "he becomes bankrupt or insolvent;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_42__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_42__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "he is prohibited from being a director of a company under any written law relating to companies;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_42__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_42__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "he has been convicted of an offence, under any law, by a court in Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_42__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_42__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "he is guilty of serious misconduct in relation to his duties;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_42__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_42__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "he fails to carry out his obligation under section 50; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_42__subsec_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_42__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "his performance has been unsatisfactory for a significant period of time."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_42__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_42",
      "schema:text": {
        "@language": "en",
        "@value": "A member of the Online Safety Appeal Tribunal may, at any time, resign from his appointment by giving a notice in writing to the Minister. Vacation of office of members of Online Safety Appeal Tribunal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_43",
      "@type": "akn:clause",
      "eli:number": "43",
      "hasPart": [
