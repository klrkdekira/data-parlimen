      "schema:name": {
        "@language": "en",
        "@value": "The quorum of the Online Safety Appeal Tribunal shall consist of—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_45__para_a",
