      "schema:text": {
        "@language": "en",
        "@value": "The Deputy Chairman shall act as the Chairman for the period when—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_II__cl_9__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_II__cl_9__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the office of the Chairman is vacant;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_II__cl_9__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_II__cl_9__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Chairman is absent from duty or from Malaysia; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_II__cl_9__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_II__cl_9__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Chairman is, for any other reason, unable to carry out his functions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_II__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "The Deputy Chairman shall, during the period in which he is carrying out the functions of the Chairman under this section, be deemed to be the Chairman. Functions of Committee"
      }
    },
