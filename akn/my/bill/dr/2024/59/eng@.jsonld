      "schema:text": {
        "@language": "en",
        "@value": "The office of a member of the Online Safety Appeal Tribunal shall be vacated—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_43__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_43__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "if he dies;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_43__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_43__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "if he resigns or otherwise vacates his office before the expiry of the term for which he is appointed; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_43__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_43__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "if his appointment is revoked."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_43__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister shall appoint a person in accordance with section 40 to replace the Chairman or any other member during the vacancy in the office of the Chairman or any other member."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_43__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_43__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_43__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_43__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister shall appoint a person in accordance with section 40 to act as the Chairman or any other member for the period when—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_43__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_43__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the office of the Chairman or any other member is vacant;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_43__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_43__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the Chairman or any other member is absent from duty or from Malaysia; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_43__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_43__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the Chairman or any other member is, for any other reason, unable to carry out his functions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_43__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_43",
      "schema:text": {
        "@language": "en",
        "@value": "The exercise of the powers, or the performance of the functions, of the Online Safety Appeal Tribunal is not affected only because of there being a vacancy in the membership of the Online Safety Appeal Tribunal. Allowances for members of Online Safety Appeal Tribunal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_44",
      "@type": "akn:clause",
      "eli:number": "44",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "The members of the Online Safety Appeal Tribunal shall be paid such allowances as the Minister may determine after consultation with the Minister of Finance. Quorum of Online Safety Appeal Tribunal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_45",
      "@type": "akn:clause",
      "eli:number": "45",
      "hasPart": [
