        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_43__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII"
    },
