      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_45",
      "schema:text": {
        "@language": "en",
        "@value": "the Chairman; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_45__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_45",
      "schema:text": {
        "@language": "en",
        "@value": "at least two other members, or any greater even number of members not exceeding four. Decision of Online Safety Appeal Tribunal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_46",
      "@type": "akn:clause",
      "eli:number": "46",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_46__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_46__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_46__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "Any decision of the Online Safety Appeal Tribunal on any matter shall be decided by the votes of the majority of members of the Online Safety Appeal Tribunal present."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_46__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_46",
      "schema:text": {
        "@language": "en",
        "@value": "The decision of the Online Safety Appeal Tribunal is final and binding and is not subject to further appeal. Enforcement of decision of Online Safety Appeal Tribunal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_47",
      "@type": "akn:clause",
      "eli:number": "47",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "Any decision of the Online Safety Appeal Tribunal may be enforced in the same manner as a judgment or an order of the High Court. Powers of Online Safety Appeal Tribunal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_48",
      "@type": "akn:clause",
      "eli:number": "48",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_48__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_48__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_48__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_48__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_48__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_48__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_48__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_48__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_48__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_48__subsec_1__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_48__subsec_1__para_h"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "The Online Safety Appeal Tribunal shall have the power—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_48__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_48__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to summon parties to its proceedings or any other person to attend before it to give evidence in respect of an appeal;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_48__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_48__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to procure and receive evidence on oath or affirmation, whether written or oral and examine all such persons as witnesses as the Online Safety Appeal Tribunal thinks necessary to procure, receive or examine;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_48__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_48__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "where a person is so summoned, to require the production of any book, paper, document, record or other thing in his possession or under his control and which the Online Safety Appeal Tribunal may consider necessary for the purposes of the appeal;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_48__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_48__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to administer any oath, affirmation or statutory declaration, as the case may require;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_48__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_48__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "where a person is so summoned, to allow the payment for any reasonable expenses incurred in connection with his attendance;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_48__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_48__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to admit evidence or reject evidence adduced, whether written or oral, and whether admissible or inadmissible under the provisions of any written law for the time being in force relating to the admissibility of evidence;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_48__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_48__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to adjourn the hearing of an appeal from time to time, including the power to adjourn to consider its decision; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_48__subsec_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_48__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to generally direct and do all such things as may be necessary or expedient for the expeditious decision of the appeal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_48__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_48",
      "schema:text": {
        "@language": "en",
        "@value": "The Online Safety Appeal Tribunal shall have the power of a subordinate court with regard to the enforcement of attendance of witnesses, hearing evidence on oath or affirmation and punishment for contempt. Suspension of members of Online Safety Appeal Tribunal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_49",
      "@type": "akn:clause",
      "eli:number": "49",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may suspend any member of the Online Safety Appeal Tribunal on the ground of misbehaviour or incapacity. Disclosure of interest"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_50",
      "@type": "akn:clause",
      "eli:number": "50",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_50__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_50__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_50__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_50__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_50__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_50__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "A member of the Online Safety Appeal Tribunal shall disclose, as soon as practicable, to the Chairman any interest, whether substantial or not, which may conflict with the member’s duties as a member of the Online Safety Appeal Tribunal, in a particular matter."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_50__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "If the Chairman is of the opinion that the member’s interest is in conflict with the member’s duties, the Chairman shall inform all the parties to the matter of the conflict."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_50__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "If none of the parties to the matter objects to the conflict, the member may continue to execute his duties as a member of the Online Safety Appeal Tribunal in relation to that matter."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_50__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "If a party to the matter objects to the conflict, the member shall not continue to execute his duties as a member of the Online Safety Appeal Tribunal in relation to that matter."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_50__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_50",
      "schema:text": {
        "@language": "en",
        "@value": "The failure by any member to disclose his interest in a particular matter shall subject him to the disciplinary actions under section 42 or 49. Secretary to Online Safety Appeal Tribunal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_51",
      "@type": "akn:clause",
      "eli:number": "51",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_51__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_51__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_51__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_51__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_51",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister shall designate a public officer as the Secretary to the Online Safety Appeal Tribunal to assist the Online Safety Appeal Tribunal in carrying out its functions and powers under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_51__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_51",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may designate such number of other public officers as the Minister thinks fit to assist the Secretary to the Online Safety Appeal Tribunal in carrying out his function under subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_51__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VII__cl_51",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this Act, the Secretary of the Online Safety Appeal Tribunal and the officers designated under subsection (2) shall be deemed to be officers of the Online Safety Appeal Tribunal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_36",
      "@type": "akn:clause",
      "eli:number": "36",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_36__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_36__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_36__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "A licensed applications service provider or licensed content applications service provider may, before a notice of non-compliance is issued to the licensed applications service provider or licensed content applications service provider under section 37, provide an undertaking to the Commission regarding the compliance of any of its duties under Part III in such form as may be prescribed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_36__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_36",
      "schema:text": {
        "@language": "en",
        "@value": "Any licensed applications service provider or licensed content applications service provider which provides the undertaking under subsection (1) shall comply with the undertaking. Notice of non-compliance"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_37",
      "@type": "akn:clause",
      "eli:number": "37",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_37__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_37__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_37__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_37__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Commission has reasonable grounds to believe that a licensed applications service provider or licensed content applications service provider has failed to comply with any of its duties under Part III, the Commission shall issue a notice of non-compliance in writing to the licensed applications service provider or licensed content applications service provider in the manner as the Commission may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_37__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_37__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_37__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_37__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "The notice of non-compliance issued under subsection (1) shall contain the following particulars:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_37__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_37__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "details of the non-compliance;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_37__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_37__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the amount of financial penalty to be paid in respect of the non-compliance; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_37__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_37__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "any other particulars as the Commission thinks necessary."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_37__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_37__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_37__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_37",
      "schema:text": {
        "@language": "en",
        "@value": "Upon receipt of the notice of non-compliance under subsection (1), the licensed applications service provider or licensed content applications service provider—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_37__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_37__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "shall pay the amount of financial penalty as specified in the notice of non-compliance within the period as may be specified in the notice; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_37__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_37__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "may apply to the Commission for a review by way of representation in respect of the notice of non-compliance within the period and in such manner as the Commission may determine if the licensed applications service provider or licensed content applications service provider does not wish to pay the amount of financial penalty specified in the notice of non-compliance. Review by Commission"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_38__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_38__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_38__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_38__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_38__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_38__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_38__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_38__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "Upon receipt of an application for a review by way of representation against the notice of non-compliance issued under section 37, the Commission shall review the notice of non-compliance and may—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_38__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_38__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "dismiss the application for the review of the notice of non-compliance;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_38__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_38__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "withdraw the notice of non-compliance;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_38__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_38__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "vary the amount of the financial penalty to be paid in respect of the non-compliance and specify the period in which the varied financial penalty to be paid; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_38__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_38__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "impose any conditions as the Commission deems fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_38__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "Any decision of the review made by the Commission under this section shall be notified in writing to the licensed applications service provider or licensed content applications service provider which applied for the review."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_38__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_38",
      "schema:text": {
        "@language": "en",
        "@value": "The licensed applications service provider or licensed content applications service provider which applied for the review shall abide by the decision of the review made by the Commission under this section. Financial penalty for non-compliance of duties"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_39__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_39__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_39__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_39__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_39",
      "schema:text": {
        "@language": "en",
        "@value": "The Commission may impose a financial penalty on a licensed applications service provider or licensed content applications service provider for any non-compliance of any of its duties under Part III."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_39__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_39",
      "schema:text": {
        "@language": "en",
        "@value": "Any licensed applications service provider or licensed content applications service provider which fails to comply with any of its duties under Part III shall be liable to pay to the Commission a financial penalty an amount of which not exceeding ten million ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_39__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_VI__cl_39",
      "schema:text": {
        "@language": "en",
        "@value": "Any financial penalty due and payable under this section may be recovered as a civil debt due to the Commission."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_30__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_30__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_30__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_30__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_30__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_30__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_30__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_30__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_30__subsec_9"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_30__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "The Commission may issue directions in writing to any licensed applications service provider, licensed content applications service provider or licensed network service provider regarding the compliance of any of the provisions of this Act by the licensed applications service provider, licensed content applications service provider or licensed network service provider."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_30__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "Before issuing the directions under subsection (1), the Commission shall issue a notice in writing to the licensed applications service provider, licensed content applications service provider or licensed network service provider specifying the nature of the required compliance."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_30__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "Upon receipt of the notice in writing under subsection (2), the licensed applications service provider, licensed content applications service provider or licensed network service provider may make a submission in respect of the required compliance, orally or in writing, within the period as specified in the notice."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_30__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "The Commission shall take into consideration any submission made by the licensed applications service provider, licensed content applications service provider or licensed network service provider before issuing the directions under subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_30__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "The licensed applications service provider, licensed content applications service provider or licensed network service provider shall comply with the directions issued by the Commission under this section."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_30__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "The directions under this section shall be registered by the Commission as soon as practicable from the date of the issuance of the directions and shall be effective from the date of registration or such later date as the Commission may specify in the directions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_30__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "The directions shall expire on such date as the Commission may specify in the directions or, if no date is specified, the directions shall be in operation until revoked."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_30__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "The Commission may modify, vary or revoke the directions issued under this section and the procedures set out under this section shall apply in respect of any modification, variation or revocation of the directions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_30__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_30",
      "schema:text": {
        "@language": "en",
        "@value": "Any licensed applications service provider, licensed content applications service provider or licensed network service provider which fails to comply with the directions issued by the Commission under this section commits an offence and shall, on conviction, be liable to a fine not exceeding one million ringgit and shall be liable to a further fine not exceeding one hundred thousand ringgit for every day or part of a day during which the offence continues after conviction. Register of directions"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_31__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_31__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_31__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_31__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "The Commission shall maintain a register of all directions issued by the Commission under section 30 both in physical form and in electronic media."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_31__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_31__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_31__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "A licensed applications service provider, licensed content applications service provider or licensed network service provider may, upon payment of a prescribed fee—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_31__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_31__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "inspect the register of the directions; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_31__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_31__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "make a copy of, or take extracts from, the register of the directions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_31__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_31__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_31__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_31",
      "schema:text": {
        "@language": "en",
        "@value": "If the licensed applications service provider, licensed content applications service provider or licensed network service provider requests that a copy or extracts from the register of directions be provided in an electronic media, the Commission may provide such copy or extracts—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_31__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_31__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "on a data processing device; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_31__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_31__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "by way of electronic transmission. Power to gather information"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32__subsec_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding any other written law, if the Commission has reasonable grounds to believe that any person—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "has any information, particulars or document that is relevant to the performance of the Commission’s functions and powers under this Act; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32__subsec_1__para_b__subpara_A",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32__subsec_1__para_b__subpara_B",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32__subsec_1__para_b__subpara_C",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32__subsec_1__para_b__subpara_D",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32__subsec_1__para_b__subpara_E",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32__subsec_1__para_b__subpara_F"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "is capable of giving any evidence which the Commission has reasonable grounds to believe that the evidence is relevant to the performance of the Commission’s functions and powers under this Act, the Commission may, by notice in writing, direct that person—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32__subsec_1__para_b__subpara_A",
      "@type": "akn:subparagraph",
      "eli:number": "A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "to give any such information or particulars to the Commission in the form and manner and within the period as may be specified in the notice or such extended period as the Commission may grant;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32__subsec_1__para_b__subpara_B",
      "@type": "akn:subparagraph",
      "eli:number": "B",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "to produce any such document, whether in physical form or in electronic media, to the Commission in the manner and within the period as may be specified in the notice or such extended period as the Commission may grant;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32__subsec_1__para_b__subpara_C",
      "@type": "akn:subparagraph",
      "eli:number": "C",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "to make copies of any such document and to produce those copies to the Commission in the manner and within the period as may be specified in the notice or such extended period as the Commission may grant;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32__subsec_1__para_b__subpara_D",
      "@type": "akn:subparagraph",
      "eli:number": "D",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "if the person is an individual, to appear before an authorized officer at the time and place as may be specified in the notice to give any evidence, either orally or in writing, and produce any document, whether in physical form or in electronic media, in the manner and within the period as specified in the notice or such extended period as the Commission may grant;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32__subsec_1__para_b__subpara_E",
      "@type": "akn:subparagraph",
      "eli:number": "E",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "if the person is a body corporate or a public body, to cause a competent officer of the body corporate or public body to appear before an authorized officer at the time and place specified in the notice to give any evidence, either orally or in writing, and produce any document, whether in physical form or in electronic media, in the manner and within the period as may be specified in the notice or such extended period as the Commission may grant; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32__subsec_1__para_b__subpara_F",
      "@type": "akn:subparagraph",
      "eli:number": "F",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "if the person is a partnership, to cause an individual who is a partner in the partnership or an employee of the partnership to appear before an authorized officer at the time and place specified in the notice to give any evidence, either orally or in writing, and produce any document, whether in physical form or in electronic media, in the manner and within the period as may be specified in the notice or such extended period as the Commission may grant."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Commission directs any person to produce any document under subsection (1) and the document is not in the custody of that person, that person shall—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "state, to the best of his knowledge and belief, where the document may be found; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "identify, to the best of his knowledge and belief, the last person who had custody of the document and state, to the best of his knowledge and belief, where that person who had custody of the document may be found."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "Any person directed to give or produce any information, particulars or documents or copies of any document under subsection (1), shall ensure that the information, particulars or documents or copies of the document given or produced are true, accurate, complete and not misleading and such person shall provide an express representation to that effect, including a declaration that he is not aware of any other information, particulars or document which would make the information, particulars or document given or produced untrue or misleading."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "Where any person discloses any information or particulars or produces any document in response to a notice in writing under this section, such person, his agent or employee, or any other person acting on his behalf or under his directions, shall not, by reason only of such disclosure or production, be liable to prosecution for any offence under any written law, or to any proceedings or claim by any person under any law or under any contract, agreement or arrangement, or otherwise."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection (4) shall not bar, prevent or prohibit the institution of any prosecution for any offence as provided by this section or for the disclosure or production of false information or document in relation to a notice in writing under this section furnished to the Commission pursuant to this section."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who fails to comply with the directions of the Commission under subsection (1) commits an offence and shall, on conviction, be liable to a fine not exceeding one million ringgit and shall be liable to a further fine not exceeding one hundred thousand ringgit for every day or part of a day during which the offence continues after conviction."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (2) or (3) commits an offence and shall, on conviction, be liable to a fine not exceeding five hundred thousand ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who intentionally alters, suppresses or destroys any information, particulars or documents which he has been directed to give or produce pursuant to a notice in writing under this section commits an offence and shall, on conviction, be liable to a fine not exceeding five hundred thousand ringgit. Proof of compliance"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_33__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_33__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_33__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "The Commission may direct any person to produce or give all such evidence and information as the person may have relating to his compliance with any of the provisions of this Act to the Commission and such person shall comply with the directions of the Commission."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_33__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection (1) shall not affect any other power conferred on the Commission under this Act. Commission may retain document"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_34",
      "@type": "akn:clause",
      "eli:number": "34",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_34__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_34__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_34__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_34__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_34__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "The Commission may take, and retain for as long as is necessary, possession of a document produced or given under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_34__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "The person who should have been entitled to possession of the document is entitled to be supplied, as soon as practicable, with a copy certified by the Commission to be a true copy."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_34__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding any other written law, the certified copy of the document referred to in subsection (2) shall be received as evidence by all courts and tribunals as if it were the original."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_34__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_34",
      "schema:text": {
        "@language": "en",
        "@value": "Until a certified copy is supplied, the Commission shall, at such times and places as the Commission thinks appropriate, permit the person who should have been entitled to possession of the document, or a person authorized by that person, to inspect and make copies of, or take extracts from, the document. Powers of Commission shall be in addition to powers under Communications and Multimedia Act 1998 and Malaysian Communications and Multimedia Commission Act 1998"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V__cl_35",
      "@type": "akn:clause",
      "eli:number": "35",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "The functions and powers of the Commission under this Act shall be in addition to, and not in derogation of, the functions and powers of the Commission under the Communications and Multimedia Act 1998 and Malaysian Communications and Multimedia Commission Act 1998."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~sched_1__para_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~sched_1__para_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~sched_1__para_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~sched_1__para_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~sched_1__para_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~sched_1__para_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~sched_1__para_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~sched_1__para_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~sched_1__para_9"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "[Section 4] HARMFUL CONTENT"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~sched_1__para_1",
      "@type": "akn:paragraph",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~sched_1",
      "schema:text": {
        "@language": "en",
        "@value": "Content on child sexual abuse material as provided for under section 4 of the Sexual Offences against Children Act 2017 [Act 792]"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~sched_1__para_2",
      "@type": "akn:paragraph",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~sched_1",
      "schema:name": {
        "@language": "en",
        "@value": "Content on financial fraud"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~sched_1__para_3",
      "@type": "akn:paragraph",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~sched_1",
      "schema:text": {
        "@language": "en",
        "@value": "Obscene content including content that may give rise to a feeling of disgust due to lewd portrayal which may offend a person’s manner on decency and modesty"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~sched_1__para_4",
      "@type": "akn:paragraph",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~sched_1",
      "schema:text": {
        "@language": "en",
        "@value": "Indecent content including content which is profane in nature, improper and against generally accepted behavior or culture"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~sched_1__para_5",
      "@type": "akn:paragraph",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~sched_1",
      "schema:text": {
        "@language": "en",
        "@value": "Content that may cause harassment, distress, fear or alarm by way of threatening, abusive or insulting words or communication or act"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~sched_1__para_6",
      "@type": "akn:paragraph",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~sched_1",
      "schema:name": {
        "@language": "en",
        "@value": "Content that may incite violence or terrorism"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~sched_1__para_7",
      "@type": "akn:paragraph",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~sched_1",
      "schema:name": {
        "@language": "en",
        "@value": "Content that may induce a child to cause harm to himself"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~sched_1__para_8",
      "@type": "akn:paragraph",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~sched_1",
      "schema:text": {
        "@language": "en",
        "@value": "Content that may promote feelings of ill-will or hostility amongst the public at large or may disturb public tranquility"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~sched_1__para_9",
      "@type": "akn:paragraph",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~sched_1__para_9__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~sched_1__para_9__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~sched_1__para_9__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~sched_1",
      "schema:name": {
        "@language": "en",
        "@value": "Content that promotes the use or sale of dangerous drugs"
      },
      "schema:text": {
        "@language": "en",
        "@value": "Notes:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~sched_1__para_9__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~sched_1__para_9",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of paragraph 2, a content that promotes awareness or education relating to financial fraud is not a content on financial fraud"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~sched_1__para_9__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~sched_1__para_9",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of paragraph 3 and 4, a content that portrays private parts for education, scientific or medical purposes is not an obscene or indecent content"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~sched_1__para_9__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~sched_1__para_9",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of paragraph 9, a content that promotes awareness or education relating to drug abuse is not a content that promotes the use or sale of dangerous drugs"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@/~sched_2",
      "@type": "akn:schedule",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "[Section 4] PRIORITY HARMFUL CONTENT “Priority harmful content” means the contents referred to in paragraphs 1 and 2 of the First Schedule."
      }
    }
  ]
}
