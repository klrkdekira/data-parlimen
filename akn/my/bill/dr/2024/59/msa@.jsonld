        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_81__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_81__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_81",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh membuat peraturan-peraturan sebagaimana yang perlu atau suai manfaat bagi maksud pelaksanaan peruntukan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_81__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
