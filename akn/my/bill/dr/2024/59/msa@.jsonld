      "schema:text": {
        "@language": "ms",
        "@value": "dia telah disabitkan atas suatu kesalahan, di bawah mana-mana undang-undang, oleh mahkamah di Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_42__subsec_1__para_f",
