    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_52__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_52",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh secara bertulis memberikan kuasa kepada mana-mana pegawai awam atau pegawai Suruhanjaya untuk menjalankan kuasa penguatkuasaan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_52__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_52",
      "schema:text": {
        "@language": "ms",
        "@value": "Pegawai yang diberi kuasa di bawah subseksyen (1) hendaklah disifatkan sebagai pekhidmat awam mengikut pengertian Kanun Keseksaan [Akta 574]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_52__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_52",
      "schema:text": {
        "@language": "ms",
        "@value": "Hendaklah dikeluarkan kepada setiap pegawai diberi kuasa suatu kad kuasa yang ditandatangani oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_52__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_52",
      "schema:text": {
        "@language": "ms",
        "@value": "Bilamana pegawai diberi kuasa itu menjalankan kuasa di bawah Akta ini, dia hendaklah, apabila diminta mengemukakan kepada orang yang terhadapnya kuasa itu sedang dijalankan kad kuasa yang dikeluarkan kepadanya di bawah subseksyen (3). Kuasa untuk menyiasat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_53",
      "@type": "akn:clause",
      "eli:number": "53",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_53__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_53__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_53__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_53",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pegawai diberi kuasa hendaklah mempunyai semua kuasa yang perlu untuk menjalankan penyiasatan mengenai apa-apa ketidakpatuhan atau perlakuan suatu kesalahan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_53__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_53",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam apa-apa hal yang berhubungan dengan perlakuan suatu kesalahan di bawah Akta ini, seorang pegawai diberi kuasa yang menjalankan suatu penyiasatan boleh menjalankan semua atau mana-mana kuasa khas berhubung dengan penyiasatan polis dalam kes boleh tangkap yang diberikan oleh Kanun Tatacara Jenayah [Akta 593]. Penggeledahan dan penyitaan dengan waran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_54",
      "@type": "akn:clause",
      "eli:number": "54",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_54__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_54__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_54__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_54__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_54__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_54__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_54__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_54__subsec_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_54__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_54",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika ternyata pada seseorang Majistret, berdasarkan maklumat bertulis dengan bersumpah dan selepas apa-apa siasatan yang difikirkannya perlu, bahawa terdapat sebab yang munasabah untuk mempercayai bahawa suatu kesalahan di bawah Akta ini sedang atau telah dilakukan di mana-mana premis, atau bahawa apa-apa keterangan atau benda yang perlu untuk penjalanan sesuatu penyiasatan suatu kesalahan boleh dijumpai di mana-mana premis, Majistret itu boleh mengeluarkan suatu waran yang memberikan kuasa kepada mana-mana pegawai diberi kuasa yang dinamakan dalam waran itu, untuk memasuki premis itu pada bila-bila masa yang munasabah pada waktu siang atau malam, dengan atau tanpa bantuan dan jika perlu secara paksa, dan di premis itu menggeledah dan menyita apa-apa keterangan atau benda sedemikian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_54__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_54__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_54__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_54",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan keluasan subseksyen (1), waran yang dikeluarkan oleh Majistret boleh memberikan kuasa untuk penggeledahan dan penyitaan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_54__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_54__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana buku, akaun, dokumen, data berkomputer, papan tanda, kad, surat, risalah, lembaran atau notis, yang mengandungi atau yang semunasabahnya disyaki mengandungi maklumat mengenai apa-apa kesalahan yang disyaki telah dilakukan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_54__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_54__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa dokumen, kemudahan, radas, kelengkapan, peranti, benda atau bahan lain yang dengan semunasabahnya dipercayai dapat memberikan keterangan mengenai perlakuan kesalahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_54__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_54",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pegawai diberi kuasa yang membuat penggeledahan di bawah subseksyen (1) boleh, bagi maksud menyiasat kesalahan itu, memeriksa mana-mana orang yang berada di dalam atau di premis itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_54__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_54",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pegawai diberi kuasa yang membuat pemeriksaan terhadap seseorang di bawah subseksyen (3) boleh menyita, atau mengambil milik, dan menyimpan dalam jagaan selamat semua benda, selain pakaian yang perlu dipakai, yang dijumpai pada orang itu, dan apa-apa benda lain, yang baginya ada sebab untuk mempercayai bahawa benda-benda itu merupakan peralatan atau keterangan bagi jenayah itu, dan setakat yang penggeledahan itu adalah bagi penyiasatan suatu kesalahan benda-benda itu boleh ditahan sehingga orang itu dilepaskan atau dibebaskan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_54__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_54",
      "schema:text": {
        "@language": "ms",
        "@value": "Bilamana perlu untuk memeriksa seorang wanita, pemeriksaan itu hendaklah dilakukan oleh seorang wanita lain dengan penuh kesopanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_54__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_54",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika, oleh sebab sifat, saiz atau amaunnya, adalah tidak praktik untuk memindahkan mana-mana buku, akaun, dokumen, data berkomputer, papan tanda, kad, surat, risalah, lembaran, notis, kemudahan, radas, kelengkapan, peranti, benda atau bahan yang disita di bawah seksyen ini, pegawai yang menyita hendaklah, dengan apa-apa cara, mengelak buku, akaun, dokumen, data berkomputer, papan tanda, kad, surat, risalah, lembaran, notis, kemudahan, radas, kelengkapan, peranti atau bahan itu di dalam premis atau bekas tempat ia dijumpai."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_54__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_54",
      "schema:text": {
        "@language": "ms",
        "@value": "Seorang yang, tanpa kuasa yang sah, memecahkan, mengusik atau merosakkan lak yang disebut dalam subseksyen (6) atau mengalihkan mana-mana buku, akaun, dokumen, data berkomputer, papan tanda, kad, surat, risalah, lembaran, notis, kemudahan, radas, kelengkapan, peranti, benda atau bahan yang dilak atau cuba untuk berbuat demikian melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi satu juta ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_54__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_54",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu penggeledahan di bawah seksyen ini menunjukkan bahawa terdapat apa-apa kelengkapan yang menyebabkan gangguan, radas radio atau kelengkapan yang peka radio, pegawai diberi kuasa itu boleh mengarahkan supaya langkah-langkah perlu diambil untuk memastikan persekitaran yang bebas daripada gangguan. Penggeledahan dan penyitaan tanpa waran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_55",
      "@type": "akn:clause",
      "eli:number": "55",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seseorang pegawai diberi kuasa dalam mana-mana hal keadaan yang disebut dalam seksyen 54 mempunyai sebab yang munasabah untuk mempercayai bahawa oleh sebab kelengahan dalam memperoleh suatu waran penggeledahan di bawah seksyen itu penyiasatan akan terjejas atau keterangan mengenai pelakuan suatu kesalahan mungkin diganggu, dipindahkan, dirosakkan atau dimusnahkan, pegawai itu boleh memasuki premis itu dan menjalankan di dalam, pada dan berkenaan dengan premis itu semua kuasa yang disebut dalam seksyen 54 dengan cara yang sepenuhnya dan secukupnya seolah-olah dia diberi kuasa untuk berbuat demikian oleh suatu waran yang dikeluarkan di bawah seksyen itu. Waran boleh diterima walaupun cacat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_56",
      "@type": "akn:clause",
      "eli:number": "56",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu waran geledah yang dikeluarkan di bawah Akta ini adalah sah dan boleh dikuatkuasakan walau apa pun apa-apa kecacatan, kesilapan atau peninggalan dalam waran geledah itu atau dalam permohonan bagi waran itu dan apa-apa buku, akaun, dokumen, data berkomputer, papan tanda, kad, surat, risalah, lembaran, notis, kemudahan, radas, kelengkapan, peranti, benda atau bahan yang disita di bawah waran itu boleh diterima sebagai keterangan dalam mana-mana prosiding di bawah Akta ini. Akses kepada data berkomputer"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_57",
      "@type": "akn:clause",
      "eli:number": "57",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_57__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_57__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_57__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_57",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pegawai diberi kuasa yang membuat penggeledahan di bawah Akta ini hendaklah diberikan akses kepada data berkomputer sama ada disimpan dalam suatu komputer atau selainnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_57__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_57",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini, pegawai diberi kuasa hendaklah diberikan kata laluan, kod penyulitan, kod penyahsulitan, perisian atau perkakasan yang perlu dan apa-apa cara lain yang dikehendaki untuk membolehkan data berkomputer itu difahami. Senarai benda yang disita"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_58",
      "@type": "akn:clause",
      "eli:number": "58",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_58__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_58__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_58__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_58__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_58__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_58__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_58",
      "schema:text": {
        "@language": "ms",
        "@value": "Kecuali sebagaimana yang diperuntukkan dalam subseksyen (2), jika apa-apa buku, akaun, dokumen, data berkomputer, papan tanda, kad, surat, risalah, lembaran, notis, kemudahan, radas, kelengkapan, peranti, benda atau bahan disita menurut Akta ini, pegawai diberi kuasa yang menyita—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_58__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_58__subsec_1__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_58__subsec_1__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_58__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah menyediakan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_58__subsec_1__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_58__subsec_1__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu senarai buku, akaun, dokumen, data berkomputer, papan tanda, kad, surat, risalah, lembaran, notis, kemudahan, radas, kelengkapan, peranti, benda atau bahan yang disita itu dan hendaklah menandatangani senarai itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_58__subsec_1__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_58__subsec_1__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu notis secara bertulis mengenai penyitaan itu yang mengandungi alasan bagi penyitaan dan hendaklah menandatangani notis itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_58__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_58__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah, dengan secepat yang dapat dilaksanakan, menyampaikan suatu salinan senarai buku, akaun, dokumen, data berkomputer, papan tanda, kad, surat, risalah, lembaran, notis, kemudahan, radas, kelengkapan, peranti, benda atau bahan yang disita dan notis secara bertulis mengenai penyitaan itu kepada penghuni premis yang telah digeledah itu, atau kepada ejen atau pekhidmatnya di dalam premis itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_58__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_58",
      "schema:text": {
        "@language": "ms",
        "@value": "Notis secara bertulis mengenai penyitaan itu tidak dikehendaki untuk disampaikan menurut perenggan (1)(b) jika penyitaan itu dibuat dengan kehadiran orang yang terhadapnya prosiding di bawah Akta ini dicadangkan untuk diambil, atau dengan kehadiran pemunya harta itu atau ejennya, mengikut mana-mana yang berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_58__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_58",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika premis itu tidak diduduki, pegawai diberi kuasa hendaklah menampal suatu salinan senarai buku, akaun, dokumen, data berkomputer, papan tanda, kad, surat, risalah, lembaran, notis, kemudahan, radas, kelengkapan, peranti, benda atau bahan yang disita itu di tempat yang mudah dilihat di premis itu. Pelepasan benda yang disita"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_59",
      "@type": "akn:clause",
      "eli:number": "59",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_59__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_59__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_59__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_59",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika apa-apa buku, akaun, dokumen, data berkomputer, papan tanda, kad, surat, risalah, lembaran, notis, kemudahan, radas, kelengkapan, peranti, benda atau bahan telah disita di bawah Akta ini, pegawai diberi kuasa yang membuat penyitaan itu boleh, selepas merujuk kepada Pendakwa Raya melepaskan buku, akaun, dokumen, data berkomputer, papan tanda, kad, surat, risalah, lembaran, notis, kemudahan, radas, kelengkapan, peranti, benda atau bahan yang disita kepada orang sebagaimana yang ditentukan olehnya sebagai berhak secara sah kepada buku, akaun, dokumen, data berkomputer, papan tanda, kad, surat, risalah, lembaran, notis, kemudahan, radas, kelengkapan, peranti, benda atau bahan itu jika dia berpuas hati bahawa buku, akaun, dokumen, data berkomputer, papan tanda, kad, surat, risalah, lembaran, notis, kemudahan, radas, kelengkapan, peranti, benda atau bahan itu tidak boleh dilucuthakkan di bawah Akta ini dan tidak dikehendaki selainnya bagi maksud apa-apa prosiding di bawah Akta ini, atau bagi maksud pendakwaan di bawah mana-mana undang-undang lain, dan dalam hal sedemikian pegawai yang membuat penyitaan itu, atau Kerajaan atau mana-mana orang yang bertindak bagi pihak Kerajaan, tidak boleh dikenakan apa-apa prosiding oleh mana-mana orang jika penyitaan dan pelepasan buku, akaun, dokumen, data berkomputer, papan tanda, kad, surat, risalah, lembaran, notis, kemudahan, radas, kelengkapan, peranti, benda atau bahan itu telah dibuat dengan suci hati."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_59__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_59",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu rekod secara bertulis hendaklah dibuat oleh pegawai yang membuat pelepasan apa-apa buku, akaun, dokumen, data berkomputer, papan tanda, kad, surat, risalah, lembaran, notis, kemudahan, radas, kelengkapan, peranti, benda atau bahan di bawah subseksyen (1) yang menyatakan secara terperinci hal keadaan dan sebab bagi pelepasan itu, dan dia hendaklah menghantar suatu salinan rekod itu kepada Pendakwa Raya dalam tempoh tujuh hari daripada pelepasan itu. Pemeliharaan data komunikasi"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_60",
      "@type": "akn:clause",
      "eli:number": "60",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_60__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_60__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_60__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_60__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_60__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_60__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_60",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seseorang pegawai diberi kuasa berpuas hati bahawa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_60__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_60__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "data komunikasi adalah semunasabahnya dikehendaki bagi maksud suatu penyiasatan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_60__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_60__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "terdapat risiko bahawa data komunikasi itu mungkin dimusnahkan atau menjadi tidak dapat diakses, pegawai diberi kuasa boleh, dengan notis secara bertulis yang diberikan kepada seseorang yang mempunyai kawalan kepada sistem komunikasi, menghendaki orang itu memastikan data komunikasi yang dinyatakan dalam notis itu dipelihara bagi tempoh dan mengikut cara sebagaimana yang dinyatakan dalam notis secara bertulis itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_60__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_60__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_60__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_60",
      "schema:text": {
        "@language": "ms",
        "@value": "Orang yang kepadanya diberikan notis secara bertulis di bawah subseksyen (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_60__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_60__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah memelihara data komunikasi yang dinyatakan dalam notis itu bagi tempoh dan dalam cara sebagaimana yang dinyatakan dalam notis itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_60__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_60__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak boleh menzahirkan kewujudan dan kandungan notis itu, tatacara, kaedah, cara atau apa-apa perkara yang berkaitan dengan pemeliharaan data komunikasi di bawah subseksyen (1) tanpa kebenaran yang sah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_60__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_60",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang melanggar subseksyen (2) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi satu juta ringgit dan boleh didenda selanjutnya tidak melebihi satu ratus ribu ringgit bagi setiap hari atau sebahagian daripadanya selama kesalahan itu berterusan selepas sabitan. Penzahiran data komunikasi yang disimpan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_61",
      "@type": "akn:clause",
      "eli:number": "61",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_61__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_61__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_61__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_61__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_61",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seseorang pegawai diberi kuasa berpuas hati bahawa mana-mana data komunikasi adalah semunasabahnya dikehendaki bagi maksud suatu penyiasatan tentang suatu kesalahan di bawah Akta ini, pegawai diberi kuasa itu boleh, melalui notis secara bertulis yang diberikan kepada seseorang yang mempunyai kawalan terhadap sistem komunikasi, menghendaki orang itu untuk menzahirkan data komunikasi itu mengikut cara sebagaimana yang dinyatakan dalam notis."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_61__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_61__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_61__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_61",
      "schema:text": {
        "@language": "ms",
        "@value": "Orang yang kepadanya diberikan notis secara bertulis di bawah subseksyen (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_61__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_61__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah menzahirkan data komunikasi itu mengikut cara sebagaimana yang dinyatakan dalam notis itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_61__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_61__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak boleh menzahirkan kewujudan dan kandungan notis bertulis itu, tatacara, kaedah, cara atau apa-apa perkara yang berkaitan dengan penzahiran data komunikasi di bawah subseksyen (1) tanpa kuasa yang sah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_61__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_61",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang melanggar subseksyen (2) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi satu juta ringgit dan boleh didenda selanjutnya tidak melebihi satu ratus ribu ringgit bagi setiap hari atau sebahagian daripadanya selama kesalahan itu berterusan selepas sabitan. Halangan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_62",
      "@type": "akn:clause",
      "eli:number": "62",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_62__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_62__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_62__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_62__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_62__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII",
      "schema:name": {
        "@language": "ms",
        "@value": "Mana-mana orang yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_62__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_62",
      "schema:text": {
        "@language": "ms",
        "@value": "enggan memberi mana-mana pegawai diberi kuasa akses kepada mana-mana premis yang pegawai diberi kuasa itu berhak kepadanya di bawah Akta ini atau dalam melaksanakan apa-apa kewajipan yang dikenakan atau kuasa yang diberikan oleh Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_62__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_62",
      "schema:text": {
        "@language": "ms",
        "@value": "mengamang, menghalang, menggalang atau melengahkan mana-mana pegawai diberi kuasa dalam membuat apa-apa kemasukan yang pegawai diberi kuasa itu berhak melaksanakan di bawah Akta ini, atau dalam melaksanakan apa-apa kewajipan yang dikenakan atau kuasa yang diberikan oleh Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_62__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_62",
      "schema:text": {
        "@language": "ms",
        "@value": "enggan memberi mana-mana pegawai diberi kuasa apa-apa maklumat yang berhubungan dengan suatu kesalahan atau kesalahan yang disyaki di bawah Akta ini atau apa-apa maklumat lain yang orang itu ada dalam pengetahuannya atau dalam kuasanya untuk diberikan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_62__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_62",
      "schema:text": {
        "@language": "ms",
        "@value": "mengambil balik atau berusaha untuk mengambil balik atau menyebabkan untuk diambil balik apa-apa jua yang telah disita dengan sewajarnya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_62__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_62",
      "schema:text": {
        "@language": "ms",
        "@value": "memusnahkan apa-apa benda untuk mengelakkannya daripada disita atau didapatkannya, melakukan suatu kesalahan dan apabila disabit kesalahan, boleh didenda tidak melebihi satu juta ringgit. Kuasa tambahan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_63",
      "@type": "akn:clause",
      "eli:number": "63",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_63__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_63__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_63__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pegawai diberi kuasa hendaklah, bagi maksud melaksanakan Akta ini, mempunyai kuasa untuk melakukan semua atau mana-mana yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_63__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_63",
      "schema:text": {
        "@language": "ms",
        "@value": "menghendaki pengemukaan buku, akaun, dokumen, data berkomputer, papan tanda, kad, surat, risalah, lembaran, notis, kemudahan, radas, kelengkapan, peranti, benda atau bahan yang disimpan oleh pemberi perkhidmatan aplikasi berlesen, pemberi perkhidmatan aplikasi kandungan berlesen atau pemberi perkhidmatan rangkaian berlesen, atau mana-mana orang lain dan untuk memeriksa, meneliti dan untuk memuat turun, membuat salinan atau untuk mengambil cabutan daripadanya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_63__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_63",
      "schema:text": {
        "@language": "ms",
        "@value": "menghendaki pengemukaan mana-mana dokumen pengenalan daripada mana-mana orang berhubung dengan mana-mana kes atau kesalahan di bawah Akta ini; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_63__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_63",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat apa-apa siasatan sebagaimana yang perlu untuk menentukan sama ada peruntukan Akta ini telah dipatuhi. Kuasa untuk menghendaki kehadiran orang yang mempunyai pengetahuan tentang kes"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_64",
      "@type": "akn:clause",
      "eli:number": "64",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_64__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_64__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_64__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_64",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pegawai diberi kuasa yang membuat suatu penyiasatan di bawah Akta ini boleh, melalui perintah secara bertulis, menghendaki supaya hadir di hadapannya seseorang yang pada hemat pegawai diberi kuasa itu tahu tentang hal keadaan kes itu, dan orang itu hendaklah hadir sebagaimana yang dikehendaki sedemikian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_64__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_64",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika orang itu tidak hadir sebagaimana yang dikehendaki, pegawai diberi kuasa itu boleh melaporkan ketidakhadiran itu kepada seorang Majistret yang hendaklah mengeluarkan suatu waran untuk memastikan kehadiran orang itu. Pemeriksaan orang yang mempunyai pengetahuan tentang kes"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_65",
      "@type": "akn:clause",
      "eli:number": "65",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_65__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_65__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_65__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_65__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_65__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_65__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_65",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pegawai diberi kuasa yang menjalankan suatu penyiasatan di bawah Akta ini boleh memeriksa secara lisan seseorang yang dikatakan mempunyai pengetahuan tentang fakta dan hal keadaan kes itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_65__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_65",
      "schema:text": {
        "@language": "ms",
        "@value": "Orang itu terikat di sisi undang-undang untuk menjawab semua soalan yang berhubungan dengan kes itu yang diajukan kepadanya oleh pegawai diberi kuasa itu, tetapi orang itu boleh enggan untuk menjawab mana-mana soalan yang jawapannya mungkin akan mendedahkannya kepada suatu pertuduhan jenayah atau penalti atau pelucuthakan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_65__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_65",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang membuat suatu pernyataan di bawah seksyen ini terikat di sisi undang-undang untuk menyatakan yang benar, sama ada pernyataan itu dibuat keseluruhannya atau sebahagiannya sebagai jawapan kepada soalan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_65__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_65",
      "schema:text": {
        "@language": "ms",
        "@value": "Pegawai diberi kuasa yang memeriksa seseorang di bawah subseksyen (1) hendaklah terlebih dahulu memaklumkan orang itu peruntukan subseksyen (2) dan (3)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_65__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_65",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu pernyataan yang dibuat oleh seseorang di bawah seksyen ini hendaklah, bilamana mungkin, diubah ke dalam bentuk bertulis dan ditandatangani oleh orang yang membuatnya atau dilekatkan dengan cap jarinya, mengikut mana-mana yang berkenaan, selepas pernyataan itu dibacakan kepadanya dalam bahasa yang dalamnya pernyataan dibuat olehnya dan selepas dia diberi peluang untuk membuat apa-apa pembetulan yang ingin dibuat olehnya. Kebolehterimaan pernyataan sebagai keterangan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_66",
      "@type": "akn:clause",
      "eli:number": "66",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_66__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_66__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_66__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_66__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_66",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana orang dipertuduh atas suatu kesalahan di bawah Akta ini, apa-apa pernyataan, sama ada pernyataan itu merupakan suatu pengakuan atau tidak atau sama ada pernyataan itu dibuat secara lisan atau bertulis, dibuat pada bila-bila masa, sama ada sebelum atau selepas orang itu dipertuduh dan sama ada dalam penjalanan suatu penyiasatan di bawah Akta ini atau tidak dan sama ada atau tidak secara keseluruhannya atau sebahagiannya sebagai jawapan kepada soalan atau tidak, oleh orang itu kepada atau dengan didengar oleh seorang pegawai diberi kuasa dan sama ada diterjemahkan kepadanya atau tidak oleh seorang pegawai lain atau orang lain, hendaklah diterima sebagai keterangan dalam perbicaraannya dan, jika orang yang dipertuduh itu mengemukakan dirinya sebagai seorang saksi, mana-mana pernyataan sedemikian boleh digunakan semasa pemeriksaan balas dan bagi maksud mencabar kebolehpercayaannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_66__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_66__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_66__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_66",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada pernyataan di bawah subseksyen (1) boleh diterima atau digunakan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_66__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_66__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "jika pembuatan pernyataan itu pada hemat mahkamah telah disebabkan oleh apa-apa dorongan, ugutan atau janji yang berkaitan dengan pertuduhan terhadap orang itu yang datang daripada seseorang yang berkuasa dan cukup pada pendapat mahkamah untuk memberi orang yang dipertuduh itu alasan yang pada pendapatnya munasabah untuk mengandaikan bahawa dengan membuat pernyataan itu dia akan mendapat apa-apa kelebihan atau mengelakkan apa-apa durjana keduniaan berkenaan dengan prosiding terhadapnya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_66__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_66__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal suatu pernyataan yang dibuat oleh orang itu selepas penangkapannya, melainkan jika mahkamah berpuas hati bahawa dia telah diberi amaran dengan perkataan yang berikut atau perkataan yang mempunyai maksud yang sama: “Adalah menjadi kewajipan saya untuk memberikan amaran kepada kamu bahawa kamu tidak diwajibkan untuk menyatakan apa-apa atau menjawab apa-apa soalan, tetapi apa-apa yang kamu nyatakan, sama ada sebagai jawapan kepada suatu soalan atau tidak, boleh diberikan sebagai keterangan”."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_66__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_66",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu pernyataan yang dibuat oleh seseorang sebelum ada kesempatan untuk memberikan amaran kepadanya tidak boleh menjadikan pernyataan itu tidak boleh diterima sebagai keterangan hanya semata-mata kerana orang itu tidak diberi amaran jika dia diberi amaran secepat yang dapat dilaksanakan selepas itu. Pelucuthakan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_67",
      "@type": "akn:clause",
      "eli:number": "67",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_67__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_67__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_67__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_67__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_67__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_67__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_67__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_67__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_67",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa buku, akaun, dokumen, data berkomputer, papan tanda, kad, surat, risalah, lembaran, notis, kemudahan, radas, kelengkapan, peranti, benda atau bahan yang disita di bawah Akta ini boleh dilucuthakkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_67__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_67",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu perintah bagi pelucuthakan atau pelepasan mana-mana buku, akaun, dokumen, data berkomputer, papan tanda, kad, surat, risalah, lembaran, notis, kemudahan, radas, kelengkapan, peranti, benda atau bahan yang boleh dilucuthakkan di bawah seksyen ini hendaklah dibuat oleh mahkamah yang di hadapannya pendakwaan berkenaan dengannya telah diadakan dan suatu perintah bagi pelucuthakan buku, akaun, dokumen, data berkomputer, papan tanda, kad, surat, risalah, lembaran, notis, kemudahan, radas, kelengkapan, peranti, benda atau bahan itu hendaklah dibuat jika dibuktikan sehingga memuaskan mahkamah bahawa suatu kesalahan di bawah Akta ini telah dilakukan dan bahawa buku, akaun, dokumen, data berkomputer, papan tanda, kad, surat, risalah, lembaran, notis, kemudahan, radas, kelengkapan, peranti, benda atau bahan itu telah digunakan dalam perlakuan kesalahan itu walaupun pada hakikatnya tiada seorang pun telah disabitkan atas kesalahan atau pelanggaran itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_67__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_67",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika tiada pendakwaan berkenaan dengan mana-mana buku, akaun, dokumen, data berkomputer, papan tanda, kad, surat, risalah, lembaran, notis, kemudahan, radas, kelengkapan, peranti, benda atau bahan yang disita dalam penjalanan mana-mana kuasa yang diberikan di bawah Akta ini, buku, akaun, dokumen, data berkomputer, papan tanda, kad, surat, risalah, lembaran, notis, kemudahan, radas, kelengkapan, peranti, benda atau bahan itu hendaklah dikira atau disifatkan terlucut hak apabila habis tempoh dua belas bulan dari tarikh ia disita melainkan jika suatu tuntutan dibuat kepadanya sebelum tarikh itu mengikut cara yang diperuntukkan dalam seksyen ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_67__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_67",
      "schema:text": {
        "@language": "ms",
        "@value": "Seorang yang menegaskan bahawa dia ialah pemunya mana-mana buku, akaun, dokumen, data berkomputer, papan tanda, kad, surat, risalah, lembaran, notis, kemudahan, radas, kelengkapan, peranti, benda atau bahan yang disita di bawah Akta ini dan bahawa buku, akaun, dokumen, data berkomputer, papan tanda, kad, surat, risalah, lembaran, notis, kemudahan, radas, kelengkapan, peranti, benda atau bahan itu tidak boleh dilucuthakkan boleh secara sendiri atau melalui ejennya yang diberi kuasa secara bertulis olehnya memberikan notis secara bertulis kepada Suruhanjaya atau mana-mana pegawai diberi kuasa mengenai tuntutannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_67__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_67",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila menerima suatu notis di bawah subseksyen (4), Suruhanjaya atau mana-mana pegawai diberi kuasa itu hendaklah, selepas siasatan yang perlu, mengarahkan supaya buku, akaun, dokumen, data berkomputer, papan tanda, kad, surat, risalah, lembaran, notis, kemudahan, radas, kelengkapan, peranti, benda atau bahan itu dilepaskan atau dilucuthakkan atau merujukkan kes itu kepada Hakim Mahkamah Sesyen bagi keputusan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_67__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_67",
      "schema:text": {
        "@language": "ms",
        "@value": "Hakim Mahkamah Sesyen yang kepadanya kes itu dirujuk hendaklah mengeluarkan suatu saman yang menghendaki orang yang menegaskan bahawa dia ialah pemunya buku, akaun, dokumen, data berkomputer, papan tanda, kad, surat, risalah, lembaran, notis, kemudahan, radas, kelengkapan, peranti, benda atau bahan itu dan orang yang daripadanya buku, akaun, dokumen, data berkomputer, papan tanda, kad, surat, risalah, lembaran, notis, kemudahan, radas, kelengkapan, peranti, benda atau bahan itu disita hadir di hadapannya dan apabila dia hadir atau tidak hadir, setelah dibuktikan saman itu telah disampaikan dengan wajar, Hakim Mahkamah Sesyen itu hendaklah meneruskan pemeriksaan kes itu dan apabila dibuktikan bahawa suatu kesalahan di bawah Akta ini telah dilakukan dan bahawa buku, akaun, dokumen, data berkomputer, papan tanda, kad, surat, risalah, lembaran, notis, kemudahan, radas, kelengkapan, peranti, benda atau bahan itu merupakan hal perkara atau telah digunakan dalam perlakuan kesalahan itu, hendaklah memerintahkan supaya buku, akaun, dokumen, data berkomputer, papan tanda, kad, surat, risalah, lembaran, notis, kemudahan, radas, kelengkapan, peranti, benda atau bahan itu dilucuthakkan atau boleh, jika tiada bukti sedemikian, memerintahkan pelepasan buku, akaun, dokumen, data berkomputer, papan tanda, kad, surat, risalah, lembaran, notis, kemudahan, radas, kelengkapan, peranti, benda atau bahan itu kepada orang yang berhak kepadanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_67__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_67",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana buku, akaun, dokumen, data berkomputer, papan tanda, kad, surat, risalah, lembaran, notis, kemudahan, radas, kelengkapan, peranti, benda atau bahan yang dilucuthakkan atau disifatkan telah dilucuthakkan hendaklah diserahkan kepada Suruhanjaya atau seorang pegawai diberi kuasa yang hendaklah melupuskannya mengikut cara sebagaimana yang disifatkan patut oleh Suruhanjaya. Bidang kuasa untuk membicarakan kesalahan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII__cl_68",
      "@type": "akn:clause",
      "eli:number": "68",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VIII",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun mana-mana undang-undang bertulis yang bertentangan, Mahkamah Sesyen hendaklah mempunyai bidang kuasa untuk membicarakan mana-mana kesalahan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "hasPart": [
