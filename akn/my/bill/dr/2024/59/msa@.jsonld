      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh pada bila-bila masa membatalkan pelantikan mana-mana anggota Tribunal Rayuan Keselamatan dalam Talian jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_42__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_42__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dia meletakkan jawatannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_42__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_42__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dia menjadi tidak sempurna akal atau selainnya tidak berupaya untuk melaksanakan tugasnya atau menguruskan hal ehwalnya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_42__subsec_1__para_c",
