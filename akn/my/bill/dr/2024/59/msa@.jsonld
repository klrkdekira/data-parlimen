    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Pemberi perkhidmatan aplikasi berlesen dan pemberi perkhidmatan aplikasi kandungan berlesen hendaklah melaksanakan langkah-langkah sebagaimana yang dinyatakan dalam kod untuk memastikan penggunaan selamat perkhidmatannya oleh pengguna kanak-kanak."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (1), pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen boleh melaksanakan apa-apa langkah alternatif selain langkah-langkah yang dinyatakan dalam kod jika pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen itu membuktikan sehingga memuaskan Suruhanjaya bahawa langkah-langkah alternatif itu akan memastikan dengan lebih baik penggunaan yang selamat perkhidmatannya oleh pengguna kanak-kanak."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_18__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_18__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_18__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_18__subsec_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_18__subsec_3__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_18__subsec_3__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Langkah-langkah yang dilaksanakan di bawah seksyen ini hendaklah termasuk langkah-langkah untuk memastikan reka bentuk dan pengendalian yang selamat bagi perkhidmatan yang, pada pendapat pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen, berkemungkinan akan diakses oleh pengguna kanak-kanak—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_18__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_18__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menghalang akses seseorang pengguna yang dikenal pasti sebagai seorang kanak-kanak kepada kandungan yang disyaki sebagai kandungan memudaratkan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_18__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_18__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengehadkan keupayaan seseorang pengguna yang dikenal pasti sebagai seorang dewasa daripada berkomunikasi dengan pengguna yang dikenal pasti sebagai seorang kanak-kanak;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_18__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_18__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengehadkan ciri-ciri yang meningkatkan, mengekalkan atau melanjutkan penggunaan perkhidmatannya oleh seseorang pengguna yang dikenal pasti sebagai seorang kanak-kanak;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_18__subsec_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_18__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menghalang seseorang pengguna yang dikenal pasti sebagai seorang dewasa daripada melihat maklumat peribadi pengguna yang dikenal pasti sebagai seorang kanak-kanak yang terdapat dalam perkhidmatannya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_18__subsec_3__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_18__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengawal sistem saranan peribadi yang sesuai bagi pengguna kanak-kanak. Kewajipan untuk mengadakan mekanisme bagi menjadikan kandungan memudaratkan prioriti tidak dapat diakses"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Pemberi perkhidmatan aplikasi berlesen dan pemberi perkhidmatan aplikasi kandungan berlesen hendaklah mengadakan suatu mekanisme bagi menjadikan kandungan memudaratkan prioriti yang terdapat dalam perkhidmatannya tidak dapat diakses oleh semua pengguna. Kewajipan untuk menyediakan Pelan Keselamatan dalam Talian"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_20__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_20__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_20__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_20__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_20__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_20__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Pemberi perkhidmatan aplikasi berlesen dan pemberi perkhidmatan aplikasi kandungan berlesen hendaklah menyediakan suatu Pelan Keselamatan dalam Talian mengenai pematuhannya terhadap kewajipan di bawah Bahagian ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_20__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Pelan Keselamatan dalam Talian yang disebut dalam subseksyen (1) hendaklah disediakan dalam tempoh dan bentuk dan mengandungi maklumat, sebagaimana yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_20__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Pemberi perkhidmatan aplikasi berlesen dan pemberi perkhidmatan aplikasi kandungan berlesen hendaklah menjadikan Pelan Keselamatan dalam Talian yang disediakan di bawah subseksyen (1) tersedia dalam perkhidmatannya dan memastikan bahawa Pelan Keselamatan dalam Talian itu boleh diakses dengan mudah dan selalu dikemas kini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_20__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Pelan Keselamatan dalam Talian yang disediakan dan dijadikan tersedia di bawah seksyen ini tidak boleh mengandungi apa-apa maklumat peribadi mana-mana pengguna."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_20__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesalinan Pelan Keselamatan dalam Talian yang disediakan di bawah subseksyen (1) hendaklah dikemukakan kepada Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_10__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_10__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_10__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_10__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_10__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_10__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatankuasa hendaklah mempunyai fungsi untuk menasihati dan memberikan syor kepada Suruhanjaya mengenai perkara yang berhubungan dengan keselamatan dalam talian termasuk—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_10__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_10__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "penentuan jenis kandungan memudaratkan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_10__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_10__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "penentuan kandungan memudaratkan prioriti;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_10__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_10__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "kaedah untuk menganalisis dan langkah-langkah untuk mengurangkan, risiko pengguna didedahkan kepada kandungan memudaratkan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_10__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_10__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pendekatan kajian berkaitan dengan kandungan memudaratkan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_10__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_10__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "amalan terbaik untuk mengalakkan kebertanggungjawaban pemberi perkhidmatan aplikasi berlesen, pemberi perkhidmatan aplikasi kandungan berlesen dan pemberi perkhidmatan rangkaian berlesen."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatankuasa hendaklah mempunyai segala kuasa yang perlu bagi, atau yang berkaitan dengan, atau yang semunasabahnya bersampingan dengan, pelaksanaan fungsinya di bawah Akta ini. Mesyuarat Jawatankuasa"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_11__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_11__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_11__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_11__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_11__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatankuasa hendaklah mengadakan mesyuaratnya seberapa kerap sebagaimana yang ditentukan oleh Pengerusi dan mesyuarat hendaklah diadakan pada masa dan di tempat sebagaimana yang ditentukan oleh Pengerusi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi hendaklah mempengerusikan semua mesyuarat Jawatankuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_11__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Pengerusi tidak hadir dalam mana-mana mesyuarat Jawatankuasa, dia boleh mengarahkan Timbalan Pengerusi untuk menggantikannya sebagai pengerusi mesyuarat itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_11__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Korum Jawatankuasa ialah tujuh dan hendaklah terdiri daripada sekurang-kurangnya seorang anggota yang dilantik di bawah perenggan 5(2)(j) dan seorang anggota yang dilantik di bawah perenggan 5(2)(l)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_11__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi boleh membenarkan penggunaan suatu rangkaian video secara langsung, rangkaian televisyen secara langsung atau apa-apa cara komunikasi elektronik yang lain bagi maksud apa-apa mesyuarat Jawatankuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_11__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatankuasa boleh menentukan tatacaranya sendiri. Jawatankuasa boleh mengundang orang lain untuk menghadiri mesyuarat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatankuasa boleh mengundang mana-mana orang untuk menghadiri mesyuarat Jawatankuasa untuk memberikan pendapat kepada Jawatankuasa mengenai apa-apa perkara yang sedang dibincangkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu jawatankuasa dengan nama “Jawatankuasa Keselamatan dalam Talian” ditubuhkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5__subsec_2__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5__subsec_2__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5__subsec_2__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5__subsec_2__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5__subsec_2__para_k",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5__subsec_2__para_l"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatankuasa hendaklah terdiri daripada anggota yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi dan Timbalan Pengerusi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang wakil daripada Kementerian yang dipertanggungkan dengan tanggungjawab bagi komunikasi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang wakil daripada Kementerian yang dipertanggungkan dengan tanggungjawab bagi hal ehwal dalam negeri;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang wakil daripada Kementerian yang dipertanggungkan dengan tanggungjawab bagi perkara berkaitan digital;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang wakil daripada Kementerian yang dipertanggungkan dengan tanggungjawab bagi pendidikan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang wakil daripada Kementerian yang dipertanggungkan dengan tanggungjawab bagi pembangunan wanita, keluarga dan masyarakat;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang wakil daripada Polis Diraja Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5__subsec_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang wakil daripada Majlis Keselamatan Negara;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5__subsec_2__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pesuruhjaya Kanak-Kanak atau wakilnya dalam kalangan Pesuruhjaya Kanak-Kanak;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5__subsec_2__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang wakil setiap satu daripada pemberi perkhidmatan aplikasi berlesen, pemberi perkhidmatan aplikasi kandungan berlesen dan pemberi perkhidmatan rangkaian berlesen;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5__subsec_2__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang wakil dalam kalangan orang kurang upaya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5__subsec_2__para_l",
      "@type": "akn:paragraph",
      "eli:number": "l",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak lebih daripada lima orang yang mempunyai pengalaman, pengetahuan atau kepakaran yang bersesuaian dalam perkara yang berhubungan dengan keselamatan dalam talian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Anggota Jawatankuasa yang disebut dalam perenggan (2)(a), (j), (k) dan (l) hendaklah dilantik oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Anggota Jawatankuasa yang dilantik di bawah perenggan (2)(a), (j), (k) dan (l) hendaklah memegang jawatan bagi suatu tempoh yang tidak melebihi tiga tahun dan adalah layak untuk dilantik semula selepas habis tempoh jawatannya bagi tempoh yang tidak melebihi tiga tahun."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud perenggan (2)(i), “Ketua Pesuruhjaya Kanak-Kanak” dan “Pesuruhjaya Kanak-Kanak” ertinya Ketua Pesuruhjaya Kanak-Kanak dan Pesuruhjaya Kanak-Kanak yang ditetapkan di bawah seksyen 6a Akta Suruhanjaya Hak Asasi Manusia Malaysia 1999 [Akta 597]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud Bahagian ini, “Menteri” ertinya Menteri yang dipertanggungkan dengan tanggungjawab bagi undang-undang. Elaun bagi anggota Jawatankuasa"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Anggota Jawatankuasa hendaklah dibayar elaun sebagaimana yang ditentukan oleh Menteri selepas berunding dengan Menteri Kewangan. Pembatalan pelantikan dan peletakan jawatan anggota Jawatankuasa"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_7__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh pada bila-bila masa membatalkan pelantikan mana-mana anggota Jawatankuasa yang disebut dalam perenggan 5(2)(a), (j), (k) dan (l) tanpa memberikan apa-apa sebab."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Anggota Jawatankuasa yang disebut dalam perenggan 5(2)(a), (j), (k) dan (l) boleh, pada bila-bila masa, meletakkan jawatan dengan memberikan notis secara bertulis kepada Menteri. Pengosongan jawatan anggota Jawatankuasa"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_8__subsec_1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_8__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_8__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_8__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_8__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_8__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_8__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_8__subsec_1__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_8__subsec_1__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_8__subsec_1__para_i"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatan seseorang anggota Jawatankuasa yang disebut dalam perenggan 5(2)(a), (j), (k) dan (l) hendaklah menjadi kosong—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_8__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_8__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia meninggal dunia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_8__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_8__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_8__subsec_1__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_8__subsec_1__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_8__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika telah dibuktikan terhadapnya, atau dia telah disabitkan atas, suatu pertuduhan berkenaan dengan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_8__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_8__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "kesalahan yang melibatkan fraud, kecurangan atau keburukan akhlak;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_8__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_8__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "kesalahan di bawah mana-mana undang-undang yang berhubungan dengan rasuah; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_8__subsec_1__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_8__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa kesalahan lain yang boleh dihukum dengan pemenjaraan, sama ada hukuman penjara sahaja atau sebagai tambahan kepada atau sebagai ganti denda, selama lebih daripada dua tahun;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_8__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_8__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika kelakuannya, sama ada yang berkaitan dengan kewajipannya sebagai seorang anggota Jawatankuasa atau selainnya, adalah sedemikian rupa sehingga memburukkan nama Jawatankuasa;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_8__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_8__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia menjadi bankrap atau tidak solven;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_8__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_8__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia menjadi tidak sempurna akal atau selainnya tidak berupaya menunaikan kewajipannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_8__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_8__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal Pengerusi, jika dia tidak menghadiri mesyuarat Jawatankuasa tiga kali berturut-turut tanpa kebenaran Menteri secara bertulis;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_8__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_8__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal seseorang anggota Jawatankuasa selain Pengerusi, jika dia tidak menghadiri mesyuarat Jawatankuasa tiga kali berturut-turut tanpa kebenaran Pengerusi secara bertulis;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_8__subsec_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_8__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika pelantikannya telah dibatalkan oleh Menteri; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_8__subsec_1__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_8__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika peletakan jawatannya telah diterima oleh Menteri. Penjalanan sementara fungsi Pengerusi"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_9__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_9__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_9__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_9__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Timbalan Pengerusi hendaklah bertindak sebagai Pengerusi selama tempoh apabila—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_9__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_9__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jawatan Pengerusi kosong;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_9__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_9__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi tidak hadir bertugas atau tidak berada di Malaysia; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_9__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_9__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi, atas apa-apa sebab lain, tidak dapat menjalankan fungsinya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Timbalan Pengerusi hendaklah, dalam tempoh dia menjalankan fungsi Pengerusi di bawah seksyen ini, disifatkan sebagai Pengerusi. Fungsi Jawatankuasa"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_21",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_22",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_23",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_24",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_25",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_26",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_27",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_28",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_29"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "PELAPORAN KANDUNGAN MEMUDARATKAN Laporan kepada pemberi perkhidmatan aplikasi berlesen dan pemberi perkhidmatan aplikasi kandungan berlesen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_21__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_21__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_21__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_21__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_21__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_21__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_21__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_21__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pengguna boleh membuat laporan kepada pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen berkenaan dengan apa-apa kandungan yang dipercayainya ialah kandungan memudaratkan yang terdapat dalam perkhidmatan pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen itu dalam bentuk dan mengikut cara sebagaimana yang ditentukan oleh pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_21__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_21__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_21__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_21__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila menerima laporan yang dibuat di bawah subseksyen (1), pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen itu hendaklah dalam tempoh sebagaimana yang ditetapkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_21__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_21__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mengaku terima penerimaan laporan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_21__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_21__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "memberitahu secara bertulis status laporan itu kepada pengguna yang membuat laporan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_21__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_21__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menilai laporan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_21__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_21__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_21__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila menilai laporan yang dibuat di bawah subseksyen (1), pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen itu hendaklah menolak laporan itu jika pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_21__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_21__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "berpendapat bahawa laporan itu bersifat remeh, menyusahkan atau tidak dibuat dengan suci hati atau hal perkara laporan itu adalah kecil; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_21__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_21__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "menentukan bahawa hal perkara laporan itu menjadi atau telah menjadi hal perkara suatu laporan lain yang dibuat kepada pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_21__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika laporan itu ditolak di bawah subseksyen (3), pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen itu hendaklah memberitahu secara bertulis pengguna yang membuat laporan itu mengenai penolakan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_21__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengguna yang terkilan dengan penolakan laporan di bawah subseksyen (3) boleh, melalui permintaan kepada pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen itu, membuat pertanyaan mengenai penolakan itu kepada pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen itu dalam tempoh sebagaimana yang ditetapkan dan memberikan sebab mengapa laporannya tidak patut ditolak oleh pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_21__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila menerima pertanyaan bersama-sama sebab daripada pengguna yang terkilan di bawah subseksyen (5), pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen itu boleh mengkaji semula keputusannya yang dibuat di bawah subseksyen (3) dan memutuskan sama ada penolakan itu patut dikekalkan atau tindakan lanjut patut diambil di bawah seksyen 22 atau 23."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_21__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa keputusan pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen yang dibuat di bawah subseksyen (6) berkenaan dengan pertanyaan itu hendaklah diberitahu secara bertulis kepada pengguna yang terkilan itu dalam tempoh sebagaimana yang ditetapkan. Laporan kepada pemberi perkhidmatan aplikasi berlesen dan pemberi perkhidmatan aplikasi kandungan berlesen mengenai kandungan memudaratkan prioriti"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_22__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_22__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_22__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_22__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_22__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_22__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_22__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_22__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika laporan yang dibuat oleh pengguna di bawah subseksyen 21(1) tidak ditolak di bawah subseksyen 21(3) atau (6) dan pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen berpendapat bahawa kandungan yang menjadi hal perkara laporan itu ialah kandungan memudaratkan prioriti, pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen itu hendaklah dengan serta-merta menjadikan kandungan itu tidak dapat diakses dalam perkhidmatannya kepada semua pengguna bagi suatu tempoh sebagaimana yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_22__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "Sebelum habis tempoh yang disebut dalam subseksyen (1), pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen itu hendaklah menentukan atas alasan yang munasabah jika kandungan yang dijadikan tidak dapat diakses dalam perkhidmatannya di bawah subseksyen (1) ialah kandungan memudaratkan prioriti."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_22__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_22__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_22__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen itu menentukan di bawah subseksyen (2) bahawa kandungan yang dijadikan tidak dapat diakses dalam perkhidmatannya di bawah subseksyen (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_22__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_22__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "ialah kandungan memudaratkan prioriti, pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen itu hendaklah, dalam tempoh sebagaimana yang ditetapkan, menjadikan kandungan memudaratkan prioriti itu tidak dapat diakses secara kekal dalam perkhidmatannya oleh semua pengguna; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_22__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_22__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "bukanlah kandungan memudaratkan prioriti, pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen itu boleh, dalam tempoh sebagaimana yang ditetapkan, menjadikan kandungan itu dapat diakses semula dalam perkhidmatannya oleh semua pengguna."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_22__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa tindakan yang diambil oleh pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen di bawah seksyen ini hendaklah diberitahu secara bertulis kepada pengguna yang membuat laporan berkenaan dengan kandungan itu dan pengguna yang menyampaikan kandungan itu dalam perkhidmatan pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_22__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengguna yang terkilan dengan tindakan yang diambil oleh pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen di bawah seksyen ini boleh, melalui permintaan kepada pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen itu, membuat pertanyaan mengenai tindakan itu kepada pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen itu dalam tempoh sebagaimana yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_22__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila menerima pertanyaan daripada pengguna yang terkilan di bawah subseksyen (5), pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen itu boleh mengkaji semula keputusannya mengenai tindakan yang diambil berhubung dengan pertanyaan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_22__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa keputusan pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen yang dibuat di bawah subseksyen (6) berhubung dengan pertanyaan itu hendaklah diberitahu secara bertulis kepada pengguna yang terkilan itu dalam tempoh sebagaimana yang ditetapkan. Laporan kepada pemberi perkhidmatan aplikasi berlesen dan pemberi perkhidmatan aplikasi kandungan berlesen mengenai kandungan memudaratkan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_23__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_23__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_23__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_23__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_23__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_23__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_23__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_23__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_23__subsec_9"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_23__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika laporan yang dibuat oleh pengguna di bawah subseksyen 21(1) tidak ditolak di bawah subseksyen 21(3) atau (6) dan pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen berpandapat bahawa kandungan yang menjadi hal perkara laporan itu ialah kandungan memudaratkan, pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen itu boleh menjadikan kandungan itu tidak dapat diakses dalam perkhidmatannya oleh semua pengguna dalam dan bagi suatu tempoh sebagaimana yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_23__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen itu menjadikan kandungan itu tidak dapat diakses dalam perkhidmatannya bagi tempoh yang ditetapkan di bawah subseksyen (1), pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen itu hendaklah, sebelum habis tempoh itu, menentukan atas alasan yang munasabah bahawa kandungan yang dijadikan tidak dapat diakses itu ialah kandungan memudaratkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_23__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_23__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_23__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen itu menentukan di bawah subseksyen (2) bahawa kandungan yang dijadikan tidak dapat diakses dalam perkhidmatannya di bawah subseksyen (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_23__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_23__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "ialah kandungan memudaratkan, pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen itu hendaklah, dalam tempoh sebagaimana yang ditetapkan, menjadikan kandungan memudaratkan itu tidak dapat diakses secara kekal dalam perkhidmatannya oleh semua pengguna; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_23__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_23__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "bukanlah kandungan memudaratkan, pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen itu hendaklah, dalam tempoh sebagaimana yang ditetapkan, menjadikan kandungan itu dapat diakses semula dalam perkhidmatannya oleh semua pengguna."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_23__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa tindakan yang diambil oleh pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen di bawah seksyen ini hendaklah diberitahu secara bertulis kepada pengguna yang membuat laporan berkenaan dengan kandungan itu dan pengguna yang menyampaikan kandungan itu dalam perkhidmatan pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_23__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengguna yang terkilan dengan tindakan yang diambil oleh pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen di bawah seksyen ini boleh, melalui permintaan kepada pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen itu, membuat pertanyaan mengenai tindakan itu kepada pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen itu dalam tempoh sebagaimana yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_23__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila menerima pertanyaan daripada pengguna yang terkilan di bawah subseksyen (5), pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen itu boleh mengkaji semula keputusannya mengenai tindakan yang diambil berhubung dengan pertanyaan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_23__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa keputusan pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen yang dibuat di bawah subseksyen (6) berhubung dengan pertanyaan itu hendaklah diberitahu secara bertulis kepada pengguna yang terkilan itu dalam tempoh sebagaimana yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_23__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika sampai kepada pengetahuan Suruhanjaya bahawa pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen itu tidak menjadikan kandungan yang disebut dalam subseksyen (1) tidak dapat diakses dalam perkhidmatannya kepada semua pengguna, walaupun penentuan telah dibuat oleh pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen di bawah subseksyen (2) bahawa kandungan itu ialah kandungan memudaratkan, Suruhanjaya boleh, demi kepentingan awam, mengeluarkan suatu suruhan bertulis kepada pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen itu yang menghendaki pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen itu menjadikan kandungan itu tidak dapat diakses secara kekal dalam perkhidmatannya dalam tempoh sebagaimana yang dinyatakan dalam suruhan bertulis itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_23__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen yang tidak mematuhi suruhan bertulis yang dikeluarkan oleh Suruhanjaya di bawah subseksyen (8) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi satu juta ringgit dan boleh didenda selanjutnya tidak melebihi satu ratus ribu ringgit bagi setiap hari atau sebahagian daripadanya selama kesalahan itu berterusan selepas sabitan. Laporan kepada Suruhanjaya"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_24",
