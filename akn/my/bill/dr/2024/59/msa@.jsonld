        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_81__subsec_2__para_j"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_81",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan keluasan subseksyen (1), Menteri boleh membuat peraturan-peraturan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_81__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_81__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan sifat yang lain bagi ciri-ciri pesanan peribadi perkhidmatan aplikasi atau perkhidmatan aplikasi kandungan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_81__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_81__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan tempoh bagi pengguna memperoleh apa-apa maklumat lain mengenai mekanisme berkenaan dengan keselamatan dalam talian yang tersedia dalam perkhidmatan pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_81__subsec_2__para_c",
