      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pengguna boleh membuat laporan kepada Suruhanjaya dalam bentuk dan mengikut cara sebagaimana yang ditentukan oleh Suruhanjaya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_24__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_24__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "berkenaan dengan apa-apa kandungan yang dipercayainya ialah kandungan memudaratkan yang terdapat dalam perkhidmatan pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan tidak kira sama ada suatu laporan telah dibuat olehnya di bawah seksyen 21 kepada pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen itu berkenaan dengan kandungan yang sama; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_24__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_24__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "berkenaan dengan apa-apa kandungan yang dipercayainya ialah kandungan memudaratkan yang terdapat dalam talian selain dalam perkhidmatan pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_24__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_24__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_24__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_24__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila menerima laporan yang dibuat di bawah subseksyen (1), Suruhanjaya hendaklah dalam tempoh sebagaimana yang ditetapkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_24__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_24__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mengaku terima penerimaan laporan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_24__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_24__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "memberitahu secara bertulis status laporan itu kepada pengguna yang membuat laporan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_24__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_24__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menilai laporan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_24__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_24__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_24__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila menilai laporan yang dibuat di bawah subseksyen (1), Suruhanjaya hendaklah menolak laporan itu jika Suruhanjaya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_24__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_24__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "berpendapat bahawa laporan itu bersifat remeh, menyusahkan atau tidak dibuat dengan suci hati atau hal perkara laporan itu adalah kecil; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_24__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_24__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "menentukan bahawa hal perkara laporan itu menjadi atau telah menjadi hal perkara suatu laporan lain yang dibuat kepada Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_24__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika laporan itu ditolak di bawah subseksyen (3), Suruhanjaya hendaklah memberitahu secara bertulis pengguna yang membuat laporan itu mengenai penolakan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_24__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengguna yang terkilan dengan penolakan laporan di bawah subseksyen (3) boleh, melalui permintaan kepada Suruhanjaya, membuat pertanyaan mengenai penolakan itu kepada Suruhanjaya dalam tempoh sebagaimana yang ditetapkan dan memberikan sebab mengapa laporannya tidak patut ditolak oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_24__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila menerima pertanyaan bersama-sama sebab daripada pengguna yang terkilan di bawah subseksyen (5), Suruhanjaya boleh mengkaji semula keputusannya yang dibuat di bawah subseksyen (3) dan memutuskan sama ada penolakan itu patut dikekalkan atau tindakan lanjut patut diambil di bawah seksyen 25."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_24__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa keputusan Suruhanjaya yang dibuat di bawah subseksyen (6) berkenaan dengan pertanyaan itu hendaklah diberitahu secara bertulis kepada pengguna yang terkilan itu dalam tempoh sebagaimana yang ditetapkan. Lap or an k epad a S uruhanja ya me ng e nai ka ndu nga n memudaratkan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_25__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_25__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_25__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_25__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_25__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_25__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_25__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_25__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika laporan yang dibuat oleh pengguna di bawah subseksyen 24(1) tidak ditolak di bawah subseksyen 24(3) atau (6) dan Suruhanjaya menentukan atas alasan yang munasabah bahawa kandungan yang menjadi hal perkara laporan itu ialah kandungan memudaratkan termasuk kandungan memudaratkan prioriti, Suruhanjaya hendaklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_25__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_25__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika kandungan memudaratkan itu terdapat dalam perkhidmatan pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen, mengeluarkan suatu suruhan bertulis kepada pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen yang menghendaki pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen itu menjadikan kandungan memudaratkan itu tidak dapat diakses secara kekal dalam perkhidmatannya oleh semua pengguna dalam tempoh sebagaimana yang dinyatakan dalam suruhan bertulis itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_25__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_25__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika kandungan memudaratkan itu terdapat dalam talian selain dalam perkhidmatan pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen, mengeluarkan suatu suruhan bertulis kepada pemberi perkhidmatan rangkaian berlesen yang berkaitan yang menghendaki pemberi perkhidmatan rangkaian berlesen itu menyekat bahagian yang berkaitan perkhidmatan rangkaiannya dalam tempoh sebagaimana yang dinyatakan dalam suruhan bertulis itu supaya menjadikan kandungan memudaratkan itu tidak dapat diakses secara kekal oleh semua pengguna."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_25__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa tindakan yang diambil oleh pemberi perkhidmatan aplikasi berlesen, pemberi perkhidmatan aplikasi kandungan berlesen atau pemberi perkhidmatan rangkaian berlesen menurut suruhan bertulis di bawah subseksyen (1) hendaklah diberitahu secara bertulis kepada Suruhanjaya dan Suruhanjaya hendaklah memberitahu yang sama secara bertulis kepada pengguna yang membuat laporan berkenaan dengan kandungan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_25__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen yang kepadanya suruhan bertulis dikeluarkan di bawah subseksyen (1) hendaklah memberitahu secara bertulis pengguna yang telah menyampaikan kandungan itu dalam perkhidmatannya mengenai tindakan yang telah diambil olehnya menurut suruhan bertulis itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_25__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pemberi perkhidmatan aplikasi berlesen, pemberi perkhidmatan aplikasi kandungan berlesen atau pemberi perkhidmatan rangkaian berlesen yang tidak mematuhi suruhan bertulis yang dikeluarkan oleh Suruhanjaya di bawah subseksyen (1) melakukan suatu kesalahan, dan boleh, apabila disabitkan, didenda tidak melebihi satu juta ringgit dan boleh didenda selanjutnya tidak melebihi satu ratus ribu ringgit bagi setiap hari atau sebahagian daripadanya selama kesalahan itu berterusan selepas sabitan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_25__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Suruhanjaya menentukan atas alasan munasabah bahawa kandungan yang menjadi hal perkara laporan yang dibuat di bawah subseksyen 24(1) bukanlah kandungan memudaratkan, Suruhanjaya hendaklah memberitahu secara bertulis pengguna yang membuat laporan itu mengenai penentuannya itu. Tindakan oleh pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen atas usulnya sendiri"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_26__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_26__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_26__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_26__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_26__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_26__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen boleh, tidak kira sama ada suatu laporan telah dibuat oleh pengguna di bawah seksyen 21 atau 24, atas usulnya sendiri menjadikan apa-apa kandungan tidak dapat diakses dalam perkhidmatannya mengikut cara sebagaimana yang ditentukannya jika pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen itu mempunyai alasan yang munasabah untuk mempercayai bahawa kandungan itu ialah kandungan memudaratkan prioriti."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_26__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu kandungan telah dijadikan tidak dapat diakses di bawah subseksyen (1), pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen hendaklah memberitahu secara bertulis pengguna yang menyampaikan kandungan itu dalam perkhidmatannya mengenai tindakan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_26__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengguna yang terkilan dengan tindakan yang diambil oleh pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen di bawah subseksyen (1) boleh, melalui permintaan kepada pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen itu, membuat pertanyaan mengenai tindakan itu kepada pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen itu dalam tempoh sebagaimana yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_26__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila menerima pertanyaan daripada pengguna yang terkilan di bawah subseksyen (3), pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen itu boleh mengkaji semula keputusannya mengenai tindakan yang diambil berhubung dengan pertanyaan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_26__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa keputusan pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen yang dibuat di bawah subseksyen (4) berkenaan dengan pertanyaan itu hendaklah diberitahu secara bertulis kepada pengguna yang terkilan itu dalam tempoh sebagaimana yang ditetapkan. Suruhanjaya boleh mengeluarkan suruhan bertulis untuk menjadikan kandungan dapat diakses"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun peruntukan Akta ini, jika sampai kepada pengetahuan Suruhanjaya bahawa pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen telah menjadikan apa-apa kandungan dalam perkhidmatannya tidak dapat diakses, Suruhanjaya boleh, demi kepentingan awam, mengeluarkan suatu suruhan bertulis kepada pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen itu yang menghendaki pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen itu menjadikan kandungan itu dapat diakses semula dalam perkhidmatannya oleh semua pengguna dalam tempoh sebagaimana yang dinyatakan dalam suruhan bertulis itu. Ketidakselarasan antara suruhan bertulis atau penentuan Suruhanjaya dengan tindakan oleh pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seseorang pengguna membuat laporan kepada pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen di bawah seksyen 21 dan pada masa yang sama membuat laporan kepada Suruhanjaya di bawah seksyen 24 berkenaan dengan kandungan yang sama yang pengguna itu percaya ialah kandungan memudaratkan, dan terdapat ketidakselarasan antara tindakan yang diambil oleh pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen di bawah subseksyen 22 atau 23 dengan suruhan bertulis yang dikeluarkan oleh Suruhanjaya di bawah subseksyen 25(1) atau seksyen 27 atau penentuan yang dibuat oleh Suruhanjaya yang disebut dalam subseksyen 25(5) berkenaan dengan laporan itu, suruhan bertulis yang dikeluarkan atau penentuan yang dibuat oleh Suruhanjaya hendaklah terpakai. Pemberitahuan kepada pengguna mengenai laporan kepada agensi penguatkuasaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen membuat laporan kepada mana-mana agensi penguatkuasaan berhubung dengan kandungan yang menjadi hal perkara suatu laporan yang dibuat oleh seseorang pengguna kepada pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen di bawah seksyen 21, pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen tidak boleh menzahirkan kepada pengguna yang membuat laporan itu apa-apa maklumat yang berhubungan dengan laporan yang dibuat kepada agensi penguatkuasaan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX",
      "@type": "akn:part",
      "eli:number": "IX",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_69",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_70",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_71",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_72",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_73",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_74",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_75",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_76",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_77",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_78",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_79",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_80",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_81",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_82",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_83",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_84"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "PELBAGAI Jalinan kerjasama dengan pihak berkuasa lain"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_69",
      "@type": "akn:clause",
      "eli:number": "69",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh memberikan arahan kepada Suruhanjaya berkenaan dengan perkiraan jalinan kerjasama antara Suruhanjaya dengan mana-mana pihak berkuasa lain di Malaysia atau di bidang kuasa asing, atau antara Suruhanjaya dengan mana-mana organisasi antarabangsa. Semakan kehakiman"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_70",
      "@type": "akn:clause",
      "eli:number": "70",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_70__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_70__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_70__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_70",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang terkilan atau yang kepentingannya terjejas dengan sesuatu keputusan atau tindakan lain Menteri atau Suruhanjaya boleh memohon kepada Mahkamah Tinggi bagi suatu semakan kehakiman terhadap keputusan atau tindakan lain itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_70__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_70",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang tidak boleh memohon kepada mahkamah bagi suatu semakan kehakiman melainkan jika orang itu telah menghabiskan semua remedi lain terlebih dahulu yang diperuntukkan di bawah Akta ini. Kuasa untuk mengecualikan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_71",
      "@type": "akn:clause",
      "eli:number": "71",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, melalui perintah yang disiarkan dalam Warta, mengecualikan, tertakluk kepada apa-apa syarat sebagaimana yang disifatkan patut oleh Menteri untuk dikenakan, mana-mana pemberi perkhidmatan aplikasi berlesen, pemberi perkhidmatan aplikasi kandungan berlesen atau pemberi perkhidmatan rangkaian berlesen atau kelas pemberi perkhidmatan aplikasi berlesen, pemberi perkhidmatan aplikasi kandungan berlesen atau pemberi perkhidmatan rangkaian berlesen daripada semua atau mana-mana peruntukan Akta ini. Pendakwaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_72",
      "@type": "akn:clause",
      "eli:number": "72",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada pendakwaan boleh dimulakan bagi suatu kesalahan di bawah Akta ini tanpa keizinan secara bertulis Pendakwa Raya. Tanggungan pengarah, dsb., bagi syarikat, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_73",
      "@type": "akn:clause",
      "eli:number": "73",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_73__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_73__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana orang yang melakukan suatu kesalahan di bawah Akta ini ialah suatu syarikat, perkongsian liabiliti terhad, firma, pertubuhan atau kumpulan orang yang lain, seseorang yang pada masa perlakuan kesalahan itu ialah seorang pengarah, pegawai pematuhan, pekongsi, pengurus, setiausaha atau pegawai lain yang seumpamanya bagi syarikat, perkongsian liabiliti terhad, firma, pertubuhan atau kumpulan orang yang lain itu atau yang berupa sebagai bertindak atas sifat itu atau yang dengan apa-apa cara atau sehingga apa-apa takat bertanggungjawab bagi pengurusan apa-apa hal ehwal syarikat, perkongsian liabiliti terhad, firma, pertubuhan atau kumpulan orang yang lain itu atau yang membantu dalam pengurusannya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_73__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_73",
      "schema:text": {
        "@language": "ms",
        "@value": "boleh dipertuduh secara berasingan atau bersesama dalam prosiding yang sama bersekali dengan syarikat, perkongsian liabiliti terhad, firma, pertubuhan atau kumpulan orang yang lain itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_73__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_73__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_73__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_73",
      "schema:text": {
        "@language": "ms",
        "@value": "jika syarikat, perkongsian liabiliti terhad, firma, pertubuhan atau kumpulan orang yang lain itu didapati bersalah atas kesalahan itu, hendaklah disifatkan bersalah atas kesalahan itu dan boleh dikenakan hukuman atau penalti yang sama sebagaimana seorang individu melainkan jika, dengan mengambil kira jenis fungsinya atas sifat itu dan segala hal keadaan, dia membuktikan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_73__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_73__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa kesalahan itu telah dilakukan tanpa pengetahuannya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_73__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_73__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bahawa kesalahan itu telah dilakukan tanpa persetujuan atau pembiarannya dan bahawa dia telah mengambil segala langkah yang munasabah dan menjalankan usaha yang wajar untuk menghalang perlakuan kesalahan itu. Pengkompaunan kesalahan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_74",
      "@type": "akn:clause",
      "eli:number": "74",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_74__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_74__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_74__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_74__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_74__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_74__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_74__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_74__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_74__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_74",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, dengan kelulusan Pendakwa Raya, membuat peraturan-peraturan yang menetapkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_74__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_74__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa kesalahan di bawah Akta ini sebagai suatu kesalahan yang boleh dikompaun; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_74__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_74__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "kaedah dan tatacara untuk mengkompaun kesalahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_74__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_74",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi Suruhanjaya boleh, dengan keizinan secara bertulis Pendakwa Raya, mengkompaun apa-apa kesalahan yang dilakukan oleh mana-mana orang di bawah Akta ini yang ditetapkan sebagai suatu kesalahan yang boleh dikompaun dengan membuat suatu tawaran secara bertulis kepada orang yang disyaki telah melakukan kesalahan itu untuk mengkompaun kesalahan itu apabila dibayar kepada Pengerusi Suruhanjaya suatu amaun tidak melebihi lima puluh peratus amaun denda maksimum bagi kesalahan itu dalam masa yang dinyatakan dalam tawarannya itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_74__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_74",
      "schema:text": {
        "@language": "ms",
        "@value": "Tawaran di bawah subseksyen (2) boleh dibuat pada bila-bila masa selepas kesalahan itu telah dilakukan tetapi sebelum apa-apa pendakwaan baginya dimulakan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_74__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_74",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika amaun yang dinyatakan dalam tawaran itu tidak dibayar dalam masa yang dinyatakan dalam tawaran itu, atau apa-apa lanjutan masa sebagaimana yang diberikan oleh Pengerusi Suruhanjaya, pendakwaan bagi kesalahan itu boleh dimulakan pada bila-bila masa selepas itu terhadap orang yang kepadanya tawaran itu dibuat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_74__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_74__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_74__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_74",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu kesalahan telah dikompaun di bawah seksyen ini—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_74__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_74__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "tiada pendakwaan boleh dimulakan berkenaan dengan kesalahan itu terhadap orang yang kepadanya tawaran untuk mengkompaun itu dibuat; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_74__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_74__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa dokumen atau benda yang disita yang berkaitan dengan kesalahan itu boleh dilepaskan oleh Pengerusi Suruhanjaya, tertakluk kepada syarat sebagaimana yang difikirkan patut oleh Pengerusi Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_74__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_74",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua jumlah wang yang diterima oleh Pengerusi Suruhanjaya di bawah seksyen ini hendaklah dibayar ke dalam dan menjadi sebahagian daripada Kumpulan Wang Disatukan Persekutuan. Obligasi kerahsiaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_75",
      "@type": "akn:clause",
      "eli:number": "75",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_75__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_75__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_75__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_75__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_75__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_75",
      "schema:text": {
        "@language": "ms",
        "@value": "Kecuali bagi maksud Bahagian ini atau bagi maksud apa-apa prosiding sivil atau jenayah di bawah mana-mana undang-undang bertulis, atau jika dibenarkan oleh Menteri—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_75__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_75__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi Jawatankuasa, mana-mana anggota lain Jawatankuasa, Pengerusi Tribunal Rayuan Keselamatan dalam Talian, mana-mana anggota lain Tribunal Rayuan Keselamatan dalam Talian, Setiausaha kepada Tribunal Rayuan Keselamatan dalam Talian atau mana-mana pegawai Tribunal Rayuan Keselamatan dalam Talian tidak boleh, semasa dia berkhidmat sebagai Pengerusi, anggota, Setiausaha atau pegawai sedemikian, menzahirkan apa-apa maklumat yang diperolehnya semasa menjalankan kewajipannya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_75__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_75__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tiada seorang pun orang lain yang, melalui apa-apa cara, mempunyai akses kepada apa-apa maklumat atau dokumen yang berhubungan dengan hal ehwal Jawatankuasa atau Tribunal Rayuan Keselamatan dalam Talian boleh menzahirkan maklumat atau dokumen itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_75__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_75",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi sepuluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tiga bulan atau kedua-duanya. Pekhidmat awam"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_76",
      "@type": "akn:clause",
      "eli:number": "76",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi Jawatankuasa, setiap anggota lain Jawatankuasa, Pengerusi Tribunal Rayuan Keselamatan dalam Talian, setiap anggota lain Tribunal Rayuan Keselamatan dalam Talian, Setiausaha kepada Tribunal Rayuan Keselamatan dalam Talian atau mana-mana pegawai Tribunal Rayuan Keselamatan dalam Talian semasa menunaikan kewajipannya sebagai Pengerusi, anggota, Setiausaha atau pegawai itu, hendaklah disifatkan sebagai pekhidmat awam mengikut pengertian Kanun Keseksaan. Pemakaian Akta Perlindungan Pihak Berkuasa Awam 1948"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_77",
      "@type": "akn:clause",
      "eli:number": "77",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Perlindungan Pihak Berkuasa Awam 1948 [Akta 198] hendaklah terpakai bagi apa-apa tindakan, guaman, pendakwaan atau prosiding terhadap Jawatankuasa, Tribunal Rayuan Keselamatan dalam Talian, Pengerusi Jawatankuasa, mana-mana anggota lain Jawatankuasa, Pengerusi Tribunal Rayuan Keselamatan dalam Talian, mana-mana anggota lain Tribunal Rayuan Keselamatan dalam Talian, Setiausaha kepada Tribunal Rayuan Keselamatan dalam Talian atau mana-mana pegawai Tribunal Rayuan Keselamatan dalam Talian berkenaan dengan apa-apa perbuatan, pengabaian atau keingkaran yang dibuat atau dilakukannya dengan suci hati atau apa-apa peninggalan olehnya dengan suci hati atas sifat yang sedemikian. Perbuatan atau peninggalan yang dibuat dengan suci hati"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_78",
      "@type": "akn:clause",
      "eli:number": "78",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_78__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_78__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_78__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_78__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_78__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada tindakan atau guaman boleh dimulakan atau dikekalkan dalam mana-mana mahkamah terhadap—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_78__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_78",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatankuasa atau Tribunal Rayuan Keselamatan dalam Talian;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_78__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_78",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi Jawatankuasa atau mana-mana anggota lain Jawatankuasa;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_78__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_78",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi Tribunal Rayuan Keselamatan dalam Talian atau mana-mana anggota Tribunal Rayuan Keselamatan dalam Talian;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_78__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_78",
      "schema:text": {
        "@language": "ms",
        "@value": "Setiausaha kepada Tribunal Rayuan Keselamatan dalam Talian atau mana-mana pegawai Tribunal Rayuan Keselamatan dalam Talian; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_78__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_78",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang yang diberi kuasa untuk bertindak bagi atau bagi pihak Jawatankuasa atau Tribunal Rayuan Keselamatan dalam Talian, bagi apa-apa perbuatan atau peninggalan yang dilakukan dengan suci hati dalam melaksanakan fungsinya dan dalam menjalankan kuasanya di bawah Akta ini. Perlindungan pegawai dan orang lain"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_79",
      "@type": "akn:clause",
      "eli:number": "79",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_79__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_79__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada tindakan, guaman, pendakwaan atau prosiding lain boleh diambil atau dibawa, dimulakan atau dikekalkan di mana-mana mahkamah terhadap—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_79__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_79",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya atau seseorang pegawai diberi kuasa atau mana-mana orang lain berkenaan dengan apa-apa tindakan yang diarahkan atau dilakukan bagi maksud melaksanakan Akta ini; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_79__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_79",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang lain berkenaan dengan apa-apa tindakan yang dilakukan atau berupa seperti dilakukan olehnya di bawah perintah, arahan atau suruhan Suruhanjaya atau seorang pegawai diberi kuasa jika tindakan itu dilakukan dengan suci hati dan dengan kepercayaan munasabah bahawa ia perlu bagi tujuan yang dimaksudkan yang hendak dicapai olehnya. Kuasa untuk mengeluarkan garis panduan dan kod"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_80",
      "@type": "akn:clause",
      "eli:number": "80",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_80__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_80__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_80__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_80__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_80__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_80",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya boleh mengeluarkan apa-apa garis panduan sebagaimana yang suai manfaat atau perlu bagi melaksanakan peruntukan Akta ini dengan lebih baik dan bagi maksud memastikan pematuhan kepada Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_80__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_80",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan subseksyen (1), Suruhanjaya boleh mengeluarkan apa-apa kod bagi maksud pematuhan kewajipan di bawah Bahagian III oleh pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_80__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_80",
      "schema:text": {
        "@language": "ms",
        "@value": "Setiap garis panduan dan kod yang dikeluarkan di bawah Akta ini hendaklah disiarkan oleh Suruhanjaya mengikut cara sebagaimana yang ditentukan oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_80__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_80",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya boleh membatalkan, mengubah, mengkaji semula atau meminda keseluruhan atau mana-mana bahagian apa-apa garis panduan atau kod yang dikeluarkan di bawah seksyen ini. Kuasa untuk membuat peraturan-peraturan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_81",
      "@type": "akn:clause",
      "eli:number": "81",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_IX__cl_81__subsec_1",
