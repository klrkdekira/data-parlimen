      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang terkilan dengan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_41__subsec_1__para_a",
