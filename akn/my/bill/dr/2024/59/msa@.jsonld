        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_32__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_32__subsec_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_32__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_32__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_32__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_32",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun mana-mana undang-undang bertulis lain, jika Suruhanjaya mempunyai alasan yang munasabah untuk mempercayai bahawa mana-mana orang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_32__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_32__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mempunyai apa-apa maklumat, butir-butir atau dokumen yang berkaitan dengan pelaksanaan fungsi dan kuasa Suruhanjaya di bawah Akta ini; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_32__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
