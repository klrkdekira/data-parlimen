        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_40__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_40__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_40",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu Tribunal Rayuan Keselamatan dalam Talian hendaklah ditubuhkan bagi maksud mengkaji semula—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_40__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_40__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa suruhan bertulis yang dikeluarkan oleh Suruhanjaya di bawah subseksyen 23(8) atau 25(1) atau seksyen 27;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_40__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_40__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa penentuan yang dibuat oleh Suruhanjaya yang disebut dalam subseksyen 25(5);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_40__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_40__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa arahan yang dikeluarkan oleh Suruhanjaya di bawah seksyen 30; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_40__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_40__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa keputusan kajian semula notis ketidakpatuhan yang dibuat oleh Suruhanjaya di bawah seksyen 38."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_40__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_40__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_40__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_40",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri hendaklah, melalui perintah yang disiarkan dalam Warta, melantik anggota Tribunal Rayuan Keselamatan dalam Talian seperti yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_40__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_40__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi yang hendaklah dilantik dalam kalangan Hakim Mahkamah Tinggi; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_40__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_40__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "sekurang-kurangnya dua orang anggota lain, atau apa-apa bilangan genap anggota yang lebih banyak dalam kalangan orang yang mempunyai pengetahuan atau pengalaman dalam bidang komunikasi dan multimedia, kejuruteraan, undang-undang, ekonomi atau perdagangan atau pentadbiran awam atau dalam apa-apa bidang lain yang disifatkan patut oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_40__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_40",
      "schema:text": {
        "@language": "ms",
        "@value": "Anggota Tribunal Rayuan Keselamatan dalam Talian hendaklah memegang jawatan bagi tempoh tidak melebihi tiga tahun dan adalah layak untuk dilantik semula selepas habis tempoh jawatannya. Rayuan kepada Tribunal Rayuan Keselamatan dalam Talian"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_41",
      "@type": "akn:clause",
