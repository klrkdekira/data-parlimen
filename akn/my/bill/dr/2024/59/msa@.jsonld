      "schema:text": {
        "@language": "ms",
        "@value": "dia bersalah atas salah laku yang berat berhubung dengan tugasnya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_42__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_42__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dia tidak menjalankan obligasinya di bawah seksyen 50; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_42__subsec_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_42__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "prestasinya adalah tidak memuaskan bagi suatu tempoh masa yang ketara."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_42__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_42",
      "schema:text": {
        "@language": "ms",
        "@value": "Anggota Tribunal Rayuan Keselamatan dalam Talian boleh, pada bila-bila masa, meletakkan jawatannya dengan memberikan notis secara bertulis kepada Menteri. Kekosongan jawatan anggota Tribunal Rayuan Keselamatan dalam Talian"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_43",
      "@type": "akn:clause",
      "eli:number": "43",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_43__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_43__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_43__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_43__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_43__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_43__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_43__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_43__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatan seseorang anggota Tribunal Rayuan Keselamatan dalam Talian hendaklah menjadi kosong—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_43__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_43__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia meninggal dunia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_43__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_43__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika dia meletakkan jawatan atau selainnya mengosongkan jawatannya sebelum habis tempoh yang baginya dia dilantik; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_43__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_43__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika pelantikannya dibatalkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_43__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri hendaklah melantik seseorang mengikut seksyen 40 untuk menggantikan Pengerusi atau mana-mana anggota lain semasa kekosongan jawatan Pengerusi atau mana-mana anggota lain itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_43__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_43__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_43__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_43__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri hendaklah melantik seseorang mengikut seksyen 40 untuk bertindak sebagai Pengerusi atau mana-mana anggota lain selama tempoh apabila—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_43__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_43__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "jawatan Pengerusi atau mana-mana anggota lain kosong;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_43__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_43__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi atau mana-mana anggota lain tidak hadir bertugas atau tidak berada di Malaysia; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_43__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_43__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi atau mana-mana anggota lain, atas apa-apa sebab lain, tidak dapat menjalankan fungsinya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_43__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Penjalanan kuasa, atau pelaksanaan fungsi, Tribunal Rayuan Keselamatan dalam Talian tidak terjejas hanya kerana terdapat kekosongan dalam keanggotaan Tribunal Rayuan Keselamatan dalam Talian itu. Elaun bagi anggota Tribunal Rayuan Keselamatan dalam Talian"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_44",
      "@type": "akn:clause",
      "eli:number": "44",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Anggota Tribunal Rayuan Keselamatan dalam Talian hendaklah dibayar elaun sebagaimana yang ditentukan oleh Menteri selepas berunding dengan Menteri Kewangan. Kuorum Tribunal Rayuan Keselamatan dalam Talian"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_45",
      "@type": "akn:clause",
      "eli:number": "45",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_45__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_45__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII",
      "schema:name": {
        "@language": "ms",
        "@value": "Kuorum Tribunal Rayuan Keselamatan dalam Talian hendaklah terdiri daripada—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_45__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_45",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_45__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_45",
      "schema:text": {
        "@language": "ms",
        "@value": "sekurang-kurangnya dua orang anggota lain, atau apa-apa bilangan genap anggota yang lebih banyak yang tidak melebihi empat. Keputusan Tribunal Rayuan Keselamatan dalam Talian"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_46",
      "@type": "akn:clause",
      "eli:number": "46",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_46__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_46__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_46__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa keputusan Tribunal Rayuan Keselamatan dalam Talian mengenai apa-apa perkara hendaklah diputuskan melalui undi majoriti anggota Tribunal Rayuan Keselamatan dalam Talian yang hadir."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_46__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Keputusan Tribunal Rayuan Keselamatan dalam Talian adalah muktamad dan mengikat dan tidak boleh dirayu selanjutnya. Penguatkuasaan keputusan Tribunal Rayuan Keselamatan dalam Talian"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_47",
      "@type": "akn:clause",
      "eli:number": "47",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa keputusan Tribunal Rayuan Keselamatan dalam Talian boleh dikuatkuasakan mengikut cara yang sama sebagaimana suatu penghakiman atau perintah Mahkamah Tinggi. Kuasa Tribunal Rayuan Keselamatan dalam Talian"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_48",
      "@type": "akn:clause",
      "eli:number": "48",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_48__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_48__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_48__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_48__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_48__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_48__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_48__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_48__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_48__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_48__subsec_1__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_48__subsec_1__para_h"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_48",
      "schema:text": {
        "@language": "ms",
        "@value": "Tribunal Rayuan Keselamatan dalam Talian hendaklah mempunyai kuasa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_48__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_48__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memanggil pihak-pihak kepada prosidingnya atau mana-mana orang lain supaya hadir di hadapannya untuk memberikan keterangan berkenaan dengan sesuatu rayuan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_48__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_48__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mendapatkan dan menerima keterangan dengan sumpah atau ikrar, sama ada secara bertulis atau lisan, dan memeriksa semua orang itu sebagai saksi sebagaimana yang difikirkan perlu oleh Tribunal Rayuan Keselamatan dalam Talian untuk didapatkan, diterima atau diperiksa;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_48__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_48__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jika seseorang dipanggil sedemikian, untuk menghendaki pengemukaan apa-apa buku, kertas, dokumen, rekod atau benda lain dalam milikannya atau di bawah kawalannya dan yang difikirkan perlu oleh Tribunal Rayuan Keselamatan dalam Talian bagi maksud rayuan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_48__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_48__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengendalikan apa-apa sumpah, ikrar atau akuan berkanun, mengikut kehendak keadaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_48__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_48__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apabila seseorang dipanggil sedemikian, untuk membenarkan bayaran bagi apa-apa perbelanjaan yang munasabah yang dilakukan berkaitan dengan kehadirannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_48__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_48__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menerima keterangan atau menolak keterangan yang dikemukakan, sama ada secara bertulis atau lisan, dan sama ada boleh diterima atau tidak boleh diterima di bawah peruntukan mana-mana undang-undang bertulis yang sedang berkuat kuasa yang berhubungan dengan kebolehterimaan keterangan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_48__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_48__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menangguhkan pendengaran rayuan dari semasa ke semasa, termasuk kuasa untuk membuat penangguhan bagi mempertimbangkan keputusannya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_48__subsec_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_48__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk secara amnya mengarahkan dan melakukan segala perkara yang perlu atau suai manfaat bagi mempercepat keputusan rayuan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_48__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_48",
      "schema:text": {
        "@language": "ms",
        "@value": "Tribunal Rayuan Keselamatan dalam Talian hendaklah mempunyai kuasa sebagai mahkamah rendah berkenaan dengan penguatkuasaan kehadiran saksi-saksi, pendengaran keterangan dengan sumpah atau ikrar dan penjatuhan hukuman bagi penghinaan. Penggantungan anggota Tribunal Rayuan Keselamatan dalam Talian"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_49",
      "@type": "akn:clause",
      "eli:number": "49",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh menggantung keanggotaan mana-mana anggota Tribunal Rayuan Keselamatan dalam Talian atas alasan perangai buruk atau ketidakupayaan. Penzahiran kepentingan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_50",
      "@type": "akn:clause",
      "eli:number": "50",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_50__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_50__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_50__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_50__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_50__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_50__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_50",
      "schema:text": {
        "@language": "ms",
        "@value": "Anggota Tribunal Rayuan Keselamatan dalam Talian hendaklah menzahirkan, secepat yang dapat dilaksanakan, apa-apa kepentingan kepada Pengerusi, sama ada substansial atau tidak, yang mungkin bercanggah dengan kewajipan anggota itu sebagai anggota Tribunal Rayuan Keselamatan dalam Talian, dalam sesuatu perkara tertentu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_50__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_50",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Pengerusi berpendapat bahawa kepentingan anggota itu bercanggah dengan kewajipan anggota itu, Pengerusi hendaklah memaklumkan semua pihak kepada perkara itu tentang percanggahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_50__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_50",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika tiada mana-mana pihak kepada perkara itu membantah percanggahan itu, anggota itu boleh terus melaksanakan kewajipannya sebagai anggota Tribunal Rayuan Keselamatan dalam Talian berhubung dengan perkara itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_50__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_50",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu pihak kepada perkara itu membantah akan percanggahan itu, anggota itu tidak boleh terus melaksanakan kewajipannya sebagai anggota Tribunal Rayuan Keselamatan dalam Talian berhubung dengan perkara itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_50__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_50",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana anggota yang tidak menzahirkan kepentingannya dalam perkara tertentu hendaklah tertakluk kepada tindakan tatatertib di bawah seksyen 42 atau 49. Setiausaha kepada Tribunal Rayuan Keselamatan dalam Talian"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_51",
      "@type": "akn:clause",
      "eli:number": "51",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_51__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_51__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_51__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_51__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_51",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri hendaklah menetapkan seorang pegawai awam sebagai Setiausaha kepada Tribunal Rayuan Keselamatan dalam Talian bagi membantu Tribunal Rayuan Keselamatan dalam Talian dalam menjalankan fungsi dan kuasanya di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_51__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_51",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh menetapkan apa-apa bilangan pegawai awam lain sebagaimana yang difikirkan patut oleh Menteri untuk membantu kepada Setiausaha kepada Tribunal Rayuan Keselamatan dalam Talian dalam menjalankan fungsinya di bawah subseksyen (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_51__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_51",
      "schema:text": {
        "@language": "ms",
        "@value": "Setiausaha kepada Tribunal Rayuan Keselamatan dalam Talian dan pegawai yang ditetapkan di bawah subseksyen (2) hendaklah, bagi maksud Akta ini, disifatkan sebagai pegawai Tribunal Rayuan Keselamatan dalam Talian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_36",
      "@type": "akn:clause",
      "eli:number": "36",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_36__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_36__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_36__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_36",
      "schema:text": {
        "@language": "ms",
        "@value": "Pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen boleh, sebelum suatu notis ketidakpatuhan dikeluarkan kepadanya di bawah seksyen 37, memberikan suatu aku janji kepada Suruhanjaya berkenaan dengan pematuhan mana-mana kewajipannya di bawah Bahagian III dalam bentuk sebagaimana yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_36__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_36",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen yang memberikan aku janji di bawah subseksyen (1) hendaklah mematuhi aku janji itu. Notis ketidakpatuhan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_37",
      "@type": "akn:clause",
      "eli:number": "37",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_37__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_37__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_37__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_37__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Suruhanjaya mempunyai alasan yang munasabah untuk mempercayai bahawa pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen telah tidak mematuhi mana-mana kewajipannya di bawah Bahagian III, Suruhanjaya hendaklah mengeluarkan suatu notis ketidakpatuhan secara bertulis kepada pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen itu mengikut cara sebagaimana yang ditentukan oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_37__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_37__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_37__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_37__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "Notis ketidakpatuhan yang dikeluarkan di bawah subseksyen (1) hendaklah mengandungi butir-butir yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_37__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_37__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "butiran mengenai ketidakpatuhan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_37__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_37__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "amaun penalti kewangan yang perlu dibayar berkenaan dengan ketidakpatuhan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_37__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_37__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa butir lain sebagaimana yang difikirkan perlu oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_37__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_37__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_37__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila menerima notis ketidakpatuhan di bawah subseksyen (1), pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_37__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_37__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "hen daklah membayar amaun pen alti k ew an gan sebagaimana yang dinyatakan dalam notis ketidakpatuhan itu dalam tempoh sebagaimana yang dinyatakan dalam notis itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_37__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_37__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "boleh memohon kepada Suruhanjaya bagi suatu kajian semula melalui representasi berkenaan dengan notis ketidakpatuhan itu dalam tempoh dan mengikut cara sebagaimana yang ditentukan oleh Suruhanjaya jika pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen itu tidak berhasrat untuk membayar amaun penalti kewangan yang dinyatakan dalam notis ketidakpatuhan itu. Kajian semula oleh Suruhanjaya"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_38__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_38__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_38__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_38__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_38__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_38__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_38__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_38__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_38",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila menerima permohonan bagi suatu kajian semula melalui representasi terhadap notis ketidakpatuhan yang dikeluarkan di bawah seksyen 37, Suruhanjaya hendaklah mengkaji semula notis ketidakpatuhan itu dan boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_38__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_38__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menolak permohonan bagi kajian semula notis ketidakpatuhan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_38__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_38__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menarik balik notis ketidakpatuhan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_38__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_38__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mengubah amaun penalti yang perlu dibayar berkenaan dengan ketidakpatuhan itu dan menyatakan tempoh yang penalti kewangan yang diubah itu perlu dibayar; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_38__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_38__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mengenakan apa-apa syarat sebagaimana yang disifatkan patut oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_38__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_38",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa keputusan kajian semula yang dibuat oleh Suruhanjaya di bawah seksyen ini hendaklah diberitahu secara bertulis kepada pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen yang memohon bagi kajian semula itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_38__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_38",
      "schema:text": {
        "@language": "ms",
        "@value": "Pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen yang memohon bagi kajian semula itu hendaklah mematuhi keputusan kajian semula yang dibuat oleh Suruhanjaya di bawah seksyen ini. Penalti kewangan bagi ketidakpatuhan kewajipan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_39__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_39__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_39__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_39__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya boleh mengenakan suatu penalti kewangan terhadap pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen bagi apa-apa ketidakpatuhan mana-mana kewajipannya di bawah Bahagian III."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_39__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen yang tidak mematuhi mana-mana kewajipannya di bawah Bahagian III adalah bertanggungan untuk membayar kepada Suruhanjaya suatu penalti kewangan yang amaunnya tidak melebihi sepuluh juta ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_39__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VI__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa penalti kewangan yang genap masa dan kena dibayar di bawah seksyen ini boleh didapatkan sebagai suatu hutang sivil yang kena dibayar kepada Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_30__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_30__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_30__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_30__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_30__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_30__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_30__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_30__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_30__subsec_9"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_30__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya boleh mengeluarkan arahan secara bertulis kepada mana-mana pemberi perkhidmatan aplikasi berlesen, pemberi perkhidmatan aplikasi kandungan berlesen atau pemberi perkhidmatan rangkaian berlesen berkenaan dengan pematuhan mana-mana peruntukan Akta ini oleh pemberi perkhidmatan aplikasi berlesen, pemberi perkhidmatan aplikasi kandungan berlesen atau pemberi perkhidmatan rangkaian berlesen."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_30__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "Sebelum mengeluarkan arahan di bawah subseksyen (1), Suruhanjaya hendaklah mengeluarkan suatu notis secara bertulis kepada pemberi perkhidmatan aplikasi berlesen, pemberi perkhidmatan aplikasi kandungan berlesen atau pemberi perkhidmatan rangkaian berlesen dengan menyatakan jenis pematuhan yang dikehendaki."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_30__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila menerima notis secara bertulis di bawah subseksyen (2), pemberi perkhidmatan aplikasi berlesen, pemberi perkhidmatan aplikasi kandungan berlesen atau pemberi perkhidmatan rangkaian berlesen boleh membuat hujahan berkenaan dengan pematuhan yang dikehendaki, secara lisan atau bertulis, dalam tempoh sebagaimana yang dinyatakan dalam notis itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_30__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya hendaklah mengambil kira apa-apa hujahan yang dibuat oleh pemberi perkhidmatan aplikasi berlesen, pemberi perkhidmatan aplikasi kandungan berlesen atau pemberi perkhidmatan rangkaian berlesen itu sebelum mengeluarkan arahan di bawah subseksyen (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_30__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "Pemberi perkhidmatan aplikasi berlesen, pemberi perkhidmatan aplikasi kandungan berlesen atau pemberi perkhidmatan rangkaian berlesen hendaklah mematuhi arahan yang dikeluarkan oleh Suruhanjaya di bawah seksyen ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_30__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "Arahan yang dikeluarkan di bawah seksyen ini hendaklah didaftarkan oleh Suruhanjaya secepat yang dapat dilaksanakan dari tarikh arahan itu dikeluarkan dan hendaklah berkuat kuasa mulai tarikh pendaftaran atau suatu tarikh terkemudian sebagaimana yang dinyatakan oleh Suruhanjaya dalam arahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_30__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "Arahan itu hendaklah habis tempoh pada tarikh sebagaimana yang dinyatakan oleh Suruhanjaya dalam arahan itu atau, jika tiada tarikh dinyatakan, arahan itu hendaklah berkuat kuasa sehingga dibatalkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_30__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya boleh mengubah suai, mengubah atau membatalkan arahan yang dikeluarkan di bawah seksyen ini dan tatacara yang dinyatakan di bawah seksyen ini hendaklah terpakai berkenaan dengan apa-apa pengubahsuaian, perubahan atau pembatalan arahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_30__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pemberi perkhidmatan aplikasi berlesen, pemberi perkhidmatan aplikasi kandungan berlesen atau pemberi perkhidmatan rangkaian berlesen yang tidak mematuhi arahan yang dikeluarkan oleh Suruhanjaya di bawah seksyen ini melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi satu juta ringgit dan boleh didenda selanjutnya tidak melebihi satu ratus ribu ringgit bagi setiap hari atau sebahagian daripadanya selama kesalahan itu berterusan selepas sabitan. Daftar arahan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_31__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_31__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_31__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_31__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_31",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya hendaklah menyenggarakan suatu daftar semua arahan yang dikeluarkan oleh Suruhanjaya di bawah seksyen 30 kedua-dua dalam bentuk fizikal dan dalam media elektronik."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_31__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_31__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_31__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_31",
      "schema:text": {
        "@language": "ms",
        "@value": "Pemberi perkhidmatan aplikasi berlesen, pemberi perkhidmatan aplikasi kandungan berlesen atau pemberi perkhidmatan rangkaian berlesen boleh, apabila dibayar fi yang ditetapkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_31__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_31__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "memeriksa daftar arahan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_31__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_31__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat salinan, atau mengambil cabutan daripada, daftar arahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_31__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_31__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_31__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_31",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika pemberi perkhidmatan aplikasi berlesen, pemberi perkhidmatan aplikasi kandungan berlesen atau pemberi perkhidmatan rangkaian berlesen meminta supaya salinan atau cabutan daripada daftar arahan itu diberikan dalam media elektronik, Suruhanjaya boleh memberikan salinan atau cabutan itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_31__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_31__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggunakan peranti pemproses data; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_31__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_31__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "melalui penghantaran elektronik. Kuasa untuk mengumpul maklumat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_32__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_V__cl_32__subsec_2",
