        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_15",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_16",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_17",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_18",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_19",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_20"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "KEWAJIPAN PEMBERI PERKHIDMATAN APLIKASI BERLESEN DAN PEMBERI PERKHIDMATAN APLIKASI KANDUNGAN BERLESEN Kewajipan untuk melaksanakan langkah-langkah untuk mengurangkan risiko pendedahan kepada kandungan memudaratkan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_13__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_13__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Pemberi perkhidmatan aplikasi berlesen dan pemberi perkhidmatan aplikasi kandungan berlesen hendaklah melaksanakan langkah-langkah sebagaimana yang dinyatakan dalam kod untuk mengurangkan risiko pengguna didedahkan kepada kandungan memudaratkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (1), pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen boleh melaksanakan apa-apa langkah alternatif selain langkah-langkah yang dinyatakan dalam kod jika pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen itu membuktikan sehingga memuaskan Suruhanjaya bahawa langkah-langkah alternatif itu akan mengurangkan dengan lebih baik risiko pengguna didedahkan kepada kandungan memudaratkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_13__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Langkah-langkah yang dilaksanakan di bawah seksyen ini tidak boleh mengehadkan suara pengguna secara tidak munasabah atau tidak berkadaran. Kewajipan untuk mengeluarkan garis panduan kepada pengguna"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_14__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_14__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_14__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Pemberi perkhidmatan aplikasi berlesen dan pemberi perkhidmatan aplikasi kandungan berlesen hendaklah mengeluarkan garis panduan kepada pengguna yang hendaklah termasuk—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_14__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_14__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "perihalan langkah-langkah yang dilaksanakan oleh pemberi perkhidmatan aplikasi berlesen dan pemberi perkhidmatan aplikasi kandungan berlesen itu di bawah seksyen 13; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_14__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_14__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "syarat-syarat penggunaan sebagai panduan kepada pengguna apabila menggunakan perkhidmatan pemberi perkhidmatan aplikasi berlesen dan pemberi perkhidmatan aplikasi kandungan berlesen itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Pemberi perkhidmatan aplikasi berlesen dan pemberi perkhidmatan aplikasi kandungan berlesen hendaklah menjadikan garis panduan yang dikeluarkan di bawah subseksyen (1) tersedia dalam perkhidmatannya dan memastikan bahawa garis panduan itu adalah jelas, boleh diakses dan difahami dengan mudah, dan selalu dikemas kini. Kewajipan untuk membolehkan pengguna mengurus keselamatan dalam talian"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_15__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_15__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_15__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Pemberi perkhidmatan aplikasi berlesen dan pemberi perkhidmatan aplikasi kandungan berlesen hendaklah menjadikan perkakasan dan pengesetan yang mencukupi tersedia dalam perkhidmatannya untuk membolehkan pengguna mengurus keselamatan dalam taliannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Perkakasan dan pengesetan yang disebut dalam subseksyen (1) hendaklah termasuk perkakasan bagi pengguna menghalang atau mengehadkan pengguna lain daripada mengenal pasti, mencari atau berkomunikasi dengannya dalam perkhidmatan pemberi perkhidmatan aplikasi berlesen dan pemberi perkhidmatan aplikasi kandungan berlesen itu. Kewajipan untuk menjadikan mekanisme bagi pelaporan kandungan memudaratkan tersedia"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Pemberi perkhidmatan aplikasi berlesen dan pemberi perkhidmatan aplikasi kandungan berlesen hendaklah menjadikan suatu mekanisme yang membolehkan pengguna membuat laporan kepada pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen itu tersedia dalam perkhidmatannya berkenaan dengan apa-apa kandungan yang dipercayai oleh pengguna itu ialah kandungan memudaratkan yang terdapat dalam perkhidmatan pemberi perkhidmatan aplikasi berlesen atau pemberi perkhidmatan aplikasi kandungan berlesen itu. Kewajipan untuk menjadikan mekanisme bagi bantuan pengguna tersedia"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_17__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Pemberi perkhidmatan aplikasi berlesen dan pemberi perkhidmatan aplikasi kandungan berlesen hendaklah menjadikan suatu mekanisme bagi bantuan pengguna tersedia dalam perkhidmatannya yang boleh diakses dengan mudah oleh semua jenis pengguna dan responsif pada setiap masa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_17__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_17__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_17__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Mekanisme bagi bantuan pengguna yang disebut dalam subseksyen (1) hendaklah, antara lain, bagi maksud yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_17__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_17__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi pengguna membangkitkan kebimbangannya berkenaan dengan keselamatan dalam talian, termasuk langkah-langkah yang dilaksanakan oleh pemberi perkhidmatan aplikasi berlesen dan pemberi perkhidmatan aplikasi kandungan berlesen di bawah seksyen 13;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_17__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_17__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi pengguna memperoleh apa-apa maklumat lain mengenai mekanisme berkenaan dengan keselamatan dalam talian yang tersedia dalam perkhidmatan pemberi perkhidmatan aplikasi berlesen dan pemberi perkhidmatan aplikasi kandungan berlesen dalam tempoh sebagaimana yang ditetapkan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_17__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_17__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi pengguna membuat apa-apa pertanyaan. Kewajipan untuk melindungi keselamatan dalam talian pengguna kanak-kanak"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_III__cl_18",
      "@type": "akn:clause",
