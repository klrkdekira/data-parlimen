      "schema:text": {
        "@language": "ms",
        "@value": "dia menjadi bankrap atau tidak solven;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_42__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_42__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dia dilarang menjadi pengarah syarikat di bawah mana-mana undang-undang bertulis yang berhubungan dengan syarikat;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/59/msa@/~part_VII__cl_42__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
