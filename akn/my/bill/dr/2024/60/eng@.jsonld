        "@language": "en",
        "@value": "NATIONAL DATA SHARING COMMITTEE Establishment of Committee"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/60/eng@/~part_III",
      "@type": "akn:part",
      "eli:number": "III",
