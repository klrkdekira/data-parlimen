      "schema:text": {
        "@language": "ms",
        "@value": "KEWAJIPAN DAN KUASA KETUA PENGARAH Kewajipan dan kuasa Ketua Pengarah"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/60/msa@/~part_III__cl_11",
      "@type": "akn:clause",
