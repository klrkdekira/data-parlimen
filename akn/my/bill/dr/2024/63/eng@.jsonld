        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/eng@/~part_III__cl_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/eng@/~part_III__cl_11",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/eng@/~part_III__cl_12",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/eng@/~part_III__cl_13",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/eng@/~part_III__cl_14"
      ],
