        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_III__cl_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_III__cl_11",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_III__cl_12",
