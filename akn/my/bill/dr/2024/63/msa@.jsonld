      "schema:text": {
        "@language": "ms",
        "@value": "AM Mesyuarat agung"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_VI__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_VI__cl_19__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_VI__cl_19__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_VI__cl_19__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_VI__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis hendaklah mengadakan mesyuarat agung sebagaimana yang diperuntukkan dalam Jadual Kedua."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_VI__cl_19__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_VI__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, atas syor Majlis, melalui perintah yang disiarkan dalam Warta, meminda Jadual Kedua. Penyimpanan rekod dan akaun Majlis"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_VI__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_VI__cl_20__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_VI__cl_20__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_VI__cl_20__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_VI__cl_20__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_VI__cl_20__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_VI",
      "schema:name": {
        "@language": "ms",
        "@value": "Lembaga hendaklah menyimpan minit prosidingnya termasuklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_VI__cl_20__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_VI__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "minit mesyuarat Lembaga;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_VI__cl_20__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_VI__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "minit mesyuarat agung Majlis;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_VI__cl_20__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_VI__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "kertas pertimbangan bagi setiap ketetapan dalam mesyuarat Lembaga;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_VI__cl_20__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_VI__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "kertas pertimbangan bagi setiap ketetapan dalam mesyuarat agung; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_VI__cl_20__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_VI__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "akaun dan rekod akaun yang menjelaskan transaksi akaun dengan secukupnya bagi membolehkan kunci kira-kira, penyata pendapatan dan perbelanjaan dan penyata untung rugi yang benar dan adil disediakan. Garis panduan, arahan, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_VI__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_VI__cl_21__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_VI__cl_21__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_VI__cl_21__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_VI__cl_21__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_VI__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis boleh mengeluarkan apa-apa garis panduan, arahan, pekeliling, standard dan notis sebagaimana yang difikirkan perlu atau suai manfaat oleh Majlis, yang hendaklah dipatuhi oleh semua ahli."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_VI__cl_21__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_VI__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana ahli yang gagal mematuhi garis panduan, arahan, pekeliling, standard dan notis adalah tertakluk pada prosiding tatatertib Majlis."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_VI__cl_21__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_VI__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Garis panduan, arahan, pekeliling, standard dan notis itu hendaklah dibuat dan diterima pakai oleh Majlis melalui suatu ketetapan undi majoriti biasa ahli yang hadir dan mengundi dalam mesyuarat agung. Tatalaku"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_VI__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_VI__cl_22__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_VI__cl_22__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_VI__cl_22__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_VI__cl_22__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_VI__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis boleh mengadakan suatu tatalaku yang hendaklah dipatuhi oleh ahlinya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_VI__cl_22__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_VI__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "Tatalaku itu hendaklah dibuat dan diterima pakai oleh Majlis melalui suatu ketetapan undi majoriti biasa ahli yang hadir dan mengundi dalam mesyuarat agung."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_VI__cl_22__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_VI__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika sampai kepada pengetahuan Majlis bahawa terdapat suatu pelanggaran tatalaku yang dikatakan telah dilakukan oleh mana-mana ahli Majlis, perkara itu hendaklah diuruskan melalui mekanisme ketidakpuasan hati dan prosiding tatatertib yang ditubuhkan di bawah Bahagian IV. Perlindungan daripada guaman dan prosiding undang-undang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_VI__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada tindakan, guaman, pendakwaan atau prosiding lain boleh dibawa, dimulakan atau dikekalkan dalam mana-mana mahkamah terhadap Lembaga atau mana-mana jawatankuasa yang ditubuhkan oleh Lembaga atas sebab atau yang berkenaan dengan apa-apa perbuatan, kecuaian atau keingkaran yang dilakukan atau ditinggalkan olehnya dalam masa menjalankan kewajipannya di bawah Akta ini melainkan jika boleh dibuktikan bahawa perbuatan, kecuaian atau keingkaran itu telah dilakukan atau ditinggalkan dengan niat jahat dan tanpa sebab yang munasabah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_17__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_17__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_17__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_17__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu kumpulan wang yang hendaklah dikenali sebagai “Kumpulan Wang Majlis Media Malaysia” ditubuhkan dan hendaklah ditadbir dan dikawal oleh Majlis."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_17__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_17__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_17__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_17__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_17__subsec_2__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Kumpulan Wang Majlis Media Malaysia hendaklah terdiri daripada—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_17__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_17__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa jumlah wang yang diperuntukkan oleh Parlimen dari semasa ke semasa bagi maksud Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_17__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_17__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "semua wang yang diperoleh daripada fi yang dikutip, pengendalian mana-mana projek atau skim yang dibiayai daripada Kumpulan Wang Majlis Media Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_17__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_17__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "semua wang yang diperoleh atau berbangkit daripada apa-apa harta, gadai janji, pajakan, penyewaan, gadaian atau debentur yang diperoleh atau terletak hak pada Majlis;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_17__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_17__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "wang yang diterima oleh Majlis melalui pemberian atau derma yang diterima secara sah oleh Majlis; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_17__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_17__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "kesemua jumlah wang dan harta lain yang dengan apa-apa cara menjadi kena dibayar kepada atau terletak hak pada Majlis berkenaan dengan apa-apa perkara yang bersampingan dengan pelaksanaan fungsinya dan penjalanan kuasanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_17__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud perenggan (2)(a), bagi apa-apa tempoh Majlis menerima peruntukan apa-apa jumlah wang yang diperuntukkan oleh Parlimen bagi maksud Akta ini, Akta Badan Berkanun (Akaun dan Laporan Tahunan) 1980 [Akta 240] hendaklah terpakai bagi Majlis."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_17__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis tidak boleh menerima apa-apa dana asing."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_17__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (4), Majlis boleh menerima dana asing tanpa apa-apa syarat daripada mana-mana individu atau pertubuhan asing bagi maksud untuk menggalakkan kesedaran dan memberikan pendidikan berhubung dengan industri media, tertakluk pada kelulusan Menteri. Perbelanjaan yang hendaklah dipertanggungkan pada Kumpulan Wang Majlis Media Malaysia"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_18__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_18__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_18__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_18__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_18__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_18__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_18__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_18__subsec_1__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Kumpulan Wang Majlis Media Malaysia hendaklah dibelanjakan bagi maksud yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_18__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_18__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "membayar apa-apa perbelanjaan yang dilakukan secara sah oleh Majlis;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_18__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_18__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "membayar saraan, elaun dan perbelanjaan lain ahli Lembaga, jawatankuasa dan pekerja Majlis;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_18__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_18__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "membiayai aktiviti penyelidikan berhubung dengan pembangunan industri media;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_18__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_18__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "membayar apa-apa fi keahlian kepada badan atau pertubuhan, di dalam atau di luar Malaysia, yang Majlis ialah ahli sebagaimana yang ditentukan oleh Lembaga;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_18__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_18__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat sumbangan kepada badan atau pertubuhan, di dalam atau di luar Malaysia, berkaitan dengan aktiviti kewartawanan sebagaimana yang ditentukan oleh Lembaga; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_18__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_18__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "membayar apa-apa belanja, kos atau perbelanjaan lain berhubung dengan perolehan barangan dan perkhidmatan, termasuklah pengambilan perunding, fi dan kos guaman serta fi dan kos lain, yang ditanggung atau diterima dengan sewajarnya oleh Majlis dalam melaksanakan fungsinya dan menjalankan kuasanya di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~part_V__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun perenggan (1)(e), apa-apa sumbangan kepada badan atau pertubuhan di luar Malaysia hendaklah tertakluk pada kelulusan Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "[Subseksyen 8(6)] Lembaga pengasas"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_1",
      "@type": "akn:paragraph",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_1__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_1__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_1__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_1__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_1__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_1__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_1__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun seksyen 8 Akta ini, anggota Lembaga pengasas yang dilantik oleh Menteri adalah seperti yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_1__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_1__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "empat anggota Lembaga yang terdiri daripada syarikat media yang diwakili oleh penerbit media masing-masing atau pengurusan kanan yang dinamakan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_1__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_1__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "empat anggota Lembaga yang terdiri daripada persatuan media yang diwakili oleh mana-mana ahli persatuan yang dinamakan, pengamal media dan pengamal media bebas; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_1__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_1__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "empat anggota Lembaga yang terdiri daripada ahli bukan media."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Anggota Lembaga pengasas yang dilantik oleh Menteri hendaklah melantik Pengerusi yang akan mengetuai Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_1__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga pengasas hendaklah menjalankan fungsi dan kuasa Lembaga itu dari tarikh pelantikan anggota Lembaga pengasas sehingga penamaan dan pemilihan anggota Lembaga di bawah subseksyen 8(4) Akta ini dijalankan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_1__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga pengasas hendaklah bertanggungjawab untuk mengadakan mesyuarat agung pertama Majlis."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_1__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Tempoh jawatan anggota Lembaga pengasas adalah tidak tertakluk kepada tempoh sebagaimana yang diperuntukkan dalam seksyen 10 Akta ini. Mesyuarat Lembaga"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_2",
      "@type": "akn:paragraph",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_2__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_2__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_2__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_2__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_2__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga hendaklah bermesyuarat sekurang-kurangnya sekali dalam setiap tiga bulan pada masa dan tempat yang ditentukan oleh Pengerusi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi hendaklah mempengerusikan semua mesyuarat Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_2__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Pengerusi tidak hadir pada mana-mana mesyuarat Lembaga, Pengerusi boleh mengarahkan Timbalan Pengerusi untuk menggantikannya sebagai pengerusi mesyuarat itu dan jika Pengerusi dan Timbalan Pengerusi tidak hadir, Lembaga hendaklah memilih seorang daripada anggotanya untuk mempengerusikan mesyuarat itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_2__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Kuorum Lembaga bagi mesyuarat ialah sebelas orang anggota, termasuklah Pengerusi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_2__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga hendaklah menentukan tatacara mesyuaratnya sendiri. Lembaga boleh mengundang orang lain ke mesyuarat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_3",
      "@type": "akn:paragraph",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_3__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga boleh mengundang mana-mana orang untuk menghadiri mesyuarat Lembaga bagi tujuan untuk menasihati Lembaga mengenai apa-apa perkara yang sedang dibincangkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang dijemput di bawah subperenggan (1) boleh dibayar apa-apa elaun dan perbelanjaan lain sebagaimana yang ditentukan oleh Majlis melalui suatu ketetapan undi majoriti biasa ahli yang hadir dan mengundi dalam mesyuarat agung. Penzahiran kepentingan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_4",
      "@type": "akn:paragraph",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_4__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang anggota Lembaga atau mana-mana orang yang diundang untuk menghadiri suatu mesyuarat Lembaga, yang mempunyai atau memperoleh suatu kepentingan secara langsung atau tidak langsung, berhubung dengan apa-apa perkara yang sedang dibincangkan oleh Lembaga hendaklah menzahirkan kepada Lembaga, hakikat kepentingannya dan jenis kepentingan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_4__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_4__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Penzahiran di bawah subperenggan (1) hendaklah direkodkan dalam minit mesyuarat Lembaga yang dalamnya perkara itu dibincangkan dan, selepas penzahiran itu, anggota itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_4__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_4__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak boleh hadir atau mengambil bahagian dalam mana-mana perbincangan atau keputusan Lembaga mengenai perkara itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_4__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_4__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak boleh dikira bagi maksud membentuk kuorum Lembaga apabila perkara itu dibincangkan atau diputuskan. Minit"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1__para_5",
      "@type": "akn:paragraph",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Minit mesyuarat Lembaga yang ditandatangani oleh pengerusi mesyuarat hendaklah diterima dalam mana-mana prosiding undang-undang sebagai keterangan prima facie mengenai fakta yang dinyatakan dalam minit itu tanpa bukti selanjutnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2",
      "@type": "akn:schedule",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "[Seksyen 19] MESYUARAT AGUNG Mesyuarat agung pertama"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_1",
      "@type": "akn:paragraph",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_1__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_1__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_1__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_1__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_1__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_1__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Mesyuarat agung pertama Majlis hendaklah diadakan dalam tempoh enam bulan daripada tarikh pelantikan anggota Lembaga pengasas."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Notis mengenai mesyuarat agung pertama hendaklah dihantar kepada ahli Majlis, mengikut apa-apa cara yang ditentukan oleh Lembaga pengasas, tidak kurang daripada tiga puluh hari sebelum tarikh mesyuarat itu, dan tidak lebih daripada enam puluh hari."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_1__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Kuorum untuk mesyuarat agung pertama hendaklah satu pertiga daripada keahlian Majlis."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_1__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_1__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_1__subsec_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_1__subsec_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Agenda bagi mesyuarat agung pertama hendaklah termasuk perkara yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_1__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_1__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memilih anggota Lembaga Majlis di bawah subseksyen 8(4) Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_1__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_1__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menentukan tatacara berhubung dengan penjalanan suatu mesyuarat agung tahunan Majlis; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_1__subsec_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_1__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menentukan fi dan perkara lain yang berhubungan dengan keahlian Majlis."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_1__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_1__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_1__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga pengasas hendaklah menyebabkan supaya disediakan dan dibentangkan kepada mesyuarat agung pertama—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_1__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_1__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa perkara yang hendak ditentukan bagi maksud melaksanakan fungsi Majlis di bawah seksyen 5 Akta ini; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_1__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_1__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa perkara yang hendak ditentukan bagi maksud menjalankan kuasa Majlis di bawah subseksyen 6(3) Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_1__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Perkara yang menghendaki suatu keputusan dalam mesyuarat agung pertama hendaklah diputuskan melalui suatu ketetapan undi majoriti biasa ahli yang hadir dan mengundi dalam mesyuarat agung."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_1__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika bilangan undi sama banyak, pengerusi mesyuarat hendaklah mempunyai undi pemutus sebagai tambahan kepada undi biasanya. Mesyuarat agung tahunan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2",
      "@type": "akn:paragraph",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2__subsec_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2__subsec_10"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Mesyuarat agung tahunan selepas mesyuarat agung pertama hendaklah diadakan dengan kekerapan sekali dalam setahun kalendar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2__subsec_10",
      "@type": "akn:subsection",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika bilangan undi sama banyak, pengerusi mesyuarat hendaklah mempunyai undi pemutus sebagai tambahan kepada undi biasanya. Mesyuarat agung luar biasa"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Notis mengenai mesyuarat agung tahunan hendaklah dihantar kepada ahli Majlis, mengikut cara sebagaimana yang ditentukan oleh Majlis, tidak kurang daripada tiga puluh hari sebelum tarikh mesyuarat itu, dan tidak lebih daripada enam puluh hari."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Notis bagi suatu mesyuarat agung tahunan hendaklah termasuk tetapi tidak terhad kepada butiran yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "tempat, tarikh dan masa bagi mesyuarat itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "setiap perkara yang dicadangkan untuk ditentukan pada mesyuarat itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2__subsec_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2__subsec_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Notis bagi suatu mesyuarat agung tahunan hendaklah disertai dengan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu salinan minit mesyuarat agung yang terakhir;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu salinan akaun teraudit bersama dengan laporan juruaudit mengenai Kumpulan Wang Majlis Media Malaysia; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2__subsec_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa dokumen lain untuk ditentukan pada mesyuarat itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana ahli Majlis boleh, melalui apa-apa cara sebagaimana yang ditentukan oleh Lembaga, mengemukakan apa-apa usul untuk dipertimbangkan pada suatu mesyuarat agung tahunan, dan usul itu hendaklah diserahkan kepada Lembaga sekurang-kurangnya dua puluh satu hari sebelum mesyuarat agung tahunan itu diadakan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Kuorum untuk mesyuarat agung tahunan hendaklah satu pertiga daripada keahlian Majlis."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika kuorum yang disebut dalam subperenggan (6) tidak hadir dalam masa satu jam dari masa yang ditetapkan bagi mengadakan mesyuarat itu, mesyuarat itu hendaklah ditangguhkan ke hari berikutnya pada masa dan tempat yang sama melainkan dimaklumkan sebaliknya, dan jika kuorum tidak hadir pada mesyuarat yang ditangguhkan itu dalam masa satu jam dari masa yang ditetapkan, ahli yang hadir dan berhak mengundi, walau apa pun bilangan mereka, hendaklah membentuk kuorum dan boleh mengendalikan urusan yang untuknya mesyuarat tersebut diadakan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2__subsec_8__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2__subsec_8__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2__subsec_8__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2__subsec_8__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2__subsec_8__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga hendaklah menyebabkan supaya disediakan dan dibentangkan kepada suatu mesyuarat agung tahunan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2__subsec_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2__subsec_8",
      "schema:text": {
        "@language": "ms",
        "@value": "laporan mengenai aktiviti Majlis sepanjang tempoh jawatan Lembaga itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2__subsec_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2__subsec_8",
      "schema:text": {
        "@language": "ms",
        "@value": "akaun teraudit bagi tempoh satu tahun kalendar bagi tahun terakhir sebelum sahaja mesyuarat agung tahunan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2__subsec_8__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2__subsec_8",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa perkara yang hendak ditentukan bagi maksud melaksanakan fungsi Majlis di bawah seksyen 5 Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2__subsec_8__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2__subsec_8",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa perkara yang hendak ditentukan bagi maksud menjalankan kuasa Majlis di bawah subseksyen 6(3) Akta ini; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2__subsec_8__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2__subsec_8",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa perkara lain untuk ditentukan pada mesyuarat agung tahunan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Perkara yang menghendaki suatu keputusan dalam mesyuarat agung tahunan hendaklah ditentukan melalui suatu ketetapan undi majoriti biasa ahli yang hadir dan mengundi dalam mesyuarat agung tahunan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_3",
      "@type": "akn:paragraph",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_3__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu mesyuarat agung luar biasa Majlis boleh diadakan pada bila-bila masa oleh Majlis dan hendaklah diadakan atas permintaan tidak kurang daripada satu perlima daripada jumlah keahlian Majlis."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2024/63/msa@/~sched_2__para_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Tatacara berhubung dengan mesyuarat agung luar biasa Majlis adalah sebagaimana yang ditentukan oleh Majlis."
      }
    }
  ]
}
