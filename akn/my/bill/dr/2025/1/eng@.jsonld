        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/1/eng@/~cl_5__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/1/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 8 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/1/eng@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/1/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "in the shoulder note, by deleting the words “and object of the Fund”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/1/eng@/~cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/1/eng@/~cl_5__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/1/eng@/~cl_5__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/1/eng@/~cl_5__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/1/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (2)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/1/eng@/~cl_5__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/1/eng@/~cl_5__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (a), by deleting the word “and” at the end of the paragraph;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/1/eng@/~cl_5__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/1/eng@/~cl_5__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (b), by substituting for the full stop the words “; and”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/1/eng@/~cl_5__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/1/eng@/~cl_5__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after paragraph (b) the following paragraph: “(c) to provide any other form of assistance or equipment for any programmes or schemes as the Board may determine from time to time on condition that such assistance or equipment for the programmes or schemes shall achieve the objects of the Fund as provided under section 7a.”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/1/eng@/~cl_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/1/eng@/~cl_5__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/1/eng@/~cl_5__para_c__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/1/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (3)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/1/eng@/~cl_5__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/1/eng@/~cl_5__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words “Paragraph (2)(a)” the words “Paragraphs (2)(a) and (c)”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/1/eng@/~cl_5__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/1/eng@/~cl_5__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words “or any other award or financial assistance” the words “, any other award or financial assistance or any other form of assistance or equipment for any programmes or schemes”. Amendment of section 9"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/1/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/1/eng@/~cl_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/1/eng@/~cl_6__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/1/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 9 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/1/eng@/~cl_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/1/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "in the shoulder note, by deleting the word “study”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/1/eng@/~cl_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/1/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (1) the following subsection: “(1) Every recipient of a studentship, scholarship, study grant, study loan, any other award or financial assistance or any other form of assistance or equipment for any programmes or schemes, as the case may be, provided or awarded under this Act, shall become and during his tenure thereof shall remain— (a) a student at the place of education approved by the Board and shall pursue his studies at such place of education to the satisfaction of the Board; and (b) a participant in any programmes or schemes as approved by the Board and shall comply with the terms and conditions imposed by the Board.”. Amendment of section 11"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/1/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/1/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Section 11 of the principal Act is amended by inserting after the words “his studies” the words “or his participation in any programmes or schemes”. Amendment of section 13"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/1/eng@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/1/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 13(2) of the principal Act is amended by substituting for the words “10 per centum” the words “twenty per centum”. Saving"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/1/eng@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/1/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The members of the Board appointed before the date of coming into operation of this Act shall continue to hold office until removed from office or until the expiry of their period of appointment."
      }
    }
  ]
}
