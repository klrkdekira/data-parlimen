    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_III",
      "@type": "akn:part",
      "eli:number": "III",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_III__cl_16",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_III__cl_17"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_III__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Bahagian III Akta yang dicadangkan memperkatakan tentang pemerangkapan karbon."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_III__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 15 dan 16 bertujuan untuk mengadakan peruntukan bagi pendaftaran dan permohonan pendaftaran pepasangan pemerangkapan karbon."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 9 bertujuan untuk memperuntukkan bahawa Menteri boleh pada bila-bila masa membatalkan pelantikan mana-mana anggota dan anggota itu juga boleh meletakkan jawatannya dengan memberikan satu bulan notis."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 10 bertujuan untuk mengadakan peruntukan bagi pengosongan jawatan anggota."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 11 bertujuan untuk mengadakan peruntukan bagi mesyuarat dan Agensi boleh menentukan tatacaranya sendiri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 12 bertujuan untuk memperuntukkan bahawa Agensi boleh mengundang orang lain untuk menghadiri mesyuarat tetapi orang itu tidak berhak untuk mengundi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 13 memperuntukkan bahawa Kementerian yang bertanggungjawab bagi Agensi hendaklah mengadakan kepada Agensi kakitangan, dana dan kemudahan lain yang perlu bagi membolehkan Agensi menjalankan fungsinya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 14 bertujuan untuk memperuntukkan bahawa Menteri boleh melantik suatu entiti teknikal kompeten yang berasingan untuk menasihati Agensi tentang pemerangkapan karbon, pengangkutan karbon dioksida, penggunaan karbon dioksida, penyimpanan luar pesisir karbon dioksida dan penyimpanan daratan karbon dioksida. Fasal ini juga memperuntukkan bahawa entiti teknikal kompeten yang dilantik hendaklah menasihati Agensi tentang apa-apa perkara teknikal dan pengoperasian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Bahagian II Akta yang dicadangkan memperkatakan tentang peruntukan yang berhubungan dengan Agensi Pemerangkapan, Penggunaan dan Penyimpanan Karbon Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 6, 7 dan 8 bertujuan untuk mengadakan peruntukan bagi penubuhan, keanggotaan, fungsi dan kuasa, Agensi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IV__cl_18",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IV__cl_19",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IV__cl_20",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IV__cl_21"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IV__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Bahagian IV Akta yang dicadangkan memperkatakan tentang pengangkutan dan pengimportan karbon dioksida."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IV__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 17 dan 18 bertujuan untuk mengadakan peruntukan bagi kehendak pendaftaran dan permohonan bagi pendaftaran untuk mengangkut mana-mana karbon dioksida yang diperangkap, sama ada melalui jalan kereta api, air, talian paip atau melalui apa-apa cara lain."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IV__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 19 bertujuan untuk memperuntukkan bahawa pengimportan karbon dioksida untuk penyimpanan kekal yang diperolehi melalui pemerangkapan carbon di luar Malaysia hendaklah mematuhi kriteria arus karbon dioksida yang dinyatakan dalam fasal 28 Akta yang dicadangkan. Kegagalan untuk mematuhi fasal ini merupakan suatu kesalahan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IV__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 20 bertujuan untuk memperuntukkan bahawa pengimportan mana-mana karbon dioksida yang diperangkap di luar Malaysia hendaklah hanya dibuat dengan suatu permit import. Kegagalan untuk mematuhi fasal ini merupakan suatu kesalahan. Karbon"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IX",
      "@type": "akn:part",
      "eli:number": "IX",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IX__cl_49",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IX__cl_50",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IX__cl_51"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IX__cl_49",
      "@type": "akn:clause",
      "eli:number": "49",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IX",
      "schema:text": {
        "@language": "ms",
        "@value": "Bahagian IX Akta yang dicadangkan memperkatakan tentang peruntukan yang berhubungan dengan penguatkuasaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IX__cl_50",
      "@type": "akn:clause",
      "eli:number": "50",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IX",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 45 bertujuan untuk memberi Menteri kuasa, secara bertulis, untuk membenarkan mana-mana pegawai awam untuk menjalankan kuasa penguatkuasaan di bawah Akta yang dicadangkan ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IX__cl_51",
      "@type": "akn:clause",
      "eli:number": "51",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IX",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 46 bertujuan untuk memperuntukkan bahawa seorang pegawai polis yang pangkatnya tidak rendah daripada Inspektor atau seorang pegawai kanan kastam boleh menjalankan semua kuasa penguatkuasaan di bawah Akta yang dicadangkan ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_I",
      "schema:text": {
        "@language": "ms",
        "@value": "Bahagian I Akta yang dicadangkan memperkatakan mengenai perkara permulaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_I__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_I",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 1 mengandungi tajuk ringkas dan peruntukan mengenai permulaan kuat kuasa Akta yang dicadangkan. Bahagian VII Akta ini mula berkuat kuasa di suatu Negeri pada tarikh yang ditetapkan oleh Menteri, setelah berunding dengan Kerajaan Negeri masing-masing, melalui pemberitahuan dalam Warta."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_I__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_I",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 2 bertujuan untuk memperuntukkan bahawa Akta yang dicadangkan hendaklah terpakai bagi Semenanjung Malaysia dan Wilayah Persekutuan Labuan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_I__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_I",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 3 bertujuan untuk memperuntukkan bahawa Akta yang dicadangkan hendaklah dibaca bersama-sama dengan undang-undang bertulis yang berkaitan dan peruntukan Akta ini hendaklah menjadi tambahan kepada, dan tidak mengurangkan, peruntukan undang-undang bertulis yang berkaitan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_I__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_I",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 4 mengandungi takrif bagi perkataan dan ungkapan tertentu yang digunakan dalam Akta yang dicadangkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_I__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_I",
      "schema:text": {
        "@language": "ms",
        "@value": "Fasal 5 bertujuan untuk memperuntukkan bahawa amalan pemerangkapan, penggunaan dan penyimpanan karbon yang berhemah hendaklah mengikut apa-apa amalan, kaedah, langkah dan standard yang secara amnya diikuti oleh industri pemerangkapan, penggunaan dan penyimpanan karbon global."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_V",
      "@type": "akn:part",
      "eli:number": "V",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_V__cl_22",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_V__cl_23",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_V__cl_24"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_VI",
      "@type": "akn:part",
      "eli:number": "VI",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_VI__cl_25",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_VI__cl_26",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_VI__cl_27",
