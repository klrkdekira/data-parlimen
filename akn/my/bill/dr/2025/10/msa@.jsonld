        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_VII__cl_36__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_VII__cl_36__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_VII__cl_36",
      "schema:text": {
        "@language": "ms",
        "@value": "Agensi boleh, selepas menimbangkan permohonan bagi lesen penyimpanan daratan di bawah seksyen 35 dan selepas berpuas hati bahawa semua kehendak telah dipenuhi, memberi atau menolak pengeluaran lesen penyimpanan daratan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_VII__cl_36__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_VII__cl_36",
      "schema:text": {
        "@language": "ms",
        "@value": "Agensi boleh mengenakan syarat yang difikirkannya sesuai, dalam memberikan lesen penyimpanan daratan itu. Kriteria penerimaan arus karbon dioksida bagi maksud penyimpanan daratan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_VII__cl_37",
      "@type": "akn:clause",
      "eli:number": "37",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_VII__cl_37__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_VII__cl_37__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_VII__cl_37__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_VII__cl_37__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_VII__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada pengendali daratan boleh menerima dan menyuntik arus karbon dioksida ke dalam suatu tapak penyimpanan di kawasan daratan melainkan jika arus karbon dioksida itu mematuhi kriteria penerimaan arus karbon dioksida yang dinyatakan dalam seksyen 28."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_VII__cl_37__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_VII__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengendali daratan hendaklah menyimpan suatu daftar kuantiti dan sifat arus karbon dioksida yang diterima dan disuntik, termasuk komposisi arus itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_VII__cl_37__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_VII__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1) atau (2) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi satu juta ringgit atau dipenjarakan selama tempoh tidak melebihi lima tahun atau kedua-duanya. Karbon Obligasi pengendalian berhubung dengan penyimpanan daratan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_VII__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Obligasi pengendalian berhubung dengan penyimpanan di luar pesisir yang dinyatakan dalam seksyen 29 hendaklah terpakai mutatis mutandis bagi obligasi pengendalian yang perlu dikenakan atas seorang pengendali daratan dalam hal penyimpanan daratan. Obligasi penutupan dan pasca-penutupan berhubung dengan penyimpanan di daratan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_VII__cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Obligasi penutupan dan pasca-penutupan berhubung dengan penyimpanan di luar pesisir yang dinyatakan dalam seksyen 31 hendaklah terpakai mutatis mutandis bagi obligasi penutupan dan pasca-penutupan yang perlu dikenakan atas suatu pengendali daratan dalam hal penyimpanan daratan. Pemindahan obligasi berhubung dengan penyimpanan daratan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_VII__cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Sebelum penutupan suatu tapak penyimpanan di kawasan daratan menurut seksyen 39, apa-apa pemindahan obligasi yang berhubungan dengan pemantauan, langkah pembetulan dan langkah pemulihan tapak penyimpanan di kawasan daratan hendaklah ditentukan oleh Menteri, selepas berunding dengan Kerajaan Negeri, mengikut mana-mana yang berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_VI__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_VI__cl_24__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_VI__cl_24__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_VI__cl_24__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_VI__cl_24__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_VI__cl_24__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_VI__cl_24__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_VI__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh menjalankan apa-apa penilaian geologi luar pesisir bagi apa-apa kompleks penyimpanan atau bentukan geologi yang berpotensi di kawasan luar pesisir tanpa suatu permit penilaian luar pesisir yang diberikan oleh Agensi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_VI__cl_24__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_VI__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu permohonan bagi permit penilaian luar pesisir di bawah subseksyen (1) hendaklah dibuat kepada Agensi dalam cara dan disertai dengan fi sebagaimana yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_VI__cl_24__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_VI__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu permohonan bagi permit penilaian pesisir di bawah seksyen ini boleh ditarik balik pada bila-bila masa sebelum permit penilaian luar pesisir itu diberikan atau ditolak."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_VI__cl_24__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_VI__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Agensi boleh pada bila-bila masa selepas permohonan di bawah subseksyen (2) dan sebelum permohonan itu ditentukan, melalui suatu notis bertulis, meminta pemohon untuk memberikan apa-apa dokumen atau maklumat tambahan dalam tempoh yang dinyatakan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_VI__cl_24__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_VI__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, dipenjarakan selama tempoh tidak melebihi tiga tahun atau didenda tidak melebihi satu juta ringgit atau kedua-duanya. Pemberian permit penilaian luar pesisir"
      }
    },
    {
