        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_VII__cl_36",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_VII__cl_37",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_VII__cl_38",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_VII__cl_39",
