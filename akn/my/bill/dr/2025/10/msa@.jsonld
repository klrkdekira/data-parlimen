      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "AGENSI PEMERANGKAPAN, PENGGUNAAN DAN PENYIMPANAN KARBON MALAYSIA Penubuhan Agensi"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_III",
      "@type": "akn:part",
      "eli:number": "III",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_III__cl_15",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_III__cl_16"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "PEMERANGKAPAN KARBON Kehendak bagi pendaftaran pepasangan pemerangkapan karbon"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_III__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_III__cl_15__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_III__cl_15__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_III__cl_15__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_III__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang memiliki atau mengendalikan apa-apa pepasangan pemerangkapan karbon hendaklah berdaftar dengan Agensi di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_III__cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_III__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud Bahagian ini, “pepasangan pemerangkapan karbon” ertinya suatu pepasangan yang menjalankan pemerangkapan karbon dan termasuklah apa-apa kemudahan teknikal yang berkaitan dengan pepasangan itu. Permohonan bagi pendaftaran pepasangan pemerangkapan karbon"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_III__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu permohonan bagi pendaftaran di bawah seksyen 15 hendaklah dibuat kepada Agensi dalam cara dan disertai dengan maklumat, butir-butir atau dokumen sebagaimana yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_10__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_10__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_10__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_10__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_10__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_10__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_10__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_10__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_10__para_i"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatan anggota yang dilantik di bawah perenggan 7(1)(d) hendaklah dikosongkan jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_10__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "dia mati;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_10__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "kelakuannya, sama ada yang berkaitan dengan kewajipannya sebagai anggota Agensi atau selainnya, telah memburukkan nama Agensi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_10__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_10__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_10__para_c__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_10__para_c__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "telah dibuktikan terhadapnya, atau dia telah disabitkan atas, suatu pertuduhan berkenaan dengan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_10__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_10__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "kesalahan yang melibatkan fraud, kecurangan atau keburukan akhlak;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_10__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_10__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "kesalahan di bawah undang-undang yang berhubungan dengan rasuah; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_10__para_c__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_10__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa kesalahan lain yang boleh dihukum dengan pemenjaraan lebih daripada dua tahun;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_10__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "dia menjadi bankrap;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_10__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "dia menjadi tidak sempurna akal atau selainnya tidak berupaya menunaikan kewajipannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_10__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "dia tidak menghadiri mesyuarat Agensi tiga kali berturut-turut tanpa kebenaran Pengerusi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_10__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "peletakan jawatannya diterima oleh Menteri;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_10__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "pelantikannya dibatalkan oleh Menteri; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_10__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "tempoh pelantikannya telah tamat. Mesyuarat Agensi"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_11__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_11__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_11__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_11__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_11__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Agensi hendaklah mengadakan mesyuaratnya sekurang-kurangnya sekali setahun dan mesyuarat itu hendaklah diadakan pada masa dan di tempat yang dinyatakan dalam notis bertulis oleh Pengerusi, dan Pengerusi boleh membenarkan penggunaan suatu rangkaian video secara langsung, rangkaian televisyen secara langsung atau apa-apa cara komunikasi elektronik yang lain bagi maksud apa-apa mesyuarat Agensi itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi hendaklah mempengerusikan semua mesyuarat Agensi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_11__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Pengerusi tidak hadir pada sesuatu mesyuarat Agensi, anggota yang hadir hendaklah memilih seorang daripada mereka untuk mempengerusikan mesyuarat itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_11__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Lima orang anggota, termasuk Pengerusi mesyuarat, hendaklah membentuk kuorum mesyuarat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_11__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika terdapat bilangan undi yang sama banyak, Pengerusi yang mempengerusikan mesyuarat itu hendaklah mempunyai undi pemutus."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_11__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Agensi boleh menentukan tatacaranya sendiri. Karbon Agensi boleh mengundang orang lain untuk menghadiri mesyuarat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Agensi boleh mengundang mana-mana orang lain untuk menghadiri apa-apa mesyuarat Agensi bagi menasihati Agensi mengenai apa-apa perkara yang sedang dibincangkan, tetapi orang yang hadir sedemikian tidak berhak untuk mengundi pada mesyuarat itu. Penyediaan kemudahan oleh Kementerian"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Kementerian yang bertanggungjawab bagi Agensi hendaklah menyediakan kakitangan, dana dan kemudahan lain yang perlu kepada Agensi untuk membolehkannya menjalankan fungsinya. Pelantikan entiti teknikal kompeten"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_14__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_14__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_14__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_14__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_14__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_14__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_14__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_14__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_14__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud Akta ini, Menteri boleh melantik suatu entiti teknikal kompeten yang berasingan bagi mana-mana komponen yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_14__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_14__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pemerangkapan karbon;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_14__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_14__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pengangkutan karbon dioksida;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_14__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_14__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "penggunaan karbon dioksida;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_14__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_14__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "penyimpanan luar pesisir karbon dioksida; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_14__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_14__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "penyimpanan daratan karbon dioksida."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Entiti teknikal kompeten yang dilantik di bawah subseksyen (1) hendaklah menasihati Agensi mengenai apa-apa perkara teknikal dan pengendalian yang berhubungan dengan komponen yang berkaitan entiti itu dilantik dan melaksanakan apa-apa fungsi lain sebagaimana yang ditentukan oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_14__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang hanya boleh dilantik sebagai entiti teknikal kompeten di bawah subseksyen (1) jika orang itu mempunyai pengetahuan, kemahiran dan pengalaman yang perlu berkenaan dengan komponen yang berkaitan bagi pemerangkapan, pengangkutan, penggunaan dan penyimpanan karbon."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_14__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana entiti teknikal kompeten yang dilantik di bawah subseksyen (1) hendaklah menggunakan usaha yang munasabah dalam menunaikan kewajipannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_14__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada apa-apa jua dalam subseksyen (1) boleh ditafsirkan sebagai memberikan kuasa kepada Menteri untuk melantik suatu entiti teknikal kompeten bagi apa-apa maksud selain daripada maksud yang dinyatakan dalam subseksyen (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Agensi Pemerangkapan, Penggunaan dan Penyimpanan Karbon Malaysia ditubuhkan. Karbon Keanggotaan Agensi"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_7__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_7__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_7__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_7__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_7__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Agensi hendaklah terdiri daripada anggota yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_7__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang Pengerusi, yang hendaklah dilantik oleh Menteri daripada kalangan anggota Agensi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_7__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Setiausaha Kementerian yang dipertanggungkan dengan tanggungjawab bagi pemerangkapan, penggunaan dan penyimpanan karbon;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_7__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah Jabatan Alam Sekitar; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_7__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak lebih daripada enam anggota lain yang hendaklah dilantik secara bertulis oleh Menteri, yang pada pandangan Menteri, mempunyai pengalaman, pengetahuan dan kepakaran yang sesuai dalam perkara yang berhubungan dengan pemerangkapan, penggunaan atau penyimpanan karbon atau apa-apa kepakaran lain yang berkaitan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_7__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_7__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Anggota Agensi yang dilantik di bawah perenggan (1)(d)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_7__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_7__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "boleh dibayar apa-apa elaun sebagaimana yang ditentukan oleh Menteri; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_7__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_7__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "melainkan jika dia terlebih dahulu meletakkan atau mengosongkan jawatannya atau pelantikannya terlebih dahulu dibatalkan, hendaklah memegang jawatan selama tempoh tidak melebihi tiga tahun dan layak untuk dilantik semula selama tempoh tidak melebihi dua penggal berturut-turut. Fungsi dan kuasa Agensi"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_8__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_8__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_8__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_8__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_8__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_8__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_8__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_8__subsec_1__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_8__subsec_1__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_8__subsec_1__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_8__subsec_1__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_8__subsec_1__para_k",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_8__subsec_1__para_l",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_8__subsec_1__para_m",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_8__subsec_1__para_n"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Fungsi Agensi adalah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_8__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_8__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menasihati Kerajaan dan Menteri berkaitan perkara yang berhubungan dengan pelaksanaan Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_8__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_8__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mentadbir dan memastikan pelaksanaan yang berkesan Akta ini dan apa-apa peraturan-peraturan yang dibuat di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_8__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_8__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menyelia apa-apa aktiviti berhubung dengan pemerangkapan, pengangkutan, penggunaan dan penyimpanan karbon;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_8__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_8__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menyelia pengurusan apa-apa sumber pen yimp anan bagi maksud pen yimp anan k ekal karbon dioksida di Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_8__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_8__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mentadbir dan mengawal Kumpulan Wang, dan semua perkara yang berhubungan dengan faedah dan pelaburan Kumpulan Wang itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_8__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_8__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengesyorkan kepada Kerajaan apa-apa dasar, tindakan dan langkah yang berhubungan dengan pemerangkapan, pengangkutan, penggunaan dan penyimpanan karbon;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_8__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_8__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menggalakkan, membangunkan atau melaksanakan apa-apa dasar dan inisiatif yang berhubungan dengan pemerangkapan, pengangkutan, penggunaan dan penyimpanan karbon;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_8__subsec_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_8__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengumpul, menganalisis dan menyiarkan apa-apa maklumat, statistik dan faktor yang mempengaruhi atau yang berkaitan dengan pembangunan pemerangkapan, pengangkutan, penggunaan dan penyimpanan karbon;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_8__subsec_1__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_8__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengawal aktiviti penilaian geologi luar pesisir dan penilaian geologi daratan melalui pengeluaran permit penilaian luar pesisir dan permit penilaian daratan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_8__subsec_1__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_8__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengawal penyimpanan kekal di kawasan luar pesisir dan kawasan daratan melalui pengeluaran lesen penyimpanan luar pesisir dan lesen penyimpanan daratan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_8__subsec_1__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_8__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk melaporkan kepada Menteri apa-apa perkara berkenaan dengan apa-apa kebocoran atau ketidakteraturan yang signifikan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_8__subsec_1__para_l",
      "@type": "akn:paragraph",
      "eli:number": "l",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_8__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengawal aktiviti pengangkutan karbon dioksida yang diperangkap di dalam atau di luar Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_8__subsec_1__para_m",
      "@type": "akn:paragraph",
      "eli:number": "m",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_8__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengawal aktiviti pengimportan karbon dioksida yang diperangkap di luar Malaysia; dan Karbon"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_8__subsec_1__para_n",
      "@type": "akn:paragraph",
      "eli:number": "n",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_8__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk melakukan apa-apa perkara lain yang timbul atau berbangkit daripada fungsi Agensi di bawah Akta ini selaras dengan maksud Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Agensi hendaklah mempunyai semua kuasa yang mungkin perlu untuk, berkaitan dengan, atau secara munasabah bersampingan dengan, pelaksanaan fungsinya di bawah Akta ini. Pembatalan pelantikan dan peletakan jawatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_9__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Pelantikan mana-mana anggota yang dilantik di bawah perenggan 7(1)(d), boleh pada bila-bila masa dibatalkan oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana anggota yang disebut dalam subseksyen (1) boleh pada bila-bila masa meletakkan jawatannya dengan memberikan satu bulan notis kepada Menteri. Pengosongan jawatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IV__cl_17",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IV__cl_18",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IV__cl_19",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IV__cl_20"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "PENGANGKUTAN DAN PENGIMPORTAN KARBON DIOKSIDA Pengangkutan karbon dioksida"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IV__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IV__cl_17__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IV__cl_17__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang, melalui jalan, kereta api, air, talian paip atau melalui apa-apa cara lain, mengangkut apa-apa karbon dioksida yang diperoleh melalui pemerangkapan karbon, hendaklah sebelum Karbon pengangkutan itu, berdaftar dengan Agensi di bawah Akta ini dan hendaklah mematuhi—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IV__cl_17__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IV__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana undang-undang bertulis lain yang berhubungan dengan pengangkutan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IV__cl_17__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IV__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "amalan pemerangkapan, penggunaan dan penyimpanan karbon yang berhemat yang dinyatakan dalam seksyen 5. Permohonan pendaftaran untuk mengangkut karbon dioksida"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IV__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu permohonan bagi pendaftaran di bawah seksyen 17 hendaklah dibuat kepada Agensi dalam cara dan disertai dengan maklumat, butir-butir atau dokumen sebagaimana yang ditetapkan. Pengimportan karbon dioksida yang diperangkap di luar Malaysia"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IV__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IV__cl_19__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IV__cl_19__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IV__cl_19__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IV__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh mengimport bagi penyimpanan kekal apa-apa karbon dioksida yang diperoleh melalui pemerangkapan karbon di luar Malaysia melainkan jika karbon dioksida itu mematuhi kriteria penerimaan arus karbon dioksida yang dinyatakan dalam seksyen 28."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IV__cl_19__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IV__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi satu juta ringgit atau dipenjarakan selama tempoh tidak melebihi lima tahun atau kedua-duanya. Permit import karbon dioksida yang diperangkap di luar Malaysia"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IV__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IV__cl_20__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IV__cl_20__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IV__cl_20__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IV__cl_20__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IV__cl_20__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IV__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada apa-apa karbon dioksida yang diperangkap di luar Malaysia boleh diimport melalui jalan, kereta api, air, talian paip atau melalui apa-apa cara lain ke dalam Malaysia melainkan jika pengimportan itu mematuhi permit import yang diberikan oleh Agensi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IV__cl_20__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IV__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu permohonan bagi suatu permit import di bawah subseksyen (1) hendaklah dibuat kepada Agensi dalam apa-apa cara dan disertai dengan apa-apa maklumat, butir-butir atau dokumen dan pembayaran fi sebagaimana ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IV__cl_20__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IV__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu permohonan di bawah seksyen ini boleh ditarik balik pada bila-bila masa sebelum permit import itu diberikan atau ditolak."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IV__cl_20__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IV__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi satu juta ringgit atau dipenjarakan selama tempoh tidak melebihi lima tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IX",
      "@type": "akn:part",
      "eli:number": "IX",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IX__cl_45",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IX__cl_46"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "PENGUATKUASAAN Pemberikuasaan pegawai awam"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IX__cl_45",
      "@type": "akn:clause",
      "eli:number": "45",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IX",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri, boleh, secara bertulis, memberi kuasa kepada mana-mana pegawai awam untuk menjalankan kuasa penguatkuasaan di bawah Akta ini. Kuasa penguatkuasaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IX__cl_46",
      "@type": "akn:clause",
      "eli:number": "46",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IX__cl_46__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IX__cl_46__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IX__cl_46__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IX__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Seorang pegawai polis yang pangkatnya tidak rendah daripada Inspektor atau seorang pegawai kanan kastam boleh menjalankan semua kuasa penguatkuasaan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IX__cl_46__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_IX__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Seorang pegawai yang diberi kuasa di bawah seksyen 45 hendaklah mempunyai kuasa seorang pegawai polis yang apa jua pun pangkatnya sebagaimana yang diperuntukkan di bawah Kanun Tatacara Jenayah [Akta 593] berhubung dengan penyiasatan apa-apa kesalahan di bawah Akta ini, dan kuasa itu hendaklah sebagai tambahan dan bukan pengurangan bagi, kuasa yang diperuntukkan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_I__cl_1__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_I__cl_1__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_I__cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Pemerangkapan, Penggunaan dan Penyimpanan Karbon 2025."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_I__cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta dan Menteri boleh menetapkan tarikh yang berlainan bagi permulaan kuat kuasa Bahagian atau peruntukan yang berlainan dalam Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_I__cl_1__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_I__cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (2), Bahagian VII Akta ini mula berkuat kuasa di sesuatu Negeri pada tarikh yang ditetapkan oleh Menteri, setelah berunding dengan Kerajaan Negeri, mengikut mana-mana yang berkenaan, melalui pemberitahuan dalam Warta. Pemakaian"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_I",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini hendaklah terpakai bagi Semenanjung Malaysia dan Wilayah Persekutuan Labuan. Akta hendaklah dibaca bersama dengan undang-undang bertulis yang berkaitan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_I__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_I",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini hendaklah dibaca bersama dengan undang-undang bertulis yang berkaitan dan peruntukan Akta ini hendaklah menjadi tambahan kepada, dan tidak mengurangkan, peruntukan undang-undang bertulis yang berkaitan. Karbon Tafsiran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_I__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_I__cl_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_I__cl_4__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_I__cl_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_I__cl_4__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_I__cl_4__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_I__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam Akta ini, melainkan jika konteksnya menghendaki makna yang lain— “Agensi” ertinya Agensi Pemerangkapan, Penggunaan dan Penyimpanan Karbon Malaysia yang ditubuhkan di bawah seksyen 6; “arus karbon dioksida” ertinya suatu aliran bahan yang disebabkan oleh pemerangkapan karbon dioksida di dalam atau di luar Malaysia; “bentukan geologi” ertinya suatu subbahagian litostratigrafi yang di dalamnya terdapat lapisan batu yang ketara yang boleh ditemui dan dipetakan; “ditetapkan” ertinya ditetapkan oleh Menteri melalui peraturan-peraturan yang dibuat di bawah peruntukan Akta ini; “entiti teknikal kompeten” ertinya mana-mana entiti teknikal kompeten yang dilantik di bawah seksyen 14; “kawasan daratan” ertinya semua tanah di dalam setiap negeri di Malaysia dan Wilayah Persekutuan Kuala Lumpur, Putrajaya dan Labuan, termasuk pesisir depan sehingga tiga batu nautika dari garis pangkal setiap Negeri; “kawasan luar pesisir” ertinya dasar laut dan tanih bawah bagi laut Malaysia yang melebihi tiga batu nautika dari garis pangkal setiap negeri, termasuk zon ekonomi eksklusif dan pelantar benua; “kebocoran” ertinya pelepasan atau penyebaran arus karbon dioksida secara tidak sengaja sama ada ke dalam lajur air, air di lautan antara permukaan dan dasar laut, atau atmosfera—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_I__cl_4__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_I__cl_4__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "daripada mana-mana kompleks penyimpanan, tapak penyimpanan, pepasangan pemerangkapan karbon; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_I__cl_4__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_I__cl_4__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "semasa pengangkutan mana-mana karbon dioksida yang didapati melalui pemerangkapan karbon; “ketidakteraturan yang signifikan” ertinya apa-apa ketidakteraturan pengendalian suatu tapak penyimpanan atau keadaan kompleks penyimpanan itu, yang menunjukkan risiko kebocoran atau risiko terhadap alam sekeliling atau kesihatan manusia; “kompleks penyimpanan” ertinya suatu kawasan isi padu yang telah ditentukan di dalam suatu bentukan geologi yang digunakan bagi penyimpanan kekal dan domain geologi keliling yang boleh memberikan kesan terhadap penyimpanan keseluruhan; “kriteria penerimaan arus karbon dioksida” ertinya kriteria bagi penerimaan suatu arus karbon dioksida yang dinyatakan dalam seksyen 28; “Kumpulan Wang” ertinya Kumpulan Wang Pengawasan Pasca-Penutupan yang ditubuhkan di bawah seksyen 41; “langkah pembetulan” ertinya apa-apa langkah yang diambil untuk membetulkan apa-apa ketidakteraturan yang signifikan, atau untuk menutup atau menghentikan apa-apa kebocoran; “langkah pemulihan” ertinya apa-apa langkah yang diambil untuk membaiki apa-apa kerosakan akibat daripada apa-apa kebocoran, pemindahan yang tidak disengajakan atau ketidakteraturan lain dalam suatu tapak penyimpanan; “lesen penyimpanan daratan” ertinya suatu lesen yang dikeluarkan oleh Agensi di bawah seksyen 36; “lesen penyimpanan luar pesisir” ertinya suatu lesen yang dikeluarkan oleh Agensi di bawah seksyen 27; “Menteri” ertinya Menteri yang dipertanggungjawabkan dengan tanggungjawab yang berhubungan dengan perkara pemerangkapan, penggunaan dan penyimpanan karbon; “pemerangkapan karbon” ertinya proses pemerangkapan karbon dioksida dengan menggunakan teknologi pemerangkapan karbon bagi maksud penggunaan atau penyimpanan kekal; “pengendali daratan” ertinya pemegang lesen penyimpanan daratan yang menjalankan pengendalian suatu tapak penyimpanan, mengawal tapak penyimpanan atau yang mengawal pengendalian suatu tapak penyimpanan, di kawasan daratan; Karbon “pengendali luar pesisir” ertinya pemegang suatu lesen penyimpanan luar pesisir yang menjalankan pengendalian suatu tapak penyimpanan, mengawal tapak penyimpanan atau yang mengawal pengendalian suatu tapak penyimpanan, di kawasan luar pesisir; “pengendalian suatu tapak penyimpanan” ertinya apa-apa aktiviti, fungsi, tugas atau perkara yang dijalankan atau yang perlu dijalankan untuk membangunkan infrastruktur bagi penyuntikan dan penyimpanan kekal karbon dioksida termasuk semua aktiviti sampingan, dan untuk mengendalikan tapak penyimpanan itu mengikut lesen penyimpanan di luar pesisir atau lesen penyimpanan daratan, menurut amalan pemerangkapan, penggunaan dan penyimpanan karbon yang berhemat; “penilaian geologi daratan” ertinya apa-apa penilaian teknikal seperti ujian pencirian tapak, kajian seismik, penggerudian dan ujian penyuntikan mana-mana kompleks penyimpanan yang berpotensi di kawasan daratan bagi tujuan penyimpanan daratan; “penilaian geologi luar pesisir” ertinya apa-apa penilaian teknikal seperti ujian pencirian tapak, kajian seismik, penggerudian dan ujian penyuntikan mana-mana kompleks penyimpanan yang berpotensi di kawasan luar pesisir bagi tujuan penyimpanan luar pesisir; “permit penilaian daratan” ertinya suatu permit yang dikeluarkan oleh Agensi di bawah seksyen 34; “permit penilaian luar pesisir” ertinya apa-apa permit yang dikeluarkan oleh Agensi di bawah seksyen 25; “penyimpanan daratan” ertinya mana-mana penyimpanan kekal karbon dioksida di mana-mana kawasan daratan; “penyimpanan kekal” ertinya pembendungan kekal suatu arus karbon dioksida dalam kompleks penyimpanan; “penyimpanan luar pesisir” ertinya mana-mana penyimpanan kekal karbon dioksida di mana-mana kawasan luar pesisir; “tapak penyimpanan” ertinya suatu kompleks penyimpanan, suatu bentukan geologi di antara kompleks penyimpanan dengan unjuran permukaan kompleks penyimpanan itu, dan apa-apa kemudahan dan struktur yang berkaitan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_I__cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_I__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud Akta ini, apa-apa sebutan berhubung dengan Malaysia, hendaklah termasuk zon ekonomi eksklusif dan pelantar benua Malaysia, sebagaimana yang ditakrifkan di bawah Akta Zon Ekonomi Eksklusif 1984 [Akta 311] dan Akta Pelantar Benua 1966 [Akta 83], mengikut mana-mana yang berkenaan. Amalan pemerangkapan, penggunaan dan penyimpanan karbon yang berhemat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_I__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_I__cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_I__cl_5__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_I__cl_5__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_I",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud Akta ini, apa-apa sebutan “amalan pemerangkapan, penggunaan dan penyimpanan karbon yang berhemat” hendaklah ditafsirkan sebagai apa-apa amalan, kaedah, langkah dan standard yang secara amnya diikuti oleh industri pemerangkapan, penggunaan dan penyimpanan karbon global semasa tempoh yang terpakai berhubung dengan aktiviti pemerangkapan, penggunaan dan penyimpanan karbon seperti, dan termasuklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_I__cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_I__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa kehendak sebagaimana yang ditetapkan oleh Menteri setelah berunding dengan entiti teknikal kompeten yang berkaitan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_I__cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_I__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa garis panduan yang dikeluarkan oleh entiti teknikal kompeten yang berkaitan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_I__cl_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_I__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa standard yang dikeluarkan oleh mana-mana badan yang diiktiraf di peringkat kebangsaan atau antarabangsa."
      }
    },
    {
