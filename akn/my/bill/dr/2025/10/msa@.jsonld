        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_VI__cl_28__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_VI__cl_28__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_VI__cl_28__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/10/msa@/~part_VI"
