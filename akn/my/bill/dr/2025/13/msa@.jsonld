        "@value": "RUU Pengurusan Sisa Pepejal dan Pembersihan Awam (Pindaan) 2025"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/13/msa@/~cl_1",
