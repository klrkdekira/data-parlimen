      "schema:text": {
        "@language": "ms",
        "@value": "Suatu Pihak Berkuasa Pengawalseliaan dan Penyeliaan yang disebut dalam Akta ini hendaklah terdiri daripada mana-mana badan yang berikut:"
      }
    },
