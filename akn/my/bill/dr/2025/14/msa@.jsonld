        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_5__para_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_5__para_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "[Seksyen 79] KETIDAKPAKAIAN KEHENDAK PELESENAN DAN PENDAFTARAN DI BAWAH AKTA INI"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_5__para_1",
      "@type": "akn:paragraph",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Bank berlesen dan penanggung insurans berlesen sebagaimana yang ditakrifkan di bawah subseksyen 2(1) Akta Perkhidmatan Kewangan 2013."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_5__para_2",
      "@type": "akn:paragraph",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Bank Islam berlesen dan pengendali takaful berlesen sebagaimana yang ditakrifkan di bawah subseksyen 2(1) Akta Perkhidmatan Kewangan Islam 2013."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_5__para_3",
      "@type": "akn:paragraph",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Institusi yang ditetapkan sebagaimana yang ditakrifkan di bawah subseksyen 3(1) Akta Institusi Kewangan Pembangunan 2002."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_5__para_4",
      "@type": "akn:paragraph",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengeluar instrumen pembayaran yang ditetapkan iaitu kad kredit dan kad caj yang diluluskan sebagaimana yang ditakrifkan di bawah subseksyen 2(1) Akta Perkhidmatan Kewangan 2013."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_5__para_5",
      "@type": "akn:paragraph",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengeluar instrumen pembayaran Islam yang ditetapkan iaitu kad kredit-i dan kad caj-i yang diluluskan sebagaimana yang ditakrifkan di bawah subseksyen 2(1) Akta Perkhidmatan Kewangan Islam 2013."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_5__para_6",
      "@type": "akn:paragraph",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Pemegang lesen sebagaimana yang ditakrifkan di bawah seksyen 2 Akta Perniagaan Perkhidmatan Wang 2011 [Akta 731]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_5__para_7",
      "@type": "akn:paragraph",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Koperasi yang berdaftar di bawah subseksyen 7(1) Akta Koperasi 1993."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_6",
      "@type": "akn:schedule",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_6__para_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_6__para_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_6__para_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_6__para_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "[Subsekyen 87(1)] SENARAI PELAKUAN PERNIAGAAN DILARANG"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_6__para_1",
      "@type": "akn:paragraph",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Melibatkan diri dalam pelakuan yang mengelirukan atau memperdayakan, atau yang mungkin mengelirukan atau memperdayakan berhubung dengan keadaan, ciri, terma atau harga apa-apa produk atau perkhidmatan kredit yang ditawarkan atau diberikan oleh mana-mana orang kepada seorang pengguna kredit di bawah apa-apa perniagaan yang berhubungan dengan pemberian kredit atau perkhidmatan kredit, mengikut mana-mana yang berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_6__para_2",
      "@type": "akn:paragraph",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_6__para_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_6__para_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_6__para_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Mendorong atau cuba untuk mendorong seorang pengguna kredit, termasuk melalui suatu iklan, untuk melakukan suatu perbuatan atau meninggalkan daripada melakukan suatu perbuatan berhubung dengan apa-apa produk atau perkhidmatan kredit yang ditawarkan atau diberikan oleh mana-mana orang di bawah apa-apa perniagaan yang berhubungan dengan pemberian kredit atau perkhidmatan kredit, mengikut mana-mana yang berkenaan, dengan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_6__para_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_6__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat suatu penyataan, misalan, janji, ramalan atau perbandingan yang mengelirukan, palsu atau memperdayakan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_6__para_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_6__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "secara tidak jujur menyembunyikan, meninggalkan atau memberikan fakta material dengan cara yang tidak jelas; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_6__para_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_6__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "secara melulu membuat apa-apa pernyataan, misalan, janji, ramalan atau perbandingan yang mengelirukan, palsu atau memperdayakan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_6__para_3",
      "@type": "akn:paragraph",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_6__para_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_6__para_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Menggunakan tekanan tidak wajar, pengaruh atau menggunakan atau mengugut untuk mengguna gangguan, paksaan atau kekerasan fizikal berhubung dengan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_6__para_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_6__para_3",
      "schema:text": {
        "@language": "ms",
        "@value": "penawaran atau pemberian kepada seorang pengguna kredit atau pihak ketiga yang berkaitan dengan pengguna kredit itu, apa-apa produk atau perkhidmatan kredit; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_6__para_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_6__para_3",
      "schema:text": {
        "@language": "ms",
        "@value": "pembayaran oleh seorang pengguna kredit atau pihak ketiga yang berkaitan dengan pengguna kredit itu bagi apa-apa produk atau perkhidmatan kredit yang ditawarkan atau diberikan, oleh mana-mana orang di bawah apa-apa perniagaan yang berhubungan dengan pemberian kredit atau perkhidmatan kredit, mengikut mana-mana yang berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_6__para_4",
      "@type": "akn:paragraph",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Menuntut bayaran daripada seorang pengguna kredit dengan apa-apa cara bagi produk atau perkhidmatan kredit yang tidak diminta mana-mana orang di bawah apa-apa perniagaan yang berhubungan dengan pemberian kredit atau perkhidmatan kredit, mengikut mana-mana yang berkenaan, termasuk mengancam untuk membawa prosiding undang-undang."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_7",
      "@type": "akn:schedule",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "[Perenggan 106(3)(b)] SENARAI PERUNTUKAN YANG DIKECUALIKAN DARIPADA PENALTI MONETARI Suatu penalti monetari tidak boleh dikenakan berkenaan dengan suatu kemungkiran dengan peruntukan yang berikut: (a) subseksyen 40(1) (b) subseksyen 57(1) (c) subseksyen 87(1) (d) subseksyen 110(9)"
      }
    }
  ]
}
