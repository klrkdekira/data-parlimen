    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu pemberi perkhidmatan kredit berdaftar, atas perbelanjaannya sendiri, hendaklah melantik secara tahunan seorang juruaudit bagi menjalankan suatu pengauditan ke atas perniagaan perkhidmatan kreditnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya boleh dalam apa-apa tempoh sebagaimana yang ditentukan oleh Suruhanjaya, menghendaki seseorang juruaudit yang dilantik di bawah subseksyen (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "supaya memperbesar atau memperluas ruang lingkup pengauditan yang dijalankan di bawah subseksyen (1);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "supaya menjalankan suatu pemeriksaan atau mengadakan apa-apa tatacara dalam apa-apa hal tertentu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66__subsec_2__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66__subsec_2__para_c__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "supaya mengemukakan kepada Suruhanjaya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66__subsec_2__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66__subsec_2__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa maklumat sebagaimana yang dikehendaki oleh Suruhanjaya berhubung dengan pengauditan yang dijalankan oleh juruaudit; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66__subsec_2__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66__subsec_2__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu laporan tentang apa-apa perkara dalam perenggan (a) dan (b)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66__subsec_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66__subsec_3__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud subperenggan (2)(c)(i), maklumat yang dikehendaki berhubung dengan pengauditan boleh termasuk yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "penyata kewangan perniagaan perkhidmatan kredit itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "amaun transaksi yang berhubungan dengan perniagaan perkhidmatan kredit itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu laporan tentang sama ada rekod yang sepatutnya bagi transaksi berhubung dengan perniagaan perkhidmatan kredit itu telah disenggarakan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66__subsec_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu laporan tentang sama ada pemberi perkhidmatan kredit berdaftar itu telah mematuhi peruntukan Akta ini dan mana-mana undang-undang bertulis yang lain sebagaimana yang ditentukan oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66",
      "schema:text": {
        "@language": "ms",
        "@value": "Pemberi perkhidmatan kredit berdaftar itu hendaklah mengemukakan suatu salinan laporan audit yang telah ditandatangani dengan sempurna oleh juruaudit itu kepada Suruhanjaya tidak lewat daripada tiga bulan atau apa-apa tempoh lain, selepas berakhirnya tahun kewangan pemberi perkhidmatan kredit berdaftar itu sebagaimana yang ditentukan oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika semasa melaksanakan kewajipannya di bawah seksyen ini, seorang juruaudit yang dilantik di bawah subseksyen (1) mengesyaki atau mempunyai pengetahuan bahawa pemberi perkhidmatan kredit berdaftar itu telah melakukan apa-apa kesalahan di bawah Akta ini atau mana-mana undang-undang bertulis yang lain—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "juruaudit itu hendaklah dengan serta-merta melaporkan perkara itu kepada Suruhanjaya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66__subsec_5__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66__subsec_5__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "juruaudit itu tidaklah bertanggungan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66__subsec_5__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66__subsec_5__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi suatu kemungkiran suatu kewajipan kerahsiaan antara juruaudit dan pemberi itu berkenaan dengan apa-apa pelaporan kepada Suruhanjaya yang dibuat dengan suci hati di bawah Akta ini; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66__subsec_5__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66__subsec_5__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk dibawa guaman dalam mana-mana mahkamah bagi fitnah berkenaan dengan apa-apa penyataan yang dibuat oleh juruaudit itu tanpa niat jahat dalam penunaian kewajipannya di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66",
      "schema:text": {
        "@language": "ms",
        "@value": "Saraan dan perbelanjaan juruaudit itu berhubungan dengan apa-apa perkhidmatan di bawah seksyen ini hendaklah ditanggung oleh pemberi perkhidmatan kredit berdaftar itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini, “penyata kewangan” termasuklah kunci kira-kira tahunan terkini yang telah diaudit, akaun untung dan rugi, dan penyata yang menyatakan sumber dana, suatu pemberi perkhidmatan kredit berdaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu pemberi perkhidmatan kredit berdaftar yang melanggar subseksyen (1) atau (4) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tiga tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66",
      "schema:text": {
        "@language": "ms",
        "@value": "Seorang juruaudit yang melanggar subseksyen (2) atau perenggan (5)(a) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tiga tahun atau kedua-duanya. Pembatalan atau penggantungan pendaftaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_67",
      "@type": "akn:clause",
      "eli:number": "67",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_67__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_67__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_67__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_67__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_67",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu pemberi perkhidmatan kredit yang berdaftar di bawah seksyen 59 hendaklah disifatkan sebagai terbatal pendaftarannya jika perniagaan perkhidmatan kreditnya telah digulungkan atau selainnya dibubarkan, sama ada di dalam atau di luar Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_67__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_67__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_67__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_67__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_67",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada seksyen 131, Suruhanjaya boleh membatalkan pendaftaran suatu pemberi perkhidmatan kredit atas mana-mana alasan yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_67__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_67__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya, berkaitan dengan permohonan di bawah seksyen 58, telah diberikan maklumat yang palsu atau mengelirukan, tidak tepat atau tidak lengkap yang daripadanya terdapat suatu ketinggalan yang material;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_67__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_67__subsec_2__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_67__subsec_2__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_67__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pemberi perkhidmatan kredit berdaftar itu tidak atau telah tidak mematuhi—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_67__subsec_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_67__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "mana–mana peruntukan Akta ini atau mana-mana kehendak lain sebagaimana yang ditetapkan atau ditentukan oleh Suruhanjaya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_67__subsec_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_67__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "mana–mana syarat yang berkenaan dengan pendaftarannya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_67__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_67__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "ia adalah demi kepentingan pengguna kredit atau awam untuk berbuat sedemikian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_67__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_67__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_67__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_67",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika subseksyen (2) terpakai, Suruhanjaya boleh, jika ia berpendapat perlu untuk berbuat sedemikian—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_67__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_67__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "menggantung pendaftaran itu bagi suatu tempoh tertentu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_67__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_67__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "pada bila-bila masa melanjutkan atau membatalkan penggantungan pendaftaran itu. Pembatalan pendaftaran secara sukarela"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_68",
      "@type": "akn:clause",
      "eli:number": "68",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_68__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_68__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_68__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_68__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_68",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu pemberi perkhidmatan kredit berdaftar boleh memohon untuk pendaftarannya dibatalkan secara sukarela dalam bentuk dan mengikut cara sebagaimana yang ditentukan oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_68__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_68",
      "schema:text": {
        "@language": "ms",
        "@value": "Pembatalan pendaftaran di bawah subseksyen (1) hendaklah berkuat kuasa setelah mendapat suatu kelulusan secara bertulis oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_68__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_68",
      "schema:text": {
        "@language": "ms",
        "@value": "Setelah pembatalan pendaftaran di bawah seksyen ini, tiada bayaran balik bagi apa-apa fi yang telah dibayar oleh pemberi perkhidmatan kredit berdaftar itu. Kesan pembatalan pendaftaran, penggantungan, dan pembatalan pendaftaran secara sukarela"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_69",
      "@type": "akn:clause",
      "eli:number": "69",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_69__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_69__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_69__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_69__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_69__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_69__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_69__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_69",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang hendaklah dengan serta merta terhenti menjalankan perniagaan perkhidmatan kreditnya jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_69__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_69__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya menggantung suatu pendaftaran atau membatalkan pendaftaran suatu pemberi perkhidmatan kredit berdaftar di bawah seksyen 67; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_69__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_69__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pembatalan pendaftaran telah berkuat kuasa di bawah subseksyen 68(2)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_69__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_69__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_69__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_69",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (1), orang yang disebutkan dalam subseksyen (1) hendaklah terus—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_69__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_69__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "tertakluk kepada Akta ini pada takat yang sama sebagaimana suatu pemberi perkhidmatan kredit berdaftar; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_69__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_69__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menunaikan obligasinya termasuk, tertakluk kepada kelulusan bertulis terdahulu Suruhanjaya untuk menjalankan perniagaan perkhidmatan kreditnya semata-mata bagi maksud penggulungan hal ehwalnya atau bagi maksud yang benefisial untuk pengguna kreditnya atau orang lain yang berurusan dengannya, sehingga Suruhanjaya berpuas hati bahawa orang itu telah menunaikan obligasinya, atau bahawa perkiraan yang mencukupi telah dibuat untuk menunaikan obligasinya, yang belum selesai pada masa pembatalan pendaftaran, penggantungan atau pembatalan pendaftaran secara sukarela."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_69__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_69__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_69__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_69",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu pembatalan pendaftaran, penggantungan atau pembatalan pendaftaran secara sukarela yang disebutkan dalam subseksyen (1) tidak—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_69__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_69__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "mengelak atau menjejaskan mana-mana perjanjian, perkiraan atau transaksi yang dibuat oleh orang yang disebutkan dalam subseksyen (1) dengan mana-mana orang; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_69__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_69__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "menjejaskan apa-apa hak, obligasi atau liabiliti yang berbangkit di bawah mana-mana perjanjian, perkiraan atau transaksi itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_69__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_69",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1) atau tidak mematuhi obligasinya di bawah subseksyen (2) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima juta ringgit atau dipenjarakan selama tempoh tidak melebihi lima tahun atau kedua-duanya. Fi yang kena dibayar pemberi perkhidmatan kredit berdaftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_70",
      "@type": "akn:clause",
      "eli:number": "70",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_70__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_70__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_70__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_70__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_70",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu pemberi perkhidmatan kredit berdaftar hendaklah membayar fi sebagaimana yang ditetapkan oleh Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_70__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_70",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu pemberi perkhidmatan kredit berdaftar tidak membayar fi yang ditetapkan di bawah subseksyen (1) pada tarikh fi itu perlu dibayar kepada Suruhanjaya, bagi setiap bulan pembayaran itu lewat, pemberi perkhidmatan kredit berdaftar itu hendaklah membayar suatu fi pembayaran lewat dalam suatu jumlah sebagaimana yang ditetapkan oleh Menteri dan fi itu boleh didapatkan kembali oleh Suruhanjaya sebagai suatu hutang sivil kena dibayar kepada Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_70__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_70",
      "schema:text": {
        "@language": "ms",
        "@value": "Fi yang ditetapkan yang dibayar kepada, atau didapatkan kembali oleh Suruhanjaya di bawah seksyen ini hendaklah dibayar ke dalam dan menjadi sebahagian Kumpulan Wang yang ditubuhkan di bawah seksyen 26. Penubuhan, penempatan semula atau penutupan cawangan, dsb., pemberi perkhidmatan kredit berdaftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_71",
      "@type": "akn:clause",
      "eli:number": "71",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu pemberi perkhidmatan kredit berdaftar hendaklah mematuhi kehendak penubuhan, penempatan semula atau penutupan cawangannya sebagaimana yang ditentukan oleh Suruhanjaya. Pemindahan atau penyerahhakan pendaftaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_72",
      "@type": "akn:clause",
      "eli:number": "72",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_72__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_72__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_72__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_72__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_72__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_72",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu pemberi perkhidmatan kredit berdaftar tidak boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_72__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_72__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "memindah atau menyerahhak pendaftarannya kepada mana-mana orang lain; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_72__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_72__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menyebabkan atau membenarkan mana-mana orang lain untuk menggunakan pendaftarannya untuk menjalankan perniagaan perkhidmatan kredit yang ditentukan dalam pendaftaran itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_72__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_72",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi satu juta ringgit atau dipenjarakan selama tempoh tidak melebihi empat tahun atau kedua-duanya. Jualan, pelupusan, pajakan, dsb., perniagaan perkhidmatan kredit"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_73",
      "@type": "akn:clause",
      "eli:number": "73",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_73__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_73__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_73__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_73__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_73__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_73",
      "schema:text": {
        "@language": "ms",
        "@value": "Kecuali dengan kelulusan bertulis terdahulu Suruhanjaya, tiada suatu pemberi perkhidmatan kredit berdaftar boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_73__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_73__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menjual, melupus, memajak, menyerahhak atau memindah bagaimana jua cara sekalipun, keseluruhan atau mana-mana bahagian perniagaan perkhidmatan kreditnya kepada mana-mana orang lain; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_73__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_73__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menyatu atau mencantum perniagaan perkhidmatan kreditnya dengan mana-mana orang lain."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_73__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_73",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu pemberi perkhidmatan kredit berdaftar yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi satu juta ringgit atau dipenjarakan selama tempoh tidak melebihi empat tahun atau kedua-duanya. Penggal 3 Perkara am Permohonan oleh orang yang terkilan untuk kajian semula atas keputusan di bawah Bahagian ini"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_74",
      "@type": "akn:clause",
      "eli:number": "74",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_74__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_74__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_74__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_74__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_74__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_74__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_74__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_74",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya boleh mengkaji semula keputusannya sendiri di bawah Bahagian ini apabila dibuat atas permohonan oleh mana-mana orang yang terkilan dengan keputusan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_74__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_74",
      "schema:text": {
        "@language": "ms",
        "@value": "Permohonan yang disebut dalam subseksyen (1) hendaklah dibuat secara bertulis dalam masa empat belas hari selepas orang yang terkilan itu diberitahu tentang keputusan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_74__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_74",
      "schema:text": {
        "@language": "ms",
        "@value": "Kajian semula oleh Suruhanjaya di bawah subseksyen (1) tidak boleh termasuk orang yang mengambil bahagian dalam pertimbangtelitian keputusan terdahulu itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_74__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_74",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu permohonan untuk kajian semula dibuat di bawah seksyen ini, keputusan Suruhanjaya di bawah Bahagian ini tidak boleh berkuat kuasa sehingga kajian semula itu diselesaikan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_74__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_74",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (4), Suruhanjaya boleh menyatakan dalam pemberitahuan di bawah subseksyen (2) bahawa keputusan Suruhanjaya hendaklah berkuat kuasa serta-merta pada tarikh pemberitahuan itu dikeluarkan atau pada mana-mana tarikh lain yang ditentukan oleh Suruhanjaya, jika Suruhanjaya berpendapat bahawa ia perlu untuk kepentingan awam."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_74__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_74",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu keputusan Suruhanjaya di bawah subseksyen (1) adalah muktamad. Rayuan kepada Menteri Perumahan dan Kerajaan Tempatan atas keputusan di bawah Bahagian ini"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_75",
      "@type": "akn:clause",
      "eli:number": "75",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_75__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_75__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_75__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_75__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_75__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_75",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang terkilan dengan keputusan Pendaftar di bawah Bahagian ini boleh, dalam masa empat belas hari selepas orang itu telah diberitahu mengenai keputusan itu, memohon secara bertulis kepada Menteri Perumahan dan Kerajaan Tempatan untuk suatu rayuan terhadap keputusan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_75__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_75",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu permohonan bagi suatu rayuan dibuat di bawah subseksyen (1), keputusan Pendaftar di bawah Bahagian ini tidak boleh berkuat kuasa sehingga rayuan itu diselesaikan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_75__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_75",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (2), Pendaftar boleh menyatakan dalam pemberitahuan di bawah subseksyen (1) bahawa keputusan Pendaftar hendaklah berkuat kuasa serta-merta pada tarikh pemberitahuan itu dikeluarkan atau pada mana-mana tarikh lain yang ditentukan oleh Pendaftar, jika Pendaftar berpendapat bahawa ia perlu untuk kepentingan awam."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_75__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_75",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa keputusan Menteri Perumahan dan Kerajaan Tempatan di bawah subseksyen (1) adalah muktamad. Penyiaran nama pemberi kredit berlesen dan pemberi perkhidmatan kredit berdaftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_76",
      "@type": "akn:clause",
      "eli:number": "76",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya hendaklah, dengan seberapa segera yang praktik, menyiarkan suatu senarai semua pemberi kredit berlesen dan pemberi perkhidmatan kredit berdaftar yang dikawal selia oleh Suruhanjaya dalam apa-apa bentuk dan mengikut cara yang ditentukan oleh Suruhanjaya. Perjanjian dengan pemberi kredit tidak berlesen tidak boleh dikuatkuasakan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_77",
      "@type": "akn:clause",
      "eli:number": "77",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada perjanjian yang di bawahnya kredit diberikan dan yang berupa sebagai suatu perjanjian kredit dibuat antara seorang pengguna kredit dan suatu pemberi kredit tidak berlesen boleh dikuatkuasakan. Anggapan mengenai perniagaan memberi kredit atau perkhidmatan kredit"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_78",
      "@type": "akn:clause",
      "eli:number": "78",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_78__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_78__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_78__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_78",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika dalam mana-mana prosiding mahkamah terhadap mana-mana orang, dikatakan bahawa orang itu adalah suatu pemberi kredit, bukti suatu transaksi kredit tunggal yang dibuat oleh orang itu hendaklah menimbulkan suatu anggapan bahawa orang itu menjalankan perniagaan memberi kredit kepada seorang pengguna kredit sehingga yang bertentangan dibuktikan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_78__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_78",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika dalam mana-mana prosiding mahkamah terhadap mana-mana orang, dikatakan bahawa orang itu adalah suatu pemberi perkhidmatan kredit, bukti suatu perkhidmatan tunggal yang diberi oleh orang itu yang berhubungan dengan kredit hendaklah menimbulkan suatu anggapan bahawa orang itu menjalankan perniagaan memberi perkhidmatan kredit melibatkan seorang pengguna kredit sehingga yang bertentangan dibuktikan. Ketidakpakaian Bahagian V"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_79",
      "@type": "akn:clause",
      "eli:number": "79",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_79__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_79__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_79__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_79__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_79__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_79__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_79",
      "schema:text": {
        "@language": "ms",
        "@value": "Bahagian V tidak terpakai bagi—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_79__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_79__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang sebagaimana yang dinyatakan dalam Jadual 5; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_79__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_79__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang yang menjalankan suatu perniagaan kredit atau perniagaan perkhidmatan kredit di bawah Akta Sewa Beli 1967, Akta Perlindungan Pengguna 1999, Akta Pemberi Pinjam Wang 1951 dan Akta Pemegang Pajak Gadai 1972, melainkan jika orang itu berniat untuk menjalankan mana-mana perniagaan kredit atau perniagaan perkhidmatan kredit sebagaimana yang dinyatakan dalam Jadual 4."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_79__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_79",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seseorang menjalankan suatu perniagaan kredit atau perniagaan perkhidmatan kredit sebagaimana yang dinyatakan dalam perenggan 1 atau perenggan 3 Jadual 4 yang tidak melibatkan seorang pengguna kredit, orang itu hendaklah mengemukakan suatu pengisytiharan kepada Suruhanjaya tentang hakikat itu, dalam apa-apa bentuk dan mengikut cara sebagaimana yang ditentukan oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_79__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_79",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang disebut di dalam subseksyen (2) hendaklah mengemukakan pengisytiharan tersebut kepada Suruhanjaya berserta dengan apa-apa dokumen atau maklumat sebagaimana yang ditentukan oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_X",
      "@type": "akn:part",
      "eli:number": "X",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_X__cl_121",
