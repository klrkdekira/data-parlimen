      "schema:text": {
        "@language": "ms",
        "@value": "JAWATANKUASA PENASIHAT Penubuhan Jawatankuasa Penasihat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IV__cl_36",
