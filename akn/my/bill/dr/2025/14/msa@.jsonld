        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_117",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_118",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_119",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_120"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "PENGUATKUASAAN Penggal 1 Tindakan pentadbiran Kuasa Pihak Berkuasa Pengawalseliaan dan Penyeliaan untuk mengambil tindakan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106",
      "@type": "akn:clause",
      "eli:number": "106",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_10"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang telah melakukan suatu kemungkiran di bawah Akta ini jika orang itu tidak mematuhi atau memberi kesan kepada—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_10",
      "@type": "akn:subsection",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada apa pun dalam seksyen ini boleh menghalang Pihak Berkuasa Pengawalseliaan dan Penyeliaan daripada mengambil apa-apa tindakan yang ia diberi kuasa untuk mengambil di bawah Akta ini terhadap seseorang yang mungkir. Permohonan bagi kajian semula atau rayuan keputusan di bawah perenggan 106(3)(b)"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana peruntukan Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana peraturan-peraturan yang dibuat di bawah Akta ini; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana perintah, arahan, standard atau garis panduan, syarat, sekatan, penentuan atau kehendak di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu Pihak Berkuasa Pengawalseliaan dan Penyeliaan hendaklah mengambil kira perkara yang berikut dalam menentukan tindakan sewajarnya yang akan diambil dalam setiap hal:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "keberkesanan tindakan yang akan diambil di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "perkadaran tindakan yang akan diambil dengan kemungkiran yang dilakukan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pencegahan kemungkiran masa hadapan yang serupa keadaannya oleh orang lain; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa perkara lain yang dipertimbangkan sebagai berkaitan pada pendapat Pihak Berkuasa Pengawalseliaan dan Penyeliaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_3__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_3__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika pada pendapat Pihak Berkuasa Pengawalseliaan dan Penyeliaan bahawa seseorang itu telah melakukan suatu kemungkiran dan adalah wajar untuk mengambil tindakan terhadap orang itu, Pihak Berkuasa Pengawalseliaan dan Penyeliaan boleh, tertakluk kepada seksyen 131, mengambil mana-mana satu atau lebih daripada tindakan yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_3__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_3__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat suatu perintah secara bertulis menghendaki orang yang mungkir—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_3__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_3__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mematuhi atau memberi kesan kepada; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_3__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_3__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk melakukan atau tidak melakukan apa-apa perbuatan untuk memastikan pematuhan dengan, mana-mana peruntukan, peraturan-peraturan, perintah, arahan, standard atau garis panduan, syarat, sekatan, penentuan atau kehendak yang disebut dalam subseksyen (1);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "kecuali bagi suatu kemungkiran mana-mana peruntukan yang dinyatakan dalam Jadual 7, mengenakan suatu penalti monetari dalam apa-apa amaun sebagaimana yang Pihak Berkuasa Pengawalseliaan dan Penyeliaan berpendapat patut, tetapi dalam apa-apa keadaan tidak melebihi lima ratus ribu ringgit;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "mencela secara bertulis orang yang mungkir atau menghendaki orang yang mungkir itu untuk mengeluarkan suatu kenyataan umum berhubung dengan kemungkiran itu, jika pada pendapat Pihak Berkuasa Pengawalseliaan dan Penyeliaan bahawa kemungkiran itu berkaitan bagi maklumat orang awam;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_3__para_d__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_3__para_d__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat suatu perintah secara bertulis menghendaki—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_3__para_d__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_3__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "orang yang mungkir itu mengambil apa-apa langkah sebagaimana yang diarahkan oleh Pihak Berkuasa Pengawalseliaan dan Penyeliaan untuk mengurangkan kesan kemungkiran itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_3__para_d__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_3__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu pemberi kredit atau pemberi perkhidmatan kredit untuk meremedi kemungkiran itu termasuk membuat restitusi kepada mana-mana orang lain yang terkilan dengan kemungkiran itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_3__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat suatu perintah secara bertulis untuk memecat orang yang mungkir itu daripada jawatan atau bahawa orang yang mungkir itu dihalang daripada menjadi seorang ketua eksekutif, pengarah, pekongsi atau menyertai secara langsung atau tidak langsung dalam pengurusan suatu pemberi kredit atau pemberi perkhidmatan kredit, bagi suatu tempoh masa sebagaimana yang ditentukan oleh Pihak Berkuasa Pengawalseliaan dan Penyeliaan yang hendaklah tidak melebihi suatu tempoh lima tahun."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu kemungkiran dilakukan oleh suatu pertubuhan perbadanan atau yang tidak diperbadankan, mana-mana tindakan di bawah subseksyen (3) boleh diambil terhadap—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang yang merupakan pengarahnya, pengawalnya, pegawainya atau pekongsinya, atau pernah berupa untuk bertindak dalam mana-mana keupayaan sedemikian; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang yang berkenaan dalam pengurusan hal ehwalnya, pada masa kemungkiran itu melainkan jika orang itu menunjukkan bahawa kemungkiran itu telah dilakukan tanpa keizinannya atau dibiarkan olehnya dan dia telah melaksanakan segala usaha untuk mencegah kemungkiran itu sebagaimana yang patut dilaksanakan olehnya, dengan mengambil kira keadaan fungsinya dalam keupayaan itu dan kepada hal keadaan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106",
      "schema:text": {
        "@language": "ms",
        "@value": "Tindakan di bawah subseksyen (3) boleh diambil terhadap pertubuhan perbadanan atau yang tidak diperbadankan itu jika suatu kemungkiran dilakukan oleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang yang merupakan seorang pengarah, pengawal, pegawai atau pekongsi pertubuhan perbadanan atau yang tidak diperbadankan itu, atau berupa untuk bertindak dalam apa-apa keupayaan sedemikian itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang yang berkenaan dalam pengurusan hal ehwal pertubuhan perbadanan atau yang tidak diperbadankan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_6__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud subperenggan (3)(d)(ii), dalam menentukan sama ada atau tidak apa-apa amaun perlu dibayar oleh pemberi kredit atau pemberi perkhidmatan kredit itu, mengikut mana-mana yang berkenaan, Pihak Berkuasa Pengawalseliaan dan Penyeliaan hendaklah mengambil kira—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "sama ada atau tidak satu atau lebih orang telah mengalami kehilangan atau terjejas selainnya berbangkit daripada kemungkiran itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "keuntungan yang terakru kepada orang yang mungkir itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_7__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_7__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa penalti monetari yang dibayar oleh seseorang mengikut perenggan (3)(b) hendaklah dibayar ke dalam dan menjadi sebahagian—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_7",
      "schema:text": {
        "@language": "ms",
        "@value": "kumpulan wang operasi Suruhanjaya Koperasi Malaysia jika penalti monetari itu dikenakan oleh Suruhanjaya Koperasi Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Kumpulan Wang yang ditubuhkan di bawah seksyen 26 jika penalti monetari itu dikenakan oleh Suruhanjaya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_7__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Kumpulan Wang Disatukan Persekutuan jika penalti monetari itu dikenakan oleh Pihak Berkuasa Pengawalseliaan dan Penyeliaan yang lain."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_8__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_8__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_8__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seseorang itu tidak membayar suatu penalti monetari yang dikenakan menurut perenggan (3)(b) dalam tempoh yang ditentukan oleh Pihak Berkuasa Pengawalseliaan dan Penyeliaan maka—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_8",
      "schema:text": {
        "@language": "ms",
        "@value": "penalti yang dikenakan boleh diambil tindakan guaman dan didapatkan kembali oleh Suruhanjaya Koperasi Malaysia sebagai suatu hutang sivil yang kena dibayar kepada Suruhanjaya Koperasi Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_8",
      "schema:text": {
        "@language": "ms",
        "@value": "penalti yang dikenakan boleh diambil tindakan guaman dan didapatkan kembali oleh Suruhanjaya sebagai suatu hutang sivil yang kena dibayar kepada Suruhanjaya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_8__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_8",
      "schema:text": {
        "@language": "ms",
        "@value": "penalti yang dikenakan oleh Pihak Berkuasa Pengawalseliaan dan Penyeliaan yang lain boleh diambil tindakan guaman dan didapatkan kembali oleh Kerajaan sebagai suatu hutang sivil yang kena dibayar kepada Kerajaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seseorang tidak meremedi kemungkiran itu termasuk membuat restitusi kepada orang lain yang terkilan disebabkan kemungkiran itu di bawah perenggan (3)(d), walau apa pun apa-apa undang-undang bertulis lain, Pihak Berkuasa Pengawalseliaan dan Penyeliaan itu boleh membawa guaman dan mendapatkan kembali amaun itu sebagai suatu hutang sivil yang kena dibayar kepada orang yang terkilan oleh kemungkiran itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_107",
      "@type": "akn:clause",
      "eli:number": "107",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_107__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_107__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_107__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_107__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_107__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_107__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_107",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang terkilan oleh keputusan suatu Pihak Berkuasa Pengawalseliaan dan Penyeliaan di bawah perenggan 106(3)(b) boleh dalam masa tiga puluh hari selepas orang yang terkilan itu diberitahu keputusan itu, memohon secara bertulis kepada—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_107__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_107__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal suatu keputusan dibuat oleh Pihak Berkuasa Pengawalseliaan dan Penyeliaan yang merupakan Suruhanjaya, Bank Negara Malaysia atau Suruhanjaya Sekuriti Malaysia, mengikut mana-mana yang berkenaan, Pihak Berkuasa Pengawalseliaan dan Penyeliaan masing-masing untuk mengkaji semula keputusannya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_107__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_107__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal suatu keputusan yang dibuat oleh Pihak Berkuasa Pengawalseliaan dan Penyeliaan Suruhanjaya yang merupakan Suruhanjaya Koperasi Malaysia, Kementerian Perumahan dan Kerajaan Tempatan atau Kementerian Perdagangan Dalam Negeri dan Kos Sara Hidup, mengikut mana-mana yang berkenaan, Menteri yang dipertanggungkan ke atas Pihak Berkuasa Pengawalseliaan dan Penyeliaan itu bagi suatu rayuan terhadap keputusan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_107__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_107",
      "schema:text": {
        "@language": "ms",
        "@value": "Kajian semula yang disebut di bawah perenggan (1)(a) tidak boleh termasuk orang yang telah mengambil bahagian dalam pertimbangtelitian keputusan terdahulu itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_107__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_107",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu keputusan Pihak Berkuasa Pengawalseliaan dan Penyeliaan atau Menteri, mengikut mana-mana yang berkenaan, di bawah subseksyen (1) adalah muktamad. Menyerah simpan amaun yang tidak diagihkan dengan Pendaftar Wang Tak Dituntut"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_108",
      "@type": "akn:clause",
      "eli:number": "108",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX",
      "schema:text": {
        "@language": "ms",
        "@value": "Setakat apa-apa amaun yang dibayar di bawah subperenggan 106(3)(d)(ii) atau subseksyen 106(9) yang tidak dapat diagihkan oleh suatu pemberi kredit atau pemberi perkhidmatan kredit, mengikut mana-mana yang berkenaan, selepas usaha yang munasabah untuk memberitahu orang yang terkilan gagal oleh sebab kesulitan mengenal pasti atau memberitahu orang yang terkilan, pemberi kredit atau pemberi perkhidmatan kredit itu hendaklah menyerah simpan amaun itu dengan Pendaftar Wang Tak Dituntut mengikut peruntukan Akta Wang Tak Dituntut 1965 [Akta 370]. Penggal 2 Tindakan penguatkuasaan sivil Tindakan penguatkuasaan sivil oleh Pihak Berkuasa Pengawalseliaan dan Penyeliaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_109",
      "@type": "akn:clause",
      "eli:number": "109",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_109__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_109__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_109__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_109__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_109__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_109__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_109__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_109",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu Pihak Berkuasa Pengawalseliaan dan Penyeliaan mendapati bahawa terdapat suatu kebarangkalian munasabah bahawa mana-mana orang akan melanggar atau telah melanggar atau akan mungkir atau telah memungkiri atau berkemungkinan tidak mematuhi atau telah tidak mematuhi—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_109__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_109__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana peruntukan Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_109__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_109__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana peraturan-peraturan yang dibuat di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_109__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_109__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana perintah, arahan, standard atau garis panduan, syarat, sekatan, penentuan atau kehendak di bawah Akta ini; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_109__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_109__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa tindakan yang diambil oleh Pihak Berkuasa Pengawalseliaan dan Penyeliaan di bawah seksyen 106, Pihak Berkuasa Pengawalseliaan dan Penyeliaan boleh memulakan prosiding sivil di mahkamah memohon apa-apa perintah yang ditentukan di bawah subseksyen 110(1) terhadap orang itu sama ada atau tidak orang itu telah dituduh dengan suatu kesalahan berkenaan dengan pelanggaran atau kemungkiran itu atau sama ada atau tidak suatu pelanggaran atau kemungkiran telah dibuktikan dalam suatu pendakwaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_109__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_109__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_109__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_109",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_109__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_109__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Pihak Berkuasa Pengawalseliaan dan Penyeliaan tidak termasuk Kementerian Perdagangan Dalam Negeri dan Kos Sara Hidup; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_109__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_109__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "prosiding sivil yang dimulakan oleh Kementerian Perumahan dan Kerajaan Tempatan hendaklah di atas nama Kerajaan. Perintah oleh mahkamah"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110",
      "@type": "akn:clause",
      "eli:number": "110",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_11",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_12",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_13",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_14"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110",
      "schema:text": {
        "@language": "ms",
        "@value": "Mahkamah boleh, atas suatu permohonan oleh suatu Pihak Berkuasa Pengawalseliaan dan Penyeliaan di bawah seksyen 109, membuat satu atau lebih perintah yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_10",
      "@type": "akn:subsection",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen (9) tidak menjejaskan kuasa mahkamah berhubung dengan hukuman menghina mahkamah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_11",
      "@type": "akn:subsection",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110",
      "schema:text": {
        "@language": "ms",
        "@value": "Mahkamah boleh membatalkan atau mengubah suatu perintah yang dibuat olehnya di bawah seksyen ini atau menggantung kuat kuasa perintah itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_12",
      "@type": "akn:subsection",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110",
      "schema:text": {
        "@language": "ms",
        "@value": "Kuasa yang diberikan kepada mahkamah di bawah seksyen ini adalah sebagai tambahan kepada mana-mana kuasanya yang lain, dan tidak mengurangkan kuasanya yang lain yang diperuntukkan di bawah mana-mana undang-undang bertulis yang lain."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_13",
      "@type": "akn:subsection",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_13__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_13__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu permohonan yang dibuat di bawah seksyen ini—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_13__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_13",
      "schema:text": {
        "@language": "ms",
        "@value": "boleh dimulakan pada bila-bila masa dalam masa enam tahun dari tarikh Pihak Berkuasa Pengawalseliaan dan Penyeliaan menyedari tentang pelanggaran, kemungkiran atau ketidakpatuhan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_13__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_13",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak boleh menjejaskan apa-apa tindakan lain yang boleh diambil oleh Pihak Berkuasa Pengawalseliaan dan Penyeliaan, orang yang terkilan, pemberi kredit atau pemberi perkhidmatan kredit, mengikut mana-mana yang berkenaan, di bawah Akta ini atau mana-mana undang- undang bertulis lain."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_14",
      "@type": "akn:subsection",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_14__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_14__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_14__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Pihak Berkuasa Pengawalseliaan dan Penyeliaan tidak termasuk Kementerian Perdagangan Dalam Negeri dan Kos Sara Hidup; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_14__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_14",
      "schema:text": {
        "@language": "ms",
        "@value": "prosiding sivil yang dimulakan oleh Kementerian Perumahan dan Kerajaan Tempatan hendaklah di atas nama Kerajaan. Keterangan yang diperoleh dalam penyiasatan boleh digunakan dalam prosiding sivil"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_1__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_1__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu perintah menghendaki orang itu untuk membayar suatu amaun yang tidak melebihi tiga kali ganda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_1__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_1__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "amaun kasar ganjaran yang diperoleh atau kehilangan yang dielakkan oleh orang itu berbangkit daripada pelanggaran, kemungkiran atau ketidakpatuhan itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_1__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_1__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "amaun wang yang menjadi hal perkara pelanggaran, kemungkiran atau ketidakpatuhan itu, mengikut mana-mana yang berkenaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu perintah untuk menghendaki orang itu untuk membayar suatu penalti sivil dalam apa-apa amaun sebagaimana yang mahkamah berpendapat wajar setelah mengambil kira seriusnya atau beratnya pelanggaran, kemungkiran atau ketidakpatuhan itu, tetapi dalam apa-apa keadaan tidak melebihi lima ratus ribu ringgit;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_1__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_1__para_c__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu perintah untuk—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_1__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_1__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "menahan orang itu daripada terlibat dalam apa-apa kelakuan tertentu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_1__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_1__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "menghendaki pemberhentian pelanggaran, kemungkiran atau ketidakpatuhan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_1__para_d__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_1__para_d__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_1__para_d__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_1__para_d__subpara_iv"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu perintah untuk mengarahkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_1__para_d__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_1__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang itu untuk melakukan suatu perbuatan tertentu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_1__para_d__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_1__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang itu, atau mana-mana orang lain yang didapati terlibat dalam pelanggaran, kemungkiran atau ketidakpatuhan itu untuk mengambil apa-apa langkah sebagaimana yang diarahkan oleh mahkamah untuk mengurangkan kesan pelanggaran, kemungkiran atau ketidapatuhan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_1__para_d__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_1__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "pemberi kredit atau pemberi perkhidmatan kredit itu untuk meremedi pelanggaran, kemungkiran atau ketidakpatuhan itu termasuk membuat restitusi kepada mana-mana orang lain yang terkilan dengan pelanggaran, kemungkiran atau ketidakpatuhan itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_1__para_d__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_1__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "jika seseorang itu telah enggan atau tidak mematuhi tindakan yang diambil oleh Pihak Berkuasa Pengawalseliaan dan Penyeliaan di bawah subseksyen 106(3), orang itu untuk mematuhi tindakan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa perintah lain yang disifatkan wajar oleh mahkamah, termasuk perintah sampingan yang disifatkan perlu berikutan dengan pembuatan suatu perintah di bawah mana-mana peruntukan dalam subseksyen ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu permohonan dibuat kepada suatu mahkamah bagi suatu perintah di bawah subseksyen (1), mahkamah boleh, jika disifatkannya wajar, sebelum mempertimbangkan permohonan itu, membuat suatu perintah interim daripada jenis perintah yang dipohon itu dan perintah itu hendaklah dinyatakan mempunyai kuat kuasa sementara menanti keputusan permohonan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110",
      "schema:text": {
        "@language": "ms",
        "@value": "Mahkamah boleh membuat suatu perintah di bawah subseksyen (1) terhadap—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang yang merupakan pengarah, pengawal, pegawai atau pekongsi, atau pernah berupa untuk bertindak dalam apa-apa keupayaan sedemikian; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang yang berkenaan dalam pengurusan hal ehwal, suatu pertubuhan perbadanan atau yang tidak diperbadankan sekiranya pelanggaran, kemungkiran atau ketidakpatuhan telah dilakukan oleh pertubuhan perbadanan atau pertubuhan yang tidak diperbadankan itu melainkan jika orang itu membuktikan bahawa pelanggaran, kemungkiran atau ketidakpatuhan itu telah dilakukan tanpa keizinannya atau dibiarkan olehnya dan dia telah melaksanakan usaha sedemikian untuk mencegah pelakuan pelanggaran, kemungkiran atau ketidakpatuhan itu sebagaimana yang patut dilaksanakan olehnya, dengan mengambil kira jenis fungsinya atas keupayaan itu dan kepada hal keadaan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu perintah di bawah subseksyen (1) boleh dibuat terhadap suatu pertubuhan perbadanan atau yang tidak diperbadankan jika suatu pelanggaran, kemungkiran atau ketidakpatuhan dilakukan oleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang yang merupakan pengarah, pengawal, pegawai atau pekongsi pertubuhan perbadanan atau yang tidak diperbadankan itu, atau yang berupa untuk bertindak dalam apa-apa keupayaan sedemikian; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang yang berkenaan dalam pengurusan hal ehwal pertubuhan perbadanan atau yang tidak diperbadankan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa jumlah yang diperintahkan oleh mahkamah di bawah subperenggan (1)(d)(iii) hendaklah digunakan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "pertamanya, untuk membayar orang yang terkilan oleh pelanggaran, kemungkiran atau ketidakpatuhan dalam hal perintah itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "keduanya, untuk membayar Pihak Berkuasa Pengawalseliaan dan Penyeliaan, termasuk apa-apa jumlah baki, untuk segala kos prosiding berkenaan dengan pelanggaran, kemungkiran atau ketidakpatuhan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_6__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_6__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa jumlah yang diperintahkan oleh mahkamah di bawah subseksyen (1) selain subperenggan (1)(d)(iii), hendaklah dibayar ke dalam dan menjadi sebahagian—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "kumpulan wang operasi Suruhanjaya Koperasi Malaysia jika permohonan itu dibuat oleh Suruhanjaya Koperasi Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Kumpulan Wang yang ditubuhkan di bawah seksyen 26 jika permohonan itu dibuat oleh Suruhanjaya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_6__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Kumpulan Wang Disatukan Persekutuan jika permohonan itu dibuat oleh Pihak Berkuasa Pengawalseliaan dan Penyeliaan yang lain."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110",
      "schema:text": {
        "@language": "ms",
        "@value": "Setakat amaun apa-apa bakal pengagihan di bawah subperenggan (1)(d)(iii) yang tidak dapat diagihkan oleh pemberi kredit atau pemberi perkhidmatan kredit itu, mengikut mana-mana yang berkenaan, selepas usaha yang munasabah untuk memberitahu orang yang terkilan telah gagal oleh sebab kesulitan mengenal pasti atau memberitahu orang yang terkilan, pemberi kredit atau pemberi perkhidmatan kredit itu hendaklah menyerah simpan amaun itu dengan Pendaftar Wang Tak Dituntut mengikut peruntukan Akta Wang Tak Dituntut 1965."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Pihak Berkuasa Pengawalseliaan dan Penyeliaan membuat suatu permohonan bagi suatu perintah di bawah seksyen ini, mahkamah tidak boleh, sebagai suatu syarat bagi perintah itu diberikan, menghendaki apa-apa aku janji tentang ganti rugi yang kena diberikan oleh atau bagi pihak Pihak Berkuasa Pengawalseliaan dan Penyeliaan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_110",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang tidak mematuhi suatu perintah mahkamah di bawah subseksyen (1) atau (2) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima juta ringgit atau dipenjarakan selama tempoh tidak melebihi lima tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_111",
      "@type": "akn:clause",
      "eli:number": "111",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_111__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_111__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_111__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_111__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_111__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_111__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_111__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_111__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_111__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_111",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun mana-mana undang-undang, apa-apa dokumen atau maklumat yang diperoleh oleh suatu Pihak Berkuasa Pengawalseliaan dan Penyeliaan dalam melaksanakan kuasa penyiasatannya terhadap orang-orang berikut boleh digunakan oleh Pihak Berkuasa Pengawalseliaan dan Penyeliaan itu dalam suatu tindakan penguatkuasaan sivil yang dimulakan oleh Pihak Berkuasa Pengawalseliaan dan Penyeliaan itu:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_111__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_111__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu pemberi kredit;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_111__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_111__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu pemberi perkhidmatan kredit;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_111__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_111__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana pengarah, pekongsi atau pegawai orang yang disebut dalam perenggan (a) atau (b);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_111__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_111__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana ejen orang yang disebut dalam perenggan (a) atau (b); atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_111__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_111__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang lain."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_111__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_111",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi mengelakkan keraguan, apa-apa dokumen atau maklumat yang disebut dalam subseksyen (1) tidak boleh tidak diterima dalam mana-mana prosiding sivil di bawah Bahagian ini yang Pihak Berkuasa Pengawalseliaan dan Penyeliaan ialah suatu pihak disebabkan hanya kerana Pihak Berkuasa Pengawalseliaan dan Penyeliaan memperolehnya dalam melaksanakan kuasa penyiasatannya dan kebolehterimaan itu hendaklah ditentukan mengikut kaedah-kaedah keterangan di bawah mana-mana undang- undang."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_111__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_111__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_111__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_111",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_111__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_111__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Pihak Berkuasa Pengawalseliaan dan Penyeliaan tidak termasuk Kementerian Perdagangan Dalam Negeri dan Kos Sara Hidup; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_111__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_111__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "prosiding sivil yang dimulakan oleh Kementerian Perumahan dan Kerajaan Tempatan hendaklah di atas nama Kerajaan. Penggal 3 Kesalahan jenayah Kesalahan berhubung dengan catatan dalam dokumen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_112",
      "@type": "akn:clause",
      "eli:number": "112",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_112__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_112__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_112__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_112__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_112__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_112__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_112__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_112",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_112__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_112__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat atau menyebabkan dibuat suatu catatan palsu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_112__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_112__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "meninggalkan daripada membuat, atau menyebabkan ditinggalkan, apa-apa catatan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_112__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_112__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mengubah, mencabutkan, menyembunyikan atau memusnahkan, atau menyebabkan untuk diubah, dicabut, disembunyikan atau dimusnahkan, apa-apa catatan, dalam apa-apa buku atau rekod, atau dalam apa-apa laporan, helaian kertas, penyata atau apa-apa jua pun dokumen lain, yang berhubungan dengan perniagaan, hal ehwal, transaksi, keadaan, harta, aset, liabiliti atau akaun, suatu pemberi kredit atau pemberi perkhidmatan kredit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_112__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_112",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh mengubah, memalsukan, memusnahkan, mencacatkan, merosakkan, menyembunyikan atau mengalihkan apa-apa dokumen untuk mengelak daripada peruntukan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_112__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_112",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1) atau (2) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima juta ringgit atau dipenjarakan selama tempoh tidak melebihi lima tahun atau kedua-duanya. Kesalahan oleh mana-mana orang yang bertindak dalam keupayaan rasmi, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_113",
      "@type": "akn:clause",
      "eli:number": "113",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_113__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_113__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_113__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_113__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_113__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_113__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_113",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika sesuatu kesalahan dilakukan oleh suatu pertubuhan perbadanan atau yang tidak diperbadankan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_113__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_113__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang yang merupakan pengarahnya, pengawalnya, pegawainya atau pekongsinya, atau berupa sebagai bertindak dalam mana-mana keupayaan sedemikian; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_113__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_113__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang yang berkenaan dalam pengurusan hal ehwalnya, pada masa kesalahan itu dilakukan adalah disifatkan sebagai telah melakukan kesalahan itu melainkan jika orang itu membuktikan bahawa kesalahan itu telah dilakukan tanpa pengetahuannya atau tanpa persetujuan atau pembiarannya dan bahawa dia telah melaksanakan apa-apa usaha untuk mencegah pelakuan kesalahan itu sebagaimana yang patut dilaksanakan olehnya, dengan mengambil kira jenis fungsinya dalam keupayaan itu dan kepada hal keadaan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_113__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_113",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang individu itu boleh didakwa untuk suatu kesalahan di bawah subseksyen (1) walau apa pun pertubuhan perbadanan atau yang tidak diperbadankan itu tidak disabitkan dengan kesalahan sama ada atau tidak suatu pendakwaan telah dimulakan atau suatu sabitan telah diperoleh terhadap pertubuhan yang diperbadankan atau yang tidak diperbadankan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_113__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_113",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen (1) tidak boleh menjejaskan liabiliti jenayah pertubuhan perbadanan atau yang tidak diperbadankan bagi kesalahan yang disebut dalam subseksyen itu. Kesalahan oleh pekerja, pegawai, ejen, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_114",
      "@type": "akn:clause",
      "eli:number": "114",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_114__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_114__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_114__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_114",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika sesuatu kesalahan dilakukan oleh seorang pekerja, pegawai, pengarah, pekongsi, pengawal atau ejen seseorang, semasa penjalanan pekerjaan pekerja atau pegawai itu, semasa menjalankan fungsi sebagai pengarah atau pekongsi, semasa menjalankan fungsi sebagai pengawal atau apabila ejen itu bertindak bagi pihak orang itu, secara masing-masing, orang itu adalah disifatkan telah melakukan kesalahan itu dan boleh dikenakan penalti yang sama bagi kesalahan pekerjanya, pegawainya, pengarahnya, pekongsinya, pengawalnya atau ejennya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_114__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_114",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada apa-apa jua di bawah subseksyen (1) akan membebaskan seseorang pekerja, pegawai, pengarah, pekongsi, pengawal atau ejen daripada apa-apa tanggungan bagi sesuatu kesalahan. Percubaan, persubahatan dan pakatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_115",
      "@type": "akn:clause",
      "eli:number": "115",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_115__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_115__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_115__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_115__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_115__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_115__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_115",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_115__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_115__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "cuba melakukan suatu kesalahan di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_115__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_115__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat suatu perbuatan sebagai persediaan untuk, atau bagi membantu, pelakuan suatu kesalahan di bawah Akta ini; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_115__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_115__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bersubahat atau terlibat dalam suatu komplot jenayah untuk melakukan, sebagaimana istilah itu diertikan dalam Kanun Keseksaan, suatu kesalahan di bawah Akta ini, sama ada atau tidak kesalahan itu dilakukan akibat daripadanya, melakukan suatu kesalahan dan boleh dikenakan penalti bagi kesalahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_115__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_115",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu peruntukan Akta ini yang merujuk kepada suatu kesalahan di bawah suatu peruntukan tertentu Akta ini hendaklah dibaca sebagai termasuk suatu sebutan kepada suatu kesalahan di bawah subseksyen (1) berhubung dengan kesalahan di bawah peruntukan tertentu itu. Pencantuman kesalahan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_116",
      "@type": "akn:clause",
      "eli:number": "116",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun apa-apa jua yang terkandung dalam mana-mana undang-undang bertulis lain, jika seseorang dituduh melakukan lebih daripada satu kesalahan di bawah Akta ini, dia boleh dipertuduh dan dibicarakan dalam satu perbicaraan atas apa-apa bilangan kesalahan sedemikian yang dilakukan dalam apa-apa jangka masa. Kesalahan boleh tangkap"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_117",
      "@type": "akn:clause",
      "eli:number": "117",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_117__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_117__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_117__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_117",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap kesalahan yang boleh dihukum di bawah Akta ini hendaklah menjadi suatu kesalahan boleh tangkap, dan seorang pegawai polis yang berpangkat tidak rendah daripada pangkat Sarjan, atau seorang pegawai penyiasat yang dilantik di bawah seksyen 90 boleh menangkap tanpa waran seseorang yang dia secara munasabah mengesyaki telah melakukan atau sedang melakukan kesalahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_117__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_117",
      "schema:text": {
        "@language": "ms",
        "@value": "Seorang pegawai penyiasat yang membuat suatu tangkapan di bawah subseksyen (1) hendaklah menyerahkan orang yang ditangkap itu kepada seorang pegawai polis tanpa kelengahan yang tidak berpatutan dan orang yang ditangkap itu hendaklah diuruskan mengikut undang-undang yang berhubungan dengan tatacara jenayah seolah-olah dia telah ditangkap oleh seorang pegawai polis. Kuasa untuk mengkompaun"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_118",
      "@type": "akn:clause",
      "eli:number": "118",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_118__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_118__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_118__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_118__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_118__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_118__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_118__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_118__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_118",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, atas syor Suruhanjaya, dengan kelulusan Pendakwa Raya, membuat peraturan-peraturan yang menetapkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_118__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_118__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa kesalahan di bawah Akta ini sebagai suatu kesalahan yang boleh dikompaun; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_118__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_118__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "kaedah dan tatacara untuk mengkompaun kesalahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_118__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_118",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu Pihak Berkuasa Pengawalseliaan dan Penyeliaan boleh, dengan keizinan bertulis Pendakwa Raya, menawarkan secara bertulis untuk mengkompaun mana-mana kesalahan yang boleh dikompaun di bawah Akta ini dengan menerima daripada orang yang semunasabahnya disyaki telah melakukan kesalahan itu, apa-apa jumlah wang tidak melebihi lima puluh peratus daripada amaun denda maksimum yang orang itu boleh bertanggungan jika dia telah disabitkan dengan kesalahan itu, dalam apa-apa masa sebagaimana yang ditentukan dalam tawaran itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_118__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_118",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu tawaran di bawah subseksyen (2) boleh dibuat pada bila-bila masa selepas kesalahan itu dilakukan, tetapi sebelum apa-apa pendakwaan baginya dimulakan, dan jika amaun yang ditentukan dalam tawaran itu tidak dibayar dalam masa yang ditentukan dalam tawaran itu atau dalam apa-apa tempoh yang dilanjutkan yang boleh diberikan oleh Pihak Berkuasa Pengawalseliaan dan Penyeliaan, pendakwaan bagi kesalahan itu boleh dimulakan pada bila-bila masa selepas itu terhadap orang yang kepadanya tawaran itu dibuat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_118__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_118",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu kesalahan telah dikompaun di bawah subseksyen (2), tiada pendakwaan boleh dimulakan berkenaan dengan kesalahan itu terhadap orang yang kepadanya tawaran untuk mengkompaun itu telah dibuat, dan apa-apa dokumen atau benda yang disita berkaitan dengan kesalahan itu boleh dilepaskan oleh Pihak Berkuasa Pengawalseliaan dan Penyeliaan, tertakluk kepada apa-apa terma dan syarat sebagaimana yang difikirkan sesuai oleh Pihak Berkuasa Pengawalseliaan dan Penyeliaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_118__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_118__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_118__subsec_5__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_118__subsec_5__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_118",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua jumlah wang yang diterima di bawah subseksyen (2) hendaklah dibayar ke dalam dan menjadi sebahagian—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_118__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_118__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "kumpulan wang operasi Suruhanjaya Koperasi Malaysia jika penawaran kompaun itu dibuat oleh Suruhanjaya Koperasi Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_118__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_118__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Kumpulan Wang yang ditubuhkan di bawah seksyen 26 jika penawaran kompaun itu dibuat oleh Suruhanjaya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_118__subsec_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_118__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Kumpulan Wang Disatukan Persekutuan jika penawaran kompaun itu dibuat oleh Pihak Berkuasa Pengawalseliaan dan Penyeliaan yang lain. Pemulaan pendakwaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_119",
      "@type": "akn:clause",
      "eli:number": "119",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada pendakwaan bagi suatu kesalahan di bawah Akta ini boleh dimulakan kecuali dengan keizinan bertulis Pendakwa Raya. Penggal 4 Perkara am Perlindungan berhubung dengan pendedahan maklumat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_120",
      "@type": "akn:clause",
      "eli:number": "120",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_120__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_120__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_120__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_120__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_120__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_120__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_120",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seseorang mendedahkan secara suci hati kepada suatu Pihak Berkuasa Pengawalseliaan dan Penyeliaan, pengetahuannya atau kepercayaannya atau apa-apa dokumen atau maklumat bahawa suatu kemungkiran atau pelanggaran telah berlaku atau mungkin akan berlaku di bawah Akta ini—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_120__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_120__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "orang itu tidak bertanggungan bagi suatu kemungkiran suatu kewajipan kerahsiaan yang dikenakan oleh mana-mana undang-undang, kontrak atau kaedah-kaedah amalan profesional;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_120__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_120__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "ia hendaklah menjadi suatu pembelaan dalam suatu tindakan, guaman, pendakwaan atau prosiding yang dibawa, dimulakan atau diteruskan dalam mana-mana mahkamah atau di hadapan mana-mana pihak berkuasa lain terhadap orang yang membuat pendedahan kepada Pihak Berkuasa Pengawalseliaan dan Penyeliaan yang ia percaya pendedahan itu perlu bagi maksud pelaksanaan peruntukan Akta ini; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_120__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_120__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak ada kontrak atau hak atau remedi lain boleh dikuatkuasakan terhadap orang itu atas sebab pendedahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_120__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_120",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa dokumen atau maklumat yang didedahkan kepada Pihak Berkuasa Pengawalseliaan dan Penyeliaan di bawah subseksyen (1) dan pengenalan diri orang yang membuat pendedahan itu hendaklah menjadi rahsia antara Pihak Berkuasa Pengawalseliaan dan Penyeliaan itu dan orang yang membuat pendedahan itu, melainkan jika orang yang membuat pendedahan itu mengizinkan secara bertulis pendedahan pengenalan dirinya atau dokumen atau maklumat itu oleh Pihak Berkuasa Pengawalseliaan dan Penyeliaan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Kredit Pengguna 2025."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta dan Menteri boleh menetapkan tarikh yang berlainan bagi permulaan kuat kuasa bahagian yang berlainan atau peruntukan yang berlainan Akta ini. Pemakaian"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_2__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_2__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_2__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_2__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_2__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini hendaklah terpakai bagi mana-mana orang yang menjalankan suatu perniagaan kredit atau perniagaan perkhidmatan kredit yang melibatkan seorang pengguna kredit kecuali kredit yang diberi oleh seseorang sebagaimana yang dinyatakan dalam Jadual 1."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (1), subseksyen 79(2) dan (3) hendaklah terpakai bagi mana-mana orang yang menjalankan suatu perniagaan kredit sebagaimana yang dinyatakan dalam perenggan 1 atau perenggan 3 Jadual 4 yang tidak melibatkan seorang pengguna kredit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_2__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_2__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_2__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_2__subsec_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_2__subsec_3__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_2__subsec_3__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_2__subsec_3__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_2__subsec_3__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_2__subsec_3__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_2__subsec_3__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_2__subsec_3__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_2__subsec_3__para_k"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada subseksyen (5), Akta ini hendaklah dibaca bersama-sama dengan undang-undang bertulis yang berkaitan dan peruntukan Akta ini hendaklah menjadi tambahan kepada, dan tidak mengurangkan, peruntukan undang-undang bertulis itu, termasuk yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_2__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_2__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Perkhidmatan Kewangan 2013 [Akta 758];"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_2__subsec_3__para_b",
