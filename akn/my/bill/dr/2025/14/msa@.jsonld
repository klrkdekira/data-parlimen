      "schema:text": {
        "@language": "ms",
        "@value": "Akta Pemegang Pajak Gadai 1972 [Akta 81];"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_2__subsec_3__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_2__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Koperasi 1993 [Akta 502]; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_2__subsec_3__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_2__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Suruhanjaya Koperasi Malaysia 2007 [Akta 665]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_2__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_2__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_2__subsec_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_2__subsec_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada apa-apa dalam Akta ini boleh menghapuskan atau menyekat kesan, atau menghalang pergantungan kepada—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_2__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_2__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana undang-undang bertulis yang mengenakan ke atas suatu pemberi kredit atau pemberi perkhidmatan kredit suatu kewajipan yang lebih ketat daripada yang dikenakan di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_2__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_2__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana undang-undang bertulis yang mengikutnya apa-apa terma yang selaras dengan Akta ini dianggap tersirat dalam suatu perjanjian kredit; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_2__subsec_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_2__subsec_4__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_2__subsec_4__para_c__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_2__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa terma dalam apa-apa perjanjian secara bertulis antara seorang pengguna kredit dengan suatu pemberi kredit atau pemberi perkhidmatan kredit, mengikut mana-mana yang berkenaan, setakat mana terma itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_2__subsec_4__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_2__subsec_4__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "mengenakan suatu kewajipan yang lebih ketat ke atas pemberi kredit atau pemberi perkhidmatan kredit itu daripada yang dikenakan di bawah Akta ini; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_2__subsec_4__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_2__subsec_4__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "memperuntukkan suatu remedi yang lebih menguntungkan kepada pengguna kredit itu daripada remedi yang diperuntukkan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_2__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika terdapat apa-apa percanggahan atau ketidakselarasan dalam pemakaian peruntukan Akta ini dalam hal yang melibatkan pemberi kredit atau pemberi perkhidmatan kredit yang dikawal selia oleh Suruhanjaya Sekuriti Malaysia, hal itu hendaklah diuruskan mengikut undang-undang sekuriti dan garis panduan yang dikeluarkan oleh Suruhanjaya Sekuriti Malaysia dan kaedah-kaedah bursa sebagaimana yang diluluskan oleh Suruhanjaya Sekuriti Malaysia. Tidak boleh berkontrak keluar dan penyingkiran pilihan undang-undang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_3__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Peruntukan Akta ini hendaklah berkuat kuasa walau apa pun apa-apa jua yang bertentangan dalam mana-mana perjanjian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini hendaklah berkuat kuasa walau apa pun apa-apa terma kontrak yang terpakai bagi atau berupa sebagai terpakai bagi undang-undang negara yang lain jika mahkamah mendapati bahawa terma itu telah dikenakan keseluruhannya atau terutamanya bagi maksud untuk membolehkan pihak yang mengenakannya mengelak daripada operasi Akta ini. Tafsiran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_4__list_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_4__list_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_4__list_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_4__list_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I",
      "schema:name": {
        "@language": "ms",
        "@value": "Dalam Akta ini, melainkan jika konteksnya menghendaki makna yang lain—"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "“Akta ini” termasuklah mana-mana perundangan subsidiari, standard atau garis panduan dan pemberitahuan yang dibuat di bawah Akta ini; “ditentukan” ertinya untuk menentukan secara bertulis dalam apa-apa bentuk termasuk standard atau garis panduan, dan suatu kuasa untuk menentukan termasuklah kuasa untuk menentukan secara berlainan bagi orang yang berlainan atau kelas, kategori atau perihalan orang, perniagaan kredit, perniagaan perkhidmatan kredit, pemberi kredit atau pemberi perkhidmatan kredit yang berlainan; “ditetapkan” ertinya untuk ditetapkan melalui perundangan subsidiari yang disiarkan dalam Warta, dan suatu kuasa untuk menetapkan termasuklah kuasa untuk menetapkan secara berlainan bagi orang yang berlainan atau kelas, kategori atau perihalan orang, perniagaan kredit, perniagaan perkhidmatan kredit, pemberi kredit atau pemberi perkhidmatan kredit yang berlainan; “dokumen” mempunyai erti yang diberikan kepadanya dalam seksyen 3 Akta Keterangan 1950 [Akta 56], dan termasuklah buku sebagaimana yang ditakrifkan dalam Akta Syarikat 2016 [Akta 777] dan dokumen hakmilik kepada aset; “harta” ertinya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_4__list_1",
      "@type": "akn:list",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_4__list_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_4__list_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_4__list_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_4"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_4__list_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_4__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tiap-tiap jenis aset, sama ada yang zahir atau tidak zahir, alih atau tak alih, yang ketara atau tidak ketara, walau bagaimana diperoleh;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_4__list_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_4__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dokumen atau surat cara undang-undang dalam apa-apa bentuk, termasuk elektronik atau digital, yang menjadi keterangan tentang hakmilik kepada, atau kepentingan dalam, aset itu, termasuk kredit bank, cek kembara, cek bank, kiriman wang, syer, sekuriti, bon, draf dan surat kredit; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_4__list_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_4__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa hak, kepentingan, hakmilik, tuntutan, hak dalam tindakan, kuasa atau keistimewaan, sama ada sekarang atau masa hadapan, atau sama ada terletak hak atau kontingen, berhubung dengan mana-mana harta, atau yang selainnya mempunyai nilai; “individu” ertinya orang sebenar; “Jawatankuasa Lembaga” ertinya suatu jawatankuasa Lembaga yang ditubuhkan di bawah seksyen 18; “Jawatankuasa Penasihat” ertinya Jawatankuasa Penasihat yang ditubuhkan di bawah seksyen 36; “ketua eksekutif”, berhubung dengan suatu pertubuhan perbadanan, ertinya pegawai eksekutif utama perbadanan itu pada masa ini, dengan apa jua namanya digelar dan sama ada dia seorang pengarah atau tidak; “komputer” mempunyai erti yang diberikan kepadanya dalam seksyen 3 Akta Keterangan 1950; “koperasi” mempunyai erti yang diberikan kepadanya dalam seksyen 2 Akta Koperasi 1993; “kredit” ertinya apa-apa perkiraan, perjanjian atau kemudahan sebagaimana yang dinyatakan dalam subseksyen 5(2); “Lembaga” ertinya lembaga pengarah Suruhanjaya yang disebut dalam seksyen 9; “lesen” ertinya suatu lesen yang diberikan di bawah seksyen 42; “liabiliti” termasuklah hutang atau tiap-tiap jenis tanggungan, sama ada sekarang atau masa hadapan, atau sama ada terletak hak atau kontingen; “Majlis Penasihat Shariah” ertinya Majlis Penasihat Shariah yang ditubuhkan di bawah seksyen 51 Akta Bank Negara Malaysia 2009 [Akta 701] atau seksyen 31zi Akta Suruhanjaya Sekuriti Malaysia 1993; “Menteri” ertinya Menteri yang dipertanggungkan dengan tanggungjawab bagi kewangan; “Menteri Perdagangan Dalam Negeri dan Kos Sara Hidup” ertinya Menteri yang dipertanggungkan dengan tanggungjawab bagi perdagangan dalam negeri dan kos sara hidup; “Menteri Perumahan dan Kerajaan Tempatan” ertinya Menteri yang dipertanggungkan dengan tanggungjawab bagi perumahan dan kerajaan tempatan; “orang” termasuklah seorang individu, mana-mana pemilikan tunggal, perbadanan, badan berkanun, pihak berkuasa tempatan, pertubuhan, kesatuan sekerja, koperasi, perkongsian dan mana-mana badan, organisasi, persatuan atau kumpulan orang yang lain, sama ada diperbadankan atau tidak diperbadankan; “output komputer” ertinya suatu penyataan atau gambaran, sama ada dalam bentuk bertulis, bercetak, bergambar, filem, grafik, akustik atau bentuk lain—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_4__list_2",
      "@type": "akn:list",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_4__list_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_4__list_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_4__list_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_4"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_4__list_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_4__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dikeluarkan oleh suatu komputer;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_4__list_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_4__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "ditayangkan pada skrin suatu komputer; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_4__list_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_4__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "diterjemahkan dengan tepat daripada suatu penyataan atau gambaran yang dikeluarkan sedemikian; “pemberi kredit” ertinya seseorang yang menjalankan suatu perniagaan kredit jika orang itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_4__list_3",
      "@type": "akn:list",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_4__list_3__para_a",
