    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_97__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_97",
      "schema:text": {
        "@language": "ms",
        "@value": "Seorang pegawai penyiasat boleh memeriksa mana-mana orang yang dia mempunyai sebab untuk mempercayai ada dalam milikannya, termasuk pada dirinya, apa-apa dokumen, cagaran yang dipegang berkenaan dengan transaksi pengguna kredit, hakmilik, wang tunai, barangan, benda, harta, perkakas, kelengkapan, jentera, komputer, output komputer, sistem, data, program, maklumat, atau artikel yang perlu, pada pendapatnya, bagi maksud penyiasatan apa-apa kesalahan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_97__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_97",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud suatu pemeriksaan atas seseorang di bawah subseksyen (1) atau seksyen 92 atau 94, seorang pegawai penyiasat boleh, tertakluk kepada peruntukan Kanun Tatacara Jenayah, menahan orang itu sebagaimana yang perlu untuk menjalankan pemeriksaan, dan boleh memindahkannya ke dalam jagaan di mana-mana tempat sebagaimana yang perlu untuk memudahkan pemeriksaan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_97__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_97",
      "schema:text": {
        "@language": "ms",
        "@value": "Seorang pegawai penyiasat yang melakukan suatu pemeriksaan atas seseorang di bawah subseksyen (1) boleh menyita, menahan atau mengambil milik apa-apa dokumen, cagaran yang dipegang berkenaan dengan transaksi pengguna kredit, hakmilik, wang tunai, barangan, benda, harta, perkakas, kelengkapan, jentera, komputer, output komputer, sistem, data, program, maklumat atau artikel, yang dijumpai pada diri orang itu bagi maksud penyiasatan yang sedang dijalankan olehnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_97__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_97",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa pemeriksaan atas seseorang yang dijalankan di bawah Bahagian ini hendaklah menurut peruntukan dalam Kanun Tatacara Jenayah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_97__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_97",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh diperiksa kecuali oleh seorang yang sama jantinanya dengan orang yang diperiksa, dan pemeriksaan itu hendaklah dijalankan dengan penuh kesopanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_97__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_97",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud suatu pemeriksaan yang dijalankan di bawah seksyen ini oleh Kementerian Perumahan dan Kerajaan Tempatan, jika pegawai penyiasat ialah seorang pegawai polis, pegawai polis itu hendaklah seorang pegawai kanan polis. Halangan terhadap pelaksanaan kuasa oleh pegawai penyiasat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_98",
      "@type": "akn:clause",
      "eli:number": "98",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_98__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_98__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_98__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_98__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_98__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_98__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_98__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_98__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_98__subsec_1__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_98",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_98__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_98__subsec_1__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_98__subsec_1__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_98__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "enggan memberi kepada mana-mana pegawai penyiasat yang menjalankan kuasanya di bawah Penggal ini—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_98__subsec_1__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_98__subsec_1__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "akses kepada mana-mana premis atau mana-mana bahagian premis itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_98__subsec_1__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_98__subsec_1__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa maklumat yang semunasabahnya boleh dikehendaki daripadanya dan yang dia berkuasa untuk memberikannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_98__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_98__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menyerang, menghalang, mengganggu atau melengah-lengahkan mana-mana pegawai penyiasat dalam melaksanakan kuasanya di bawah Penggal ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_98__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_98__subsec_1__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_98__subsec_1__para_c__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_98__subsec_1__para_c__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_98__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_98__subsec_1__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_98__subsec_1__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "mematuhi apa-apa tuntutan yang sah oleh mana-mana pegawai penyiasat dalam menjalankan kuasanya di bawah Penggal ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_98__subsec_1__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_98__subsec_1__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "membenarkan dirinya diperiksa; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_98__subsec_1__para_c__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_98__subsec_1__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "mengemukakan kepada, atau menyembunyikan atau cuba menyembunyikan daripada, seorang pegawai penyiasat apa-apa dokumen, cagaran yang dipegang berkenaan dengan transaksi pengguna kredit, hakmilik, wang tunai, barangan, benda, harta, perkakas, kelengkapan, jentera, komputer, output komputer, sistem, data, program, maklumat atau artikel yang pegawai penyiasat itu menghendaki;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_98__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_98__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mendapatkan balik atau berusaha untuk mendapatkan balik apa-apa benda yang telah disita dengan sewajarnya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_98__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_98__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "memberikan kepada seorang pegawai penyiasat maklumat sebagai benar, yang dia tahu atau mempunyai sebab bagi mempercayai adalah palsu, mengelirukan, tidak tepat atau tidak lengkap; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_98__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_98__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "sebelum atau selepas apa-apa penyitaan, memecah atau selainnya memusnahkan apa-apa benda untuk menghalang penyitaan itu, atau melindungi benda itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_98__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_98",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima juta ringgit atau dipenjarakan selama tempoh tidak melebihi lima tahun atau kedua-duanya. Kehendak menyediakan terjemahan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_99",
      "@type": "akn:clause",
      "eli:number": "99",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_99__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_99__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_99__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_99__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_99__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_99__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_99__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_99",
      "schema:text": {
        "@language": "ms",
        "@value": "Seorang pegawai penyiasat boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_99__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_99__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "secara lisan atau bertulis, menghendaki seseorang yang mempunyai milikan, jagaan atau kawalan ke atas dokumen, cagaran yang dipegang berkenaan dengan transaksi pengguna kredit, hakmilik, wang tunai, komputer, output komputer, sistem, data, program, atau maklumat dalam suatu bahasa selain bahasa kebangsaan atau bahasa Inggeris, atau dalam apa-apa isyarat atau kod, untuk memberi kepada pegawai penyiasat itu suatu terjemahan dalam bahasa kebangsaan atau bahasa Inggeris mengenai dokumen, cagaran yang dipegang berkenaan dengan transaksi pengguna kredit, hakmilik, wang tunai, output komputer, sistem, data, program, atau maklumat itu yang dijumpai, disita, ditahan atau diambil milik oleh pegawai penyiasat itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_99__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_99__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menentukan tempoh yang munasabah untuk orang itu memberikan suatu terjemahan, dengan mengambil kira panjang dokumen, cagaran yang dipegang berkenaan dengan transaksi pengguna kredit, hakmilik, wang tunai, output komputer, sistem, data, program, atau maklumat, atau hal keadaan lain yang berhubungan dengannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_99__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_99",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh dengan pengetahuannya membuat atau memberikan suatu terjemahan di bawah subseksyen (1) yang bukan suatu terjemahan yang tepat, jujur dan benar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_99__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_99",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika orang yang dikehendaki untuk memberikan suatu terjemahan di bawah subseksyen (1) bukan orang yang disyaki melakukan kesalahan atau kemungkiran di bawah penyiasatan, Pihak Berkuasa Pengawalseliaan dan Penyeliaan hendaklah membayar kepadanya fi yang munasabah bagi terjemahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_99__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_99",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1) atau (2) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tiga tahun atau kedua-duanya. Kuasa untuk memeriksa orang untuk penyiasatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_84",
      "@type": "akn:clause",
      "eli:number": "84",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu pemberi kredit atau pemberi perkhidmatan kredit hendaklah mengurus dan memastikan ia menjalankan perniagaan kreditnya atau perniagaan perkhidmatan kreditnya dengan cara yang adil, bertanggungjawab dan profesional apabila berurusan dengan pengguna kredit. Pematuhan dengan peraturan-peraturan dan standard atau garis panduan mengenai pelakuan perniagaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_85",
      "@type": "akn:clause",
      "eli:number": "85",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_85__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_85__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_85__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_85__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_85__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_85__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_85__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_85__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_85__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_85__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_85__subsec_1__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_85__subsec_1__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_85__subsec_1__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_85__subsec_1__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_85__subsec_1__para_k"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_85",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen 84, peraturan-peraturan di bawah seksyen 122 dan standard atau garis panduan di bawah seksyen 123 boleh termasuk yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_85__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_85__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pelakuan perniagaan dilarang;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_85__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_85__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "promosi apa-apa perniagaan kredit atau perniagaan perkhidmatan kredit, termasuk melalui penerbitan atau penyiaran suatu iklan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_85__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_85__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "kehendak ketelusan dan pendedahan, termasuk pemberian maklumat kepada seorang pengguna kredit yang tepat, jelas, tepat pada masanya dan tidak mengelirukan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_85__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_85__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "terma yang adil dalam suatu perjanjian kredit;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_85__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_85__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pengenaan faedah, keuntungan, fi atau caj;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_85__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_85__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pemberian penilaian kemampuan kredit yang ditawarkan kepada pengguna kredit termasuk hal keadaan jika kredit tidak boleh diberikan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_85__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_85__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "amalan kutipan hutang yang adil;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_85__subsec_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_85__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "penyediaan bantuan kepada seorang pengguna kredit yang mengalami kesusahan kewangan untuk memenuhi kewajipan kewangannya di bawah suatu perjanjian kredit;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_85__subsec_1__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_85__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pengendalian aduan dan mekanisme penyelesaian pertikaian;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_85__subsec_1__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_85__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "kekompetenan pegawai atau mana-mana orang yang bertindak bagi pihak suatu pemberi kredit atau pemberi perkhidmatan kredit termasuk untuk memastikan bahawa mereka menerima latihan secukupnya untuk terlibat dengan pengguna kredit; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_85__subsec_1__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_85__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pengurusan apa-apa dokumen atau maklumat yang berhubungan dengan perniagaan atau hal ehwal mana-mana pengguna kredit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_85__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_85",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap pemberi kredit atau pemberi perkhidmatan kredit hendaklah pada setiap masa memastikan bahawa dasar dan tatacara dalamannya yang berhubungan dengan pelakuan perniagaan adalah selaras dengan peraturan-peraturan yang dibuat di bawah perenggan 122(2)(d) dan standard atau garis panduan yang dibuat di bawah perenggan 123(2)(c)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_85__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_85",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap pengarah, pekongsi atau pegawai suatu pemberi kredit atau pemberi perkhidmatan kredit hendaklah pada setiap masa mematuhi dasar dan tatacara dalaman yang diterima pakai oleh pemberi kredit atau pemberi perkhidmatan kredit itu termasuk dasar dan tatacara dalaman untuk melaksanakan peraturan-peraturan yang dibuat di bawah perenggan 122(2)(d) dan standard atau garis panduan yang dibuat di bawah perenggan 123(2)(c). Kesusahan kewangan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_86",
      "@type": "akn:clause",
      "eli:number": "86",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_86__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_86__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_86__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_86__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_86__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_86__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_86__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_86__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_86__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_86",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud perenggan 85(1)(h), Suruhanjaya boleh mengeluarkan standard atau garis panduan di bawah seksyen 123 untuk menentukan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_86__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_86__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "hal keadaan yang layak sebagai kesusahan kewangan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_86__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_86__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bentuk dan cara bantuan yang akan diberikan oleh suatu pemberi kredit, jika penentuan itu adalah, menurut pendapat Suruhanjaya, perlu atau wajar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_86__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_86__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_86__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_86",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam menjalankan kuasanya di bawah subseksyen (1), Suruhanjaya hendaklah memastikan standard atau garis panduan yang dibuat adalah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_86__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_86__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "demi kepentingan keteraturan penjalanan fungsi dan pembangunan industri kredit pengguna, dengan mengambil kira akses berterusan pengguna kredit kepada kredit; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_86__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_86__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak memudaratkan kestabilan kewangan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_86__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_86",
      "schema:text": {
        "@language": "ms",
        "@value": "Seorang pengguna kredit boleh memohon bantuan kesusahan kewangan daripada suatu pemberi kredit berkenaan dengan suatu perjanjian kredit dengan pemberi kredit itu, jika mana-mana hal keadaan kesusahan kewangan yang ditentukan di bawah subseksyen (1) terpakai."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_86__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_86",
      "schema:text": {
        "@language": "ms",
        "@value": "Setelah menerima suatu permohonan di bawah subseksyen (3), pemberi kredit itu hendaklah membuat suatu penilaian untuk menentukan sama ada suatu bantuan boleh diberikan kepada pengguna kredit itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_86__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_86",
      "schema:text": {
        "@language": "ms",
        "@value": "Semasa suatu penilaian di bawah subseksyen (4), hak pemberi kredit itu untuk memulakan sebarang prosiding, pelaksanaan atau mana-mana proses undang-undang yang lain terhadap pengguna kredit itu hendaklah digantung."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_86__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_86",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika pemberi kredit itu berpuas hati bahawa bantuan kesusahan kewangan harus diberi, pemberi kredit itu hendaklah menentukan bentuk dan cara bantuan yang akan diberikan, melainkan jika Suruhanjaya telah mengeluarkan suatu penentuan mengenai perkara itu di bawah perenggan (1)(b). Penggal 2 Pelakuan perniagaan dilarang Pelakuan perniagaan dilarang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_87",
      "@type": "akn:clause",
      "eli:number": "87",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_87__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_87__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_87__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_87",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh terlibat dalam apa-apa pelakuan perniagaan dilarang sebagaimana yang dinyatakan dalam Jadual 6."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_87__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VII__cl_87",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima juta ringgit atau dipenjarakan selama tempoh tidak melebihi lima tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VI__cl_80",
      "@type": "akn:clause",
      "eli:number": "80",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Bahagian ini hendaklah terpakai bagi suatu pemberi kredit Islam yang menjalankan mana-mana perniagaan kredit Islam sebagaimana yang dinyatakan dalam perenggan 2 Jadual 2. Kewajipan untuk memastikan pematuhan Shariah"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VI__cl_81",
      "@type": "akn:clause",
      "eli:number": "81",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VI__cl_81__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VI__cl_81__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VI__cl_81__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VI__cl_81__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VI__cl_81__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VI__cl_81__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VI__cl_81",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu pemberi kredit Islam hendaklah pada setiap masa memastikan bahawa perniagaan kredit Islamnya, hal ehwalnya dan aktivitinya adalah mematuhi Shariah dan menguruskan perniagaannya, hal ehwal dan aktivitinya mengikut cara yang mematuhi Shariah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VI__cl_81__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VI__cl_81",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu pemberi kredit Islam boleh, melalui Pihak Berkuasa Pengawalseliaan dan Penyeliaannya, mendapatkan nasihat atau keputusan daripada Majlis Penasihat Shariah mengenai perkara Shariah berkenaan dengan perniagaan kredit Islamnya, hal ehwalnya atau aktivitinya yang menghendaki penentuan hukum Syarak oleh Majlis Penasihat Shariah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VI__cl_81__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VI__cl_81",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu pematuhan kepada apa-apa nasihat atau keputusan Majlis Penasihat Shariah berkenaan dengan apa-apa perniagaan kredit Islam, hal ehwal atau aktiviti tertentu hendaklah disifatkan sebagai suatu pematuhan kepada Shariah berkenaan dengan perniagaan, hal ehwal atau aktiviti itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VI__cl_81__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VI__cl_81",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu Pihak Berkuasa Pengawalseliaan dan Penyeliaan boleh menjalankan suatu penilaian sebagaimana yang ia fikirkan perlu untuk menentukan sama ada pemberi kredit Islam itu sedang menjalankan atau telah menjalankan perniagaan kredit Islamnya, hal ehwalnya atau aktivitinya mengikut cara yang mematuhi Shariah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VI__cl_81__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VI__cl_81",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pemberi kredit Islam yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi satu juta ringgit atau dipenjarakan selama tempoh tidak melebihi empat tahun atau kedua-duanya. Dasar dan tatacara dalaman mengenai perniagaan kredit Islam"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VI__cl_82",
      "@type": "akn:clause",
      "eli:number": "82",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VI__cl_82__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VI__cl_82__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VI__cl_82__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VI__cl_82",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu pemberi kredit Islam hendaklah, pada setiap masa memastikan bahawa dasar dan tatacara dalamannya mengenai perniagaan kredit Islam adalah selaras dengan peraturan-peraturan yang dibuat di bawah perenggan 122(2)(b) dan (c) dan standard atau garis panduan yang dibuat di bawah perenggan 123(2)(b) dan (c)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VI__cl_82__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VI__cl_82",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap pengarah, pekongsi atau pegawai suatu pemberi kredit Islam, dan seseorang yang dilantik oleh suatu pemberi kredit Islam untuk menasihati mengenai pematuhannya kepada Shariah hendaklah pada setiap masa mematuhi dasar dan tatacara dalaman yang diterima pakai oleh pemberi kredit Islam itu termasuk dasar dan tatacara dalaman untuk melaksanakan peraturan-peraturan yang dibuat di bawah perenggan 122(2)(b) dan (c) dan standard atau garis panduan yang dibuat di bawah perenggan 123(2)(b) dan (c). Rujukan kepada Majlis Penasihat Shariah daripada mahkamah atau penimbang tara"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VI__cl_83",
      "@type": "akn:clause",
      "eli:number": "83",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VI__cl_83__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VI__cl_83__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VI__cl_83__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VI__cl_83__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VI__cl_83__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VI__cl_83",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika dalam mana-mana prosiding yang berhubungan dengan suatu perniagaan kredit Islam di hadapan mana-mana mahkamah atau penimbang tara apa-apa persoalan berbangkit mengenai suatu perkara Shariah, mahkamah atau penimbang tara itu, mengikut mana-mana yang berkenaan, hendaklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VI__cl_83__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VI__cl_83__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mengambil kira mana-mana peraturan-peraturan yang dibuat di bawah perenggan 122(2)(b) dan standard atau garis panduan yang dibuat di bawah perenggan 123(2)(b); atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VI__cl_83__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VI__cl_83__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "merujuk persoalan itu kepada Majlis Penasihat Shariah untuk keputusannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VI__cl_83__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VI__cl_83",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa keputusan yang dibuat oleh Majlis Penasihat Shariah menurut suatu rujukan yang dibuat di bawah perenggan (1)(b) hendaklah mengikat mahkamah atau penimbang tara yang membuat rujukan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_40__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_40__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_40__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_40",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh menjalankan apa-apa perniagaan kredit sebagaimana yang dinyatakan dalam perenggan 1 atau perenggan 2 Jadual 4 atau mengemukakan dirinya sebagai menjalankan perniagaan itu melainkan jika dia adalah suatu pemberi kredit berlesen."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_40__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_40",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima juta ringgit atau dipenjarakan selama tempoh tidak melebihi lima tahun atau kedua-duanya. Permohonan untuk lesen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_41",
      "@type": "akn:clause",
      "eli:number": "41",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_41__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_41__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_41__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_41__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_41__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_41__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_41__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_41__subsec_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_41__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang berniat untuk menjalankan suatu perniagaan kredit sebagaimana yang dinyatakan dalam perenggan 1 atau perenggan 2 Jadual 4 hendaklah mengemukakan suatu permohonan kepada Suruhanjaya atau Pendaftar, mengikut mana-mana yang berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_41__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_41__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_41__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "Permohonan di bawah subseksyen (1) hendaklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_41__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_41__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dibuat kepada Suruhanjaya atau Pendaftar, mengikut mana-mana yang berkenaan, dalam apa-apa bentuk dan mengikut cara sebagaimana yang ditentukan oleh Suruhanjaya atau Pendaftar; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_41__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_41__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "disertakan dengan pembayaran fi yang ditetapkan dan apa-apa maklumat, butir-butir atau dokumen sebagaimana yang ditentukan oleh Suruhanjaya atau Pendaftar, mengikut mana-mana yang berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_41__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_41__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_41__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya atau Pendaftar, mengikut mana-mana yang berkenaan, boleh pada bila-bila masa selepas penerimaan suatu permohonan di bawah subseksyen (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_41__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_41__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "menjalankan apa-apa siasatan sebagaimana yang difikirkannya perlu, termasuk menjalankan pemeriksaan terhadap latar belakang kewangan, profesional, jenayah atau yang lain ke atas pemohon dan pengawal, pengarah, pekongsi dan pengurusan kanan pemohon itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_41__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_41__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "melalui suatu notis bertulis menghendaki pemohon itu untuk memberinya apa-apa dokumen atau maklumat sebagaimana yang disifatkan perlu oleh Suruhanjaya atau Pendaftar, mengikut mana-mana yang berkenaan, berhubung dengan permohonan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_41__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_41__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_41__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika apa-apa dokumen atau maklumat tambahan yang dikehendaki di bawah perenggan (3)(b) tidak diberikan oleh pemohon itu dalam tempoh yang ditentukan dalam notis bertulis itu atau apa-apa tempoh lanjutan yang diberikan oleh Suruhanjaya atau Pendaftar, mengikut mana-mana yang berkenaan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_41__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_41__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "permohonan itu tidak lagi boleh diteruskan, tetapi tanpa menjejaskan hak pemohon itu untuk membuat suatu permohonan baharu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_41__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_41__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "tiada bayaran balik bagi fi yang telah dibayar oleh pemohon itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_41__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_41__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_41__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu pemohon menarik balik suatu permohonan yang telah dikemukakan di bawah subseksyen (2)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_41__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_41__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "ia tidak akan menjejaskan hak pemohon itu untuk membuat suatu permohonan baharu selepas suatu tempoh sebagaimana yang ditentukan oleh Suruhanjaya atau Pendaftar, mengikut mana-mana yang berkenaan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_41__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_41__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "tiada bayaran balik bagi fi yang telah dibayar oleh pemohon itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_41__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "Setelah menerima suatu permohonan dan bayaran fi serta pengemukaan maklumat, butir-butir atau dokumen di bawah subseksyen (2) dan apa-apa dokumen atau maklumat tambahan yang diberi di bawah perenggan (3)(b), Suruhanjaya atau Pendaftar, mengikut mana-mana yang berkenaan, boleh mempertimbangkan permohonan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_41__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu pemberi kredit berlesen yang berniat untuk menjalankan suatu perniagaan kredit yang berikutnya sebagaimana yang dinyatakan dalam perenggan 1 atau perenggan 2 Jadual 4 hendaklah mengemukakan permohonan lain kepada Suruhanjaya atau Pendaftar, mengikut mana-mana yang berkenaan, mengikut seksyen ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_41__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada apa-apa dalam Akta ini boleh melarang atau menyekat mana-mana pemberi kredit berlesen yang dikawal selia oleh Suruhanjaya daripada menjalankan suatu perniagaan kredit Islam sebagai tambahan kepada perniagaan kredit konvensionalnya, dengan syarat pemberi kredit berlesen itu mendapat kelulusan bertulis Suruhanjaya terlebih dahulu. Pemberian lesen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_42",
      "@type": "akn:clause",
      "eli:number": "42",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_42__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_42__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_42__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_42__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_42__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_42__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_42__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_42",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya atau Pendaftar, mengikut mana-mana yang berkenaan, boleh memberikan suatu lesen jika Suruhanjaya atau Pendaftar berpuas hati bahawa pemohon itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_42__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_42__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "memenuhi kehendak kewangan minimum di bawah seksyen 44; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_42__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_42__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mematuhi mana-mana peraturan-peraturan, standard atau garis panduan, atau kehendak lain yang berhubungan dengan pelesenan di bawah Akta ini atau syarat sebagaimana yang ditentukan oleh Suruhanjaya atau Pendaftar, mengikut mana-mana yang berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_42__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_42__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_42__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_42",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya atau Pendaftar, mengikut mana-mana yang berkenaan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_42__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_42__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam memberikan suatu lesen di bawah subseksyen (1), boleh menentukan apa-apa syarat bagi lesen itu sebagaimana yang Suruhanjaya atau Pendaftar fikirkan patut untuk dikenakan, mengikut mana-mana yang berkenaan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_42__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_42__subsec_2__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_42__subsec_2__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_42__subsec_2__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_42__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "boleh pada bila-bila masa semasa tempoh lesen itu mengeluarkan suatu notis bertulis untuk—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_42__subsec_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_42__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "mengenakan apa-apa syarat tambahan atau baharu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_42__subsec_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_42__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "meminda atau mengubah mana-mana syarat itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_42__subsec_2__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_42__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "membatalkan atau mengenepikan mana-mana syarat itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_42__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_42",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Suruhanjaya atau Pendaftar, mengikut mana-mana yang berkenaan, menambah, meminda, mengubah, membatalkan atau mengenepikan mana-mana syarat di bawah subseksyen (2), penambahan, pindaan, pengubahan, pembatalan atau pengenepian itu hendaklah berkuat kuasa pada masa penyampaian notis itu atau pada masa sebagaimana yang ditentukan oleh Suruhanjaya atau Pendaftar, mengikut mana-mana yang berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_42__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_42",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang tidak mematuhi mana-mana syarat suatu lesen yang dikenakan di bawah subseksyen (2) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi satu juta ringgit atau dipenjarakan selama tempoh tidak melebihi empat tahun atau kedua-duanya. Alasan bagi penolakan lesen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_43",
      "@type": "akn:clause",
      "eli:number": "43",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_43__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_43__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_43__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_43__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_43__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_43__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_43__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_43__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya atau Pendaftar, mengikut mana-mana yang berkenaan, boleh menolak permohonan untuk suatu lesen atas mana-mana alasan yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_43__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_43__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "permohonan itu tidak dibuat mengikut Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_43__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_43__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pemohon telah tidak mematuhi mana-mana peraturan-peraturan, standard atau garis panduan, atau kehendak yang lain di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_43__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_43__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pemohon telah tidak memuaskan hati Suruhanjaya atau Pendaftar, mengikut mana-mana yang berkenaan, bahawa pemohon, pengawalnya, pengarahnya, pekongsinya dan pengurusan kanannya, adalah layak dan sesuai;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_43__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_43__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa dokumen atau maklumat yang diberikan oleh pemohon kepada Suruhanjaya atau Pendaftar, mengikut mana-mana yang berkenaan, adalah palsu atau mengelirukan atau daripadanya terdapat ketinggalan yang material; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_43__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_43__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya atau Pendaftar, mengikut mana-mana yang berkenaan, berpendapat bahawa ia adalah bertentangan dengan kepentingan awam untuk memberikan suatu lesen kepada pemohon itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_43__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_43__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_43__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_43__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Suruhanjaya atau Pendaftar menolak suatu permohonan di bawah subseksyen (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_43__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_43__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya atau Pendaftar hendaklah memberitahu pemohon itu secara bertulis mengenai penolakan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_43__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_43__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "penolakan itu hendaklah tidak menjejaskan hak pemohon itu untuk membuat suatu permohonan baharu setelah suatu tempoh sebagaimana yang ditentukan oleh Suruhanjaya atau Pendaftar, mengikut mana-mana yang berkenaan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_43__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_43__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "tiada bayaran balik bagi fi yang telah dibayar oleh pemohon itu. Kehendak kewangan minimum bagi pelesenan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_44",
      "@type": "akn:clause",
      "eli:number": "44",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_44__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_44__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_44__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_44__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_44",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh dilesenkan di bawah seksyen 42 jika orang itu tidak memenuhi kehendak kewangan minimum sebagaimana yang ditentukan oleh Suruhanjaya atau Pendaftar, mengikut mana-mana yang berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_44__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_44",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam menjalankan perniagaan kreditnya, suatu pemberi kredit berlesen hendaklah mematuhi, pada setiap masa, kehendak kewangan minimum sebagaimana yang ditentukan oleh Suruhanjaya atau Pendaftar, mengikut mana-mana berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_44__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_44",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu pemberi kredit berlesen tidak boleh terus menjalankan mana-mana perniagaan kredit tanpa keizinan bertulis terdahulu Suruhanjaya atau Pendaftar, mengikut mana-mana yang berkenaan, jika ia tidak memenuhi kehendak kewangan minimum yang ditentukan di bawah subseksyen (1). Kehendak layak dan sesuai pemberi kredit berlesen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_45",
      "@type": "akn:clause",
      "eli:number": "45",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_45__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_45__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_45__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_45__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_45__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_45__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_45",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya atau Pendaftar, mengikut mana-mana yang berkenaan, boleh menentukan kehendak layak dan sesuai yang terpakai bagi seorang pengawal, pengarah, pekongsi atau pengurusan kanan suatu pemberi kredit berlesen, yang boleh termasuk kriteria minimum yang berhubungan dengan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_45__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_45__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "kejujuran, integriti peribadi dan reputasi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_45__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_45__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "kekompetenan dan kebolehan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_45__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_45__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "integriti kewangan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_45__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_45",
      "schema:text": {
        "@language": "ms",
        "@value": "Seorang pengawal, pengarah, pekongsi atau pengurusan kanan suatu pemberi kredit berlesen hendaklah pada setiap masa mematuhi kehendak layak dan sesuai sebagaimana yang ditentukan di bawah subseksyen (1). Pengarah dan pengurusan kanan pemberi kredit berlesen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_46",
      "@type": "akn:clause",
      "eli:number": "46",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_46__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_46__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_46__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_46__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_46__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_46__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_46__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_46__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_46__subsec_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_46__subsec_10"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_46__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_46__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_46__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu pemberi kredit berlesen hendaklah hanya melantik atau melantik semula mana-mana orang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_46__subsec_10",
      "@type": "akn:subsection",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1), (4), (5) atau (9) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tiga tahun atau kedua-duanya. Pengawal pemberi kredit berlesen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_46__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_46__subsec_1__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_46__subsec_1__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_46__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal suatu pemberi kredit berlesen yang dikawal selia oleh Suruhanjaya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_46__subsec_1__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_46__subsec_1__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "sebagai pengarahnya atau pengurusan kanannya jika orang itu telah memenuhi kehendak layak dan sesuai sebagaimana yang ditentukan oleh Suruhanjaya di bawah seksyen 45; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_46__subsec_1__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_46__subsec_1__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "sebagai ketua eksekutifnya tertakluk kepada pemerolehan suatu kelulusan bertulis terdahulu Suruhanjaya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_46__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_46__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_46__subsec_1__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_46__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal suatu pemberi kredit berlesen yang dikawal selia oleh Kementerian Perumahan dan Kerajaan Tempatan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_46__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_46__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "sebagai pengarahnya, pekongsinya atau pengurusan kanannya jika orang itu telah memenuhi kehendak layak dan sesuai sebagaimana yang ditentukan oleh Pendaftar di bawah seksyen 45; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_46__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_46__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "sebagai pengarahnya atau pekongsinya tertakluk kepada pemerolehan suatu kelulusan bertulis terdahulu Pendaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_46__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam hal suatu pemberi kredit berlesen yang dikawal selia oleh Suruhanjaya, pemberi kredit berlesen itu hendaklah memberikan suatu notis bertulis kepada Suruhanjaya mengenai pelantikan atau pelantikan semula pengarahnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_46__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu perkara berbangkit sama ada seseorang telah mematuhi kehendak layak dan sesuai yang ditentukan di bawah seksyen 45, Suruhanjaya atau Pendaftar, mengikut mana-mana yang berkenaan, hendaklah mempunyai budi bicara penuh untuk menentukan perkara itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_46__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seorang pengarah, pekongsi atau pengurusan kanan kemudiannya menyedari bahawa dia tidak mematuhi kehendak layak dan sesuai yang ditentukan di bawah seksyen 45, dia hendaklah dengan serta-merta memaklumkan kepada pemberi kredit berlesen itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_46__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seorang pengarah, pekongsi atau pengurusan kanan tidak mematuhi kehendak layak dan sesuai yang ditentukan di bawah seksyen 45, pemberi kredit berlesen itu hendaklah dengan serta-merta memecatnya daripada jawatan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_46__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada seksyen 131, Suruhanjaya atau Pendaftar, mengikut mana-mana yang berkenaan, boleh mengarahkan suatu pemberi kredit berlesen untuk memecat pengarah, pekongsi atau pengurusan kanan yang tidak mematuhi kehendak layak dan sesuai di bawah seksyen 45 dalam apa-apa tempoh sebagaimana yang ditentukan oleh Suruhanjaya atau Pendaftar, mengikut mana-mana yang berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_46__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun apa-apa jua yang terkandung dalam apa-apa kontrak perkhidmatan atau apa-apa perjanjian lain yang berhubungan dengan pelantikannya, pemecatan seorang pengarah, pekongsi atau pengurusan kanan di bawah subseksyen (5) atau (6) adalah menurut undang-undang dan sah dan pengarah, pekongsi atau pengurusan kanan yang dipecat di bawah subseksyen (5) atau (6) tidaklah berhak untuk menuntut apa-apa pampasan bagi pemecatan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_46__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu pemberi kredit berlesen yang dikawal selia oleh Suruhanjaya hendaklah memberitahu Suruhanjaya secara bertulis bahawa pengarahnya atau pengurusan kanannya telah terhenti memegang jawatan dan bertindak atas keupayaan sedemikian dan sebab bagi pemberhentian itu dalam suatu tempoh yang ditentukan oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_46__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_46",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu pemberi kredit berlesen yang dikawal selia oleh Kementerian Perumahan dan Kerajaan Tempatan hendaklah memberitahu Pendaftar secara bertulis hakikat bahawa pengarahnya atau pekongsinya telah terhenti memegang jawatan dan bertindak atas keupayaan sedemikian tidak melebihi empat belas hari selepas pemberhentian itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47",
      "@type": "akn:clause",
      "eli:number": "47",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh mempunyai kawalan ke atas suatu pemberi kredit berlesen melainkan jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "orang itu telah memenuhi kehendak layak dan sesuai sebagaimana yang ditentukan di bawah seksyen 45 oleh Suruhanjaya atau Pendaftar, mengikut mana-mana yang berkenaan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "orang itu telah mendapat kelulusan bertulis terdahulu Suruhanjaya atau Pendaftar, mengikut mana-mana yang berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang berniat untuk menjadi seorang pengawal hendaklah mengemukakan suatu permohonan kepada Suruhanjaya atau Pendaftar, mengikut mana-mana yang berkenaan, dalam apa-apa bentuk atau mengikut cara sebagaimana yang ditentukan Suruhanjaya atau Pendaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya atau Pendaftar, mengikut mana-mana yang berkenaan, boleh, pada bila-bila masa selepas penerimaan suatu permohonan di bawah subseksyen (2)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "menjalankan penyiasatan sebagaimana yang difikirkannya perlu, termasuk menjalankan pemeriksaan terhadap latar belakang kewangan, profesional, jenayah atau yang lain ke atas orang itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "melalui suatu notis bertulis menghendaki orang itu untuk memberikan kepadanya apa-apa dokumen atau maklumat tambahan sebagaimana yang disifatkan perlu oleh Suruhanjaya atau Pendaftar, mengikut mana-mana yang berkenaan, berhubung dengan permohonan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu perkara berbangkit sama ada seorang pengawal telah mematuhi kehendak layak dan sesuai yang ditentukan di bawah seksyen 45, Suruhanjaya atau Pendaftar, mengikut mana-mana yang berkenaan, hendaklah mempunyai budi bicara penuh untuk menentukan perkara itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seorang pengawal tidak atau telah tidak mematuhi kehendak layak dan sesuai sebagaimana yang ditentukan di bawah seksyen 45 oleh Suruhanjaya atau Pendaftar, mengikut mana-mana yang berkenaan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu pemberi kredit berlesen hendaklah memberitahu Suruhanjaya atau Pendaftar, mengikut mana-mana yang berkenaan, secara bertulis mengenai ketidakpatuhan itu dalam tempoh sebagaimana yang ditentukan oleh Suruhanjaya atau Pendaftar; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47__subsec_5__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47__subsec_5__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "pengawal itu hendaklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47__subsec_5__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47__subsec_5__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "melupuskan pemegangan syer yang menjadikannya sebagai pengawal itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47__subsec_5__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47__subsec_5__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "terhenti mempunyai kawalan dalam, pemberi kredit berlesen itu dalam suatu tempoh atau mana-mana tempoh lanjut, dan tertakluk kepada apa-apa syarat sebagaimana yang ditentukan oleh Suruhanjaya atau Pendaftar, mengikut mana-mana yang berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47__subsec_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47__subsec_6__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47__subsec_6__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini, “pengawal” ertinya seseorang yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47__subsec_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "berhak untuk menjalankan, atau mengawal penjalanan, tidak kurang daripada tiga puluh tiga peratus undi yang dikaitkan dengan syer mengundi dalam suatu pemberi kredit berlesen;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47__subsec_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "mempunyai kuasa untuk melantik, atau menyebabkan dilantik, suatu majoriti pengarah suatu pemberi kredit berlesen; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47__subsec_6__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "mempunyai kuasa untuk membuat, atau menyebabkan dibuat, keputusan berkenaan dengan perniagaan atau pentadbiran suatu pemberi kredit berlesen, dan untuk memberi kesan kepada keputusan itu atau menyebabkan keputusan itu diberikan kesan kepadanya, dan perkataan “kawalan” hendaklah ditafsirkan sewajarnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1) atau (5) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tiga tahun atau kedua-duanya. Pemerolehan kepentingan dalam syer pemberi kredit berlesen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_48",
      "@type": "akn:clause",
      "eli:number": "48",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_48__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_48__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_48__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_48__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_48__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_48__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_48",
      "schema:text": {
        "@language": "ms",
        "@value": "Kecuali dengan kelulusan bertulis terdahulu Suruhanjaya, tiada seorang pun boleh memperoleh mana-mana kepentingan dalam syer suatu pemberi kredit berlesen yang dikawal selia oleh Suruhanjaya dengan membuat suatu perjanjian atau perkiraan atau dalam apa cara sekalipun, jika pemerolehan itu akan menyebabkan orang itu memegang, berserta dengan apa-apa kepentingan dalam syer pemberi kredit berlesen itu yang telah ada dipegang olehnya, suatu kepentingan agregat tiga puluh tiga peratus atau lebih dalam syer pemberi kredit berlesen itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_48__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_48",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya boleh menentukan perkara yang menjadi “kepentingan dalam syer” bagi maksud subseksyen (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_48__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_48",
      "schema:text": {
        "@language": "ms",
        "@value": "Kecuali dengan kelulusan bertulis terdahulu Pendaftar, tiada seorang pun boleh menjadi suatu pemegang syer substansial suatu pemberi kredit berlesen yang dikawal selia oleh Kementerian Perumahan dan Kerajaan Tempatan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_48__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_48",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud subseksyen (3), “pemegang syer substansial” hendaklah mempunyai erti sebagaimana yang diberikan kepadanya di bawah seksyen 136 Akta Syarikat 2016."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_48__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_48",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1) atau (3) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tiga tahun atau kedua-duanya. Pelantikan juruaudit oleh pemberi kredit berlesen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49",
      "@type": "akn:clause",
      "eli:number": "49",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_9"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu pemberi kredit berlesen, atas perbelanjaannya sendiri, hendaklah melantik secara tahunan seorang juruaudit bagi menjalankan suatu pengauditan ke atas perniagaan kreditnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya atau Pendaftar, mengikut mana-mana yang berkenaan, boleh dalam apa-apa tempoh sebagaimana yang ditentukan oleh Suruhanjaya atau Pendaftar, menghendaki seseorang juruaudit yang dilantik di bawah subseksyen (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "supaya memperbesar atau memperluas ruang lingkup pengauditan yang dijalankan di bawah subseksyen (1);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "supaya menjalankan suatu pemeriksaan atau mengadakan apa-apa tatacara dalam apa-apa hal tertentu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_2__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_2__para_c__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "supaya mengemukakan kepada Suruhanjaya atau Pendaftar, mengikut mana-mana yang berkenaan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_2__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_2__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa maklumat sebagaimana yang dikehendaki oleh Suruhanjaya atau Pendaftar, mengikut mana-mana yang berkenaan, berhubung dengan pengauditan yang dijalankan oleh juruaudit; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_2__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_2__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu laporan tentang apa-apa perkara dalam perenggan (a) dan (b)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_3__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud subperenggan (2)(c)(i), maklumat yang dikehendaki berhubung dengan pengauditan itu boleh termasuk yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "penyata kewangan perniagaan kredit itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "bilangan transaksi yang berhubungan dengan perniagaan kredit itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu laporan tentang sama ada rekod yang sepatutnya bagi transaksi berhubung dengan perniagaan kredit itu telah disenggarakan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu laporan tentang sama ada pemberi kredit berlesen itu telah mematuhi peruntukan Akta ini dan mana-mana undang-undang bertulis yang lain sebagaimana yang ditentukan oleh Suruhanjaya atau Pendaftar, mengikut mana-mana yang berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49",
      "schema:text": {
        "@language": "ms",
        "@value": "Pemberi kredit berlesen itu hendaklah mengemukakan suatu salinan laporan audit yang telah ditandatangani dengan sempurna oleh juruaudit itu kepada Suruhanjaya atau Pendaftar, mengikut mana-mana yang berkenaan, tidak lewat daripada tiga bulan atau apa-apa tempoh lain, selepas berakhirnya tahun kewangan pemberi kredit berlesen itu sebagaimana yang ditentukan oleh Suruhanjaya atau Pendaftar, mengikut mana-mana yang berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika semasa melaksanakan kewajipannya di bawah seksyen ini, seorang juruaudit yang dilantik di bawah subseksyen (1) mengesyaki atau mempunyai pengetahuan bahawa pemberi kredit berlesen itu telah melakukan apa-apa kesalahan di bawah Akta ini atau mana-mana undang-undang bertulis yang lain—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "juruaudit itu hendaklah dengan serta-merta melaporkan perkara itu kepada Suruhanjaya atau Pendaftar, mengikut mana-mana yang berkenaan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_5__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_5__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "juruaudit itu tidaklah bertanggungan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_5__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_5__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi suatu kemungkiran suatu kewajipan kerahsiaan antara juruaudit dan pemberi kredit itu berkenaan dengan apa-apa pelaporan kepada Suruhanjaya atau Pendaftar, mengikut mana-mana yang berkenaan, yang dibuat dengan suci hati di bawah Akta ini; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_5__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_5__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk dibawa guaman dalam mana-mana mahkamah bagi fitnah berkenaan dengan apa-apa penyataan yang dibuat oleh juruaudit itu tanpa niat jahat dalam penunaian kewajipannya di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49",
      "schema:text": {
        "@language": "ms",
        "@value": "Saraan dan perbelanjaan juruaudit itu yang berhubungan dengan apa-apa perkhidmatan di bawah seksyen ini hendaklah ditanggung oleh pemberi kredit berlesen itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini, “penyata kewangan” termasuklah kunci kira-kira tahunan terkini yang telah diaudit, akaun untung dan rugi, dan penyata yang menyatakan sumber dana, suatu pemberi kredit berlesen."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu pemberi kredit berlesen yang melanggar subseksyen (1) atau (4) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tiga tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_49",
      "schema:text": {
        "@language": "ms",
        "@value": "Seorang juruaudit yang melanggar subseksyen (2) atau perenggan (5)(a) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tiga tahun atau kedua-duanya. Pembatalan atau penggantungan lesen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_50",
      "@type": "akn:clause",
      "eli:number": "50",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_50__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_50__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_50__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_50__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_50",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu lesen yang diberikan kepada suatu pemberi kredit di bawah seksyen 42 hendaklah disifatkan telah dibatalkan jika perniagaan kreditnya telah digulungkan atau selainnya dibubarkan, sama ada di dalam atau di luar Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_50__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_50__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_50__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_50__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_50",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada seksyen 131, Suruhanjaya atau Pendaftar, mengikut mana-mana yang berkenaan, boleh membatalkan suatu lesen atas mana-mana alasan yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_50__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_50__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya atau Pendaftar, mengikut mana-mana yang berkenaan, berkaitan dengan permohonan di bawah seksyen 41, telah diberikan maklumat yang palsu atau mengelirukan, tidak tepat atau tidak lengkap yang daripadanya terdapat ketinggalan yang material;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_50__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_50__subsec_2__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_50__subsec_2__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_50__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pemberi kredit berlesen itu tidak atau telah tidak mematuhi—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_50__subsec_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_50__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "mana–mana peruntukan Akta ini atau mana-mana kehendak lain sebagaimana yang ditetapkan atau ditentukan oleh Suruhanjaya atau Pendaftar, mengikut mana-mana yang berkenaan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_50__subsec_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_50__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "mana–mana syarat yang berkenaan dengan lesennya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_50__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_50__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "ia adalah demi kepentingan pengguna kredit atau awam untuk berbuat sedemikian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_50__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_50__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_50__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_50",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika subseksyen (2) terpakai, Suruhanjaya atau Pendaftar, mengikut mana-mana yang berkenaan, boleh, jika ia berpendapat perlu untuk berbuat sedemikian—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_50__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_50__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "menggantung lesen itu bagi suatu tempoh tertentu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_50__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_50__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "pada bila-bila masa melanjutkan atau membatalkan penggantungan lesen itu. Penyerahan balik lesen secara sukarela"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_51",
      "@type": "akn:clause",
      "eli:number": "51",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_51__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_51__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_51__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_51__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_51__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_51__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_51",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu pemberi kredit berlesen yang dikawal selia oleh Suruhanjaya boleh memohon untuk menyerah balik lesennya secara sukarela dalam bentuk dan mengikut cara sebagaimana yang ditentukan oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_51__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_51",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu pemberi kredit berlesen yang dikawal selia oleh Kementerian Perumahan dan Kerajaan Tempatan boleh menyerah balik lesennya atas usahanya sendiri dengan menyampaikan lesen itu kepada Pendaftar bersama suatu notis bertulis mengenai penyerahan lesen itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_51__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_51",
      "schema:text": {
        "@language": "ms",
        "@value": "Penyerahan balik lesen di bawah subseksyen (1) hendaklah berkuat kuasa setelah mendapat suatu kelulusan bertulis oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_51__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_51",
      "schema:text": {
        "@language": "ms",
        "@value": "Penyerahan balik lesen di bawah subseksyen (2) hendaklah berkuat kuasa empat belas hari daripada tarikh Pendaftar menerima lesen dan notis bertulis itu atau mana-mana tarikh lain sebagaimana yang ditentukan oleh Pendaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_51__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_51",
      "schema:text": {
        "@language": "ms",
        "@value": "Setelah penyerahan balik lesen di bawah seksyen ini, tiada bayaran balik bagi apa-apa fi yang telah dibayar oleh pemberi kredit lesen itu. Kesan pembatalan, penggantungan dan penyerahan balik lesen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_52",
      "@type": "akn:clause",
      "eli:number": "52",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_52__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_52__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_52__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_52__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_52__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_52__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_52__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_52",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang hendaklah dengan serta merta terhenti menjalankan perniagaan kreditnya jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_52__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_52__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya atau Pendaftar, mengikut mana-mana yang berkenaan, membatalkan atau menggantung suatu lesen di bawah seksyen 50; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_52__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_52__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "penyerahan balik suatu lesen telah berkuat kuasa di bawah subseksyen 51(3) atau (4)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_52__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_52__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_52__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_52",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (1), orang yang disebutkan dalam subseksyen (1) hendaklah terus—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_52__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_52__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "tertakluk kepada Akta ini pada takat yang sama sebagaimana suatu pemberi kredit berlesen; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_52__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_52__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menunaikan obligasinya termasuk, tertakluk kepada kelulusan bertulis terdahulu Suruhanjaya atau Pendaftar, mengikut mana-mana yang berkenaan, untuk menjalankan perniagaan kreditnya semata-mata bagi maksud penggulungan hal ehwalnya atau bagi maksud yang benefisial untuk pengguna kreditnya atau orang lain yang berurusan dengannya, sehingga Suruhanjaya atau Pendaftar, mengikut mana-mana yang berkenaan, berpuas hati bahawa orang itu telah menunaikan obligasinya, atau bahawa perkiraan yang mencukupi telah dibuat untuk menunaikan obligasinya, yang belum selesai pada masa pembatalan, penggantungan atau penyerahan balik."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_52__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_52__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_52__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_52",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu pembatalan, penggantungan atau penyerahan balik yang disebutkan dalam subseksyen (1) tidak—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_52__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_52__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "mengelak atau menjejaskan mana-mana perjanjian, perkiraan atau transaksi yang dibuat oleh orang yang disebutkan dalam subseksyen (1) dengan mana-mana orang; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_52__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_52__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "menjejaskan apa-apa hak, obligasi atau liabiliti yang berbangkit di bawah mana-mana perjanjian, perkiraan atau transaksi itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_52__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_52",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1) atau tidak menunaikan obligasinya di bawah subseksyen (2) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima juta ringgit atau dipenjarakan selama tempoh tidak melebihi lima tahun atau kedua-duanya. Fi yang kena dibayar oleh pemberi kredit berlesen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_53",
      "@type": "akn:clause",
      "eli:number": "53",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_53__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_53__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_53__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_53__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_53__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_53",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu pemberi kredit berlesen hendaklah membayar fi sebagaimana yang ditetapkan oleh Menteri atau Menteri Perumahan dan Kerajaan Tempatan, mengikut mana-mana yang berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_53__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_53",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu pemberi kredit berlesen yang dikawal selia oleh Suruhanjaya tidak membayar fi yang ditetapkan di bawah subseksyen (1) pada tarikh fi itu perlu dibayar kepada Suruhanjaya, bagi setiap bulan pembayaran itu lewat, pemberi kredit berlesen itu hendaklah membayar suatu fi pembayaran lewat dalam suatu amaun yang ditetapkan oleh Menteri dan fi itu boleh didapatkan kembali oleh Suruhanjaya sebagai suatu hutang sivil kena dibayar kepada Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_53__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_53",
      "schema:text": {
        "@language": "ms",
        "@value": "Fi yang ditetapkan yang dibayar kepada, atau didapatkan kembali oleh Suruhanjaya di bawah seksyen ini hendaklah dibayar ke dalam dan menjadi sebahagian Kumpulan Wang yang ditubuhkan di bawah seksyen 26."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_53__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_53",
      "schema:text": {
        "@language": "ms",
        "@value": "Fi yang ditetapkan yang dibayar kepada Pendaftar di bawah seksyen ini hendaklah dibayar ke dalam dan menjadi sebahagian Kumpulan Wang Disatukan Persekutuan. Penubuhan, penempatan semula atau penutupan cawangan, dsb., pemberi kredit berlesen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_54",
      "@type": "akn:clause",
      "eli:number": "54",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_54__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_54__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_54__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_54__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_54",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu pemberi kredit berlesen yang dikawal selia oleh Suruhanjaya hendaklah mematuhi kehendak penubuhan, penempatan semula atau penutupan cawangannya sebagaimana yang ditentukan oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_54__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_54",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu pemberi kredit berlesen yang dikawal selia oleh Kementerian Perumahan dan Kerajaan Tempatan tidak boleh menjalankan perniagaan kreditnya di mana-mana tempat lain selain di alamat atau alamat-alamat yang dibenarkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_54__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_54",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (2) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tiga tahun atau kedua-duanya. Pemindahan atau penyerahhakan lesen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_55",
      "@type": "akn:clause",
      "eli:number": "55",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_55__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_55__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_55__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_55__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_55__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_55__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_55__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_55",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu pemberi kredit berlesen tidak boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_55__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_55__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "memindah atau menyerahhak lesennya kepada mana-mana orang lain; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_55__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_55__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menyebabkan atau membenarkan mana-mana orang lain untuk menggunakan lesen itu atau menjalankan perniagaan kredit yang ditentukan dalam lesen itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_55__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_55",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (1), suatu pemberi kredit berlesen yang dikawal selia oleh Kementerian Perumahan dan Kerajaan Tempatan boleh, dengan keizinan bertulis terdahulu Pendaftar, melantik mana-mana orang bagi maksud menjalankan apa-apa hak yang diberikan kepada pemberi kredit berlesen itu di bawah lesen itu, atau menyebabkan atau membenarkan mana-mana orang itu untuk menjalankan mana-mana hak sedemikian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_55__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_55__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_55__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_55",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (1), Pendaftar boleh membenarkan pemindahan suatu lesen jika Pendaftar berpuas hati bahawa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_55__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_55__subsec_3__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_55__subsec_3__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_55__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "pemberi kredit berlesen itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_55__subsec_3__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_55__subsec_3__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "merupakan suatu syarikat, yang telah dilikuidasikan dan seorang penerima atau pengurus telah dilantik berhubung dengan perniagaan kredit syarikat itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_55__subsec_3__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_55__subsec_3__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "merupakan suatu pertubuhan, firma atau mana-mana badan orang yang lain, yang telah dibubarkan dan seorang penerima atau pengurus telah dilantik berhubung dengan perniagaan kredit pertubuhan, firma atau mana-mana badan orang yang lain itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_55__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_55__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "adalah menjadi adil untuk berbuat demikian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_55__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_55",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi satu juta ringgit atau dipenjarakan selama tempoh tidak melebihi empat tahun atau kedua-duanya. Jualan, pelupusan, pajakan, dsb., perniagaan kredit"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_56",
      "@type": "akn:clause",
      "eli:number": "56",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_56__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_56__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_56__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_56__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_56__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_56",
      "schema:text": {
        "@language": "ms",
        "@value": "Kecuali dengan kelulusan bertulis terdahulu Suruhanjaya atau Pendaftar, mengikut mana-mana yang berkenaan, tiada suatu pemberi kredit berlesen boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_56__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_56__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menjual, melupus, memajak, menyerahhak atau memindah bagaimana jua cara sekalipun, keseluruhan atau mana-mana bahagian perniagaan kreditnya kepada mana-mana orang lain; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_56__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_56__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menyatu atau mencantum perniagaan kreditnya dengan mana-mana orang lain."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_56__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_56",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu pemberi kredit berlesen yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi satu juta ringgit atau dipenjarakan selama tempoh tidak melebihi empat tahun atau kedua-duanya. Penggal 2 Pendaftaran Kehendak untuk pendaftaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_57",
      "@type": "akn:clause",
      "eli:number": "57",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_57__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_57__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_57__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_57",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh menjalankan perniagaan perkhidmatan kredit sebagaimana yang dinyatakan dalam perenggan 3 Jadual 4 atau mengemukakan dirinya sebagai menjalankan perniagaan itu melainkan jika dia adalah suatu pemberi perkhidmatan kredit berdaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_57__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_57",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima juta ringgit atau dipenjarakan selama tempoh tidak melebihi lima tahun atau kedua-duanya. Permohonan untuk pendaftaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_58",
      "@type": "akn:clause",
      "eli:number": "58",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_58__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_58__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_58__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_58__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_58__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_58__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_58__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_58__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_58",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang berniat untuk menjalankan suatu perniagaan perkhidmatan kredit sebagaimana yang dinyatakan dalam perenggan 3 Jadual 4 hendaklah mengemukakan suatu permohonan kepada Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_58__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_58__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_58__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_58",
      "schema:text": {
        "@language": "ms",
        "@value": "Permohonan di bawah subseksyen (1) hendaklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_58__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_58__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dibuat kepada Suruhanjaya dalam apa-apa bentuk dan mengikut cara sebagaimana yang ditentukan oleh Suruhanjaya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_58__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_58__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "disertakan dengan pembayaran fi yang ditetapkan dan apa-apa maklumat, butir-butir atau dokumen sebagaimana yang ditentukan oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_58__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_58__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_58__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_58",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya boleh pada bila-bila masa selepas penerimaan suatu permohonan di bawah subseksyen (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_58__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_58__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "menjalankan apa-apa siasatan sebagaimana yang difikirkannya perlu, termasuk menjalankan pemeriksaan terhadap latar belakang kewangan, profesional, jenayah atau yang lain ke atas pemohon dan pengawal, pengarah dan pengurusan kanan pemohon itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_58__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_58__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "melalui suatu notis bertulis menghendaki pemohon itu untuk memberinya apa-apa dokumen atau maklumat sebagaimana yang disifatkan perlu oleh Suruhanjaya berhubung dengan permohonan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_58__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_58__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_58__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_58",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika apa-apa dokumen atau maklumat tambahan yang dikehendaki di bawah perenggan (3)(b) tidak diberikan oleh pemohon itu dalam tempoh yang ditentukan dalam notis bertulis itu atau apa-apa tempoh lanjutan yang diberikan oleh Suruhanjaya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_58__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_58__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "permohonan itu tidak lagi boleh diteruskan, tetapi tanpa menjejaskan hak pemohon itu untuk membuat suatu permohonan baharu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_58__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_58__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "tiada bayaran balik bagi fi yang telah dibayar oleh pemohon itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_58__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_58__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_58__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_58",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu pemohon menarik balik suatu permohonan yang telah dikemukakan di bawah subseksyen (2)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_58__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_58__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "ia tidak akan menjejaskan hak pemohon itu untuk membuat suatu permohonan baharu selepas suatu tempoh sebagaimana yang ditentukan oleh Suruhanjaya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_58__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_58__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "tiada bayaran balik bagi fi yang telah dibayar oleh pemohon itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_58__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_58",
      "schema:text": {
        "@language": "ms",
        "@value": "Setelah menerima suatu permohonan dan pembayaran fi serta pengemukaan maklumat, butir-butir atau dokumen di bawah subseksyen (2) dan apa-apa dokumen atau maklumat tambahan yang diberikan di bawah perenggan (3)(b), Suruhanjaya boleh mempertimbangkan permohonan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_58__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_58",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu pemberi perkhidmatan kredit berdaftar yang berniat untuk menjalankan suatu perniagaan perkhidmatan kredit yang berikutnya sebagaimana yang dinyatakan dalam perenggan 3 Jadual 4 hendaklah mengemukakan permohonan lain kepada Suruhanjaya mengikut seksyen ini. Pendaftaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_59",
      "@type": "akn:clause",
      "eli:number": "59",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_59__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_59__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_59__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_59__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_59__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_59__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_59__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_59",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya boleh mendaftarkan pemohon itu jika Suruhanjaya berpuas hati bahawa pemohon itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_59__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_59__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "memenuhi kehendak kewangan minimum di bawah seksyen 61; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_59__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_59__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mematuhi apa-apa kehendak lain Akta ini, mana-mana peraturan-peraturan, standard atau garis panduan atau kehendak yang lain yang berhubungan dengan pendaftaran di bawah Akta ini dan syarat sebagaimana yang ditentukan oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_59__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_59__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_59__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_59",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_59__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_59__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam mendaftarkan suatu pemohon di bawah subseksyen (1), boleh menentukan mana-mana syarat pendaftaran sebagaimana yang Suruhanjaya fikirkan patut untuk dikenakan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_59__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_59__subsec_2__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_59__subsec_2__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_59__subsec_2__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_59__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "boleh pada bila-bila masa dalam tempoh pendaftaran itu mengeluarkan suatu notis bertulis untuk—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_59__subsec_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_59__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "mengenakan apa-apa syarat tambahan atau baharu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_59__subsec_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_59__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "meminda atau mengubah mana-mana syarat itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_59__subsec_2__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_59__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "membatalkan atau mengenepikan mana-mana syarat itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_59__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_59",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Suruhanjaya menambah, meminda, mengubah, membatalkan atau mengenepikan mana-mana syarat di bawah subseksyen (2), penambahan, pindaan, pengubahan, pembatalan atau pengenepian itu hendaklah berkuat kuasa pada masa penyampaian notis itu atau pada masa sebagaimana yang ditentukan oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_59__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_59",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang tidak mematuhi mana-mana syarat suatu pendaftaran yang dikenakan di bawah subseksyen (2) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi satu juta ringgit atau dipenjarakan selama tempoh tidak melebihi empat tahun atau kedua-duanya. Alasan bagi penolakan pendaftaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_60",
      "@type": "akn:clause",
      "eli:number": "60",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_60__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_60__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_60__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_60__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_60__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_60__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_60__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_60__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_60",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya boleh menolak permohonan untuk suatu pendaftaran atas mana-mana alasan yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_60__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_60__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "permohonan itu tidak dibuat mengikut Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_60__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_60__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pemohon telah tidak mematuhi mana-mana peraturan-peraturan, standard atau garis panduan, atau kehendak yang lain di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_60__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_60__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pemohon telah tidak memuaskan hati Suruhanjaya bahawa pemohon, pengawalnya, pengarahnya dan pengurusan kanannya, adalah layak dan sesuai;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_60__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_60__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa dokumen atau maklumat yang diberikan oleh pemohon kepada Suruhanjaya adalah palsu atau mengelirukan atau daripadanya terdapat ketinggalan yang material; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_60__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_60__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya berpendapat bahawa ia adalah bertentangan dengan kepentingan awam untuk mendaftarkan pemohon itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_60__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_60__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_60__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_60__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_60",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Suruhanjaya menolak suatu permohonan di bawah subseksyen (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_60__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_60__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya hendaklah memberitahu pemohon itu secara bertulis mengenai penolakan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_60__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_60__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "penolakan itu hendaklah tidak menjejaskan hak pemohon itu untuk membuat suatu permohonan baharu setelah suatu tempoh sebagaimana yang ditentukan oleh Suruhanjaya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_60__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_60__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "tiada bayaran balik bagi fi yang telah dibayar oleh pemohon itu. Kehendak kewangan minimum bagi pendaftaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_61",
      "@type": "akn:clause",
      "eli:number": "61",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_61__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_61__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_61__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_61__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_61",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh didaftarkan di bawah seksyen 59 jika orang itu tidak memenuhi kehendak kewangan minimum sebagaimana yang ditentukan oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_61__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_61",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam menjalankan perniagaan perkhidmatan kreditnya, suatu pemberi perkhidmatan kredit berdaftar hendaklah mematuhi, pada setiap masa, kehendak kewangan minimum sebagaimana yang ditentukan oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_61__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_61",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu pemberi perkhidmatan kredit berdaftar tidak boleh terus menjalankan mana-mana perniagaan perkhidmatan kredit tanpa keizinan bertulis terdahulu Suruhanjaya, jika ia tidak memenuhi kehendak kewangan minimum sebagaimana yang ditentukan di bawah subseksyen (1). Kehendak layak dan sesuai pemberi perkhidmatan kredit berdaftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_62",
      "@type": "akn:clause",
      "eli:number": "62",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_62__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_62__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_62__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_62__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_62__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_62__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_62",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya boleh menentukan kehendak layak dan sesuai yang terpakai bagi seorang pengawal, pengarah atau pengurusan kanan suatu pemberi perkhidmatan kredit berdaftar, yang boleh termasuk kriteria minimum yang berhubungan dengan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_62__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_62__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "kejujuran, integriti peribadi dan reputasi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_62__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_62__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "kekompetenan dan kebolehan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_62__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_62__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "integriti kewangan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_62__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_62",
      "schema:text": {
        "@language": "ms",
        "@value": "Seorang pengawal, pengarah atau pengurusan kanan suatu pemberi perkhidmatan kredit berdaftar hendaklah pada setiap masa mematuhi kehendak layak dan sesuai sebagaimana yang ditentukan di bawah subseksyen (1). Pengarah dan pengurusan kanan pemberi perkhidmatan kredit berdaftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_63",
      "@type": "akn:clause",
      "eli:number": "63",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "(1) Suatu pemberi perkhidmatan kredit berdaftar hendaklah hanya melantik atau melantik semula mana-mana orang— (a) sebagai pengarahnya atau pengurusan kanannya jika orang itu telah memenuhi kehendak layak dan sesuai sebagaimana yang ditentukan oleh Suruhanjaya di bawah seksyen 62; dan (b) sebagai ketua eksekutifnya tertakluk kepada pemerolehan suatu kelulusan bertulis terdahulu Suruhanjaya. (2) Suatu pemberi perkhidmatan kredit berdaftar hendaklah memberikan suatu notis bertulis kepada Suruhanjaya mengenai pelantikan atau pelantikan semula pengarahnya. (3) Jika suatu perkara berbangkit sama ada seseorang telah mematuhi kehendak layak dan sesuai yang ditentukan di bawah seksyen 62, Suruhanjaya hendaklah mempunyai budi bicara penuh untuk menentukan perkara itu. (4) Jika seorang pengarah atau pengurusan kanan kemudiannya menyedari bahawa dia tidak mematuhi kehendak layak dan sesuai yang ditentukan di bawah seksyen 62, dia hendaklah dengan serta-merta memaklumkan kepada pemberi perkhidmatan kredit berdaftar itu. (5) Jika seorang pengarah atau pengurusan kanan tidak mematuhi kehendak layak dan sesuai yang ditentukan di bawah seksyen 62, pemberi perkhidmatan kredit berdaftar itu hendaklah dengan serta-merta memecatnya daripada jawatan itu. (6) Tertakluk kepada seksyen 131, Suruhanjaya boleh mengarahkan suatu pemberi perkhidmatan kredit berdaftar untuk memecat pengarahnya atau pengurusan kanannya yang tidak mematuhi kehendak layak dan sesuai di bawah seksyen 62 dalam apa-apa tempoh sebagaimana yang ditentukan oleh Suruhanjaya. (7) Walau apa pun apa-apa jua yang terkandung dalam apa-apa kontrak perkhidmatan atau apa-apa perjanjian lain yang berhubungan dengan pelantikannya, pemecatan seorang pengarah atau pengurusan kanan di bawah subseksyen (5) atau (6) adalah menurut undang-undang dan sah dan pengarah atau pengurusan kanan yang dipecat di bawah subseksyen (5) atau (6) tidaklah berhak untuk menuntut apa-apa pampasan bagi pemecatan itu. (8) Suatu pemberi perkhidmatan kredit berdaftar hendaklah memberitahu Suruhanjaya secara bertulis bahawa pengarahnya atau pengurusan kanannya telah terhenti memegang jawatan dan bertindak atas keupayaan sedemikian dan sebab bagi pemberhentian itu dalam suatu tempoh yang ditentukan oleh Suruhanjaya. (9) Mana-mana orang yang melanggar subseksyen (1), (4) atau (5) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tiga tahun atau kedua-duanya. Pengawal pemberi perkhidmatan kredit berdaftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64",
      "@type": "akn:clause",
      "eli:number": "64",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh mempunyai kawalan atas suatu pemberi perkhidmatan kredit berdaftar melainkan jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "orang itu telah memenuhi kehendak layak dan sesuai sebagaimana yang ditentukan di bawah seksyen 62 oleh Suruhanjaya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "orang itu telah mendapat kelulusan bertulis terdahulu Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang berniat untuk menjadi seorang pengawal hendaklah mengemukakan suatu permohonan kepada Suruhanjaya dalam apa-apa bentuk dan mengikut cara sebagaimana yang ditentukan Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya boleh, pada bila-bila masa selepas penerimaan suatu permohonan di bawah subseksyen (2)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "menjalankan apa-apa siasatan sebagaimana yang difikirkannya perlu, termasuk menjalankan pemeriksaan terhadap latar belakang kewangan, profesional, jenayah atau yang lain ke atas orang itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "melalui suatu notis bertulis menghendaki orang itu untuk memberikan kepadanya apa-apa dokumen atau maklumat tambahan sebagaimana yang disifatkan perlu oleh Suruhanjaya berhubung dengan permohonan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu perkara berbangkit sama ada seorang pengawal telah mematuhi kehendak layak dan sesuai yang ditentukan di bawah seksyen 62, Suruhanjaya hendaklah mempunyai budi bicara penuh untuk menentukan perkara itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seorang pengawal tidak atau telah tidak mematuhi kehendak layak dan sesuai sebagaimana yang ditentukan di bawah seksyen 62 oleh Suruhanjaya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu pemberi perkhidmatan kredit berdaftar hendaklah memberitahu Suruhanjaya secara bertulis mengenai ketidakpatuhan itu dalam tempoh sebagaimana yang ditentukan oleh Suruhanjaya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64__subsec_5__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64__subsec_5__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "pengawal itu hendaklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64__subsec_5__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64__subsec_5__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "melupuskan pemegangan syer yang menjadikannya sebagai pengawal itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64__subsec_5__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64__subsec_5__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "terhenti mempunyai kawalan dalam, pemberi perkhidmatan kredit berdaftar itu dalam suatu tempoh atau mana-mana tempoh lanjut, dan tertakluk kepada apa-apa syarat sebagaimana yang ditentukan oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64__subsec_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64__subsec_6__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64__subsec_6__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini, “pengawal” ertinya seseorang yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64__subsec_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "berhak untuk menjalankan, atau mengawal penjalanan, tidak kurang daripada tiga puluh tiga peratus undi yang dikaitkan dengan syer mengundi dalam suatu pemberi perkhidmatan kredit berdaftar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64__subsec_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "mempunyai kuasa untuk melantik, atau menyebabkan dilantik, suatu majoriti pengarah suatu pemberi perkhidmatan kredit berdaftar; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64__subsec_6__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "mempunyai kuasa untuk membuat, atau menyebabkan dibuat, keputusan berkenaan dengan perniagaan atau pentadbiran suatu pemberi perkhidmatan kredit berdaftar, dan untuk memberi kesan kepada keputusan itu atau menyebabkan keputusan itu diberikan kesan kepadanya, dan perkataan “kawalan” hendaklah ditafsirkan sewajarnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_64",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1) atau (5) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tiga tahun atau kedua-duanya. Pemerolehan kepentingan dalam syer pemberi perkhidmatan kredit berdaftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_65",
      "@type": "akn:clause",
      "eli:number": "65",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_65__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_65__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_65__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_65__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_65",
      "schema:text": {
        "@language": "ms",
        "@value": "Kecuali dengan kelulusan bertulis terdahulu Suruhanjaya, tiada seorang pun boleh memperoleh mana-mana kepentingan dalam syer suatu pemberi perkhidmatan kredit berdaftar dengan membuat suatu perjanjian atau perkiraan atau dalam apa cara sekalipun, jika pemerolehan itu akan menyebabkan orang itu memegang, berserta dengan apa-apa kepentingan dalam syer pemberi perkhidmatan kredit berdaftar itu yang telah ada dipegang olehnya, suatu kepentingan agregat tiga puluh tiga peratus atau lebih dalam syer pemberi perkhidmatan kredit berdaftar itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_65__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_65",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya boleh menentukan perkara yang menjadi “kepentingan dalam syer” bagi maksud subseksyen (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_65__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_65",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tiga tahun atau kedua-duanya. Pelantikan juruaudit oleh pemberi perkhidmatan kredit berdaftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_V__cl_66",
      "@type": "akn:clause",
