      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_3",
      "schema:name": {
        "@language": "ms",
        "@value": "Jenis perniagaan perkhidmatan kredit"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_3__para_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
