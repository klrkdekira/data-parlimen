      "schema:text": {
        "@language": "ms",
        "@value": "Akta Sewa Beli 1967 [Akta 212];"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_2__subsec_3__para_g",
