      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_4__para_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Pemerolehan pinjaman atau pembiayaan terjejas"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_4__para_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
