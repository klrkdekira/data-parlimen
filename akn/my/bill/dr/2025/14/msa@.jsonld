      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_III__cl_34",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud subseksyen (2), kuasa suatu Pihak Berkuasa Pengawalseliaan dan Penyeliaan hendaklah termasuk kuasa untuk—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_III__cl_34__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_III__cl_34__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "mengenakan fi atau caj lain;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_III__cl_34__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_III__cl_34__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "memeriksa perniagaan dan hal ehwal suatu pemberi kredit atau pemberi perkhidmatan kredit yang dikawal selia oleh Pihak Berkuasa Pengawalseliaan dan Penyeliaan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_III__cl_34__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_III__cl_34__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "mengenakan penalti monetari di bawah seksyen 106;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_III__cl_34__subsec_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_III__cl_34__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "menyebabkan suatu penyiasatan dibuat dan menjalankan semua kuasa penyiasatan mengenai perkara yang berhubungan dengan perniagaan kredit atau perniagaan perkhidmatan kredit yang dikawal selia oleh Pihak Berkuasa Pengawalseliaan dan Penyeliaan masing-masing;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_III__cl_34__subsec_3__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_III__cl_34__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "menentukan standard atau garis panduan untuk apa-apa perkara di bawah seksyen 123;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_III__cl_34__subsec_3__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_III__cl_34__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "mengeluarkan panduan di bawah seksyen 125;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_III__cl_34__subsec_3__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_III__cl_34__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "menyiarkan maklumat di bawah seksyen 126; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_III__cl_34__subsec_3__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_III__cl_34__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "melakukan apa-apa perkara yang bersampingan dengan mana-mana fungsinya dan kuasanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_III__cl_34__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_III__cl_34",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini, suatu Pihak Berkuasa Pengawalseliaan dan Penyeliaan hendaklah melaksanakan fungsi dan menjalankan kuasa di bawah Akta ini dengan cara yang ia berpendapat paling wajar bagi maksud Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_III__cl_34__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_III__cl_34",
      "schema:text": {
        "@language": "ms",
        "@value": "Fungsi dan kuasa Pihak Berkuasa Pengawalseliaan dan Penyeliaan di bawah Akta ini hendaklah menjadi tambahan kepada, dan tidak mengurangkan, fungsi dan kuasa Pihak Berkuasa Pengawalseliaan dan Penyeliaan itu di bawah undang-undang bertulis berkaitan yang lain. Pelantikan pegawai atau orang lain"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_III__cl_35",
      "@type": "akn:clause",
      "eli:number": "35",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_III__cl_35__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_III__cl_35__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_III__cl_35__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_III__cl_35__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_III__cl_35__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_III__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu Pihak Berkuasa Pengawalseliaan dan Penyeliaan boleh melantik mana-mana pegawainya atau mana-mana orang lain untuk melaksanakan mana-mana atau semua fungsinya atau menjalankan mana-mana atau semua kuasanya, atau memberikan apa-apa bantuan dalam melaksanakan fungsinya atau menjalankan kuasanya di bawah Akta ini sebagaimana yang ditentukan olehnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_III__cl_35__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_III__cl_35__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_III__cl_35__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_III__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan keluasan subseksyen (1), Menteri Perumahan dan Kerajaan Tempatan boleh melantik—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_III__cl_35__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_III__cl_35__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang Pendaftar pemberi kredit Islam dan apa-apa bilangan Timbalan Pendaftar pemberi kredit Islam; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_III__cl_35__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_III__cl_35__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana pegawai lain sebagaimana yang perlu bagi maksud Akta ini, termasuk pegawai penyiasat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_III__cl_35__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_III__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar dan Timbalan Pendaftar hendaklah mempunyai dan boleh melaksanakan atau menjalankan mana-mana fungsi dan kuasa seorang pegawai penyiasat di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_III__cl_35__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_III__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar boleh, secara bertulis, mewakilkan semua atau mana-mana fungsinya dan kuasanya di bawah Akta ini, kecuali kuasa pewakilannya, kepada mana-mana Timbalan Pendaftar atau pegawai yang dilantik di bawah subseksyen (1) dan (2)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_10__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang akan dilantik sebagai Pengerusi Eksekutif atau Timbalan Pengerusi Eksekutif di bawah perenggan 9(2)(a) dan (b) hendaklah seseorang yang mempunyai integriti dan reputasi yang amat baik dengan pengetahuan tentang, atau pengalaman dalam perniagaan, pengurusan syarikat, perlindungan pengguna kredit, produk dan perkhidmatan kewangan atau kredit, undang-undang, ekonomi atau perakaunan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_10__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_10__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_10__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri, dalam melantik anggota Lembaga yang lain di bawah perenggan 9(2)(d), hendaklah memberi perhatian kepada—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_10__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_10__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "kejujuran, integriti peribadi, integriti kewangan dan reputasi orang itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_10__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_10__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "kecekapan dan kebolehan orang itu, termasuk mempunyai pengetahuan, kemahiran dan pengalaman yang berkaitan, dalam memenuhi tanggungjawabnya sebagai seorang anggota Lembaga; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_10__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_10__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "kepelbagaian anggota Lembaga dalam hal minat, pengetahuan, kemahiran dan pengalaman. Tempoh jawatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua anggota Lembaga hendaklah dilantik bagi tempoh tiga tahun dan adalah layak untuk pelantikan semula bagi suatu tempoh yang ditentukan dalam instrumen pelantikan yang tidak melebihi suatu tempoh maksimum dua penggal berturut-turut. Pembatalan pelantikan dan peletakan jawatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_12__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_12__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_12__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_12__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_12__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, atas syor Lembaga, pada bila-bila masa, membatalkan pelantikan seorang anggota Lembaga atas apa-apa sebab termasuk yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_12__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_12__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "anggota itu tidak hadir dalam tiga mesyuarat Lembaga secara berturut-turut, dalam hal Pengerusi Eksekutif, tanpa kebenaran Menteri dan dalam hal Timbalan Pengerusi Eksekutif atau anggota Lembaga lain, tanpa kebenaran Pengerusi Eksekutif;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_12__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_12__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "anggota itu tidak mematuhi obligasinya di bawah seksyen 20; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_12__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_12__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "anggota itu hilang kelayakan di bawah seksyen 19."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Pembatalan pelantikan di bawah subseksyen (1) hendaklah disokong dengan suatu sebab secara bertulis."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_12__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana anggota Lembaga boleh meletakkan jawatannya dengan memberi suatu notis bertulis yang ditujukan kepada Menteri. Saraan dan elaun"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_13__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi Eksekutif dan Timbalan Pengerusi Eksekutif hendaklah dibayar apa-apa saraan dan apa-apa elaun lain sebagaimana yang ditentukan oleh Jawatankuasa Pencalonan dan Saraan yang ditubuhkan di bawah subseksyen 18(1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Anggota bukan eksekutif Lembaga yang disebut dalam perenggan 9(2)(c) dan (d) yang dijemput untuk menyertai apa-apa mesyuarat termasuk suatu mesyuarat Lembaga boleh dibayar apa-apa saraan atau elaun sebagaimana yang ditentukan oleh Menteri. Mesyuarat Lembaga"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_14__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga boleh bermesyuarat seberapa kerap yang perlu bagi pelaksanaan fungsinya dan hendaklah menentukan tatacaranya sendiri termasuk tatacara bagi Jawatankuasa Lembaga mengikut amalan tadbir urus yang baik."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga boleh menjemput mana-mana orang yang bukan seorang anggota Lembaga untuk menghadiri mesyuaratnya bagi menasihati Lembaga tentang apa-apa perkara yang dibincangkan. Tindakan dan prosiding Lembaga tidak terjejas oleh kekosongan, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_15__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_15__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_15__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_15__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga boleh bertindak walau apa pun terdapat apa-apa kekosongan dalam keanggotaannya dan prosidingnya tidak boleh menjadi tak sah oleh sebab—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_15__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "ketidakhadiran mana-mana anggota;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_15__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa kecacatan yang kemudiannya diketahui dalam pelantikan atau kelayakan mana-mana anggota atau keanggotaan Lembaga;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_15__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa peninggalan, kecacatan atau salah aturan dalam pengadaan atau penjalanan suatu mesyuarat; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_15__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "kehadiran atau penyertaan seseorang yang bukan seorang anggota Lembaga. Perwakilan fungsi dan kuasa, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_16__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_16__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_16__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_16__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_16__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_16__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya boleh mewakilkan fungsinya atau kuasanya di bawah Akta ini kepada—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_16__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_16__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi Eksekutif atau Timbalan Pengerusi Eksekutif;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_16__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_16__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang yang ditetapkan oleh Lembaga atau mana-mana jawatankuasa yang ditubuhkan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_16__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_16__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana pegawai Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Perwakilan di bawah seksyen ini tidaklah menghalang pelaksanaan atau penjalanan serentak fungsi atau kuasa yang telah diwakilkan oleh Suruhanjaya. Kuasa untuk mengguna khidmat orang untuk memberikan bantuan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_17__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_17__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya boleh mengguna khidmat, sama ada secara am atau dalam sesuatu perkara tertentu, di bawah apa-apa terma dan syarat guna khidmat sebagaimana yang ditentukan oleh Suruhanjaya dari semasa ke semasa, mana-mana orang yang bukan seorang pegawai Suruhanjaya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_17__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk memberikan apa-apa bantuan sebagaimana yang dikehendaki atau ditentukan oleh Suruhanjaya berkaitan dengan pelaksanaan fungsinya atau penjalanan kuasanya di bawah Akta ini; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_17__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk melaksanakan atau menjalankan perkara yang sama yang disebut dalam perenggan (a) bagi pihak dan atas nama Suruhanjaya. Jawatankuasa Lembaga"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_10"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga hendaklah menubuhkan jawatankuasa yang berikut yang hanya terdiri daripada anggota bukan eksekutif Lembaga yang disebut dalam perenggan 9(2)(c) dan (d):"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_10",
      "@type": "akn:subsection",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang disebut di bawah perenggan (2)(b) boleh meletakkan jawatannya dengan memberi suatu notis bertulis yang ditujukan kepada Lembaga. Kehilangan kelayakan anggota Lembaga dan Jawatankuasa Lembaga"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatankuasa Audit dan Risiko; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatankuasa Pencalonan dan Saraan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga boleh menubuhkan apa-apa jawatankuasa lain, dalam apa-apa bentuk dan dengan apa-apa jua namanya digelar, sebagaimana yang Lembaga berpendapat patut atau perlu, yang boleh terdiri daripada mana-mana orang yang berikut sebagaimana yang dilantik oleh Lembaga:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana anggota Lembaga; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang lain."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam melantik seseorang di bawah perenggan (2)(b), Lembaga hendaklah mengambil kira kejujuran, integriti peribadi, integriti kewangan, reputasi, pengetahuan, kemahiran dan pengalaman orang itu, yang akan membolehkannya melaksanakan fungsinya sebagai seorang anggota Jawatankuasa Lembaga itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_4__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_4__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_4__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_4__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Fungsi Jawatankuasa Audit dan Risiko yang ditubuhkan menurut perenggan (1)(a) hendaklah termasuk untuk membantu Lembaga dalam pengawasannya ke atas—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "integriti akaun dan penyata kewangan Suruhanjaya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "keberkesanan sistem kawalan dalaman Suruhanjaya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "pelaksanaan fungsi audit dalaman Suruhanjaya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_4__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "pematuhan oleh Suruhanjaya dengan kehendak undang-undang dan pengawalseliaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_4__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "kajian semula dan pengurusan risiko perusahaan Suruhanjaya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_4__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa perkara lain sebagaimana yang ditentukan oleh Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Fungsi Jawatankuasa Pencalonan dan Saraan yang ditubuhkan menurut perenggan (1)(b) hendaklah termasuk—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengesyorkan anggota Lembaga bagi maksud subseksyen 9(3); dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk bertanggungjawab bagi apa-apa perkara lain sebagaimana yang ditentukan oleh Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Fungsi mana-mana Jawatankuasa Lembaga yang ditubuhkan menurut subsekyen (2) hendaklah ditentukan oleh Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_7__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Orang yang disebut di bawah perenggan (2)(b) hendaklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_7",
      "schema:text": {
        "@language": "ms",
        "@value": "pada setiap masa bertindak secara jujur dan demi kepentingan Suruhanjaya dan menggunakan usaha yang munasabah dalam melaksanakan fungsinya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_7",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak menyalahgunakan apa-apa maklumat yang diperoleh atau menggunakan apa-apa pengaruh yang tidak wajar oleh sebab kedudukannya untuk mendapat secara langsung atau tidak langsung suatu kelebihan bagi dirinya atau bagi mana-mana orang lain."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_8__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_8__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_8__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga boleh membatalkan pelantikan orang yang disebut di bawah perenggan (2)(b) atas apa-apa sebab termasuk yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_8",
      "schema:text": {
        "@language": "ms",
        "@value": "orang itu tidak hadir dalam tiga mesyuarat Jawatankuasa Lembaga secara berturut-turut tanpa kebenaran Pengerusi Eksekutif;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_8",
      "schema:text": {
        "@language": "ms",
        "@value": "orang itu tidak mematuhi obligasinya di bawah seksyen 20; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_8__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_8",
      "schema:text": {
        "@language": "ms",
        "@value": "orang itu hilang kelayakan di bawah seksyen 19."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Pembatalan pelantikan di bawah subseksyen (8) hendaklah disokong dengan suatu sebab secara bertulis."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_19__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_19__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_19__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_19__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_19__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_19__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_19__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_19__para_h"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh dilantik, atau terus kekal, menjadi seorang anggota Lembaga atau Jawatankuasa Lembaga jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_19__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "dia ialah atau menjadi seorang ahli Dewan Negara atau Dewan Rakyat atau mana-mana Dewan Undangan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_19__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "dia ialah atau menjadi seorang pegawai, pengarah, atau pekongsi, suatu pemberi kredit atau pemberi perkhidmatan kredit;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_19__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "dia ialah atau menjadi seorang pemegang jawatan, atau dia memegang apa-apa jawatan atau kedudukan yang sama dalam suatu parti politik;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_19__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_19__para_d__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_19__para_d__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_19__para_d__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "telah dibuktikan terhadapnya, atau jika dia telah disabitkan atas, suatu pertuduhan berkenaan dengan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_19__para_d__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_19__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu kesalahan jenayah yang melibatkan fraud, kecurangan, keganasan atau keburukan akhlak;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_19__para_d__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_19__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu kesalahan di bawah mana-mana undang-undang yang berhubungan dengan rasuah; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_19__para_d__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_19__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana kesalahan jenayah lain yang boleh dihukum dengan pemenjaraan (sama ada pemenjaraan sahaja atau sebagai tambahan kepada atau sebagai ganti suatu denda) selama lebih daripada dua tahun;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_19__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "kelakuannya, sama ada yang berkaitan dengan fungsinya sebagai seorang anggota Lembaga atau selainnya, telah menjadi kelakuan yang memburukkan nama atau membawa aib kepada Suruhanjaya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_19__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "dia ialah atau menjadi seorang bankrap, atau menggantung pembayaran atau mencapai penyelesaian dengan pemiutangnya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_19__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "dia ialah atau menjadi tidak sempurna akal atau selainnya tidak berupaya untuk melaksanakan fungsinya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_19__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "dia terlibat atau menjadi terlibat dalam apa-apa aktiviti yang boleh mengganggu kebebasannya dalam melaksanakan fungsinya. Penzahiran kepentingan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_20__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_20__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_20__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_20__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_20__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Seorang anggota Lembaga atau suatu Jawatankuasa Lembaga, yang memperoleh atau mempunyai suatu kepentingan, secara langsung atau tidak langsung, berhubung dengan apa-apa perkara yang dibincangkan oleh Lembaga atau Jawatankuasa Lembaga hendaklah menzahirkan kepada Lembaga atau Jawatankuasa Lembaga itu, mengikut mana-mana yang berkenaan, kewujudan kepentingannya dan jenis kepentingannya itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_20__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_20__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_20__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Sesuatu penzahiran di bawah subseksyen (1) hendaklah direkodkan dalam minit mesyuarat Lembaga atau Jawatankuasa Lembaga, mengikut mana-mana yang berkenaan, dan selepas penzahiran itu, anggota Lembaga atau Jawatankuasa Lembaga itu hendaklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_20__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_20__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak boleh mengambil bahagian atau hadir dalam apa-apa pertimbangtelitian atau keputusan Lembaga atau Jawatankuasa Lembaga, mengikut mana-mana yang berkenaan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_20__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_20__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak diambil kira bagi maksud membentuk suatu kuorum Lembaga atau Jawatankuasa Lembaga, mengikut mana-mana yang berkenaan, yang berhubungan dengan perkara itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_20__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada tindakan atau prosiding Lembaga atau Jawatankuasa Lembaga boleh menjadi tak sah atas alasan bahawa mana-mana anggota Lembaga atau Jawatankuasa Lembaga telah tidak mematuhi seksyen ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_20__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana anggota Lembaga atau Jawatankuasa Lembaga yang melanggar subseksyen (1) atau perenggan (2)(a) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima ratus ribu ringgit atau dipenjarakan selama tempoh tidak melebihi tiga tahun atau kedua-duanya. Penyata, laporan, akaun dan maklumat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya hendaklah memberi Menteri apa-apa penyata, laporan, akaun dan maklumat berkenaan dengan pelaksanaan mana-mana fungsinya di bawah Akta ini sebagaimana yang dikehendaki oleh Menteri dari semasa ke semasa. Penggal 2 Pengerusi Eksekutif dan Timbalan Pengerusi Eksekutif Pengerusi Eksekutif"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_22__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_22__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_22__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi Eksekutif hendaklah diamanahkan dengan pentadbiran dan pengurusan harian Suruhanjaya dan boleh, melainkan jika diperuntukkan selainnya di bawah Akta ini, menjalankan semua kuasa dan membuat semua tindakan yang boleh dilakukan oleh Suruhanjaya di bawah Akta ini atau mana-mana undang-undang bertulis yang lain."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_22__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi Eksekutif boleh membawa apa-apa perkara berhubung dengan fungsi atau kuasa Suruhanjaya kepada Lembaga atau Jawatankuasa Lembaga untuk pertimbangtelitian atau arahan, jika difikirkannya perlu. Ketiadaan atau ketidakupayaan Pengerusi Eksekutif dan Timbalan Pengerusi Eksekutif"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_23__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_23__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_23__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Semasa ketiadaan Pengerusi Eksekutif atau ketidakupayaan Pengerusi Eksekutif untuk bertindak atas apa-apa sebab, Timbalan Pengerusi Eksekutif hendaklah menjalankan fungsi Pengerusi Eksekutif."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_23__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud subseksyen (1), dalam hal apabila Timbalan Pengerusi Eksekutif itu juga tiada atau tidak berupaya untuk bertindak atas apa-apa sebab, seorang pegawai kanan Suruhanjaya yang ditentukan oleh Lembaga atas syor Jawatankuasa Pencalonan dan Saraan hendaklah menjalankan fungsi Pengerusi Eksekutif. Penggal 3 Pegawai Suruhanjaya Pelantikan pegawai Suruhanjaya, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_24__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_24__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_24__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_24__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_24__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya boleh dari semasa ke semasa melantik orang yang hendaklah dibayar apa-apa saraan dan elaun, dan hendaklah memegang jawatan mereka atas apa-apa terma dan syarat sebagaimana yang ditentukan oleh Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_24__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya boleh membuat perkiraan bagi pembayaran apa-apa faedah persaraan, gratuiti atau elaun lain sebagaimana yang ditentukan oleh Lembaga kepada pegawainya dan pekerjanya dan tanggungan mereka."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_24__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua anggota Lembaga atau mana-mana jawatankuasanya atau mana-mana pegawai Suruhanjaya semasa melaksanakan fungsi mereka atau menjalankan kuasa mereka sebagai anggota atau pegawai itu hendaklah disifatkan sebagai pekhidmat awam dalam erti Kanun Keseksaan [Akta 574] dan pegawai awam bagi maksud Akta Keterangan 1950."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_24__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_24__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_24__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun peruntukan mana-mana undang-undang bertulis—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_24__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_24__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam mana-mana prosiding sivil oleh atau terhadap Suruhanjaya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_24__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_24__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam mana-mana prosiding sivil lain yang Suruhanjaya dikehendaki atau dibenarkan oleh mahkamah untuk diwakili atau didengar, atau selainnya berhak untuk diwakili atau didengar, mana-mana pegawai Suruhanjaya yang diberi kuasa oleh Pengerusi Eksekutif bagi maksud itu boleh, bagi pihak Suruhanjaya, memulakan prosiding itu atau hadir sebagai seorang peguam bela dalam prosiding itu, dan boleh membuat apa-apa kehadiran dan permohonan dan menjalankan semua tindakan berkenaan dengan prosiding itu bagi pihak Suruhanjaya. Kuasa untuk memberikan pemberian, pinjaman, pembiayaan dan pendahuluan kepada pegawainya, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_25__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_25__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_25__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya boleh memberikan pemberian, pinjaman, pembiayaan dan pendahuluan, termasuk pinjaman pelajaran dan biasisiwa, kepada pegawainya dan pekerjanya atau kepada orang lain atas apa-apa terma dan syarat sebagaimana yang ditentukan oleh Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_25__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam seksyen ini, istilah “pegawai” termasuklah Pengerusi Eksekutif dan Timbalan Pengerusi Eksekutif. Penggal 4 Kewangan Kumpulan Wang Suruhanjaya"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_26__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_26__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_26__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_26__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_26__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu Kumpulan Wang yang hendaklah ditadbir dan dikawal oleh Suruhanjaya adalah ditubuhkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_26__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_26__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_26__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_26__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_26__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_26__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_26__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_26__subsec_2__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Kumpulan Wang hendaklah terdiri daripada—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_26__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_26__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa jumlah wang sebagaimana yang diperuntukkan dari semasa ke semasa bagi maksud Akta ini oleh Parlimen;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_26__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_26__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "jumlah wang yang dipinjam oleh Suruhanjaya bagi maksud memenuhi mana-mana obligasinya, melaksanakan apa-apa fungsinya atau menjalankan apa-apa kuasanya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_26__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_26__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "fi atau caj lain yang dikenakan oleh Suruhanjaya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_26__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_26__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "penalti yang dibayar kepada Suruhanjaya atau wang yang didapatkan oleh, atau bagi pihak, Suruhanjaya dalam menjalankan suatu hak tindakan yang diberikan atau diperoleh di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_26__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_26__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pendanaan yang diterima oleh Suruhanjaya yang tidak termasuk pemberian yang diterima di bawah perenggan 33(2)(a);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_26__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_26__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "segala jumlah wang atau harta lain yang mungkin dengan apa-apa cara menjadi kena dibayar kepada atau terletak hak pada Suruhanjaya berkenaan dengan apa-apa perkara yang bersampingan dengan fungsinya dan kuasanya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_26__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_26__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "semua wang lain yang secara sah kena dibayar kepada, atau diterima oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_26__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_26__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_26__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_26__subsec_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_26__subsec_3__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_26__subsec_3__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Kumpulan Wang hendaklah dibelanjakan bagi maksud—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_26__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_26__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "membayar apa-apa perbelanjaan yang ditanggung secara sah oleh Suruhanjaya termasuk fi dan kos guaman dan fi dan kos yang lain, dan saraan dan elaun bagi pegawai-pegawai dan ejen-ejen yang dilantik dan diambil kerja oleh Suruhanjaya, termasuk pemberian pinjaman, pembiayaan, pendahuluan, pemberian, faedah persaraan, biasiswa, elaun persaraan, elaun atau gratuiti;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_26__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_26__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "membayar apa-apa perbelanjaan, kos atau perbelanjaan lain yang dilakukan atau diterima dengan sepatutnya oleh Suruhanjaya dalam melaksanakan fungsinya atau menjalankan kuasanya di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_26__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_26__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "membeli atau menyewa kelengkapan, jentera dan apa-apa bahan lain, memperoleh tanah dan mendirikan bangunan, dan menjalankan apa-apa kerja dan pengusahaan lain dalam melaksanakan fungsinya atau menjalankan kuasanya di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_26__subsec_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_26__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "membayar balik apa-apa wang yang dipinjam dan faedah yang kena dibayar atasnya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_26__subsec_3__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_26__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "secara amnya membayar apa-apa perbelanjaan bagi melaksanakan peruntukan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_26__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_26",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya hendaklah mempunyai kewajipan untuk memelihara Kumpulan Wang dengan melaksanakan fungsinya dan menjalankan kuasanya di bawah Akta ini untuk menjamin jumlah keseluruhan hasil Suruhanjaya adalah mencukupi untuk membayar semua jumlah wang yang boleh dipertanggungkan dengan sepatutnya kepada akaun hasilnya termasuk susut nilai dan faedah atas modal, dari setahun ke setahun. Pendanaan kepada Suruhanjaya"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_27__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_27__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_27__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_27__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_27__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_27__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu Pihak Berkuasa Pengawalseliaan dan Penyeliaan boleh, atas apa-apa terma dan syarat yang ditentukan oleh Pihak Berkuasa Pengawalseliaan dan Penyeliaan itu, memberi, meminjamkan atau mendahulukan sejumlah wang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_27__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_27__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "yang perlu untuk penubuhan Suruhanjaya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_27__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_27__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "berkenaan dengan kekurangan hasil belanjawan Suruhanjaya, yang semunasabahnya perlu untuk pengendalian Suruhanjaya yang sepatutnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_27__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_27__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_27__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_27__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_27__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pemberian, pinjaman dan pendahuluan di bawah subseksyen (1) hendaklah hanya diberikan oleh Pihak Berkuasa Pengawalseliaan dan Penyeliaan itu tertakluk kepada undang-undang bertulis yang berkaitan dan dengan kelulusan bertulis terdahulu lembaga pengarahnya, atau mana-mana orang lain jika dikehendaki di bawah mana-mana undang-undang bertulis; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_27__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_27__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "“Pihak Berkuasa Pengawalseliaan dan Penyeliaan” tidak termasuk Suruhanjaya dan semua kementerian yang disebut dalam tafsiran “Pihak Berkuasa Pengawalseliaan dan Penyeliaan” dalam seksyen 4."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_27__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen ini hendaklah terhenti berkuat kuasa pada 1 Januari 2031. Tahun kewangan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Tahun kewangan Suruhanjaya hendaklah bermula pada hari pertama bulan Januari dan berakhir pada hari ketiga puluh satu bulan Disember bagi setiap tahun. Laporan tahunan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya hendaklah, dengan seberapa segera yang praktik selepas berakhirnya setiap tahun kewangan, menyediakan suatu laporan mengenai aktivitinya semasa tahun kewangan itu dan menghantar suatu salinan laporan itu kepada Menteri yang hendaklah menyebabkan salinan itu dibentangkan di hadapan kedua-dua Majlis Parlimen. Akaun"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_30__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_30__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_30__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_30__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_30__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya hendaklah menyebabkan akaun Kumpulan Wang yang ditubuhkan di bawah seksyen 26 disimpan dengan sepatutnya dan hendaklah, dengan seberapa segera yang praktik selepas berakhirnya setiap tahun kewangan, menyebabkan suatu penyata akaun Suruhanjaya disediakan bagi tahun kewangan itu yang hendaklah termasuk suatu kunci kira-kira dan suatu akaun pendapatan dan perbelanjaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_30__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya hendaklah menyebabkan penyata akaun itu diaudit oleh juruaudit yang dilantik oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_30__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya hendaklah dengan seberapa segera yang praktik menghantar satu salinan penyata akaun yang diperakui oleh juruaudit itu dan satu salinan laporan juruaudit kepada Menteri yang hendaklah menyebabkannya dibentangkan di hadapan kedua- dua Majlis Parlimen."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_30__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_30",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Badan Berkanun (Akaun dan Laporan Tahunan) 1980 [Akta 240] tidaklah terpakai bagi Suruhanjaya. Kuasa untuk meminjam"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, atas syor Lembaga, meluluskan untuk Suruhanjaya meminjam atas apa-apa kadar faedah atau keuntungan dan bagi apa-apa tempoh dan atas apa-apa terma tentang masa dan kaedah pembayaran balik dan selainnya sebagaimana yang diluluskan oleh Menteri, apa-apa jumlah wang yang dikehendaki oleh Suruhanjaya bagi memenuhi mana-mana obligasinya atau bagi melaksanakan mana-mana fungsinya di bawah Akta ini. Pelaburan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Wang Suruhanjaya hendaklah, setakat yang ia tidak dikehendaki untuk dibelanjakan oleh Suruhanjaya di bawah Akta ini, dilaburkan mengikut cara sebagaimana yang difikirkan patut oleh Suruhanjaya, dengan kelulusan Menteri. Suruhanjaya boleh menubuhkan atau menyertai pertubuhan perbadanan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_33__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_33__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_33__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_33__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_33__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_33",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya boleh, dengan kelulusan Menteri, menubuhkan atau menyertai mana-mana pertubuhan perbadanan bagi maksud melindungi kepentingan awam atau pengguna kredit atau bagi melaksanakan fungsinya di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_33__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_33__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_33__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_33__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_33",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_33__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_33__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menerima suatu pemberian atau sumbangan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_33__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_33__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat suatu pemberian atau sumbangan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_33__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_33__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menyediakan apa-apa bentuk bantuan lain, bagi penubuhan atau pengendalian pertubuhan perbadanan itu di bawah subseksyen (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_33__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_33",
      "schema:text": {
        "@language": "ms",
        "@value": "Wang yang diterima di bawah perenggan (2)(a) hendaklah disimpan dalam suatu akaun amanah yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_33__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_33",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya hendaklah membayar wang di dalam akaun amanah yang ditetapkan itu kepada orang yang berhak mengikut maksud yang baginya wang itu diterima oleh Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_6__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_6__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya Kredit Pengguna ditubuhkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya hendaklah menjadi pertubuhan perbadanan dan hendaklah kekal turun-temurun."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya boleh mendakwa dan didakwa atas namanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_6__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_6__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_6__subsec_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_6__subsec_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya boleh, atas apa-apa terma sebagaimana yang difikirkan patut oleh Suruhanjaya dan bagi maksud Akta ini—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_6__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_6__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat kontrak;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_6__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_6__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "memperoleh, membeli, mengambil, memegang dan menikmati apa-apa jenis harta alih atau tak alih; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_6__subsec_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_6__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "menjual, memindahkan, menyerahhakkan, menyerahkan balik, memulangkan, menggadaikan, menggadai janji, mendemis, menyerahhakkan semula, memindahmilikkan, memajakkan, menyewakan, menyewakan semula atau selainnya melupuskan, atau menguruskan apa-apa harta alih atau tak alih atau apa-apa kepentingan mengenai harta itu yang terletak hak pada Suruhanjaya. Fungsi Suruhanjaya"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_7__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_7__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_7__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_7__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Fungsi Suruhanjaya adalah seperti yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menasihati Menteri dalam semua perkara yang berhubungan dengan kredit pengguna;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menasihati Kerajaan tentang dasar kebangsaan yang melibatkan kredit pengguna;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_7__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menggalakkan pelakuan yang sepatutnya dalam kalangan pemberi kredit dan pemberi perkhidmatan kredit;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_7__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menggalakkan perkembangan industri kredit pengguna; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_7__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk melakukan apa-apa perkara lain yang timbul daripada, atau berbangkit dengan fungsi Suruhanjaya di bawah Akta ini. Kuasa Suruhanjaya"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_8__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya hendaklah mempunyai kuasa untuk melakukan semua perkara yang perlu atau sesuai untuk dilakukan bagi, atau berkaitan dengan pelaksanaan fungsinya di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_8__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_8__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_8__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_8__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_8__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_8__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_8__subsec_2__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_8__subsec_2__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_8__subsec_2__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_8__subsec_2__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_8__subsec_2__para_k",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_8__subsec_2__para_l",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_8__subsec_2__para_m"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan keluasan subseksyen (1), kuasa Suruhanjaya hendaklah termasuk kuasa untuk—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_8__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_8__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mengawal selia semua perkara yang berhubungan dengan kredit pengguna;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_8__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_8__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mengawal selia dan menyelia orang yang menjalankan perniagaan kredit dan perniagaan perkhidmatan kredit yang dikawal selia oleh Suruhanjaya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_8__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_8__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mengenakan fi yang ditetapkan dalam melaksanakan fungsinya atau menjalankan kuasanya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_8__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_8__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "memeriksa perniagaan dan hal ehwal suatu pemberi kredit atau pemberi perkhidmatan kredit yang dikawal selia oleh Suruhanjaya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_8__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_8__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mengenakan penalti monetari di bawah seksyen 106;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_8__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_8__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menyebabkan suatu penyiasatan dibuat dan menjalankan semua kuasa penyiasatan mengenai perkara yang berhubungan dengan perniagaan kredit atau perniagaan perkhidmatan kredit yang dikawal selia oleh Suruhanjaya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_8__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_8__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menentukan standard atau garis panduan di bawah seksyen 123 mengenai perkara yang berhubungan dengan kredit pengguna yang dikawal selia oleh Suruhanjaya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_8__subsec_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_8__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menggunakan semua harta alih dan tak alih Suruhanjaya mengikut cara sebagaimana yang Suruhanjaya fikirkan suai manfaat, termasuk mendapatkan dana dengan menggadai janji harta itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_8__subsec_2__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_8__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menubuhkan dan memberi kuasa kepada suatu jawatankuasa yang terdiri daripada anggota sebagaimana yang ditentukan oleh Suruhanjaya bagi maksud melaksanakan apa-apa fungsinya atau menjalankan apa-apa kuasanya di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_8__subsec_2__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_8__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "melantik dan menyara apa-apa ejen, pakar atau perunding sebagaimana yang disifatkannya patut bagi membantu Suruhanjaya dalam melaksanakan fungsinya atau menjalankan kuasanya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_8__subsec_2__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_8__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "membayar saraan, elaun dan perbelanjaan lain anggota Lembaga dan Jawatankuasa Lembaga;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_8__subsec_2__para_l",
      "@type": "akn:paragraph",
      "eli:number": "l",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_8__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "memberi geran, pinjaman, pembiayaan dan pendahuluan kepada mana-mana orang atas terma dan syarat sebagaimana yang ditentukan oleh Lembaga; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_8__subsec_2__para_m",
      "@type": "akn:paragraph",
      "eli:number": "m",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_8__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "melakukan apa-apa perkara yang bersampingan dengan mana-mana fungsinya dan kuasanya. Lembaga"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Hendaklah ada suatu Lembaga Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9__subsec_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga hendaklah terdiri daripada anggota yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang Pengerusi Eksekutif yang hendaklah menjadi pengerusi Lembaga;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang Timbalan Pengerusi Eksekutif yang hendaklah menjadi timbalan pengerusi Lembaga;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9__subsec_2__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9__subsec_2__para_c__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9__subsec_2__para_c__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang anggota yang mewakili setiap yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9__subsec_2__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9__subsec_2__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "Kementerian Kewangan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9__subsec_2__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9__subsec_2__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "Bank Negara Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9__subsec_2__para_c__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9__subsec_2__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "Suruhanjaya Sekuriti Malaysia; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak lebih daripada empat orang anggota lain yang hendaklah mempunyai pengetahuan dan pengalaman yang berkaitan dalam perkara yang berhubungan dengan kredit pengguna atau apa-apa perkara lain yang berkaitan dengan fungsi Suruhanjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Anggota Lembaga termasuk seorang anggota silih ganti bagi mana-mana anggota yang disebut dalam perenggan (2)(c) hendaklah dilantik oleh Menteri, atas syor Lembaga."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Anggota silih ganti itu hendaklah hanya disifatkan sebagai anggota Lembaga apabila menghadiri mesyuarat Lembaga bagi menggantikan tempat anggota yang disebut dalam perenggan (2)(c)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9__subsec_5__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9__subsec_5__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9__subsec_5__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9__subsec_5__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah bertanggungjawab bagi, dan mempunyai pemantauan ke atas penjalanan perniagaan dan hal ehwal Suruhanjaya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah bertanggungjawab bagi objektif dasar yang berhubungan dengan industri kredit;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9__subsec_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah bertanggungjawab bagi pentadbiran am dan pengawasan keseluruhan tadbir urus Suruhanjaya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9__subsec_5__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah bertanggungjawab bagi mengkaji semula dan meluluskan belanjawan dan pelan strategik Suruhanjaya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9__subsec_5__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "hendaklah bertanggungjawab bagi apa-apa perkara lain sebagaimana yang diperuntukkan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_II__cl_9__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "hasPart": [
