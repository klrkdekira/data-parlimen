      "schema:text": {
        "@language": "ms",
        "@value": "Pemerolehan pinjaman atau pembiayaan terjejas"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_3__para_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_3__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Pemilikan semula"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_3__para_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_3__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Kaunseling dan pengurusan hutang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_3__para_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_3__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Platform pinjaman ramai dalam talian"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_3__para_2",
      "@type": "akn:paragraph",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_3__para_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_3__para_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_3__para_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_3__para_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_3__para_2__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_3",
      "schema:name": {
        "@language": "ms",
        "@value": "Tafsiran perniagaan perkhidmatan kredit"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_3__para_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_3__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "“Pemungutan hutang” ertinya memungut hutang atau obligasi kewangan yang perlu dibayar di bawah suatu perjanjian kredit bagi pihak suatu pemberi kredit atau pemberi perkhidmatan kredit yang menjalankan perniagaan pemerolehan pinjaman atau pembiayaan terjejas, mengikut mana-mana yang berkenaan, selain pemungutan yang dilakukan oleh seorang peguam bela dan peguam cara yang dikawal selia di bawah Akta Profesion Undang-Undang 1976 [Akta 166]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_3__para_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_3__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "“Pemerolehan pinjaman atau pembiayaan terjejas” ertinya memperolehi pinjaman atau pembiayaan terjejas di bawah suatu perjanjian kredit jika pemeroleh akan mengambil alih dan melaksanakan semua hak dan obligasi suatu pemberi kredit berhubung dengan perjanjian kredit itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_3__para_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_3__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "“Pemilikan semula” ertinya aktiviti pemilikan semula barangan yang terkandung di dalam suatu “perjanjian sewa beli” sebagaimana yang ditakrifkan di dalam Akta Sewa Beli 1967."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_3__para_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_3__para_2__para_d__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_3__para_2__para_d__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_3__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "“Kaunseling dan pengurusan hutang” ertinya aktiviti-aktiviti berikut yang dijalankan oleh orang-orang lain selain daripada suatu pemberi kredit:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_3__para_2__para_d__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_3__para_2__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "memberikan nasihat berkenaan dengan apa-apa perkara yang berhubungan dengan suatu perjanjian kredit; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_3__para_2__para_d__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_3__para_2__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "merundingkan suatu pelan penyelesaian hutang dengan pemberi kredit itu bagi pihak seorang pengguna kredit berkenaan dengan suatu perjanjian kredit yang boleh melibatkan penstrukturan atau penjadualan semula hutang."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_3__para_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_3__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "“Platform pinjaman ramai dalam talian” ertinya aktiviti mengendalikan suatu platform elektronik yang diberi kuasa oleh Suruhanjaya Sekuriti Malaysia, yang memudahkan secara langsung atau tidak langsung pinjaman atau pembiayaan kredit kepada seorang pengguna kredit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_4",
      "@type": "akn:schedule",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_4__para_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_4__para_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_4__para_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "[Subseksyen 40(1), 41(1), 57(1) dan 58(1) dan seksyen 79] PERNIAGAAN KREDIT DAN PERNIAGAAN PERKHIDMATAN KREDIT MENGHENDAKI PELESENAN ATAU PENDAFTARAN"
      }
    },
    {
