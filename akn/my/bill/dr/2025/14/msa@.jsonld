      "schema:text": {
        "@language": "ms",
        "@value": "untuk memudahkan kerjasama dan penyelarasan antara anggota Jawatankuasa Penasihat berhubung dengan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IV__cl_38__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IV__cl_38__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "penjalanan kuasa penyeliaan, penyiasatan dan penguatkuasaan di bawah Akta ini, termasuk dalam hal keadaan jika penjalanan kuasa itu oleh suatu Pihak Berkuasa Pengawalseliaan dan Penyeliaan mungkin melibatkan perkara yang dikawal selia oleh Pihak Berkuasa Pengawalseliaan dan Penyeliaan yang lain;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IV__cl_38__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IV__cl_38__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "pembangunan kapasiti Pihak-Pihak Berkuasa Pengawalseliaan dan Penyeliaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IV__cl_38__para_c__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IV__cl_38__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "memacu reformasi rangka kerja pengawalseliaan kredit pengguna;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IV__cl_38__para_c__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IV__cl_38__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "menggalakkan kesedaran dan pendidikan kewangan pengguna kredit untuk menggalakkan suatu budaya kredit yang kukuh; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IV__cl_38__para_c__subpara_v",
      "@type": "akn:subparagraph",
      "eli:number": "v",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IV__cl_38__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "menugaskan atau menjalankan kajian atau penyelidikan am bagi maksud yang berhubung dengan Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IV__cl_38__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IV__cl_38",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menimbang teliti implikasi mana-mana undang-undang bertulis, garis panduan, atau dasar yang dicadangkan oleh Suruhanjaya atau Pihak Berkuasa Pengawalseliaan dan Penyeliaan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IV__cl_38__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IV__cl_38",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menimbang teliti apa-apa perkara yang boleh dirujuk kepadanya bagi maksud pelaksanaan Akta ini secara patut dan berkesan, dan untuk perlindungan pengguna kredit. Mesyuarat Jawatankuasa Penasihat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IV__cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatankuasa Penasihat boleh mengadakan tatacaranya sendiri, yang hendaklah selaras dengan amalan tadbir urus yang baik."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX",
      "@type": "akn:part",
      "eli:number": "IX",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_106",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_107",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_108",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IX__cl_109",
