    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_III__cl_34__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_III__cl_34__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_III__cl_34__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_III__cl_34",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu Pihak Berkuasa Pengawalseliaan dan Penyeliaan hendaklah mempunyai semua fungsi untuk mengawal selia dan menyelia orang-orang yang berikut yang dikawal selia oleh Pihak Berkuasa Pengawalseliaan dan Penyeliaan itu:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_III__cl_34__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_III__cl_34__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pemberi kredit yang menjalankan perniagaan kredit sebagaimana yang dinyatakan dalam Jadual 2; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_III__cl_34__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_III__cl_34__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pemberi perkhidmatan kredit yang menjalankan perniagaan perkhidmatan kredit sebagaimana yang dinyatakan dalam Jadual 3."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_III__cl_34__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
