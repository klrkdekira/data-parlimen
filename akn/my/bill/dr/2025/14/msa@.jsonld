      "schema:text": {
        "@language": "ms",
        "@value": "Akta Pemberi Pinjam Wang 1951 [Akta 400];"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_2__subsec_3__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
