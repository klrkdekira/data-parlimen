      "schema:text": {
        "@language": "ms",
        "@value": "Pemungutan hutang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_3__para_1__para_b",
      "@type": "akn:paragraph",
