      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi Eksekutif sebagai pengerusi Jawatankuasa Penasihat;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IV__cl_37__para_b",
