        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IV__cl_38__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IV__cl_38__para_d",
