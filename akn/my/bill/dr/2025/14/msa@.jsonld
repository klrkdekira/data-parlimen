        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_III__cl_34__subsec_3__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_III__cl_34__subsec_3__para_g",
