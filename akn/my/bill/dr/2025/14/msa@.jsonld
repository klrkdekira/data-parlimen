      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatankuasa Penasihat hendaklah mempunyai fungsi yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IV__cl_38__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IV__cl_38",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menyelaras dasar dan strategi bagi perlindungan pengguna kredit selaras dengan Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IV__cl_38__para_b",
      "@type": "akn:paragraph",
