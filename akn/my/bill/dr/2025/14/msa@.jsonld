      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IV__cl_38",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menggalakkan dan memantau pengawalseliaan berkesan industri kredit pengguna dan pelaksanaan Akta ini yang konsisten;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_IV__cl_38__para_c",
      "@type": "akn:paragraph",
