      "schema:text": {
        "@language": "ms",
        "@value": "Kaunseling dan pengurusan hutang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_5",
      "@type": "akn:schedule",
      "eli:number": "5",
