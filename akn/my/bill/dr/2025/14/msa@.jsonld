        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_4__list_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_4__list_3__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_4"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_4__list_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_4__list_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dilesenkan di bawah Bahagian V Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_4__list_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_4__list_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dibenarkan untuk berbuat sedemikian di bawah mana-mana undang-undang bertulis lain;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_4__list_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_4__list_3",
      "schema:text": {
        "@language": "ms",
        "@value": "tertakluk kepada Akta Sewa Beli 1967; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_4__list_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_4__list_3",
      "schema:text": {
        "@language": "ms",
        "@value": "tertakluk kepada Akta Perlindungan Pengguna 1999; “pemberi kredit Islam” ertinya seseorang yang menjalankan suatu perniagaan kredit Islam jika orang itu diberi kuasa di bawah Akta ini atau undang-undang bertulis lain; “pemberi perkhidmatan kredit” ertinya seseorang yang menjalankan suatu perniagaan perkhidmatan kredit jika orang itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_4__list_4",
      "@type": "akn:list",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_4__list_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_4__list_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_4__list_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_4"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_4__list_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_4__list_4",
      "schema:text": {
        "@language": "ms",
        "@value": "didaftarkan di bawah Bahagian V Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_4__list_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_4__list_4",
      "schema:text": {
        "@language": "ms",
        "@value": "didaftarkan untuk berbuat sedemikian di bawah Akta Pasaran Modal dan Perkhidmatan 2007; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_4__list_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_4__list_4",
      "schema:text": {
        "@language": "ms",
        "@value": "merupakan seorang pemegang permit di bawah Akta Sewa Beli 1967; “Pendaftar” ertinya pendaftar pemberi kredit Islam yang dilantik di bawah perenggan 35(2)(a); “pendaftaran” ertinya suatu pendaftaran yang dibuat di bawah seksyen 59; “pengarah” mempunyai erti yang diberikan kepadanya dalam Akta Syarikat 2016, dan termasuklah suatu sebutan kepada seseorang yang menduduki tempat atau bertindak dalam kedudukan sebagai seorang pengarah sesuatu perbadanan, dengan apa jua namanya digelar dan sama ada dilantik dengan sah atau tidak untuk menduduki tempat, atau diberi kuasa dengan sewajarnya untuk bertindak, dalam kedudukan itu; “pengawal” ertinya seseorang sebagaimana yang ditakrifkan dalam subseksyen 47(6) atau subseksyen 64(6), mengikut mana-mana yang berkenaan; “Pengerusi Eksekutif” ertinya pengerusi eksekutif Lembaga yang dilantik di bawah seksyen 9; “pengguna kredit” ertinya mana-mana orang sebagaimana yang dinyatakan dalam subseksyen 5(1); “pengurusan kanan” ertinya seseorang yang dilantik oleh suatu perbadanan untuk menguruskan mana-mana bahagian perniagaannya atau mempunyai kuasa dan tanggungjawab untuk perniagaan kredit, perniagaan perkhidmatan kredit atau keputusan perniagaan perbadanan itu, dengan apa jua namanya digelar dan termasuklah ketua eksekutif dan ketua pegawai kewangan; “perbadanan” mempunyai erti yang diberikan kepadanya dalam seksyen 3 Akta Syarikat 2016; “perjanjian kredit” ertinya suatu perjanjian yang dibuat antara suatu pemberi kredit dengan seorang pengguna kredit untuk memberikan kredit; “perkiraan” ertinya suatu perkiraan sama ada formal atau tidak formal, lisan atau bertulis, nyata atau tersirat; “perniagaan kredit” ertinya mana-mana perniagaan, sama ada konvensional atau Islam sebagaimana yang dinyatakan dalam Jadual 2; “perniagaan kredit Islam” ertinya mana-mana perniagaan sebagaimana yang dinyatakan dalam perenggan 2 Jadual 2; “perniagaan perkhidmatan kredit” ertinya mana-mana perniagaan memberi perkhidmatan yang berhubungan dengan kredit sebagaimana yang dinyatakan dalam Jadual 3; “pertubuhan perbadanan” ertinya seseorang yang diperbadankan oleh atau di bawah mana-mana undang-undang bertulis, dan termasuklah suatu perbadanan atau badan berkanun, pihak berkuasa awam atau pihak berkuasa yang lain, yang diperbadankan oleh atau di bawah suatu undang-undang bertulis; “perusahaan mikro atau kecil” merujuk kepada suatu perusahaan yang layak sebagai suatu perusahaan mikro atau kecil sebagaimana yang ditakrifkan berdasarkan saiz operasinya, oleh Majlis Pembangunan Perusahaan Kecil dan Sederhana Kebangsaan yang ditubuhkan di bawah Akta Perbadanan Perusahaan Kecil dan Sederhana Malaysia 1995 [Akta 539]; “Pihak Berkuasa Pengawalseliaan dan Penyeliaan” ertinya mana-mana badan sebagaimana yang dinyatakan di bawah subseksyen 34(1); “premis” termasuklah apa-apa tanah, bangunan, struktur, tempat atau kenderaan, sama ada tetap atau sementara; “standard atau garis panduan” termasuklah apa-apa obligasi atau kehendak sebagaimana yang ditentukan oleh Suruhanjaya atau suatu Pihak Berkuasa Pengawalseliaan dan Penyeliaan di bawah seksyen 123; “Suruhanjaya” ertinya Suruhanjaya Kredit Pengguna yang ditubuhkan di bawah seksyen 6; “syarikat” mempunyai erti yang diberikan kepadanya dalam subseksyen 2(1) Akta Syarikat 2016; “Timbalan Pendaftar” ertinya timbalan pendaftar pemberi kredit Islam yang dilantik di bawah perenggan 35(2)(a); “Timbalan Pengerusi Eksekutif” ertinya timbalan pengerusi eksekutif Lembaga yang dilantik di bawah seksyen 9; “undang-undang sekuriti” mempunyai erti yang diberikan kepadanya dalam subseksyen 2(1) Akta Suruhanjaya Sekuriti Malaysia 1993. Pengguna kredit dan kredit"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_5__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_5__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_5__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_5__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_5__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Seorang pengguna kredit yang disebut dalam Akta ini hendaklah terdiri daripada mana-mana orang yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_5__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_5__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang individu yang mendapat, telah mendapat atau berhasrat untuk mendapatkan kredit sepenuhnya atau kebanyakannya bagi maksud persendirian, domestik atau isi rumah;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_5__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_5__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang yang merupakan suatu perusahaan mikro atau kecil yang mendapat, telah mendapat atau berhasrat untuk mendapatkan kredit, jika kredit itu tidak melebihi suatu amaun sebagaimana yang ditetapkan oleh Menteri, atas syor Suruhanjaya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_5__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_5__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang lain atau kelas, kategori atau perihalan orang sebagaimana yang ditentukan oleh Suruhanjaya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_5__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_5__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang individu yang bertindak sebagai seorang penjamin sosial, bukan bagi maksud membuat keuntungan, kepada seorang pengguna kredit di bawah perenggan (a), (b) atau (c) berkenaan dengan suatu perjanjian kredit yang kepadanya Akta ini terpakai."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_5__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_5__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_5__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Kredit yang disebut dalam Akta ini hendaklah terdiri daripada suatu perkiraan, perjanjian atau kemudahan, dalam apa jua bentuk atau dengan apa jua namanya digelar, termasuk yang dibuat mengikut prinsip Shariah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_5__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "yang menyebabkan seseorang berhutang atau menanggung suatu obligasi kewangan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_5__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "yang membenarkan pembayaran untuk barangan atau perkhidmatan yang dijual kepada seseorang dibuat secara ansuran; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_5__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_I__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa perkiraan, perjanjian atau kemudahan lain sebagaimana yang ditentukan oleh Suruhanjaya."
      }
    },
