        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_96__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_96__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_96__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_96__subsec_6",
