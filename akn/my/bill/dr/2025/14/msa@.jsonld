      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2",
      "schema:name": {
        "@language": "ms",
        "@value": "Tafsiran perniagaan kredit"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_a__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_a__subpara_iv"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3",
      "schema:text": {
        "@language": "ms",
        "@value": "“Pinjaman wang” mempunyai erti yang diberikan kepadanya dalam Akta Pemberi Pinjam Wang 1951 dan tidak termasuk melanggan atau membeli sekuriti hutang yang termasuklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "saham yang dikeluarkan di bawah Akta Pinjaman (Tempatan) 1959 [Akta 637];"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "Bil Perbendaharaan yang dikeluarkan di bawah Akta Bil Perbendaharaan (Tempatan) 1946 [Akta 188];"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "pelaburan di bawah Akta Pendanaan Kerajaan 1983 [Akta 275]; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_a__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "debentur sebagaimana ditakrifkan dalam seksyen 2 Akta Pasaran Modal dan Perkhidmatan 2007."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3",
      "schema:text": {
        "@language": "ms",
        "@value": "“Perniagaan pemajakgadaian” mempunyai erti yang diberikan kepadanya dalam Akta Pemegang Pajak Gadai 1972."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3",
      "schema:text": {
        "@language": "ms",
        "@value": "“Sewa beli” ertinya memberi kredit, dengan apa jua namanya digelar melalui suatu “perjanjian sewa beli” sebagaimana yang ditakrifkan di bawah Akta Sewa Beli 1967."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3",
      "schema:text": {
        "@language": "ms",
        "@value": "“Jualan kredit” ertinya memberi kredit, dengan apa jua namanya digelar menurut suatu “transaksi jualan kredit” sebagaimana yang ditakrifkan di bawah Akta Perlindungan Pengguna 1999 dan tidak termasuk suatu skim beli sekarang bayar kemudian."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_e__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_e__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3",
      "schema:text": {
        "@language": "ms",
        "@value": "“Skim beli sekarang bayar kemudian” ertinya suatu perkiraan, dengan apa jua namanya digelar, dibuat antara seorang pengguna kredit dan suatu pemberi kredit pihak ketiga bagi pembelian barangan atau perkhidmatan oleh pengguna kredit itu daripada suatu penjual jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_e__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_e",
      "schema:text": {
        "@language": "ms",
        "@value": "pemberi kredit pihak ketiga itu memberikan kredit kepada pengguna kredit itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_e__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_e__subpara_ii__subpara_A",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_e__subpara_ii__subpara_B"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_e",
      "schema:text": {
        "@language": "ms",
        "@value": "pembayaran yang perlu dibayar oleh pengguna kredit itu kepada pemberi kredit pihak ketiga ditangguhkan dan boleh dibuat dalam suatu pembayaran tunggal atau secara ansuran mengikut terma dan syarat perkiraan itu, tetapi tidak termasuk—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_e__subpara_ii__subpara_A",
      "@type": "akn:subparagraph",
      "eli:number": "A",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_e__subpara_ii",
      "schema:text": {
        "@language": "ms",
        "@value": "“pinjaman wang” sebagaimana yang ditakrifkan dalam Akta Pemberi Pinjam Wang 1951; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_e__subpara_ii__subpara_B",
      "@type": "akn:subparagraph",
      "eli:number": "B",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_e__subpara_ii",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu “transaksi jualan kredit” sebagaimana yang ditakrifkan dalam Akta Perlindungan Pengguna 1999."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3",
      "schema:text": {
        "@language": "ms",
        "@value": "“Pemajakan” ertinya suatu kontrak atau sebahagian daripada suatu kontrak menyewakan atau menyewakan semula aset alih yang memberikan pemajak, hak untuk menggunakan aset itu yang dimiliki oleh pemberi pajak sebagai tukaran bagi pembayaran untuk suatu tempoh yang ditentukan dengan atau tanpa suatu pilihan untuk membeli aset alih itu, tetapi tidak termasuklah apa-apa kontrak yang tertakluk kepada Akta Sewa Beli 1967 atau Akta Jualan Langsung dan Skim Anti-Piramid 1993 [Akta 500]. Bagi maksud takrif ini, “aset alih” termasuklah apa-apa loji, jentera, peralatan atau catel lain yang dipasang atau akan dipasang pada bumi atau dilekatkan atau akan dilekatkan, secara tetap atau selainnya, pada apa-apa benda yang dipasang pada bumi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_g__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_g__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3",
      "schema:text": {
        "@language": "ms",
        "@value": "“Pemfaktoran” ertinya suatu perkiraan jika suatu pemberi kredit pihak ketiga—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_g__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_g",
      "schema:text": {
        "@language": "ms",
        "@value": "membeli daripada suatu penjual, akaun belum terima semasa dan masa hadapan penjual itu yang berbangkit daripada jualan barangan atau perkhidmatan kepada suatu pembeli; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_g__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_g",
      "schema:text": {
        "@language": "ms",
        "@value": "mendahulukan pembayaran kepada suatu penjual bagi suatu akaun belum bayar pembeli yang berbangkit daripada pembelian barangan atau perkhidmatan oleh pembeli daripada penjual."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3",
      "schema:text": {
        "@language": "ms",
        "@value": "“Kemudahan pembiayaan Islam” ertinya apa-apa pendahuluan, perkiraan pembiayaan atau kemudahan lain, dalam apa jua bentuk, sama ada berdasarkan jualan, pajakan, kebajikan, fi, ekuiti atau perkongsian, dan penerimaan atau penjaminan apa-apa liabiliti, obligasi atau kewajipan mana-mana orang, atau dengan apa jua namanya digelar dibuat mengikut Shariah tetapi tidak termasuklah perniagaan kredit Islam sebagaimana yang dinyatakan dalam subperenggan (i) hingga (n)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3",
      "schema:text": {
        "@language": "ms",
        "@value": "“Pemajakgadaian Islam” ertinya pemberian pembiayaan yang mengikut Shariah yang dijamin dengan suatu cagaran yang disimpan dengan selamat oleh pemberi kredit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_j__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_j__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3",
      "schema:text": {
        "@language": "ms",
        "@value": "“Sewa beli Islam” ertinya menyewakan barangan dengan suatu pilihan diberi kepada penyewa untuk membeli barangan itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_j__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_j",
      "schema:text": {
        "@language": "ms",
        "@value": "sebelum matangnya tempoh sewaan itu, pada suatu harga yang dipersetujui; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_j__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_j",
      "schema:text": {
        "@language": "ms",
        "@value": "apabila matangnya tempoh sewaan itu, mengikut terma dan syarat yang dipersetujui oleh pihak-pihak, di bawah apa-apa perjanjian yang disempurnakan mengikut konsep Shariah termasuk al-ijarah thumma al-bai’ atau al-ijarah al-muntahiyah bi al-tamlik."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3",
      "schema:text": {
        "@language": "ms",
        "@value": "“Jualan kredit Islam” ertinya memberi suatu kemudahan kepada suatu pembeli di bawah suatu transaksi jualan bayaran ditangguhkan, yang mengikut Shariah, yang membenarkan pembayaran barangan yang dijual untuk dibuat dalam suatu pembayaran tunggal atau secara ansuran dan tidak termasuk suatu skim beli sekarang bayar kemudian Islam."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_l",
      "@type": "akn:paragraph",
      "eli:number": "l",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_l__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_l__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3",
      "schema:text": {
        "@language": "ms",
        "@value": "“Skim beli sekarang bayar kemudian Islam” ertinya suatu perkiraan, dengan apa jua namanya digelar yang dibuat mengikut Shariah, antara seorang pengguna kredit dan suatu pemberi kredit pihak ketiga bagi pembelian barangan atau perkhidmatan oleh pengguna kredit daripada suatu penjual jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_l__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_l",
      "schema:text": {
        "@language": "ms",
        "@value": "pemberi kredit pihak ketiga itu memberikan kredit kepada pengguna kredit itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_l__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_l",
      "schema:text": {
        "@language": "ms",
        "@value": "pembayaran yang perlu dibayar oleh pengguna kredit kepada pemberi kredit pihak ketiga ditangguhkan dan boleh dibuat dalam suatu pembayaran tunggal atau secara ansuran mengikut terma dan syarat perkiraan itu, tetapi tidak termasuk kemudahan pembiayaan Islam dan jualan kredit Islam."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_m",
      "@type": "akn:paragraph",
      "eli:number": "m",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3",
      "schema:text": {
        "@language": "ms",
        "@value": "“Pemajakan Islam” ertinya suatu kontrak atau sebahagian daripada suatu kontrak menyewakan atau menyewakan semula aset alih yang mengikut Shariah yang memberikan pemajak, hak untuk menggunakan aset itu yang dimiliki oleh pemberi pajak sebagai tukaran bagi pembayaran untuk suatu tempoh yang ditentukan dengan atau tanpa suatu pilihan untuk membeli aset alih itu, tetapi tidak termasuk apa-apa transaksi sewa beli Islam. Bagi maksud takrif ini, “aset alih” termasuklah apa-apa loji, jentera, peralatan atau catel lain yang dipasang atau akan dipasang pada bumi atau dilekatkan atau akan dilekatkan, secara tetap atau selainnya, pada apa-apa benda yang dipasang pada bumi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_n",
      "@type": "akn:paragraph",
      "eli:number": "n",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_n__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_n__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3",
      "schema:text": {
        "@language": "ms",
        "@value": "“Pemfaktoran Islam” ertinya suatu perkiraan mengikut Shariah jika suatu pemberi kredit pihak ketiga—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_n__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_n",
      "schema:text": {
        "@language": "ms",
        "@value": "membeli daripada suatu penjual, akaun belum terima semasa dan masa hadapan penjual itu yang berbangkit daripada jualan barangan atau perkhidmatan kepada suatu pembeli; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_n__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_2__para_3__para_n",
      "schema:text": {
        "@language": "ms",
        "@value": "mendahulukan pembayaran kepada suatu penjual bagi suatu akaun belum bayar pembeli yang berbangkit daripada pembelian barangan atau perkhidmatan oleh pembeli daripada penjual."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_3",
      "@type": "akn:schedule",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_3__para_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_3__para_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "[Seksyen 4] PERNIAGAAN PERKHIDMATAN KREDIT"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~sched_3__para_1",
      "@type": "akn:paragraph",
