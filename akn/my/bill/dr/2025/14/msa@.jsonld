        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_96__subsec_9"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_96__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_96__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_96__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_96",
      "schema:text": {
        "@language": "ms",
        "@value": "Seorang pegawai penyiasat hendaklah, melainkan jika diperintahkan selainnya oleh mana-mana mahkamah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_96__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_96__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pada penutupan penyiasatan atau apa-apa prosiding yang berbangkit daripada penyiasatan itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_96__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_96__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan mendapat keizinan bertulis terdahulu Pihak Berkuasa Pengawalseliaan dan Penyeliaan masing-masing pada bila-bila masa sebelum penyiasatan ditutup, melepaskan apa-apa dokumen, cagaran yang dipegang berkenaan dengan transaksi pengguna kredit, hakmilik, wang tunai, barangan, benda, harta, perkakas, kelengkapan, jentera, komputer, output komputer, sistem, data, program, maklumat atau artikel yang disita, ditahan atau dipindah olehnya atau mana-mana pegawai penyiasat lain di bawah Bahagian ini menurut subseksyen (2) atau (3), mengikut mana-mana yang berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_96__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_96__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_96__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_96__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_96",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud subseksyen (1), jika penyiasatan itu dijalankan oleh Kementerian Perdagangan Dalam Negeri dan Kos Sara Hidup—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_96__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_96__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang yang mengakui bahawa dia adalah pemilik dokumen, cagaran yang dipegang berkenaan dengan transaksi pengguna kredit, hakmilik, wang tunai, barangan, benda, harta, perkakas, kelengkapan, jentera, komputer, output komputer, sistem, data, program, maklumat atau artikel itu, boleh, secara kediri atau melalui ejennya yang diberi kuasa secara bertulis, memberi suatu notis bertulis kepada Kementerian Perdagangan Dalam Negeri dan Kos Sara Hidup;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_96__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_96__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "setelah menerima notis di bawah perenggan (a), Kementerian Perdagangan Dalam Negeri dan Kos Sara Hidup boleh, selepas membuat pertanyaan sebagaimana yang perlu, mengarahkan dokumen, cagaran yang dipegang berkenaan dengan transaksi pengguna kredit, hakmilik, wang tunai, barangan, benda, harta, perkakas, kelengkapan, jentera, komputer, output komputer, sistem, data, program, maklumat atau artikel itu dilepaskan atau dilucut hak atau merujuk perkara itu kepada seorang majistret; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_96__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_96__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "majistret yang kepadanya perkara itu dirujuk di bawah perenggan (b) hendaklah mengeluarkan suatu saman menghendaki orang yang mengakui bahawa dia adalah pemilik dokumen, cagaran yang dipegang berkenaan dengan transaksi pengguna kredit, hakmilik, wang tunai, barangan, benda, harta, perkakas, kelengkapan, jentera, komputer, output komputer, sistem, data, program, maklumat atau artikel dan orang yang daripadanya mereka disita untuk hadir di hadapan majistret itu dan setelah kehadiran atau ketidakhadirannya, penyampaian saman yang wajar telah dibuktikan, majistret itu hendaklah meneruskan pemeriksaan ke atas perkara itu dan dengan bukti bahawa suatu kesalahan telah dilakukan di bawah Akta ini dan bahawa dokumen, cagaran yang dipegang berkenaan dengan transaksi pengguna kredit, hakmilik, wang tunai, barangan, benda, harta, perkakas, kelengkapan, jentera, komputer, output komputer, sistem, data, program, maklumat atau artikel itu adalah hal perkara atau telah digunakan dalam pelakuan suatu kesalahan hendaklah mengarahkan yang sama itu dilucut hak dan hendaklah, sehingga yang bertentangan dibuktikan, memerintahkan pelepasan mereka."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_96__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_96",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika penyiasatan itu dijalankan oleh suatu Pihak Berkuasa Pengawalseliaan dan Penyeliaan selain Kementerian Perdagangan Dalam Negeri dan Kos Sara Hidup, pegawai penyiasat itu hendaklah melepaskan dokumen, cagaran yang dipegang berkenaan dengan transaksi pengguna kredit, hakmilik, wang tunai, barangan, benda, harta, perkakas, kelengkapan, jentera, komputer, output komputer, sistem, data, program, maklumat atau artikel kepada mana-mana orang yang ditentukan olehnya berhak menurut undang-undang ke atasnya jika dia berpuas hati bahawa ia tidak dikehendaki bagi maksud apa-apa pendakwaan atau prosiding di bawah Akta ini, atau bagi maksud apa-apa pendakwaan di bawah mana-mana undang-undang bertulis lain."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_96__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_96",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud subseksyen (3), jika seorang pegawai penyiasat tidak dapat mengesan orang yang berhak menurut undang-undang ke atas dokumen, cagaran yang dipegang berkenaan dengan transaksi pengguna kredit, hakmilik, wang tunai, barangan, benda, harta, perkakas, kelengkapan, jentera, komputer, output komputer, sistem, data, program, maklumat atau artikel, pegawai penyiasat itu hendaklah menyebabkan untuk disiarkan suatu notis di laman sesawang Pihak Berkuasa Pengawalseliaan dan Penyeliaan atau dalam apa-apa cara penerbitan lain sebagaimana yang dianggap patut oleh Pihak Berkuasa Pengawalseliaan dan Penyeliaan meminta mana-mana orang yang berhak menurut undang-undang atas dokumen, cagaran yang dipegang berkenaan dengan transaksi pengguna kredit, hakmilik, wang tunai, barangan, benda, harta, perkakas, kelengkapan, jentera, komputer, output komputer, sistem, data, program, maklumat atau artikel itu untuk menuntut dokumen, cagaran yang dipegang berkenaan dengan transaksi pengguna kredit, hakmilik, wang tunai, barangan, benda, harta, perkakas, kelengkapan, jentera, komputer, output komputer, sistem, data, program, maklumat atau artikel itu dalam tempoh yang dinyatakan dalam notis itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_96__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_96__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_96__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_96",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika tiada tuntutan dibuat apabila habis tempoh yang ditentukan dalam notis yang disiarkan di bawah subseksyen (4)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_96__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_96__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "pegawai penyiasat itu hendaklah membuat suatu permohonan secara bertulis kepada mahkamah mengenai pelupusan dokumen, cagaran yang dipegang berkenaan dengan transaksi pengguna kredit, hakmilik, wang tunai, barangan, benda, harta, perkakas, kelengkapan, jentera, komputer, output komputer, sistem, data, program, maklumat atau artikel itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_96__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_96__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "mahkamah apabila menerima permohonan di bawah perenggan (a) dan setelah berpuas hati bahawa orang di bawah subseksyen (1) yang berhak menurut undang-undang atas dokumen, cagaran yang dipegang berkenaan dengan transaksi pengguna kredit, hakmilik, wang tunai, barangan, benda, harta, perkakas, kelengkapan, jentera, komputer, output komputer, sistem, data, program, maklumat atau artikel itu tidak dapat dikesan, hendaklah memerintahkan yang sama itu untuk dilucut hak atau dilupuskan oleh Pihak Berkuasa Pengawalseliaan dan Penyeliaan itu mengikut perintah yang dibuat oleh mahkamah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_96__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_96",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu rekod secara bertulis hendaklah dibuat oleh pegawai penyiasat yang menjalankan apa-apa pelepasan mana-mana dokumen, cagaran yang dipegang berkenaan dengan transaksi pengguna kredit, hakmilik, wang tunai, barangan, benda, harta, perkakas, kelengkapan, jentera, komputer, output komputer, sistem, data, program, maklumat atau artikel di bawah subseksyen (1) berkenaan dengan pelepasan itu dengan menentukan secara terperinci hal keadaan, dan sebab bagi, pelepasan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_96__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_96",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh, dalam apa-apa prosiding di hadapan mana-mana mahkamah berkenaan dengan penyitaan apa-apa dokumen, cagaran yang dipegang berkenaan dengan transaksi pengguna kredit, hakmilik, wang tunai, barangan, benda, harta, perkakas, kelengkapan, jentera, komputer, output komputer, sistem, data, program, maklumat, atau artikel yang disita dalam menjalankan atau yang berupa sebagai menjalankan apa-apa kuasa yang diberikan di bawah Akta ini, berhak kepada kos prosiding itu atau kepada apa-apa ganti rugi atau relief lain melainkan jika penyitaan itu dibuat tanpa sebab yang munasabah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_96__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_96",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika apa-apa dokumen, cagaran yang dipegang berkenaan dengan transaksi pengguna kredit, hakmilik, wang tunai, barangan, benda, harta, perkakas, kelengkapan, jentera, komputer, output komputer, sistem, data, program, maklumat atau artikel yang disita dalam penjalanan mana-mana kuasa di bawah Akta ini dipegang dalam jagaan Kerajaan sementara menunggu penyelesaian apa-apa prosiding berkenaan dengan suatu kesalahan di bawah Akta ini, kos bagi memegang yang sama itu dalam jagaan, hendaklah, jika mana-mana orang didapati bersalah atas suatu kesalahan di bawah Akta ini, menjadi suatu hutang yang kena dibayar kepada Kerajaan oleh orang itu dan hendaklah didapatkan dengan sewajarnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_96__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/14/msa@/~part_VIII__cl_96",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini, jika penyiasatan itu dijalankan oleh Kementerian Perumahan dan Kerajaan Tempatan dan pegawai penyiasat itu ialah seorang pegawai polis, pegawai polis itu hendaklah seorang pegawai kanan polis berpangkat lebih tinggi daripada pegawai kanan polis yang melaksanakan penyitaan itu. Pemeriksaan atas orang"
      }
    },
    {
