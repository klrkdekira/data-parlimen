      "schema:name": {
        "@language": "en",
        "@value": "Whistleblower Protection (Amendment) Bill 2025"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/15/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/15/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/15/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/15/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/15/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/15/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Whistleblower Protection (Amendment) Act 2025."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/15/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/15/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette and the Minister may appoint different dates for the coming into operation of different provisions of this Act. Amendment of section 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/15/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/15/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Whistleblower Protection Act 2010 [Act 711], which is referred to as the “principal Act” in this Act, is amended in section 2 by inserting after the definition of “confidential information” the following definition: ‘ “Minister” means the Minister charged with the responsibility for law;’. New section 5a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/15/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/15/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting after section 5 the following section: “Whistleblower Protection Committee 5a. (1) A committee to be known as the Whistleblower Protection Committee shall be established and shall have the following functions: (a) to oversee the implementation of this Act relating to the general powers of the enforcement agency under section 3; and (b) to obtain statistics and data relating to the disclosure and complaints received by the enforcement agency in accordance with this Act. (2) The Minister shall appoint a Chairman and not more than seven persons to be members of the Whistleblower Protection Committee, whom he deems fit and proper, on such terms and conditions as may be specified in the instrument of appointment. (3) The Chairman of the Whistleblower Protection Committee appointed under subsection (2) shall hold office for a term not exceeding three years after which he shall be eligible to be reappointed upon the expiry of his term of office. (4) The other members of the Whistleblower Protection Committee appointed under subsection (2) shall hold office for a term not exceeding three years after which they shall be eligible to be reappointed upon the expiry of their term of office. (5) The Whistleblower Protection Committee shall determine its own meeting procedure. (6) Any statistics, data or information which is required to be submitted to the Whistleblower Protection Committee for the purposes of this section shall not include the confidential information protected under section 8.”. Amendment of section 6"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/15/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/15/eng@/~cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/15/eng@/~cl_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/15/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Subsection 6(1) of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/15/eng@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/15/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the colon at the end of the subsection a full stop; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/15/eng@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/15/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting the proviso. Amendment of section 7"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/15/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/15/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 7(3) of the principal Act is amended by inserting after the words “an offence” the words “, that includes the protection under the Witness Protection Act 2009 [Act 696]”. Amendment of section 11"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/15/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/15/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraph 11(1)(a) of the principal Act is amended by inserting after the words “the whistleblower himself has” the word “wilfully”."
      }
    }
  ]
}
