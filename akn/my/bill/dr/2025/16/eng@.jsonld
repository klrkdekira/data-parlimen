      ],
      "schema:name": {
        "@language": "en",
        "@value": "Offenders Compulsory Attendance (Amendment) Bill 2025"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/16/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/16/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/16/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/16/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/16/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/16/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Offenders Compulsory Attendance (Amendment) Act 2025."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/16/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/16/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Amendment of section 5"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/16/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/16/eng@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/16/eng@/~cl_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/16/eng@/~cl_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/16/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Offenders Compulsory Attendance Act 1954 [Act 461], which is referred to as the “principal Act” in this Act, is amended in section 5—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/16/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/16/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (1) the following subsection: “(1) Subject to subsections (1a) and (1b), where a person who resides within the prescribed distance from a Centre— (a) has been convicted of an offence for which he is liable to be sentenced to imprisonment for a term of not more than ten years; or (b) is liable to be sentenced to imprisonment for failure to pay a fine or debt, the Court may consider such person to be ordered Compulsory Attendance Order in lieu of such sentence.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/16/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/16/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (1a) the following subsection: “(1a) The Court shall only make the Compulsory Attendance Order under subsection (1) if the Court is of the opinion that— (a) such person would have been adequately punished by a sentence of imprisonment for a period not exceeding three years; and (b) it is inexpedient to sentence such person to imprisonment having regard to— (i) the character of such person; (ii) the nature and seriousness of the offence; (iii) the circumstances of such person’s failure to pay, as the case may be; or (iv) any other circumstances of the case.”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/16/eng@/~cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/16/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (1a) the following subsections: “(1b) The Court shall specify in the Compulsory Attendance Order under subsection (1), requiring such person— (a) to attend daily at a Centre; and (b) to undertake compulsory work— (i) for a period not exceeding twelve months; and (ii) for the number of hours each day not exceeding four hours. (1c) The Court may, for further ensuring due compliance with such Compulsory Attendance Order, require the offender to execute a bond with or without sureties.”. Amendment of section 8"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/16/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/16/eng@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/16/eng@/~cl_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/16/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 8 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/16/eng@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/16/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (1) the following subsections: “(1a) Upon receiving a report under subsection (1), the Court shall cause the offender to be brought before it and the Court may issue— (a) a summon requiring the offender to appear at the place and time as specified in the summons; or (b) a warrant for his arrest. (1b) An offender when arrested under paragraph (2)(b) may, if not brought immediately before the Court under subsection (2)— (a) be detained in a place of detention until such time as he can be brought before the Court; or (b) be released on bail, with or without sureties.”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/16/eng@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/16/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (2), by substituting for the words “On receipt of such report the Court shall cause the offender to be brought before it, and if satisfied as to the truth of such allegations, may pass” the words “If the Court is satisfied that such allegation is true, the Court may pass”."
      }
    }
  ]
}
