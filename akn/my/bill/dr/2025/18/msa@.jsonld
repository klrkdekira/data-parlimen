      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “di perairan perikanan Malaysia” perkataan “, jaminan keselamatan dan kualiti ikan dan keluaran ikan”. Pindaan seksyen 1"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/18/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
