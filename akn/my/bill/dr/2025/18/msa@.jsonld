      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (b), dengan menggantikan perkataan “atau pertubuhan perbadanan yang diperihalkan di bawah perenggan (a)(i), (a)(ii),"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/18/msa@/~cl_5__list_2",
      "@type": "akn:list",
