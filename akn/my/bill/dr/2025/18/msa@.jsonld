      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “pengurusan” perkataan “, akuakultur, penyelidikan, pengembangan”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/18/msa@/~cl_3__para_b",
