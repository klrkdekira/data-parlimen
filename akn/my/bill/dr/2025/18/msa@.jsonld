      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 1(1) Akta ibu dipinda dengan menggantikan perkataan “Wilayah-Wilayah Persekutuan Kuala Lumpur dan Labuan” dengan perkataan “Wilayah-Wilayah Persekutuan Kuala Lumpur, Labuan dan Putrajaya”. Pindaan seksyen 2"
      }
    },
