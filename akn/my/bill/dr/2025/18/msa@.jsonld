        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/18/msa@/~cl_15__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/18/msa@/~cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/18/msa@/~cl_15__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/18/msa@/~cl_15__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (a), dengan menggantikan perkataan “atau tanan” dengan perkataan “, tanan, enjin atau apa-apa pengenalan”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/18/msa@/~cl_15__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/18/msa@/~cl_15__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan (a) perenggan yang berikut: “(aa) Mana-mana orang yang merosakkan apa-apa pengenalan vesel penangkapan ikan berlesen atau apa-apa pengenalan peralatan menangkap ikan berlesen adalah bersalah melakukan suatu kesalahan.”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/18/msa@/~cl_15__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/18/msa@/~cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (3), dengan menggantikan perenggan (b) dengan perenggan yang berikut: “(b) Mana-mana pemunya, nakhoda atau tiap-tiap anggota kru vesel penangkapan ikan yang menggunakan apa-apa huruf, nombor atau cara pengenalan lain selain huruf, nombor atau cara pengenalan lain sebagaimana yang diuntukkan kepada vesel penangkapan ikan itu adalah bersalah melakukan suatu kesalahan dan boleh didakwa secara berasingan.”. Pindaan seksyen 15"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/18/msa@/~cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/18/msa@/~cl_16__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/18/msa@/~cl_16__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/18/msa@/~cl_16__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/18/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 15 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/18/msa@/~cl_16__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/18/msa@/~cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (1)(a), dengan memotong perkataan “atau cuba menangkap ikan”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/18/msa@/~cl_16__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/18/msa@/~cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (2) dengan subseksyen yang berikut: “(2) Tiada pemunya, nakhoda atau anggota kru apa-apa vesel penangkapan ikan asing di perairan perikanan Malaysia boleh— (a) memuat atau memunggah apa-apa ikan, bekalan, bahan api atau umpan; (b) menjalankan aktiviti pindah kapal; atau (c) menjalankan apa-apa aktiviti penyelenggaraan atau apa-apa aktiviti lain, dalam apa-apa hal keadaan berhubung dengan apa-apa vesel penangkapan ikan atau pengangkut atau apa-apa pangkalan atau pelabuhan kecuali dengan kelulusan bertulis Ketua Pengarah.”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/18/msa@/~cl_16__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/18/msa@/~cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (2) subseksyen yang berikut: “(3) Mana-mana orang yang melanggar subseksyen (1) atau (2) adalah bersalah melakukan suatu kesalahan.”. Pindaan seksyen 16"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/18/msa@/~cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/18/msa@/~cl_17__para_a",
