      "schema:text": {
        "@language": "ms",
        "@value": "dalam takrif “vesel penangkapan ikan tempatan”—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/18/msa@/~cl_5__list_1__para_p__subpara_i",
