      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/18/msa@/~cl_40__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
