      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (a)(iv), dengan memotong perkataan “atau” di hujung perenggan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/18/msa@/~cl_5__list_1__para_p__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
