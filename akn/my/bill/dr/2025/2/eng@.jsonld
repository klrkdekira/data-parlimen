      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting after section 58 the following section: “Jurisdiction to try offences 58a. Notwithstanding any written law to the contrary, a court of a First Class Magistrate shall have jurisdiction to try any offence under this Act and to impose punishment under this Act for any such offence.”. Amendment of section 59"
      }
    },
