      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/2/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by substituting for section 44 the following section: “Prosecution 44. No prosecution for an offence under this Act shall be instituted except by or with the written consent of the Public Prosecutor.”. Amendment of section 49"
      }
    },
