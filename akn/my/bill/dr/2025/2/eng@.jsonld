      "schema:text": {
        "@language": "en",
        "@value": "Section 7b of the principal Act is amended by substituting for the words “and Voluntary Fire Officers” the words “, Voluntary Fire Officers and Voluntary Fire Brigades”. New section 7c"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/2/eng@/~cl_8",
