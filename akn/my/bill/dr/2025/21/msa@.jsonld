        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~part_III__cl_22",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~part_III__cl_23",
