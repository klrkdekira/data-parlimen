      "schema:text": {
        "@language": "ms",
        "@value": "subpenggal 2 dan 3 Penggal 7 Bahagian III, Penggal 8 Bahagian III, dan Bahagian IV dan V Akta Syarikat 2016;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~part_I__cl_2__subsec_1__list_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
