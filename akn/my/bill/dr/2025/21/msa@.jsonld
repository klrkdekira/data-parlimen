      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~part_I__cl_3__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Pendaftaran Perniagaan 1956 [Akta 197];"
      }
    },
