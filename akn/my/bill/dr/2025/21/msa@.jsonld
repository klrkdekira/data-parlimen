      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~part_I__cl_2__subsec_1__list_3__para_b",
