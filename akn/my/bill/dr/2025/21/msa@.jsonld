        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~part_I__cl_2__subsec_1__list_1__para_b__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~part_I__cl_2__subsec_1__list_1__para_b__subpara_iv"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~part_I__cl_2__subsec_1__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "seseorang yang dilantik di bawah Akta Syarikat 2016 untuk bertindak dalam mana-mana kapasiti yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~part_I__cl_2__subsec_1__list_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~part_I__cl_2__subsec_1__list_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "penyelesai atau penyelesai interim, sama ada dalam penggulungan paksa atau sukarela;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~part_I__cl_2__subsec_1__list_1__para_b__subpara_ii",
