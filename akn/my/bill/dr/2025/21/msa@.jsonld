        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_I__para_14",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_I__para_15",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_I__para_16",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_I__para_17"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketidakpakaian Akta ini tidak terpakai bagi—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_II",
      "@type": "akn:part",
      "eli:number": "II",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_II__para_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_II__para_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_II__para_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_II__para_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Peruntukan berhubung dengan sekatan terhadap pemberian pengiktirafan, relief, dsb., dalam hal keadaan tertentu"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_II__para_1",
      "@type": "akn:paragraph",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_II__para_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_II__para_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_II__para_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengiktirafan mana-mana prosiding asing, pemberian apa-apa relief atau pengubahsuaian apa-apa relief yang telah diberikan, atau pemberian apa-apa kerjasama atau penyelarasan di bawah Akta ini tidak boleh dibenarkan, jika dan setakat yang pengiktirafan, relief, relief yang diubah suai, kerjasama atau penyelarasan itu akan, dalam hal prosiding di bawah mana-mana undang-undang bertulis—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_II__para_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_II__para_1__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_II__para_1__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_II__para_1__para_a__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_II__para_1__para_a__subpara_iv",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_II__para_1__para_a__subpara_v"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_II__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "adalah dilarang menurut kuasa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_II__para_1__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_II__para_1__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "seksyen 42, 44, 194 atau 195 Akta Perkhidmatan Kewangan 2013;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_II__para_1__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_II__para_1__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "seksyen 52, 54, 206 atau 207 Akta Perkhidmatan Kewangan Islam 2013;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_II__para_1__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_II__para_1__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "seksyen 25, 26, 65, 91 atau 204, dan Bahagian VII atau IX Akta Perbadanan Insurans Deposit Malaysia 2011;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_II__para_1__para_a__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_II__para_1__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "Penggal 2 Bahagian II Akta Pasaran Modal dan Perkhidmatan 2007; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_II__para_1__para_a__subpara_v",
      "@type": "akn:subparagraph",
      "eli:number": "v",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_II__para_1__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Kepentingan Antarabangsa Mengenai Kelengkapan Bergerak (Pesawat Udara) 2006 [Akta 659];"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_II__para_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_II__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mengganggu atau tidak selaras dengan kemuktamadan pembayaran atau perkiraan penghasilan bersih di bawah Penggal 3 Bahagian IV Akta Perkhidmatan Kewangan 2013 atau Penggal 3 Bahagian V Akta Perkhidmatan Kewangan Islam 2013; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_II__para_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_II__para_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mengganggu atau tidak selaras dengan kebolehkuatkuasaan peruntukan penghasilan bersih dalam perjanjian kewangan yang layak berkenaan dengan transaksi kewangan yang layak sebagaimana yang ditakrifkan dalam atau ditetapkan di bawah Akta Penghasilan Bersih Perjanjian Kewangan 2015 [Akta 766]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_II__para_2",
      "@type": "akn:paragraph",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_II__para_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_II__para_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_II__para_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengiktirafan mana-mana prosiding asing, pemberian apa-apa relief atau pengubahsuaian apa-apa relief yang telah diberikan, atau pemberian apa-apa kerjasama atau penyelarasan di bawah Akta ini tidak boleh dibenarkan atas permohonan oleh mana-mana wakil asing atau mana-mana pemohon lain dalam mana-mana prosiding berkenaan dengan mana-mana orang yang kepadanya atau yang berkenaan dengannya Bank Negara Malaysia—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_II__para_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_II__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menentukan langkah-langkah di bawah perenggan 31(1)(a) Akta Bank Negara Malaysia 2009 [Akta 701], yang pada pendapat Bank Negara Malaysia akan menyumbang kepada daya tahan sistem kewangan atau mengehadkan penumpuan mana-mana risiko kepada kestabilan kewangan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_II__para_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_II__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mengeluarkan suatu perintah secara bertulis di bawah perenggan 31(1)(b) Akta Bank Negara Malaysia 2009, untuk mengambil apa-apa langkah sebagaimana yang Bank Negara Malaysia berpendapat perlu atau wajar untuk mengelakkan atau mengurangkan apa-apa risiko kepada kestabilan kewangan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_II__para_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_II__para_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menjalankan kuasanya di bawah seksyen 32 Akta Bank Negara Malaysia 2009 bagi maksud mengelakkan atau mengurangkan apa-apa risiko kepada kestabilan kewangan, melainkan jika wakil asing atau pemohon lain itu telah mendapat kelulusan bertulis terdahulu daripada Bank Negara Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_II__para_3",
      "@type": "akn:paragraph",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengiktirafan mana-mana prosiding asing, pemberian apa-apa relief atau pengubahsuaian apa-apa relief yang telah diberikan, atau pemberian apa-apa kerjasama atau penyelarasan di bawah Akta ini tidak boleh dibenarkan atas permohonan oleh mana-mana wakil asing atau mana-mana pemohon lain dalam mana-mana prosiding berkenaan dengan mana-mana orang yang kepadanya atau yang berkenaan dengannya Suruhanjaya Sekuriti Malaysia telah mengeluarkan suatu arahan secara bertulis di bawah seksyen 31zg Akta Suruhanjaya Sekuriti Malaysia 1993 [Akta 498] untuk mengambil apa-apa langkah yang didapati perlu oleh Suruhanjaya Sekuriti Malaysia bagi kepentingan mengawasi, mengurangkan atau menguruskan risiko sistemik dalam pasaran modal, melainkan jika wakil asing atau pemohon lain itu telah mendapat kelulusan bertulis terdahulu daripada Suruhanjaya Sekuriti Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_II__para_4",
      "@type": "akn:paragraph",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengiktirafan mana-mana prosiding asing, pemberian apa-apa relief atau pengubahsuaian apa-apa relief yang telah diberikan, atau pemberian apa-apa kerjasama atau penyelarasan di bawah Akta ini tidak boleh dibenarkan atas permohonan oleh mana-mana wakil asing atau mana-mana pemohon lain dalam mana-mana prosiding berkenaan dengan mana-mana orang yang kepadanya atau yang berkenaan dengannya Lembaga Perkhidmatan Kewangan Labuan telah mengeluarkan suatu arahan di bawah seksyen 4B Akta Lembaga Perkhidmatan Kewangan Labuan 1996 [Akta 545], untuk mengambil apa-apa langkah yang didapati perlu oleh Lembaga Perkhidmatan Kewangan Labuan untuk memberi kesan kepada objektifnya di bawah subseksyen 3(2) Akta Lembaga Perkhidmatan Kewangan Labuan 1996, termasuk langkah-langkah yang perlu bagi pembangunan dan pentadbiran yang teratur akan perniagaan antarabangsa dan perkhidmatan kewangan di Labuan, melainkan jika wakil asing atau pemohon lain itu telah mendapat kelulusan bertulis terdahulu daripada Lembaga Perkhidmatan Kewangan Labuan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_I__para_1",
      "@type": "akn:paragraph",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_I",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang berlesen, syarikat pemegangan kewangan, pengendali sistem pembayaran yang ditetapkan, pengendali sistem pembayaran yang diluluskan atau pengeluar instrumen pembayaran yang ditetapkan yang diluluskan sebagaimana yang ditakrifkan dalam subseksyen 2(1) Akta Perkhidmatan Kewangan 2013 [Akta 758];"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_I__para_10",
      "@type": "akn:paragraph",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_I",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana penanggung insurans Labuan dan penanggung insurans semula Labuan yang dilesenkan di bawah seksyen 103 Akta Perkhidmatan Kewangan dan Sekuriti Labuan 2010, termasuk orang yang menjalankan perniagaan insurans kaptif Labuan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_I__para_11",
      "@type": "akn:paragraph",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_I",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana pengendali takaful Labuan dan pengendali takaful semula Labuan yang dilesenkan di bawah seksyen 78 Akta Perkhidmatan Kewangan dan Sekuriti Islam Labuan 2010, termasuk orang yang menjalankan perniagaan takaful kaptif Labuan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_I__para_12",
      "@type": "akn:paragraph",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_I",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana syarikat sel terlindung Labuan yang diperbadankan di bawah seksyen 130o Akta Syarikat Labuan 1990;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_I__para_13",
      "@type": "akn:paragraph",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_I",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana syarikat amanah Labuan, syarikat amanah diurus Labuan dan syarikat amanah persendirian Labuan yang masing-masing dilesenkan atau didaftarkan di bawah seksyen 61, 71 atau 74 Akta Perkhidmatan Kewangan dan Sekuriti Labuan 2010;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_I__para_14",
      "@type": "akn:paragraph",
      "eli:number": "14",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_I",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana amanah Labuan yang diwujudkan di bawah seksyen 8 Akta Amanah Labuan 1996 [Akta 554] dan mana-mana amanah Islam Labuan yang ditubuhkan di bawah seksyen 105 Akta Perkhidmatan Kewangan dan Sekuriti Islam Labuan 2010;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_I__para_15",
      "@type": "akn:paragraph",
      "eli:number": "15",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_I",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang yang mengendalikan sistem pembayaran Labuan yang diluluskan di bawah seksyen 171 Akta Perkhidmatan Kewangan dan Sekuriti Labuan 2010 atau seksyen 136 Akta Perkhidmatan Kewangan dan Sekuriti Islam Labuan 2010;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_I__para_16",
      "@type": "akn:paragraph",
      "eli:number": "16",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_I",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana bursa yang diluluskan di bawah seksyen 134 Akta Perkhidmatan Kewangan dan Sekuriti Labuan 2010; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_I__para_17",
      "@type": "akn:paragraph",
      "eli:number": "17",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_I",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana yayasan Labuan yang ditubuhkan di bawah seksyen 4 Akta Yayasan Labuan 2010 [Akta 706] atau mana-mana yayasan Islam Labuan yang ditubuhkan di bawah seksyen 107 Akta Perkhidmatan Kewangan dan Sekuriti Islam Labuan 2010."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_I__para_2",
      "@type": "akn:paragraph",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_I",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang berlesen, syarikat pemegangan kewangan, pengendali sistem pembayaran yang ditetapkan, pengendali sistem pembayaran yang diluluskan atau pengeluar instrumen pembayaran Islam yang ditetapkan yang diluluskan sebagaimana yang ditakrifkan dalam subseksyen 2(1) Akta Perkhidmatan Kewangan Islam 2013 [Akta 759];"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_I__para_3",
      "@type": "akn:paragraph",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_I",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana institusi yang ditetapkan sebagaimana yang ditakrifkan dalam subseksyen 3(1) Akta Institusi Kewangan Pembangunan 2002 [Akta 618];"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_I__para_4",
      "@type": "akn:paragraph",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_I",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang yang ditetapkan sebagai institusi kewangan yang ditetapkan di bawah seksyen 212 Akta Perkhidmatan Kewangan 2013 atau sebagai institusi kewangan Islam yang ditetapkan di bawah seksyen 223 Akta Perkhidmatan Kewangan Islam 2013;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_I__para_5",
      "@type": "akn:paragraph",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_I",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana institusi anggota atau institusi perantaraan sebagaimana yang ditakrifkan di bawah subseksyen 2(1) Akta Perbadanan Insurans Deposit Malaysia 2011 [Akta 720];"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_I__para_6",
      "@type": "akn:paragraph",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_I",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana syarikat pemegangan bursa dan subsidiarinya termasuk bursa saham, bursa derivatif, pengendali pasaran diiktiraf atau pusat penjelasan, sebagaimana yang diluluskan atau didaftarkan di bawah Akta Pasaran Modal dan Perkhidmatan 2007 [Akta 671];"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_I__para_7",
      "@type": "akn:paragraph",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_I",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana depositori pusat yang diluluskan di bawah seksyen 5 Akta Perindustrian Sekuriti (Depositori Pusat) 1991 [Akta 453];"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_I__para_8",
      "@type": "akn:paragraph",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_I",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana bank Labuan dan bank pelaburan Labuan yang masing-masing dilesenkan di bawah seksyen 88 dan 89 Akta Perkhidmatan Kewangan dan Sekuriti Labuan 2010 [Akta 704] dan bank Islam Labuan dan bank pelaburan Islam Labuan yang masing-masing dilesenkan di bawah seksyen 63 dan 64 Akta Perkhidmatan Kewangan dan Sekuriti Islam Labuan 2010 [Akta 705];"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_I__para_9",
      "@type": "akn:paragraph",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~sched_1__part_I",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana entiti berlesen Labuan yang menjalankan perniagaan kewangan Labuan di bawah seksyen 90 Akta Perkhidmatan Kewangan dan Sekuriti Labuan 2010 atau perniagaan kewangan Islam Labuan yang dilesenkan di bawah seksyen 65 Akta Perkhidmatan Kewangan dan Sekuriti Islam Labuan 2010;"
      }
    }
  ]
}
