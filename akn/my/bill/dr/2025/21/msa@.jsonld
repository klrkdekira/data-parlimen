        "@language": "ms",
        "@value": "mana-mana perkongsian liabiliti terhad dan perkongsian liabiliti terhad asing di bawah Akta Perkongsian Liabiliti Terhad 2012 [Akta 743]; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~part_I__cl_3__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~part_I__cl_3__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang sebagaimana yang dinyatakan dalam Bahagian I Jadual. Akta hendaklah dibaca bersama-sama undang-undang lain"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~part_I__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~part_I",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini hendaklah dibaca bersama-sama mana-mana undang-undang bertulis lain yang berhubungan dengan insolvensi dan perkara yang berkaitan dan peruntukan Akta ini hendaklah menjadi tambahan kepada, dan tidak mengurangkan, peruntukan undang-undang bertulis lain itu. Mahkamah kompeten"
      }
    },
