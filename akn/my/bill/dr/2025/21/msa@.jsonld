        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~part_I__cl_3__subsec_2__para_b__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~part_I__cl_3__subsec_2__para_b__subpara_iv"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~part_I__cl_3__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang yang menjalankan perniagaan berdaftar atau perniagaan berlesen di bawah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/21/msa@/~part_I__cl_3__subsec_2__para_b__subpara_i",
