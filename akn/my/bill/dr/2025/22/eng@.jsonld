        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/22/eng@/~cl_11__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/22/eng@/~cl_11__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/22/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 27a of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/22/eng@/~cl_11__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/22/eng@/~cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "by renumbering the existing section as subsection (1); and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/22/eng@/~cl_11__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/22/eng@/~cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (1) as renumbered the following subsection: “(2) Notwithstanding subsection (1), an anti-dumping duty imposed under this Act shall be terminated— (a) on a date not later than five years from its imposition; or (b) five years from the date of the conclusion of the most recent expiry review.”. Amendment of section 28"
      }
    },
