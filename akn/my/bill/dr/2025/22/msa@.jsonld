      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 31 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/22/msa@/~cl_15__para_a",
      "@type": "akn:paragraph",
