      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/22/msa@/~cl_15__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/22/msa@/~cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “mana-mana orang atau pegawai yang diberi kuasa di bawah Akta ini” dengan perkataan “pihak berkuasa penyiasat”; dan"
