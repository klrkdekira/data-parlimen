      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “atas apa-apa asas munasabah” perkataan “sebagaimana yang ditentukan oleh Kerajaan”. Pindaan seksyen 24"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/22/msa@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
