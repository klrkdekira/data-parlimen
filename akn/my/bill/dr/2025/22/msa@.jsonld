      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “ternyata” perkataan “kepada Kerajaan”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/22/msa@/~cl_8__para_b__subpara_ii",
      "@type": "akn:subparagraph",
