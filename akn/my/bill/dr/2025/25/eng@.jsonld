      "schema:text": {
        "@language": "en",
        "@value": "to prescribe the manner relating to extension of time to commence an urban renewal project;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_V__cl_29__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_V__cl_29__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe any matter relating to mediation under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_V__cl_29__subsec_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_V__cl_29__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to provide for any other matters required by this Act to be prescribed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_V__cl_29__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_V__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "The State Authority may make rules for the purpose of carrying out or giving effect to the provisions of this Act. Public servant"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_V__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "Any officer of a body appointed by the Federal Executive Committee or the State Executive Committee while discharging his duties or performing his functions under this Act in such capacity shall be deemed to be a public servant within the meaning of Penal Code [Act 574]. Public Authorities Protection Act 1948"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_V__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "The Public Authorities Protection Act 1948 [Act 198] shall apply to any action, suit, prosecution or proceedings against any member of the Federal Executive Committee or the State Executive Committee, or any officer of a body appointed by the Federal Executive Committee or the State Executive Committee, in respect of any act or thing done or committed by him in such capacity."
      }
    }
  ]
}
