      "schema:text": {
        "@language": "en",
        "@value": "A member of the State Urban Renewal Mediation Committee shall disclose, as soon as practicable, to the State Executive Committee any interest, whether substantial or not, which may conflict with the member’s duties as a member of the State Urban Renewal Mediation Committee in an urban renewal project."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_IV__cl_28__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_IV__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of subsection (1), where a member has interest in an urban renewal project carried out by the State Executive Committee, the member shall not be present or take part in the mediation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_IV__cl_28__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_IV__cl_28__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_IV__cl_28__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_IV__cl_28",
      "schema:text": {
        "@language": "en",
        "@value": "Where a member of the State Urban Renewal Mediation Committee fails to disclose his interest in an urban renewal project—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_IV__cl_28__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_IV__cl_28__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the member shall be subject to cessation of membership as determined by the State Executive Committee; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_IV__cl_28__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_IV__cl_28__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the State Executive Committee may appoint another person to fill the vacancy and any person so appointed shall hold office for the remaining period."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_I__cl_1__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_I__cl_1__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Urban Renewal Act 2025."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall apply to Peninsular Malaysia and the Federal Territory of Labuan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_I__cl_1__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_I__cl_1__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_I__cl_1__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_I__cl_1__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette and the Minister may appoint different dates—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_I__cl_1__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_I__cl_1__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "for the coming into operation of this Act in different parts of Peninsular Malaysia and Federal Territory of Labuan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_I__cl_1__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_I__cl_1__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "for the coming into operation of different provisions of this Act; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_I__cl_1__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_I__cl_1__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "for the coming into operation of different provisions of this Act in different parts of Peninsular Malaysia and the Federal Territory of Labuan. Non-application of Act"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_I",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall not apply to the heritage site under the National Heritage Act 2005 [Act 645]. Construction of Act"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_I__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_I",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall be read together with the relevant written laws in relation to town and country planning, land, housing and local government. Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_I__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_I__cl_4__list_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_I__cl_4__list_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_I",
      "schema:name": {
        "@language": "en",
        "@value": "In this Act, unless the context otherwise requires—"
      },
      "schema:text": {
        "@language": "en",
        "@value": "“consent threshold” means a consent threshold by interested person to participate in an urban renewal project under section 19; “building” means any house, hut, shed or roofed enclosure, whether used for human habitation or otherwise, and any wall, fence, platform, staging, gate, post, pillar, paling, frame, hoarding, slip, dock, wharf, pier, jetty, landing-stage or bridge, or any structure support or foundation connected to the house, hut, shed or roofed enclosure; “prescribed” means prescribed by rules made under this Act; “incentive” means a benefit or reward given to any interested person by the Federal Government or the State Authority in the form of taxable or non-taxable revenue; “State Executive Committee” means the State Executive Committee established under section 10; “Federal Executive Committee’’ means the Federal Executive Committee established under section 5; “Professional Engineer with Practising Certificate” has the meaning assigned to it in the Registration of Engineers Act 1967 [Act 138]; “nuisance” has the meaning assigned to it in the Local Government Act 1976 [Act 171]; “urban renewal area” means an area or site identified for urban renewal in a development plan; “Minister” means the Minister charged with the responsibility of the control and supervision of urban renewal; “interested person” means a proprietor, developer, trustee, liquidator, legal representative, or administrator or executor if the proprietor is dead; “approved developer” means a qualifying developer approved by the Federal Executive Committee or the State Executive Committee to carry out an urban renewal project; “qualifying developer” means any person or body of persons who engages in or carries on the business of developing land or building, providing moneys for development of land or building, or purchasing land or building; “urban redevelopment” means a development made to change the physical condition of the existing sites which includes demolishing buildings, clearing of the sites, erecting buildings, and upgrading infrastructure and utility facilities; “proprietor” means any person or body registered as the proprietor of any building or alienated land; “Chairman of the State Executive Committee” means the Chairman of the State Executive Committee referred to in paragraph 10(2)(a); “Chairman of the Federal Executive Committee” means the Chairman of the Federal Executive Committee referred to in paragraph 5(2)(a); “urban regeneration” means a regeneration of an area or building including a building which is neglected, dilapidated or abandoned by repairing the existing building, upgrading the infrastructure or utility facilities, and landscaping; “urban revitalization” includes improving an area or building by upgrading, beautifying or landscaping, or changing the functions of the area or building; “State Authority” means—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_I__cl_4__list_1",
      "@type": "akn:list",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_I__cl_4__list_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_I__cl_4__list_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_I__cl_4"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_I__cl_4__list_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_I__cl_4__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "in relation to the States of Peninsular Malaysia, the Ruler-in-Council or Governor-in-Council of a State and includes in Negeri Sembilan, the Yang di-Pertuan Besar acting on behalf of himself and the Ruling Chiefs; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_I__cl_4__list_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_I__cl_4__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "in relation to the Federal Territories of Kuala Lumpur, Putrajaya and Labuan, the Minister charged with the responsibility for local government; “local authority” means—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_I__cl_4__list_2",
      "@type": "akn:list",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_I__cl_4__list_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_I__cl_4__list_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_I__cl_4__list_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_I__cl_4__list_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_I__cl_4"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_I__cl_4__list_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_I__cl_4__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "any local authority established under the Local Government Act 1976;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_I__cl_4__list_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_I__cl_4__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "in relation to the Federal Territory of Kuala Lumpur, the Commissioner of the City of Kuala Lumpur appointed under section 4 of the Federal Capital Act 1960 [Act 190];"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_I__cl_4__list_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_I__cl_4__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "in relation to the Federal Territory of Putrajaya, the Perbadanan Putrajaya established under the Perbadanan Putrajaya Act 1995 [Act 536]; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_I__cl_4__list_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_I__cl_4__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "in relation to the Federal Territory of Labuan, the Perbadanan Labuan established under the Perbadanan Labuan Act 2001 [Act 609]; “development plan” has the meaning assigned to it in the Town and Country Planning Act 1976 [Act 172] and the Federal Territory (Planning) Act 1982 [Act 267]; “land” has the meaning assigned to it in the National Land Code [Act 828]; “Secretary of the State Executive Committee” means the Secretary of the State Executive Committee referred to in section 15; “Secretary of the Federal Executive Committee” means the Secretary of the Federal Executive Committee referred to in section 9."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_V",
      "@type": "akn:part",
      "eli:number": "V",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_V__cl_29",
