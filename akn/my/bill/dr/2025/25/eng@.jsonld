      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_III",
      "@type": "akn:part",
      "eli:number": "III",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_III__cl_16",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_III__cl_17",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_III__cl_18",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_III__cl_19",
