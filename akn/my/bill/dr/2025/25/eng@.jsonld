      "schema:text": {
        "@language": "en",
        "@value": "GENERAL Power to make rules"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_V__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_V__cl_29__subsec_1",
