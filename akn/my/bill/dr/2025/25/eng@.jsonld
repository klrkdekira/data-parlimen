        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_V__cl_29__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_V__cl_29__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_V__cl_29",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may make rules for the purpose of carrying into effect the provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_V__cl_29__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
