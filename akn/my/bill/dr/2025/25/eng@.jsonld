      "schema:text": {
        "@language": "en",
        "@value": "to prescribe the fees payable under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/25/eng@/~part_V__cl_29__subsec_2__para_f",
