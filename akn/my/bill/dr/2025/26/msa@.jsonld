      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (3)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_9__para_d__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_9__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “penggunaan” dengan perkataan “membuat urusan dengan”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_9__para_d__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_9__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “, benda ditetapkan atau radas penyinaran” dengan perkataan “atau penjana sinaran”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_9__para_d__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_9__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “ahli radiologi, ahli radioterapi atau doktor pergigian berdaftar” dengan perkataan “pengamal pergigian berdaftar, pakar perubatan nuklear, pakar onkologi atau pakar radiologi”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_9__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (3) subseksyen yang berikut: “(4) Mana-mana orang yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, dipenjarakan selama tempoh tidak melebihi sepuluh tahun atau didenda tidak melebihi lima ratus ribu ringgit atau kedua-duanya.”. Seksyen baharu 12a"
      }
    },
