      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (b), dengan memasukkan selepas perkataan “menghalang,” perkataan “menyekat, mengganggu,”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_51__para_c",
