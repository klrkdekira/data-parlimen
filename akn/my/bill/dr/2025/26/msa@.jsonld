    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_14__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “Lembaga” di mana-mana jua terdapat dengan perkataan “Ketua Pengarah”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_14__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (4) subseksyen yang berikut: “(4a) Jika terdapat keraguan sama ada suatu aktiviti yang akan dilesenkan adalah untuk maksud perubatan atau suatu maksud selain maksud perubatan, perkara itu hendaklah dirujuk kepada Majlis Penasihat bagi maksud mengenal pasti sama ada aktiviti itu akan dilesenkan untuk maksud perubatan atau suatu maksud selain maksud perubatan di bawah Akta ini dan Ketua Pengarah hendaklah bertindak mengikut dapatan Majlis Penasihat itu.”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_14__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
