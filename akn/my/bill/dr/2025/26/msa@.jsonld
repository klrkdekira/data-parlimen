        "@language": "ms",
        "@value": "Seksyen 31 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_36__para_a",
