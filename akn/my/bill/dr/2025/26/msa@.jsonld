        "@value": "dengan memasukkan selepas perkataan “lesen” di mana-mana jua terdapat perkataan “atau permit”. Pindaan seksyen 25"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_25__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_25__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_25__para_c",
