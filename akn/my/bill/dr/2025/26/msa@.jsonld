      "schema:text": {
        "@language": "ms",
        "@value": "dalam nota birai, dengan menggantikan perkataan “tiap-tiap jualan bahan radioaktif, dll” dengan perkataan “jualan”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_21__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (1) dengan subseksyen yang berikut: “(1) Tiap-tiap pemegang lesen yang menjual bahan radioaktif, bahan nuklear atau penjana sinaran hendaklah mengemukakan suatu penyata penjualan dalam bentuk yang ditetapkan.”;"
      }
    },
    {
