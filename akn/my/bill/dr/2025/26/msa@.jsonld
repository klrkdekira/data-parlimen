      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (h), dengan memotong perkataan “atau” di hujung perenggan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_51__para_e",
      "@type": "akn:paragraph",
