      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “, bahan-bahan nuklear atau benda-benda ditetapkan” dengan perkataan “atau bahan nuklear”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_16__para_b",
