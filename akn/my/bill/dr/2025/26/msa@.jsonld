      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (f), dengan menggantikan perkataan “bahan ditetapkan, radas penyinaran” dengan perkataan “penjana sinaran”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_51__para_d",
