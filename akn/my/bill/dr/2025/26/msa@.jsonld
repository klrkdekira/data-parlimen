        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_6__list_1__para_t"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_6"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_6__list_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_6__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam teks bahasa kebangsaan, dengan memotong takrif “ahli radiologi”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_6__list_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_6__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong takrif “ahli radioterapi”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_6__list_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_6__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan sebelum takrif “Akta ini” takrif yang berikut: ‘ “Agensi” ertinya Agensi Tenaga Atom Antarabangsa;’;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_6__list_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_6__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam takrif “bahan api nuklear”, dengan menggantikan perkataan “sebagaimana ditetapkan oleh Lembaga dari semasa ke semasa melalui perintah dalam Warta” dengan perkataan “sebagaimana yang ditetapkan”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_6__list_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_6__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif “bahan api nuklear” takrif yang berikut: ‘ “bahan api terpakai” ertinya bahan api nuklear yang telah disinar dalam dan dikeluarkan daripada reaktor apabila bahan api nuklear itu tidak lagi digunakan sebagai bahan api nuklear;’;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_6__list_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_6__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan takrif “bahan nuklear” dengan takrif yang berikut: ‘ “bahan nuklear” ertinya bahan sebagaimana yang dinyatakan dalam Jadual;’;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_6__list_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_6__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan takrif “bahan radioaktif” dengan takrif yang berikut: ‘ “bahan radioaktif” ertinya apa-apa bahan api nuklear, hasil radioaktif, sisa radioaktif atau apa-apa radionuklid sebagaimana yang ditetapkan;’;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_6__list_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_6__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif baharu “bahan radioaktif” takrif yang berikut: ‘ “barang berkaitan nuklear” ertinya apa-apa barang yang berhubungan dengan penggunaan dan pembangunan teknologi nuklear sebagaimana yang ditetapkan;’;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_6__list_1__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_6__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan takrif “doktor pergigian berdaftar”, “pengamal perubatan berdaftar”, “ahli farmasi berdaftar” dan “doktor veterinar berdaftar” dengan takrif yang berikut: ‘ “doktor veterinar berdaftar”, “pengamal pergigian berdaftar” dan “pengamal perubatan berdaftar” masing-masing ertinya seorang doktor veterinar, pengamal pergigian dan pengamal perubatan, setiapnya yang didaftarkan sebagaimana mengikut peruntukan undang-undang bertulis yang berhubungan dengan pendaftaran orang itu;’;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_6__list_1__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_6__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif “insiden nuklear” takrif yang berikut: ‘ “kemudahan”, berhubung dengan apa-apa bahan radioaktif, bahan nuklear atau penjana sinaran termasuklah— (a) pepasangan nuklear; (b) pepasangan penyinaran; (c) kemudahan yang bahan radioaktif diproses; (d) kemudahan pengurusan sisa radioaktif; (e) kemudahan pengurusan bahan api terpakai; atau (f) kemudahan pelupusan sisa radioaktif;’;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_6__list_1__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_6__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam teks bahasa kebangsaan, dengan memotong takrif “kenderaan”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_6__list_1__para_l",
      "@type": "akn:paragraph",
      "eli:number": "l",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_6__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif “kerosakan nuklear” takrif yang berikut: ‘ “Ketua Pengarah” ertinya Ketua Pengarah Jabatan Tenaga Atom;’;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_6__list_1__para_m",
      "@type": "akn:paragraph",
      "eli:number": "m",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_6__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong takrif “Lembaga”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_6__list_1__para_n",
      "@type": "akn:paragraph",
      "eli:number": "n",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_6__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif baharu “Ketua Pengarah” takrif yang berikut: ‘ “Majlis Penasihat” ertinya Majlis Penasihat Tenaga Atom yang ditubuhkan di bawah seksyen 2a;’;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_6__list_1__para_o",
      "@type": "akn:paragraph",
      "eli:number": "o",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_6__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif baharu “Majlis Penasihat” takrif yang berikut: ‘ “Menteri” ertinya Menteri yang dipertanggungkan dengan tanggungjawab bagi sains dan teknologi;’;"
      }
    },
    {
