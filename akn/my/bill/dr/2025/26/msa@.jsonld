      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 39 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_51__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_51",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (a), dengan menggantikan perkataan “pepasangan nuklear” dengan perkataan “kemudahan”;"
      }
    },
    {
