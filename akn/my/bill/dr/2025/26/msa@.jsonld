      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan sebelum perkataan “hendaklah” perkataan “atau pegawai polis yang berpangkat tidak rendah daripada Inspektor”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/26/msa@/~cl_43__para_a__subpara_ii",
