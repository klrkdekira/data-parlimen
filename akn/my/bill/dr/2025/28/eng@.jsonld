        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_93__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_93__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_93__subsec_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_93__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_93",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who is registered, for the purpose of Government procument, as a supplier of goods or services or contractor for works with the Ministry of Finance or any authority authorized by the Ministry of Finance immediately before the coming into operation of this Act shall be deemed to be registered under this Act until the expiry of that registration, except in the case of a society registered under the Societies Act 1966 where the registration is deemed to be revoked six months after the coming into operation of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_93__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_93",
      "schema:text": {
        "@language": "en",
        "@value": "Any application for a registration, renewal of a registration, amendment of a registration or an exemption in relation to any supplier of goods or services or contractor for works for the purpose of Government procurement pending on the date of the coming into operation of this Act shall be dealt with under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_93__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_93",
      "schema:text": {
        "@language": "en",
        "@value": "Any complaint or objection made in relation to a registration, renewal or amendment of registration pending on the date of the coming into operation of this Act shall be dealt with under the relevant instructions and circulars issued by the Treasury under the Financial Procedure Act 1957 prior to the coming into operation of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_93__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_93",
      "schema:text": {
        "@language": "en",
        "@value": "Any complaint or objection made against any procuring entity in relation to any Government procurement pending on the date of the coming into operation of this Act shall be dealt with under the relevant instructions and circulars issued by the Treasury under the Financial Procedure Act 1957 prior to the coming into operation of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_93__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_93",
      "schema:text": {
        "@language": "en",
        "@value": "Any application made to the Ministry of Finance or any procuring entity to review any procedure in relation to any Government procurement pending on the date of the coming into operation of this Act shall be dealt with in accordance with the relevant instructions and circulars issued by the Treasury under the Financial Procedure Act 1957 prior to the coming into operation of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_93__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_93",
      "schema:text": {
        "@language": "en",
        "@value": "Any appeal made to the Ministry of Finance in relation to any decision on Government procurement pending on the date of the coming into operation of this Act shall be dealt with in accordance with the relevant instructions and circulars issued by the Treasury under the Financial Procedure Act 1957 prior to the coming into operation of this Act"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_93__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_93",
      "schema:text": {
        "@language": "en",
        "@value": "Any Government procurement commenced by any procuring entity before the date of the coming into operation of this Act shall be dealt with in accordance with the relevant instructions and circulars issued by the Treasury under the Financial Procedure Act 1957 prior to the coming into operation of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_93__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_93",
      "schema:text": {
        "@language": "en",
        "@value": "Any exemptions given by the Treasury pursuant to any instructions or circulars issued by the Treasury under the Financial Procedure Act 1957 on matters relating to Government procurement prior to the date of coming into operation of this Act shall, on the date of coming into operation of this Act, be deemed to be revoked."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_82",
      "@type": "akn:clause",
      "eli:number": "82",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_82__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_82__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_82__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_82__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_82__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_82",
      "schema:text": {
        "@language": "en",
        "@value": "No person shall, in his participation in a Government procurement or any requirements under this Act, submit to a procuring entity, Registrar or to the Treasury—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_82__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_82__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any forged, altered or counterfeited document; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_82__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_82__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any information for which that is false or misleading, or contains a material omission."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_82__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_82",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes this section commits an offence. Liability of director, etc., of body corporate, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_83",
      "@type": "akn:clause",
      "eli:number": "83",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_83__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_83__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI",
      "schema:text": {
        "@language": "en",
        "@value": "Where any person who commits an offence under this Act is a body corporate, firm, co-operative society or other body of persons, any person who at the time of the commission of the offence was a director or other similar officer of the body corporate, firm, co-operative society or other body of persons or was purporting to act in the capacity or was in any manner or to any extent responsible for the management of any of the affairs of the body corporate, firm, co-operative society or other body of persons or was assisting in its management—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_83__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_83",
      "schema:text": {
        "@language": "en",
        "@value": "may be charged severally or jointly in the same proceedings with the body corporate, firm, co-operative society or other body of persons; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_83__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_83__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_83__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_83",
      "schema:text": {
        "@language": "en",
        "@value": "if the body corporate, firm, co-operative society or other body of persons is found guilty of the offence, shall be deemed to be guilty of the offence and shall be liable to the same punishment or penalty as an individual unless, having regard to the nature of his functions in that capacity and to all circumstances, he proves—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_83__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_83__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "that the offence was committed without his knowledge; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_83__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_83__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "that the offence was committed without his consent or connivance and that he had taken all reasonable precautions and exercised due diligence to prevent the commission of the offence. Liability of person for act, etc., of employee, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_84",
      "@type": "akn:clause",
      "eli:number": "84",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_84__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_84__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_84__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI",
      "schema:text": {
        "@language": "en",
        "@value": "Where any person would be liable to any punishment or penalty under this Act for any act, omission, neglect or default committed—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_84__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_84",
      "schema:text": {
        "@language": "en",
        "@value": "by that person’s employee in the course of his employment;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_84__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_84",
      "schema:text": {
        "@language": "en",
        "@value": "by that person’s agent when acting on behalf of that person; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_84__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_84",
      "schema:text": {
        "@language": "en",
        "@value": "by the employee of that person’s agent when acting in the course of his employment with that person’s agent or otherwise on behalf of that person’s agent acting on behalf of that person, that person shall be liable to the same punishment or penalty for every such act, omission, neglect or default of that person’s employee or agent, or of the employee of that person’s agent. Power to impose administrative penalty"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_85",
      "@type": "akn:clause",
      "eli:number": "85",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_85__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_85__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_85__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_85__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_85__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_85__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_85",
      "schema:text": {
        "@language": "en",
        "@value": "The Secretary General to the Treasury, Registrar or State financial authority, as the case may be, may impose administrative penalty on any person for any non-compliance with any instructions, circulars or guidelines issued under this Act or any contravention of any regulations made under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_85__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_85",
      "schema:text": {
        "@language": "en",
        "@value": "The Secretary General to the Treasury, Registrar or State financial authority, as the case may be, shall, before making a decision to impose an administrative penalty on any person, serve on him a written notice calling on him to show cause, within fourteen days from the date of the written notice, why the administrative penalty should not be imposed on him."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_85__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_85__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_85__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_85",
      "schema:text": {
        "@language": "en",
        "@value": "If the Secretary General to the Treasury, Registrar or State financial authority, as the case may be, is not satisfied with the explanation given in response to the written notice served under subsection (2) or if the written notice was not responded within fourteen days, the Secretary General to the Treasury, Registrar or State financial authority, as the case may be, may impose an administrative penalty—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_85__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_85__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "in an amount not exceeding twenty-five thousand ringgit; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_85__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_85__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "in an amount not exceeding five hundred ringgit for each day of non-compliance and such amount shall not in total exceed the sum of fifty thousand ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_85__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_85",
      "schema:text": {
        "@language": "en",
        "@value": "All sums of money received by the Secretary General to the Treasury, Registrar or State financial authority under this section shall be paid into and form part of the Federal Consolidated Fund."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_85__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_85",
      "schema:text": {
        "@language": "en",
        "@value": "Any amount due under this section shall be recoverable as a civil debt to the Government. Prosecution"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_86",
      "@type": "akn:clause",
      "eli:number": "86",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI",
      "schema:text": {
        "@language": "en",
        "@value": "No prosecution for an offence under this Act shall be instituted except by or with the written consent of the Public Prosecutor. Compounding of offences"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_87",
      "@type": "akn:clause",
      "eli:number": "87",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_87__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_87__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_87__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_87__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_87__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_87__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_87__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_87",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, with the approval of the Public Prosecutor, make regulations prescribing—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_87__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_87__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any offence under this Act as an offence which may be compounded; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_87__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_87__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the method and procedure for compounding such offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_87__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_87",
      "schema:text": {
        "@language": "en",
        "@value": "The Secretary General to the Treasury may, with the consent in writing of the Public Prosecutor, at any time before a prosecution is being instituted, compound any offence prescribed as an offence which may be compounded by making a written offer to the person reasonably suspected of having committed the offence to compound the offence upon payment to the Treasury of a sum of money not exceeding fifty per centum of the amount of the maximum fine to which the person would have been liable to if he had been convicted of the offence, within such time as may be specified in the written offer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_87__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_87",
      "schema:text": {
        "@language": "en",
        "@value": "An offer under subsection (2) may be made at any time after the offence has been committed but before any prosecution for it has been instituted, and where the amount specified in the offer is not paid within the time specified in the offer, or such extended time as the Secretary General to the Treasury may grant, prosecution for the offence may be instituted at any time after that against the person to whom the offer was made."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_87__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_87",
      "schema:text": {
        "@language": "en",
        "@value": "Where an offence has been compounded under subsection (2), no prosecution shall be instituted in respect of the offence against the person to whom the offer to compound was made, and any record, book, account, document, computerized data or other thing or any matter or thing that is the subject matter of Government procument being investigated seized in connection with the offence may be forfeited or released by the Secretary General to the Treasury, subject to such terms as the Secretary General to the Treasury thinks fit. General penalty"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_88",
      "@type": "akn:clause",
      "eli:number": "88",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_88__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_88__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes any requirement or provision of this Act, commits an offence under this Act and, where no penalty is expressly provided, shall, on conviction, be liable—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_88__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_88",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of an individual, to a fine not exceeding one hundred thousand ringgit or to imprisonment for a term not exceeding three years or to both; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_88__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XI__cl_88",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of a company, partnership, co-operative society or professional body, to a fine not exceeding five hundred thousand ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63",
      "@type": "akn:clause",
      "eli:number": "63",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63",
      "schema:text": {
        "@language": "en",
        "@value": "There shall be established a Government Procurement Appeal Tribunal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister shall, by order published in the Gazette, appoint the members of the Appeal Tribunal as follows:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "a Chairman and not more than two Deputies Chairman who shall be appointed from among members of the Judicial and Legal Service with not less than ten years of experience; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_2__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_2__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_2__para_b__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_2__para_b__subpara_iv",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_2__para_b__subpara_v"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "not less than five members from among persons who have integrity and impeccable reputation with proven experience and recognized knowledge in—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "law;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "finance or procurement;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_2__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "engineering;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_2__para_b__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "economic or commerce; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_2__para_b__subpara_v",
      "@type": "akn:subparagraph",
      "eli:number": "v",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_2__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "public administration."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_3__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_3__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_3__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to subsection (2), for the purpose of paragraph (b), no person shall be appointed as a member of the Appeal Tribunal if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "he has been convicted of an offence, under any law, by a court in Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "he is one of the persons in the finding of an infringement of a prohibition that has been determined by the Competition Commission under the Competition Act 2010;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "he becomes bankrupt or insolvent;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "other than the public officers of the Judicial and Legal Service appointed under paragraph 63(2)(a), he is a public officer or a member of the administration;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_3__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "he is a member of the Senate or the House of Representatives or any Legislative Assembly; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_3__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "he is a registered person or has interest in any registered person;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63",
      "schema:text": {
        "@language": "en",
        "@value": "A member of the Appeal Tribunal shall hold office for a term not exceeding three years and shall be eligible for reappointment upon the expiry of his term of office, but shall not be appointed for more than two consecutive terms."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this section—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "“interest” includes any direct or indirect interest by himself, through a member of his family or his associate, and any of his beneficial ownership;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_63__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "“a member of his family” and “associate” have the same meaning as in paragraphs 37(6)(a) and 37(6)(b) respectively. Resignation and revocation of appointment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_64",
      "@type": "akn:clause",
      "eli:number": "64",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_64__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_64__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_64__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_64",
      "schema:text": {
        "@language": "en",
        "@value": "The Chairman or any other member of the Appeal Tribunal may at any time resign from his office by giving a notice in writing to the Minister."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_64__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_64__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_64__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_64__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_64__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_64__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_64__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_64__subsec_2__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_64__subsec_2__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_64__subsec_2__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_64__subsec_2__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_64__subsec_2__para_k"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_64",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may at any time revoke the appointment of any member of the Appeal Tribunal by order published in the Gazette if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_64__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_64__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "he resigns his office;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_64__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_64__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "he has been convicted of an offence, under any written law, by a court in Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_64__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_64__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "he is one of the persons in the finding of an infringement of a prohibition that has been determined by the Competition Commission under the Competition Act 2010;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_64__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_64__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "his conduct, whether in connection with his duties as a member of the Appeal Tribunal or otherwise, has been such as to bring discredit on the Appeal Tribunal;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_64__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_64__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "he becomes bankrupt or insolvent;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_64__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_64__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "he is of unsound mind or otherwise incapable of discharging his duties;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_64__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_64__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "he becomes a member of the Senate or the House of Representatives or any Legislative Assembly;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_64__subsec_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_64__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of an appointment under paragraph 63(2)(b), he becomes a public officer or a member of the administration;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_64__subsec_2__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_64__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "he is guilty of serious misconduct in relation to his duties;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_64__subsec_2__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_64__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "his performance has been unsatisfactory for a significant period of time; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_64__subsec_2__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_64__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "he fails to carry out his obligations under section 73; Vacation of office"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_65",
      "@type": "akn:clause",
      "eli:number": "65",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_65__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_65__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_65__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_65__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_65__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_65__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_65__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_65__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_65",
      "schema:text": {
        "@language": "en",
        "@value": "The office of a member of the Appeal Tribunal shall be vacated if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_65__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_65__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "he dies;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_65__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_65__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "he resigns or otherwise vacates his office before the expiry of the term for which he is appointed; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_65__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_65__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "his appointment is revoked under subsection 64(2)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_65__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_65",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister shall appoint a person in accordance with section 63 to replace the Chairman or any other member of the Appeal Tribunal during the vacancy in the office of the Chairman or any other member of the Appeal Tribunal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_65__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_65__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_65__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_65__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_65",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may appoint temporarily a person from among the members of the Appeal Tribunal in accordance with section 63 to act as the Chairman or any other member of the Appeal Tribunal during any period when—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_65__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_65__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the office of the Chairman or any other member is vacant;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_65__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_65__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the Chairman or any other member is absent from duty or from Malaysia; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_65__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_65__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the Chairman or any other member is, for any other reason, unable to perform his duties."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_65__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_65",
      "schema:text": {
        "@language": "en",
        "@value": "The exercise of the powers or the performance of the functions of the Appeal Tribunal is not affected only because of there being a vacancy in the membership of the Appeal Tribunal. Composition and quorum"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_66",
      "@type": "akn:clause",
      "eli:number": "66",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_66__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_66__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_66__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_66",
      "schema:text": {
        "@language": "en",
        "@value": "Every proceeding of the Appeal Tribunal shall be heard and disposed of by three members or such greater uneven number of members of the Appeal Tribunal as the Chairman may in any particular case determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_66__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_66",
      "schema:text": {
        "@language": "en",
        "@value": "In determining the quorum under subsection (1), the Chairman shall take into consideration the subject matter of the appeal and the relevant expertise of the members. Jurisdiction"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_67",
      "@type": "akn:clause",
      "eli:number": "67",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_67__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_67__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_67__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_67",
      "schema:text": {
        "@language": "en",
        "@value": "The Appeal Tribunal shall have jurisdiction to determine any appeal on matters relating to the decisions and process of the decisions of a review panel."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_67__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_67__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_67__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_67__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_67__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_67__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_67__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_67__subsec_2__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_67",
      "schema:text": {
        "@language": "en",
        "@value": "The Appeal Tribunal has no jurisdiction on matters—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_67__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_67__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "relating to the contravention of this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_67__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_67__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "relating to the investigation and enforcement under Part VIII;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_67__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_67__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "relating to any decision made in relation to a dispute resolution for a Government procurement contract under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_67__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_67__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "arising after the issuance of a letter of acceptance by a procuring entity to a registered person and such a letter of acceptance has been signed by parties;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_67__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_67__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "relating to any trade secret or intellectual property rights;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_67__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_67__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "where a tribunal has been established by any written law to hear and determine a claim; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_67__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_67__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "relating to any complaint or objection that has not been decided by a review panel. Appeals to Appeal Tribunal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_68",
      "@type": "akn:clause",
      "eli:number": "68",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_68__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_68__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_68__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_68__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_68",
      "schema:text": {
        "@language": "en",
        "@value": "A person who is aggrieved or whose interest is affected by a decision of a review panel under section 61 may appeal to the Appeal Tribunal by filing a notice of appeal to the Appeal Tribunal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_68__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_68",
      "schema:text": {
        "@language": "en",
        "@value": "The notice of appeal shall be made in writing within fourteen days from the date of the decision of the review panel and the appellant shall give a copy of the notice to the relevant review panel."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_68__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_68",
      "schema:text": {
        "@language": "en",
        "@value": "The notice of appeal shall summarily state the substance of the decision of the review panel appealed against, contain an address at which any notices or documents connected with the appeal may be served upon the appellant or upon his advocate, and be signed by the appellant or his advocate. Suspension order against Government procurement"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_69",
      "@type": "akn:clause",
      "eli:number": "69",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_69__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_69__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_69__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_69__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_69__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_69__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_69__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_69__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_69__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_69__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_69",
      "schema:text": {
        "@language": "en",
        "@value": "The appellant may, at any time after he has lodged a notice of appeal with the Secretary of the Appeal Tribunal, paid any fee and deposit as prescribed and served the notice of appeal to the relevant review panel, make an application to the Appeal Tribunal for an order to suspend—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_69__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_69__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the procedures leading to the award of the Government procurement contract which is the subject matter of the appeal; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_69__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_69__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the implementation of any decision made while undertaking the procedures mentioned in paragraph (a)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_69__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_69",
      "schema:text": {
        "@language": "en",
        "@value": "The application under subsection (1) shall be made within seven days from the filing of the notice of appeal and supported with an affidavit stating reasonable grounds for such order."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_69__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_69",
      "schema:text": {
        "@language": "en",
        "@value": "The appellant shall provide a copy of the application under subsection (1) together with supporting affidavit to the procuring entity without unnecessary delay."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_69__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_69",
      "schema:text": {
        "@language": "en",
        "@value": "The procuring entity may file an affidavit to the Appeal Tribunal stating the reasons for not making an order to suspend the Government procurement, including public interest reasons supported by a Procurement Public Interest Certificate issued under section 32."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_69__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_69",
      "schema:text": {
        "@language": "en",
        "@value": "The Appeal Tribunal, upon considering the affidavits of the appellant and the procuring entity, may decline the request by the appellant or make an order to suspend the Government procurement, either unconditionally or upon such terms and conditions as may be determined by the Appeal Tribunal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_69__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_69__subsec_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_69__subsec_6__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_69",
      "schema:text": {
        "@language": "en",
        "@value": "The Appeal Tribunal must not make an order under this section if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_69__subsec_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_69__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "such suspension is against the public interest; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_69__subsec_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_69__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "the contract mentioned in paragraph (1)(a) has already been awarded at the date of hearing of the application for the order."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_69__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_69",
      "schema:text": {
        "@language": "en",
        "@value": "Where the Appeal Tribunal refuses to make an order under this section, the Appeal Tribunal shall give the reasons for its refusal in writing. Exclusion of jurisdiction of court"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_70",
      "@type": "akn:clause",
      "eli:number": "70",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_70__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_70__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_70__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_70__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_70__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_70",
      "schema:text": {
        "@language": "en",
        "@value": "Where an appeal is lodged with the Appeal Tribunal and the appeal is within its jurisdiction, the issues in dispute in such appeal, whether as shown in the initial appeal or as emerging in the course of the hearing, shall not be the subject of proceedings between the same parties in any court unless—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_70__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_70__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the proceedings before the court were commenced before the appeal was lodged with the Appeal Tribunal; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_70__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_70__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the appeal before the Appeal Tribunal is withdrawn, abandoned or struck out."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_70__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_70",
      "schema:text": {
        "@language": "en",
        "@value": "Where paragraph (1)(a) applies, the issues in dispute in the claim to which those proceedings relate, whether as shown in the initial claim or emerging in the course of the hearing, shall not be the subject of proceedings between the same parties before the Tribunal unless the claim before the court is withdrawn, abandoned or struck out. Powers of Appeal Tribunal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_71",
      "@type": "akn:clause",
      "eli:number": "71",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_71__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_71__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_71__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_71__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_71__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_71__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_71__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_71__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_71__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_71__subsec_1__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_71__subsec_1__para_h"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_71",
      "schema:text": {
        "@language": "en",
        "@value": "The Appeal Tribunal shall have the following powers:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_71__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_71__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to summon parties to the proceedings or any other person to attend before it to give evidence in respect of an appeal;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_71__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_71__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to procure and receive evidence on oath or affirmation, whether written or oral, and examine all such persons as witnesses as the Appeal Tribunal considers necessary to procure, receive or examine;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_71__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_71__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "where a person is so summoned, to require the production of any record, book, account, document, computerized data or other thing in his possession or under his control which the Tribunal considers necessary for the purposes of the appeal;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_71__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_71__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to administer any oath, affirmation or statutory declaration, as the case may require;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_71__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_71__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "where a person is so summoned, to allow the payment for any reasonable expenses incurred in connection with his attendance;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_71__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_71__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to admit evidence or reject evidence adduced, whether written or oral, and whether admissible or inadmissible under the provisions of any written law for the time being in force relating to the admissibility of evidence;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_71__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_71__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to receive evidence from experts; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_71__subsec_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_71__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to generally direct and do all such things as may be necessary or expedient for the expeditious decision of the appeal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_71__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_71",
      "schema:text": {
        "@language": "en",
        "@value": "The Appeal Tribunal shall have the powers of a subordinate court under the Subordinate Courts Act 1948 [Act 92] with regard to the enforcement of attendance of witnesses, hearing evidence on oath or affirmation and punishment for contempt. Procedures of Appeal Tribunal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_72",
      "@type": "akn:clause",
      "eli:number": "72",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to this Act, the Appeal Tribunal may adopt such procedure as it thinks fit and proper. Disclosure of interest by Chairman and members of Appeal Tribunal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_73",
      "@type": "akn:clause",
      "eli:number": "73",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_73__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_73__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_73__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_73__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_73__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_73",
      "schema:text": {
        "@language": "en",
        "@value": "The Chairman, or any member of the Appeal Tribunal shall disclose, as soon as practicable, in the case of the Chairman, to the Minister any interest, and in the case of any member, to the Chairman any interest, whether substantial or not, which may conflict with the Chairman’s or member’s duties, as a member of the Appeal Tribunal in a particular matter."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_73__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_73__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_73__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_73",
      "schema:text": {
        "@language": "en",
        "@value": "In the case of a member of the Appeal Tribunal, if the Chairman is of the opinion that the member’s interest is in conflict with the member’s duties, the Chairman shall inform all the parties to the matter of the conflict, and—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_73__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_73__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "if none of the parties to the matter objects to the conflict, the member may continue to execute his duties as a member of the Appeal Tribunal in relation to that matter; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_73__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_73__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "if a party to the matter objects to the conflict, the member of the Appeal Tribunal shall not continue to execute his duties as a member of the Appeal Tribunal in relation to that matter."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_73__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_73",
      "schema:text": {
        "@language": "en",
        "@value": "In the case of the Chairman of the Appeal Tribunal, the Minister shall consider the matter and if the Minister is of the opinion that there is a conflict of interest with his duties as the Chairman of the Appeal Tribunal, the Minister may appoint any of the Deputies Chairman as a replacement Chairman in accordance with section 63."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_73__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_73__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_73__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_73",
      "schema:text": {
        "@language": "en",
        "@value": "The failure by the Chairman or any member of the Appeal Tribunal to disclose his interest under subsection (1) shall—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_73__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_73__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "invalidate the decision of the Appeal Tribunal, unless all parties agree to be bound by the decision; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_73__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_73__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "subject the Chairman or member of the Appeal Tribunal to the revocation of his appointment under subsection 64(2). Secretary of Appeal Tribunal and other officers"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_74",
      "@type": "akn:clause",
      "eli:number": "74",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_74__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_74__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_74__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_74__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_74__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_74__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_74",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister shall appoint—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_74__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_74__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a senior public officer as Secretary of the Appeal Tribunal to assist the Appeal Tribunal in carrying out its functions under this Act; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_74__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_74__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "such number of public officers as the Minister thinks fit to assist the Secretary in carrying out his function under paragraph (a)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_74__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_74",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this section, the Secretary and any public officer appointed under subsection (1) shall be deemed to be officers of the Appeal Tribunal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_74__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_74",
      "schema:text": {
        "@language": "en",
        "@value": "The Secretary of the Appeal Tribunal shall be responsible for the administration and management of the Appeal Tribunal in accordance with this Act. Obligation of secrecy"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_75",
      "@type": "akn:clause",
      "eli:number": "75",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_75__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_75__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_75__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_75__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_75__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_75",
      "schema:text": {
        "@language": "en",
        "@value": "Except for this Part or for the purposes of any civil or criminal proceedings under any written law, or where authorized by the Minister—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_75__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_75__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Chairman, every other member, the Secretary or any other officer of the Appeal Tribunal shall not, during the time he serves as Chairman, member or officer, disclose any information obtained by him in the course of his duties; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_75__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_75__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "no other person who has, by any means, access to any information or document relating to the affairs of the Appeal Tribunal shall disclose such information or document."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_75__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_75",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) commits an offence. Public servants and public officers"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_76",
      "@type": "akn:clause",
      "eli:number": "76",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X",
      "schema:text": {
        "@language": "en",
        "@value": "The Chairman, every other member, the Secretary and any other officer of the Appeal Tribunal, while discharging their respective duties shall be deemed to be public servants within the meaning of the Penal Code [Act 574], and to be public officers for the purposes of the Criminal Procedure Code [Act 593]. Application of Public Authorities Protection Act 1948"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_77",
      "@type": "akn:clause",
      "eli:number": "77",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X",
      "schema:text": {
        "@language": "en",
        "@value": "The Public Authorities Protection Act 1948 [Act 198] shall apply to any action, suit, prosecution or proceedings against the Appeal Tribunal, the Chairman of the Appeal Tribunal, every other member of the Appeal Tribunal and the Secretary of the Appeal Tribunal or any other officer of the Appeal Tribunal in respect of any act, neglect or default done or committed by him in such capacity. Act or omission done in good faith"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_78",
      "@type": "akn:clause",
      "eli:number": "78",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_78__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_78__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_78__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_78__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X",
      "schema:name": {
        "@language": "en",
        "@value": "No action or suit shall be instituted or maintained in any court against—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_78__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_78",
      "schema:text": {
        "@language": "en",
        "@value": "the Appeal Tribunal;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_78__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_78",
      "schema:text": {
        "@language": "en",
        "@value": "the Chairman or any member of the Appeal Tribunal;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_78__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_78",
      "schema:text": {
        "@language": "en",
        "@value": "the Secretary or any other officer of the Appeal Tribunal; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_78__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_78",
      "schema:text": {
        "@language": "en",
        "@value": "a person authorized to act for and on behalf of the Appeal Tribunal, for any act or omission done in good faith in the performance of its or his functions and the exercise of its or his powers under this Act. Proceedings to be public"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_79",
      "@type": "akn:clause",
      "eli:number": "79",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_79__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_79__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_79__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_79",
      "schema:text": {
        "@language": "en",
        "@value": "All proceedings before the Appeal Tribunal shall be open to the public."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_79__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_79",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (1), the Chairman may, on an application by a respondent to an appeal, make an order for any or all part of the proceeding to be held in a closed session if the Chairman is satisfied that it is against the public interest for any matter under the appeal to be heard in an open proceeding. Decisions by Appeal Tribunal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_80",
      "@type": "akn:clause",
      "eli:number": "80",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_80__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_80__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_80__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_80__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_80__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_80__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_80__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_80__subsec_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_80__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_80",
      "schema:text": {
        "@language": "en",
        "@value": "The Appeal Tribunal shall make its decision without delay and where practicable, within thirty days from the first day of the hearing before the Appeal Tribunal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_80__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_80",
      "schema:text": {
        "@language": "en",
        "@value": "The decision of the Appeal Tribunal on any matter shall be decided on a majority of members of the Appeal Tribunal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_80__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_80__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_80__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_80__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_80",
      "schema:text": {
        "@language": "en",
        "@value": "The Appeal Tribunal shall have the power—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_80__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_80__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "to affirm the decision of the review panel;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_80__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_80__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "to vary the decision of the review panel; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_80__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_80__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "to set aside the decision of the review panel and make a new decision."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_80__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_80",
      "schema:text": {
        "@language": "en",
        "@value": "The Appeal Tribunal shall give reason for its decision in any appeal heard before it."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_80__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_80__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_80__subsec_5__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_80__subsec_5__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_80",
      "schema:text": {
        "@language": "en",
        "@value": "If the Appeal Tribunal makes a decision under paragraph (3)(c), the Appeal Tribunal may make the following orders:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_80__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_80__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "in the case where the Government procurement was suspended in accordance with section 69, order any decision or action taken by the procuring entity concerned in relation to the procurement which is the subject of the challenge to be set aside and order the procuring entity to take one or more decision or action, in accordance with the relevant provisions of this Act, in place of that which has been set aside;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_80__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_80__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "in the case where the Government procurement was not suspended and a letter of acceptance has not been signed by parties, order the procuring entity to remedy the situation and place the appellant or the Government procurement process or both to the position prior to the subject matter being submitted to the Appeal Tribunal; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_80__subsec_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_80__subsec_5",
      "schema:text": {
        "@language": "en",
        "@value": "in the case where the Government procurement was not suspended and a letter of acceptance has been signed by parties, order the procuring entity to pay to the appellant the costs of participation in the qualification of suppliers and contractors, or the costs of tender preparation, reasonably incurred by the appellant for the purposes of the Government procurement."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_80__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_80",
      "schema:text": {
        "@language": "en",
        "@value": "The Appeal Tribunal may, in addition to an order made under paragraph (5)(a) or (5)(b), order the procuring entity to pay to the appellant the costs of participation in the qualification of suppliers and contractors, or the costs of tender preparation, reasonably incurred by the appellant for the purposes of the Government procurement."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_80__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_80",
      "schema:text": {
        "@language": "en",
        "@value": "A decision of the Appeal Tribunal shall be final and binding on the parties to the appeal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_80__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_80",
      "schema:text": {
        "@language": "en",
        "@value": "The decision of the Appeal Tribunal shall be in writing and published in the form and manner as prescribed. Enforcement of decision of Appeal Tribunal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X__cl_81",
      "@type": "akn:clause",
      "eli:number": "81",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_X",
      "schema:text": {
        "@language": "en",
        "@value": "A decision given by the Appeal Tribunal may, by leave of the High Court, be enforced in the same manner as a judgment or an order of the High Court."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~sched_1__para_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~sched_1__para_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~sched_1__para_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~sched_1__para_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "[Section 10] APPROVAL THRESHOLD No. Approving Procurement for goods authority and services"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~sched_1__para_1",
