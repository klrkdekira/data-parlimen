      "schema:text": {
        "@language": "en",
        "@value": "every person named in a registration;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_5__subsec_1__list_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_5__subsec_1__list_5",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of a company, the directors, shareholders and senior management of the company;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_5__subsec_1__list_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_5__subsec_1__list_5",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of a partnership, all the partners in the partnership; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_5__subsec_1__list_5__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_5__subsec_1__list_5",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of a co-operative society, any person holding key responsibility in the management of the co-operative society; “authorized officer” means any public officer authorized in writing under subsection 45(1); “controlling officer” means—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_5__subsec_1__list_6",
      "@type": "akn:list",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_5__subsec_1__list_6__para_a",
