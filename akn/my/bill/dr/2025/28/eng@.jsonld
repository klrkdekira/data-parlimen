      "schema:text": {
        "@language": "en",
        "@value": "GENERAL Power of Minister to make regulations"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_89",
      "@type": "akn:clause",
      "eli:number": "89",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_89__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_89__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_89__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_89",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may make such regulations as may be necessary or expedient for giving full effect to the provisions of this Act including any supplemental, incidental or consequential matters in relation to this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_89__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_89__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_89__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_89__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_89__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_89__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_89__subsec_2__para_f",
