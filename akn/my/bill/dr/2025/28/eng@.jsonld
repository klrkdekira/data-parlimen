      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_5__subsec_1__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "any company incorporated under the Companies Act 2016 [Act 777] where—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_5__subsec_1__list_2__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_5__subsec_1__list_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of a company limited by shares, the Menteri Besar or Chief Minister incorporated under any State law or any State statutory body is a shareholder having more than fifty per cent of the shares of the company; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_5__subsec_1__list_2__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_5__subsec_1__list_2__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of a company limited by guarantee, the Menteri Besar or Chief Minister incorporated under any State law or any State statutory body is a member of the company; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_5__subsec_1__list_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_5__subsec_1__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "any body corporate incorporated under the Trustees (Incorporation) Act 1952 [Act 258] by the State Government; “Federal Government entity” means—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_5__subsec_1__list_3",
