      "schema:text": {
        "@language": "en",
        "@value": "any Ministry or Federal statutory body, the local authorities of the Federal Territories of Kuala Lumpur, Labuan and Putrajaya or any Federal Government entity;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_5__subsec_1__list_4__para_b",
