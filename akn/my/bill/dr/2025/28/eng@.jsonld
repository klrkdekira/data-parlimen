        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_89__subsec_2__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_89__subsec_2__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_89__subsec_2__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_89__subsec_2__para_k",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_89__subsec_2__para_l",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_89__subsec_2__para_m"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_89",
      "schema:text": {
        "@language": "en",
        "@value": "Without limiting the generality of subsection (1), Minister may make regulations in relating to all or any of the following matters:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_89__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_89__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the exercise of the duties and powers of controlling officer under section 7;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_89__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_89__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the exercise of the duties and powers of a procurement officer under section 8;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_89__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_89__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Government procurement procedures by procuring entity other than a Ministry or ministry or department of a State under section 9;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_89__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_89__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the procedures for the approval of Government procurement under section 10, including the establishment and appointment of any committee for the purposes of evaluation, consideration and recommendation of any matter in Government procurement, including the administration and procedures for such committee;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_89__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_89__subsec_2__para_e__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_89__subsec_2__para_e__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_89__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the administration of a procurement board under sections 11 and 12, including—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_89__subsec_2__para_e__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_89__subsec_2__para_e",
      "schema:text": {
        "@language": "en",
        "@value": "the conditions and procedure for approvals by any person with the authority to approve Government procurement;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_89__subsec_2__para_e__subpara_ii",
