      "schema:text": {
        "@language": "en",
        "@value": "the State financial authority may, in addition to this Act or any instructions, circulars or guidelines issued under this Act, issue any instructions as may be necessary or expedient for the proper administration of this Act at the State, provided that such instructions are not inconsistent with this Act; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_92__para_b",
