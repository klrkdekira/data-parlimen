      "schema:text": {
        "@language": "en",
        "@value": "different persons or activities; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_5__subsec_1__list_1__para_b",
