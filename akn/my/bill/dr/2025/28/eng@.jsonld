    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_10__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_10__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_10__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_10__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to subsection (2), an approval for a Government procurement under this Act may be given by—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_10__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_10__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the Minister or, in relation to a State, the Menteri Besar or Chief Minister or any other authority as may be determined by the State Government, as the case may be;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_10__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_10__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a procurement board established under section 11;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_10__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_10__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a committee established by a controlling officer under paragraph 7(1)(f); or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_10__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_10__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "a controlling officer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The approval threshold of each approving authority under subsection (1) shall be as specified in the First Schedule."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_10__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (2), a Menteri Besar or Chief Minister, as the case may be, may determine the approval threshold for State Government procurement, which shall not exceed the approval threshold as specified in the First Schedule for each approving authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_10__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may prescribe the procedures for the approvals in Government procurement. Establishment of procurement board"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_11__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_11__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_11__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister or, in relation to a State, the Menteri Besar or Chief Minister, as the case may be, may, by notification in the Gazette—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_11__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_11__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "establish a procurement board for every Ministry or, ministry or department of a State, as the case may be; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_11__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_11__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "upon request from the controlling officer of a Ministry or, ministry or department of a State, as the case may be, establish additional procurement board for a specific purpose as the Minister, Menteri Besar or Chief Minister, as the case may be, thinks necessary."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_11__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_11__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "The procurement board established under this section shall consist of the public officers—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_11__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_11__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of a Ministry or ministry or department of a State, as specified in item 1 of the Second Schedule; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_11__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_11__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of the Ministry of Finance, as specified in item 2 of the Second Schedule. Approvals by procurement board"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_9"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "A procurement board established under section 11 shall consider and approve all Government procurements in accordance with the approval threshold as specified in the First Schedule."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The quorum for every meeting of a procurement board shall not be less than three including the chairman."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "No person other than members of the procurement board shall be present or take part in a meeting of the procurement board unless—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "he is a member of the secretariat for the procurement board as designated by the controlling officer; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "he is a public officer invited by the chairman for the purpose of advising the procurement board on any matter being deliberated."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "Any public officer invited under paragraph (3)(b) shall not be entitled to vote or be present during the making of a decision by the procurement board."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "A member of a procurement board having directly or indirectly, by himself, a member of his family or his associate, any interest in any matter under discussion by the procurement board shall disclose to the procurement board the fact and nature of his interest."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_6__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_6__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "A disclosure under subsection (5) shall be recorded in the minutes of the meeting and after the disclosure, the member having an interest in the matter—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "shall not be present or take part in any deliberation or decision of the procurement board on that matter;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "shall be disregarded for the purpose of constituting a quorum of the meeting for the deliberation or decision on that matter; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_6__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "where the member having an interest is the chairman of the procurement board, shall remove himself and be replaced by an alternative chairman as prescribed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "No act or proceedings of a procurement board shall be invalidated on the ground that any member of the procurement board has contravened the provisions of this section."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "If a procurement board fails to reach a unanimous decision on any matter being deliberated in a meeting, the procurement board shall refer the matter to the Minister or, in relation to a State, Menteri Besar or Chief Minister or any other authority as may be determined by the State Government, as the case may be, for a decision."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_9__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_9__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this section—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_9__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_9__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_9__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_9__para_a__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_9__para_a__subpara_iv",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_9__para_a__subpara_v"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_9",
      "schema:text": {
        "@language": "en",
        "@value": "“a member of his family” includes—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_9__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_9__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "his spouse;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_9__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_9__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "his parent, including a parent of his spouse;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_9__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_9__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "his child, including an adopted child or stepchild;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_9__para_a__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_9__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "his brother or sister, including a brother or sister of his spouse; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_9__para_a__subpara_v",
      "@type": "akn:subparagraph",
      "eli:number": "v",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_9__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "a spouse of his child, brother or sister;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_9__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_9__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_9__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_9__para_b__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_9__para_b__subpara_iv",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_9__para_b__subpara_v"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_9",
      "schema:text": {
        "@language": "en",
        "@value": "“associate” means—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_9__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_9__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "a person who is a nominee or an employee of the member;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_9__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_9__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "a firm of which the member or any nominee of his is a partner;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_9__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_9__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "a partner of the member;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_9__para_b__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_9__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "a trustee of a trust under which the member or a member of his family is a beneficiary; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_9__para_b__subpara_v",
      "@type": "akn:subparagraph",
      "eli:number": "v",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_12__subsec_9__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "any corporation within the meaning of the Labuan Companies Act 1990 or the Companies Act 2016, as the case may be, of which or in which the member or any nominee of his or a member of the member’s family is a director or has a substantial shareholding. Approvals by Minister, Menteri Besar, Chief Minister, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_13__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_13__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_13__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_13__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_13__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister or, in relation to a State, Menteri Besar or Chief Minister or any other authority as may be determined by the State Government, as the case may be, shall consider and approve—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_13__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_13__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "all Government procurements in accordance with the approval threshold as specified in the First Schedule; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_13__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_13__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any Government procurement referred to the Minister or, in relation to a State, Menteri Besar or Chief Minister or any other authority as may be determined by the State Government, as the case may be, by a procurement board under subsection 12(8)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_13__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_13__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "Before giving an approval to a Government procurement, the Minister or, in relation to a State, Menteri Besar or Chief Minister or any other authority as may be determined by the State Government, as the case may be, shall—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_13__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_13__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of paragraph (1)(a), require the procurement board responsible for the funds allocated for the Government procurement; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_13__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_13__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of paragraph (1)(b), require the procurement board which referred the Government procurement for a decision, to consider the Government procurement in accordance with this Act and submit a recommendation to the Minister or, in relation to a State, Menteri Besar or Chief Minister or any other authority as may be determined by the State Government, as the case may be."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_13__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "After considering the recommendation submitted under subsection (2), the Minister or, in relation to a State, Menteri Besar or Chief Minister or any other authority as may be determined by the State Government, as the case may be, may concur with the recommendation or may make a different decision as he thinks fit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_13__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_III__cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "Any decision made by the Minister or, in relation to a State, Menteri Besar or Chief Minister or any other authority as may be determined by the State Government, as the case may be, is final and shall be implemented accordingly."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_6__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_6__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_6__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The Secretary General to the Treasury shall be responsible for the administration, control and supervision of all matters relating to this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The Secretary General to the Treasury may delegate any of his powers, duties or functions under this Act, other than the powers under sections 14, 26 and 45, to any officer under his purview subject to such conditions, limitations or restrictions as he thinks fit, and shall give such directions as may be necessary to secure the proper exercise or performance of such powers, duties or functions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "Any delegation under this section shall not preclude the Secretary General to the Treasury himself from exercising or performing at any time any of the delegated powers, duties or functions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_6__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The Secretary General to the Treasury shall exercise due diligence and have in place adequate process and procedures to avoid conflict of interest when exercising his powers, discharging his duties and performing his functions under this Act and in accordance with any instructions or circulars issued under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_6__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The Secretary General to the Treasury shall carry out all such activities and do all such things as are necessary or advantageous and proper for the administration of this Act, or for such other purpose consistent with this Act as may be directed by the Minister in accordance with this Act. Duties and powers of controlling officer"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_7__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_7__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_7__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_7__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_7__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_7__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_7__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_7__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_7__subsec_1__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_7__subsec_1__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_7__subsec_1__para_i"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "A controlling officer shall have the following duties and powers:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_7__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to be accountable for every act done and decision made in relation to Government procurement administered, conducted or implemented within his purview;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_7__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to supervise procurement officers and procurement committees under his supervision and monitor their compliance with this Act and any instructions or circulars issued under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_7__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to exercise due diligence and have in place adequate procedures to avoid conflict of interest when exercising his powers, discharging his duties and performing his functions under this Act and in accordance with any instructions or circulars issued under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_7__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to administer, conduct or implement any Government procurement of which the planning and estimation for the allocated funds have been prepared and approved by the Federal Government or State Government, as the case may be;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_7__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to consider and approve a Government procurement in accordance with this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_7__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to designate or appoint procurement officers and establish procurement committees to assist the controlling officer in performing any of his duties and in the exercise of his powers under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_7__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to specify the extent to which the duties and powers conferred or imposed upon him under this Act may be exercised or performed on his behalf by a procurement officer or procurement committee, as the case may be, in accordance with this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_7__subsec_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to establish a review panel for the handling of complaints relating to Government procurement administered, conducted or implemented by the procuring entity within his purview; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_7__subsec_1__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to carry out all such activities and do all such things as are necessary or advantageous and proper for the administration of this Act, or for such other purpose consistent with this Act as may be directed by the Secretary General to the Treasury."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding paragraph (1)(g), the controlling officer shall remain accountable for the exercise or performance of such duties and powers by the person so authorized."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_7__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "A controlling officer shall be responsible for any loss incurred by the Government arising from his failure to ensure that his duties and powers are exercised and performed in accordance with this Act and any instructions or circulars issued under this Act. Duties and powers of procurement officer"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_8__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_8__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_8__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_8__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_8__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_8__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "A controlling officer—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_8__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_8__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of an appointment under section 15a of the Financial Procedure Act 1957, may designate such number of public officers; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_8__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_8__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of an appointment under subsection 9(1), may appoint such number of persons, as procurement officers for the purposes of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "A controlling officer may specify the extent to which the duties and powers conferred or imposed upon him under this Act may be exercised or performed on his behalf by any procurement officer so designated or appointed and give such directions as may be necessary to secure the proper exercise or performance of such duties and powers."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_8__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "A procurement officer shall, to the extent of the authorization or appointment granted upon him by the controlling officer in accordance with subsection (2), administer, conduct or implement every Government procurement in accordance with this Act and any instructions or circulars issued under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_8__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (2), the controlling officer shall remain accountable for the exercise or performance of such duties and powers by the procurement officer so authorized or appointed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_8__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "Any procurement officer who fails to comply with subsection (3) shall be responsible for any loss incurred by the Government arising from his failure. Administration of Government procurement by procuring entity other than a Ministry or ministry or department of a State"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_9__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_9__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "A procuring entity other than a Ministry or ministry or department of a State shall, subject to the procedures and laws relating to the incorporation or administration of the procuring entity, appoint a person as a controlling officer for the procuring entity."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may prescribe the procedures for the administration, conduct and implementation of Government procurement by procuring entity other than a Ministry or ministry or department of a State."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_9__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_II__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this section, “procuring entity other than a Ministry or ministry or department of a State” means any statutory body of the Federal Government or a State Government, Federal Government entity, State Government entity, the local authorities of the Federal Territories of Kuala Lumpur, Labuan and Putrajaya or any local authority in a State that administers, conducts or implements Government procurement."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_14",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_15",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_16",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_17",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_19",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_20",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_21",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_22",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_23",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_24",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_25",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_26",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_27"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "REGISTRATION OF SUPPLIERS AND CONTRACTORS Registrar, deputy registrar and registration officer"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_14__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_14__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_14__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_14__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "The Secretary General to the Treasury shall appoint a public officer of the Treasury as the Registrar of Government Procurement who shall perform the duties imposed and exercise the powers conferred on him under this Act for the proper administration of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "The Secretary General to the Treasury shall appoint such number of public officers of the Treasury as deputy registrars of Government procurement and registration officers as are necessary to assist the Registrar in the performance of his duties and the exercise of his powers under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_14__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "The appointment of the Registrar under subsection (1) shall be published by notification in the Gazette."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_14__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "The Secretary General to the Treasury may give directions to the Registrar, deputy registrars and registration officers on matters relating to registration under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_14__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "The Secretary General to the Treasury shall have the same powers as conferred to the Registrar under this Act. Duties and powers of Registrar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_15__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_15__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_15__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_15__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_15__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_15__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_15__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_15__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_15__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_15__para_j"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "The Registrar shall have the following duties and powers:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_15__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "to advise the Secretary General to the Treasury on all matters in relation to registration of suppliers and contractors under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_15__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "to implement and enforce Government policies in relation to registration of suppliers and contractors under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_15__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "to be responsible for the monitoring and investigation of the breaches and non-compliances by registered persons under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_15__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "to administer the registration and recognition of suppliers and contractors and deal with all matters relating to registration under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_15__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "to register suppliers and contractors and deal with matters relating to registration under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_15__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "to establish and maintain the register of suppliers and contractors;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_15__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "to establish and maintain the register of recognized suppliers and contractors;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_15__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "to take action in accordance with this Act on any breach or non-compliance by registered persons;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_15__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "to collect fees as prescribed; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_15__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "to carry out all such activities and do all such things as are necessary or advantageous and proper for the administration of this Act, or for such other purposes consistent with this Act as may be directed by the Secretary General to the Treasury. Guidelines and written directions by Registrar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_16__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_16__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_16__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_16__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_16__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_16__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The Registrar may issue guidelines as the Registrar thinks necessary or expedient for the implementation of his duties and powers under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The guidelines issued under this section shall be complied with by all registered persons."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_16__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The Registrar may issue a written direction as he thinks necessary or expedient to any registered person for ensuring compliance with any guidelines or any conditions or restrictions imposed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_16__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_16__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_16__subsec_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_16__subsec_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "Where a registered person fails to comply with any written direction issued under subsection (3), the Registrar may take one or more of the following actions:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_16__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_16__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "direct the registered person in breach to comply with or give effect to the written direction;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_16__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_16__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "impose an administrative penalty under section 85; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_16__subsec_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_16__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "reprimand the registered person in breach."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_16__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_16",
      "schema:text": {
        "@language": "en",
        "@value": "The Registrar shall not take any action under subsection (4) without giving the registered person in breach an opportunity to be heard. Requirement to register"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "No supplier or contractor shall participate in a Government procurement unless he is registered under this Act. Application for registration, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_11",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_12",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_13",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_14",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_15",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_16"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "An application for the registration of a supplier or contractor shall be made to the Registrar in the manner as prescribed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_10",
      "@type": "akn:subsection",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "A person whose registration has expired shall be deemed to be without a valid registration for the purposes of section 17."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_11",
      "@type": "akn:subsection",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "The Registrar may impose such conditions as the Registrar thinks fit to impose on any renewal of registration."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_12",
      "@type": "akn:subsection",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "The Registrar may at any time vary or revoke the conditions imposed on a renewed registration under subsection (11)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_13",
      "@type": "akn:subsection",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "Where there is any change in the information of a registration, the registered person shall make an application to the Registrar to amend the information in such manner as prescribed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_14",
      "@type": "akn:subsection",
      "eli:number": "14",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "The Registrar may impose such conditions as the Registrar thinks fit to impose on any amendment approved under subsection (13)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_15",
      "@type": "akn:subsection",
      "eli:number": "15",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "At any time after having been granted a registration under subsection (4), a registered person may apply to the Registrar for relevant recognition as may be determined by the Treasury."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_16",
      "@type": "akn:subsection",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_16__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_16__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this section—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_16__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_16__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_16__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_16__para_a__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_16__para_a__subpara_iv"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_16",
      "schema:text": {
        "@language": "en",
        "@value": "an application under this section may be made by a supplier or contractor in his personal capacity or by any person on behalf of a company, partnership, co-operative society or professional body, and includes—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_16__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_16__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of a company, the director or any person primarily responsible for the management of the company;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_16__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_16__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of a partnership, all the partners in the partnership;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_16__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_16__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of a co-operative society, the director or any person primarily responsible for the management of the co-operative society; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_16__para_a__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_16__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "any other person that is named in the application as may be required under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_16__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_16",
      "schema:text": {
        "@language": "en",
        "@value": "“professional body” means any body established under any written law for the purposes of regulating a profession and its qualifications or any other body recognized by the Government. Grounds for refusal of registration, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "Every application under subsection (1) shall be accompanied by the fee as prescribed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "At any time after receiving an application under subsection (1), the Registrar may—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "in writing, require the applicant to provide any additional information, particulars or document within any period as specified by the Registrar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "in writing, require the applicant to submit a declaration on matters relevant to the application; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "visit any place or premises for the purpose of ascertaining the fact and nature of the supply, services or works stated in any application for a registration."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "The Registrar may approve an application under subsection (1) if the Registrar is satisfied that the applicant—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "is a fit and proper person;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "has satisfied all the requirements under this Act and complied with any preconditions of the registration; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "has made a disclosure of interest in accordance with subsection 37(2), and shall issue a certificate of registration in such form as may be determined by the Registrar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "The Registrar may impose such conditions as the Registrar thinks fit to impose on any registration."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "The Registrar may at any time vary or revoke the conditions imposed on a registration under subsection (5)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "A registration under this section shall be valid for a period as specified in the certificate of registration."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "A registered person may make an application to renew its registration within the period and in such manner as prescribed and shall be accompanied by the fee as prescribed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "Any application for a renewal of registration made a year after the date of expiration of the registration shall be treated as a new application for registration under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_19__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_19__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_19__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_19__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_19__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_19__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "The Registrar shall refuse an application for a registration or renewal or amendment of a registration under section 18 on any of the following grounds:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_19__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "the applicant has been convicted of an offence under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_19__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "the applicant has been convicted for an offence under the Malaysian Anti-Corruption Commission Act 2009 [Act 694] or for an offence relating to corruption under any law outside Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_19__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "the applicant is one of the persons in the finding of an infringement of a prohibition that has been determined by the Competition Commission in accordance with the Competition Act 2010;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_19__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "the applicant has been convicted of an offence and his name has been registered under the Registration of Criminals and Undesirable Persons Act 1969 [Act 7];"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_19__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "the applicant, in the case of an individual, is an undischarged bankrupt whether within or outside Malaysia; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_19__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_19__para_f__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_19__para_f__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_19__para_f__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_19__para_f__subpara_iv"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "the applicant, in the case of a company—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_19__para_f__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_19__para_f",
      "schema:text": {
        "@language": "en",
        "@value": "is in the course of being wound up or otherwise dissolved;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_19__para_f__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_19__para_f",
      "schema:text": {
        "@language": "en",
        "@value": "had an execution against him in respect of a judgment debt been returned unsatisfied in whole or in part;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_19__para_f__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_19__para_f",
      "schema:text": {
        "@language": "en",
        "@value": "had a receiver, a receiver and manager, or an equivalent person appointed within or outside Malaysia, or in respect of any property of the applicant; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_19__para_f__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_19__para_f",
      "schema:text": {
        "@language": "en",
        "@value": "has, whether within or outside Malaysia, entered into a compromise or scheme of arrangement with its creditors, being a compromise or scheme of arrangement that is still in operation. Registration deemed to be revoked"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_20__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_20__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_20__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV",
      "schema:name": {
        "@language": "en",
        "@value": "A registration shall be deemed to be revoked—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_20__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of an individual, if the registered person is dead or becomes an undischarged bankrupt, whether within or outside Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_20__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_20__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_20__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of a company, if the registered person—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_20__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_20__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "is wound up or otherwise dissolved, whether within or outside Malaysia; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_20__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_20__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "has been struck off the register pursuant to the Labuan Companies Act 1990 or the Companies Act 2016, as the case may be; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_20__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of a co-operative society, upon the revocation of the registration of the co-operative society pursuant to the Co-operative Societies Act 1993. Suspension and revocation of registration"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_21__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_21__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_21__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_21__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_21__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_21__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_21__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_21__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_21__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_21__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_21__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_21__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "The Registrar may suspend a registration granted under subsection 18(4) if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_21__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_21__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the registered person has contravened any provisions of this Act or has not complied with any instructions, circulars or guidelines issued under this Act, and an action has been taken under section 85;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_21__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_21__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the registered person has been convicted for an offence under the Malaysian Anti-Corruption Commission Act 2009 or for an offence relating to corruption under any law outside Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_21__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_21__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the registered person is one of the persons in the finding of an infringement of a prohibition that has been determined by the Competition Commission under the Competition Act 2010;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_21__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_21__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "there is a non-compliance of any guidelines or written directions issued by the Registrar or breach of any condition of registration, by the registered person, and an action has been taken by the Registrar in accordance with subsection 16(4); or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_21__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_21__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any information or document that is furnished by the registered person is false or misleading in a material particular."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_21__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_21__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_21__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "A suspension of registration under subsection (1) may be made—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_21__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_21__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "for a period of not more than two years and the Registrar may at any time extend or revoke the suspension in accordance with this Act; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_21__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_21__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "for one or more classification codes granted in a registration."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_21__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_21__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_21__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "The Registrar may revoke a registration—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_21__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_21__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "on any of the grounds under section 19; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_21__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_21__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "if the registered person or any person named in the registration of the registered person has an interest in another registered person in which he is obligated to disclose under subsection 37(2)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_21__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "In the case of a State, the Registrar may suspend or revoke a registration of a registered person on the recommendation of the State financial authority for a proven non-compliance of any instructions issued by the State financial authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_21__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "The Registrar shall not suspend or revoke any registration without giving the registered person an opportunity to be heard."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_21__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "Where a registration is revoked, all fees paid shall not be refunded. Prohibition on registration"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_22__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_22__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_22__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_22__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "Any registered person whose registration has been suspended or revoked under section 21 is prohibited from registering or participating in a new registration and the prohibition shall include—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_22__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "every person named in the suspended or revoked registration;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_22__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_22__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_22__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of a company—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_22__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_22__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "the director and any person primarily responsible for the management of the company; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_22__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_22__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "any beneficial owner of the registered person;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_22__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of a partnership, all partners in the partnership; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_22__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "in the case of a co-operative society, the director and any person primarily responsible for the management of the co-operative society. Effect of suspension and revocation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_23__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_23__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_23__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_23__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_23__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "The person whose registration has been suspended or revoked under section 21 shall continue—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_23__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_23__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to be subject to this Act to the same extent as if his registration had not been suspended or revoked; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_23__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_23__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to discharge his obligations, until the Secretary General to the Treasury or the Registrar is satisfied that the person whose registration has been suspended or revoked, as the case may be, has discharged his obligations or made adequate arrangements to discharge his obligations, which remain undischarged at the time of suspension or revocation of the registration, as the case may be."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_23__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_23__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_23__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "A suspension or revocation under section 21 shall not operate so as to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_23__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_23__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "avoid or affect any agreement, arrangement or transaction entered into by the person whose registration had been suspended or revoked with any person; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_23__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_23__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "affect any right, obligation or liability arising under any such agreement, arrangement or transaction. Exemption from registration"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_24__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_24__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_24__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, after consulting the Registrar, by order published in the Gazette, exempt any person or class of persons from the requirement to register under section 17 subject to such conditions as the Minister may specify in the order."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_24__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_24",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may at any time, on the recommendation of the Registrar, by order published in the Gazette, revoke any order made under subsection (1) if the Minister is satisfied that such exemption should no longer be granted. Power to publish information"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_25__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_25__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_25__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_25__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "If the Registrar thinks that it is necessary or expedient in the interest of the public, the Registrar may publish any information in the form and manner as may be determined by the Registrar in relation to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_25__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "the approval, lapsing, renewal, suspension or revocation of registration or prohibition or exemption from registration under this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_25__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "any information on the owner, shareholders, directors, partners or any person named in a registration, including any disclosure of interest by a registered person or persons named in a registration in any other registered person;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_25__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "any imposition of a condition; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_25__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_25",
      "schema:text": {
        "@language": "en",
        "@value": "any action taken by the Registrar or the Secretary General to the Treasury under this Act. Review of decision by Registrar on suspension, revocation and prohibition"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "Any person or registered person who is aggrieved by the decision of the Registrar under this Part may, within fourteen days after the registered person has been informed of the decision, submit a request in writing to the Secretary General to the Treasury for a review of the decision. Prohibition on registration under same classification code"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_27__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_27__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_27__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_27__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "Unless with the prior approval of the Registrar, no registered person shall be registered in the same classification code."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_27__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) commits an offence."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_27__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_27__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_27__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_27",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this section—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_27__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_27__subsec_3__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_27__subsec_3__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_27__subsec_3__para_a__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_27__subsec_3__para_a__subpara_iv"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_27__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "“registered person” includes—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_27__subsec_3__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_27__subsec_3__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "any of its employee;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_27__subsec_3__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_27__subsec_3__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "any beneficial owner of the registered person;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_27__subsec_3__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_27__subsec_3__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "any person of interest which the registered person is obligated to disclose under subsection 37(2); or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_27__subsec_3__para_a__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_27__subsec_3__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "any person or group of persons acting in concert with the registered person for the purpose of registering under this Part under the same classification code;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_27__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IV__cl_27__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "“classification code” means the category of the supply of goods and services or any specialization for works as determined by the Registrar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IX",
      "@type": "akn:part",
      "eli:number": "IX",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IX__cl_61",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IX__cl_62"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "COMPLAINTS, OBJECTIONS AND REVIEW Administration of complaints, objections and reviews"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IX__cl_61",
      "@type": "akn:clause",
      "eli:number": "61",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IX__cl_61__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IX__cl_61__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IX__cl_61__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IX__cl_61__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IX__cl_61__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IX__cl_61__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IX__cl_61__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IX__cl_61",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who is dissatisfied with any Government procurement in general may submit a complaint to the procuring entity."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IX__cl_61__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IX__cl_61",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who is dissatisfied with any Government procurement exceeding a certain approval threshold as determined by the Minister may submit an objection to the procuring entity."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IX__cl_61__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IX__cl_61",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who has submitted an objection under subsection (2) and is dissatisfied with the decision made by the procuring entity may submit the decision for a review by the review panel of the procuring entity."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IX__cl_61__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IX__cl_61",
      "schema:text": {
        "@language": "en",
        "@value": "The decision by a review panel shall be submitted in writing to the person making the objection within a reasonable period."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IX__cl_61__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IX__cl_61",
      "schema:text": {
        "@language": "en",
        "@value": "If the person making the objection is not satisfied with the decision made by the review panel under subsection (4), such person may, within the period of fourteen days after the date of the decision, appeal to the Appeal Tribunal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IX__cl_61__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IX__cl_61__subsec_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IX__cl_61__subsec_6__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IX__cl_61__subsec_6__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IX__cl_61__subsec_6__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IX__cl_61",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this section, the Minister may prescribe—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IX__cl_61__subsec_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IX__cl_61__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "the procedure for the administration of complaints in respect of Government procurement in general;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IX__cl_61__subsec_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IX__cl_61__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "the procedure, subject matter and conditions for objection in respect of Government procurement exceeding a certain approval threshold as determined by the Minister;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IX__cl_61__subsec_6__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IX__cl_61__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "the person that is required to administer the complaints and objections; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IX__cl_61__subsec_6__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IX__cl_61__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "the fee for complaints, objections and review. Establishment and administration of review panel"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IX__cl_62",
      "@type": "akn:clause",
      "eli:number": "62",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_IX",
      "schema:text": {
        "@language": "en",
        "@value": "A controlling officer shall establish and administer a review panel for the purpose of reviewing objections on matters relating to the administration and conduct of Government procurement implemented by the procuring entity under his purview in accordance with the procedure, subject matter and conditions as prescribed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Government Procurement Act 2025."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Application"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_2__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_2__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_2__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_2__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall apply to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_2__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_2__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any person who administers, conducts or implements Government procurement; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_2__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_2__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any person who participates in a Government procurement."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding anything in this section, the Minister or, in relation to a State, the Menteri Besar or Chief Minister, as the case may be, may, by order published in the Gazette, exempt from the application of this Act any one-off allocation of funds appropriated by the Supply Act or Supply Enactment, as the case may be, for any Government procurement by any statutory body, local authority, Federal Government entity, State Government entity or any other entity in relation to any new programme. Non-application"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I",
      "schema:name": {
        "@language": "en",
        "@value": "This Act shall not apply to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "any procurement or acquisition of fiscal agency or depository services, liquidation and management services for regulated financial institutions or services related to the sale, redemption and distribution of public debt, including loans and Government bonds, notes and any other securities;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "any appointment on contract basis by the Federation or any State for the delivery of public service; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_3__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_3__para_c__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_3__para_c__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "any procurement—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_3__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_3__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "conducted for the specific purpose of providing international assistance, including development aid;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_3__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_3__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "funded by an international organization or foreign or international grants, loans or other assistance to which procurement procedures or conditions of the international organization or donor apply; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_3__para_c__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_3__para_c",
      "schema:text": {
        "@language": "en",
        "@value": "conducted under the particular procedure or condition of an international agreement relating to the stationing of troops or relating to the joint implementation by the signatory. Act to be read together with relevant written laws"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall be read together with the relevant written laws relating to Government procurement and the provisions of this Act shall be in addition to, and not in derogation of, the provisions of the relevant written laws. Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
