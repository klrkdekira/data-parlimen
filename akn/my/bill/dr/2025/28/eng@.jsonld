      "schema:text": {
        "@language": "en",
        "@value": "any fund appropriated in accordance with the Supply Act by Parliament, including any contingencies fund;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_I__cl_5__subsec_1__list_7__para_a__subpara_ii",
