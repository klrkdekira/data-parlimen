      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_89__subsec_2__para_e",
      "schema:text": {
        "@language": "en",
        "@value": "matters relating to confidentiality and integrity of the decision-making process;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_89__subsec_2__para_f",
