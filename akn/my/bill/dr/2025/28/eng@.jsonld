      "eli:number": "91",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII",
      "schema:text": {
        "@language": "en",
        "@value": "The Secretary General to the Treasury may issue any instructions or circulars as may be necessary or expedient for giving full effect to the provisions of this Act, for carrying out or achieving the objects and purposes of this Act, or any provision thereof, or for the further, better or more convenient implementation of the provisions of this Act. Instructions by State financial authority"
      }
    },
