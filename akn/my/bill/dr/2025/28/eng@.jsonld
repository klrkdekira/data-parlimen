      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, by order published in the Gazette, amend the Schedules to this Act. Instructions and circulars by Secretary General to the Treasury"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/eng@/~part_XII__cl_91",
