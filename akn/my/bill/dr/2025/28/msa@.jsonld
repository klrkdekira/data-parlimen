      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa dana yang diuntukkan mengikut Enakmen Perbekalan oleh suatu Dewan Undangan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I__cl_5__subsec_1__list_7__para_b__subpara_ii",
