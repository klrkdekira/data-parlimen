      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa dana yang diuntukkan dan diarahkan oleh suatu Dewan Undangan mengikut seksyen 9 Akta Kumpulan Wang Pembangunan 1966;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I__cl_5__subsec_1__list_7__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
