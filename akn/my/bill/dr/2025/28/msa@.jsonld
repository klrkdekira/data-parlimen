      "schema:text": {
        "@language": "ms",
        "@value": "PEMANTAUAN PEMATUHAN Pemantauan pematuhan dan kuasa penyeliaan Ketua Setiausaha Perbendaharaan dan pihak berkuasa kewangan Negeri"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII",
      "@type": "akn:part",
      "eli:number": "VIII",
