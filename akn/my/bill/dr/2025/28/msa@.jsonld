        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_24",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_25",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_26",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_27"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "PENDAFTARAN PEMBEKAL DAN KONTRAKTOR Pendaftar, timbalan pendaftar dan pegawai pendaftaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_14__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_14__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_14__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_14__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Setiausaha Perbendaharaan hendaklah melantik seorang pegawai awam Perbendaharaan sebagai Pendaftar Perolehan Kerajaan yang hendaklah melaksanakan kewajipan yang dikenakan dan menjalankan kuasa yang diberikan kepadanya di bawah Akta ini bagi pentadbiran sepatutnya Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Setiausaha Perbendaharaan hendaklah melantik apa-apa bilangan pegawai awam Perbendaharaan sebagai timbalan pendaftar perolehan Kerajaan dan pegawai pendaftaran sebagaimana yang perlu untuk membantu Pendaftar dalam melaksanakan kewajipan dan menjalankan kuasanya di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_14__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Pelantikan Pendaftar di bawah subseksyen (1) hendaklah disiarkan melalui pemberitahuan dalam Warta."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_14__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Setiausaha Perbendaharaan boleh memberikan arahan kepada Pendaftar, timbalan pendaftar dan pegawai pendaftaran mengenai perkara yang berhubungan dengan pendaftaran di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_14__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Setiausaha Perbendaharaan hendaklah mempunyai kuasa yang sama sebagaimana yang diperuntukkan kepada Pendaftar di bawah Akta ini. Kewajipan dan kuasa Pendaftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_15__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_15__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_15__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_15__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_15__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_15__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_15__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_15__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_15__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_15__para_j"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar hendaklah mempunyai kewajipan dan kuasa yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_15__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menasihati Ketua Setiausaha Perbendaharaan mengenai semua perkara berhubung dengan pendaftaran pembekal dan kontraktor di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_15__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk melaksanakan dan menguatkuasakan dasar Kerajaan berhubung dengan pendaftaran pembekal dan kontraktor di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_15__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk bertanggungjawab bagi pemantauan dan penyiasatan terhadap pelanggaran dan ketidakpatuhan oleh orang berdaftar di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_15__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mentadbir pendaftaran dan pengiktirafan pembekal dan kontraktor dan menangani semua perkara yang berhubungan dengan pendaftaran di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_15__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mendaftarkan pembekal dan kontraktor dan menangani perkara yang berhubungan dengan pendaftaran di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_15__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mewujudkan dan menyenggara daftar pembekal dan kontraktor;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_15__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mewujudkan dan menyenggara daftar pembekal dan kontraktor yang diiktiraf;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_15__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengambil tindakan mengikut Akta ini bagi apa-apa pelanggaran atau ketidakpatuhan oleh orang berdaftar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_15__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengutip fi yang ditetapkan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_15__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menjalankan semua aktiviti dan membuat semua perkara yang perlu atau berfaedah dan patut bagi pentadbiran Akta ini, atau bagi apa-apa maksud lain yang selaras dengan Akta ini sebagaimana yang diarahkan oleh Ketua Setiausaha Perbendaharaan. Garis panduan dan arahan bertulis oleh Pendaftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_16__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_16__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_16__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_16__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_16__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_16__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar boleh mengeluarkan garis panduan sebagaimana yang Pendaftar fikirkan perlu atau suai manfaat bagi pelaksanaan kewajipan dan kuasanya di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_16__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Garis panduan yang dikeluarkan di bawah seksyen ini hendaklah dipatuhi oleh semua orang berdaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_16__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar boleh mengeluarkan arahan bertulis yang difikirkannya perlu atau suai manfaat kepada mana-mana orang berdaftar bagi memastikan pematuhan apa-apa garis panduan atau apa-apa syarat atau sekatan yang dikenakan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_16__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_16__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_16__subsec_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_16__subsec_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika orang berdaftar tidak mematuhi mana-mana arahan bertulis yang dikeluarkan di bawah subseksyen (3), Pendaftar boleh mengambil satu atau lebih tindakan yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_16__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_16__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "mengarahkan orang berdaftar yang mungkir itu untuk mematuhi atau melaksanakan arahan bertulis itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_16__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_16__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "mengenakan penalti pentadbiran di bawah seksyen 85; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_16__subsec_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_16__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "mencela orang berdaftar yang mungkir itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_16__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar tidak boleh mengambil apa-apa tindakan di bawah subseksyen (4) tanpa memberikan orang berdaftar yang mungkir itu suatu peluang untuk didengari. Kehendak untuk mendaftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada mana-mana pembekal atau kontraktor boleh menyertai suatu perolehan Kerajaan melainkan jika dia didaftarkan di bawah Akta ini. Permohonan bagi pendaftaran, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_11",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_12",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_13",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_14",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_15",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_16"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu permohonan bagi pendaftaran pembekal atau kontraktor hendaklah dibuat kepada Pendaftar mengikut cara yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_10",
      "@type": "akn:subsection",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang pendaftarannya telah habis tempoh hendaklah dianggap sebagai tidak mempunyai pendaftaran yang sah bagi maksud seksyen 17."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_11",
      "@type": "akn:subsection",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar boleh mengenakan apa-apa syarat sebagaimana yang Pendaftar fikirkan patut untuk dikenakan kepada mana-mana pembaharuan pendaftaran."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_12",
      "@type": "akn:subsection",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar boleh pada bila-bila masa mengubah atau membatalkan syarat yang dikenakan kepada sesuatu pembaharuan pendaftaran di bawah subseksyen (11)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_13",
      "@type": "akn:subsection",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika terdapat apa-apa perubahan dalam maklumat sesuatu pendaftaran, orang berdaftar hendaklah membuat permohonan kepada Pendaftar untuk meminda maklumat itu mengikut cara yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_14",
      "@type": "akn:subsection",
      "eli:number": "14",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar boleh mengenakan apa-apa syarat sebagaimana yang Pendaftar fikirkan patut untuk dikenakan kepada apa-apa pindaan yang diluluskan di bawah subseksyen (13)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_15",
      "@type": "akn:subsection",
      "eli:number": "15",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Pada bila-bila masa selepas didaftarkan di bawah subseksyen (4), orang berdaftar boleh memohon kepada Pendaftar bagi pengiktirafan berkaitan sebagaimana yang ditentukan oleh Perbendaharaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_16",
      "@type": "akn:subsection",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_16__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_16__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_16__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_16__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_16__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_16__para_a__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_16__para_a__subpara_iv"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_16",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu permohonan di bawah seksyen ini boleh dibuat oleh pembekal atau kontraktor dalam kapasiti peribadinya atau oleh mana-mana orang bagi pihak suatu syarikat, perkongsian, koperasi atau badan profesional, termasuklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_16__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_16__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal suatu syarikat, pengarah atau mana-mana orang yang mempunyai tanggungjawab utama dalam pengurusan syarikat itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_16__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_16__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal suatu perkongsian, semua pekongsi dalam perkongsian itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_16__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_16__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal suatu koperasi, pengarah atau mana-mana orang yang mempunyai tanggungjawab utama dalam pengurusan koperasi itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_16__para_a__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_16__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang lain yang dinamakan dalam permohonan sebagaimana yang dikehendaki oleh Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_16__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_16",
      "schema:text": {
        "@language": "ms",
        "@value": "“badan profesional” ertinya mana-mana badan yang ditubuhkan di bawah mana-mana undang-undang bertulis bagi maksud mengawal selia suatu profesion dan kelayakannya atau mana-mana badan lain yang diiktiraf oleh Kerajaan. Alasan bagi penolakan pendaftaran, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap permohonan di bawah subseksyen (1) hendaklah disertakan dengan fi yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Pada bila-bila masa selepas menerima suatu permohonan di bawah subseksyen (1), Pendaftar boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "secara bertulis, menghendaki pemohon untuk memberikan apa-apa maklumat, butir-butir atau dokumen tambahan dalam apa-apa tempoh yang dinyatakan oleh Pendaftar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "secara bertulis, menghendaki pemohon untuk mengemukakan suatu perisytiharan mengenai perkara yang berkaitan dengan permohonan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "melawat mana-mana tempat atau premis bagi maksud menentukan fakta dan jenis pembekalan, perkhidmatan atau kerja yang dinyatakan dalam mana-mana permohonan bagi suatu pendaftaran."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar boleh meluluskan sesuatu permohonan di bawah subseksyen (1) jika Pendaftar berpuas hati bahawa pemohon—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "ialah orang yang layak dan sesuai;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "telah memenuhi semua kehendak di bawah Akta dan mematuhi semua prasyarat pendaftaran; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "telah membuat penzahiran kepentingan mengikut subseksyen 37(2), dan hendaklah mengeluarkan suatu sijil pendaftaran dalam bentuk sebagaimana yang ditentukan oleh Pendaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar boleh mengenakan apa-apa syarat sebagaimana yang Pendaftar fikirkan patut untuk dikenakan kepada mana-mana pendaftaran."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar boleh pada bila-bila masa mengubah atau membatalkan syarat yang dikenakan kepada sesuatu pendaftaran di bawah subseksyen (5)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu pendaftaran di bawah seksyen ini adalah sah bagi tempoh yang dinyatakan dalam sijil pendaftaran."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Orang berdaftar boleh membuat permohonan untuk membaharui pendaftarannya dalam tempoh dan mengikut apa-apa cara yang ditetapkan dan hendaklah disertakan dengan fi yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana permohonan bagi pembaharuan pendaftaran yang dibuat setahun selepas tarikh habis tempoh pendaftaran itu hendaklah diuruskan sebagai permohonan baharu bagi pendaftaran di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_19__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_19__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_19__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_19__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_19__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_19__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar hendaklah menolak sesuatu permohonan bagi pendaftaran atau pembaharuan atau pindaan pendaftaran di bawah seksyen 18 atas mana-mana alasan yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_19__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "pemohon telah disabitkan dengan suatu kesalahan di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_19__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "pemohon telah disabitkan dengan suatu kesalahan di bawah Akta Suruhanjaya Pencegahan Rasuah Malaysia 2009 [Akta 694] atau dengan suatu kesalahan yang berhubungan dengan rasuah di bawah mana-mana undang-undang di luar Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_19__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "pemohon merupakan salah seorang dalam suatu dapatan pelanggaran suatu larangan yang telah ditentukan oleh Suruhanjaya Persaingan mengikut Akta Persaingan 2010;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_19__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "pemohon telah disabitkan dengan apa-apa kesalahan dan namanya telah didaftarkan di bawah Akta Pendaftaran Penjenayah dan Orang yang tidak Diingini 1969 [Akta 7];"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_19__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "pemohon, dalam hal seseorang individu, merupakan seorang bankrap yang belum dilepaskan sama ada di dalam atau di luar Malaysia; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_19__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_19__para_f__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_19__para_f__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_19__para_f__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_19__para_f__subpara_iv"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "pemohon, dalam hal suatu syarikat—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_19__para_f__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_19__para_f",
      "schema:text": {
        "@language": "ms",
        "@value": "sedang digulung atau selainnya dibubarkan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_19__para_f__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_19__para_f",
      "schema:text": {
        "@language": "ms",
        "@value": "telah terhadapnya pelaksanaan berkenaan dengan suatu hutang penghakiman dikembalikan tanpa dijelaskan keseluruhannya atau sebahagiannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_19__para_f__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_19__para_f",
      "schema:text": {
        "@language": "ms",
        "@value": "telah dilantik baginya seorang penerima, penerima dan pengurus, atau orang yang setaraf dengannya di dalam atau di luar Malaysia, atau berkenaan dengan mana-mana harta pemohon itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_19__para_f__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_19__para_f",
      "schema:text": {
        "@language": "ms",
        "@value": "telah, sama ada di dalam atau di luar Malaysia, membuat suatu kompromi atau skim perkiraan dengan pemiutangnya, yang merupakan suatu kompromi atau skim perkiraan yang masih berkuat kuasa. Pendaftaran disifatkan terbatal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_20__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_20__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_20__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV",
      "schema:name": {
        "@language": "ms",
        "@value": "Pendaftaran hendaklah disifatkan telah dibatalkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_20__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal seseorang individu, jika orang berdaftar itu telah mati atau telah menjadi seorang bankrap yang belum dilepaskan, sama ada di dalam atau di luar Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_20__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_20__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_20__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal suatu syarikat, jika orang berdaftar itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_20__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_20__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "telah digulung atau selainnya dibubarkan, sama ada di dalam atau di luar Malaysia; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_20__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_20__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "telah dipotong namanya daripada daftar menurut Akta Syarikat Labuan 1990 atau Akta Syarikat 2016, mengikut mana-mana yang berkenaan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_20__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal suatu koperasi, atas pembatalan pendaftaran koperasi tersebut menurut Akta Koperasi 1993. Penggantungan dan pembatalan pendaftaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_21__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_21__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_21__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_21__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_21__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_21__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_21__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_21__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_21__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_21__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_21__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_21__subsec_1__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar boleh menggantung suatu pendaftaran yang diberikan di bawah subseksyen 18(4) jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_21__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_21__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "orang berdaftar telah melanggar mana-mana peruntukan Akta ini atau tidak mematuhi mana-mana arahan, pekeliling atau garis panduan yang dikeluarkan di bawah Akta ini, dan tindakan telah diambil di bawah seksyen 85;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_21__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_21__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "orang berdaftar telah disabitkan dengan suatu kesalahan di bawah Akta Suruhanjaya Pencegahan Rasuah Malaysia 2009 atau dengan suatu kesalahan yang berhubungan dengan rasuah di bawah mana-mana undang-undang di luar Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_21__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_21__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "orang berdaftar merupakan salah seorang dalam suatu dapatan pelanggaran suatu larangan yang telah ditentukan oleh Suruhanjaya Persaingan mengikut Akta Persaingan 2010;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_21__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_21__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "terdapat ketidakpatuhan mana-mana garis panduan atau arahan bertulis yang dikeluarkan oleh Pendaftar atau pelanggaran mana-mana syarat pendaftaran, oleh orang berdaftar, dan tindakan telah diambil oleh Pendaftar mengikut subseksyen 16(4); atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_21__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_21__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa maklumat atau dokumen yang diberikan oleh orang berdaftar adalah palsu atau mengelirukan dalam butir-butir material."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_21__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_21__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_21__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Penggantungan pendaftaran di bawah subseksyen (1) boleh dibuat—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_21__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_21__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi suatu tempoh tidak melebihi dua tahun dan Pendaftar boleh pada bila-bila masa melanjutkan atau membatalkan penggantungan itu mengikut Akta ini; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_21__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_21__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "bagi satu atau lebih kod bidang yang telah diberikan dalam suatu pendaftaran."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_21__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_21__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_21__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar boleh membatalkan suatu pendaftaran—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_21__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_21__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "atas mana-mana alasan di bawah seksyen 19; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_21__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_21__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "jika orang berdaftar atau mana-mana orang yang dinamakan dalam pendaftaran orang berdaftar tersebut mempunyai kepentingan dalam orang berdaftar lain yang dia berkewajipan untuk menzahirkan di bawah subseksyen 37(2)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_21__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam hal sesuatu Negeri, Pendaftar boleh menggantung atau membatalkan pendaftaran seseorang orang berdaftar atas syor pihak berkuasa kewangan Negeri bagi ketidakpatuhan yang terbukti apa-apa arahan yang dikeluarkan oleh pihak berkuasa kewangan Negeri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_21__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar tidak boleh menggantung atau membatalkan mana-mana pendaftaran tanpa memberikan orang berdaftar itu suatu peluang untuk didengari."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_21__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu pendaftaran dibatalkan, semua fi yang telah dibayar tidak boleh dikembalikan. Larangan mengenai pendaftaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_22__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_22__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_22__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_22__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang berdaftar yang pendaftarannya telah digantung atau dibatalkan di bawah seksyen 21 adalah dilarang daripada mendaftar atau menyertai suatu pendaftaran baharu dan larangan ini hendaklah termasuk—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_22__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "tiap-tiap orang yang dinamakan dalam pendaftaran yang telah digantung atau dibatalkan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_22__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_22__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_22__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal suatu syarikat—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_22__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_22__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "pengarah dan mana-mana orang yang memegang tanggungjawab utama dalam pengurusan syarikat; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_22__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_22__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana pemunya benefisial orang berdaftar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_22__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal suatu perkongsian, semua pekongsi dalam perkongsian itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_22__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal suatu koperasi, pengarah dan mana-mana orang yang memegang tanggungjawab utama dalam pengurusan koperasi. Kesan penggantungan dan pembatalan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_23__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_23__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_23__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_23__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_23__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Orang yang pendaftarannya telah digantung atau dibatalkan di bawah seksyen 21 hendaklah terus—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_23__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_23__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tertakluk kepada Akta ini pada takat yang sama seolah-olah pendaftarannya tidak digantung atau dibatalkan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_23__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_23__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menunaikan obligasinya, sehingga Ketua Setiausaha Perbendaharaan atau Pendaftar berpuas hati bahawa orang yang pendaftarannya telah digantung atau dibatalkan itu, mengikut mana-mana yang berkenaan, telah menunaikan obligasinya atau membuat perkiraan yang mencukupi untuk menunaikan obligasinya, yang belum selesai pada masa penggantungan atau pembatalan pendaftarannya, mengikut mana-mana yang berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_23__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_23__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_23__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu penggantungan atau pembatalan di bawah seksyen 21 tidak berkuat kuasa untuk—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_23__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_23__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mengelak atau menjejaskan mana-mana perjanjian, perkiraan atau transaksi yang dibuat oleh orang yang pendaftarannya telah digantung atau dibatalkan dengan mana-mana orang; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_23__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_23__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menjejaskan apa-apa hak, obligasi atau liabiliti yang berbangkit di bawah mana-mana perjanjian, perkiraan atau transaksi itu. Pengecualian daripada pendaftaran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_24",
      "@type": "akn:clause",
      "eli:number": "24",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_24__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_24__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_24__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh, selepas berunding dengan Pendaftar, melalui perintah yang disiarkan dalam Warta, mengecualikan mana-mana orang atau kelas orang daripada kehendak untuk mendaftar di bawah seksyen 17 tertakluk kepada apa-apa syarat yang dinyatakan oleh Menteri dalam perintah itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_24__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh pada bila-bila masa, atas syor Pendaftar, melalui perintah yang disiarkan dalam Warta, membatalkan apa-apa perintah yang dibuat di bawah subseksyen (1) jika Menteri berpuas hati bahawa pengecualian itu tidak lagi diperlukan. Kuasa untuk menyiarkan maklumat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_25",
      "@type": "akn:clause",
      "eli:number": "25",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_25__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_25__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_25__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_25__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Pendaftar fikirkan perlu atau suai manfaat demi kepentingan awam, Pendaftar boleh menyiarkan apa-apa maklumat dalam bentuk dan cara sebagaimana yang ditentukan oleh Pendaftar berhubung dengan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_25__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "kelulusan, peluputan, pembaharuan, penggantungan atau pembatalan pendaftaran atau larangan mengenai atau pengecualian daripada pendaftaran di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_25__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa maklumat berkenaan pemilik, pemegang syer, pengarah, pekongsi atau mana-mana orang yang dinamakan dalam suatu pendaftaran, termasuk apa-apa penzahiran kepentingan oleh orang berdaftar atau orang yang dinamakan dalam pendaftaran dalam mana-mana orang berdaftar lain;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_25__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa syarat yang dikenakan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_25__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_25",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa tindakan yang diambil oleh Pendaftar atau Ketua Setiausaha Perbendaharaan di bawah Akta ini. Kajian semula keputusan Pendaftar bagi penggantungan, pembatalan dan larangan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_26",
      "@type": "akn:clause",
      "eli:number": "26",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang atau orang berdaftar yang terkilan dengan keputusan Pendaftar di bawah Bahagian ini boleh, dalam masa empat belas hari selepas orang berdaftar itu telah diberitahu mengenai keputusan itu, memohon secara bertulis kepada Ketua Setiausaha Perbendaharaan untuk kajian semula keputusan itu. Larangan pendaftaran dalam kod bidang yang sama"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_27",
      "@type": "akn:clause",
      "eli:number": "27",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_27__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_27__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_27__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_27__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "Melainkan jika dengan kelulusan Pendaftar terlebih dahulu, tiada orang berdaftar boleh didaftarkan dalam kod bidang yang sama."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_27__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1) melakukan suatu kesalahan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_27__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_27__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_27__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_27",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_27__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_27__subsec_3__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_27__subsec_3__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_27__subsec_3__para_a__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_27__subsec_3__para_a__subpara_iv"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_27__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "“orang berdaftar” termasuklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_27__subsec_3__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_27__subsec_3__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana pekerjanya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_27__subsec_3__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_27__subsec_3__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana pemunya benefisial orang berdaftar;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_27__subsec_3__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_27__subsec_3__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang berkepentingan yang orang berdaftar berkewajipan untuk menzahirkan di bawah subseksyen 37(2); atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_27__subsec_3__para_a__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_27__subsec_3__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang atau kumpulan orang yang bertindak bersama-sama orang berdaftar bagi maksud pendaftaran di bawah Akta ini dalam kod bidang yang sama;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_27__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV__cl_27__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "“kod bidang” ertinya kategori pembekalan barangan dan perkhidmatan atau apa-apa pengkhususan bagi kerja sebagaimana yang ditentukan oleh Pendaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IX",
      "@type": "akn:part",
      "eli:number": "IX",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IX__cl_61",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IX__cl_62"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "ADUAN, BANTAHAN DAN KAJIAN SEMULA Pentadbiran aduan, bantahan dan kajian semula"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IX__cl_61",
      "@type": "akn:clause",
      "eli:number": "61",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IX__cl_61__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IX__cl_61__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IX__cl_61__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IX__cl_61__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IX__cl_61__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IX__cl_61__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IX"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IX__cl_61__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IX__cl_61",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang tidak berpuas hati dengan mana-mana perolehan Kerajaan secara am boleh mengemukakan aduan kepada entiti perolehan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IX__cl_61__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IX__cl_61",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang tidak berpuas hati dengan mana-mana perolehan Kerajaan yang melebihi suatu nilai ambang kelulusan tertentu yang ditentukan oleh Menteri boleh mengemukakan bantahan kepada entiti perolehan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IX__cl_61__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IX__cl_61",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang telah mengemukakan bantahan di bawah subseksyen (2) dan tidak berpuas hati dengan keputusan entiti perolehan boleh mengemukakan keputusan tersebut untuk kajian semula oleh panel kajian semula entiti perolehan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IX__cl_61__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IX__cl_61",
      "schema:text": {
        "@language": "ms",
        "@value": "Keputusan oleh panel kajian semula hendaklah dikemukakan secara bertulis kepada orang yang membuat bantahan itu dalam tempoh yang munasabah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IX__cl_61__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IX__cl_61",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika orang yang membuat bantahan itu tidak berpuas hati dengan keputusan yang dibuat oleh panel kajian semula di bawah subseksyen (4), orang itu boleh, dalam tempoh empat belas hari selepas tarikh keputusan itu, merayu kepada Tribunal Rayuan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IX__cl_61__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IX__cl_61__subsec_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IX__cl_61__subsec_6__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IX__cl_61__subsec_6__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IX__cl_61__subsec_6__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IX__cl_61",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini, Menteri boleh menetapkan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IX__cl_61__subsec_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IX__cl_61__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "tatacara pentadbiran aduan berkenaan dengan perolehan Kerajaan secara am;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IX__cl_61__subsec_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IX__cl_61__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "tatacara, hal perkara dan syarat bagi bantahan berkenaan dengan perolehan Kerajaan yang melebihi suatu nilai ambang kelulusan tertentu sebagaimana yang ditentukan oleh Menteri;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IX__cl_61__subsec_6__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IX__cl_61__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "orang yang dikehendaki untuk mentadbir aduan dan bantahan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IX__cl_61__subsec_6__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IX__cl_61__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "fi bagi aduan, bantahan dan kajian semula. Penubuhan dan pentadbiran panel kajian semula"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IX__cl_62",
      "@type": "akn:clause",
      "eli:number": "62",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IX",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pegawai pengawal hendaklah menubuhkan dan mentadbir suatu panel kajian semula bagi maksud mengkaji semula bantahan mengenai perkara yang berhubungan dengan pentadbiran dan penjalanan perolehan Kerajaan yang dilaksanakan oleh entiti perolehan di bawah bidang kuasanya mengikut tatacara, hal perkara dan syarat yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I__cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I__cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Perolehan Kerajaan 2025."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I__cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta. Pemakaian"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I__cl_2__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I__cl_2__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I__cl_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I__cl_2__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I__cl_2__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I__cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini hendaklah terpakai bagi—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I__cl_2__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I__cl_2__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang yang mentadbir, menjalankan atau melaksanakan perolehan Kerajaan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I__cl_2__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I__cl_2__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang yang menyertai perolehan Kerajaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I__cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I__cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun dalam seksyen ini, Menteri atau, berhubung dengan sesuatu Negeri, Menteri Besar atau Ketua Menteri, mengikut mana-mana yang berkenaan, boleh, melalui perintah yang disiarkan dalam Warta, mengecualikan daripada pemakaian Akta ini mana-mana peruntukan dana sekali beri yang diuntukkan melalui Akta Perbekalan atau Enakmen Perbekalan, mengikut mana-mana yang berkenaan, bagi apa-apa perolehan Kerajaan oleh mana-mana badan berkanun, pihak berkuasa tempatan, entiti Kerajaan Persekutuan, entiti Kerajaan Negeri atau mana-mana entiti lain berhubung dengan apa-apa program baharu. Ketidakpakaian"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I__cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I__cl_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I__cl_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta ini tidak terpakai bagi—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I__cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa perolehan atau pengambilan agensi fiskal atau perkhidmatan depositori, perkhidmatan pembubaran dan pengurusan bagi institusi kewangan yang dikawal selia atau perkhidmatan yang berkaitan dengan penjualan, penebusan dan pengagihan hutang awam, termasuk pinjaman dan bon Kerajaan, nota dan apa-apa sekuriti lain;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I__cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa pelantikan atas dasar kontrak oleh Persekutuan atau mana-mana Negeri bagi penyampaian perkhidmatan awam; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I__cl_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I__cl_3__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I__cl_3__para_c__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I__cl_3__para_c__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa perolehan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I__cl_3__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I__cl_3__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "yang dijalankan bagi maksud khusus untuk memberikan bantuan antarabangsa, termasuk bantuan pembangunan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I__cl_3__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I__cl_3__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "yang dibiayai oleh organisasi antarabangsa atau oleh pemberian, pinjaman atau bantuan asing atau antarabangsa lain yang tatacara atau syarat perolehan organisasi antarabangsa atau penyumbang tersebut terpakai; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I__cl_3__para_c__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I__cl_3__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "yang dijalankan di bawah prosedur atau syarat khusus suatu perjanjian antarabangsa yang berhubungan dengan penempatan tentera atau yang berhubungan dengan pelaksanaan bersama oleh penandatangan. Akta hendaklah dibaca bersama-sama undang-undang bertulis yang berkaitan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini hendaklah dibaca bersama-sama mana-mana undang-undang bertulis yang berkaitan yang berhubungan dengan perolehan Kerajaan dan peruntukan Akta ini hendaklah menjadi tambahan kepada, dan tidak mengurangkan, peruntukan undang-undang bertulis yang berkaitan itu. Tafsiran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I__cl_5__subsec_1",
