        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_64__subsec_2__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_64__subsec_2__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_64__subsec_2__para_k"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_64",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh pada bila-bila masa membatalkan pelantikan mana-mana anggota Tribunal Rayuan melalui perintah yang disiarkan dalam Warta jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_64__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_64__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dia meletakkan jawatannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_64__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_64__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dia telah disabitkan atas suatu kesalahan, di bawah mana-mana undang-undang bertulis, oleh suatu mahkamah di Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_64__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_64__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dia merupakan salah seorang dalam dapatan pelanggaran suatu larangan yang telah ditentukan oleh Suruhanjaya Persaingan di bawah Akta Persaingan 2010;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_64__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_64__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "kelakuannya, sama ada berkaitan dengan kewajipannya sebagai anggota Tribunal Rayuan atau selainnya, telah mencemarkan nama baik Tribunal Rayuan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_64__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_64__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dia menjadi bankrap atau insolven;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_64__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_64__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dia tidak sempurna akal atau selainnya tidak berupaya untuk menunaikan kewajipannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_64__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_64__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dia menjadi seorang anggota Dewan Negara atau Dewan Rakyat atau mana-mana Dewan Undangan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_64__subsec_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_64__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal suatu pelantikan di bawah perenggan 63(2)(b), dia menjadi seorang pegawai awam atau anggota pentadbiran;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_64__subsec_2__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_64__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dia telah melakukan salah laku yang serius berhubung dengan kewajipannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_64__subsec_2__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_64__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "prestasinya adalah tidak memuaskan bagi suatu tempoh masa yang ketara; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_64__subsec_2__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_64__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dia tidak menjalankan obligasinya di bawah seksyen 73. Pengosongan jawatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_65",
