      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa dana yang diuntukkan dan diarahkan oleh Dewan Rakyat mengikut seksyen 3 dan 4 Akta Kumpulan Wang Pembangunan 1966;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I__cl_5__subsec_1__list_7__para_a__subpara_iii",
