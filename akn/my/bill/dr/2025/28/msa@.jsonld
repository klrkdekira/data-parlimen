        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_47",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_48",
