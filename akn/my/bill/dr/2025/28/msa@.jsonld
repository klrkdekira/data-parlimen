      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_69__subsec_1__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tatacara yang membawa kepada award kontrak perolehan Kerajaan yang menjadi hal perkara rayuan itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_69__subsec_1__list_2",
