      "schema:text": {
        "@language": "ms",
        "@value": "AM Kuasa Menteri untuk membuat peraturan-peraturan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_XII__cl_89",
      "@type": "akn:clause",
      "eli:number": "89",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_XII__cl_89__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_XII__cl_89__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_XII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_XII__cl_89__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_XII__cl_89",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh membuat peraturan-peraturan sebagaimana yang perlu atau suai manfaat bagi memberikan kuat kuasa penuh kepada peruntukan Akta ini termasuk apa-apa perkara tambahan, bersampingan atau berbangkit berhubung dengan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_XII__cl_89__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_XII__cl_89__subsec_2__para_a",
