      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana pihak berkuasa tempatan atau pihak berkuasa yang ditubuhkan atau disifatkan telah ditubuhkan di bawah Akta Kerajaan Tempatan 1976 [Akta 171], atau Ordinan Pihak Berkuasa Tempatan Sarawak 1996 [Sarawak Bab 20] atau Perbandaran yang ditubuhkan di bawah Ordinan Perbandaran Kuching [Sarawak Bab 116], atau Ordinan Kerajaan Tempatan 1961 [Sabah Ord. 11 Tahun 1961];"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I__cl_5__subsec_1__list_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I__cl_5__subsec_1__list_8",
      "schema:text": {
        "@language": "ms",
        "@value": "berhubung dengan Wilayah Persekutuan Kuala Lumpur, Datuk Bandar Bandaraya Kuala Lumpur yang dilantik di bawah seksyen 4 Akta Ibu Kota Persekutuan 1960 [Akta 190];"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I__cl_5__subsec_1__list_8__para_c",
