        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_69__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_69__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_69__subsec_1__list_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_69__subsec_1__list_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_69",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang perayu boleh, pada bila-bila masa selepas perayu telah menyerah simpan notis rayuan dengan Setiausaha Tribunal Rayuan, membayar apa-apa fi dan deposit yang ditetapkan dan menyampaikan notis rayuan kepada panel kajian semula yang berkaitan, membuat suatu permohonan kepada Tribunal Rayuan bagi suatu perintah untuk menggantung—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_69__subsec_1__list_1",
      "@type": "akn:list",
      "eli:number": "1",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_69__subsec_1__list_1__para_a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_69__subsec_1"
    },
    {
