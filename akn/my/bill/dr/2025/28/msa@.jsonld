      "schema:text": {
        "@language": "ms",
        "@value": "kejuruteraan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_63__subsec_2__para_b__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_63__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "ekonomi atau perdagangan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_63__subsec_2__para_b__subpara_v",
      "@type": "akn:subparagraph",
      "eli:number": "v",
