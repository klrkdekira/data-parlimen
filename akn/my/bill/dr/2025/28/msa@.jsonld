        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_63__subsec_2__para_b__subpara_v"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_63__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak kurang daripada lima anggota dalam kalangan orang yang mempunyai integriti dan reputasi yang amat baik dengan pengalaman yang terbukti dan pengetahuan yang diiktiraf dalam—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_63__subsec_2__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_63__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "undang-undang;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_63__subsec_2__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_63__subsec_2__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "kewangan atau perolehan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_63__subsec_2__para_b__subpara_iii",
