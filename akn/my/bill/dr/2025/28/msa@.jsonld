    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_63__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_63",
      "schema:text": {
        "@language": "ms",
        "@value": "Maka hendaklah ditubuhkan suatu Tribunal Rayuan Perolehan Kerajaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_63__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_63__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_63__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_63",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri hendaklah, melalui perintah yang disiarkan dalam Warta, melantik anggota Tribunal Rayuan seperti yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_63__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_63__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "seorang Pengerusi dan tidak lebih daripada dua Timbalan Pengerusi yang hendaklah dilantik dalam kalangan pegawai Perkhidmatan Kehakiman dan Perundangan dengan tidak kurang daripada sepuluh tahun pengalaman; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_63__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
