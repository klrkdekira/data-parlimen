      "schema:text": {
        "@language": "ms",
        "@value": "TINDAKAN PENTADBIRAN DAN PENDAKWAAN Dokumen dan maklumat palsu"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_XII",
