      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa pemberian, pinjaman atau apa-apa peruntukan yang berpunca daripada subperenggan (a)(i) hingga (a)(iii), oleh atau melalui Kerajaan Persekutuan kepada mana-mana orang atau entiti; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I__cl_5__subsec_1__list_7__para_a__subpara_v",
