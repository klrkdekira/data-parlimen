      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa dana daripada akaun amanah atau kumpulan wang amanah Kerajaan yang ditubuhkan oleh Kerajaan Persekutuan mengikut seksyen 9 dan 10 Akta Tatacara Kewangan 1957;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I__cl_5__subsec_1__list_7__para_a__subpara_iv",
