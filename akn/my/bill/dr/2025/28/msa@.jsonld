      "schema:text": {
        "@language": "ms",
        "@value": "pentadbiran awam."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_63__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_63__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_63__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_63__subsec_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_63__subsec_3__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_63__subsec_3__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_63__subsec_3__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_63",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan subseksyen (2), bagi maksud perenggan (b), tiada seorang pun boleh dilantik sebagai anggota Tribunal Rayuan jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_63__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_63__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dia telah disabitkan atas suatu kesalahan, di bawah mana-mana undang-undang, oleh suatu mahkamah di Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_63__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_63__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dia merupakan salah seorang dalam dapatan pelanggaran suatu larangan yang telah ditentukan oleh Suruhanjaya Persaingan di bawah Akta Persaingan 2010;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_63__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_63__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dia merupakan seorang bankrap atau tidak solven;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_63__subsec_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_63__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "selain daripada pegawai awam Perkhidmatan Kehakiman dan Perundangan yang dilantik di bawah perenggan 63(2)(a), dia merupakan seorang pegawai awam atau anggota pentadbiran;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_63__subsec_3__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_63__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dia merupakan seorang anggota Dewan Negara atau Dewan Rakyat atau mana-mana Dewan Undangan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_63__subsec_3__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_63__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dia merupakan orang berdaftar atau mempunyai kepentingan dalam mana-mana orang berdaftar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_63__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_63",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang anggota Tribunal Rayuan hendaklah memegang jawatan selama tempoh tidak melebihi tiga tahun dan hendaklah layak untuk dilantik semula apabila habis tempoh jawatannya, tetapi tidak boleh dilantik bagi lebih daripada dua tempoh berturut-turut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_63__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_63__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_63__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_63",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_63__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_63__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "“kepentingan” termasuklah suatu kepentingan secara langsung atau tidak langsung dengan sendirinya, melalui anggota keluarganya atau sekutunya, dan mana-mana pemunya benefisialnya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_63__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_63__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "“anggota keluarganya” dan “sekutu” mempunyai erti yang sama sebagaimana dalam perenggan 37(6)(a) dan 37(6)(b) masing-masing. Peletakan jawatan dan pembatalan pelantikan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_64",
      "@type": "akn:clause",
      "eli:number": "64",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_64__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_64__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_64__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_64",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengerusi atau mana-mana anggota lain Tribunal Rayuan boleh, pada bila-bila masa, meletakkan jawatannya dengan memberikan notis secara bertulis kepada Menteri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X__cl_64__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
