        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_52",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_53",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_54",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_55",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_56",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_57",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_58",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_59",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_60"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "PENYIASATAN DAN PENGUATKUASAAN Pemberikuasaan pegawai awam"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_45",
      "@type": "akn:clause",
      "eli:number": "45",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_45__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_45__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_45__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_45__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_45",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Setiausaha Perbendaharaan atau pihak berkuasa kewangan Negeri, mengikut mana-mana yang berkenaan, boleh, secara bertulis, memberi kuasa kepada mana-mana pegawai awam di bawah bidang kuasanya untuk menjalankan kuasa penyiasatan dan penguatkuasaan di bawah Akta ini berkenaan dengan perolehan Kerajaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_45__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_45",
      "schema:text": {
        "@language": "ms",
        "@value": "Maka hendaklah dikeluarkan kepada setiap pegawai diberi kuasa suatu kad kuasa yang ditandatangani oleh Ketua Setiausaha Perbendaharaan atau pihak berkuasa kewangan Negeri, mengikut mana-mana yang berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_45__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_45",
      "schema:text": {
        "@language": "ms",
        "@value": "Bilamana pegawai diberi kuasa itu menjalankan mana-mana kuasa di bawah Akta ini, dia hendaklah apabila diminta mengemukakan kepada orang yang terhadapnya kuasa itu sedang dijalankan kad kuasa yang dikeluarkan kepadanya di bawah subseksyen (2). Kuasa penyiasatan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_46",
      "@type": "akn:clause",
      "eli:number": "46",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pegawai diberi kuasa hendaklah mempunyai segala kuasa yang perlu untuk menjalankan suatu penyiasatan setelah menerima apa-apa aduan atau laporan, atau setelah apa-apa ketidakpatuhan di bawah Akta ini atau syak bahawa mana-mana kesalahan telah dilakukan berhubung dengan perolehan Kerajaan di bawah Akta ini. Penggeledahan dan penyitaan dengan waran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_47",
      "@type": "akn:clause",
      "eli:number": "47",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_47__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_47__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_47__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_47__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_47__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_47__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_47__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_47__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_47__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_47__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika ternyata pada seseorang Majistret, berdasarkan maklumat bertulis dengan bersumpah daripada seseorang pegawai diberi kuasa dan selepas apa-apa siasatan sebagaimana yang difikirkan perlu oleh Majistret itu, bahawa terdapat sebab yang munasabah untuk mempercayai bahawa—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_47__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_47__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana premis telah digunakan atau akan digunakan bagi; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_47__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_47__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "terdapat di dalam mana-mana premis keterangan yang perlu untuk menjalankan suatu penyiasatan mengenai, pelakuan suatu kesalahan berhubung dengan mana-mana perolehan Kerajaan di bawah Akta ini, Majistret boleh mengeluarkan suatu waran yang memberi kuasa kepada mana-mana pegawai diberi kuasa yang dinamakan dalam waran itu, untuk memasuki premis itu pada bila-bila masa yang munasabah pada waktu siang atau malam, dan dengan atau tanpa bantuan, dan jika perlu secara paksa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_47__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_47__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_47__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_47__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan keluasan subseksyen (1), suatu waran yang dikeluarkan oleh Majistret boleh memberi kuasa kepada pegawai diberi kuasa untuk—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_47__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_47__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menggeledah dan menyita apa-apa rekod, buku, akaun, dokumen, data berkomputer atau benda lain atau apa-apa bahan atau benda yang merupakan hal perkara perolehan Kerajaan yang sedang disiasat, yang mengandungi atau dengan munasabahnya dipercayai mengandungi maklumat atau dapat memberikan keterangan mengenai pelakuan kesalahan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_47__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_47__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "membuat salinan atau mengambil cabutan daripada apa-apa rekod, buku, akaun, dokumen, data berkomputer atau benda lain; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_47__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_47__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "mengambil sampel apa-apa bahan atau benda yang merupakan hal perkara perolehan Kerajaan yang sedang disiasat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_47__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pegawai diberi kuasa yang menjalankan suatu penggeledahan di bawah subseksyen (1) boleh, bagi maksud menyiasat kesalahan itu, memeriksa mana-mana orang yang berada di dalam atau di premis itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_47__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pegawai diberi kuasa yang membuat pemeriksaan terhadap seseorang di bawah subseksyen (3) boleh menyita, atau mengambil milikan, dan menyimpan dalam jagaan selamat semua benda, selain pakaian yang perlu, yang dijumpai pada orang itu, dan apa-apa benda lain, yang baginya ada sebab untuk mempercayai bahawa benda itu merupakan peralatan atau keterangan lain bagi kesalahan itu, dan benda itu boleh ditahan sehingga orang itu dilepaskan atau dibebaskan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_47__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh diperiksa kecuali oleh seseorang lain yang sama jantina, dan pemeriksaan sedemikian hendaklah dijalankan dengan penuh kesopanan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_47__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika, oleh sebab sifat, saiz atau amaunnya, adalah tidak praktik untuk memindahkan apa-apa rekod, buku, akaun, dokumen, data berkomputer atau benda lain atau apa-apa bahan atau benda yang merupakan hal perkara perolehan Kerajaan yang sedang disiasat yang disita di bawah seksyen ini, pegawai diberi kuasa yang membuat penyitaan itu hendaklah, dengan apa-apa cara, mengelak rekod, buku, akaun, dokumen, data berkomputer atau benda lain atau apa-apa bahan atau benda yang merupakan hal perkara perolehan Kerajaan yang sedang disiasat itu di dalam premis atau bekas yang di dalamnya ia dijumpai."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_47__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_47",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang, tanpa kuasa yang sah, memecahkan, mengusik atau merosakkan lak yang disebut dalam subseksyen (6) atau memindahkan apa-apa rekod, buku, akaun, dokumen, data berkomputer atau benda lain atau apa-apa bahan atau benda yang merupakan hal perkara perolehan Kerajaan yang sedang disiasat yang dilak atau cuba untuk berbuat demikian melakukan suatu kesalahan. Penggeledahan dan penyitaan tanpa waran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_48",
      "@type": "akn:clause",
      "eli:number": "48",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika seseorang pegawai diberi kuasa berpuas hati atas maklumat yang diterima bahawa dia mempunyai sebab yang munasabah untuk mempercayai bahawa oleh sebab kelengahan dalam memperoleh suatu waran geledah di bawah seksyen 47, penyiasatan akan terjejas atau keterangan mengenai pelakuan sesuatu kesalahan mungkin diganggu, dipindahkan, dirosakkan atau dimusnahkan, pegawai diberi kuasa itu boleh memasuki premis itu dan menjalankan di dalam, pada dan berkenaan dengan premis itu semua kuasa yang disebut dalam seksyen 47 dengan cara yang sepenuhnya dan secukupnya seolah-olah dia diberi kuasa untuk berbuat demikian oleh suatu waran yang dikeluarkan di bawah seksyen itu. Waran boleh diterima walaupun cacat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_49",
      "@type": "akn:clause",
      "eli:number": "49",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu waran geledah yang dikeluarkan di bawah Akta ini adalah sah dan boleh dikuatkuasakan walau apa pun apa-apa kecacatan, kesilapan atau peninggalan dalam waran geledah itu atau dalam permohonan bagi waran itu dan apa-apa rekod, buku, akaun, dokumen, data berkomputer atau benda lain atau apa-apa bahan atau benda yang merupakan hal perkara perolehan Kerajaan yang sedang disiasat yang disita di bawah waran itu hendaklah boleh diterima sebagai keterangan dalam mana-mana prosiding di bawah Akta ini. Akses kepada data berkomputer"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_50",
      "@type": "akn:clause",
      "eli:number": "50",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_50__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_50__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_50__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_50",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pegawai diberi kuasa yang menjalankan suatu penggeledahan di bawah Akta ini hendaklah diberikan akses kepada data berkomputer sama ada disimpan dalam suatu komputer atau selainnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_50__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_50",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini, pegawai diberi kuasa hendaklah diberi kata laluan, kod penyulitan, kod penyahsulitan, perisian atau perkakasan yang perlu dan apa-apa cara lain yang dikehendaki untuk membolehkan pemahaman data berkomputer itu. Senarai benda yang disita"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_51",
      "@type": "akn:clause",
      "eli:number": "51",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_51__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_51__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_51__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_51",
      "schema:text": {
        "@language": "ms",
        "@value": "Kecuali sebagaimana yang diperuntukkan dalam subseksyen (2), jika apa-apa rekod, buku, akaun, dokumen, data berkomputer atau benda lain atau apa-apa bahan atau benda yang merupakan hal perkara perolehan Kerajaan yang sedang disiasat disita di bawah Bahagian ini, pegawai diberi kuasa yang melakukan penyitaan itu hendaklah dengan secepat yang dapat dilaksanakan menyediakan senarai rekod, buku, akaun, dokumen, data berkomputer atau benda lain atau apa-apa bahan atau benda yang merupakan hal perkara perolehan Kerajaan yang sedang disiasat yang disita itu dan dengan segera menyerahkan salinan senarai itu yang ditandatangani olehnya kepada penghuni premis yang telah digeledah itu, atau kepada ejen atau pekhidmatnya, di premis itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_51__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_51",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika premis itu tidak berpenghuni, pegawai diberi kuasa yang melakukan penyitaan itu hendaklah di mana-mana mungkin menampalkan senarai benda yang disita itu di tempat yang mudah dilihat di premis itu. Pelepasan benda yang disita"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_52",
      "@type": "akn:clause",
      "eli:number": "52",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_52__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_52__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_52__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_52",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika apa-apa rekod, buku, akaun, dokumen, data berkomputer atau benda lain atau apa-apa bahan atau benda yang merupakan hal perkara perolehan Kerajaan yang sedang disiasat telah disita di bawah Akta ini, pegawai diberi kuasa yang melakukan penyitaan itu, boleh pada bila-bila masa selepas itu melepaskan rekod, buku, akaun, dokumen, data berkomputer atau benda lain atau apa-apa bahan atau benda yang merupakan hal perkara perolehan Kerajaan yang sedang disiasat yang disita itu kepada orang yang ditentukan olehnya sebagai berhak secara sah kepada rekod, buku, akaun, dokumen, data berkomputer atau benda lain atau apa-apa bahan atau benda yang merupakan hal perkara perolehan Kerajaan yang sedang disiasat yang disita itu jika dia berpuas hati bahawa rekod, buku, akaun, dokumen, data berkomputer atau benda lain atau apa-apa bahan atau benda yang merupakan hal perkara perolehan Kerajaan yang sedang disiasat yang disita itu tidak boleh dilucuthakkan di bawah Akta ini dan tidak dikehendaki selainnya bagi maksud mana-mana prosiding di bawah Akta ini, atau bagi maksud apa-apa pendakwaan di bawah mana-mana undang-undang bertulis yang lain, dan dalam hal sedemikian, pegawai diberi kuasa yang melakukan penyitaan itu, Kerajaan atau mana-mana orang yang bertindak bagi pihak Kerajaan, tidak boleh dikenakan apa-apa prosiding oleh mana-mana orang jika penyitaan dan pelepasan rekod, buku, akaun, dokumen, data berkomputer atau benda lain atau apa-apa bahan atau benda yang merupakan hal perkara perolehan Kerajaan yang sedang disiasat yang disita itu telah dibuat dengan suci hati."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_52__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_52",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu rekod secara bertulis hendaklah dibuat oleh pegawai diberi kuasa yang melakukan pelepasan apa-apa rekod, buku, akaun, dokumen, data berkomputer atau benda lain atau apa-apa bahan atau benda yang merupakan hal perkara perolehan Kerajaan yang sedang disiasat di bawah subseksyen (1) yang menyatakan secara terperinci hal keadaan, dan sebab bagi, pelepasan itu, dan dia hendaklah menghantar salinan rekod itu kepada Pendakwa Raya dalam masa tujuh hari daripada pelepasan itu. Pelucuthakan benda yang disita"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_53",
      "@type": "akn:clause",
      "eli:number": "53",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_53__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_53__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_53__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_53__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_53__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_53__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_53__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_53__subsec_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_53__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_53",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa rekod, buku, akaun, dokumen, data berkomputer atau benda lain atau apa-apa bahan atau benda yang merupakan hal perkara perolehan Kerajaan yang sedang disiasat yang disita pada menjalankan apa-apa kuasa yang diberikan di bawah Akta ini boleh dilucuthakkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_53__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_53",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu perintah bagi pelucuthakan atau bagi pelepasan apa-apa rekod, buku, akaun, dokumen, data berkomputer atau benda lain atau apa-apa bahan atau benda yang merupakan hal perkara perolehan Kerajaan yang sedang disiasat yang disita hendaklah dibuat jika dibuktikan sehingga memuaskan hati mahkamah bahawa suatu kesalahan di bawah Akta ini telah dilakukan dan bahawa rekod, buku, akaun, dokumen, data berkomputer atau benda lain atau apa-apa bahan atau benda yang merupakan hal perkara perolehan Kerajaan yang sedang disiasat yang disita itu adalah hal perkara atau telah digunakan dalam pelakuan kesalahan itu, walaupun tiada seorang pun telah disabitkan atas kesalahan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_53__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_53",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika tiada pendakwaan berkenaan dengan apa-apa rekod, buku, akaun, dokumen, data berkomputer atau benda lain atau apa-apa bahan atau benda yang merupakan hal perkara perolehan Kerajaan yang sedang disiasat yang disita di bawah Akta ini, rekod, buku, akaun, dokumen, data berkomputer atau benda lain atau apa-apa bahan atau benda yang merupakan hal perkara perolehan Kerajaan yang sedang disiasat itu hendaklah dikira dan disifatkan terlucut hak apabila habis tempoh satu bulan kalendar dari tarikh penyampaian notis kepada alamat terakhir orang yang daripadanya rekod, buku, akaun, dokumen, data berkomputer atau benda lain atau apa-apa bahan atau benda yang merupakan hal perkara perolehan Kerajaan yang sedang disiasat itu yang telah disita yang menyatakan bahawa tidak ada pendakwaan berkenaan dengan rekod, buku, akaun, dokumen, data berkomputer atau benda lain atau apa-apa bahan atau benda yang merupakan hal perkara perolehan Kerajaan yang sedang disiasat itu melainkan jika sebelum habis tempoh itu suatu tuntutan dibuat mengikut cara yang dinyatakan dalam subseksyen (4), (5), (6) dan (7)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_53__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_53",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang menegaskan bahawa dia ialah pemunya rekod, buku, akaun, dokumen, data berkomputer atau benda lain atau apa-apa bahan atau benda yang merupakan hal perkara perolehan Kerajaan yang sedang disiasat yang disebut dalam subseksyen (3) dan bahawa benda itu tidak boleh dilucuthakkan, boleh, secara sendiri atau melalui ejennya yang diberi kuasa secara bertulis, memberikan notis bertulis kepada pegawai diberi kuasa yang dalam milikannya rekod, buku, akaun, dokumen, data berkomputer atau benda lain atau apa-apa bahan atau benda yang merupakan hal perkara perolehan Kerajaan yang sedang disiasat itu dipegang bahawa dia menuntut rekod, buku, akaun, dokumen, data berkomputer atau benda lain atau apa-apa bahan atau benda yang merupakan hal perkara perolehan Kerajaan yang sedang disiasat yang akan dilucuthakkan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_53__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_53",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila menerima notis yang disebut dalam subseksyen (4), pegawai diberi kuasa itu hendaklah merujuk tuntutan itu kepada seorang Majistret bagi keputusannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_53__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_53",
      "schema:text": {
        "@language": "ms",
        "@value": "Seorang Majistret yang kepadanya perkara itu dirujuk di bawah subseksyem (5) hendaklah mengeluarkan suatu saman yang menghendaki orang yang menegaskan bahawa dia ialah pemunya rekod, buku, akaun, dokumen, data berkomputer atau benda lain atau apa-apa bahan atau benda yang merupakan hal perkara perolehan Kerajaan yang sedang disiasat yang hendak dilucuthakkan itu dan orang yang daripadanya benda yang hendak dilucuthakkan itu disita supaya hadir di hadapannya, dan apabila mereka hadir atau gagal untuk hadir, selepas dibuktikan bahawa saman itu telah disampaikan dengan sewajarnya, Majistret itu hendaklah meneruskan pemeriksaan perkara itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_53__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_53",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika dibuktikan bahawa suatu kesalahan di bawah Akta ini telah dilakukan dan bahawa rekod, buku, akaun, dokumen, data berkomputer atau benda lain atau apa-apa bahan atau benda yang merupakan hal perkara perolehan Kerajaan yang sedang disiasat yang disebut dalam subseksyen (6) merupakan hal perkara atau telah digunakan dalam pelakuan kesalahan itu, Majistret hendaklah memerintahkan supaya rekod, buku, akaun, dokumen, data berkomputer atau benda lain atau apa-apa bahan atau benda yang merupakan hal perkara perolehan Kerajaan yang sedang disiasat itu dilucuthakkan, dan hendaklah, jika tidak dibuktikan sedemikian, memerintahkan supaya benda itu dilepaskan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_53__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_53",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa rekod, buku, akaun, dokumen, data berkomputer atau benda lain atau apa-apa bahan atau benda yang merupakan hal perkara perolehan Kerajaan yang sedang disiasat yang dilucuthakkan atau disifatkan telah dilucuthakkan hendaklah diserahkan kepada pegawai diberi kuasa dan hendaklah dilupuskan mengikut apa-apa cara sebagaimana yang pegawai diberi kuasa fikirkan patut. Hak harta mengenai benda yang dilucuthakkan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_54",
      "@type": "akn:clause",
      "eli:number": "54",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa rekod, buku, akaun, dokumen, data berkomputer atau benda lain atau apa-apa bahan atau benda yang merupakan hal perkara perolehan Kerajaan yang sedang disiasat, yang dilucuthakkan atau disifatkan terlucut hak di bawah Akta ini hendaklah menjadi harta Kerajaan Persekutuan. Tiada kos atau ganti rugi yang berbangkit daripada penyitaan boleh didapatkan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_55",
      "@type": "akn:clause",
      "eli:number": "55",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh, dalam apa-apa prosiding di hadapan mana-mana mahkamah berkenaan dengan apa-apa rekod, buku, akaun, dokumen, data berkomputer atau benda lain atau apa-apa bahan atau benda yang merupakan hal perkara perolehan Kerajaan yang sedang disiasat yang disita dalam menjalankan atau yang berupa sebagai menjalankan mana-mana kuasa yang diberikan di bawah Akta ini, berhak kepada kos prosiding itu atau apa-apa ganti rugi atau relief lain melainkan jika penyitaan itu dibuat tanpa sebab yang munasabah. Kuasa untuk menghendaki kehadiran orang yang mempunyai pengetahuan tentang kes"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_56",
      "@type": "akn:clause",
      "eli:number": "56",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_56__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_56__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_56__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_56",
      "schema:text": {
        "@language": "ms",
        "@value": "Seorang pegawai diberi kuasa yang membuat suatu penyiasatan di bawah Akta ini boleh, melalui arahan secara bertulis, menghendaki mana-mana orang yang pada pendapat pegawai diberi kuasa itu mempunyai pengetahuan tentang fakta dan hal keadaan kes itu supaya hadir di hadapannya, dan orang itu hendaklah hadir sebagaimana yang dikehendaki."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_56__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_56",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana orang sedemikian enggan atau tidak hadir sebagaimana yang dikehendaki oleh suatu perintah yang dibuat di bawah subseksyen (1), pegawai diberi kuasa itu boleh melaporkan keengganan atau ketidakhadiran itu kepada Majistret yang hendaklah mengeluarkan suatu waran untuk memastikan kehadiran orang itu sebagaimana yang dikehendaki oleh perintah itu. Pemeriksaan orang yang mempunyai pengetahuan tentang kes"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_57",
      "@type": "akn:clause",
      "eli:number": "57",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_57__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_57__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_57__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_57__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_57__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_57__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_57",
      "schema:text": {
        "@language": "ms",
        "@value": "Seorang pegawai diberi kuasa yang membuat suatu penyiasatan di bawah Akta ini boleh memeriksa secara lisan mana-mana orang yang dikatakan mempunyai pengetahuan fakta dan hal keadaan kes itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_57__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_57",
      "schema:text": {
        "@language": "ms",
        "@value": "Orang yang diperiksa di bawah subseksyen (1) itu adalah terikat di sisi undang-undang untuk menjawab semua soalan yang berhubungan dengan kes itu yang diajukan kepadanya oleh pegawai diberi kuasa itu, tetapi orang itu boleh enggan menjawab mana-mana soalan yang jawapannya berkecenderungan mendedahkannya kepada suatu pertuduhan jenayah atau penalti atau pelucuthakan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_57__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_57",
      "schema:text": {
        "@language": "ms",
        "@value": "Seorang yang membuat pernyataan di bawah seksyen ini adalah terikat di sisi undang-undang untuk menyatakan yang benar, sama ada pernyataan itu dibuat keseluruhannya atau sebahagiannya bagi menjawab soalan-soalan itu atau tidak."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_57__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_57",
      "schema:text": {
        "@language": "ms",
        "@value": "Pegawai diberi kuasa yang memeriksa seseorang di bawah subseksyen (1) hendaklah terlebih dahulu memaklumkan orang itu mengenai peruntukan subseksyen (2) dan (3)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_57__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_57__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_57__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_57",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu pernyataan yang dibuat oleh mana-mana orang di bawah seksyen ini hendaklah, bilamana mungkin, diubah ke dalam bentuk bertulis dan ditandatangani oleh orang yang membuatnya atau dilekatkan dengan cap jarinya, mengikut mana-mana yang berkenaan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_57__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_57__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "selepas pernyataan itu dibacakan kepadanya dalam bahasa yang dalamnya pernyataan itu dibuat olehnya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_57__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_57__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "selepas dia diberi peluang untuk membuat apa-apa pembetulan yang ingin dibuat olehnya. Kebolehterimaan pernyataan sebagai keterangan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_58",
      "@type": "akn:clause",
      "eli:number": "58",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_58__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_58__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_58__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_58__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_58__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_58",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana orang dipertuduh atas suatu kesalahan di bawah Akta ini, apa-apa pernyataan, sama ada pernyataan itu terjumlah kepada suatu pengakuan atau tidak atau sama ada pernyataan itu dibuat secara lisan atau bertulis, dibuat pada bila-bila masa, sama ada sebelum atau selepas orang itu dituduh dan sama ada dalam penjalanan suatu penyiasatan di bawah Akta ini atau tidak dan sama ada atau tidak ada secara keseluruhannya atau sebahagiannya sebagai jawapan kepada soalan atau tidak, oleh orang itu kepada atau dengan didengar oleh seorang pegawai diberi kuasa dan sama ada diterjemahkan kepadanya atau tidak oleh seorang pegawai lain atau orang lain, hendaklah diterima sebagai keterangan dalam perbicaraannya dan, jika orang yang dipertuduh itu mengemukakan dirinya sebagai seorang saksi, mana-mana pernyataan sedemikian boleh digunakan semasa pemeriksaan balas dan bagi maksud mencabar kebolehpercayaannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_58__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_58__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_58__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_58",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada pernyataan di bawah subseksyen (1) boleh diterima atau digunakan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_58__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_58__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "jika pembuatan pernyataan itu pada hemat mahkamah telah disebabkan oleh apa-apa dorongan, ugutan atau janji yang berkaitan dengan pertuduhan terhadap orang itu yang datang daripada seseorang yang berkuasa dan cukup, pada pendapat mahkamah, untuk memberi orang yang dipertuduh itu alasan yang pada pendapatnya munasabah untuk mengandaikan bahawa dengan membuat pernyataan itu dia akan mendapat apa-apa kelebihan atau mengelakkan apa-apa durjana keduniaan berkenaan dengan prosiding terhadapnya; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_58__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_58__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal suatu pernyataan yang dibuat oleh orang itu selepas penangkapannya, melainkan jika mahkamah berpuas hati bahawa dia telah diberi amaran dengan perkataan seperti yang berikut atau perkataan yang mempunyai maksud yang sama: “Adalah menjadi kewajipan saya untuk memberikan amaran kepada kamu bahawa kamu tidak diwajibkan untuk menyatakan apa-apa atau menjawab apa-apa soalan, tetapi apa-apa yang kamu nyatakan, sama ada sebagai jawapan kepada suatu soalan atau tidak, boleh diberikan sebagai keterangan.”."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_58__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_58",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu pernyataan yang dibuat oleh seseorang sebelum ada kesempatan untuk memberikan amaran kepadanya tidak boleh menjadikan pernyataan itu tidak boleh diterima sebagai keterangan hanya semata-mata kerana orang itu tidak diberi amaran jika dia diberi amaran secepat yang dapat dilaksanakan selepas itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_58__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_58",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun apa-apa jua yang berlawanan yang terkandung dalam mana-mana undang-undang bertulis, seseorang yang dipertuduh atas suatu kesalahan yang baginya subseksyen (1) terpakai tidaklah terikat untuk menjawab apa-apa soalan yang berhubungan dengan kes itu selepas apa-apa amaran yang disebut dalam perenggan (2)(b) telah diberikan kepadanya. Galangan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_59",
      "@type": "akn:clause",
      "eli:number": "59",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_59__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_59__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_59__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_59__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_59__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_59__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII",
      "schema:name": {
        "@language": "ms",
        "@value": "Mana-mana orang yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_59__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_59",
      "schema:text": {
        "@language": "ms",
        "@value": "mengamang, melengahkan, merintangi, menghalang atau menggalang mana-mana pegawai diberi kuasa dalam membuat apa-apa kemasukan yang pegawai diberi kuasa itu berhak membuatnya di bawah Akta ini atau dalam melaksanakan apa-apa kewajipan yang dikenakan atau kuasa yang diberikan oleh Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_59__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_59",
      "schema:text": {
        "@language": "ms",
        "@value": "memecahkan apa-apa lak yang telah dipasang oleh seseorang pegawai diberi kuasa di mana-mana premis atau tempat;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_59__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_59",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak mematuhi apa-apa tuntutan sah oleh seorang pegawai diberi kuasa dalam pelaksanaan kuasa dan kewajipannya di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_59__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_59",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak, enggan atau abai untuk memberi apa-apa maklumat, keterangan atau dokumen yang dikehendaki dengan munasabahnya oleh seseorang pegawai diberi kuasa;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_59__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_59",
      "schema:text": {
        "@language": "ms",
        "@value": "tanpa alasan yang munasabah tidak menunjukkan apa-apa rekod, buku, akaun, dokumen, data berkomputer atau benda lain atau apa-apa bahan atau benda yang merupakan hal perkara perolehan Kerajaan yang sedang disiasat yang dikehendaki oleh seorang pegawai diberi kuasa; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_59__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_59",
      "schema:text": {
        "@language": "ms",
        "@value": "memberikan apa-apa maklumat, keterangan atau dokumen yang dia mengetahui atau mempunyai sebab untuk mempercayai adalah palsu atau mengelirukan, sebagai respons kepada suatu arahan yang dikeluarkan oleh pegawai diberi kuasa, melakukan suatu kesalahan. Pemusnahan, penyembunyian, pencacatan dan pengubahan rekod"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_60",
      "@type": "akn:clause",
      "eli:number": "60",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_60__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_60__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII",
      "schema:name": {
        "@language": "ms",
        "@value": "Mana-mana orang yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_60__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_60",
      "schema:text": {
        "@language": "ms",
        "@value": "memusnahkan, menyembunyikan, mencacatkan atau mengubah; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_60__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VIII__cl_60",
      "schema:text": {
        "@language": "ms",
        "@value": "menghantar atau cuba untuk menghantar atau berkomplot dengan mana-mana orang lain untuk memindahkan dari premisnya atau menghantar ke luar Malaysia, apa-apa rekod, buku, akaun, dokumen, data berkomputer atau benda lain atau apa-apa bahan atau benda yang merupakan hal perkara perolehan Kerajaan yang sedang disiasat yang disimpan atau disenggarakan dengan niat untuk memfraud Perbendaharaan atau pihak berkuasa kewangan Negeri, mengikut mana-mana yang berkenaan, Pendaftar atau mana-mana entiti perolehan, atau untuk menyekat, melengahkan atau menggalang penjalanan suatu penyiasatan atau penjalanan apa-apa kuasa oleh Perbendaharaan atau pihak berkuasa kewangan Negeri, mengikut mana-mana yang berkenaan, atau Pendaftar di bawah Akta ini melakukan suatu kesalahan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_39__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_39__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_39__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_39__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_39__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Setiausaha Perbendaharaan atau pihak berkuasa kewangan Negeri, mengikut mana-mana yang berkenaan, hendaklah mempunyai kuasa am untuk memantau pematuhan Akta ini dan apa-apa arahan, pekeliling atau garis panduan yang dikeluarkan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_39__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_39__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_39__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_39__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_39__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_39__subsec_2__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud subseksyen (1), Ketua Setiausaha Perbendaharaan hendaklah mempunyai kuasa yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_39__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_39__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menjalankan kajian semula dan pemeriksaan ke atas apa-apa tatacara perolehan Kerajaan oleh mana-mana entiti perolehan di bawah bidang kuasanya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_39__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_39__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menjalankan pemeriksaan ke atas mana-mana orang berdaftar berhubung dengan mana-mana perolehan Kerajaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_39__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_39__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menjalankan siasatan ke atas apa-apa aduan atau bantahan terhadap mana-mana entiti perolehan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_39__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_39__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengkaji semula pentadbiran aduan dan bantahan oleh mana-mana entiti perolehan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_39__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_39__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk melakukan apa-apa perkara yang perlu atau suai manfaat bagi memberikan kuat kuasa penuh kepada peruntukan Akta ini dan apa-apa arahan, pekeliling atau garis panduan yang dikeluarkan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_39__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud subseksyen (1), pihak berkuasa kewangan Negeri hendaklah mempunyai kuasa di bawah perenggan (2)(a), (c), (d) dan (e)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_39__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_39",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Setiausaha Perbendaharaan atau pihak berkuasa kewangan Negeri, mengikut mana-mana yang berkenaan, boleh melantik apa-apa bilangan pegawai awam Perbendaharaan atau kementerian atau jabatan sesuatu Negeri yang dipertanggungkan dengan tanggungjawab bagi kewangan, mengikut mana-mana yang berkenaan, sebagai pegawai pemantauan dengan kuasa untuk memantau pematuhan di bawah Bahagian ini. Pemantauan pematuhan oleh pegawai pengawal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_40",
      "@type": "akn:clause",
      "eli:number": "40",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_40__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_40__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_40__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_40__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_40__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_40__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_40__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_40",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pegawai pengawal hendaklah bertanggungjawab—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_40__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_40__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menyelia pegawai perolehan di bawah penyeliaannya dan memastikan pematuhan mereka kepada Akta ini dan apa-apa arahan, pekeliling atau garis panduan yang dikeluarkan di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_40__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_40__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk melaksanakan dan mentadbir tatacara aduan yang ditetapkan dan mengkaji semula mana-mana aduan terhadap entiti perolehan di bawah bidang kuasanya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_40__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_40__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menjalankan apa-apa aktiviti dan membuat apa-apa perkara yang perlu, berfaedah dan patut bagi pentadbiran Akta ini, atau bagi apa-apa maksud lain yang selaras dengan Akta ini sebagaimana yang diarahkan oleh Ketua Setiausaha Perbendaharaan atau pihak berkuasa kewangan Negeri, mengikut mana-mana yang berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_40__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_40",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pegawai pengawal boleh menyatakan takat mana tanggungjawab yang dikenakan kepadanya di bawah seksyen ini boleh dijalankan atau dilaksanakan bagi pihaknya oleh mana-mana pegawai awam di bawah bidang kuasanya dan memberi apa-apa arahan sebagaimana yang perlu untuk memastikan penjalanan atau pelaksanaan tanggungjawab tersebut dengan sepatutnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_40__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_40",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (2), seseorang pegawai pengawal hendaklah bertanggungjawab bagi tanggungjawabnya di bawah subseksyen (1). Kuasa untuk menghendaki maklumat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_41",
      "@type": "akn:clause",
      "eli:number": "41",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_41__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_41__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_41__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Setiausaha Perbendaharaan atau pihak berkuasa kewangan Negeri, mengikut mana-mana yang berkenaan, atau mana-mana pegawai pemantauan boleh, melalui notis secara bertulis, menghendaki mana-mana orang yang mentadbir, menjalankan atau melaksanakan perolehan Kerajaan untuk memberikan apa-apa penjelasan, maklumat, dokumen atau rekod yang berhubungan dengan perolehan Kerajaan yang ditadbir, dijalankan atau dilaksanakan dalam tempoh dan dalam bentuk dan cara yang dinyatakan dalam notis secara bertulis itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_41__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_41",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang dikehendaki untuk memberikan penjelasan, maklumat, dokumen atau rekod di bawah subseksyen (1) hendaklah memastikan bahawa penjelasan, maklumat, dokumen atau rekod yang diberikan adalah benar, tepat dan lengkap dan orang itu hendaklah memberikan suatu representasi nyata yang bermaksud sedemikian, termasuk suatu perisytiharan bahawa dia tidak tahu tentang apa-apa maklumat lain yang mungkin dapat menjadikan penjelasan, maklumat, dokumen atau rekod yang diberikan itu palsu atau mengelirukan. Kuasa untuk menghendaki laporan penilaian pematuhan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_42",
      "@type": "akn:clause",
      "eli:number": "42",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud melaksanakan kuasa di bawah Bahagian ini, Ketua Setiausaha Perbendaharaan atau pihak berkuasa kewangan Negeri, mengikut mana-mana yang berkenaan, boleh, sama ada secara am atau bagi suatu perolehan Kerajaan tertentu, menghendaki seseorang pegawai pengawal untuk mengemukakan suatu laporan penilaian pematuhan yang hendaklah mengandungi maklumat yang berhubungan dengan pematuhan kepada Akta ini dan apa-apa arahan, pekeliling atau garis panduan yang dikeluarkan di bawah Akta ini oleh entiti perolehan di bawah seliaannya. Tindakan berdasarkan dapatan laporan penilaian pematuhan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_43",
      "@type": "akn:clause",
      "eli:number": "43",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_43__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_43__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_43__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Setiausaha Perbendaharaan atau pihak berkuasa kewangan Negeri, mengikut mana-mana yang berkenaan, boleh, selepas menerima laporan penilaian pematuhan yang dikemukakan di bawah seksyen 42, mengkaji semula dan menilai laporan itu dan merekodkan dapatannya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_43__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_43__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_43__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_43",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika Ketua Setiausaha Perbendaharaan atau pihak berkuasa kewangan Negeri, mengikut mana-mana yang berkenaan, berpuas hati bahawa, berdasarkan dapatannya, terdapat alasan yang munasabah untuk mempercayai bahawa suatu ketidakpatuhan atau pelanggaran Akta ini telah atau mungkin telah berlaku, tindakan yang berikut boleh diambil:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_43__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_43__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal suatu ketidakpatuhan mana-mana arahan, pekeliling atau garis panduan oleh mana-mana pegawai pengawal atau pegawai perolehan, Perbendaharaan atau pihak berkuasa kewangan Negeri, mengikut mana-mana yang berkenaan, boleh mengesyorkan tindakan terhadap pegawai tersebut mengikut undang-undang bertulis yang berkaitan yang berhubungan dengan perkhidmatan awam; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_43__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_43__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal suatu perlanggaran Akta ini, Perbendaharaan atau pihak berkuasa kewangan Negeri, mengikut mana-mana yang berkenaan, boleh menyiasat kesalahan-kesalahan dan mengambil tindakan mengikut Akta ini. Kewajipan untuk melaporkan kepada agensi penguatkuasaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_44",
      "@type": "akn:clause",
      "eli:number": "44",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_44__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_44__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_44__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_44",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang mentadbir, menjalankan atau melaksanakan apa-apa perolehan Kerajaan hendaklah melaporkan kepada agensi penguatkuasaan yang berkaitan sekiranya orang itu menyedari pelakuan apa-apa kesalahan yang berhubungan dengan rasuah, persaingan atau apa-apa kesalahan lain di bawah mana-mana undang-undang bertulis sebagaimana yang ditentukan oleh Ketua Setiausaha Perbendaharaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_44__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VII__cl_44",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud subseksyen (1), adalah mencukupi bagi seorang pegawai perolehan untuk melaporkan secara bertulis kepada pegawai pengawalnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37",
      "@type": "akn:clause",
      "eli:number": "37",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang mentadbir, menjalankan atau melaksanakan perolehan Kerajaan yang mempunyai apa-apa kepentingan secara langsung atau tidak langsung dengan sendirinya, anggota keluarganya atau sekutunya dalam apa-apa perkara dalam suatu perolehan Kerajaan hendaklah menzahirkan fakta dan jenis kepentingan termasuk mana-mana pemunyaan benefisial."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang membuat suatu permohonan bagi pendaftaran atau mana-mana orang berdaftar yang membuat permohonan bagi pembaharuan atau pindaan suatu pendaftaran di bawah seksyen 18 hendaklah menzahirkan kepada Pendaftar—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa kepentingan secara langsung atau tidak langsung dengan sendirinya, anggota keluarganya atau sekutunya berhubungan dengan mana-mana orang berdaftar yang lain atau orang yang memohon suatu pendaftaran di bawah seksyen 18; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pemunya benefisial kepada mana-mana orang yang membuat suatu permohonan atau mana-mana orang berdaftar tersebut, mengikut mana-mana yang berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "Obligasi di bawah subseksyen (2) hendaklah terpakai bagi—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal suatu syarikat, pengarah, pemegang syer dan pengurusan kanan syarikat;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal suatu perkongsian, semua pekongsi dalam perkongsian itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal suatu koperasi, mana-mana orang yang memegang tanggungjawab utama dalam pengurusan koperasi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang berdaftar yang menyertai atau berniat untuk menyertai suatu perolehan Kerajaan di bawah Akta ini hendaklah menzahirkan kepada entiti perolehan yang bertanggungjawab bagi perolehan Kerajaan itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana pemunya benefisial orang berdaftar itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_4__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_4__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa kepentingan sama ada secara langsung atau tidak langsung, dengan sendirinya, melalui anggota keluarganya atau sekutunya berhubung dengan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_4__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_4__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang berdaftar yang lain, sama ada atau tidak orang berdaftar yang lain itu menyertai atau berniat untuk menyertai perolehan Kerajaan tersebut; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_4__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_4__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang di bawah bidang kuasa entiti perolehan yang terlibat dalam penjalanan perolehan Kerajaan tersebut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar seksyen ini melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi dua ratus dan lima puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi lima tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_6__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_6__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_6__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_6__para_a__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_6__para_a__subpara_iv",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_6__para_a__subpara_v"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "“anggota keluarganya”, berhubungan dengan seseorang, ahli lembaga perolehan atau ahli jawatankuasa perolehan, termasuklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_6__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_6__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "suami atau isterinya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_6__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_6__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "ibu atau bapanya, termasuk ibu atau bapa suami atau isterinya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_6__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_6__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "anaknya, termasuk anak angkat atau anak tiri;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_6__para_a__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_6__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "adik-beradiknya, termasuk adik-beradik suami atau isterinya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_6__para_a__subpara_v",
      "@type": "akn:subparagraph",
      "eli:number": "v",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_6__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "suami atau isteri anaknya, atau adik-beradiknya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_6__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_6__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_6__para_b__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_6__para_b__subpara_iv",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_6__para_b__subpara_v",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_6__para_b__subpara_vi"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "“sekutu”, berhubung dengan seseorang, ahli lembaga perolehan atau ahli jawatankuasa perolehan, ertinya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_6__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_6__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang yang merupakan penama atau pekerja orang itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_6__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_6__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "firma yang seseorang itu atau mana-mana penamanya merupakan seorang pekongsi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_6__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_6__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "pekongsi kepada seseorang itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_6__para_b__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_6__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "pemegang amanah sesuatu amanah yang di bawahnya seseorang itu atau seorang anggota keluarganya ialah seorang pemunya benefisial;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_6__para_b__subpara_v",
      "@type": "akn:subparagraph",
      "eli:number": "v",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_6__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana perbadanan mengikut pengertian Akta Syarikat Labuan 1990 atau Akta Syarikat 2016, mengikut mana-mana yang berkenaan, yang seseorang itu atau mana-mana penamanya atau seseorang anggota keluarganya ialah seorang pengarah atau mempunyai pemegangan syer substansial; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_6__para_b__subpara_vi",
      "@type": "akn:subparagraph",
      "eli:number": "vi",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_37__subsec_6__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal suatu koperasi, termasuklah mana-mana orang yang memegang tanggungjawab utama dalam pengurusan koperasi itu. Larangan terhadap campur tangan dalam perolehan Kerajaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_38",
      "@type": "akn:clause",
      "eli:number": "38",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_38__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_38__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_38__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_38__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_38",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada seorang pun boleh, secara langsung atau tidak langsung, campur tangan dalam atau, secara intimidasi, pengaruh tidak wajar atau dengan apa-apa cara lain mengganggu, suatu perolehan aktif yang boleh atau berkemungkinan boleh menjadi bercanggah dengan proses perolehan di bawah Akta ini atau apa-apa arahan, pekeliling atau garis panduan yang dikeluarkan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_38__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_38",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar seksyen ini melakukan satu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi lima ratus ribu ringgit atau penjara tidak melebihi lima tahun atau kedua-duanya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_38__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_38__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_38__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_38",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_38__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_38__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "“perolehan aktif” ertinya suatu tempoh dari tarikh kelulusan untuk memulakan perolehan Kerajaan diberikan oleh pegawai pengawal sehingga tarikh surat setuju terima telah ditandatangani oleh pihak-pihak;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_38__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_VI__cl_38__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "“surat setuju terima” ertinya suatu surat rasmi yang dikeluarkan oleh entiti perolehan yang memaklumkan penyetujuterimaan tanpa syarat oleh Kerajaan ke atas tawaran yang dikemukakan oleh orang berdaftar yang berjaya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_V__cl_28",
      "@type": "akn:clause",
      "eli:number": "28",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_V__cl_28__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_V__cl_28__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_V__cl_28__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_V__cl_28__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_V__cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada peruntukan Akta ini, kaedah perolehan terbuka dan berdaya saing hendaklah menjadi kaedah utama dalam menjalankan perolehan Kerajaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_V__cl_28__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_V__cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (1), Menteri boleh menetapkan kaedah selain daripada kaedah perolehan terbuka dan berdaya saing mengambil kira objektif Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_V__cl_28__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_V__cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini, “kaedah perolehan terbuka dan berdaya saing” ertinya kaedah perolehan apabila semua orang berdaftar boleh mengambil bahagian. Dasar dan langkah-langkah khusus dalam perolehan Kerajaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_V__cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun peruntukan Akta ini, Menteri atau, berhubung dengan sesuatu Negeri, Menteri Besar atau Ketua Menteri, mengikut mana-mana yang berkenaan, boleh, jika dia mempertimbangkannya demi kepentingan negara atau negeri untuk berbuat sedemikian, melaksanakan apa-apa dasar atau langkah-langkah dalam perolehan Kerajaan bagi mendorong, menggalakkan, merangsang atau memudahkan pembangunan sosial, ekonomi dan alam sekitar di Malaysia atau mana-mana Negeri tertentu, mengikut mana-mana yang berkenaan. Tatacara khusus semasa tempoh keterdesakan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_V__cl_30",
      "@type": "akn:clause",
      "eli:number": "30",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh menetapkan tatacara bagi apa-apa perolehan Kerajaan semasa tempoh keterdesakan yang menghendaki tindakan serta-merta demi kepentingan ketenteraman, kesihatan atau keselamatan awam. Peruntukan bagi pelaksanaan obligasi antarabangsa"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_V__cl_31",
      "@type": "akn:clause",
      "eli:number": "31",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh menetapkan kaedah dan tatacara bagi perolehan Kerajaan sebagaimana yang dikehendaki atau perlu bagi melaksanakan obligasi yang berbangkit daripada perjanjian antarabangsa yang kepadanya Malaysia menjadi suatu pihak. Sijil Perolehan Demi Kepentingan Awam"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_V__cl_32",
      "@type": "akn:clause",
      "eli:number": "32",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_V__cl_32__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_V__cl_32__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_V__cl_32__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_V__cl_32",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu entiti perolehan boleh mengeluarkan Sijil Perolehan Demi Kepentingan Awam yang mengisytiharkan mana-mana perolehan Kerajaan dalam bidang kuasanya sebagai penting oleh sebab kepentingan awam dan tidak boleh dilengahkan atau digantung oleh apa-apa bantahan atau rayuan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_V__cl_32__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_V__cl_32",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh menetapkan syarat dan tatacara bagi pengeluaran Sijil Perolehan Demi Kepentingan Awam di bawah seksyen ini. Kontrak perolehan Kerajaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_V__cl_33",
      "@type": "akn:clause",
      "eli:number": "33",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu kontrak perolehan Kerajaan antara entiti perolehan dengan orang berdaftar hendaklah dibuat mengikut bentuk dan cara dan tertakluk kepada apa-apa terma dan syarat sebagaimana yang ditetapkan oleh Menteri. Pentadbiran kontrak perolehan Kerajaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_V__cl_34",
      "@type": "akn:clause",
      "eli:number": "34",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Cara penyelesaian pertikaian berhubung dengan pentadbiran kontrak perolehan Kerajaan hendaklah sebagaimana yang ditetapkan oleh Menteri. Larangan pemindahan pemberian atau kontrak perolehan Kerajaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_V__cl_35",
      "@type": "akn:clause",
      "eli:number": "35",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_V__cl_35__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_V__cl_35__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_V__cl_35__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_V__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada mana-mana orang berdaftar boleh memindahkan, menyerahhakkan atau membuat novasi dalam apa-apa cara suatu pemberian atau kontrak yang diawardkan di bawah Akta ini, sepenuhnya atau sebahagiannya, atau apa-apa kepentingan dalam suatu pemberian atau kontrak yang diawardkan di bawah Akta ini kepada mana-mana orang dalam apa-apa cara tanpa kelulusan pegawai pengawal yang bertanggungjawab bagi perolehan Kerajaan itu terlebih dahulu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_V__cl_35__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_V__cl_35",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang berdaftar yang melanggar subseksyen (1) melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak kurang daripada tiga kali nilai pemberian atau kontrak yang diawardkan di bawah Akta ini atau satu juta ringgit, mengikut yang mana-mana yang lebih tinggi, atau dipenjarakan selama tempoh tidak melebihi lima tahun atau kedua-duanya. Sistem berkomputer bagi pentadbiran perolehan Kerajaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_V__cl_36",
      "@type": "akn:clause",
      "eli:number": "36",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh menetapkan penggunaan apa-apa sistem berkomputer bagi pentadbiran dan penjalanan perolehan Kerajaan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_X",
