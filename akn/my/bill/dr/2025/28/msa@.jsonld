      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa dana yang diuntukkan mengikut Akta Perbekalan oleh Parlimen, termasuk mana-mana kumpulan wang luar jangka;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I__cl_5__subsec_1__list_7__para_a__subpara_ii",
