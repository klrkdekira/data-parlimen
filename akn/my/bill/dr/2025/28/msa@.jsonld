        "@language": "ms",
        "@value": "dalam hal sesuatu Kerajaan Negeri—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_I__cl_5__subsec_1__list_7__para_b__subpara_i",
