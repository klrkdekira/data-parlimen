      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa hasil atau pulangan yang diperoleh daripada mana-mana pelaburan mana-mana dana di bawah subperenggan (a)(i) hingga (a)(iv); atau"
      }
    },
    {
