      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_XII__cl_89",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa mengehadkan keluasan subseksyen (1), Menteri boleh membuat peraturan-peraturan berhubung dengan semua atau mana-mana perkara yang berikut:"
      }
    },
    {
