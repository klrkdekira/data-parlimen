      "schema:text": {
        "@language": "ms",
        "@value": "KELULUSAN DALAM PEROLEHAN KERAJAAN Pihak berkuasa yang meluluskan dalam perolehan Kerajaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_10__subsec_2",
