      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_10__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_10__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_10__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_10__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada subseksyen (2), suatu kelulusan bagi perolehan Kerajaan di bawah Akta ini boleh diberikan oleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_10__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_10__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri atau, berhubung dengan sesuatu Negeri, Menteri Besar atau Ketua Menteri atau mana-mana pihak berkuasa lain sebagaimana yang ditentukan oleh Kerajaan Negeri, mengikut mana-mana yang berkenaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_10__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_10__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "lembaga perolehan yang ditubuhkan di bawah seksyen 11;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_10__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_10__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "jawatankuasa yang ditubuhkan oleh pegawai pengawal di bawah perenggan 7(1)(f); atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_10__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_10__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pegawai pengawal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Nilai ambang kelulusan bagi setiap pihak berkuasa yang meluluskan di bawah subseksyen (1) hendaklah sebagaimana yang dinyatakan dalam Jadual Pertama."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_10__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (2), Menteri Besar atau Ketua Menteri, mengikut mana-mana yang berkenaan, boleh menentukan nilai ambang kelulusan bagi perolehan Kerajaan Negeri, yang hendaklah tidak melebihi nilai ambang kelulusan yang dinyatakan dalam Jadual Pertama bagi setiap pihak berkuasa yang meluluskan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_10__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh menetapkan tatacara bagi kelulusan dalam perolehan Kerajaan. Penubuhan lembaga perolehan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_11__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_11__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_11__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri atau, berhubung dengan sesuatu Negeri, Menteri Besar atau Ketua Menteri, mengikut mana-mana yang berkenaan, boleh, melalui pemberitahuan dalam Warta—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_11__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_11__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menubuhkan suatu lembaga perolehan bagi tiap-tiap Kementerian atau, kementerian atau jabatan sesuatu Negeri, mengikut mana-mana yang berkenaan; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_11__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_11__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "atas permintaan pegawai pengawal Kementerian atau, kementerian atau jabatan sesuatu Negeri, mengikut mana- mana yang berkenaan, menubuhkan lembaga perolehan tambahan bagi maksud khusus yang Menteri, Menteri Besar atau Ketua Menteri, mengikut mana-mana yang berkenaan, fikirkan perlu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_11__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_11__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Lembaga perolehan yang ditubuhkan di bawah seksyen ini hendaklah terdiri daripada pegawai awam—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_11__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_11__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal suatu Kementerian atau kementerian atau jabatan sesuatu Negeri, sebagaimana yang dinyatakan dalam butiran 1 Jadual Kedua; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_11__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_11__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal Kementerian Kewangan, sebagaimana yang dinyatakan dalam butiran 2 Jadual Kedua. Kelulusan oleh lembaga perolehan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_9"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu lembaga perolehan yang ditubuhkan di bawah seksyen 11 hendaklah menimbangkan dan meluluskan semua perolehan Kerajaan mengikut nilai ambang kelulusan yang dinyatakan dalam Jadual Pertama."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Kuorum bagi tiap-tiap mesyuarat lembaga perolehan hendaklah tidak kurang daripada tiga termasuk pengerusi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada mana-mana orang selain ahli lembaga perolehan boleh hadir atau mengambil bahagian dalam mesyuarat lembaga perolehan melainkan jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dia merupakan anggota urus setia lembaga perolehan yang dinamai oleh pegawai pengawal; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dia merupakan pegawai awam yang diundang oleh pengerusi bagi maksud menasihati lembaga perolehan bagi apa-apa perkara yang sedang dipertimbang teliti."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pegawai awam yang diundang di bawah perenggan (3)(b) tidak berhak mengundi atau hadir semasa sesuatu keputusan dibuat oleh lembaga perolehan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang ahli lembaga perolehan yang mempunyai secara langsung atau tidak langsung, dengan sendirinya, anggota keluarganya atau sekutunya, apa-apa kepentingan dalam apa-apa perkara yang sedang dibincangkan oleh lembaga perolehan hendaklah menzahirkan kepada lembaga perolehan fakta dan jenis kepentingan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_6__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_6__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu penzahiran di bawah subseksyen (5) hendaklah direkodkan dalam minit mesyuarat dan selepas penzahiran itu, ahli yang mempunyai kepentingan dalam perkara itu—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak boleh hadir atau mengambil bahagian semasa mana-mana pertimbangtelitian atau keputusan lembaga perolehan mengenai perkara itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "tidak boleh dikira bagi maksud membentuk kuorum suatu mesyuarat bagi pertimbangtelitian atau keputusan mengenai perkara itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_6__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_6",
      "schema:text": {
        "@language": "ms",
        "@value": "jika ahli yang mempunyai kepentingan itu ialah pengerusi lembaga perolehan, hendaklah menarik diri dan digantikan oleh pengerusi ganti yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada tindakan atau prosiding lembaga perolehan boleh ditidaksahkan atas alasan bahawa mana-mana ahli lembaga perolehan telah melanggar peruntukan seksyen ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika lembaga perolehan gagal mencapai keputusan sebulat suara dalam apa-apa perkara yang dipertimbang teliti dalam mesyuarat, lembaga perolehan hendaklah merujuk perkara itu kepada Menteri atau, berhubung dengan sesuatu Negeri, Menteri Besar atau Ketua Menteri atau apa-apa pihak berkuasa lain sebagaimana yang ditentukan oleh Kerajaan Negeri, mengikut mana-mana yang berkenaan, bagi suatu keputusan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_9__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_9__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_9__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_9__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_9__para_a__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_9__para_a__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_9__para_a__subpara_iv",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_9__para_a__subpara_v"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_9",
      "schema:text": {
        "@language": "ms",
        "@value": "“anggota keluarganya” termasuklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_9__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_9__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "suami atau isterinya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_9__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_9__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "ibu atau bapanya, termasuk ibu atau bapa suami atau isterinya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_9__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_9__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "anaknya, termasuk anak angkat atau anak tiri;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_9__para_a__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_9__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "adik-beradiknya, termasuk adik-beradik suami atau isterinya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_9__para_a__subpara_v",
      "@type": "akn:subparagraph",
      "eli:number": "v",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_9__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "suami atau isteri anaknya, atau adik-beradiknya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_9__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_9__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_9__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_9__para_b__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_9__para_b__subpara_iv",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_9__para_b__subpara_v"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_9",
      "schema:text": {
        "@language": "ms",
        "@value": "“sekutu” ertinya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_9__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_9__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "orang yang merupakan penama atau pekerja ahli itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_9__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_9__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "firma yang ahli itu atau mana-mana penamanya merupakan seorang pekongsi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_9__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_9__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "pekongsi ahli itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_9__para_b__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_9__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "pemegang amanah sesuatu amanah yang di bawahnya ahli itu atau seorang anggota keluarganya ialah seorang benefisiari; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_9__para_b__subpara_v",
      "@type": "akn:subparagraph",
      "eli:number": "v",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_12__subsec_9__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana perbadanan mengikut pengertian Akta Syarikat Labuan 1990 atau Akta Syarikat 2016, mengikut mana-mana yang berkenaan, yang ahli itu atau mana-mana penamanya atau seseorang anggota keluarganya ialah seorang pengarah atau mempunyai pemegangan syer yang substansial. Kelulusan oleh Menteri, Menteri Besar, Ketua Menteri, dsb."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_13__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_13__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_13__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_13__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_13__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri atau, berhubung dengan sesuatu Negeri, Menteri Besar atau Ketua Menteri atau mana-mana pihak berkuasa lain sebagaimana yang ditentukan oleh Kerajaan Negeri, mengikut mana-mana yang berkenaan, hendaklah menimbangkan dan meluluskan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_13__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_13__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "semua perolehan Kerajaan mengikut nilai ambang kelulusan yang dinyatakan dalam Jadual Pertama; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_13__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_13__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana perolehan Kerajaan yang dirujuk kepada Menteri atau, berhubung dengan sesuatu Negeri, Menteri Besar atau Ketua Menteri atau mana-mana pihak berkuasa lain sebagaimana yang ditentukan oleh Kerajaan Negeri, mengikut mana-mana yang berkenaan, oleh lembaga perolehan di bawah subseksyen 12(8)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_13__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_13__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Sebelum memberikan kelulusan bagi sesuatu perolehan Kerajaan, Menteri atau, berhubung dengan sesuatu Negeri, Menteri Besar atau Ketua Menteri atau mana-mana pihak berkuasa lain sebagaimana yang ditentukan oleh Kerajaan Negeri, mengikut mana-mana yang berkenaan, hendaklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_13__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_13__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal perenggan (1)(a), menghendaki lembaga perolehan yang bertanggungjawab bagi dana yang diuntukkan bagi perolehan Kerajaan itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_13__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_13__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal perenggan (1)(b), menghendaki lembaga perolehan yang merujuk perolehan Kerajaan untuk keputusan itu, untuk menimbang perolehan Kerajaan itu mengikut Akta ini dan mengemukakan suatu syor kepada Menteri atau, berhubung dengan sesuatu Negeri, Menteri Besar atau Ketua Menteri atau mana-mana pihak berkuasa lain sebagaimana yang ditentukan oleh Kerajaan Negeri, mengikut mana-mana yang berkenaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_13__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Selepas menimbangkan syor yang dikemukakan di bawah subseksyen (2), Menteri atau, berhubung dengan sesuatu Negeri, Menteri Besar atau Ketua Menteri atau mana-mana pihak berkuasa lain sebagaimana yang ditentukan oleh Kerajaan Negeri, mengikut mana-mana yang berkenaan, boleh bersetuju dengan syor itu atau boleh membuat keputusan berlainan yang difikirkannya patut."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_13__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_III__cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa keputusan yang dibuat oleh Menteri atau, berhubung dengan sesuatu Negeri, Menteri Besar atau Ketua Menteri atau mana-mana pihak berkuasa lain sebagaimana yang ditentukan oleh Kerajaan Negeri, mengikut mana-mana yang berkenaan, adalah muktamad dan hendaklah dilaksanakan sewajarnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_6__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_6__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_6__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Setiausaha Perbendaharaan hendaklah bertanggungjawab bagi pentadbiran, kawalan dan pengawasan semua perkara yang berhubungan dengan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Setiausaha Perbendaharaan boleh mewakilkan mana-mana kuasa, kewajipan atau fungsinya di bawah Akta ini, selain kuasa di bawah seksyen 14, 26 dan 45, kepada mana-mana pegawai di bawah bidang kuasanya tertakluk kepada apa-apa syarat, had atau sekatan yang difikirkannya patut, dan hendaklah memberikan apa-apa arahan sebagaimana yang perlu untuk memastikan penjalanan atau pelaksanaan kuasa, kewajipan dan fungsi itu yang sepatutnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa pewakilan di bawah seksyen ini tidaklah menghalang Ketua Setiausaha Perbendaharaan sendiri daripada menjalankan atau melaksanakan pada bila-bila masa apa-apa kuasa, kewajipan atau fungsi yang diwakilkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_6__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Setiausaha Perbendaharaan hendaklah menjalankan usaha wajar dan mengadakan proses dan tatacara secukupnya bagi mengelakkan percanggahan kepentingan semasa menjalankan kuasanya, menunaikan kewajipannya dan melaksanakan fungsinya di bawah Akta ini dan mengikut apa-apa arahan atau pekeliling yang dikeluarkan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_6__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Setiausaha Perbendaharaan hendaklah menjalankan semua aktiviti dan membuat semua perkara yang perlu atau berfaedah dan patut bagi pentadbiran Akta ini, atau bagi apa-apa maksud lain yang selaras dengan Akta ini sebagaimana yang diarahkan oleh Menteri mengikut Akta ini. Kewajipan dan kuasa pegawai pengawal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_7__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_7__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_7__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_7__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_7__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_7__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_7__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_7__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_7__subsec_1__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_7__subsec_1__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_7__subsec_1__para_i"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Seorang pegawai pengawal hendaklah mempunyai kewajipan dan kuasa yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_7__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk bertanggungjawab bagi setiap tindakan dan keputusan yang dibuat berhubung dengan perolehan Kerajaan yang ditadbir, dijalankan atau dilaksanakan dalam bidang kuasanya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_7__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menyelia pegawai perolehan dan jawatankuasa perolehan di bawah seliaannya dan memantau pematuhan mereka kepada Akta ini dan apa-apa arahan atau pekeliling yang dikeluarkan di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_7__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menjalankan usaha wajar dan mengadakan tatacara secukupnya bagi mengelakkan percanggahan kepentingan semasa menjalankan kuasanya, menunaikan kewajipannya dan melaksanakan fungsinya di bawah Akta ini dan mengikut apa-apa arahan atau pekeliling yang dikeluarkan di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_7__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mentadbir, menjalankan atau melaksanakan apa-apa perolehan Kerajaan yang perancangan dan anggaran peruntukan dananya telah disediakan dan diluluskan oleh Kerajaan Persekutuan atau Kerajaan Negeri, mengikut mana-mana yang berkenaan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_7__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menimbangkan dan meluluskan perolehan Kerajaan mengikut Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_7__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menamai atau melantik pegawai perolehan dan menubuhkan jawatankuasa perolehan untuk membantu pegawai pengawal dalam melaksanakan apa-apa kewajipan dan penjalanan kuasanya di bawah Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_7__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menyatakan takat kewajipan dan kuasa yang diberikan atau dikenakan kepadanya di bawah Akta ini yang boleh dijalankan atau dilaksanakan bagi pihaknya oleh pegawai perolehan atau jawatankuasa perolehan, mengikut mana-mana yang berkenaan, mengikut Akta ini;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_7__subsec_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk mewujudkan panel kajian semula bagi mengendalikan aduan yang berhubungan dengan perolehan Kerajaan yang ditadbir, dijalankan atau dilaksanakan oleh entiti perolehan dalam bidang kuasanya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_7__subsec_1__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_7__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menjalankan segala aktiviti dan membuat segala perkara yang perlu atau berfaedah dan patut bagi pentadbiran Akta ini, atau bagi apa-apa maksud lain yang selaras dengan Akta ini sebagaimana yang diarahkan oleh Ketua Setiausaha Perbendaharaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun perenggan (1)(g), pegawai pengawal hendaklah kekal bertanggungjawab bagi penjalanan atau pelaksanaan kewajipan dan kuasa oleh orang yang diberi kuasa itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_7__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Pegawai pengawal hendaklah bertanggungjawab bagi apa-apa kerugian yang ditanggung oleh Kerajaan yang berbangkit daripada kegagalannya untuk memastikan kewajipan dan kuasanya dijalankan dan dilaksanakan mengikut Akta ini dan apa-apa arahan atau pekeliling yang dikeluarkan di bawah Akta ini. Kewajipan dan kuasa pegawai perolehan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_8__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_8__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_8__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_8__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_8__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_8__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang pegawai pengawal—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_8__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_8__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal pelantikan di bawah seksyen 15a Akta Tatacara Kewangan 1957, boleh menamai apa-apa bilangan pegawai awam; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_8__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_8__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal pelantikan di bawah subseksyen 9(1), boleh melantik apa-apa bilangan orang, sebagai pegawai perolehan bagi maksud Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Pegawai pengawal boleh menyatakan takat kewajipan dan kuasa yang diberikan atau dikenakan kepadanya di bawah Akta ini yang boleh dijalankan atau dilaksanakan bagi pihaknya oleh mana-mana pegawai perolehan yang dinamai atau dilantik itu dan memberikan apa-apa arahan sebagaimana yang perlu untuk memastikan penjalanan atau pelaksanaan kewajipan dan kuasa tersebut dengan sepatutnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_8__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Pegawai perolehan hendaklah, setakat pemberikuasaan atau pelantikan yang diberikan kepadanya oleh pegawai pengawal mengikut subseksyen (2), mentadbir, menjalankan atau melaksanakan tiap-tiap perolehan Kerajaan mengikut Akta ini dan apa-apa arahan atau pekeliling yang dikeluarkan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_8__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (2), pegawai pengawal hendaklah kekal bertanggungjawab bagi penjalanan atau pelaksanaan kewajipan dan kuasa itu oleh pegawai perolehan yang diberi kuasa atau dilantik."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_8__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pegawai perolehan yang tidak mematuhi subseksyen (3) hendaklah bertanggungjawab bagi apa-apa kerugian yang ditanggung oleh Kerajaan yang berbangkit daripada kegagalannya. Pentadbiran perolehan Kerajaan oleh entiti perolehan selain Kementerian atau kementerian atau jabatan sesuatu Negeri"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_9__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_9__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu entiti perolehan selain Kementerian atau kementerian atau jabatan sesuatu Negeri hendaklah, tertakluk kepada tatacara dan undang-undang yang berhubungan dengan pemerbadanan atau pentadbiran entiti perolehan itu, melantik seseorang sebagai pegawai pengawal bagi entiti perolehan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri boleh menetapkan tatacara bagi pentadbiran, penjalanan dan pelaksanaan perolehan Kerajaan oleh entiti perolehan selain Kementerian atau kementerian atau jabatan sesuatu Negeri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_9__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_II__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini, “entiti perolehan selain Kementerian atau kementerian atau jabatan sesuatu Negeri” ertinya mana-mana badan berkanun Kerajaan Persekutuan atau Kerajaan Negeri, entiti Kerajaan Persekutuan, entiti Kerajaan Negeri, pihak berkuasa tempatan bagi Wilayah Persekutuan Kuala Lumpur, Labuan dan Putrajaya atau mana-mana pihak berkuasa tempatan dalam sesuatu Negeri yang mentadbir, menjalankan atau melaksanakan perolehan Kerajaan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/28/msa@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
