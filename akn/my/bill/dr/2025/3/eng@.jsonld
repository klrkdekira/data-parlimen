    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/3/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/3/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Supplementary Supply (2024) Act 2025. Additional expenditure for the year 2024"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/3/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/3/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The issue is hereby authorized of a sum not exceeding twenty billion one hundred and ninety-one million two hundred and ninety-nine thousand five hundred ringgit (RM20,191,299,500) from the Consolidated Fund for additional expenditure on the services and purposes specified in the Schedule for the year 2024 not provided for or not fully provided for by the Supply Act 2024 [Act A1697]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/3/eng@/~sched_1",
