      "schema:text": {
        "@language": "en",
        "@value": "Purpose Title B. 4 Election Commission B. 7 Public Service Department B. 11 Treasury General Services B. 12 Contribution to Statutory Funds B. 25 Ministry of Domestic Trade and Cost of Living B. 63 Ministry of Education B. 64 Ministry of Higher Education TOTAL"
      }
    }
