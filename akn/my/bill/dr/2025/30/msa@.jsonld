      "schema:name": {
        "@language": "ms",
        "@value": "RUU Perbekalan 2026"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/30/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/30/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Perbekalan 2026. Pengeluaran dan peruntukan untuk perkhidmatan bagi tahun 2026"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/30/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/30/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Pengeluaran sejumlah wang yang tidak melebihi dua ratus dua puluh sembilan bilion lapan puluh juta lapan ratus dua belas ribu tujuh ratus ringgit (RM229,080,812,700) daripada Kumpulan Wang Disatukan untuk perkhidmatan bagi tahun 2026 adalah dengan ini dibenarkan dan jumlah wang itu diperuntukkan bagi maksud-maksud yang dinyatakan dalam Jadual."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/30/msa@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/30/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Tajuk Parlimen Malaysia Pejabat Penyimpan Mohor Besar Raja-Raja Jabatan Audit Negara Suruhanjaya Pilihan Raya Suruhanjaya Perkhidmatan Awam Jabatan Perdana Menteri 5,368,727,300 Jabatan Perkhidmatan Awam Jabatan Peguam Negara Suruhanjaya Pencegahan Rasuah Malaysia Perbendaharaan 4,604,627,700 Perkhidmatan Am Perbendaharaan 38,244,751,700 Peruntukan Kepada Kumpulan Wang Terkanun 1,941,100,500 Kementerian Luar Negeri Kementerian Perpaduan Negara Kementerian Ekonomi Kementerian Perladangan dan Komoditi Kementerian Pertanian dan Keterjaminan 4,826,625,900 Makanan Kementerian Kemajuan Desa dan Wilayah 4,613,177,700 Kementerian Sumber Asli dan Kelestarian 1,495,439,200 Alam Kementerian Pelaburan, Perdagangan dan Industri Kementerian Perdagangan Dalam Negeri 2,091,273,800 dan Kos Sara Hidup Kementerian Pembangunan Usahawan dan Koperasi Kementerian Kerja Raya 1,084,692,100 Maksud Tajuk B. 28 Kementerian Pengangkutan B. 30 Kementerian Sains, Teknologi dan Inovasi B. 31 Kementerian Pelancongan, Seni dan Budaya B. 33 Kementerian Peralihan Tenaga dan Transformasi Air B. 40 Suruhanjaya Perkhidmatan Pendidikan B. 42 Kementerian Kesihatan B. 43 Kementerian Perumahan dan Kerajaan Tempatan B. 45 Kementerian Belia dan Sukan B. 46 Kementerian Sumber Manusia B. 47 Kementerian Komunikasi B. 48 Kementerian Pembangunan Wanita, Keluarga dan Masyarakat B. 50 Kementerian Digital B. 60 Kementerian Pertahanan B. 62 Kementerian Dalam Negeri B. 63 Kementerian Pendidikan B. 64 Kementerian Pendidikan Tinggi JUMLAH"
      }
