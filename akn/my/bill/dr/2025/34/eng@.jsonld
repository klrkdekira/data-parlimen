      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting the words “other than by way of skills training loan”. Amendment of section 5"
      }
    },
