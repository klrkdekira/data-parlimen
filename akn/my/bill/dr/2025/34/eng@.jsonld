      "schema:text": {
        "@language": "en",
        "@value": "Paragraph 35(a) of the principal Act is amended by substituting for the words “training programme” the words “skills training programme or other training programme”. Amendment of section 36"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/eng@/~cl_16",
