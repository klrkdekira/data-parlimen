      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/eng@/~cl_44",
      "@type": "akn:clause",
      "eli:number": "44",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/eng@/~cl_44__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/eng@/~cl_44__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/eng@/~cl_44__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/eng@/~cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "Any public officer or officer of the Corporation, who, immediately before the date of coming into operation of this Act, was appointed as an inspector under the principal Act shall, on the date of coming into operation of this Act, be deemed to have been duly authorized as an authorized officer and shall continue to exercise the powers and perform the functions conferred on an authorized officer under the principal Act as amended by this Act until his appointment is revoked or ceases to have effect."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/eng@/~cl_44__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/eng@/~cl_44",
      "schema:text": {
        "@language": "en",
        "@value": "Any act, direction or decision done, given or made, or any powers or functions exercised or performed, by an inspector under the principal Act before the date of coming into operation of this Act shall, in so far as it is consistent with the provisions of the principal Act as amended by this Act, be deemed to have been lawfully done, given or made, or exercised or performed, by an authorized officer."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/eng@/~cl_4__para_a",
      "@type": "akn:paragraph",
