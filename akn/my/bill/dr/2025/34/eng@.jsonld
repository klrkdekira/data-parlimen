    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/eng@/~cl_32__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/eng@/~cl_32",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the words “skills training loan” the words “or skills training financial assistance”;"
