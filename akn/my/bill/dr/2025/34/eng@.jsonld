    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/eng@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraph 24(4)(b) of the principal Act is amended by deleting the words “of the Corporation”. New section 25a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/eng@/~cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting after section 25 the following section: “Delegation of power and duties of Chief Executive 25a. (1) The Chief Executive may delegate in writing any of his powers or duties under this Act, except the power of delegation, subject to such conditions, limitations or restrictions as he thinks fit, to any officer of the Corporation. (2) Any powers or duties delegated under this section shall be performed or exercised by the officer of the Corporation in the name and on behalf of the Chief Executive. (3) A delegation made under this section shall not preclude the Chief Executive himself from performing or exercising any of the powers or duties so delegated.”. Amendment of section 33"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/eng@/~cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/eng@/~cl_14__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/eng@/~cl_14__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 33 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/eng@/~cl_14__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/eng@/~cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (1) the following subsection: “(1) No skills training provider may apply for a skills training loan or skills training financial assistance facility unless— (a) it is registered under this Part; and (b) it conducts an approved skills training programme.”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/eng@/~cl_14__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/eng@/~cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (2) the following subsection: “(2) A skills training provider shall not be registered under this Part unless the skills training provider conducts an approved skills training programme.”. Amendment of section 35"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/eng@/~cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
