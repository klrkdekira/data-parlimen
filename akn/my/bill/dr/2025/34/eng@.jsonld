      "schema:text": {
        "@language": "en",
        "@value": "in the shoulder note, by substituting for the words “approved training programmes” the words “approved skills training programmes”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/eng@/~cl_22__para_b",
