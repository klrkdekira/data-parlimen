      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (5), dengan menggantikan perkataan “permohonan pinjaman latihan kemahiran” dengan perkataan “permohonan bagi pinjaman latihan kemahiran atau bantuan kewangan latihan kemahiran”; dan"
      }
    },
