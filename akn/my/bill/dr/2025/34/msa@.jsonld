      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 72(1) Akta ibu dipinda dengan menggantikan perkataan “kemudahan pinjaman” dengan perkataan “kemudahan pinjaman latihan kemahiran atau bantuan kewangan latihan kemahiran”. Pindaan seksyen 74"
      }
    },
    {
