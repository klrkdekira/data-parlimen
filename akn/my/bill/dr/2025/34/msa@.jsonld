      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2), dengan menggantikan perkataan “perjanjian latihan kemahiran” dengan perkataan “perjanjian pinjaman latihan kemahiran atau bantuan kewangan latihan kemahiran”. Pindaan seksyen 53"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong takrif “inspektor”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan sebelum takrif “jawatankuasa” takrif yang berikut: ‘ “bantuan kewangan latihan kemahiran” ertinya apa-apa wang atau pemberian atau apa-apa bentuk bantuan kewangan lain yang diluluskan dan dibayar oleh Perbadanan kepada pelatih di bawah Akta ini bagi maksud latihan kemahiran atau latihan lain selain pinjaman latihan kemahiran;’;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_2__para_c",
