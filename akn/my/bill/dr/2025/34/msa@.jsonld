      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perenggan (e) dengan perenggan yang berikut: “(e) bahawa kelulusan pinjaman latihan kemahiran atau bantuan kewangan latihan kemahiran berkenaan dengan program latihan kemahiran atau program latihan lain itu telah dibatalkan di bawah seksyen 53;”; dan"
      }
    },
