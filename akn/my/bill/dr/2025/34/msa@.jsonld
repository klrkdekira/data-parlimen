      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1), dengan memasukkan selepas perkataan “pinjaman latihan kemahiran” perkataan “atau bantuan kewangan latihan kemahiran”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_29__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
