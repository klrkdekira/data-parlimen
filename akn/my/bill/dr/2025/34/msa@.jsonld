      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “Pinjaman latihan kemahiran” perkataan “atau bantuan kewangan latihan kemahiran”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_28__para_b__subpara_ii",
