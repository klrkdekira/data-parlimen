      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 46 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_22__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
