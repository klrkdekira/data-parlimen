        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_11__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 16 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_11__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1), dengan menggantikan perkataan “Lembaga Perbadanan” dengan perkataan “Lembaga Pengarah”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_11__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_11__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_11__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_11__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_11__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (c), dengan menggantikan perkataan “Ketua Pengarah Majlis Latihan Vokasional Kebangsaan” dengan perkataan “Ketua Pengarah Pembangunan Kemahiran”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_11__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_11__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan (e) perenggan yang berikut: “(ea) seorang wakil daripada Kementerian Sumber Manusia; (eb) seorang wakil daripada Kementerian Ekonomi;”. Pindaan seksyen 24"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan 24(4)(b) Akta ibu dipinda dengan memotong perkataan “Perbadanan”. Seksyen baharu 25a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memasukkan selepas seksyen 25 seksyen yang berikut: “Pewakilan kuasa dan kewajipan Ketua Eksekutif 25a. (1) Ketua Eksekutif boleh mewakilkan secara bertulis mana-mana kuasa atau kewajipannya di bawah Akta, kecuali kuasa pewakilan, tertakluk kepada apa-apa syarat, batasan atau sekatan yang difikirkannya patut, kepada mana-mana pegawai Perbadanan. (2) Mana-mana kuasa atau kewajipan yang diwakilkan di bawah seksyen ini hendaklah dilaksanakan atau dijalankan oleh pegawai Perbadanan atas nama dan bagi pihak Ketua Eksekutif. (3) Pewakilan yang dibuat di bawah seksyen ini tidaklah menghalang Ketua Eksekutif itu sendiri daripada melaksanakan atau menjalankan mana-mana kuasa atau kewajipan yang diwakilkan itu.”. Pindaan seksyen 33"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_14__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_14__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 33 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_14__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (1) dengan subseksyen yang berikut: “(1) Tiada penyedia latihan kemahiran boleh memohon bagi kemudahan pinjaman latihan kemahiran atau bantuan kewangan latihan kemahiran melainkan jika— (a) ia telah berdaftar di bawah Bahagian ini; dan (b) ia menjalankan program latihan kemahiran yang diluluskan.”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_14__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (2) dengan subseksyen yang berikut: “(2) Penyedia latihan kemahiran tidak boleh didaftarkan di bawah Bahagian ini melainkan jika penyedia latihan kemahiran itu menjalankan suatu program latihan kemahiran yang diluluskan.”. Pindaan seksyen 35"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan 35(a) Akta ibu dipinda dengan menggantikan perkataan “program latihan” dengan perkataan “program latihan kemahiran atau program latihan lain”. Pindaan seksyen 36"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_16__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_16__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 36 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_16__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (2) dengan subseksyen yang berikut: “(2) Perakuan pendaftaran hendaklah menyatakan premis utama di mana latihan kemahiran atau latihan lain yang disediakan oleh penyedia latihan kemahiran dijalankan.”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_16__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (5), dengan menggantikan perkataan “menyediakan latihan kemahiran” dengan perkataan “menyediakan latihan kemahiran atau latihan lain”. Pindaan seksyen 37"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_17__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_17__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_17__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 37(1) Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_17__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perenggan (a);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_17__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perenggan (b) dengan perengan yang berikut: “(b) penyedia latihan kemahiran tidak lagi menjalankan apa-apa program latihan kemahiran yang diluluskan;”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_17__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (c), dengan menggantikan perkataan “seksyen 34” dengan perkataan “seksyen 39”. Pindaan seksyen 38"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_18",
      "@type": "akn:clause",
