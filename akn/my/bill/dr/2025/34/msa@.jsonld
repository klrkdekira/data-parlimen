      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan 92(2)(a) Akta ibu dipinda dengan memasukkan selepas perkataan “pinjaman latihan kemahiran” perkataan “atau bantuan kewangan latihan kemahiran”. Pindaan Jadual"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_43",
