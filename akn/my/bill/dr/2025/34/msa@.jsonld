      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “program latihan” dengan perkataan “program latihan kemahiran atau program latihan lain”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_26__para_d__subpara_ii",
