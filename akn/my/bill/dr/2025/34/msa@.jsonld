      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif “Menteri” takrif yang berikut: ‘ “pegawai diberi kuasa” ertinya mana-mana pegawai awam atau pegawai Perbadanan yang diberi kuasa di bawah seksyen 71b;’:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_2__para_f",
