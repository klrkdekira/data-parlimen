      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong takrif “Majlis Latihan Vokasional Kebangsaan”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_2__para_e",
      "@type": "akn:paragraph",
