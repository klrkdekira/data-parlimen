        "@value": "dengan menomborkan semula seksyen sedia ada sebagai subseksyen (1);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_37__para_b",
