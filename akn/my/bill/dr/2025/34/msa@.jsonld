      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 38 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_18__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
