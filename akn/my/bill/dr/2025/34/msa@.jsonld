    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_44__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_44",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana pegawai awam atau pegawai Perbadanan, yang, sebaik sebelum tarikh Akta ini mula berkuat kuasa, telah dilantik sebagai seseorang inspektor di bawah Akta ibu hendaklah, pada tarikh permulaan kuat kuasa Akta ini, disifatkan sebagai telah diberikan kuasa sebagai pegawai diberi kuasa dan hendaklah terus menjalankan kuasa dan melaksanakan fungsi yang telah diberikan kepada seseorang pegawai diberi kuasa di bawah Akta ibu sebagaimana yang dipinda oleh Akta ini sehingga pelantikannya dibatalkan atau terhenti berkuat kuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_44__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_44",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa tindakan, arahan atau keputusan yang dilakukan, diberikan atau dibuat, atau apa-apa kuasa atau fungsi yang dijalankan atau dilaksanakan, oleh seseorang inspektor di bawah Akta ibu sebelum tarikh permulaan kuat kuasa Akta ini hendaklah, setakat yang ia selaras dengan peruntukan Akta ibu sebagaimana yang dipinda oleh Akta ini, disifatkan telah dilakukan, diberikan, dibuat, atau dijalankan atau dilaksanakan, seseorang pegawai diberi kuasa secara sah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “bantuan kewangan” dengan perkataan “bantuan kewangan latihan kemahiran”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan “selain dengan cara pinjaman latihan kemahiran”. Pindaan seksyen 5"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 5(4) Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “pinjaman latihan kemahiran” perkataan “dan bantuan kewangan latihan kemahiran,”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “bon dan sekuriti kerajaan” dengan perkataan “bon dan sekuriti Kerajaan”. Pindaan seksyen 8"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_6__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 8 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perenggan (a) dengan perenggan yang berikut: “(a) mengenal pasti dan meluluskan program latihan kemahiran atau program latihan lain yang layak bagi pinjaman latihan kemahiran atau bantuan kewangan latihan kemahiran;”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perenggan (b) dengan perenggan yang berikut: “(b) mengadakan dan memberikan pinjaman latihan kemahiran dan bantuan kewangan latihan kemahiran kepada pelatih, dan memberikan perkhidmatan dalam mentadbir, mengawas dan memungut pembayaran balik dan pemulangan balik pinjaman latihan kemahiran dan bantuan kewangan latihan kemahiran;”. Pindaan seksyen 9"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_7__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_7__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Perenggan 9(2)(c) Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_7__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “pinjaman latihan kemahiran” perkataan “dan bantuan kewangan latihan kemahiran”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_7__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “program latihan yang diluluskan” dengan perkataan “program latihan kemahiran yang diluluskan”. Pindaan seksyen 10"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_8__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_8__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_8__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Perenggan 10(2)(a) Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_8__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subperenggan (ii) dengan subperenggan yang berikut: “(ii) mana-mana bank berlesen atau bank pelaburan berlesen di bawah Akta Perkhidmatan Kewangan 2013 [Akta 758];”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_8__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan “atau” di hujung subperenggan (ii); dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_8__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subperenggan (ii) subperenggan yang berikut: “(iia) mana-mana bank Islam berlesen di bawah Akta Perkhidmatan Kewangan Islam 2013 [Akta 759]; (iib) mana-mana institusi yang ditetapkan di bawah Akta Institusi Kewangan Pembangunan 2002 [Akta 618]; atau”. Pindaan seksyen 11"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan 11(b) Akta ibu dipinda dengan menggantikan perkataan “Akta Syarikat 1965 [Akta 125]” dengan perkataan “Akta Syarikat 2016 [Akta 777]”. Pindaan seksyen 14"
      }
    }
  ]
}
