      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “program latihan yang diluluskan” dengan perkataan “program latihan kemahiran yang diluluskan”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_26__para_e",
      "@type": "akn:paragraph",
