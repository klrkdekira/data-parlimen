      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “program latihan kemahiran” dengan perkataan “atau program latihan lain”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_22__para_c__subpara_ii",
