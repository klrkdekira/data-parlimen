      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan takrif “program latihan yang diluluskan” dengan takrif yang berikut: ‘ “program latihan kemahiran yang diluluskan” ertinya suatu program latihan kemahiran atau program latihan lain yang dijalankan di Malaysia dan diluluskan oleh Perbadanan di bawah seksyen 44;’. Pindaan seksyen 3"
      }
    },
