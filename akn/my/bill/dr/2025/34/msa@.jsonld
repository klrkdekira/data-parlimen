      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_32",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “pinjaman latihan kemahiran” perkataan “atau bantuan kewangan latihan kemahiran”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_32__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
