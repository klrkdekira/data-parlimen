      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “menjalankan program latihan berkenaan” dengan perkataan “menjalankan program latihan kemahiran atau program latihan lain itu”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_22__para_d",
      "@type": "akn:paragraph",
