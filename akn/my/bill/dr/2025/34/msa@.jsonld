      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif “Ketua Eksekutif” takrif yang berikut: ‘ “Ketua Pengarah Pembangunan Kemahiran” ertinya Ketua Pengarah Pembangunan Kemahiran yang dilantik di bawah Akta Pembangunan Kemahiran Kebangsaan 2006 [Akta 652];’;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_2__para_d",
      "@type": "akn:paragraph",
