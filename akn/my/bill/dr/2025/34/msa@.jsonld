      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam takrif “pinjaman latihan kemahiran”, dengan memasukkan selepas perkataan “suatu pinjaman” perkataan “, dalam apa-apa jua bentuk atau dengan apa-apa jua namanya dipanggil,”; dan"
      }
    },
