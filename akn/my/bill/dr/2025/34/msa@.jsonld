      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan nota bahu dengan nota bahu yang berikut: “Permohonan bagi pinjaman latihan kemahiran atau bantuan kewangan latihan kemahiran”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_24__para_b",
      "@type": "akn:paragraph",
