      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2), dengan memasukkan selepas perkataan “pinjaman latihan kemahiran” perkataan “atau bantuan kewangan latihan kemahiran”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/34/msa@/~cl_24__para_d",
      "@type": "akn:paragraph",
