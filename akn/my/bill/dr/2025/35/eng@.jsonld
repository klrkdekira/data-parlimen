      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the National Skills Development (Amendment) Act 2025."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/35/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
