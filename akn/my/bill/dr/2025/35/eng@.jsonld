      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/35/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the definition of “curriculum” the following definition: ‘ “curriculum” means the content of an organized training programme conducted by a skills training provider based on the Standards indicating the activities to be undertaken, the time allotted to each activity, and their sequence;’;"
      }
    },
