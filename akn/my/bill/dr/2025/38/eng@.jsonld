      "schema:text": {
        "@language": "en",
        "@value": "Section 14 has effect for the year of assessment 2028 and subsequent years of assessment."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/38/eng@/~chp_II__cl_3__subsec_6",
