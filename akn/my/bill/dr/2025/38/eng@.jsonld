      "schema:text": {
        "@language": "en",
        "@value": "Sections 4, 7, 8, 9, 17 and 18, and subparagraphs 6(a)(i), (ii), (iii) and (iv) have effect for the year of assessment 2026 and subsequent years of assessment."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/38/eng@/~chp_II__cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/38/eng@/~chp_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "Subparagraph 6(a)(v) and paragraph 6(c) have effect for the year of assessment 2026."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/38/eng@/~chp_II__cl_3__subsec_3",
