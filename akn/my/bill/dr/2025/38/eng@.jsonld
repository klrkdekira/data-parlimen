      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/38/eng@/~chp_II",
      "schema:name": {
        "@language": "en",
        "@value": "Section 46 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/38/eng@/~chp_II__cl_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/38/eng@/~chp_II__cl_6__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/38/eng@/~chp_II__cl_6__para_a__subpara_ii",
