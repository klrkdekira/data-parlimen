      "schema:text": {
        "@language": "en",
        "@value": "Subparagraph 6(a)(vi) and paragraph 6(b) have effect for the years of assessment 2026 and 2027."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/38/eng@/~chp_II__cl_3__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/38/eng@/~chp_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "Sections 5, 10, 11, 12, 13 and 16 come into operation on 1 January 2026."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/38/eng@/~chp_II__cl_3__subsec_5",
      "@type": "akn:subsection",
