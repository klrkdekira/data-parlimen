      "schema:text": {
        "@language": "en",
        "@value": "in the shoulder note, by substituting for the words “chargeable income and tax payable” the words “chargeable income, tax payable, etc.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/39/eng@/~part_II__cl_4__para_b",
