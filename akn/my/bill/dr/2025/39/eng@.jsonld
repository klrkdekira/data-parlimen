      "schema:text": {
        "@language": "en",
        "@value": "Paragraphs 5(a) and (c) and subparagraph 5(b)(ii) come into operation on 1 January 2027."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/39/eng@/~part_II__cl_3__subsec_3",
