      "schema:text": {
        "@language": "en",
        "@value": "in subsection (2), by deleting the word “prescribed”. Amendment of section 6a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/39/eng@/~part_V__cl_34",
      "@type": "akn:clause",
      "eli:number": "34",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/39/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraph 6a(1)(a) of the principal Act is amended by substituting for the words “in the appropriate prescribed form” the words “in the form as determined by the Director General”. Amendment of section 10"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/39/eng@/~part_V__cl_35",
