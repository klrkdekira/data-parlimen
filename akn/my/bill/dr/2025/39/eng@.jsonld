      "schema:text": {
        "@language": "en",
        "@value": "Section 42 and paragraph 43(d) come into operation on 1 January 2026."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/39/eng@/~part_VI__cl_41__subsec_2",
