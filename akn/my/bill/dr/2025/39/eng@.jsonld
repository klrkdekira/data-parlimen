        "@value": "in subsection (4), by substituting for the words “A prescribed form furnished in accordance with subsection (3)” the words “The form as determined by the Director General in accordance with subsection (3) or (3a)”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/39/eng@/~part_V__cl_39__para_f",
