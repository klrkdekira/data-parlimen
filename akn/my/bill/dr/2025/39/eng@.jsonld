      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/39/eng@/~part_V__cl_33",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (1), by substituting for the words “in the prescribed form” the words “in the form as determined by the Director General”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/39/eng@/~part_V__cl_33__para_b",
      "@type": "akn:paragraph",
