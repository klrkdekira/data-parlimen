      "schema:text": {
        "@language": "en",
        "@value": "Section 4 has effect for the year of assessment 2027 and subsequent years of assessment."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/39/eng@/~part_II__cl_3__subsec_2",
