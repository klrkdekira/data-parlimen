    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "There shall be a Parliamentary Service Disciplinary Committee to exercise disciplinary control over the members of the Parliamentary Service."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_8__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_8__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_8__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_8__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_8__subsec_2__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "The Parliamentary Service Disciplinary Committee shall consist of the following members:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_8__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_8__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Deputy President of the Senate as a Chairman;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_8__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_8__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Deputy Speaker of the House of Representatives as a Co-Chairman;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_8__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_8__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Clerk to the Senate;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_8__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_8__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Clerk to the House of Representatives; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_8__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_8__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Legal Advisor of the Parliamentary Service."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_8__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "If any member of the Parliamentary Service Disciplinary Committee has a direct or indirect interest in any matter being considered by the Parliamentary Service Disciplinary Committee, the member of the Parliamentary Service Disciplinary Committee shall disclose to the Parliamentary Service Disciplinary Committee the fact of his interest and the nature of that interest."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_8__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "A disclosure under subsection (3) shall be recorded in the minutes of the meeting in which the disclosure was made and, after the disclosure, the member of the Parliamentary Service Disciplinary Committee shall not be present and take part in the deliberation or decision of the Parliamentary Service Disciplinary Committee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_8__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "Meetings of the Parliamentary Service Disciplinary Committee shall be co-chaired by the Deputy President of the Senate and the Deputy Speaker of the House of Representatives."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_8__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "Every member of the Parliamentary Service Disciplinary Committee present at the meeting shall be entitled to one vote."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_8__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "All questions raised in the meetings of the Parliamentary Service Disciplinary Committee shall be decided by the votes of the majority of members present and voting, and if the number of votes are equal, then the Chairman shall have the casting vote."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_8__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "The Yang di-Pertuan Agong may, after consultation with the Parliamentary Service Council, prescribe any matter relating to the disciplinary control of the members of the Parliamentary Service."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_8__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "The disciplinary control referred to in subsection (8) shall include interdiction, suspension, punishment and dismissal of the members of the Parliamentary Service. Parliamentary Service Appeal Committee"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_9__subsec_1",
