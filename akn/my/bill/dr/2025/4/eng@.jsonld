      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "There shall be a Parliamentary Service Appeal Committee to receive, consider and determine any appeal submitted by a member of the Parliamentary Service against the decision of the Parliamentary Service Promotion Committee and the Parliamentary Service Disciplinary Committee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
