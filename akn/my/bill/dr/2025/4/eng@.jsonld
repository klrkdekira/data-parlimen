      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Parliamentary Service Act 2025."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
