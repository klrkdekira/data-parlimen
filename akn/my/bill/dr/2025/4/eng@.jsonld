        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_3__subsec_2__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_3__subsec_2__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_3__subsec_2__para_k"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "The Parliamentary Service Council shall consist of the following members:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_3__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_3__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the President of the Senate as a Chairman;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_3__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_3__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Speaker of the House of Representatives as a Co-Chairman;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_3__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_3__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Deputy President of the Senate;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_3__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_3__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "two Deputy Speakers of the House of Representatives;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_3__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_3__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "two members of the Senate;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_3__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_3__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "four members of the House of Representatives;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_3__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_3__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Clerk to the Senate;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_3__subsec_2__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_3__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Clerk to the House of Representatives;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_3__subsec_2__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_3__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Secretary General of Treasury or his representative as an ex-officio member;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_3__subsec_2__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_3__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Director General of Public Service or his representative as an ex-officio member; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_3__subsec_2__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_3__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Chief Administrator of Parliament as an ex-officio member. Functions and powers of Parliamentary Service Council"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
