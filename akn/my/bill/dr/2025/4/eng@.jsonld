        "@language": "en",
        "@value": "PARLIAMENTARY SERVICE AND PARLIAMENTARY SERVICE COUNCIL Parliamentary Service"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_III",
      "@type": "akn:part",
      "eli:number": "III",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_III__cl_6",
