      "schema:text": {
        "@language": "en",
        "@value": "no member of the Parliamentary Service Council or member of the Parliamentary Service, whether during or after his tenure of office or employment, shall disclose any information obtained by him in the course of his duties; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_VI__cl_14__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_VI__cl_14__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "no person attending any meeting of the Parliamentary Service Council or who has by any means access to any information or document relating to the affairs of the Parliamentary Service shall disclose such information or document."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_VI__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_VI__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes this section commits an offence and shall, on conviction, be liable to a fine not exceeding one hundred thousand ringgit or to imprisonment for a term not exceeding two years or to both. Protection against suits and legal proceedings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_VI__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "No action, suit, prosecution or other proceedings shall lie or be brought, instituted or maintained in any court against any member of the Parliamentary Service Council, Parliamentary Service Promotion Committee, Parliamentary Service Disciplinary Committee, Parliamentary Service Appeal Committee, committee established under this Act, or any member of the Parliamentary Service, in respect of any act, neglect or default done or omitted by him in good faith, in such capacity. Public Authorities Protection Act 1948"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_VI__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "The Public Authorities Protection Act 1948 [Act 198] shall apply to any action, suit, prosecution or proceedings against any member of the Parliamentary Service Council, Parliamentary Service Promotion Committee, Parliamentary Service Disciplinary Committee, Parliamentary Service Appeal Committee, committee established under this Act, or any member of the Parliamentary Service, in respect of any act or thing done or committed by him in such capacity. Public servant"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_VI__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "Every member of the Parliamentary Service Council, Parliamentary Service Promotion Committee, Parliamentary Service Disciplinary Committee, Parliamentary Service Appeal Committee, committee established under this Act, or every member of the Parliamentary Service, while discharging his duties as the member of the Parliamentary Service Council, Parliamentary Service Promotion Committee, Parliamentary Service Disciplinary Committee, Parliamentary Service Appeal Committee, committee established under this Act, or the member of the Parliamentary Service, shall be deemed to be a public servant within the meaning of the Penal Code [Act 574]. Power to make regulations"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_VI__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_VI__cl_18__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_VI__cl_18__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_VI__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_VI__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "The Yang di-Pertuan Agong may, after consultation with the Parliamentary Service Council, make such regulations as may be expedient or necessary for giving full effect or the better carrying out of the provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_VI__cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_VI__cl_18__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_VI__cl_18__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_VI__cl_18__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_VI__cl_18__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_VI__cl_18__subsec_2__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_VI__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to the generality of subsection (1), regulations may be made for the following purposes:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_VI__cl_18__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_VI__cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe the qualifications for appointment and conditions of service of the Clerk to the Senate and the Clerk to the House of Representatives;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_VI__cl_18__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_VI__cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe the terms and conditions of appointment of the members of the Parliamentary Service;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_VI__cl_18__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_VI__cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe the discipline of members of the Parliamentary Service and for disciplinary proceedings against the members of the Parliamentary Service, including the interdiction, suspension, punishment and dismissal of the members of the Parliamentary Service;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_VI__cl_18__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_VI__cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe any matter relating to the administration of the Parliamentary Service;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_VI__cl_18__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_VI__cl_18__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "to prescribe any matter which may be required to be prescribed for the purposes of this Act. Saving"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_VI__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_VI__cl_19__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_VI__cl_19__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "Every member of the public service who has been appointed on permanent basis and emplaced on permanent establishment immediately before the date of coming into operation of this Act and has opted to become a member of the Parliamentary Service shall, on the date of coming into operation of this Act—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_VI__cl_19__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_VI__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "be employed on terms and conditions of service to which he was entitled to immediately before the date of coming into operation of this Act; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_VI__cl_19__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_VI__cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "be deemed to be a member of the public service for the purposes of the Pensions Act 1980 [Act 227]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_V__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_V__cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_V__cl_11__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_V__cl_11__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_V__cl_11__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_V__cl_11__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_V__cl_11__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_V__cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_V__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "There shall be a Chief Administrator of Parliament from among the members of the general public service of the Federation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_V__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_V__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "The Chief Administrator of Parliament shall be responsible for the overall administration and management of the functions and the day-to-day affairs of the Parliament including the financial matters of the Parliamentary Service."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_V__cl_11__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_V__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "The Chief Administrator of Parliament shall have general control of the members of the Parliamentary Service."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_V__cl_11__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_V__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "The Chief Administrator of Parliament shall perform such other duties as the Parliamentary Service Council may direct."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_V__cl_11__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_V__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "In discharging his duties, the Chief Administrator of Parliament shall act under the general authority and directions of the Parliamentary Service Council."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_V__cl_11__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_V__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "The Chief Administrator of Parliament shall be the secretary to the Parliamentary Service Council. Fund"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_V__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "The Government shall provide sufficient funds for the Parliamentary Service annually to enable the Parliamentary Service Council to perform its functions under this Act. Remuneration"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_V__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "A member of the Parliamentary Service shall be paid such remuneration and other benefits as may be determined by the Parliamentary Service Council and approved by the Yang di-Pertuan Agong."
      }
    }
  ]
}
