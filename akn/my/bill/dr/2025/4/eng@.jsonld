      "schema:text": {
        "@language": "en",
        "@value": "A disclosure under subsection (3) shall be recorded in the minutes of the meeting in which the disclosure was made and, after the disclosure, the member of the Parliamentary Service Appeal Committee shall not be present and take part in the deliberation or decision of the Parliamentary Service Appeal Committee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_9__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
