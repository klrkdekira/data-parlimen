      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_5__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_5__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_5__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_5__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_5__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_5__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_5__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_5__subsec_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_5__subsec_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_5__subsec_11"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The Parliamentary Service Council shall meet as often as may be necessary for the performance of its functions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_5__subsec_10",
      "@type": "akn:subsection",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The Parliamentary Service Council may invite any person to attend meetings of the Parliamentary Service Council for the purpose of advising it on any matter under discussion but that person shall not be entitled to vote at the meeting or be present during the making of a decision."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_5__subsec_11",
      "@type": "akn:subsection",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "Any person invited to attend any meeting of the Parliamentary Service Council may be paid such allowances and other expenses as the Parliamentary Service Council may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "Meetings of the Parliamentary Service Council shall be co-chaired by the President of the Senate and the Speaker of the House of Representatives."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_5__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The quorum of the Parliamentary Service Council shall be seven."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_5__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "Every member of the Parliamentary Service Council, other than the ex-officio members, present at the meeting shall be entitled to one vote."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_5__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "All questions raised in the meetings of the Parliamentary Service Council shall be decided by the votes of the majority of members present and voting, and if the number of votes are equal, then the Chairman shall have the casting vote."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_5__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The Parliamentary Service Council may determine its own procedure."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_5__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The Parliamentary Service Council shall cause minutes of all its meetings to be maintained and kept in a proper form."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_5__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "If any member of the Parliamentary Service Council has a direct or indirect interest in any matter being considered by the Parliamentary Service Council, the member of the Parliamentary Service Council shall disclose to the Parliamentary Service Council the fact of his interest and the nature of that interest."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_5__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "A disclosure under subsection (8) shall be recorded in the minutes of the meeting in which the disclosure was made and, after the disclosure, the member of the Parliamentary Service Council shall not be present and take part in the deliberation or decision of the Parliamentary Service Council."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_10"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "COMMITTEES Parliamentary Service Promotion Committee"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_10__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_10__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_10__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_10__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_10__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_10__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The Parliamentary Service Council may establish any committee as the Parliamentary Service Council considers necessary or expedient to assist the Parliamentary Service Council in the performance of its functions."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The Parliamentary Service Council may appoint any member of the Parliamentary Service to be a member of any committee established under subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_10__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The Parliamentary Service Council may appoint any of its members to be the chairman of the committee established under subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_10__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The committee shall be subject to and act in accordance with any directions given by the Parliamentary Service Council."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_10__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The committee shall meet as often as may be necessary at the time and place as the chairman of the committee may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_10__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The committee may invite any person to attend meetings of the committee to advise the committee on any matter under discussion."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_10__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The committee may determine its own procedure."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_7__subsec_2",
