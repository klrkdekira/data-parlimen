      "schema:text": {
        "@language": "en",
        "@value": "the President of the Senate as a Chairman;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_9__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_9__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Speaker of the House of Representatives as a Co-Chairman; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_9__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_9__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "three members of the Parliamentary Service Council appointed by the Chairman and the Co-Chairman of the Parliamentary Service Council."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_9__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "If any member of the Parliamentary Service Appeal Committee has a direct or indirect interest in any matter being considered by the Parliamentary Service Appeal Committee, the member of the Parliamentary Service Appeal Committee shall disclose to the Parliamentary Service Appeal Committee the fact of his interest and the nature of that interest."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_9__subsec_4",
      "@type": "akn:subsection",
