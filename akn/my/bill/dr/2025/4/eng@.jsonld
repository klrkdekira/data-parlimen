      "schema:text": {
        "@language": "en",
        "@value": "Meetings of the Parliamentary Service Appeal Committee shall be co-chaired by the President of the Senate and the Speaker of the House of Representatives."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/eng@/~part_IV__cl_9__subsec_6",
