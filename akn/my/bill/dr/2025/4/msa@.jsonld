        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_3__subsec_2__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_3__subsec_2__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_3__subsec_2__para_k"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis Perkhidmatan Parlimen hendaklah terdiri daripada anggota yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_3__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_3__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Yang di-Pertua Dewan Negara sebagai Pengerusi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_3__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_3__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Yang di-Pertua Dewan Rakyat sebagai Pengerusi Bersama;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_3__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_3__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Timbalan Yang di-Pertua Dewan Negara;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_3__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_3__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dua orang Timbalan Yang di-Pertua Dewan Rakyat;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_3__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_3__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dua orang ahli Dewan Negara;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_3__subsec_2__para_f",
