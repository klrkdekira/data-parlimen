      "schema:text": {
        "@language": "ms",
        "@value": "Jawatankuasa Tatatertib Perkhidmatan Parlimen hendaklah terdiri daripada anggota yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_8__subsec_2__para_a",
