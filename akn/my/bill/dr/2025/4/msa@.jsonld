      "schema:text": {
        "@language": "ms",
        "@value": "untuk mengawasi semua perkara kewangan yang berhubungan dengan Perkhidmatan Parlimen;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_4__subsec_1__para_c",
