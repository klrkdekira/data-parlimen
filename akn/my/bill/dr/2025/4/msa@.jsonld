        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_V__cl_12",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_V__cl_13"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "PENTADBIRAN DAN KEWANGAN Ketua Pentadbir Parlimen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI",
      "@type": "akn:part",
      "eli:number": "VI",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI__cl_14",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI__cl_15",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI__cl_16",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI__cl_17",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI__cl_18",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI__cl_19"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "AM Obligasi kerahsiaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI__cl_14__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI__cl_14__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI__cl_14__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Kecuali bagi apa-apa maksud Akta ini atau bagi maksud mana-mana prosiding sivil atau jenayah di bawah mana-mana undang-undang bertulis atau jika selainnya dibenarkan oleh Majlis Perkhidmatan Parlimen—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI__cl_14__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI__cl_14__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tiada anggota Majlis Perkhidmatan Parlimen atau anggota Perkhidmatan Parlimen, sama ada semasa atau selepas tempoh jawatan atau penggajiannya, boleh menzahirkan apa-apa maklumat yang diperoleh olehnya semasa menjalankan kewajipannya; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI__cl_14__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI__cl_14__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tiada orang yang menghadiri mana-mana mesyuarat Majlis Perkhidmatan Parlimen atau seseorang yang dengan apa-apa cara mempunyai akses kepada apa-apa maklumat atau dokumen yang berhubungan dengan hal ehwal Perkhidmatan Parlimen boleh menzahirkan maklumat atau dokumen itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar seksyen ini melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi satu ratus ribu ringgit atau dipenjarakan bagi tempoh tidak melebihi dua tahun atau kedua-duanya. Perlindungan terhadap guaman dan prosiding undang-undang"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada tindakan, guaman, pendakwaan atau prosiding lain boleh diambil atau dibawa, dimulakan atau dikekalkan dalam mana-mana mahkamah terhadap mana-mana anggota Majlis Perkhidmatan Parlimen, Jawatankuasa Kenaikan Pangkat Perkhidmatan Parlimen, Jawatankuasa Tatatertib Perkhidmatan Parlimen, Jawatankuasa Rayuan Perkhidmatan Parlimen, jawatankuasa yang ditubuhkan di bawah Akta ini, atau mana-mana anggota Perkhidmatan Parlimen, berkenaan dengan apa-apa perbuatan, pengabaian atau keingkaran yang dilakukan atau ditinggalkan olehnya dengan suci hati, atas sifat yang sedemikian. Akta Perlindungan Pihak Berkuasa Awam 1948"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Perlindungan Pihak Berkuasa Awam 1948 [Akta 198] hendaklah terpakai bagi apa-apa tindakan, guaman, pendakwaan atau prosiding terhadap mana-mana anggota Majlis Perkhidmatan Parlimen, Jawatankuasa Kenaikan Pangkat Perkhidmatan Parlimen, Jawatankuasa Tatatertib Perkhidmatan Parlimen, Jawatankuasa Rayuan Perkhidmatan Parlimen, jawatankuasa yang ditubuhkan di bawah Akta ini, atau mana-mana anggota Perkhidmatan Parlimen, berkenaan dengan apa-apa perbuatan atau benda yang dibuat atau dilakukan olehnya atas sifat yang sedemikian. Pekhidmat awam"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap anggota Majlis Perkhidmatan Parlimen, Jawatankuasa Kenaikan Pangkat Perkhidmatan Parlimen, Jawatankuasa Tatatertib Perkhidmatan Parlimen, Jawatankuasa Rayuan Perkhidmatan Parlimen, jawatankuasa yang ditubuhkan di bawah Akta ini, atau tiap-tiap anggota Perkhidmatan Parlimen, semasa menunaikan kewajipannya sebagai anggota Majlis Perkhidmatan Parlimen, Jawatankuasa Kenaikan Pangkat Perkhidmatan Parlimen, Jawatankuasa Tatatertib Perkhidmatan Parlimen, Jawatankuasa Rayuan Perkhidmatan Parlimen, jawatankuasa yang ditubuhkan di bawah Akta ini, atau anggota Perkhidmatan Parlimen itu, hendaklah disifatkan sebagai pekhidmat awam mengikut pengertian Kanun Keseksaan [Akta 574]. Kuasa untuk membuat peraturan-peraturan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI__cl_18__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI__cl_18__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Yang di-Pertuan Agong boleh, selepas berunding dengan Majlis Perkhidmatan Parlimen, membuat apa-apa peraturan-peraturan yang suai manfaat atau perlu bagi memberikan kuat kuasa sepenuhnya atau bagi melaksanakan dengan lebih baik peruntukan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI__cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI__cl_18__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI__cl_18__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI__cl_18__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI__cl_18__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI__cl_18__subsec_2__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan keluasan subseksyen (1), peraturan-peraturan boleh dibuat bagi maksud yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI__cl_18__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI__cl_18__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan kelayakan bagi pelantikan dan syarat perkhidmatan Setiausaha Dewan Negara dan Setiausaha Dewan Rakyat;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI__cl_18__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI__cl_18__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan terma dan syarat pelantikan anggota Perkhidmatan Parlimen;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI__cl_18__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI__cl_18__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan tatatertib anggota Perkhidmatan Parlimen dan bagi prosiding tatatertib terhadap anggota Perkhidmatan Parlimen itu, termasuk penahanan kerja, penggantungan kerja, hukuman dan pembuangan kerja anggota Perkhidmatan Parlimen itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI__cl_18__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI__cl_18__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan apa-apa perkara yang berhubungan dengan pentadbiran Perkhidmatan Parlimen;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI__cl_18__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI__cl_18__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menetapkan apa-apa perkara yang dikehendaki untuk ditetapkan bagi maksud Akta ini. Kecualian"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI__cl_19__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI__cl_19__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap anggota perkhidmatan awam yang telah dilantik secara tetap dan dimasukkan ke dalam perjawatan tetap sebaik sebelum tarikh permulaan kuat kuasa Akta ini dan telah memilih untuk menjadi anggota Perkhidmatan Parlimen hendaklah, pada tarikh permulaan kuat kuasa Akta ini—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI__cl_19__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "diambil kerja atas terma dan syarat perkhidmatan yang kepadanya dia berhak sebaik sebelum tarikh permulaan kuat kuasa Akta ini; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI__cl_19__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_VI__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "disifatkan sebagai anggota perkhidmatan awam bagi maksud Akta Pencen 1980 [Akta 227]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_V__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_V__cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_V__cl_11__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_V__cl_11__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_V__cl_11__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_V__cl_11__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_V__cl_11__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_V__cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_V__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Hendaklah ada seorang Ketua Pentadbir Parlimen dalam kalangan anggota perkhidmatan awam am Persekutuan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_V__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_V__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pentadbir Parlimen hendaklah bertanggungjawab bagi keseluruhan pentadbiran dan pengurusan fungsi dan hal ehwal harian Parlimen termasuk perkara kewangan Perkhidmatan Parlimen."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_V__cl_11__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_V__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pentadbir Parlimen hendaklah mempunyai kawalan am terhadap anggota Perkhidmatan Parlimen."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_V__cl_11__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_V__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pentadbir Parlimen hendaklah melaksanakan apa-apa kewajipan lain sebagaimana yang diarahkan oleh Majlis Perkhidmatan Parlimen."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_V__cl_11__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_V__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Dalam menunaikan kewajipannya, Ketua Pentadbir Parlimen hendaklah bertindak di bawah kuasa dan arahan am Majlis Perkhidmatan Parlimen."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_V__cl_11__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_V__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pentadbir Parlimen hendaklah menjadi setiausaha kepada Majlis Perkhidmatan Parlimen. Dana"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_V__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Kerajaan hendaklah mengadakan dana yang mencukupi bagi Perkhidmatan Parlimen setiap tahun untuk membolehkan Majlis Perkhidmatan Parlimen melaksanakan fungsinya di bawah Akta ini. Saraan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_V__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang anggota Perkhidmatan Parlimen hendaklah dibayar apa-apa saraan dan faedah lain sebagaimana yang boleh ditentukan oleh Majlis Perkhidmatan Parlimen dan diluluskan oleh Yang di-Pertuan Agong."
      }
    }
  ]
}
