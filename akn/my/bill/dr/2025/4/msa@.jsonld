        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_7__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_7__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_7__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_7__subsec_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Hendaklah ada suatu Jawatankuasa Kenaikan Pangkat Perkhidmatan Parlimen yang bertanggungjawab bagi kenaikan pangkat anggota Perkhidmatan Parlimen."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_7__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_7__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_7__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_7__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_7__subsec_2__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatankuasa Kenaikan Pangkat Perkhidmatan Parlimen hendaklah terdiri daripada anggota yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_7__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_7__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Timbalan Yang di-Pertua Dewan Negara sebagai Pengerusi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_7__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_7__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Timbalan Yang di-Pertua Dewan Rakyat sebagai Pengerusi Bersama;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_7__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_7__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Setiausaha Dewan Negara;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_7__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_7__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Setiausaha Dewan Rakyat; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_7__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_7__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pentadbir Parlimen."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_7__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana anggota Jawatankuasa Kenaikan Pangkat Perkhidmatan Parlimen mempunyai kepentingan langsung atau tidak langsung dalam apa-apa perkara yang sedang dipertimbangkan oleh Jawatankuasa Kenaikan Pangkat Perkhidmatan Parlimen, anggota Jawatankuasa Kenaikan Pangkat Perkhidmatan Parlimen itu hendaklah menzahirkan kepada Jawatankuasa Kenaikan Pangkat Perkhidmatan Parlimen fakta kepentingannya dan jenis kepentingan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_7__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu penzahiran di bawah subseksyen (3) hendaklah direkodkan dalam minit mesyuarat yang penzahiran itu dibuat dan, selepas penzahiran itu, anggota Jawatankuasa Kenaikan Pangkat Perkhidmatan Parlimen itu tidak boleh hadir dan mengambil bahagian dalam pertimbangtelitian atau keputusan Jawatankuasa Kenaikan Pangkat Perkhidmatan Parlimen."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_7__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Mesyuarat Jawatankuasa Kenaikan Pangkat Perkhidmatan Parlimen hendaklah dipengerusikan secara bersama oleh Timbalan Yang di-Pertua Dewan Negara dan Timbalan Yang di-Pertua Dewan Rakyat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_7__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap anggota Jawatankuasa Kenaikan Pangkat Perkhidmatan Parlimen yang hadir dalam mesyuarat berhak kepada satu undi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_7__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua soalan yang dibangkitkan dalam mesyuarat Jawatankuasa Kenaikan Pangkat Perkhidmatan Parlimen hendaklah diputuskan melalui undi majoriti anggota yang hadir dan mengundi, dan jika bilangan undi sama banyak, maka Pengerusi hendaklah mempunyai undi pemutus."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_7__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_7",
      "schema:text": {
        "@language": "ms",
        "@value": "Yang di-Pertuan Agong boleh, selepas berunding dengan Majlis Perkhidmatan Parlimen, menetapkan apa-apa perkara yang berhubungan dengan pemangkuan dan kenaikan pangkat anggota Perkhidmatan Parlimen. Jawatankuasa Tatatertib Perkhidmatan Parlimen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
