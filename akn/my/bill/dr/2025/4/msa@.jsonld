        "@value": "Setiausaha Dewan Rakyat;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_3__subsec_2__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_3__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Setiausaha Perbendaharaan atau wakilnya sebagai anggota ex-officio;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_3__subsec_2__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_3__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pengarah Perkhidmatan Awam atau wakilnya sebagai anggota ex-officio; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_3__subsec_2__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_3__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua Pentadbir Parlimen sebagai anggota ex-officio. Fungsi dan kuasa Majlis Perkhidmatan Parlimen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_4",
