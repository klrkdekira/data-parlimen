      "schema:text": {
        "@language": "ms",
        "@value": "SETIAUSAHA DEWAN NEGARA DAN SETIAUSAHA DEWAN RAKYAT Setiausaha Dewan Negara dan Setiausaha Dewan Rakyat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_III__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_III__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_III__cl_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_III__cl_6__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_III__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_III__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Setiausaha Dewan Negara hendaklah berada di bawah arahan dan kawalan Yang di-Pertua Dewan Negara."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_III__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_III__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Setiausaha Dewan Rakyat hendaklah berada di bawah arahan dan kawalan Yang di-Pertua Dewan Rakyat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_III__cl_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_III__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Yang di-Pertuan Agong boleh, selepas berunding dengan Majlis Perkhidmatan Parlimen, menetapkan kelayakan bagi pelantikan dan syarat perkhidmatan Setiausaha Dewan Negara dan Setiausaha Dewan Rakyat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_2__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_2__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_2__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_2__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu perkhidmatan dengan nama “Perkhidmatan Parlimen” ditubuhkan dan hendaklah menjadi suatu perkhidmatan berasingan daripada perkhidmatan awam di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Perkhidmatan Parlimen hendaklah terdiri daripada Setiausaha Dewan Negara, Setiausaha Dewan Rakyat dan anggota Perkhidmatan Parlimen."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_2__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang anggota Perkhidmatan Parlimen yang dilantik oleh Majlis Perkhidmatan Parlimen hendaklah tertakluk kepada apa-apa terma dan syarat pelantikan sebagaimana yang ditetapkan oleh Yang di-Pertuan Agong selepas berunding dengan Majlis Perkhidmatan Parlimen."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_2__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang anggota Perkhidmatan Parlimen hilang kelayakan untuk menjadi ahli mana-mana satu Majlis Parlimen atau Dewan Undangan mana-mana Negeri. Majlis Perkhidmatan Parlimen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_3__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_3__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_3__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "Hendaklah ada suatu Majlis Perkhidmatan Parlimen yang hendaklah bertanggungjawab bagi perkara yang berhubungan dengan Perkhidmatan Parlimen."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_3__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_3__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_3__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_3__subsec_2__para_c",
