      "schema:text": {
        "@language": "ms",
        "@value": "Hendaklah ada suatu Jawatankuasa Tatatertib Perkhidmatan Parlimen untuk menjalankan kawalan tatatertib terhadap anggota Perkhidmatan Parlimen."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_8__subsec_2",
