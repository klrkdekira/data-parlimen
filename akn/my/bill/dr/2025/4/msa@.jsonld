      "schema:text": {
        "@language": "ms",
        "@value": "empat orang ahli Dewan Rakyat;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_3__subsec_2__para_g",
