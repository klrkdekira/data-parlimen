      "schema:text": {
        "@language": "ms",
        "@value": "Timbalan Yang di-Pertua Dewan Negara sebagai Pengerusi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_8__subsec_2__para_b",
