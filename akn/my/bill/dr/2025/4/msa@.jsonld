      "schema:text": {
        "@language": "ms",
        "@value": "Setiausaha Dewan Negara;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_8__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
