        "@value": "tiga orang anggota Majlis Perkhidmatan Parlimen yang dilantik oleh Pengerusi dan Pengerusi Bersama Majlis Perkhidmatan Parlimen."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_9__subsec_3",
