      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk membangunkan dan untuk melaksanakan program dan latihan yang berhubungan dengan Perkhidmatan Parlimen; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_4__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_4__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk melakukan semua perkara yang suai manfaat dan semunasabahnya perlu bagi pengurusan hal ehwal Perkhidmatan Parlimen."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_4",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis Perkhidmatan Parlimen hendaklah mempunyai segala kuasa sebagaimana yang perlu bagi melaksanakan fungsinya di bawah Akta ini. Mesyuarat"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_5__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_5__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_5__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_5__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_5__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_5__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_5__subsec_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_5__subsec_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_5__subsec_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_5__subsec_11"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis Perkhidmatan Parlimen hendaklah bermesyuarat seberapa kerap yang perlu bagi melaksanakan fungsinya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_5__subsec_10",
      "@type": "akn:subsection",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis Perkhidmatan Parlimen boleh mengundang mana-mana orang untuk menghadiri mesyuarat Majlis Perkhidmatan Parlimen bagi maksud menasihatinya tentang apa-apa perkara yang dibincangkan tetapi orang itu tidak berhak untuk mengundi dalam mesyuarat itu atau hadir semasa sesuatu keputusan dibuat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_5__subsec_11",
      "@type": "akn:subsection",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang diundang untuk menghadiri mana-mana mesyuarat Majlis Perkhidmatan Parlimen boleh dibayar apa-apa elaun dan perbelanjaan lain sebagaimana yang ditentukan oleh Majlis Perkhidmatan Parlimen."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Mesyuarat Majlis Perkhidmatan Parlimen hendaklah dipengerusikan secara bersama oleh Yang di-Pertua Dewan Negara dan Yang di-Pertua Dewan Rakyat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_5__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Kuorum Majlis Perkhidmatan Parlimen ialah tujuh orang."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_5__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap anggota Majlis Perkhidmatan Parlimen, selain anggota ex-officio, yang hadir dalam mesyuarat berhak kepada satu undi."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_5__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Semua soalan yang dibangkitkan dalam mesyuarat Majlis Perkhidmatan Parlimen hendaklah diputuskan melalui undi majoriti anggota yang hadir dan mengundi, dan jika bilangan undi sama banyak, maka Pengerusi hendaklah mempunyai undi pemutus."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_5__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis Perkhidmatan Parlimen boleh menentukan tatacaranya sendiri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_5__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis Perkhidmatan Parlimen hendaklah menyebabkan minit semua mesyuaratnya disenggarakan dan disimpan dalam bentuk yang sepatutnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_5__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana anggota Majlis Perkhidmatan Parlimen mempunyai kepentingan langsung atau tidak langsung dalam apa-apa perkara yang sedang dipertimbangkan oleh Majlis Perkhidmatan Parlimen, anggota Majlis Perkhidmatan Parlimen itu hendaklah menzahirkan kepada Majlis Perkhidmatan Parlimen fakta kepentingannya dan jenis kepentingan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_5__subsec_9",
      "@type": "akn:subsection",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu penzahiran di bawah subseksyen (8) hendaklah direkodkan dalam minit mesyuarat yang penzahiran itu dibuat dan, selepas penzahiran itu, anggota Majlis Perkhidmatan Parlimen itu tidak boleh hadir dan mengambil bahagian dalam pertimbangtelitian atau keputusan Majlis Perkhidmatan Parlimen."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_10"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "JAWATANKUASA Jawatankuasa Kenaikan Pangkat Perkhidmatan Parlimen"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_10__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_10__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_10__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_10__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_10__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_10__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis Perkhidmatan Parlimen boleh menubuhkan apa-apa jawatankuasa sebagaimana yang Majlis Perkhidmatan Parlimen fikirkan perlu atau suai manfaat untuk membantu Majlis Perkhidmatan Parlimen dalam melaksanakan fungsinya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis Perkhidmatan Parlimen boleh melantik mana-mana anggota Perkhidmatan Parlimen untuk menjadi anggota mana-mana jawatankuasa yang ditubuhkan di bawah subseksyen (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_10__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Majlis Perkhidmatan Parlimen boleh melantik mana-mana anggotanya untuk menjadi pengerusi jawatankuasa yang ditubuhkan di bawah subseksyen (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_10__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatankuasa hendaklah tertakluk kepada dan bertindak mengikut apa-apa arahan yang diberikan oleh Majlis Perkhidmatan Parlimen."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_10__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatankuasa hendaklah bermesyuarat seberapa kerap yang perlu pada masa dan tempat sebagaimana yang ditentukan oleh pengerusi jawatankuasa."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_10__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatankuasa boleh mengundang mana-mana orang untuk menghadiri mesyuarat jawatankuasa untuk menasihati jawatankuasa mengenai apa-apa perkara yang sedang dibincangkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_10__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "Jawatankuasa boleh menentukan tatacaranya sendiri."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_IV__cl_7__subsec_2",
