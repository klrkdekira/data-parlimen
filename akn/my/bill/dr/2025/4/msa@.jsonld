      "schema:text": {
        "@language": "ms",
        "@value": "Setiausaha Dewan Negara;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/4/msa@/~part_II__cl_3__subsec_2__para_h",
