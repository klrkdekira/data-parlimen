      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words “two years” the words “five years”. Amendment of section 26h"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/eng@/~cl_13",
