        "@value": "by substituting for the words “fifty thousand” the words “two hundred and fifty thousand”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/eng@/~cl_12__para_b",
