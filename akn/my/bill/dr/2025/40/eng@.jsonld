      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by deleting section 22a. Amendment of section 24b"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/eng@/~cl_11",
