      "schema:text": {
        "@language": "en",
        "@value": "by renumbering the existing section as subsection (1); and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/eng@/~cl_11__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/eng@/~cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (1) as renumbered the following subsection: “(2) For the purposes of this Act, any person whose name appears in the credits of a film as its producer or co-producer, or who is otherwise shown in the credits to have financed or supervised the production of the film shall, unless the contrary is proved, be presumed to be engaged in the production of the film.”. Amendment of section 25"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/eng@/~cl_12",
