    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/eng@/~cl_19__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/eng@/~cl_19",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after paragraph 1 the following paragraph: “Temporary Chairman 1a. The Minister may appoint temporarily any member of the Perbadanan to act as the Chairman during any period when— (a) the office of Chairman is vacant; (b) the Chairman is absent from duty or from Malaysia; or (c) the Chairman is, for any reason, unable to perform his duties and functions or exercise his powers under this Act.”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/eng@/~cl_19__para_b",
