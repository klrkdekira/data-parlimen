      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “pengetahuan dan pengalaman mereka yang luas” dengan perkataan “pengetahuan dan pengalamannya yang luas”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@/~cl_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
