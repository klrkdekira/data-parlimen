      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perenggan (e). Pindaan seksyen 6"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
