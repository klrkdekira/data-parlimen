      "schema:text": {
        "@language": "ms",
        "@value": "dalam takrif “Pengerusi”, dengan memotong perkataan “Timbalan Pengerusi dan”. Pindaan seksyen 4"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@/~cl_3",
