    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memotong seksyen 22a. Pindaan seksyen 24b"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
