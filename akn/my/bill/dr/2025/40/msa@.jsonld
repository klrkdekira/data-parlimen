        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@/~cl_17__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 34(2) Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@/~cl_17__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@/~cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (c), dengan memotong perkataan “dan” di hujung perenggan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@/~cl_17__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@/~cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (d), dengan menggantikan noktah di hujung perenggan itu dengan perkataan “; dan”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@/~cl_17__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@/~cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan (d) perenggan yang berikut: “(e) untuk menetapkan semua perkara lain sebagaimana yang perlu atau suai manfaat untuk ditetapkan bagi melaksanakan Akta ini.”. Pindaan seksyen 34a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@/~cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 34a Akta ibu dipinda dengan memasukkan selepas perkataan “Akta ini” perkataan “atau perundangan subsidiari yang dibuat di bawahnya”. Pindaan Jadual"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@/~cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@/~cl_19__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@/~cl_19__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Jadual kepada Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@/~cl_19__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@/~cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan 1 perenggan yang berikut: “Pengerusi 1a. Menteri boleh melantik buat sementara sementara. mana-mana ahli Perbadanan untuk bertindak sebagai Pengerusi semasa apa-apa tempoh apabila— (a) jawatan Pengerusi kosong; (b) Pengerusi tidak hadir bertugas atau tidak berada di Malaysia; atau (c) Pengerusi, atas apa-apa sebab, tidak dapat melaksanakan kewajipan dan tugasnya atau menjalankan kuasanya di bawah Akta ini.”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@/~cl_19__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@/~cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subperenggan 3(2), dengan menggantikan perkataan “Timbalan Pengerusi” dengan perkataan “Pengerusi sementara”."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Perbadanan Kemajuan Filem Nasional Malaysia (Pindaan) 2025."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta. Pindaan seksyen 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
