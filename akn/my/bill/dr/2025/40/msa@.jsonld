      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam takrif “filem-filem”, dengan memotong perkataan “, filem subjek ringkas”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@/~cl_2__para_c",
      "@type": "akn:paragraph",
