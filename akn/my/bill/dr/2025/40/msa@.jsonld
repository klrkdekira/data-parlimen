        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@/~cl_11__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@/~cl_11__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 24b Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@/~cl_11__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@/~cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menomborkan semula seksyen sedia ada sebagai subseksyen (1); dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@/~cl_11__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@/~cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (1) sebagaimana yang dinomborkan semula subseksyen yang berikut: “(2) Bagi maksud Akta ini, mana-mana orang yang namanya tersiar dalam penghargaan suatu filem sebagai penerbit atau penerbit bersama filem itu, atau yang selainnya ditunjukkan dalam penghargaan itu telah membiayai atau menyelia pengeluaran filem itu hendaklah, melainkan jika dibuktikan sebaliknya, dianggap mengambil bahagian dalam pengeluaran filem itu.”. Pindaan seksyen 25"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@/~cl_12__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@/~cl_12__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 25(1) Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@/~cl_12__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@/~cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “lima puluh ribu” dengan perkataan “dua ratus lima puluh ribu”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@/~cl_12__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@/~cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “dua tahun” dengan perkataan “lima tahun”. Pindaan seksyen 26h"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@/~cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@/~cl_13__para_a",
