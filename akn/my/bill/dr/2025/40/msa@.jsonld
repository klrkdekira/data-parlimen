        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@/~cl_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Perbadanan Kemajuan Filem Nasional Malaysia 1981 [Akta 244], yang disebut “Akta ibu” dalam Akta ini, dipinda dalam seksyen 2—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam takrif “ahli”, dengan memotong perkataan “, Timbalan Pengerusi”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
