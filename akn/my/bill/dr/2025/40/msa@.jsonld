      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (7)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/40/msa@/~cl_8__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
