      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/43/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (1), by inserting after the words “shall produce to an immigration officer” the words “or provide through an automated system,”; and"
      }
    },
