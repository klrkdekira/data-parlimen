      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/43/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The Passports Act 1966 [Act 150] is amended in section 2—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/43/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
