      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/43/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Amendment of section 2"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/43/eng@/~cl_2",
