      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/43/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1), dengan memasukkan selepas perkataan “shall produce to an immigration officer” perkataan “or provide through an automated system,”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/43/msa@/~cl_2__para_b",
