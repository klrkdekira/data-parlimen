      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/43/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta Pasport 1966 [Akta 150] dipinda dalam seksyen 2—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/43/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
