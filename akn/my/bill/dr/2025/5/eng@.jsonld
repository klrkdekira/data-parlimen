        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/5/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/5/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/5/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/5/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Constitution (Amendment) Act 2025."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/5/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/5/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Yang di-Pertuan Agong by notification in the Gazette. Amendment of Article 56"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/5/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/5/eng@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/5/eng@/~cl_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/5/eng@/~cl_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/5/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The Federal Constitution is amended in Article 56—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/5/eng@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/5/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "in Clause (2), by inserting after the words “Clause (5)” the words “or Clause (5a)”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/5/eng@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/5/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after Clause (5) the following Clause: “(5a) A member who is elected to be President or Deputy President shall not be disqualified from holding such office by virtue of his membership in the Parliamentary Service Council established under a federal law provided that the member who is elected to be President or Deputy President does not receive any remuneration, reward, profit or benefit from it.”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/5/eng@/~cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/5/eng@/~cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "in Clause (6), by inserting after the words “Clause (5)” the words “or Clause (5a)”. Amendment of Article 57"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/5/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/5/eng@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/5/eng@/~cl_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/5/eng@/~cl_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/5/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Article 57 of the Federal Constitution is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/5/eng@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/5/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (bb) of Clause (2), by inserting after the words “Clause (5)” the words “or Clause (5a)”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/5/eng@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/5/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after Clause (5) the following Clause: “(5a) A person who is elected to be Speaker or Deputy Speaker shall not be disqualified from holding such office by virtue of his membership in the Parliamentary Service Council established under a federal law provided that the person who is elected to be Speaker or Deputy Speaker does not receive any remuneration, reward, profit or benefit from it.”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/5/eng@/~cl_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/5/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "in Clause (6), by inserting after the words “Clause (5)” the words “or Clause (5a)”. Amendment of Article 65"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/5/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/5/eng@/~cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/5/eng@/~cl_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/5/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Article 65 of the Federal Constitution is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/5/eng@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/5/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for Clause (2) the following Clause: “(2) The Clerk to the Senate and the Clerk to the House of Representatives shall be appointed by the Yang di-Pertuan Agong and each shall hold office until his terms of appointment expire, his appointment is revoked or he resigns his office.”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/5/eng@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/5/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after Clause (2) the following Clauses: “(2a) The Clerk to the Senate and the Clerk to the House of Representatives shall be disqualified from being a member of either House of Parliament or the Legislative Assembly of any State. (2b) Except as otherwise expressly provided by this Article, the qualifications for appointment and conditions of service of the Clerk to the Senate and the Clerk to the House of Representatives may be regulated by federal law.”. Saving"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/5/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/5/eng@/~cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/5/eng@/~cl_5__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/5/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/5/eng@/~cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/5/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The person holding the office of the Clerk to the Senate or the Clerk to the House of Representatives before the date of coming into operation of this Act shall, on the date of coming into operation of this Act, continue to hold office until he attains his age of compulsory retirement as a member of the general public service of the Federation unless he sooner resigns his office or is transferred to another office in the general public service of the Federation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/5/eng@/~cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/5/eng@/~cl_5__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/5/eng@/~cl_5__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/5/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "If the person holding the office of the Clerk to the Senate or the Clerk to the House of Representatives before the date of coming into operation of this Act has opted to become a member of the Parliamentary Service established under a federal law, on the date of coming into operation of this Act—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/5/eng@/~cl_5__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/5/eng@/~cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the person shall be employed on terms and conditions of service to which he was entitled to immediately before the date of coming into operation of this Act; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/5/eng@/~cl_5__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/5/eng@/~cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the person shall be deemed to be a member of the public service for the purposes of the Pensions Act 1980 [Act 227]."
      }
    }
  ]
}
