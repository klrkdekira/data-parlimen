      ],
      "schema:name": {
        "@language": "en",
        "@value": "Constitution (Amendment) Bill 2025"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/5/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
