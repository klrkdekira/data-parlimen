      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/7/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The Energy Commission Act 2001 [Act 610] is amended in subsection 14(1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/7/eng@/~cl_2__para_a",
