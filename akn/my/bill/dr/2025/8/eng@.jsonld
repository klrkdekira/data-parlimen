      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words “member of the Fund” wherever appearing the word “employee”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/8/eng@/~cl_4__para_b",
