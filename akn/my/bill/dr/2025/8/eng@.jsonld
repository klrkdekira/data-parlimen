        "@value": "Employees Provident Fund (Amendment) Bill 2025"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/8/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
