    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/8/eng@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/8/eng@/~cl_10__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/8/eng@/~cl_10__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/8/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "The Third Schedule to the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/8/eng@/~cl_10__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/8/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting Parts B and D; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/8/eng@/~cl_10__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/8/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after Part E the following part: “PART F 1. The rate of contributions specified in this Part shall apply to employees who are not Malaysian citizens— RATE OF CONTRIBUTIONS BASED ON AMOUNT OF WAGES FOR THE MONTH By the Employer 2% of the amount of wages 2% of the amount of wages for the month 2. The total contribution which includes cents shall be rounded to the next ringgit. 3. The Board may prescribe any limit on the amount of wages and contributions for the purpose of determining any amount of contribution to be paid on the wages for the month by each employer for each employee. 4. For the purposes of subsection 43(3), the amount of contributions for the month is limited to any limit on the total contribution as prescribed by the Board.”. Transitional"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/8/eng@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/8/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The rate of monthly contributions of an employee who is not a Malaysian citizen and who has elected to contribute on or after 1 August 1998 until the date of coming into operation of this Act shall, on the date of coming into operation of this Act, be at the rate as specified in Part F of the Third Schedule."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/8/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/8/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Employees Provident Fund (Amendment) Act 2025."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/8/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/8/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette and the Minister may appoint different dates for the coming into operation of different provisions of this Act. Amendment of Part VIIa"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/8/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/8/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Employees Provident Fund Act 1991 [Act 452], which is referred to as the “principal Act” in this Act, is amended in the heading of Part VIIa by substituting for the words “MEMBER OF THE FUND” the word “EMPLOYEE”. Substitution of section 70a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/8/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/8/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by substituting for section 70a the following section: “Application 70a. This Part shall apply to an employee who is not a Malaysian citizen: (a) whose country of domicile is outside Malaysia; and (b) who enters and remains temporarily under the authority of any pass issued under the provisions of any written law relating to immigration.”. Amendment of section 70c"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/8/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/8/eng@/~cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/8/eng@/~cl_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/8/eng@/~cl_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/8/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 70c of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/8/eng@/~cl_4__para_a",
