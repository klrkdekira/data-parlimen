      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong perkataan “55a (selain subseksyen (2)),”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/8/msa@/~cl_6__para_c",
