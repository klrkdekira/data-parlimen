      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “seksyen 29a,” perkataan “43(8),”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/8/msa@/~cl_6__para_b",
      "@type": "akn:paragraph",
