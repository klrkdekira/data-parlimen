      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 70e Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/8/msa@/~cl_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
