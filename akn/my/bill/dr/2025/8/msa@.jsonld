      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “ahli Kumpulan Wang” dengan perkataan “pekerja”. Pindaan seksyen 70f"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/8/msa@/~cl_7",
