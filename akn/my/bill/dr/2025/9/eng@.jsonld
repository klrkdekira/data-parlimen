      ],
      "schema:name": {
        "@language": "en",
        "@value": "Government Service Efficiency Commitment Bill 2025"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_10__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_10__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_10__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_10__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_10__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The head of Government entity shall, from time to time as determined by the Chief Secretary to the Government, submit a service performance report to the Chief Secretary to the Government."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The Chief Secretary to the Government shall cause the service performance report submitted by the head of Government entity under subsection (1) to be examined, assessed and considered for rating in accordance with the rating method established under section 7."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_10__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of subsection (2), the Minister shall, after consultation with the Chief Secretary to the Government, appoint any person with appropriate qualifications to examine and assess a service performance report of a Government entity, and the person shall submit his findings to the Chief Secretary to the Government."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_10__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "Upon receiving the findings with regard to a service performance report of a Government entity, the Chief Secretary to the Government shall review and consider the findings and give a rating to the Government entity."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_10__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "Any Government entity that achieves a rating as determined by the Chief Secretary to the Government may be considered to receive incentives and recognition from the Government."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_10__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_10__subsec_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_10__subsec_6__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding the provisions of this Act—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_10__subsec_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_10__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "the Minister may use the service performance report of a Government entity as a criteria for determining the granting of Government financial allocation to the Government entity; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_10__subsec_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_10__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "the Minister may cause the service performance report of any Government entity to be laid before the Dewan Rakyat. Service performance report and rating of State Government entity"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_11__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_11__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_11__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_11__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_11__subsec_6"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding the provisions of this Act, the Chief Secretary to the Government may receive, assess and consider a service performance report submitted voluntarily to the Chief Secretary to the Government by any State Government entity."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "The Chief Secretary to the Government shall cause the service performance report submitted by the head of a State Government entity under subsection (1) to be examined, assessed and considered for rating in accordance with the rating method established under section 7."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_11__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of subsection (2), the Minister shall, after consultation with the Chief Secretary to the Government, appoint any person with appropriate qualifications to examine and assess a service performance report of a State Government entity, and the person shall submit his findings to the Chief Secretary to the Government."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_11__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_11__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_11__subsec_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_11__subsec_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "Upon receiving the findings with regard to the service performance report of a State Government entity, the Chief Secretary to the Government shall review and consider the findings and may—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_11__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_11__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "give a rating to the State Government entity in accordance with the rating method established under section 7;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_11__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_11__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "determine an incentive or recognition that may be given to the State Government entity; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_11__subsec_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_11__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "impose any conditions for spending any incentive given to the State Government entity."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_11__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding the provisions of this Act, the Minister may use a service performance report of a State Government entity as a criteria for determining the granting of Government financial allocation to the State Government entity."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_11__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_11__subsec_6__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_11__subsec_6__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_11__subsec_6__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this section, “State Government entity” means—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_11__subsec_6__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_11__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "any ministry, department, office, authority or agency, of a State Government, or any other entity in the State Government service;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_11__subsec_6__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_11__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "any statutory body of a State Government established under State law; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_11__subsec_6__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_11__subsec_6",
      "schema:text": {
        "@language": "en",
        "@value": "any local authority in a State. Government Service Efficiency Commitment Report"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_12__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_12__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_12__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_12__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_12__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_12__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_12__subsec_1__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The Chief Secretary to the Government shall prepare the Government Service Efficiency Commitment Report every three years, which shall contain the following information:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_12__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_12__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "overall effectiveness of Government service delivery;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_12__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_12__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "regulatory burden reduction performance;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_12__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_12__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "details of Government entity ratings;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_12__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_12__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "details of incentives given to the Government entities that achieve rating targets;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_12__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_12__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "service performance reports of State Government entities; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_12__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_12__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any other relevant information."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister shall cause the Government Service Efficiency Commitment Report made under subsection (1) to be laid before the Dewan Rakyat as soon as may be practicable. Exemption"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_13__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_13__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_13__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_13__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_13__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, after consulting the Chief Secretary to the Government, by order published in the Gazette, exempt—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_13__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_13__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any Government entity or part of any Government entity; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_13__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_13__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any regulatory instrument or part of any regulatory instrument, from all or any provisions of this Act subject to such conditions as the Minister may specify in the order."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_13__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_13",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, at any time by order published in the Gazette, revoke any order made under subsection (1) if the Minister is satisfied that such exemption should no longer be granted. Directives, circulars and guidelines"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Chief Secretary to the Government may issue any directives, circulars or guidelines as he thinks beneficial or necessary to implement the provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Government Service Efficiency Commitment Act 2025."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Application"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall apply to the Government and Government entities. Act to be read together with relevant written laws"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall be read together with the relevant written laws and the provisions of this Act shall be in addition to, and not in derogation of, the provisions of the relevant written laws. Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_4__list_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_4__list_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "In this Act, unless the context otherwise requires—"
      },
      "schema:text": {
        "@language": "en",
        "@value": "“regulatory burden” means any regulatory or administrative requirements imposed by a regulatory instrument on individuals or businesses which are excessive, irrelevant or inefficient, or have detrimental effects; “Government entity” means—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_4__list_1",
      "@type": "akn:list",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_4__list_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_4__list_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_4__list_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_4"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_4__list_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_4__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "any ministry, department, office, authority or agency, of the Government, or any other entity in the Government service;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_4__list_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_4__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "any statutory body of the Government established under an Act of Parliament; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_4__list_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_4__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "the local authorities of the Federal Territories of Kuala Lumpur, Labuan and Putrajaya; “regulatory instrument” means—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_4__list_2",
      "@type": "akn:list",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_4__list_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_4__list_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_4"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_4__list_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_4__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "any subsidiary legislation made under the Federal Constitution or any Act of Parliament; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_4__list_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_4__list_2",
      "schema:text": {
        "@language": "en",
        "@value": "any directive, circular, guidelines, procedure, work process or any other form of administrative instrument issued by a Government entity; “head of Government entity” means any officer who is responsible for a Government entity, including any officer authorized in writing by the head of Government entity to act on his behalf; “Minister” means the Prime Minister or any Minister designated by the Prime Minister; “Principles of Commitment” means the Principles of Commitment specified under section 5. Principles of Commitment"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_5__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_5__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_5__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Government service delivery shall be based on the Principles of Commitment as follows:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "service efficiency, namely the delivery of services that is efficient, effective and easily accessible;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "responsibility in governance, namely the practice of ethical and high-performance work culture at all levels of Government entities by instilling accountability, integrity and transparency in the delivery of services to individuals and businesses;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_5__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "structural reform, namely the implementation of continuous changes and improvement in Government entities and regulatory instruments to reduce bureaucracy and to adapt to technological advancement and current changes; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_5__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "responsibility in regulatory effectiveness, namely the responsibility in reducing regulatory burden guided by the values of efficiency, effectiveness and necessity. Reduction of regulatory burden"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_6__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_6__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_6__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_6__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "A Government entity shall, at every three-year interval—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_6__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_6__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "review the procedures under its regulatory instruments; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_6__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_6__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "reduce the regulatory burden by at least twenty-five percent."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The Government entity shall perform the obligations under paragraphs (1)(a) and (b) to ensure that its regulatory instruments are efficient, effective and necessary."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "No new regulatory instrument shall come into operation unless at least one regulatory instrument on the same subject matter, as determined in the manner as specified in the guidelines issued by the Chief Secretary to the Government, is revoked."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_6__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may, after consultation with the Chief Secretary to the Government, by order published in the Gazette, amend the interval under subsection (1) or the percentage of reduction of regulatory burden under paragraph (1)(b). Service performance rating method"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_7__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "The Chief Secretary to the Government shall establish a rating method which is consistent with the Principles of Commitment to measure, assess and monitor the efficiency and effectiveness of Government service delivery."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_7__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_7__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_7__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "The rating method under subsection (1) shall—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_7__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_7__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "objectively and transparently measure and assess the service performance of a Government entity;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_7__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_7__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "use clear criteria to measure and assess the service performance of a Government entity which comprise efficiency and effectiveness of service delivery and adherence to the Principles of Commitment; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_7__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_7__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "ensure that the result of the measurement and assessment can be used to improve and enhance the quality of service of a Government entity. Duties and powers of Chief Secretary to the Government"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_8__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_8__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_8__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_8__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_8__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "The Chief Secretary to the Government shall carry out the following duties:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_8__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_8__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to plan, implement and monitor policies in respect of the Principles of Commitment;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_8__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_8__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to make recommendations to the Minister on a method of assessment and rating of service performance of a Government entity;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_8__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_8__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to advise and recommend to the Minister on the implementation of the Principles of Commitment and any other matter relating to this Act;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_8__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_8__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to undertake any other things arising out of or consequential to the provisions under this Act consistent with the purposes of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "The Chief Secretary to the Government shall have all such powers as may be necessary for, or in connection with, or reasonably incidental to, the carrying out of his duties under this Act. Duties of head of Government entity"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_9__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_9__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_9__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_9__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_9__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_9__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_9__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_9__subsec_1__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_9__subsec_1__para_h"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "The head of Government entity shall carry out the following duties:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_9__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_9__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to ensure that the management and services of the Government entity under his supervision are aligned with the purposes of this Act and Principles of Commitment, and comply with policies as determined from time to time;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_9__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_9__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to ensure that the governance at all levels of the Government entity under his supervision is implemented with dedication, integrity, accountability and transparency;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_9__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_9__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to provide a framework for structural reform to reduce the regulatory burden together with planning information as well as directions for the structural reform;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_9__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_9__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to monitor the implementation of policies and directives in relation to the Principles of Commitment at all levels of the Government entity under his supervision;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_9__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_9__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to coordinate and monitor the service performance of the Government entity under his supervision towards achieving the rating targets;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_9__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_9__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to prepare and submit to the Chief Secretary to the Government periodic service performance reports for rating purposes;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_9__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_9__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to submit any other information as may be directed by the Chief Secretary to the Government;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_9__subsec_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_9__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to perform any other duties imposed on him under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2025/9/eng@/~cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "The head of Government entity shall have all such powers as may be necessary for, or in connection with, or reasonably incidental to, the carrying out of his duties under this Act. Service performance report and rating of Government entity"
      }
    }
  ]
}
