      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 4(2) Akta ibu dipinda dengan menggantikan perkataan “Suruhanjaya Persaingan” dengan perkataan “Suruhanjaya Persaingan Malaysia”. Pindaan seksyen 16"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/11/msa@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/11/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan 16(a) Akta ibu dipinda dengan memasukkan selepas perkataan “yang berkenaan dengan persaingan” dengan perkataan “termasuklah tentang polisi, tatacara dan program yang berhubungan dengan persaingan”. Pindaan seksyen 17"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/11/msa@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/11/msa@/~cl_9__para_a",
