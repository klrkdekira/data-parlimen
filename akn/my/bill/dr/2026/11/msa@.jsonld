      "schema:text": {
        "@language": "ms",
        "@value": "dalam takrif “Suruhanjaya”, dengan menggantikan perkataan “Suruhanjaya Persaingan” dengan perkataan “Suruhanjaya Persaingan Malaysia”. Pindaan Bahagian II"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/11/msa@/~cl_5",
