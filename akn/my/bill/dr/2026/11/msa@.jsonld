      "schema:text": {
        "@language": "ms",
        "@value": "Bahagian II Akta ibu dipinda dalam kepala dengan menggantikan perkataan “SURUHANJAYA PERSAINGAN” dengan perkataan “SURUHANJAYA”. Pindaan seksyen 3"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/11/msa@/~cl_6",
