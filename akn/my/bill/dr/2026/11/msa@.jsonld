      "schema:name": {
        "@language": "ms",
        "@value": "RUU Suruhanjaya Persaingan (Pindaan) 2026"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/11/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
