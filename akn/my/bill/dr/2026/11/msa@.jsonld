      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan takrif “pegawai Suruhanjaya” dengan takrif yang berikut: ‘ “pegawai Suruhanjaya” ertinya mana-mana orang yang dilantik oleh Suruhanjaya di bawah seksyen 38;’; dan"
      }
    },
    {
