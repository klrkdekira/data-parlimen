      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 3(1) Akta ibu dipinda dengan menggantikan perkataan “Suruhanjaya Persaingan” dengan perkataan “Suruhanjaya Persaingan Malaysia”. Pindaan seksyen 4"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/11/msa@/~cl_7",
