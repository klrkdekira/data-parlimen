      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/11/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 17(2) Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/11/msa@/~cl_9__para_a",
      "@type": "akn:paragraph",
