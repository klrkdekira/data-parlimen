      "schema:text": {
        "@language": "ms",
        "@value": "dalam takrif “Kumpulan Wang”, dengan menggantikan perkataan “Kumpulan Wang Suruhanjaya Persaingan” dengan perkataan “Kumpulan Wang Suruhanjaya Persaingan Malaysia”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/11/msa@/~cl_4__para_b",
