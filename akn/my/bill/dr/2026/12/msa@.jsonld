      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2) sebagaimana yang dinomborkan semula—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_22__para_d__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_22__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “Jika Suruhanjaya memutuskan bahawa terdapat suatu pelanggaran suatu larangan di bawah Bahagian II, ia—” dengan perkataan “Jika Suruhanjaya telah membuat suatu keputusan bahawa terdapat suatu pelanggaran larangan di bawah Bahagian II, Suruhanjaya—”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_22__para_d__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_22__para_d",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (b), dengan menggantikan perkataan “dikehendaki supaya perlu diambil oleh perusahaan yang melanggar” dengan perkataan “yang dikehendaki supaya diambil oleh perusahaan yang tersentuh oleh keputusan itu”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_22__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_22__para_e__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_22__para_e__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (3) sebagaimana yang dinomborkan semula—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_22__para_e__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_22__para_e",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “Bahagian ini” dengan perkataan “seksyen ini”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_22__para_e__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_22__para_e",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “memberitahu mana-mana orang” dengan perkataan “memberikan notis bertulis kepada mana-mana perusahaan”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_22__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (5) sebagaimana yang dinomborkan semula dengan subseksyen yang berikut: “(5) Penalti kewangan yang dikenakan oleh Suruhanjaya di bawah perenggan (1)(c) hendaklah dibayar oleh perusahaan yang tersentuh oleh keputusan itu dalam tempoh sebagaimana yang ditentukan oleh Suruhanjaya dan tidak boleh melebihi sepuluh peratus daripada pusing ganti seluruh dunia perusahaan itu sepanjang tempoh pelanggaran larangan itu berlaku.”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_22__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (5) sebagaimana yang dinomborkan semula subseksyen yang berikut: “(6) Jika perusahaan yang kepadanya penalti kewangan telah dikenakan tidak membayar penalti kewangan itu atau mana-mana bahagian daripadanya dalam tempoh yang ditentukan oleh Suruhanjaya, perusahaan itu hendaklah juga bertanggungan untuk membayar caj pembayaran lewat pada kadar yang ditentukan oleh Suruhanjaya.”. Pindaan seksyen 41"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_23",
      "@type": "akn:clause",
