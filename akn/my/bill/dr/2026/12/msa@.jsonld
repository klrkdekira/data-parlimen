      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (a), dengan menggantikan perkataan “kepada seseorang atau suatu kategori orang tertentu” dengan perkataan “kepada perusahaan atau orang tertentu atau kategori perusahaan atau orang tertentu”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_16__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_16__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “ia boleh” dengan perkataan “Suruhanjaya boleh, pada bila-bila masa sebelum penyiasatan selesai,”;"
      }
    },
