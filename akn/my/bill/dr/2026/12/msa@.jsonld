      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (3)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_15__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_15__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (a), dengan menggantikan perkataan “dan” di hujung perenggan itu dengan perkataan “atau”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_15__para_c__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_15__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (b), dengan memasukkan selepas perkataan “apa-apa penyiasatan oleh Suruhanjaya” perkataan “atau pelaksanaan fungsi dan kuasa Suruhanjaya yang lain di bawah Akta ini”. Pindaan seksyen 35"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_16",
      "@type": "akn:clause",
