      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 40 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_22__para_a",
      "@type": "akn:paragraph",
