      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (a), dengan menggantikan perkataan “pelanggaran mana-mana larangan” dengan perkataan “perjanjian”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_23__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_23__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (b), dengan menggantikan perkataan “pengenalpastian atau penyiasatan apa-apa dapatan” dengan perkataan “pengenalpastian, siasatan atau penyiasatan”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_23__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
