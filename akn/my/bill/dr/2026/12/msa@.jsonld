      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan nota bahu dengan nota bahu yang berikut: “Keputusan mengenai pelanggaran larangan”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_22__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menomborkan semula subseksyen (1), (2), (3) dan (4) sedia ada sebagai subseksyen (2), (3), (4) dan (5) masing-masing;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_22__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_22",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan sebelum subseksyen (2) sebagaimana yang dinomborkan semula subseksyen yang berikut: “(1) Seksyen ini terpakai jika suatu notis bertulis mengenai keputusan yang dicadangkan di bawah seksyen 36 telah diberikan oleh Suruhanjaya kepada perusahaan dan Suruhanjaya telah menimbangkan representasi bertulis di bawah seksyen 36 atau representasi lisan di bawah seksyen 37 yang dibuat oleh perusahaan itu, jika ada.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_22__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_22__para_d__subpara_i",
