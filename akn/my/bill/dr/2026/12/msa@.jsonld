      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_24__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam nota bahu, dengan menggantikan perkataan “atau keputusan” dengan perkataan “, dsb.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_24__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_24",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (1) dengan subseksyen yang berikut: “(1) Suruhanjaya boleh membawa prosiding di hadapan Mahkamah Tinggi terhadap mana-mana perusahaan yang tidak mematuhi— (a) apa-apa arahan yang diberikan oleh Suruhanjaya di bawah seksyen 35; (b) apa-apa keputusan yang dibuat oleh Suruhanjaya di bawah seksyen 40; atau (c) apa-apa aku janji yang diterima oleh Suruhanjaya di bawah seksyen 43.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_24__para_c",
      "@type": "akn:paragraph",
