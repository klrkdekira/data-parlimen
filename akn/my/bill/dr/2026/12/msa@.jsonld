      "schema:text": {
        "@language": "ms",
        "@value": "dalam subperenggan (b)(ii), dengan memotong perkataan “atau” di hujung subperenggan itu; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_23__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_23__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan (b) perenggan yang berikut: “(ba) sama ada perusahaan itu telah memaksa perusahaan lain untuk terlibat dalam suatu perjanjian di bawah subseksyen 4(2); atau”. Pindaan seksyen 42"
      }
    },
