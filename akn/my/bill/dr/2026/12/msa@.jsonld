      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 41 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_23__para_a",
