      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_23__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_23__para_a",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam teks bahasa kebangsaan, dengan menggantikan perkataan “penurunan” dengan perkataan “pengurangan”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_23__para_a__subpara_ii",
      "@type": "akn:subparagraph",
