      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 20(1) Akta ibu dipinda dengan menggantikan perkataan “membenarkan Suruhanjaya” dengan perkataan “membenarkan pegawai Suruhanjaya”. Pindaan seksyen 21"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_11__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_11__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_11__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_11__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 21 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_11__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (1) dengan subseksyen yang berikut: “(1) Mana-mana orang hendaklah pada setiap masa memelihara kerahsiaan apa-apa maklumat berkenaan dengan perusahaan tertentu atau hal ehwal seseorang individu yang diperolehnya menurut kuasa mana-mana peruntukan Akta ini dan tidak boleh menzahirkan atau menggunakan mana-mana maklumat itu termasuk maklumat orang yang memberikan maklumat itu kepadanya.”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_11__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2), dengan menggantikan perkataan “maklumat” dengan perkataan “maklumat itu”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_11__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (3) dengan subseksyen yang berikut: “(3) Maklumat yang disebut dalam subseksyen (1) hendaklah berkait dengan maklumat mengenai perdagangan, perniagaan atau industri yang dipunyai oleh mana-mana orang, yang mempunyai nilai komersial atau ekonomi dan tidak tersedia secara amnya kepada atau diketahui oleh orang lain.”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_11__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (3) subseksyen yang berikut: “(4) Mana-mana orang yang melanggar subseksyen (1) melakukan suatu kesalahan.”. Pindaan seksyen 22"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_12__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_12__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 22(2) Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_12__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (a), dengan memasukkan selepas perkataan “maklumat” perkataan “, butir-butir”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_12__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (b), dengan memasukkan selepas perkataan “maklumat” perkataan “, butir-butir”. Pindaan seksyen 24"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan 24(a) Akta ibu dipinda dengan memasukkan selepas perkataan “atau mengubah” perkataan “atau cuba untuk memusnahkan, menyembunyikan, mencacatkan atau mengubah”. Pindaan seksyen 25"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_14__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_14__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 25 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_14__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1), dengan menggantikan perkataan “pelakuan suatu kesalahan” dengan perkataan “pelakuan apa-apa kesalahan”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_14__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2), dengan memasukkan selepas perkataan “atau benda lain” perkataan “atau salinan atau cabutan apa-apa rekod, buku, akaun, dokumen, data berkomputer atau benda lain”. Pindaan seksyen 34"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_15__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_15__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_15__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 34 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_15__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (1)(b), dengan memasukkan selepas perkataan “komersial” perkataan “, ekonomi”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_15__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_15",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (2) dengan subseksyen yang berikut: “(2) Bagi maksud dan tanpa menjejaskan keluasan perenggan (1)(b), keadaan merugikan dari segi komersial, ekonomi atau lain terhadap seseorang boleh termasuk— (a) pembayaran lewat amaun yang kena dibayar dengan sewajarnya kepada orang itu; (b) pembawaan atau penjalanan litigasi dengan tidak munasabah terhadap orang itu; (c) pembatalan pesanan yang dibuat dengan orang itu; (d) pengalihan perniagaan daripada orang itu atau keengganan untuk berdagang dengan orang itu; dan (e) penamatan kontrak dengan orang itu, penahanan pembayaran yang genap masa dan kena dibayar kepada orang itu di bawah kontrak atau keengganan untuk membuat kontrak selanjutnya dengan orang itu.”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_15__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/12/msa@/~cl_15__para_c__subpara_i",
