        "@value": "Control of Padi and Rice (Amendment) Bill 2026"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/13/eng@/~cl_1",
      "@type": "akn:clause",
