    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/13/eng@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/13/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Control of Padi and Rice (Amendment) Act 2026."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/13/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/13/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Amendment of section 4"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/13/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/13/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Control of Padi and Rice Act 1994 [Act 522], which is referred to as the “principal Act” in this Act, is amended in paragraph 4(2)(c), by substituting for the words “to fix” the words “to enforce”. Amendment of section 22"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/13/eng@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/13/eng@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/13/eng@/~cl_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/13/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 22 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/13/eng@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/13/eng@/~cl_3__para_a__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/13/eng@/~cl_3__para_a__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/13/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (1)—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/13/eng@/~cl_3__para_a__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/13/eng@/~cl_3__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words “fifteen thousand ringgit” the words “two hundred and fifty thousand ringgit”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/13/eng@/~cl_3__para_a__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/13/eng@/~cl_3__para_a",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words “twenty-five thousand ringgit” the words “five hundred thousand ringgit”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/13/eng@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/13/eng@/~cl_3__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/13/eng@/~cl_3__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/13/eng@/~cl_3__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/13/eng@/~cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (2)— Amendment of section 29"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/13/eng@/~cl_3__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/13/eng@/~cl_3__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after the words “any regulation made thereunder” the words “in respect of which no penalty is expressly provided for,”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/13/eng@/~cl_3__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/13/eng@/~cl_3__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words “twenty-five thousand ringgit” the words “five hundred thousand ringgit”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/13/eng@/~cl_3__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/13/eng@/~cl_3__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for the words “fifty thousand ringgit” the words “one million ringgit”."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/13/eng@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/13/eng@/~cl_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/13/eng@/~cl_4__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/13/eng@/~cl_4__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/13/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Section 29 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/13/eng@/~cl_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/13/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by renumbering the existing section as subsection (1);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/13/eng@/~cl_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/13/eng@/~cl_4__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/13/eng@/~cl_4__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/13/eng@/~cl_4__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/13/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "in subsection (1) as renumbered— “(da) prescribe the grades of rice and the price control for the graded rice; (db) make provisions relating to the prohibition, regulation or control of the movement of padi or rice; and”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/13/eng@/~cl_4__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/13/eng@/~cl_4__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "in paragraph (c), by inserting after the words “retailers,” the words “padi purchasers,”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/13/eng@/~cl_4__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/13/eng@/~cl_4__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after paragraph (d) the following paragraphs:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/13/eng@/~cl_4__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/13/eng@/~cl_4__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting paragraph (e); and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/13/eng@/~cl_4__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/13/eng@/~cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "by inserting after subsection (1) as renumbered the following subsection: “(2) Any regulations made under this Act may prescribe an act or omission in contravention of the regulations to be an offence and may prescribe penalties of a fine not exceeding fifteen thousand ringgit or to imprisonment for a term not exceeding six months or to both.”. Saving"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/13/eng@/~cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/13/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Any investigation or proceedings commenced or pending before the date of coming into operation of this Act shall, after the date of coming into operation of this Act, be continued as if the principal Act has not been amended by this Act."
      }
    }
  ]
}
