        "@language": "ms",
        "@value": "PENGAMAL KERJA SOSIAL DAN PELATIH KERJA SOSIAL Pendaftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_17__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Setiausaha Majlis hendaklah menjadi Pendaftar di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_17__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_17__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_17__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar hendaklah mempunyai kewajipan yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_17__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_17__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pengeluaran perakuan amalan, perakuan amalan sementara dan perakuan interim;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_17__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_17__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "penyenggaraan Daftar; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_17__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_17__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "untuk menjalankan apa-apa arahan lain sebagaimana yang ditentukan oleh Majlis. Daftar"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_18__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_18__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_18__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Pendaftar hendaklah menyimpan dan menyenggara suatu daftar yang dikenali sebagai “Daftar Pengamal Kerja Sosial dan Pelatih Kerja Sosial” dalam bentuk dan mengikut cara sebagaimana yang ditentukan oleh Majlis."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang boleh, setelah membayar fi yang ditetapkan, membuat suatu salinan atau mengambil cabutan daripada Daftar sebagaimana yang ditentukan oleh Majlis."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_18__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Daftar yang disenggara di bawah Akta ini hendaklah disifatkan menjadi suatu dokumen awam dalam pengertian Akta Keterangan 1950 [Akta 56]. Perakuan amalan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19__subsec_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang selain daripada pegawai awam yang berhasrat untuk memberikan perkhidmatan kerja sosial atau seseorang pegawai awam yang memberikan perkhidmatan kerja sosial di luar tugasnya sebagai pegawai awam hendaklah memohon kepada Majlis bagi suatu perakuan amalan, dalam bentuk dan mengikut cara sebagaimana yang ditetapkan dan permohonan itu hendaklah disertakan dengan fi yang ditetapkan, jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dia seorang warganegara Malaysia; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19__subsec_1__para_b__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19__subsec_1__para_b__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dia—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "memegang suatu ijazah sarjana muda dalam kerja sosial atau apa-apa ijazah sarjana muda yang berhubungan dengan kerja sosial; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "ialah seorang pekerja sosial berdaftar di suatu negara asing yang diiktiraf oleh Majlis; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19__subsec_1__para_b__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19__subsec_1__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "memegang apa-apa kelayakan lain sebagaimana yang ditetapkan termasuk kehendak bagi piawaian kompetensi yang diakreditasi; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dia telah memperoleh pengalaman dalam perkhidmatan kerja sosial bagi suatu tempoh sebagaimana yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Selepas menimbangkan permohonan itu, Majlis boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "meluluskan permohonan bagi perakuan amalan itu dan Pendaftar hendaklah mengeluarkan perakuan amalan kepada pemohon itu mengikut tatacara sebagaimana yang ditetapkan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menolak permohonan itu dan Pendaftar hendaklah memberitahu pemohon itu dengan memberikan sekurang-kurangnya tiga puluh hari notis secara bertulis."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu perakuan amalan hendaklah sah bagi tempoh dua tahun dari tarikh pengeluaran."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu permohonan bagi pembaharuan perakuan amalan hendaklah dibuat dalam tempoh tidak kurang dari sembilan puluh hari sebelum tarikh tamat tempoh perakuan amalan itu mengikut cara sebagaimana yang ditetapkan dan permohonan itu hendaklah disertakan dengan fi yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Selepas menimbangkan permohonan itu, Majlis boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "meluluskan permohonan bagi pembaharuan perakuan amalan itu dan Pendaftar hendaklah mengeluarkan perakuan amalan kepada pemohon itu mengikut tatacara sebagaimana yang ditetapkan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "menolak permohonan bagi pembaharuan perakuan amalan itu dan Pendaftar hendaklah memberitahu pemohon itu dengan memberikan sekurang-kurangnya tiga puluh hari notis secara bertulis."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa permohonan yang dibuat lewat dari tempoh yang dikehendaki di bawah subseksyen (4) tidak boleh dibenarkan melainkan jika suatu fi tambahan yang ditetapkan telah dibayar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang memegang perakuan amalan boleh, melalui notis secara bertulis, menyerahkan perakuan amalannya kepada Majlis dan penyerahan itu hendaklah berkuat kuasa pada tarikh Majlis menerima perakuan amalan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_19",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada apa-apa pun dalam seksyen ini boleh ditafsirkan sebagai menghalang seorang pegawai awam untuk memberikan perkhidmatan kerja sosial dalam menjalankan tugasnya sebagai pegawai awam tanpa memegang suatu perakuan amalan. Perakuan amalan sementara"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_20__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_20__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_20__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_20__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_20__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_20__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_20__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_20__subsec_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_20__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang bukan warganegara Malaysia yang berhasrat untuk memberikan perkhidmatan kerja sosial, atau seseorang majikan yang berhasrat untuk menggaji orang itu hendaklah memohon kepada Majlis bagi suatu perakuan amalan sementara dalam bentuk dan mengikut cara sebagaimana yang ditetapkan dan permohonan itu hendaklah disertakan dengan fi yang ditetapkan, jika dia memenuhi kehendak prasyarat sebagaimana yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_20__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_20__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_20__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Selepas menimbangkan permohonan itu, Majlis boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_20__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_20__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "meluluskan permohonan bagi perakuan amalan sementara itu dan Pendaftar hendaklah mengeluarkan perakuan amalan sementara kepada pemohon itu mengikut tatacara sebagaimana yang ditetapkan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_20__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_20__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menolak permohonan itu dan Pendaftar hendaklah memberitahu pemohon itu dengan memberikan sekurang-kurangnya tiga puluh hari notis secara bertulis."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_20__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu perakuan amalan sementara hendaklah sah bagi tempoh satu tahun dari tarikh pengeluaran."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_20__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu permohonan bagi pembaharuan perakuan amalan sementara hendaklah dibuat dalam tempoh tidak kurang dari enam puluh hari sebelum tarikh tamat tempoh perakuan amalan sementara itu mengikut cara sebagaimana yang ditetapkan dan permohonan itu hendaklah disertakan dengan fi yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_20__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_20__subsec_5__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_20__subsec_5__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Selepas menimbangkan permohonan itu, Majlis boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_20__subsec_5__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_20__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "meluluskan permohonan bagi pembaharuan perakuan amalan sementara itu dan Pendaftar hendaklah mengeluarkan perakuan amalan sementara kepada pemohon itu mengikut tatacara sebagaimana yang ditetapkan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_20__subsec_5__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_20__subsec_5",
      "schema:text": {
        "@language": "ms",
        "@value": "menolak permohonan bagi pembaharuan perakuan amalan sementara dan Pendaftar hendaklah memberitahu pemohon itu dengan memberikan sekurang-kurangnya tiga puluh hari notis secara bertulis."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_20__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa permohonan yang dibuat lewat dari tempoh yang dikehendaki di bawah subseksyen (4) tidak boleh dibenarkan melainkan jika suatu fi tambahan yang ditetapkan telah dibayar."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_20__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu perakuan amalan sementara boleh diperbaharui oleh Majlis sekali sahaja bagi tempoh satu tahun apabila tamat tempohnya."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_20__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang memegang perakuan amalan sementara boleh, melalui notis secara bertulis, menyerahkan perakuan amalan sementaranya kepada Majlis dan penyerahan itu hendaklah berkuat kuasa pada tarikh Majlis menerima perakuan amalan sementara itu. Perakuan interim"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_21__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_21__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_21__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_21__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_21__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_21__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_21__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang hendaklah memohon kepada Majlis bagi suatu perakuan interim, semata-mata bagi maksud mendapatkan pengalaman dalam perkhidmatan kerja sosial bagi tempoh satu tahun, dalam bentuk dan mengikut cara sebagaimana yang ditetapkan dan permohonan itu hendaklah disertakan dengan fi yang ditetapkan, jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_21__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_21__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dia ialah seorang warganegara Malaysia; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_21__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_21__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dia memegang suatu ijazah sarjana muda dalam kerja sosial atau apa-apa ijazah sarjana muda yang berhubungan dengan kerja sosial; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_21__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_21__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "dia memegang apa-apa kelayakan lain sebagaimana yang ditetapkan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_21__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_21__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_21__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Selepas menimbangkan permohonan itu, Majlis boleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/14/msa@/~part_III__cl_21__subsec_2__para_a",
      "@type": "akn:paragraph",
