        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_II__cl_4__subsec_7"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_II__cl_4__subsec_1",
      "@type": "akn:subsection",
