      "schema:text": {
        "@language": "en",
        "@value": "PRELIMINARY Short title and commencement"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_II",
      "@type": "akn:part",
      "eli:number": "II",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_II__cl_4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "ADMIRALTY JURISDICTION OF HIGH COURT Admiralty jurisdiction of High Court"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III",
      "@type": "akn:part",
      "eli:number": "III",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "MODE OF EXERCISE OF ADMIRALTY JURISDICTION Action in personam"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to section 6, all claims or disputes under this Act may be commenced in the High Court as an action in personam. Restriction on action in personam in certain cases"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_6__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_6__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_6__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_6__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_6__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The claim referred to under paragraph 4(1)(g) shall only be commenced in the High Court as an action in personam if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_6__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_6__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the defendant has his habitual residence or has a place of business in Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_6__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_6__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the cause of action arose within the territorial waters of Malaysia, the inland waters of Malaysia or the limits of a port of Malaysia; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_6__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_6__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "an action arising out of the same incident or series of incidents is proceeding in the High Court or has been heard and determined in the High Court."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "Any action to enforce a claim under paragraph 4(1)(g) shall not be commenced in the High Court as an action in personam until any proceeding previously commenced by the plaintiff in any court outside Malaysia against the same defendant in respect of the same incident or series of incidents has been discontinued or otherwise come to an end."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "Subsections (1) and (2) shall apply to counterclaims except for counterclaims in proceedings arising out of the same incident or series of incidents."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_6__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "Subsections (1) and (2) shall not apply to any action or counterclaim if the defendant submits or has agreed to submit to the jurisdiction of the High Court. Action in rem"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_7__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_7__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_7__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_7__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_7__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_7__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_7__subsec_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "Any claim or dispute referred to in paragraph 4(1)(a), (b), (c) or (v) may be commenced in the High Court as an action in rem against the related ship or property."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "An action in rem may be commenced against a ship, aircraft or property in the High Court if there is a maritime lien or other charge on the ship, aircraft or property for the amount claimed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_7__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_7__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_7__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "If any claim or dispute referred to in the paragraphs 4(1)(e), (f), (h), (j) to (o) and (q) to (u) arises in connection with a ship and the person who would be liable on the claim in an action in personam was, when the cause of action arose, the owner, charterer, in possession of or in control of the ship, an action in rem may, regardless of whether or not the claim gives rise to a maritime lien on the ship, be commenced against—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_7__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_7__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "that ship, if at the time when the action is brought, such person is either the beneficial owner of that ship and all the shares in the ship or the charterer of the ship under a bareboat charterparty agreement; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_7__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_7__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "any of his other ship, if at the time when the action is brought, such person is either the beneficial owner of that ship and all the shares in the ship or the charterer of the ship under a bareboat charterparty agreement."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_7__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_7__subsec_4__para_n",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "For the purpose of the claim under paragraphs 4(1)(m) and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_7__subsec_4__para_n",
      "@type": "akn:paragraph",
      "eli:number": "n",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_7__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "in respect of an aircraft, an action in rem may be brought in the High Court against the aircraft if at the time the action is brought, the aircraft is beneficially owned by the person who would be liable on the claim in an action in personam."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_7__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "If any claim referred to in paragraph 4(1)(m) or (n) arises in connection with an aircraft and the person who would be liable on the claim in an action in personam was, when the cause of action arose, the beneficial owner of the aircraft, an action in rem may be commenced against the aircraft."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_7__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "In determining whether a person would be liable on a claim in an action in personam under subsections (3) and (4), the person shall be presumed to have his habitual residence or a place of business within Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_7__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "If a ship or property has been sold under this Act, any action in rem that could have been brought against the ship or property may be brought against the proceeds of the sale of the ship or property provided that the proceeds remains held by the High Court."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_7__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "Any service of a warrant of arrest in an action in rem against a ship under paragraphs 4(1)(e), (f), (h), (j) to (o) and (q) to (u) shall preclude the service of a warrant of arrest against any other ship for the same claim without affecting the right of the claimant to initially issue a writ naming multiple ships or issue multiple writs each naming a different ship. Action for wages"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "Nothing in this Act shall be construed as limiting the jurisdiction of the High Court to refuse to hear an action for wages commenced by a seafarer or his heir, where the action concerns a ship other than a Malaysian ship."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
