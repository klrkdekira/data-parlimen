        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_II__cl_4__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/17/eng@/~part_II__cl_4__subsec_4",
