        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/18/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/18/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/18/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/18/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Komunikasi dan Multimedia (Pindaan) 2026."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/18/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/18/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta. Pindaan seksyen 202"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/18/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/18/msa@/~cl_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/18/msa@/~cl_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/18/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Akta Komunikasi dan Multimedia 1998 [Akta 588] dipinda dalam seksyen 202—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/18/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/18/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas subseksyen (1) subseksyen yang berikut: “(1a) Walau apa pun subseksyen (1), Menteri boleh mengarahkan Suruhanjaya untuk menyokong suatu inisiatif pemberian perkhidmatan sejagat kebangsaan yang berhubungan dengan penggunaan perkhidmatan rangkaian atau perkhidmatan aplikasi atau kedua-duanya dengan menggalakkan pemasangan kemudahan rangkaian dan penyediaan perkhidmatan rangkaian atau perkhidmatan aplikasi atau kedua-duanya bagi pemeliharaan keselamatan negara yang penentuan keselamatan negara itu hendaklah dibuat oleh Majlis Keselamatan Negara mengikut seksyen 4 Akta Majlis Keselamatan Negara 2016 [Akta 776]. (1b) Apa-apa inisiatif pemberian perkhidmatan sejagat kebangsaan di bawah subseksyen (1a) hendaklah selaras dengan matlamat Akta ini.”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/18/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/18/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (2), dengan menggantikan perkataan “subseksyen (1)” dengan perkataan “subseksyen (1) dan (1a)”."
      }
    }
  ]
}
