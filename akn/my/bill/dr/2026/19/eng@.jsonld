      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/19/eng@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/19/eng@/~cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/19/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The principal Act is amended by inserting after section 18 the following section: “Register of direction by Minister 18a. (1) The Commission shall maintain a register, in both physical form and electronic media, of all matters which are required to be registered under section 18. (2) Any person may, on payment of the fee, if any, imposed by the Commission— (a) inspect the register; and (b) make a copy of, or take extracts from, the register. (3) If a person requests that a copy be provided in an electronic media, the Commission may provide the relevant information— (a) by using a data processing device; or (b) by way of electronic transmission.”. Amendment of section 20"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/19/eng@/~cl_11",
      "@type": "akn:clause",
