      "schema:text": {
        "@language": "en",
        "@value": "Section 23 of the principal Act is amended by substituting for the words “, with the approval of the Minister, make regulations with respect to” the word “determine”. Amendment of section 38"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/19/eng@/~cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/19/eng@/~cl_14__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/19/eng@/~cl_14__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/19/eng@",
      "schema:name": {
        "@language": "en",
        "@value": "Paragraph 38(2)(c) of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/19/eng@/~cl_14__para_a",
      "@type": "akn:paragraph",
