      "schema:text": {
        "@language": "ms",
        "@value": "dalam nota bahu, dengan menggantikan perkataan “ketua eksekutif” dengan perkataan “ketua pegawai eksekutif”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/19/msa@/~cl_11__para_b",
