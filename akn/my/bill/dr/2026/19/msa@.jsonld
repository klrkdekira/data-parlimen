      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 20 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/19/msa@/~cl_11__para_a",
