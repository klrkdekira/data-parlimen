      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (5), dengan menggantikan perkataan “Ketua eksekutif” dengan perkataan “Ketua pegawai eksekutif”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/19/msa@/~cl_11__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/19/msa@/~cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (6), dengan menggantikan perkataan “ketua eksekutif” dengan perkataan “ketua pegawai eksekutif”. Pindaan seksyen 21"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/19/msa@/~cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/19/msa@/~cl_12__para_a",
