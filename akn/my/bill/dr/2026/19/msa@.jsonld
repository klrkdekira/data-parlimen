      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (4), dengan menggantikan perkataan “Ketua eksekutif” dengan perkataan “Ketua pegawai eksekutif”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/19/msa@/~cl_11__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
