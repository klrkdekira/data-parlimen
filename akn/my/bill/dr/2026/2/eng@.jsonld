      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/2/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Capitation Grant Act 2026."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/2/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/2/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on 1 April 2026. Amendment of Part I of the Tenth Schedule to the Federal Constitution"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/2/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/2/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "Subsection 1(1) of Part I of the Tenth Schedule to the Federal Constitution is amended by substituting for paragraphs (a), (b), (c) and (d) the following paragraphs: “(a) for the first 100,000 persons at the rate of RM102.00 per person; (b) for the next 500,000 persons at the rate of RM14.00 per person; (c) for the next 500,000 persons at the rate of RM13.50 per person; (d) for the remainder at the rate of RM13.00 per person,”."
      }
    }
