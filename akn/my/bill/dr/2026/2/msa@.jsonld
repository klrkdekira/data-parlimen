      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/2/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Pemberian Mengikut Bilangan Orang 2026."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/2/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/2/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada 1 April 2026. Pindaan Bahagian I Jadual Kesepuluh kepada Perlembagaan Persekutuan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/2/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/2/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 1(1) Bahagian I Jadual Kesepuluh kepada Perlembagaan Persekutuan dipinda dengan menggantikan perenggan (a), (b), (c) dan (d) dengan perenggan yang berikut: “(a) bagi 100,000 orang yang pertama mengikut kadar RM102.00 bagi tiap-tiap orang; (b) bagi 500,000 orang yang berikutnya mengikut kadar RM14.00 bagi tiap-tiap orang; (c) bagi 500,000 orang yang berikutnya mengikut kadar RM13.50 bagi tiap-tiap orang; (d) bagi yang selebihnya mengikut kadar RM13.00 tiap-tiap orang,”."
      }
    }
