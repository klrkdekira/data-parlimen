        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_21__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_21__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_21__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_21__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_21__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_21__subsec_1__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_21__subsec_1__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_21__subsec_1__para_i"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "Each public authority may publish, as frequently as may be necessary, the following information:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_21__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_21__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "details of its organisational structure, including any entities under its purview;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_21__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_21__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "description of its functions and powers;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_21__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_21__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "general contact details and official working hours;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_21__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_21__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "details of the services provided including relevant forms and standard operating procedures;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_21__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_21__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "public complaints management system;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_21__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_21__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "applicable law including regulations and guidelines;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_21__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_21__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "general information and strategic plans of the agency;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_21__subsec_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_21__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the number of requests made under this Act and the number of requests allowed under this Act; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_21__subsec_1__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_21__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "contact details of the appointed officer responsible for matters relating to the request for access to information under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_21__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of subsection (1), the publication of information to the public may be made through websites, print media, digital media or any other form of information dissemination to the public as deemed appropriate by the public authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_21__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_21",
      "schema:text": {
        "@language": "en",
        "@value": "The information published under subsection (1) shall not include any information that identifies or is capable of identifying, any person making the request or any other person. Construction of this Act"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "Nothing in this Act shall be construed as fundamental liberties under Part II of the Federal Constitution. Power to make regulations"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_23__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_23__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_23__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "The Prime Minister may make regulations as may be necessary or expedient for the purpose of carrying into effect the provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_23__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_23__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_23__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_23__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_23__subsec_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_23",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to the generality of subsection (1), the Prime Minister may make regulations for or in respect of all or of the following matters:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_23__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_23__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the procedure for request for access to information;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_23__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_23__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the forms to be used;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_23__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_23__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the procedure for internal review by public authority;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_23__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_23__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the procedure for external review by the Ombudsman."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_V__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who is aggrieved with the decision of the head of public authority under section 11 may submit the decision for a review by the Ombudsman. Decision of Ombudsman"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_V__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_V__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_V__cl_14__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_V__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_V__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "Subject to section 9, the Ombudsman may affirm, vary or set aside the decision of the head of public authority after reviewing the decision."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_V__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_V__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "Any decision made by the Ombudsman under subsection (1) shall be communicated in writing to the aggrieved person. Non-application"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_V__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "The investigation powers conferred upon the Ombudsman under ... of the Ombudsman Act 20… [Act …] is not applicable to this Part. Judicial review"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_V__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "A person aggrieved by the decision of the Ombudsman or the public authority under this Act may apply to the High Court for judicial review. Obligation of secrecy"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_V__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_V__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_V__cl_17__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_V__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_V__cl_17__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_V__cl_17__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_V__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "Except for any of the purposes of this Act or for the purposes of any civil or criminal proceedings under any written law—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_V__cl_17__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_V__cl_17__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "no member, officer or staff of the Ombudsman, whether during or after his tenure of office or employment, shall disclose any information or document obtained by him in the course of his employment under this Act; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_V__cl_17__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_V__cl_17__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "no other person who has by any means access to any information or documents relating to information under this Act shall disclose such information or document."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_V__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_V__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) commits an offence and shall, on conviction, be liable to imprisonment for a term not exceeding five years or to a fine not exceeding one hundred thousand ringgit or to both."
      }
    }
  ]
}
