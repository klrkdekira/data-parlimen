      "schema:text": {
        "@language": "en",
        "@value": "the local authorities of the Federal Territories of Kuala Lumpur, Labuan and Putrajaya; “official secret” has the meaning assigned to it under the Official Secrets Act 1972 [Act 88]; “official” relates to any public authority."
      }
    },
