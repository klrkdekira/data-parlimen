        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I__cl_3__list_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I__cl_3"
    },
