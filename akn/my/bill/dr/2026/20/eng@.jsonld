      ],
      "schema:name": {
        "@language": "en",
        "@value": "Freedom of Information Bill 2026"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I",
      "@type": "akn:part",
      "eli:number": "I",
