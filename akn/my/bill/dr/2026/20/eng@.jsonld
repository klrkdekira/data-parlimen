      "schema:text": {
        "@language": "en",
        "@value": "the statutory body of the Federal Government established under an Act of Parliament; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I__cl_3__list_2__para_d",
