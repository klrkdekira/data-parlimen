      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_18__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_18__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "uses any information obtained under this Act that is contrary to the purpose of such request;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_18__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_18__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "gives false information in the request made under section 5;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_18__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_18__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "unlawfully destroys, erases, alters, damages, conceals, blocks or falsify any information within the control of the public authority with the intention of unlawfully preventing disclosure of any information or any part thereof or obstructing the request for access to any information, commits an offence and shall, on conviction, be liable to a fine not exceeding one hundred thousand ringgit or to imprisonment for a term not exceeding five years or to both. Prosecution"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "No prosecution shall be instituted for an offence under this Act without the consent in writing of the Public Prosecutor. Protection against action for defamation, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_20__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_20__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "Unless it can be proven that the act, neglect or default was done or omitted in bad faith and without reasonable cause, no action for defamation, breach of confidence or infringement of copyright may be brought, instituted or maintained in any court against the public authority, or any officer or employee of the public authority, on account of or in respect of any act, neglect or default was done or omitted by him in the course of his duties under this Act—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_20__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "as a result of allowing the request for access to information; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_20__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_20__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_20__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_20",
      "schema:text": {
        "@language": "en",
        "@value": "in respect of any publication involved in the allowing of the request for access to information by the public authority against—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_20__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_20__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "any person who was the author of the document; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_20__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_20__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "any person as a result of that person having supplied the document or the information contained in it to the public authority. Publication of public information and proactive disclosure"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_21__subsec_1",
