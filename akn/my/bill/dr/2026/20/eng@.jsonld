    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_VI__cl_21__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
