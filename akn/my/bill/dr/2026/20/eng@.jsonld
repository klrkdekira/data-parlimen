        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I__cl_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "PRELIMINARY Short title and commencement"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_II",
      "@type": "akn:part",
      "eli:number": "II",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_II__cl_4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "APPOINTED OFFICER Appointment of appointed officer"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III",
      "@type": "akn:part",
      "eli:number": "III",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_11"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "PROCEDURE OF REQUEST Request for access"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "A public authority which receives a request may defer access to the requested information if such information has been submitted for and is pending publication for any proceedings in Parliament or released to the media and shall inform the person reasons for the deferment and indicate, as far as practicable, the period of the deferment. Internal review"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_11__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_11__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "Any person aggrieved by the decision of the public authority in relation to the request made may, within fourteen working days after the date of receipt of the notice informing such refusal under subsection 9(2), appeal in writing to the head of public authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "The head of public authority may, after considering the appeal made under subsection (1) affirm, vary or set aside the decision of the public authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_11__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "Any decision made by the head of public authority under subsection (2) shall be communicated in writing to the aggrieved person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_5__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_5__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_5__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_5__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "A person who is a citizen of Malaysia aged eighteen years and above may request for access to information under this Act which is in the control of the public authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_5__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_5__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_5__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "A person mentioned under subsection (1) may request on behalf of a third party if the person is—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_5__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the legal guardian of the third party;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_5__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the legal heir; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_5__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_5__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the legal administrator of a deceased party."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_5__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_5__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_5__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_5__subsec_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_5__subsec_3__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_5__subsec_3__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "A person mentioned under subsection (1) or (2) may request for access to information by making a written request to the public authority specifying the particulars of information as follows:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_5__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_5__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the person’s name, identification card number, residential address and postcode, and contact details;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_5__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_5__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "in the case where the person is requesting for access to information on behalf of a corporate or an unincorporated body, the name, registration number, registered address and postcode and contact details of the corporate or unincorporated body;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_5__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_5__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "in the case where the person is requesting for access to information acts in the capacity under subsection (2), the relevant document as proof of such capacity;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_5__subsec_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_5__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the requested information; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_5__subsec_3__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_5__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the specific purpose of the request as specified under section 6."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_5__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "A request made under this section shall be submitted together with the payment of fee as may be prescribed by the Yang di-Pertuan Agong by an order."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_5__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "Upon receipt of the request, the appointed officer shall provide a written acknowledgement of the request to the person. Purpose of request"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_6__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_6__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_6__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_6__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_6__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "A request for access to information under section 5 may be allowed for the following purposes:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_6__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_6__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "verifying and making correction to personal information or personal information of a third party in the case mentioned under subsection 5(2);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_6__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_6__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "research or educational purposes conducted for non-commercial purpose by any student, apprentice or trainee, or a researcher or resident scholar in a higher educational institution or research institution in Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_6__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_6__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "reporting, publication or dissemination of information by a media practitioner to the public; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_6__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_6__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "any other purpose not contrary to any written law where that person has proper and tangible interest and has been prejudiced by the act of the public authority."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The purpose mentioned under subsection (1) shall not provide a person, the press or media, a right to access to information."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "For the purposes of this section, “media practitioner” has the meaning assigned to it under the Malaysian Media Council Act 2025 [Act 868]. Verification of request"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "The appointed officer may require the person making a request under section 5 to provide reasonable proof of identity and citizenship, or any other information or document relating to the request in the manner as may be determined by the public authority. Decision of request"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_8__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_8__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_8__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_8__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "The public authority shall, within fifteen working days after the receipt of the request under section 5, make a decision to allow the request to access the information requested or to reject the request on any grounds referred to in section 9, and shall immediately communicate such decision to the person."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "Where a decision is made to allow the request to access the information requested for under subsection (1), such information shall be given to the person within fourteen working days from the date the decision is made."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_8__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_8__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_8__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "Notwithstanding subsection (1), where the request for access to information is made by a person that concerns the life and liberty of an individual, the public authority shall—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_8__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_8__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "within forty-eight hours of the receipt of such request, make a decision to allow the request or to reject the request on any grounds referred to in section 9; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_8__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_8__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "in the case where the request is allowed, provide such information to the person as soon as practicable within fourteen working days from the date the decision is made under paragraph (a)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_8__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_8__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_8__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "The public authority may extend the period referred to in subsection (2) or paragraph (3)(b) for a further period of not more than twenty-one working days or any other reasonable period where—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_8__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_8__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "the request involves large number of documents and providing the information within fourteen working days would unreasonably interfere with the activities of the public authority; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_8__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_8__subsec_4",
      "schema:text": {
        "@language": "en",
        "@value": "the request requires a search for records in the office of the public authority situated in a different State, city or district."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_8__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_8",
      "schema:text": {
        "@language": "en",
        "@value": "Where a period for providing the information is extended due to any circumstances referred to in subsection (4), the appointed officer shall, within fourteen working days from the date of the expiry of the period provided under subsection (2) or paragraph (3)(b), notify the person the period of the extension and reasons for the extension. Refusal of request"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_9__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_9__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_9__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_9__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_9__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_9__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_9__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_9__subsec_1__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "The request for access to information under section 5 may be refused by the public authority, for the following reasons:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_9__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_9__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the requested information is an exempted information under Part IV;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_9__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_9__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the requested information is publicly available;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_9__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_9__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the requested information does not exist or is not within the control of the public authority;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_9__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_9__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "subject to subsection (3), the requested information contains personal information of third party;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_9__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_9__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the request is vexatious or unreasonable; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_9__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_9__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the request for access to information has been made and rejected within the previous six months unless the person provides a reasonable explanation for the request for the same information."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_9__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_9__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "When the request for access to information is refused under subsection (1), the appointed officer shall notify the person of such refusal in writing within the period provided in subsection 8(1) or paragraph 8(3)(a), as the case may be, and such written notice shall—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_9__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_9__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "state the reasons of the refusal of the request as specified under subsection (1); and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_9__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_9__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "inform the person of the procedures to appeal to the head of public authority against the refusal."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_9__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_9__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_9__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_9__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "Paragraph (1)(d) does not apply if—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_9__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_9__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the person making the request has obtained written consent from the third party to the disclosure of the information;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_9__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_9__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the person is the legal guardian of the third party or the legal heir; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_9__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_III__cl_9__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "the person is the legal administrator of a deceased third party. Deferment of access"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_II",
      "schema:text": {
        "@language": "en",
        "@value": "The responsible Minister shall appoint one or more officers within the public authority as appointed officers to process a request for access to information under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "EXEMPTED INFORMATION Exempted information"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_j",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_k",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_l",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_m",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_n",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_o",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_p",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_q"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV",
      "schema:name": {
        "@language": "en",
        "@value": "An information shall be exempted where—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "the information is relating to official documents, official secrets, secrets, confidential information or information protected under other written laws;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "the information relates to the detection, prevention, enforcement, investigation or prosecution of any breach or non-compliance of any law;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "the information will disclose or allow someone to determine the identity of a confidential source of information related to the law enforcement or the administration of justice;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "the information will disclose the existence or identity of a person included in a witness protection program;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "the information will disclose the investigative steps or procedures, including the intelligence gathering methodologies, the investigative techniques or technologies, the covert practices, or the information sharing arrangements between law enforcement agencies;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "the information will prejudice or obstruct the assessment or collection of any tax, duty or penalty;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "the information would likely endanger the life, safety, health or welfare of any person or group of persons;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "the information would likely disclose trade secrets of the public authority or of any other person;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "the disclosure of the information would be likely to prejudice the commercial, financial, economy or property interests of the public authority;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "the disclosure of the information would be likely to prejudice the conduct of any research undertaken by a public authority or any person;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_k__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_k__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_k__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "the information is obtained—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_k__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_k",
      "schema:text": {
        "@language": "en",
        "@value": "from a third party and to communicate it would constitute an actionable breach of confidence;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_k__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_k",
      "schema:text": {
        "@language": "en",
        "@value": "in confidence from a third party and it contains a trade secret or to communicate it would, or would be likely to, seriously prejudice the commercial or financial interests of the third party; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_k__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_k",
      "schema:text": {
        "@language": "en",
        "@value": "in confidence from another State or international organization, and to communicate it would, or would likely to, seriously prejudice relations with that State or international organization;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_l",
      "@type": "akn:paragraph",
      "eli:number": "l",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_l__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_l__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_l__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "the disclosure of the information would breach one or more of the following:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_l__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_l",
      "schema:text": {
        "@language": "en",
        "@value": "an agreement or contract;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_l__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_l",
      "schema:text": {
        "@language": "en",
        "@value": "a duty of confidentiality in equity; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_l__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_l",
      "schema:text": {
        "@language": "en",
        "@value": "a court or tribunal order;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_m",
      "@type": "akn:paragraph",
      "eli:number": "m",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_m__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_m__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_m__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_m__subpara_iv"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "the information is relating to—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_m__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_m",
      "schema:text": {
        "@language": "en",
        "@value": "legal professional privilege or solicitor-client privilege;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_m__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_m",
      "schema:text": {
        "@language": "en",
        "@value": "confidentiality of doctor and patient or privilege of the medical profession;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_m__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_m",
      "schema:text": {
        "@language": "en",
        "@value": "the administration of justice of courts including any judicial proceedings, whether civil or criminal, mediation proceedings and pre-trial case management and an inquest or inquiry into a death;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_m__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_m",
      "schema:text": {
        "@language": "en",
        "@value": "any proceedings before a tribunal or a board;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_n",
      "@type": "akn:paragraph",
      "eli:number": "n",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "the information would disclose matter in the nature of opinion, advice or recommendation prepared by an officer of the public authority or Minister, or consultation or deliberation that has taken place between officers of the public authority, Ministers, or an officer of the public authority and a Minister, in the course of, or for the purpose of, the deliberative processes involved in the functions of a public authority;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_o",
      "@type": "akn:paragraph",
      "eli:number": "o",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "the information would involve disclosure of personal information of an individual, including a deceased individual;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_p",
      "@type": "akn:paragraph",
      "eli:number": "p",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "the information would involve any unpublished broadcasting material, public communication material, media content, draft publication or strategic communication prepared by or for a public authority and intended for future publication, broadcast or public dissemination; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12__para_q",
      "@type": "akn:paragraph",
      "eli:number": "q",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_IV__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "the information would disclose the source of any information obtained in the course of making any programme or broadcast."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I__cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Freedom of Information Act 2026."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Prime Minister by notification in the Gazette. Application"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I__cl_2__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I__cl_2__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I__cl_2__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I__cl_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I__cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall apply to the Federal Government."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I__cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I__cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall provide for the procedure to request for access to information subject to the exempted information under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I__cl_2__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I__cl_2",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall be read together with the provisions of other written laws which allow for access to official documents or information, subject to the conditions provided under such laws, and the provisions of this Act shall be in addition to, and not in derogation of, the provisions of the relevant written laws. Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I__cl_3__list_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I__cl_3__list_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I",
      "schema:name": {
        "@language": "en",
        "@value": "In this Act, unless the context otherwise requires—"
      },
      "schema:text": {
        "@language": "en",
        "@value": "“document” has the meaning assigned to it under the Evidence Act 1950 [Act 56]; “head of public authority” means the public officer charged with the responsibility in respect of any Ministry, department or any public service; “information” means any information contained in any official document within the control of the public authority excluding the matters mentioned under section 9; “personal information” means information about an individual, including—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I__cl_3__list_1",
      "@type": "akn:list",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I__cl_3__list_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I__cl_3__list_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I__cl_3__list_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I__cl_3__list_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I__cl_3__list_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I__cl_3__list_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I__cl_3__list_1__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I__cl_3__list_1__para_h"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I__cl_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I__cl_3__list_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I__cl_3__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "information relating to the race, national or ethnic origin, religion, age, sex or marital or family status of the individual;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I__cl_3__list_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I__cl_3__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "information relating to the education or the medical, psychiatric, psychological, criminal or employment history of the individual or information relating to financial transactions in which the individual has been involved;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I__cl_3__list_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I__cl_3__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "any identifying number, symbol or other particular assigned to the individual;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I__cl_3__list_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I__cl_3__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "the address, telephone number, fingerprints or blood type of the individual;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I__cl_3__list_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I__cl_3__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "the correspondence sent to a public authority by the individual that is private or confidential in nature, and replies to that correspondence that would reveal the contents of the original correspondence;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I__cl_3__list_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I__cl_3__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "the individual’s name where it appears with other personal information relating to the individual or where the disclosure of the name would reveal other personal information about the individual;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I__cl_3__list_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I__cl_3__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "the personal opinions or views of the individual except where they relate to another individual; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I__cl_3__list_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I__cl_3__list_1",
      "schema:text": {
        "@language": "en",
        "@value": "the views or opinions of another individual about the individual; “exempted information” means the information as specified under section 12; “responsible Minister” means each Minister who is respectively charged with the responsibility in respect of the functions in accordance with the Ministerial Functions Act 1969 [Act 2]; “Ombudsman” has the meaning assigned to it under the Ombudsman Act 20… [Act …]; “appointed officer” means the officer appointed under section 4; “public authority” means—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/eng@/~part_I__cl_3__list_2",
      "@type": "akn:list",
