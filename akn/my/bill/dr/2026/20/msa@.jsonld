    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_18__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_18__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_18__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_18__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_18__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "menggunakan apa-apa maklumat yang diperoleh di bawah Akta ini yang bertentangan dengan tujuan permintaan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_18__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_18__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "memberikan maklumat palsu dalam permintaan yang dibuat di bawah seksyen 5;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_18__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_18__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "secara menyalahi undang-undang memusnahkan, memadamkan, mengubah, merosakkan, menyembunyikan, menyekat atau memalsukan apa-apa maklumat yang berada dalam kawalan pihak berkuasa awam dengan niat untuk menghalang secara menyalahi undang-undang pendedahan apa-apa maklumat atau mana-mana bahagiannya atau menghalang permintaan untuk mendapatkan akses kepada apa-apa maklumat, melakukan suatu kesalahan dan boleh, apabila disabitkan, didenda tidak melebihi satu ratus ribu ringgit atau dipenjarakan selama tempoh yang tidak melebihi lima tahun atau kedua-duanya. Pendakwaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada pendakwaan boleh dimulakan bagi suatu kesalahan di bawah Akta ini tanpa keizinan secara bertulis Pendakwa Raya. Perlindungan terhadap tindakan bagi fitnah, dll."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_20__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_20__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Melainkan jika dibuktikan bahawa perbuatan, pengabaian atau keingkaran itu dilakukan atau ditinggalkan dengan niat jahat dan tanpa sebab yang munasabah, tiada tindakan bagi fitnah, pecah kepercayaan atau pelanggaran hak cipta boleh dibawa, dimulakan atau dikekalkan dalam mana-mana mahkamah terhadap pihak berkuasa awam, atau mana-mana pegawai atau pekerja pihak berkuasa awam, disebabkan atau berkenaan dengan apa-apa perbuatan, pengabaian atau keingkaran yang dilakukan atau ditinggalkan olehnya semasa menjalankan kewajipannya di bawah Akta ini—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_20__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "berikutan dengan membenarkan permintaan untuk mendapatkan akses kepada maklumat; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_20__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_20__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_20__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_20",
      "schema:text": {
        "@language": "ms",
        "@value": "berkenaan dengan apa-apa penerbitan yang terlibat dalam membenarkan permintaan untuk mendapatkan akses kepada maklumat oleh pihak berkuasa awam terhadap—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_20__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_20__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang yang merupakan pengarang dokumen itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_20__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_20__para_b",
      "schema:text": {
        "@language": "ms",
        "@value": "mana-mana orang berikutan dengan orang itu telah membekalkan dokumen itu atau maklumat yang terkandung di dalamnya kepada pihak berkuasa awam. Penerbitan maklumat awam dan penzahiran proaktif"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_21__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_21__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_21__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_21__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_21__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_21__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_21__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_21__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_21__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_21__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_21__subsec_1__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_21__subsec_1__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_21__subsec_1__para_i"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiap-tiap pihak berkuasa awam boleh menerbitkan, seberapa kerap yang perlu, maklumat yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_21__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_21__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "butiran struktur organisasinya, termasuk mana-mana entiti di bawah seliaannya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_21__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_21__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "perihalan fungsi dan kuasanya;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_21__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_21__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "butir-butir am untuk dihubungi dan waktu bekerja rasmi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_21__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_21__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "butir-butir perkhidmatan yang disediakan termasuk borang berkaitan dan prosedur operasi standard;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_21__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_21__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "sistem pengurusan aduan awam;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_21__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_21__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "undang-undang yang terpakai termasuk peraturan-peraturan dan garis panduan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_21__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_21__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "maklumat am dan pelan strategik agensi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_21__subsec_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_21__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "bilangan permintaan yang dibuat di bawah Akta ini dan bilangan permintaan yang dibenarkan di bawah Akta ini; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_21__subsec_1__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_21__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "butir-butir untuk dihubungi bagi pegawai yang dilantik yang bertanggungjawab bagi perkara yang berhubungan dengan permintaan untuk mendapatkan akses kepada maklumat di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_21__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud subseksyen (1), penerbitan maklumat kepada orang awam boleh dibuat melalui laman sesawang, media cetak, media digital atau apa-apa bentuk penyebaran maklumat kepada orang awam yang difikirkan sesuai oleh pihak berkuasa awam."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_21__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_21",
      "schema:text": {
        "@language": "ms",
        "@value": "Maklumat yang diterbitkan di bawah subseksyen (1) tidak boleh termasuk apa-apa maklumat yang mengenal pasti atau yang boleh digunakan untuk mengenal pasti mana-mana orang yang membuat permintaan atau mana-mana orang lain. Pentafsiran Akta ini"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI",
      "schema:text": {
        "@language": "ms",
        "@value": "Tiada apa-apa dalam Akta ini boleh ditafsirkan sebagai kebebasan asasi di bawah Bahagian II Perlembagaan Persekutuan. Kuasa untuk membuat peraturan-peraturan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_23",
      "@type": "akn:clause",
      "eli:number": "23",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_23__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_23__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_23__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Perdana Menteri boleh membuat peraturan-peraturan sebagaimana yang perlu atau suai manfaat bagi maksud melaksanakan peruntukan Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_23__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_23__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_23__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_23__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_23__subsec_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_23",
      "schema:text": {
        "@language": "ms",
        "@value": "Tanpa menjejaskan keluasan subseksyen (1), Perdana Menteri boleh membuat peraturan-peraturan bagi atau berkenaan dengan semua atau bagi perkara yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_23__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_23__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "tatacara bagi permintaan untuk mendapatkan akses kepada maklumat;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_23__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_23__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "borang yang hendak digunakan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_23__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_23__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "tatacara bagi semakan dalaman oleh pihak berkuasa awam;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_23__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_23__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "tatacara bagi semakan luar oleh Ombudsman."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_V__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang terkilan dengan keputusan ketua pihak berkuasa awam di bawah seksyen 11 boleh mengemukakan keputusan itu untuk disemak oleh Ombudsman. Keputusan Ombudsman"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_V__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_V__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_V__cl_14__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_V__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_V__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Tertakluk kepada seksyen 9, Ombudsman boleh mengesahkan, mengubah atau mengetepikan keputusan ketua pihak berkuasa awam itu selepas menyemak keputusan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_V__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_V__cl_14",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa keputusan yang dibuat oleh Ombudsman di bawah subseksyen (1) hendaklah disampaikan secara bertulis kepada orang yang terkilan itu. Ketidakpakaian"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_V__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Kuasa penyiasatan yang diberikan kepada Ombudsman di bawah ... Akta Ombudsman 20… [Akta …] tidak terpakai bagi Bahagian ini. Semakan kehakiman"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_V__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_V",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang terkilan dengan keputusan Ombudsman atau pihak berkuasa awam di bawah Akta ini boleh memohon kepada Mahkamah Tinggi bagi semakan kehakiman. Obligasi kerahsiaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_V__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_V__cl_17__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_V__cl_17__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_V__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_V__cl_17__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_V__cl_17__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_V__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Kecuali bagi apa-apa maksud Akta ini atau bagi maksud apa-apa prosiding sivil atau jenayah di bawah mana-mana undang-undang bertulis—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_V__cl_17__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_V__cl_17__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tiada anggota, pegawai atau kakitangan Ombudsman, sama ada semasa atau selepas tempoh jawatan atau pekerjaannya, boleh mendedahkan apa-apa maklumat atau dokumen yang diperolehnya dalam perjalanan pekerjaannya di bawah Akta ini; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_V__cl_17__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_V__cl_17__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tiada mana-mana orang lain yang melalui apa-apa cara mengakses kepada apa-apa maklumat atau dokumen yang berhubungan dengan maklumat di bawah Akta ini boleh mendedahkan maklumat atau dokumen itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_V__cl_17__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_V__cl_17",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang melanggar subseksyen (1) melakukan suatu kesalahan dan hendaklah, apabila disabitkan, dipenjarakan selama tempoh yang tidak melebihi lima tahun atau didenda tidak melebihi satu ratus ribu ringgit atau kedua-duanya."
      }
    }
  ]
}
