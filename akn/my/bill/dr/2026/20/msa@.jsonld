      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV",
      "schema:name": {
        "@language": "ms",
        "@value": "Suatu maklumat hendaklah dikecualikan jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "maklumat itu berkaitan dengan dokumen rasmi, rahsia rasmi, rahsia, maklumat sulit atau maklumat yang dilindungi di bawah undang-undang bertulis yang lain;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "maklumat itu berkaitan dengan pengesanan, pencegahan, penguatkuasaan, penyiasatan atau pendakwaan terhadap apa-apa pelanggaran atau ketidakpatuhan mana-mana undang-undang;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "maklumat itu akan menzahirkan atau membolehkan seseorang untuk menentukan identiti suatu sumber maklumat sulit yang berkaitan dengan penguatkuasaan undang-undang atau pentadbiran keadilan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "maklumat itu akan menzahirkan kewujudan atau identiti seseorang yang dimasukkan dalam program perlindungan saksi;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "maklumat itu akan menzahirkan langkah atau tatacara penyiasatan, termasuk metodologi pengumpulan risikan, teknik atau teknologi penyiasatan, amalan rahsia, atau perkiraan perkongsian maklumat antara agensi penguatkuasaan undang-undang;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "maklumat itu akan menjejaskan atau menghalang pentaksiran atau pemungutan apa-apa cukai, duti atau penalti;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "maklumat itu berkemungkinan akan membahayakan nyawa, keselamatan, kesihatan atau kebajikan mana-mana orang atau kumpulan orang;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "maklumat itu berkemungkinan akan menzahirkan rahsia perdagangan pihak berkuasa awam atau mana-mana orang lain;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "penzahiran maklumat itu berkemungkinan akan menjejaskan kepentingan komersial, kewangan, ekonomi atau harta pihak berkuasa awam;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_j",
      "@type": "akn:paragraph",
      "eli:number": "j",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "penzahiran maklumat itu berkemungkinan akan menjejaskan penjalanan apa-apa penyelidikan yang dijalankan oleh pihak berkuasa awam atau mana-mana orang;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_k",
      "@type": "akn:paragraph",
      "eli:number": "k",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_k__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_k__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_k__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "maklumat itu diperoleh—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_k__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_k",
      "schema:text": {
        "@language": "ms",
        "@value": "daripada pihak ketiga dan penyampaiannya akan terjumlah kepada pecah kepercayaan yang boleh diambil tindakan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_k__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_k",
      "schema:text": {
        "@language": "ms",
        "@value": "secara rahsia daripada pihak ketiga dan mengandungi rahsia dagangan atau penyampaiannya akan, atau berkemungkinan akan, menjejaskan dengan serius kepentingan komersial atau kewangan pihak ketiga itu; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_k__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_k",
      "schema:text": {
        "@language": "ms",
        "@value": "secara rahsia daripada suatu Negara lain atau suatu organisasi antarabangsa, dan penyampaiannya akan, atau berkemungkinan akan, menjejaskan dengan serius hubungan dengan Negara atau organisasi antarabangsa itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_l",
      "@type": "akn:paragraph",
      "eli:number": "l",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_l__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_l__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_l__subpara_iii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "penzahiran maklumat itu akan melanggar satu atau lebih daripada yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_l__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_l",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu perjanjian atau kontrak;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_l__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_l",
      "schema:text": {
        "@language": "ms",
        "@value": "kewajipan kerahsiaan di bawah ekuiti; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_l__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_l",
      "schema:text": {
        "@language": "ms",
        "@value": "suatu perintah mahkamah atau tribunal;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_m",
      "@type": "akn:paragraph",
      "eli:number": "m",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_m__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_m__subpara_ii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_m__subpara_iii",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_m__subpara_iv"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "maklumat itu yang berhubungan dengan—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_m__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_m",
      "schema:text": {
        "@language": "ms",
        "@value": "keistimewaan profesional undang-undang atau keistimewaan peguam cara dan klien;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_m__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_m",
      "schema:text": {
        "@language": "ms",
        "@value": "kerahsiaan doktor dan pesakit atau keistimewaan profesion perubatan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_m__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_m",
      "schema:text": {
        "@language": "ms",
        "@value": "pentadbiran keadilan oleh mahkamah termasuk apa-apa prosiding kehakiman, sama ada sivil atau jenayah, prosiding pengantaraan dan pengurusan kes pra-perbicaraan dan inkues atau siasatan mengenai suatu kematian; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_m__subpara_iv",
      "@type": "akn:subparagraph",
      "eli:number": "iv",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_m",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa prosiding di hadapan suatu tribunal atau lembaga;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_n",
      "@type": "akn:paragraph",
      "eli:number": "n",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "maklumat itu akan menzahirkan perkara yang berupa pendapat, nasihat atau syor yang disediakan oleh seorang pegawai pihak berkuasa awam atau Menteri, atau perundingan atau pertimbangtelitian yang telah dilakukan antara pegawai pihak berkuasa awam, Menteri dengan Menteri, atau antara seorang pegawai pihak berkuasa awam dengan seorang Menteri, dalam masa menjalankan, atau bagi maksud, proses pertimbangtelitian yang terlibat dalam fungsi suatu pihak berkuasa awam;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_o",
      "@type": "akn:paragraph",
      "eli:number": "o",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "maklumat itu akan melibatkan penzahiran maklumat peribadi seseorang individu, termasuk seseorang individu yang telah meninggal dunia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_p",
      "@type": "akn:paragraph",
      "eli:number": "p",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "maklumat itu akan melibatkan apa-apa bahan penyiaran yang belum diterbitkan, bahan komunikasi awam, kandungan media, draf penerbitan atau komunikasi strategik yang disediakan oleh atau untuk pihak berkuasa awam dan yang dimaksudkan bagi penerbitan, penyiaran atau penyebaran kepada orang awam pada masa hadapan; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_q",
      "@type": "akn:paragraph",
      "eli:number": "q",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "maklumat itu akan menzahirkan sumber apa-apa maklumat yang diperoleh dalam masa menjalankan penghasilan apa-apa program atau penyiaran."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Kebebasan Maklumat 2026."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Perdana Menteri melalui pemberitahuan dalam Warta. Pemakaian"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_2__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_2__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_2__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_2__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini hendaklah terpakai bagi Kerajaan Persekutuan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_2__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini hendaklah memperuntukkan tatacara permintaan untuk mendapatkan akses kepada maklumat tertakluk kepada maklumat yang dikecualikan di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_2__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini hendaklah dibaca bersama-sama dengan peruntukan undang-undang bertulis lain yang membenarkan akses kepada dokumen rasmi atau maklumat, tertakluk kepada syarat yang diperuntukkan di bawah undang-undang bertulis itu, dan peruntukan Akta ini hendaklah menjadi tambahan kepada, dan tidak mengurangkan, peruntukan undang-undang bertulis yang berkaitan. Tafsiran"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_3__list_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_3__list_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I",
      "schema:name": {
        "@language": "ms",
        "@value": "Dalam Akta ini, melainkan jika konteksnya mengkehendaki makna yang lain—"
      },
      "schema:text": {
        "@language": "ms",
        "@value": "“dokumen” mempunyai erti yang diberikan kepadanya di bawah Akta Keterangan 1950 [Akta 56]; “ketua pihak berkuasa awam” ertinya pegawai awam yang dipertanggungkan dengan tanggungjawab berkenaan dengan mana-mana Kementerian, jabatan atau mana-mana perkhidmatan awam; “maklumat” ertinya apa-apa maklumat yang terkandung dalam mana-mana dokumen rasmi yang berada dalam kawalan pihak berkuasa awam tidak termasuk perkara yang disebut dalam seksyen 9; “maklumat peribadi” ertinya maklumat mengenai seorang individu, termasuk—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_3__list_1",
      "@type": "akn:list",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_3__list_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_3__list_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_3__list_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_3__list_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_3__list_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_3__list_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_3__list_1__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_3__list_1__para_h"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_3__list_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_3__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "maklumat yang berhubungan dengan bangsa, asal-usul kerakyatan atau etnik, agama, umur, jantina atau taraf perkahwinan atau keluarga individu itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_3__list_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_3__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "maklumat yang berhubungan dengan pendidikan atau perubatan, sejarah psikiatri, psikologi, jenayah atau pekerjaan individu itu atau maklumat yang berhubungan dengan transaksi kewangan yang melibatkan individu itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_3__list_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_3__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa nombor, simbol atau butir-butir pengenalan lain yang diberikan kepada individu itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_3__list_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_3__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "alamat, nombor telefon, cap jari atau kumpulan darah individu itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_3__list_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_3__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "surat-menyurat yang dihantar kepada pihak berkuasa awam oleh individu itu yang bersifat persendirian atau sulit, dan jawapan kepada surat-menyurat itu yang akan mendedahkan kandungan asal surat-menyurat itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_3__list_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_3__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "nama individu itu yang kelihatan dengan maklumat peribadi lain yang berhubungan dengan individu itu atau apabila penzahiran nama itu akan mendedahkan maklumat peribadi lain mengenai individu itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_3__list_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_3__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pendapat atau pandangan peribadi individu itu kecuali jika pendapat atau pandangan itu berkaitan dengan individu lain; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_3__list_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_3__list_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pandangan atau pendapat individu lain mengenai individu itu; “maklumat yang dikecualikan” ertinya maklumat sebagaimana yang dinyatakan di bawah seksyen 12; “Menteri yang bertanggungjawab” ertinya tiap-tiap Menteri yang masing-masing dipertanggungkan dengan tanggungjawab berkenaan dengan fungsi mengikut Akta Fungsi-Fungsi Menteri 1969 [Akta 2]; “Ombudsman” mempunyai erti yang diberikan kepadanya di bawah Akta Ombudsman 20… [Akta …]; “pegawai yang dilantik” ertinya pegawai yang dilantik di bawah seksyen 4; “pihak berkuasa awam” ertinya—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_3__list_2",
      "@type": "akn:list",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_3__list_2__para_a",
