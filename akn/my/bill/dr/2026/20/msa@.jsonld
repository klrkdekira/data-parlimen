        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_j",
