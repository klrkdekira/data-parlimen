        "@language": "ms",
        "@value": "AM Kesalahan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_VI__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
