      "schema:text": {
        "@language": "ms",
        "@value": "PEGAWAI YANG DILANTIK Pelantikan pegawai yang dilantik"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III",
      "@type": "akn:part",
      "eli:number": "III",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_8",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_9",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_10",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_11"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "TATACARA PERMINTAAN Permintaan untuk mendapatkan akses"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Pihak berkuasa awam yang menerima suatu permintaan boleh menangguhkan pemberian akses kepada maklumat yang diminta jika maklumat itu telah dikemukakan untuk dan sedang menunggu penerbitan bagi apa-apa prosiding di Parlimen atau hebahan kepada media dan hendaklah memaklumkan kepada orang itu sebab bagi penangguhan itu dan menyatakan, setakat yang praktik, tempoh penangguhan itu. Semakan dalaman"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_11__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_11__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Mana-mana orang yang terkilan dengan keputusan pihak berkuasa awam berhubung dengan permintaan yang dibuat boleh, dalam tempoh empat belas hari bekerja selepas tarikh penerimaan notis yang memaklumkan penolakan itu di bawah subseksyen 9(2), merayu secara bertulis kepada ketua pihak berkuasa awam."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Ketua pihak berkuasa awam boleh, selepas menimbangkan rayuan yang dibuat di bawah subseksyen (1) mengesahkan, mengubah atau mengetepikan keputusan pihak berkuasa awam."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_11__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_11",
      "schema:text": {
        "@language": "ms",
        "@value": "Apa-apa keputusan yang dibuat oleh ketua pihak berkuasa awam di bawah subseksyen (2) hendaklah disampaikan secara bertulis kepada orang yang terkilan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_5__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_5__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_5__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_5__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang merupakan warganegara Malaysia yang berumur lapan belas tahun dan ke atas boleh meminta untuk mendapatkan akses kepada maklumat di bawah Akta ini yang berada dalam kawalan pihak berkuasa awam."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_5__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_5__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_5__subsec_2__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang disebut di bawah subseksyen (1) boleh meminta bagi pihak ketiga jika orang itu ialah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_5__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "penjaga yang sah kepada pihak ketiga;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_5__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "waris yang sah; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_5__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_5__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pentadbir yang sah bagi pihak yang telah meninggal dunia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_5__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_5__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_5__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_5__subsec_3__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_5__subsec_3__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_5__subsec_3__para_e"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Seseorang yang disebut di bawah subseksyen (1) atau (2) boleh meminta untuk mendapatkan akses kepada maklumat dengan membuat suatu permintaan secara bertulis kepada pihak berkuasa awam yang menyatakan butir-butir maklumat yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_5__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_5__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "nama, nombor kad pengenalan, alamat kediaman dan poskod, dan butir-butir untuk dihubungi bagi orang itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_5__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_5__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal orang itu meminta untuk mendapatkan akses kepada maklumat bagi pihak suatu pertubuhan perbadanan atau yang tidak diperbadankan, nama, nombor pendaftaran, alamat berdaftar dan poskod dan butir-butir untuk dihubungi pertubuhan perbadanan atau yang tidak diperbadankan itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_5__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_5__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal orang itu meminta untuk mendapatkan akses kepada maklumat bertindak atas kapasiti yang disebut di bawah subseksyen (2), dokumen berkaitan sebagai bukti kapasiti sedemikian;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_5__subsec_3__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_5__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "maklumat yang diminta; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_5__subsec_3__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_5__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "tujuan khusus permintaan itu sebagaimana yang dinyatakan di bawah seksyen 6."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_5__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Suatu permintaan yang dibuat di bawah seksyen ini hendaklah dikemukakan bersama pembayaran fi sebagaimana yang ditetapkan oleh Yang di-Pertuan Agong melalui suatu perintah."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_5__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_5",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila menerima permintaan itu, pegawai yang dilantik hendaklah memberikan suatu akuan terima bertulis mengenai permintaan itu kepada orang itu. Tujuan permintaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_6__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_6__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_6__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_6__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_6__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_6__subsec_1__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Permintaan untuk mendapatkan akses kepada maklumat di bawah seksyen 5 boleh dibenarkan bagi tujuan yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_6__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_6__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "mengesahkan dan membuat pembetulan kepada maklumat peribadi atau maklumat peribadi suatu pihak ketiga dalam hal yang disebut di bawah subseksyen 5(2);"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_6__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_6__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "penyelidikan atau tujuan pendidikan yang dijalankan bukan bagi tujuan komersial oleh mana-mana pelajar, perantis atau pelatih, atau penyelidik atau sarjana tamu di sesebuah institusi pendidikan tinggi atau institusi penyelidikan di Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_6__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_6__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "pelaporan, penerbitan atau penyebaran maklumat oleh pengamal media kepada orang awam; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_6__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_6__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "apa-apa tujuan lain yang tidak bertentangan dengan mana-mana undang-undang bertulis yang orang itu mempunyai kepentingan yang wajar dan nyata dan telah terjejas dengan tindakan oleh pihak berkuasa awam."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Tujuan yang disebut di bawah subseksyen (1) tidak memberikan seseorang, akhbar atau media, suatu hak untuk akses kepada maklumat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_6__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_6",
      "schema:text": {
        "@language": "ms",
        "@value": "Bagi maksud seksyen ini, “pengamal media” mempunyai erti yang diberikan kepadanya di bawah Akta Majlis Media Malaysia 2025 [Akta 868]. Pengesahan permintaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III",
      "schema:text": {
        "@language": "ms",
        "@value": "Pegawai yang dilantik boleh menghendaki orang yang membuat suatu permintaan di bawah seksyen 5 untuk memberikan bukti identiti dan kewarganegaraan yang munasabah, atau apa-apa maklumat atau dokumen lain yang berhubungan dengan permintaan itu mengikut cara yang boleh ditentukan oleh pihak berkuasa awam. Keputusan permintaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_8__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_8__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_8__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_8__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_8__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_8__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Pihak berkuasa awam hendaklah, dalam tempoh lima belas hari bekerja selepas menerima permintaan itu di bawah seksyen 5, membuat keputusan untuk membenarkan permintaan untuk mendapatkan akses kepada maklumat yang diminta atau menolak permintaan itu atas mana-mana alasan yang disebut dalam seksyen 9, dan hendaklah dengan serta-merta memaklumkan keputusan itu kepada orang itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_8__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika suatu keputusan dibuat untuk membenarkan permintaan untuk mendapatkan akses kepada maklumat yang diminta di bawah subseksyen (1), maklumat itu hendaklah diberikan kepada orang itu dalam tempoh empat belas hari bekerja dari tarikh keputusan itu dibuat."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_8__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_8__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_8__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Walau apa pun subseksyen (1), jika permintaan untuk mendapatkan akses kepada maklumat dibuat oleh seseorang yang menyentuh nyawa dan kebebasan seorang individu, pihak berkuasa awam hendaklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_8__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_8__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam tempoh empat puluh lapan jam selepas menerima permintaan itu, membuat keputusan sama ada membenarkan atau menolak permintaan itu atas mana-mana alasan yang disebut dalam seksyen 9; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_8__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_8__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam hal permintaan itu dibenarkan, memberikan maklumat itu kepada orang itu dengan seberapa segera yang praktik dalam tempoh empat belas hari bekerja dari tarikh keputusan itu dibuat di bawah perenggan (a)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_8__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_8__subsec_4__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_8__subsec_4__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Pihak berkuasa awam boleh melanjutkan tempoh yang disebut dalam subseksyen (2) atau perenggan (3)(b) selama suatu tempoh tidak melebihi dua puluh satu hari bekerja atau apa-apa tempoh munasabah yang lain jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_8__subsec_4__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_8__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "permintaan itu melibatkan bilangan dokumen yang banyak dan pemberian maklumat dalam tempoh empat belas hari bekerja akan mengganggu secara tidak munasabah aktiviti pihak berkuasa awam; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_8__subsec_4__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_8__subsec_4",
      "schema:text": {
        "@language": "ms",
        "@value": "permintaan itu memerlukan pencarian rekod di pejabat pihak berkuasa awam yang terletak di Negeri, bandar atau daerah yang berlainan."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_8__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_8",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika tempoh untuk memberikan maklumat dilanjutkan disebabkan oleh apa-apa keadaan yang disebut dalam subseksyen (4), pegawai yang dilantik hendaklah, dalam tempoh empat belas hari bekerja dari tarikh tamat tempoh yang diperuntukkan di bawah subseksyen (2) atau perenggan (3)(b), memaklumkan kepada orang itu tempoh lanjutan dan sebab bagi lanjutan itu. Penolakan permintaan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_9__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_9__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_9__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_9__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_9__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_9__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_9__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_9__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_9__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_9__subsec_1__para_f"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Permintaan untuk mendapatkan akses kepada maklumat di bawah seksyen 5 boleh ditolak oleh pihak berkuasa awam, atas sebab yang berikut:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_9__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_9__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "maklumat yang diminta ialah maklumat yang dikecualikan di bawah Bahagian IV;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_9__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_9__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "maklumat yang diminta telah tersedia kepada umum;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_9__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_9__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "maklumat yang diminta tidak wujud atau tidak berada dalam kawalan pihak berkuasa awam;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_9__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_9__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "tertakluk kepada subseksyen (3), maklumat yang diminta itu mengandungi maklumat peribadi pihak ketiga;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_9__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_9__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "permintaan itu adalah menyusahkan atau tidak munasabah; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_9__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_9__subsec_1",
      "schema:text": {
        "@language": "ms",
        "@value": "permintaan untuk mendapatkan akses kepada maklumat telah dibuat dan ditolak dalam tempoh enam bulan sebelumnya melainkan jika orang itu memberikan penjelasan yang munasabah bagi permintaan untuk maklumat yang sama itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_9__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_9__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_9__subsec_2__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika permintaan untuk mendapatkan akses kepada maklumat ditolak di bawah subseksyen (1), pegawai yang dilantik hendaklah memaklumkan penolakan itu secara bertulis kepada orang itu dalam tempoh yang diperuntukkan di bawah subseksyen 8(1) atau perenggan 8(3)(a), mengikut mana-mana yang berkenaan, dan notis bertulis itu hendaklah—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_9__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_9__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "menyatakan sebab bagi penolakan permintaan sebagaimana yang dinyatakan di bawah subseksyen (1); dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_9__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_9__subsec_2",
      "schema:text": {
        "@language": "ms",
        "@value": "memaklumkan orang itu tentang tatacara untuk merayu kepada ketua pihak berkuasa awam terhadap penolakan itu."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_9__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_9__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_9__subsec_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_9__subsec_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "Perenggan (1)(d) tidak terpakai jika—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_9__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_9__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "orang yang membuat permintaan itu telah memperoleh persetujuan bertulis daripada pihak ketiga bagi pendedahan maklumat itu;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_9__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_9__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "orang itu ialah penjaga yang sah pihak ketiga itu atau waris yang sah; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_9__subsec_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_III__cl_9__subsec_3",
      "schema:text": {
        "@language": "ms",
        "@value": "orang itu ialah pentadbir yang sah bagi pihak ketiga yang telah meninggal dunia. Penangguhan akses"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_II",
      "schema:text": {
        "@language": "ms",
        "@value": "Menteri yang bertanggungjawab hendaklah melantik seorang pegawai atau lebih dalam pihak berkuasa awam sebagai pegawai yang dilantik untuk memproses permintaan untuk mendapatkan akses kepada maklumat di bawah Akta ini."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "MAKLUMAT YANG DIKECUALIKAN Maklumat yang dikecualikan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_IV__cl_12__para_a",
