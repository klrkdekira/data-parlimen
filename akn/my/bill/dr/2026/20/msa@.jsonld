        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_3__list_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_3"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_3__list_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_3__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Kerajaan Persekutuan;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_3__list_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_3__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "Perkhidmatan Parlimen yang ditubuhkan di bawah Akta Perkhidmatan Parlimen 2025 [Akta 869];"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_3__list_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_3__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "badan berkanun Kerajaan Persekutuan yang ditubuhkan di bawah suatu Akta Parlimen; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_3__list_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_I__cl_3__list_2",
      "schema:text": {
        "@language": "ms",
        "@value": "pihak berkuasa tempatan bagi Wilayah-Wilayah Persekutuan Kuala Lumpur, Labuan dan Putrajaya; “rahsia rasmi” mempunyai erti yang diberikan kepadanya di bawah Akta Rahsia Rasmi 1972 [Akta 88]; “rasmi” berhubungan dengan mana-mana pihak berkuasa awam."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/20/msa@/~part_V",
      "@type": "akn:part",
      "eli:number": "V",
