      "schema:text": {
        "@language": "en",
        "@value": "NATIONAL STATISTICS COUNCIL Establishment of National Statistics Council"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_10",
      "@type": "akn:clause",
      "eli:number": "10",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_10__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_10__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_10__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_10__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_10__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_10__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The Council shall convene its meeting as often as the Chairman may determine and the meeting shall be held at the time and place as determined by the Chairman."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_10__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The Chairman shall preside at all meetings of the Council but if the Chairman is absent from any meeting, the members present shall elect one from among themselves to preside at that meeting."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_10__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "Seven members, including the Chairman, shall constitute a quorum for a meeting of the Council."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_10__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The Chairman may authorize the use of a live video link, live television link or any other electronic means of communication for the purpose of any meeting of the Council, and any member attending the meeting through such means shall be deemed to be present at the meeting."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_10__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "The Council may determine its own procedure. Committees"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_11__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_11__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_11__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_11__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_11__subsec_5",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_11__subsec_6",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_11__subsec_7",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_11__subsec_8"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_11__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "The Council may establish such committees as the Council considers necessary or expedient to assist the Council in the performance of its functions under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_11__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "The Council may appoint any person to be a member of any committee established under subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_11__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "The Council may appoint any of its members to be the chairman of any committee established under subsection (1)."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_11__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "A member of a committee shall hold office for such term as the Council may specify in his letter of appointment and is eligible for reappointment."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_11__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "A committee shall be subject to, and act in accordance with, any directions given by the Council."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_11__subsec_6",
      "@type": "akn:subsection",
      "eli:number": "6",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "A committee shall meet as often as may be necessary at the time and place as the chairman of the committee may determine."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_11__subsec_7",
      "@type": "akn:subsection",
      "eli:number": "7",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "A committee may invite any person to attend any of its meeting to advise the committee on any matter under discussion."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_11__subsec_8",
      "@type": "akn:subsection",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_11",
      "schema:text": {
        "@language": "en",
        "@value": "A committee may determine its own procedure."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_7",
      "@type": "akn:clause",
      "eli:number": "7",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_7__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_7__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_7__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "The National Statistics Council is established."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_7__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_7__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_7__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_7__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_7__subsec_2__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_7__subsec_2__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_7__subsec_2__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_7__subsec_2__para_g"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_7",
      "schema:text": {
        "@language": "en",
        "@value": "The Council shall consist of the following members:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_7__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_7__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Prime Minister as Chairman;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_7__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_7__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Minister;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_7__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_7__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "not more than eight Ministers of the Federal Government appointed by the Prime Minister;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_7__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_7__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Chief Secretary to the Government;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_7__subsec_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_7__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Director General of the Public Services;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_7__subsec_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_7__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Secretary General of the Ministry charged with the responsibility for matters relating to statistics; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_7__subsec_2__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_7__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "the Chief Statistician as Secretary. Council may invite any person to attend meetings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "The Council may invite any person to attend any of its meetings to advise the Council on any matter under discussion, but the person is not entitled to vote at the meeting. Functions of Council"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_9__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_9__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_9__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III",
      "schema:text": {
        "@language": "en",
        "@value": "The functions of the Council are as follows:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_9__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "to act as the main advisory body for providing guidance and directions on matters relating to statistics;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_9__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "to evaluate and endorse statistical standards and procedures in Malaysia; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_9__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_III__cl_9",
      "schema:text": {
        "@language": "en",
        "@value": "to do such other things arising out of or incidental to the functions of the Council under this Act. Meetings of Council"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_4__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_4__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_4__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_4__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_4__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "The Department of Statistics shall be known as the Department of Statistics Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_4__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_4__subsec_2__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_4__subsec_2__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_4__subsec_2__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_4__subsec_2__para_d"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "The Yang di-Pertuan Agong shall appoint a Chief Statistician from among officers currently serving in the federal public services who have the following qualifications:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_4__subsec_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_4__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "hold a master’s degree or a doctor of philosophy degree in the field of statistics, economics, data science, mathematics, or other fields relating to statistics, from a university recognized by the Government of Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_4__subsec_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_4__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "have at least twenty years of working experience in the field of statistics;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_4__subsec_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_4__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "have knowledge, technical skills and expertise in producing and disseminating statistics in the field of social, economic, or other fields relating to statistics; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_4__subsec_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_4__subsec_2",
      "schema:text": {
        "@language": "en",
        "@value": "have knowledge, skills and experience in conducting population, economic, agricultural and household census or surveys at the national or state level."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_4__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "There shall be appointed such number of Deputy Chief Statisticians, and such other officer of the Department of Statistics Malaysia as may be necessary for the purpose of carrying into effect the provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_4__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_4",
      "schema:text": {
        "@language": "en",
        "@value": "Every Deputy Chief Statistician and officer of the Department of Statistics Malaysia shall be subject to the control and directions of the Chief Statistician. Functions of Department of Statistics Malaysia"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_5",
      "@type": "akn:clause",
      "eli:number": "5",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_5__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_5__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_5__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_5__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_5__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_5__subsec_1__para_c",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_5__subsec_1__para_d",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_5__subsec_1__para_e",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_5__subsec_1__para_f",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_5__subsec_1__para_g",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_5__subsec_1__para_h",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_5__subsec_1__para_i"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The functions of the Department of Statistics Malaysia are as follows:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_5__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to be a central repository for data and statistics;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_5__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to collect, compile, analyse and interpret data for the purposes of furnishing information required for the formation or carrying out of Government policies or otherwise required for Government purposes;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_5__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to disseminate data and statistics;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_5__subsec_1__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to develop and establish statistical standards and procedures;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_5__subsec_1__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to ensure the quality, integrity and reliability of official statistics for the Government of Malaysia;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_5__subsec_1__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to advice any Government entity or any person in matters relating to statistics;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_5__subsec_1__para_g",
      "@type": "akn:paragraph",
      "eli:number": "g",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to coordinate statistical activities for any Government entity or any person;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_5__subsec_1__para_h",
      "@type": "akn:paragraph",
      "eli:number": "h",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to provide training relating to statistics; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_5__subsec_1__para_i",
      "@type": "akn:paragraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_5__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "to perform any other functions relating to data and statistics as may be necessary for the purposes of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_5__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_5",
      "schema:text": {
        "@language": "en",
        "@value": "The Chief Statistician shall have all such powers as may be necessary for, or in connection with, or incidental to the performance of the functions of the Department of Statistics Malaysia under this Act. Delegation of powers"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_6",
      "@type": "akn:clause",
      "eli:number": "6",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_6__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_6__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_6__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The Chief Statistician may, in writing, delegate any of his powers under this Act to any Deputy Chief Statistician or other officer of the Department of Statistics Malaysia subject to such conditions, limitations or restrictions as the Chief Statistician thinks fit except the power of delegation under this section."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_6__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_II__cl_6",
      "schema:text": {
        "@language": "en",
        "@value": "The delegation of any power under this section shall not prevent the Chief Statistician from exercising the powers so delegated."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_IV",
      "@type": "akn:part",
      "eli:number": "IV",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_IV__cl_12",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_IV__cl_13",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_IV__cl_14"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "DATA COLLECTION, PUBLICATION AND COMMUNICATION Directions to furnish data"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_IV__cl_12",
      "@type": "akn:clause",
      "eli:number": "12",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_IV__cl_12__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_IV__cl_12__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_IV__cl_12__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_IV__cl_12__subsec_4",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_IV__cl_12__subsec_5"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_IV__cl_12__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_IV__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "The Chief Statistician may, by notice in writing, direct any person to furnish such data within the person’s knowledge or which the person is reasonably able to obtain, in the form and manner and within the period specified in the notice or such extended period as the Chief Statistician may grant."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_IV__cl_12__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_IV__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "A notice under subsection (1) shall be served on the person either personally, by registered post, or by electronic means."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_IV__cl_12__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_IV__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "Any person directed to furnish data under subsection (1) shall ensure that the data furnished is true, accurate and complete, and shall provide an express representation to that effect, including a declaration the person is not aware of any other data that would render the furnished data untrue or misleading."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_IV__cl_12__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_IV__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "If the person directed to furnish data under subsection (1) does not have the data, or the data is incomplete, the person shall notify the Chief Statistician in the form and manner and within the period as specified in the notice."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_IV__cl_12__subsec_5",
      "@type": "akn:subsection",
      "eli:number": "5",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_IV__cl_12",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (3) commits an offence and shall, on conviction, be liable to a fine not exceeding fifty thousand ringgit and in the case of a continuing offence, to a further fine not exceeding two thousand ringgit for each day during which the offence continues after conviction. Request for data"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_IV__cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_IV",
      "schema:text": {
        "@language": "en",
        "@value": "The Chief Statistician may request any data from any Government entity by notice in writing directing the head of the Government entity to furnish the data. Publication and communication of data and statistics"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_IV__cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_IV__cl_14__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_IV__cl_14__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_IV__cl_14__subsec_3",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_IV__cl_14__subsec_4"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_IV"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_IV__cl_14__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_IV__cl_14__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_IV__cl_14__subsec_1__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_IV__cl_14__subsec_1__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_IV__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "No data or statistics obtained under this Act shall be published or communicated to any other person except in accordance with the following requirements:"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_IV__cl_14__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_IV__cl_14__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the prior approval of the Chief Statistician has been obtained;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_IV__cl_14__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_IV__cl_14__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the publication or communication is made within the period or at the time specified by the Chief Statistician; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_IV__cl_14__subsec_1__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_IV__cl_14__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "the publication or communication is made in such a manner as to ensure that the identity of any person to whom the data or statistics relates to the data and statistics received is not disclosed."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_IV__cl_14__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_IV__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "No data or statistics shall be used by any person for the purpose of determining any liability to any form of taxation or levy, whether Federal, State, or otherwise or be communicated to any authority or person likely to use the data or statistics for that purpose."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_IV__cl_14__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_IV__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "Any person may request any data or statistics, or any physical or digital publication issued, by the Department of Statistics Malaysia, in the form and manner determined by the Chief Statistician and upon payment of the prescribed fee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_IV__cl_14__subsec_4",
      "@type": "akn:subsection",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_IV__cl_14",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) commits an offence and shall, on conviction, be liable to a fine not exceeding fifty thousand ringgit."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_I__cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_I__cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_I__cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_I"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_I__cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Statistics Act 2026."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_I__cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_I__cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. This Act binds Federal Government and State Government"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_I__cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_I",
      "schema:text": {
        "@language": "en",
        "@value": "This Act shall bind the Federal Government and State Government. Interpretation"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_I__cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_I__cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_I__cl_3__para_b",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_I__cl_3__para_c"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_I",
      "schema:name": {
        "@language": "en",
        "@value": "In this Act, unless the context otherwise requires—"
      },
      "schema:text": {
        "@language": "en",
        "@value": "“data” means particulars or information in any form; “prescribed” means prescribed by the Minister by regulations made under this Act; “Government entity” means—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_I__cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_I__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "any ministry, department, office, authority or agency, of the Federal Government or State Government, or any other entity in the Federal Government or State Government service;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_I__cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_I__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "any statutory body of the Federal Government or State Government established under any written law; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_I__cl_3__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_I__cl_3",
      "schema:text": {
        "@language": "en",
        "@value": "any local authority; “head of Government entity” means any officer who is responsible for a Government entity, including any officer authorized in writing by the head of Government entity to act on his behalf; “Chief Statistician” means the Chief Statistician appointed under subsection 4(2); “Council” means the National Statistics Council established under section 7; “Minister” means the Minister charged with the responsibility for matters relating to statistics; “statistics” means the value or figures produced from the process of data collection, compilation, analysis and interpretation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V",
      "@type": "akn:part",
      "eli:number": "V",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V__cl_15",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V__cl_16",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V__cl_17",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V__cl_18",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V__cl_19",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V__cl_20"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "GENERAL Obligation of secrecy"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_VI",
      "@type": "akn:part",
      "eli:number": "VI",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_VI__cl_21",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_VI__cl_22"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "REPEAL Repeal"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_VI__cl_21",
      "@type": "akn:clause",
      "eli:number": "21",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_VI",
      "schema:text": {
        "@language": "en",
        "@value": "The Statistics Act 1965 [Act 415] is repealed. Saving"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_VI__cl_22",
      "@type": "akn:clause",
      "eli:number": "22",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_VI__cl_22__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_VI__cl_22__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_VI__cl_22__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_VI"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_VI__cl_22__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_VI__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "Any notice issued under the Statistics Act 1965 shall, on the date of coming into operation of this Act, continue to be valid and be deemed to have been issued under this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_VI__cl_22__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_VI__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "Any officer and servant of the Department of Statistics who has been appointed before the date of coming into operation of this Act shall, on the date of coming into operation of this Act, continue to be an officer of the Department of Statistics Malaysia and shall be subject to the law for the time being in force relating to the public service of the Federation."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_VI__cl_22__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_VI__cl_22",
      "schema:text": {
        "@language": "en",
        "@value": "Any reference to the Department of Statistics in any written law or document shall, upon the coming into operation of this Act, be construed as a reference to the Department of Statistics Malaysia."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V__cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V__cl_15__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V__cl_15__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V__cl_15__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "Except for the purposes of this Act or for the purposes of any civil or criminal proceedings under any written law, any Deputy Chief Statistician or other officer of the Department of Statistics Malaysia, during or after his tenure of office or employment, shall not disclose any data and statistics obtained by him in the course of his duties."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V__cl_15__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V__cl_15",
      "schema:text": {
        "@language": "en",
        "@value": "Any person who contravenes subsection (1) commits an offence and shall, on conviction, be liable to a fine not exceeding ten thousand ringgit or to imprisonment for a term not exceeding two years or to both. Protection against suits and legal proceedings"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V__cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "No action, suit, prosecution or other proceedings shall be brought, instituted or maintained in any court against the Minister, any member of the Council, the Chief Statistician, any Deputy Chief Statistician or officer of the Department of Statistics Malaysia in respect of any act, neglect or default done or omitted by him in the course of carrying out his duties under this Act unless it can be proven that the act, neglect or default was done or omitted in bad faith and without reasonable cause. Liability of director, etc., of company, etc."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V__cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "hasPart": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V__cl_17__subsec_1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V__cl_17__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V__cl_17__subsec_1__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V__cl_17__subsec_1__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V__cl_17",
      "schema:text": {
        "@language": "en",
        "@value": "Where any person who commits an offence under this Act is a company, limited liability partnership, firm, society or other body of persons, a person who at the time of the commission of the offence was a director, compliance officer, partner, manager, secretary or other similar officer of the company, limited liability partnership, firm, society or other body of persons or was purporting to act in the capacity or was in any manner or to any extent responsible for the management of any of the affairs of the company, limited liability partnership, firm, society or other body of persons or was assisting in its management—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V__cl_17__subsec_1__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V__cl_17__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "may be charged severally or jointly in the same proceedings with the company, limited liability partnership, firm, society or other body of persons; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V__cl_17__subsec_1__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V__cl_17__subsec_1__para_b__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V__cl_17__subsec_1__para_b__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V__cl_17__subsec_1",
      "schema:text": {
        "@language": "en",
        "@value": "if the company, limited liability partnership, firm, society or other body of persons is found guilty of the offence, shall be deemed to be guilty of that offence and shall be liable to the same punishment or penalty as an individual unless, having regard to the nature of his functions in that capacity and to all circumstances, he proves—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V__cl_17__subsec_1__para_b__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V__cl_17__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "that the offence was committed without his knowledge; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V__cl_17__subsec_1__para_b__subpara_ii",
      "@type": "akn:subparagraph",
      "eli:number": "ii",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V__cl_17__subsec_1__para_b",
      "schema:text": {
        "@language": "en",
        "@value": "that the offence was committed without his consent or connivance and that he had taken all reasonable precautions and exercised due diligence to prevent the commission of the offence. Power to make regulations"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V__cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V__cl_18__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V__cl_18__subsec_2",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V__cl_18__subsec_3"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V__cl_18__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "The Minister may make regulations as may be necessary or expedient for the purpose of carrying into effect the provisions of this Act."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V__cl_18__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "Without prejudice to the generality of subsection (1), the Minister may make regulations to prescribe any fee payable under this Act, including any processing fee."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V__cl_18__subsec_3",
      "@type": "akn:subsection",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V__cl_18__subsec_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V__cl_18__subsec_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V__cl_18",
      "schema:text": {
        "@language": "en",
        "@value": "Any regulations made under this Act may prescribe any act in contravention of the regulations to be an offence and may prescribe penalties—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V__cl_18__subsec_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V__cl_18__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "of a fine not exceeding ten thousand ringgit or imprisonment for a term not exceeding twelve months or to both if the person is an individual; or"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V__cl_18__subsec_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V__cl_18__subsec_3",
      "schema:text": {
        "@language": "en",
        "@value": "of a fine not exceeding twenty thousand ringgit if the person is a body corporate. Power to issue directive, circular and guidelines"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V__cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "The Chief Statistician may issue any directive, circular or guidelines as the Chief Statistician considers necessary or expedient for the purpose of carrying out the provisions of this Act. Prosecution"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V__cl_20",
      "@type": "akn:clause",
      "eli:number": "20",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/21/eng@/~part_V",
      "schema:text": {
        "@language": "en",
        "@value": "No prosecution for an offence under this Act shall be instituted without the consent in writing of the Public Prosecutor."
      }
    }
  ]
}
