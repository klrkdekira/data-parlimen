      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Environmental Quality (Amendment) Act 2026."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/3/eng@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/3/eng@/~cl_1",
      "schema:text": {
        "@language": "en",
        "@value": "This Act comes into operation on a date to be appointed by the Minister by notification in the Gazette. Amendment of section 1"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/3/eng@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/3/eng@",
      "schema:text": {
        "@language": "en",
        "@value": "The Environmental Quality Act 1974 [Act 127] is amended in section 1 by inserting after subsection (2) the following subsection: “(3) The Minister may, by order published in the Gazette, suspend the operation of the whole or any of the provisions of this Act in different parts of Malaysia.”."
      }
    }
