      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan (b) perenggan yang berikut: “(ba) Pendakwa Raya; (bb) Peguam Cara Negara; dan”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/5/msa@/~cl_4__para_b__subpara_iv",
      "@type": "akn:subparagraph",
