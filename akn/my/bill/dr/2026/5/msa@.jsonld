      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perenggan (b) dengan perenggan yang berikut: “(b) Peguam Negara, dengan syarat bahawa Peguam Negara bukanlah seorang ahli Parlimen;”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/5/msa@/~cl_4__para_b__subpara_iii",
