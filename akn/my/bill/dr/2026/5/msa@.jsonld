      "schema:text": {
        "@language": "ms",
        "@value": "dalam Fasal (3), dengan memasukkan selepas perenggan (c) perenggan yang berikut: “(ca) jawatan Peguam Negara; atau (cb) jawatan Pendakwa Raya; atau”; dan"
      }
