      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas Fasal (1) Fasal yang berikut: “(1a) Suruhanjaya Perkhidmatan Kehakiman dan Perundangan hendaklah juga menjalankan apa-apa fungsi lain sebagaimana yang diperuntukkan di bawah mana-mana Perkara lain dalam Perlembagaan ini termasuk mengesyorkan seseorang untuk dilantik sebagai Pendakwa Raya bagi Persekutuan di bawah Fasal (1) Perkara 145a.”; dan"
      }
    },
