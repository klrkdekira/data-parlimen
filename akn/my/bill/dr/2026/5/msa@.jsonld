      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan (a) perenggan yang berikut: “(aa) Hakim Besar Mahkamah Tinggi di Malaya; (ab) Hakim Besar Mahkamah Tinggi di Sabah dan Sarawak;”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/5/msa@/~cl_4__para_b__subpara_ii",
