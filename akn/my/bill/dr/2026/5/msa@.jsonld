      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif “pemilih” takrif yang berikut: ‘ “Pendakwa Raya” ertinya Pendakwa Raya bagi Persekutuan;’. Peralihan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/5/msa@/~cl_8",
      "@type": "akn:clause",
      "eli:number": "8",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/5/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila Akta ini mula berkuat kuasa, fungsi Pendakwa Raya hendaklah dijalankan oleh Peguam Negara sehingga seorang Pendakwa Raya dilantik di bawah Perlembagaan Persekutuan sebagaimana yang dipinda oleh Akta ini. Kecualian"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/5/msa@/~cl_9",
      "@type": "akn:clause",
      "eli:number": "9",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/5/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Apabila Akta ini mula berkuat kuasa, orang yang memegang jawatan Peguam Negara sebaik sebelum Akta ini mula berkuat kuasa hendaklah terus memegang jawatan itu atas terma-terma dan syarat-syarat yang tidak kurang baiknya daripada yang terpakai baginya sebaik sebelum Akta ini mula berkuat kuasa."
      }
