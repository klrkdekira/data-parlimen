      "schema:name": {
        "@language": "ms",
        "@value": "RUU Perbekalan Tambahan (2025) 2026"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/6/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/6/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Perbekalan Tambahan (2025) 2026. Perbelanjaan tambahan bagi tahun 2025"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/6/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/6/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Maka dengan ini dibenarkan pengeluaran sejumlah wang yang tidak melebihi tujuh bilion sembilan ratus tiga puluh lapan juta dua ratus dua belas ribu ringgit (RM7,938,212,000) daripada Kumpulan Wang Disatukan bagi perbelanjaan tambahan untuk perkhidmatan dan maksud yang dinyatakan dalam Jadual bagi tahun 2025 yang tidak diperuntukkan atau yang tidak diperuntukkan dengan sepenuhnya oleh Akta Perbekalan 2025 [Akta A1740]."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/6/msa@/~sched_1",
      "@type": "akn:schedule",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/6/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Maksud Tajuk B. 10 Perbendaharaan B. 12 Peruntukan kepada Kumpulan Wang Terkanun B. 25 Kementerian Perdagangan Dalam Negeri dan Kos Sara Hidup B. 64 Kementerian Pendidikan Tinggi JUMLAH"
      }
    }
  ]
