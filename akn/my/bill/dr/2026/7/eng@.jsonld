      "schema:name": {
        "@language": "en",
        "@value": "Section 20 of the principal Act is amended—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/eng@/~cl_10__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "in the shoulder note, by substituting for the words “Display of motor vehicle licence” the words “Duty to produce motor vehicle licence information”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/eng@/~cl_10__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "by substituting for subsection (1) the following subsection: “(1) Any person in charge of or uses a motor vehicle on a road shall, on being so required by any police officer, traffic warden or road transport officer, produce the motor vehicle licence information in the form and manner as determined by the Director General or such other evidence that satisfies such police officer, traffic warden or road transport officer that the motor vehicle holds a valid motor vehicle licence granted under section 16.”; and"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/eng@/~cl_10__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/eng@/~cl_10",
      "schema:text": {
        "@language": "en",
        "@value": "by deleting subsection (2). Amendment of section 26"
      }
    },
