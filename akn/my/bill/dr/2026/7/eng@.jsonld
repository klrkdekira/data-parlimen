      "schema:text": {
        "@language": "en",
        "@value": "by substituting for paragraph (ee) the following paragraph: “(ee) to regulate the establishment of a driving school or driving institute, to issue permit for driving school or driving institute, to regulate the training of a driver of motor vehicle and to provide for the fees to be charged relating to it;”;"
      }
    },
