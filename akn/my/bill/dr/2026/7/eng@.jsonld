      "schema:text": {
        "@language": "en",
        "@value": "This Act may be cited as the Road Transport (Amendment) Act 2026."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/eng@/~cl_1__subsec_2",
