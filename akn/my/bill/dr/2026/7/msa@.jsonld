      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (d), dengan menggantikan noktah di hujung perenggan itu dengan perkataan “; atau”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_33__para_a__subpara_iii",
      "@type": "akn:subparagraph",
      "eli:number": "iii",
