      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 112 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_31__para_a",
