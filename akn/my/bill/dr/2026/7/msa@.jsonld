      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1)— “(e) dengan menyampaikan notis itu dalam bentuk mesej elektronik melalui sistem memproses maklumat sebagaimana yang ditentukan oleh Ketua Pengarah.”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_33__para_a__subpara_i",
