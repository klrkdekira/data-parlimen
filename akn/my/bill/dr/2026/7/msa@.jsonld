      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1), dengan memasukkan selepas perkataan “42(1),” perkataan “42a(1), 42a(2),”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_18__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_18",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (2)(b), dengan menggantikan perkataan “seksyen 43,” dengan perkataan “seksyen 42a atau 43,”. Pindaan seksyen 59"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_19",
      "@type": "akn:clause",
      "eli:number": "19",
