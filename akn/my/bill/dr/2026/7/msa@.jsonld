        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_12__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 29 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_12__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1a), dengan memasukkan selepas perkataan “bertentangan dengan Akta ini” perkataan “, Akta Pengangkutan Awam Darat 2010”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_12__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_12",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong subseksyen (4b). Pindaan seksyen 32"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_13",
      "@type": "akn:clause",
      "eli:number": "13",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_13__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_13__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 32(3) Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_13__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (a), dengan menggantikan perkataan “satu tahun” dengan perkataan “tiga tahun”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_13__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_13",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (b), dengan menggantikan perkataan “tidak melebihi lima ribu ringgit” dengan perkataan “tidak kurang daripada tiga ribu ringgit dan tidak lebih daripada sepuluh ribu ringgit”. Pindaan seksyen 40"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_14",
      "@type": "akn:clause",
      "eli:number": "14",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 40(1) Akta ibu dipinda dengan menggantikan perkataan “tiga ratus ringgit” dengan perkataan “lima ratus ringgit”. Seksyen baharu 42a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_15",
      "@type": "akn:clause",
      "eli:number": "15",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ibu dipinda dengan memasukkan selepas seksyen 42 seksyen yang berikut: “Berlumba atau dugaan kelajuan 42a. (1) Mana-mana orang yang berlumba di jalan yang melibatkan dua atau lebih kenderaan motor melakukan suatu kesalahan dan apabila disabitkan boleh didenda tidak kurang daripada dua ribu ringgit dan tidak lebih daripada sepuluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi dua tahun atau kedua-duanya dan, dalam hal sabitan kali kedua atau kali kemudian, didenda tidak kurang daripada lima ribu ringgit dan tidak lebih daripada dua puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi lima tahun atau kedua-duanya. (2) Mana-mana orang yang mengambil bahagian dalam menduga kelajuan di jalan yang melibatkan satu atau lebih kenderaan motor melakukan suatu kesalahan dan apabila disabitkan boleh didenda tidak kurang daripada dua ribu ringgit dan tidak lebih daripada sepuluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi dua tahun atau kedua-duanya dan, dalam hal sabitan kali kedua atau kali kemudian, didenda tidak kurang daripada lima ribu ringgit dan tidak lebih daripada dua puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi lima tahun atau kedua-duanya.”. Pindaan seksyen 52"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_16",
      "@type": "akn:clause",
      "eli:number": "16",
