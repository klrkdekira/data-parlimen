      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 52(2) Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_16__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perkataan “balai polis yang berhampiran sekali” perkataan “atau mengikut apa-apa cara lain yang ditetapkan oleh Menteri selepas berunding dengan Menteri yang dipertanggungkan dengan tanggungjawab bagi hal ehwal dalam negeri”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_16__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_16",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “, jika dikehendaki sedemikian, perakuan insurans yang dikeluarkan di bawah seksyen 90 Akta ini” dengan perkataan “perakuan insurans yang dikeluarkan di bawah seksyen 90, jika dikehendaki sedemikian”. Pindaan seksyen 53b"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_17",
      "@type": "akn:clause",
      "eli:number": "17",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 53b Akta ibu dipinda dengan memasukkan selepas subseksyen (2) subseksyen yang berikut: “(2a) Subseksyen (2) tidak terpakai bagi pemunya berdaftar yang menyebabkan atau membenarkan untuk digunakan suatu kenderaan motor yang berkenaan dengannya suatu kesalahan yang dirakamkan melalui kamera telah dilakukan.”. Pindaan seksyen 54"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_18",
      "@type": "akn:clause",
      "eli:number": "18",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_18__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_18__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 54 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_18__para_a",
      "@type": "akn:paragraph",
