      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Subseksyen 17(1) Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_9__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perenggan (b) dengan perenggan yang berikut: “(b) butir-butir pengenalan— (i) kenderaan motor itu, termasuk nombor enjin dan nombor casis, kekal terang, jelas dan tidak terusik dan adalah serupa dengan butir-butir bersamaan yang terkandung dalam perakuan pendaftaran itu; dan (ii) kenderaan motor elektrik itu, termasuk nombor siri kenderaan motor elektrik dan nombor casis, kekal terang, jelas dan tidak terusik dan adalah serupa dengan butir-butir bersamaan yang terkandung dalam perakuan pendaftaran itu;”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_9__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas perenggan (bb) perenggan yang berikut: “(bc) dia berpuas hati bahawa permohonan bagi suatu lesen kenderaan motor adalah mengikut kawasan diisytiharkan di mana kenderaan motor itu berada dan hendak digunakan;”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_9__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_9__para_c__subpara_i",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_9__para_c__subpara_ii"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_9",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam perenggan (d)— Pindaan seksyen 20"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_9__para_c__subpara_i",
      "@type": "akn:subparagraph",
      "eli:number": "i",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_9__para_c",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan perkataan “Akta Lembaga Pelesenan Kenderaan Perdagangan 1987:” dengan perkataan “, Akta Pengangkutan Awam Darat 2010 atau Akta Lembaga Pelesenan Kenderaan Perdagangan 1987.”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_9__para_c__subpara_ii",
