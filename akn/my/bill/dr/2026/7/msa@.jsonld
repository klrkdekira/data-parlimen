      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 20 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_10__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam nota bahu, dengan menggantikan perkataan “Memperagakan lesen kenderaan motor” dengan perkataan “Kewajipan untuk mengemukakan maklumat lesen kenderaan motor”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_10__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan menggantikan subseksyen (1) dengan subseksyen yang berikut: “(1) Mana-mana orang yang menjaga atau menggunakan sesuatu kenderaan motor di jalan hendaklah, apabila dikehendaki sedemikian oleh mana-mana pegawai polis, warden lalu lintas atau pegawai pengangkutan jalan, mengemukakan maklumat lesen kenderaan motor dalam bentuk dan mengikut cara yang ditentukan oleh Ketua Pengarah atau apa-apa keterangan lain yang memuaskan hati pegawai polis, warden lalu lintas atau pegawai pengangkutan jalan itu bahawa kenderaan motor itu mempunyai suatu lesen kenderaan motor yang sah yang diberikan di bawah seksyen 16.”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_10__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_10",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memotong subseksyen (2). Pindaan seksyen 26"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_11",
      "@type": "akn:clause",
      "eli:number": "11",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_11__para_a",
