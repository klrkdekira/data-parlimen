      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 102(2) Akta ibu dipinda dengan menggantikan perkataan “tiga ratus ringgit” dengan perkataan “lima ratus ringgit”. Pindaan seksyen 108"
      }
    },
    {
