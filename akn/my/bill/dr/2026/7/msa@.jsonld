      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (8), dengan memotong perkataan “atau diberi lesen”. Pindaan seksyen 126a"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_39",
      "@type": "akn:clause",
      "eli:number": "39",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 126a Akta ibu dipinda dengan memotong perkataan “atau lesen yang dikeluarkan” di mana-mana jua terdapat. Pindaan seksyen 127"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_4",
      "@type": "akn:clause",
      "eli:number": "4",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Seksyen 9 Akta ibu dipinda dalam nota bahu dengan menggantikan perkataan “pendaftar berlesen” dengan perkataan “Pengarah”. Pindaan seksyen 10"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_40",
      "@type": "akn:clause",
