      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@",
      "schema:name": {
        "@language": "ms",
        "@value": "Seksyen 108 Akta ibu dipinda—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_28__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (1), dengan menggantikan perkataan “tidak melebihi lima ribu ringgit atau dipenjarakan selama tempoh tidak melebihi satu tahun” dengan perkataan “tidak kurang daripada sepuluh ribu ringgit dan tidak lebih daripada lima puluh ribu ringgit atau dipenjarakan selama tempoh tidak melebihi sepuluh tahun”; dan"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_28__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_28",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam subseksyen (3), dengan menggantikan perkataan “lima ribu ringgit dan tidak lebih daripada dua puluh ribu ringgit atau dipenjarakan selama tempoh tidak kurang daripada satu tahun dan tidak melebihi lima tahun” dengan perkataan “sepuluh ribu ringgit dan tidak lebih daripada dua ratus ribu ringgit atau dipenjarakan selama tempoh tidak kurang daripada satu tahun dan tidak lebih daripada sepuluh tahun”. Pindaan seksyen 109"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_29",
      "@type": "akn:clause",
      "eli:number": "29",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 109(3a) Akta ibu dipinda dengan memasukkan selepas perkataan “42,” perkataan “42a,”. Seksyen baharu 110b"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_2__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam takrif “jalan”, dalam perenggan (c), dengan menggantikan perkataan “seksyen 41, 42, 43, 44, 45 dan 45a,” dengan perkataan “seksyen 41, 42, 42a, 43, 44, 45, 45a, 48 dan 65,”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_2__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif “jalan” takrif yang berikut: ‘ “kawasan diisytiharkan” ertinya mana-mana kawasan pendaftaran yang diisytiharkan oleh Menteri sebagai suatu kawasan diisytiharkan di bawah subseksyen 16(1d);’;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_2__para_c",
      "@type": "akn:paragraph",
      "eli:number": "c",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif “lesen belajar memandu” takrif yang berikut: ‘ “lesen kenderaan motor” ertinya suatu lesen kenderaan motor yang diberikan di bawah seksyen 16 dalam apa-apa bentuk;’;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_2__para_d",
      "@type": "akn:paragraph",
      "eli:number": "d",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam takrif “lesen memandu”, dengan memasukkan selepas perkataan “di bawah seksyen 29” perkataan “dalam apa-apa bentuk”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_2__para_e",
      "@type": "akn:paragraph",
      "eli:number": "e",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dalam takrif “lesen vokasional”, dengan memasukkan selepas perkataan “seksyen 56 dan 57” perkataan “dalam apa-apa bentuk”;"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_2__para_f",
      "@type": "akn:paragraph",
      "eli:number": "f",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/7/msa@/~cl_2",
      "schema:text": {
        "@language": "ms",
        "@value": "dengan memasukkan selepas takrif “Menteri” takrif yang berikut: ‘ “mesej elektronik” mempunyai erti yang diberikan kepadanya dalam Akta Aktiviti Kerajaan Elektronik 2007 [Akta 680];’; dan"
      }
    },
    {
