      "schema:text": {
        "@language": "ms",
        "@value": "Subseksyen 76a(4) Akta ibu dipinda dengan menggantikan perkataan “tiga ratus ringgit” dengan perkataan “lima ratus ringgit”. Pindaan seksyen 79"
      }
    },
