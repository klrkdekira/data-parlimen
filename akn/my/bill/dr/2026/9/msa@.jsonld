      "schema:name": {
        "@language": "ms",
        "@value": "RUU Kesalahan-Kesalahan Seksual terhadap Kanak-Kanak (Pindaan) 2026"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/9/msa@/~cl_1",
      "@type": "akn:clause",
      "eli:number": "1",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/9/msa@/~cl_1__subsec_1",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/9/msa@/~cl_1__subsec_2"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/9/msa@"
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/9/msa@/~cl_1__subsec_1",
      "@type": "akn:subsection",
      "eli:number": "1",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/9/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini bolehlah dinamakan Akta Kesalahan-Kesalahan Seksual terhadap Kanak-Kanak (Pindaan) 2026."
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/9/msa@/~cl_1__subsec_2",
      "@type": "akn:subsection",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/9/msa@/~cl_1",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta ini mula berkuat kuasa pada tarikh yang ditetapkan oleh Menteri melalui pemberitahuan dalam Warta. Penggantian seksyen 3"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/9/msa@/~cl_2",
      "@type": "akn:clause",
      "eli:number": "2",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/9/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Akta Kesalahan-Kesalahan Seksual terhadap Kanak-Kanak 2017 [Akta 792] dipinda dengan menggantikan seksyen 3 dengan seksyen yang berikut: “Pemakaian luar wilayah"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/9/msa@/~cl_3",
      "@type": "akn:clause",
      "eli:number": "3",
      "hasPart": [
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/9/msa@/~cl_3__para_a",
        "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/9/msa@/~cl_3__para_b"
      ],
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/9/msa@",
      "schema:text": {
        "@language": "ms",
        "@value": "Jika mana-mana kesalahan di bawah Akta ini, atau mana-mana kesalahan yang dinyatakan dalam Jadual sekiranya mangsa ialah kanak-kanak dilakukan di mana-mana tempat di luar Malaysia—"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/9/msa@/~cl_3__para_a",
      "@type": "akn:paragraph",
      "eli:number": "a",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/9/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "oleh seseorang warganegara Malaysia, atau seseorang pemastautin tetap Malaysia, atau seseorang yang mempunyai pemastautinan lazimnya di Malaysia terhadap mana-mana kanak-kanak; atau"
      }
    },
    {
      "@id": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/9/msa@/~cl_3__para_b",
      "@type": "akn:paragraph",
      "eli:number": "b",
      "isPartOf": "https://cheeleong.dev/data-parlimen/akn/my/bill/dr/2026/9/msa@/~cl_3",
      "schema:text": {
        "@language": "ms",
        "@value": "oleh mana-mana orang terhadap kanak-kanak yang merupakan seorang warganegara Malaysia, atau seorang pemastautin tetap Malaysia, atau yang mempunyai pemastautinan lazimnya di Malaysia, kesalahan itu bolehlah diuruskan seolah-olah ia telah dilakukan di mana-mana tempat di dalam Malaysia.”."
      }
    }
  ]
}
